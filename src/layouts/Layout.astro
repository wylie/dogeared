---
import LeftHand from '../components/LeftHand.astro';
import { resolveUserBySession } from '../lib/auth';
type SectionLink = { id: string; label: string };
const { title = "Dogeared", sectionLinks = [] } = Astro.props as { title?: string; sectionLinks?: SectionLink[] };
const currentPath = Astro.url.pathname;
const session = await resolveUserBySession(Astro.request);
const isAuthenticated = !!session?.userId;
const metaDescription = "Track what matters. Find your next great read. Keep your shelves focused. Make reading feel like yours.";
const pageTitle = `${title} | Dogeared`;
const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url).toString();
const ogImageUrl = new URL("/og-image.png", Astro.site ?? Astro.url).toString();
import '../assets/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google Analytics: Only load in production -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-RT7DKML8JY"></script>
		<script is:inline>
			if (
				typeof window !== "undefined" &&
				!['localhost', '127.0.0.1'].includes(window.location.hostname)
			) {
				// @ts-ignore
				window.dataLayer = window.dataLayer || [];
				// @ts-ignore
				function gtag(){dataLayer.push(arguments);}
				// @ts-ignore
				gtag('js', new Date());
				// @ts-ignore
				gtag('config', 'G-RT7DKML8JY');
			}
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta name="description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Dogeared" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Copse&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
	</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<div class="container">
				<div class="column" style="padding-bottom: 0;">
					<slot name="left">
						<LeftHand current={currentPath} sectionLinks={sectionLinks} isAuthenticated={isAuthenticated} />
					</slot>
				</div>
				<main id="main-content" class="column content-column" tabindex="-1">
					<slot name="right">
						<slot />
					</slot>
				</main>
			</div>
			<a class="global-support-float" href="https://buymeacoffee.com/wylie" target="_blank" rel="noopener noreferrer">Support Dogeared</a>
		</body>
	</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;

	}
	.container {
		max-width: 1200px;
		margin: auto;
		display: grid;
		grid-template-columns: minmax(240px, 26%) minmax(0, 1fr);
		min-height: 100vh;
		align-items: start;
	}
	.column {
		display: flex;
		flex-direction: column;
	}
	.column {
		padding: 1rem;
		box-sizing: border-box;
	}
	.container > .column:first-child {
		position: sticky;
		top: 0;
		align-self: start;
		height: 100vh;
		max-height: 100vh;
		min-height: 0;
		overflow-y: auto;
	}
	.skip-link {
		position: fixed;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 15000;
		background: #111;
		color: #fff;
		padding: 0.5rem 0.75rem;
		border-radius: 6px;
		text-decoration: none;
		transform: translateY(-200%);
		opacity: 0;
		pointer-events: none;
	}
	.skip-link:focus {
		transform: translateY(0);
		opacity: 1;
		pointer-events: auto;
	}
	.global-support-float {
		position: fixed;
		right: 1rem;
		bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
		z-index: 9999;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		background: #151515;
		color: #fff;
		border-radius: 999px;
		padding: 0.6rem 0.9rem;
		font-size: 0.9rem;
		font-weight: 700;
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
	}
	.global-support-float:hover {
		background: var(--color-primary);
	}
	@media (max-width: 900px) {
		.container {
			max-width: 100%;
			grid-template-columns: 1fr;
			min-height: 0;
			align-content: start;
			padding: 0 0.5rem 1rem;
			box-sizing: border-box;
		}
		.column {
			padding: 0.6rem 0.5rem;
		}
		.container > .column:first-child {
			position: sticky;
			top: 0;
			z-index: 40;
			height: auto;
			overflow: visible;
			padding-top: 0;
		}
		.global-support-float {
			right: 0.6rem;
			bottom: calc(2.35rem + env(safe-area-inset-bottom, 0px));
			padding: 0.52rem 0.76rem;
			font-size: 0.84rem;
		}
	}
</style>
