---
import LeftHand from '../components/LeftHand.astro';
import FloatingActions from '../components/FloatingActions.astro';
import GuidedTip from '../components/GuidedTip.astro';
import OnboardingMilestones from '../components/OnboardingMilestones.astro';
import ReaderGuidance from '../components/ReaderGuidance.astro';
import WhatsNewModal from '../components/WhatsNewModal.astro';
import { ClientRouter } from 'astro:transitions';
import { resolveAdminSession } from '../lib/admin';
import { loadActiveAnnouncement } from '../lib/adminAnnouncements';
import { resolveUserBySession } from '../lib/auth';
import { DEFAULT_FOUNDING_READER_CONFIG, loadFoundingReaderConfigReadOnly } from '../lib/foundingReaders';
import { getNeonSql } from '../lib/neon';
import { DEFAULT_SOCIAL_IMAGE } from '../lib/metadataAssets';
import { DEFAULT_ROBOTS_DIRECTIVE, DEFAULT_SOCIAL_IMAGE_ALT, buildPageMetadata, type PageMetadataOgType } from '../lib/pageMetadata';
import { loadLatestPublishedRelease } from '../lib/releases';
import { recordPerformanceEventSafe, type PerformanceSpanInput } from '../lib/performanceTelemetry';
import { withRuntimeCache } from '../lib/runtimeCache';
import { resolveAppVersion, resolveGitCommit } from '../lib/versionInfo';
type SectionLink = { id: string; label: string };
type ResolvedLayoutSession = { userId: string; sessionHash: string } | null;
type LayoutPerformanceTelemetry = {
	operationName: string;
	route: string;
	startedAt: number;
	success: boolean;
	httpStatus: number;
	spans: PerformanceSpanInput[];
	metadata?: Record<string, unknown>;
};
const {
	title = "DogEared",
	sectionLinks = [],
	metaDescription = "",
	robots = DEFAULT_ROBOTS_DIRECTIVE,
	canonicalUrl = "",
	socialImage = DEFAULT_SOCIAL_IMAGE,
	socialImageAlt = DEFAULT_SOCIAL_IMAGE_ALT,
	ogType = "website",
	structuredData = "",
	resolvedSession = undefined,
	performanceTelemetry = null
} = Astro.props as {
	title?: string;
	sectionLinks?: SectionLink[];
	metaDescription?: string;
	robots?: string;
	canonicalUrl?: string;
	socialImage?: string;
	socialImageAlt?: string;
	ogType?: PageMetadataOgType;
	structuredData?: string;
	resolvedSession?: ResolvedLayoutSession;
	performanceTelemetry?: LayoutPerformanceTelemetry | null;
};
const layoutSharedStartedAt = performance.now();
const currentPath = Astro.url.pathname;
const AUTH_PROMPT_ROUTES = new Set(["/", "/discover", "/search", "/books", "/authors", "/collections", "/related"]);
const allowsAuthPrompt = (path: string) =>
	AUTH_PROMPT_ROUTES.has(path)
	|| path === "/book"
	|| path.startsWith("/author/")
	|| path.startsWith("/collections/")
	|| path.startsWith("/profile/");
const fontStylesheetHref = "https://fonts.googleapis.com/css2?family=Copse&family=Outfit:wght@100..900&display=swap";
const iconStylesheetHref = "https://fonts.googleapis.com/icon?family=Material+Icons&display=swap";
const session = resolvedSession === undefined ? await resolveUserBySession(Astro.request) : resolvedSession;
const isAuthenticated = !!session?.userId;
const allowAuthPrompt = !isAuthenticated && allowsAuthPrompt(currentPath);
const [
	adminSession,
	layoutGlobalData
] = await Promise.all([
	isAuthenticated ? resolveAdminSession(Astro.request) : Promise.resolve({ isAdmin: false }),
	withRuntimeCache("layout-global-public-data:v2", 30 * 1000, async () => {
		const sql = getNeonSql();
		const [activeAnnouncement, foundingReaderConfig, latestRelease] = await Promise.all([
			loadActiveAnnouncement(),
			loadFoundingReaderConfigReadOnly(sql).catch(() => DEFAULT_FOUNDING_READER_CONFIG),
			loadLatestPublishedRelease(sql).catch(() => null)
		]);
		return { activeAnnouncement, foundingReaderConfig, latestRelease };
	}).catch(() => ({
		activeAnnouncement: null,
		foundingReaderConfig: DEFAULT_FOUNDING_READER_CONFIG,
		latestRelease: null
	}))
]);
if (performanceTelemetry) {
	performanceTelemetry.spans.push({
		name: "shared navigation/sidebar data",
		durationMs: performance.now() - layoutSharedStartedAt
	});
}
const { activeAnnouncement, foundingReaderConfig, latestRelease } = layoutGlobalData;
const isAdmin = !!adminSession.isAdmin;
const appVersion = resolveAppVersion();
const releaseVersion = latestRelease && latestRelease.version ? latestRelease.version : appVersion;
const gitCommit = resolveGitCommit();
const metadata = buildPageMetadata({
	title,
	description: metaDescription,
	robots,
	canonicalUrl: String(canonicalUrl || "").trim() || currentPath,
	socialImage,
	socialImageAlt,
	ogType,
	structuredData,
	site: Astro.site ?? Astro.url
});
if (performanceTelemetry) {
	recordPerformanceEventSafe({
		operationName: performanceTelemetry.operationName,
		route: performanceTelemetry.route,
		totalMs: performance.now() - performanceTelemetry.startedAt,
		success: performanceTelemetry.success,
		httpStatus: performanceTelemetry.httpStatus,
		spans: performanceTelemetry.spans,
		metadata: performanceTelemetry.metadata
	});
}
import '../assets/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset={metadata.charset} />
		<meta name="viewport" content={metadata.viewport} />
		{metadata.iconLinks.map((link) => (
			<link rel={link.rel} type={link.type} sizes={link.sizes} href={link.href} />
		))}
		<meta name="theme-color" content={metadata.themeColor} />
		<meta name="generator" content={Astro.generator} />
		<title>{metadata.title}</title>
		<link rel="canonical" href={metadata.canonicalUrl} />
		<meta name="description" content={metadata.description} />
		<meta name="robots" content={metadata.robots} />
		<meta property="og:type" content={metadata.ogType} />
		<meta property="og:site_name" content="DogEared" />
		<meta property="og:title" content={metadata.title} />
		<meta property="og:description" content={metadata.description} />
		<meta property="og:url" content={metadata.canonicalUrl} />
		<meta property="og:image" content={metadata.socialImageUrl} />
		<meta property="og:image:alt" content={metadata.socialImageAlt} />
		<meta name="twitter:card" content={metadata.twitterCard} />
		<meta name="twitter:title" content={metadata.title} />
		<meta name="twitter:description" content={metadata.description} />
		<meta name="twitter:image" content={metadata.socialImageUrl} />
		<meta name="twitter:image:alt" content={metadata.socialImageAlt} />
		<script type="application/ld+json" set:html={metadata.websiteStructuredData}></script>
		{metadata.pageStructuredData ? <script type="application/ld+json" set:html={metadata.pageStructuredData}></script> : null}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href={fontStylesheetHref} onload="this.onload=null;this.rel='stylesheet'">
		<link rel="preload" as="style" href={iconStylesheetHref} onload="this.onload=null;this.rel='stylesheet'">
		<noscript>
			<link href={fontStylesheetHref} rel="stylesheet">
			<link href={iconStylesheetHref} rel="stylesheet">
		</noscript>
		<ClientRouter />
	</head>
		<body data-app-version={appVersion} data-release-version={releaseVersion} data-git-commit={gitCommit}>
			<div class="navigation-progress" aria-hidden="true"></div>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<div class="container">
				<div class="column" style="padding-bottom: 0;">
					<slot name="left">
						<LeftHand
							current={currentPath}
							sectionLinks={sectionLinks}
							isAuthenticated={isAuthenticated}
							isAdmin={isAdmin}
							allowAuthPrompt={allowAuthPrompt}
							foundingReaderMode={foundingReaderConfig.effectiveMode}
							appVersion={appVersion}
							releaseVersion={releaseVersion}
						/>
					</slot>
				</div>
				<main id="main-content" class="column content-column" tabindex="-1">
					<div id="route-loading-announcer" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
					<div id="route-transition-skeleton" class="route-transition-skeleton" hidden aria-hidden="true"></div>
					{activeAnnouncement ? (
						<section
							class="announcement-banner"
							data-announcement-id={String(activeAnnouncement.id)}
							aria-labelledby={`announcement-${activeAnnouncement.id}-title`}
						>
							<div>
								<strong id={`announcement-${activeAnnouncement.id}-title`}>{activeAnnouncement.title}</strong>
								<p>{activeAnnouncement.body}</p>
							</div>
							{activeAnnouncement.dismissible ? <button type="button" data-dismiss-announcement aria-label="Dismiss announcement">Dismiss</button> : null}
						</section>
					) : null}
					<slot name="right">
						<slot />
					</slot>
				</main>
			</div>
			<ReaderGuidance isAuthenticated={isAuthenticated} allowGuidance={allowAuthPrompt} />
			<GuidedTip isAuthenticated={isAuthenticated} />
			<OnboardingMilestones isAuthenticated={isAuthenticated} />
			<FloatingActions isAuthenticated={isAuthenticated} />
			<WhatsNewModal release={latestRelease} />
			<script is:inline>
				(() => {
					let navigationTimer = 0;
					let skeletonTimer = 0;
					let slowNavigationTimer = 0;
					let pendingPath = "";
					let activeNavigation = null;
					const root = document.documentElement;
					const progressDelayMs = 75;
					const skeletonDelayMs = 140;
					const slowNavigationMs = 15000;
					const mainContent = () => document.getElementById("main-content");
					const skeletonRoot = () => document.getElementById("route-transition-skeleton");
					const announcer = () => document.getElementById("route-loading-announcer");
					const escapeHtml = (value) => String(value || "")
						.replace(/&/g, "&amp;")
						.replace(/</g, "&lt;")
						.replace(/>/g, "&gt;")
						.replace(/"/g, "&quot;")
						.replace(/'/g, "&#39;");
					const pathFromUrl = (value) => {
						try {
							return new URL(String(value || ""), window.location.href).pathname;
						} catch {
							return "";
						}
					};
					const pathFromEvent = (event) => {
						const rawTo = event?.to || event?.detail?.to || event?.detail?.url || "";
						return pathFromUrl(rawTo) || pendingPath || window.location.pathname;
					};
					const routePattern = (path) => {
						const cleanPath = pathFromUrl(path) || String(path || window.location.pathname).split("?")[0] || "/";
						if (cleanPath === "/search") return "/search";
						if (cleanPath === "/reading-life") return "/reading-life";
						if (cleanPath === "/journal") return "/journal";
						if (cleanPath === "/discover") return "/discover";
						if (cleanPath === "/following") return "/following";
						if (cleanPath === "/notifications") return "/notifications";
						if (cleanPath === "/settings") return "/settings";
						if (cleanPath === "/books") return "/books";
						if (cleanPath === "/authors") return "/authors";
						if (cleanPath === "/book") return "/book";
						if (cleanPath.startsWith("/author/")) return "/author/[slug]";
						if (cleanPath.startsWith("/profile/")) return "/profile/[username]";
						if (cleanPath.startsWith("/admin/")) return "/admin/[section]";
						return cleanPath.length <= 80 ? cleanPath : cleanPath.slice(0, 80);
					};
					const pageLabel = (path) => {
						const route = routePattern(path);
						if (route === "/search") return "Search";
						if (route === "/reading-life") return "My Reading Life";
						if (route === "/journal") return "Reading Journal";
						if (route === "/discover") return "Discover";
						if (route === "/following") return "Following";
						if (route === "/notifications") return "Notifications";
						if (route === "/settings") return "Settings";
						if (route === "/books") return "Books";
						if (route === "/authors") return "Authors";
						if (route === "/book") return "Book Detail";
						if (route === "/author/[slug]") return "Author Detail";
						if (route === "/profile/[username]") return "Profile";
						if (route === "/admin/[section]") return "Admin";
						return "Page";
					};
					const skeletonLine = (width = "100%") => `<span class="route-skeleton-line" style="--skeleton-width:${escapeHtml(width)}"></span>`;
					const skeletonStat = () => `<div class="route-skeleton-stat">${skeletonLine("46%")}${skeletonLine("74%")}</div>`;
					const skeletonCover = () => `<div class="route-skeleton-cover"></div>`;
					const skeletonBookCard = () => `
						<li class="route-skeleton-book-card">
							${skeletonCover()}
							<div class="route-skeleton-card-copy">
								${skeletonLine("78%")}
								${skeletonLine("48%")}
								${skeletonLine("92%")}
								${skeletonLine("66%")}
							</div>
						</li>
					`;
					const skeletonActivityRow = () => `
						<li class="route-skeleton-activity-row">
							<span class="route-skeleton-dot"></span>
							<div>${skeletonLine("70%")}${skeletonLine("38%")}</div>
						</li>
					`;
					const skeletonHeader = (label) => `
						<div class="route-skeleton-header">
							<div>
								<span class="route-skeleton-eyebrow">${escapeHtml(label)}</span>
								${skeletonLine("54%")}
								${skeletonLine("72%")}
							</div>
						</div>
					`;
					const buildRouteSkeleton = (path) => {
						const route = routePattern(path);
						const label = pageLabel(path);
						if (route === "/search") {
							return `<section class="route-skeleton-shell route-skeleton-search" aria-label="Loading ${escapeHtml(label)}">
								${skeletonHeader(label)}
								<div class="route-skeleton-search-box">${skeletonLine("62%")}</div>
								<ul class="route-skeleton-book-grid">${skeletonBookCard()}${skeletonBookCard()}${skeletonBookCard()}${skeletonBookCard()}</ul>
							</section>`;
						}
						if (route === "/book") {
							return `<section class="route-skeleton-shell route-skeleton-detail" aria-label="Loading ${escapeHtml(label)}">
								<div class="route-skeleton-detail-head">${skeletonCover()}<div>${skeletonLine("48%")}${skeletonLine("34%")}${skeletonLine("82%")}${skeletonLine("72%")}</div></div>
								<div class="route-skeleton-section">${skeletonLine("26%")}${skeletonLine("100%")}${skeletonLine("94%")}${skeletonLine("64%")}</div>
							</section>`;
						}
						if (route === "/author/[slug]") {
							return `<section class="route-skeleton-shell route-skeleton-author" aria-label="Loading ${escapeHtml(label)}">
								<div class="route-skeleton-profile-head"><span class="route-skeleton-avatar"></span><div>${skeletonLine("44%")}${skeletonLine("74%")}${skeletonLine("58%")}</div></div>
								<ul class="route-skeleton-book-grid">${skeletonBookCard()}${skeletonBookCard()}${skeletonBookCard()}${skeletonBookCard()}</ul>
							</section>`;
						}
						if (route === "/profile/[username]") {
							return `<section class="route-skeleton-shell route-skeleton-profile" aria-label="Loading ${escapeHtml(label)}">
								<div class="route-skeleton-profile-head"><span class="route-skeleton-avatar"></span><div>${skeletonLine("36%")}${skeletonLine("66%")}${skeletonLine("52%")}</div></div>
								<div class="route-skeleton-stats">${skeletonStat()}${skeletonStat()}${skeletonStat()}</div>
								<ul class="route-skeleton-book-grid">${skeletonBookCard()}${skeletonBookCard()}</ul>
								<ul class="route-skeleton-activity">${skeletonActivityRow()}${skeletonActivityRow()}</ul>
							</section>`;
						}
						if (route === "/reading-life") {
							return `<section class="route-skeleton-shell route-skeleton-reading-life" aria-label="Loading ${escapeHtml(label)}">
								${skeletonHeader(label)}
								<div class="route-skeleton-stats">${skeletonStat()}${skeletonStat()}${skeletonStat()}${skeletonStat()}</div>
								<div class="route-skeleton-chart">${skeletonLine("82%")}${skeletonLine("68%")}${skeletonLine("74%")}</div>
							</section>`;
						}
						if (route === "/discover" || route === "/books") {
							return `<section class="route-skeleton-shell route-skeleton-discover" aria-label="Loading ${escapeHtml(label)}">
								${skeletonHeader(label)}
								<ul class="route-skeleton-book-grid">${skeletonBookCard()}${skeletonBookCard()}${skeletonBookCard()}${skeletonBookCard()}</ul>
							</section>`;
						}
						if (route === "/following" || route === "/notifications" || route === "/journal") {
							return `<section class="route-skeleton-shell route-skeleton-list" aria-label="Loading ${escapeHtml(label)}">
								${skeletonHeader(label)}
								<ul class="route-skeleton-activity">${skeletonActivityRow()}${skeletonActivityRow()}${skeletonActivityRow()}${skeletonActivityRow()}</ul>
							</section>`;
						}
						return `<section class="route-skeleton-shell" aria-label="Loading ${escapeHtml(label)}">
							${skeletonHeader(label)}
							<div class="route-skeleton-section">${skeletonLine("100%")}${skeletonLine("92%")}${skeletonLine("76%")}</div>
						</section>`;
					};
					const sendNavigationTelemetry = (navigation, success, reason) => {
						if (!navigation || navigation.sent) return;
						navigation.sent = true;
						const totalMs = Math.max(1, Math.round(performance.now() - navigation.startedAt));
						const skeletonVisibleMs = navigation.skeletonVisibleAt ? Math.max(1, Math.round(navigation.skeletonVisibleAt - navigation.startedAt)) : 0;
						const spans = [
							{ name: "navigation start to content swap", durationMs: totalMs }
						];
						if (skeletonVisibleMs > 0) {
							spans.unshift({ name: "navigation start to skeleton visible", durationMs: skeletonVisibleMs });
						}
						const body = JSON.stringify({
							route: navigation.route,
							totalMs,
							success,
							spans,
							metadata: {
								feedbackShown: skeletonVisibleMs > 0,
								skeletonVisibleMs,
								reason: String(reason || (success ? "complete" : "interrupted")).slice(0, 40)
							}
						});
						try {
							if (navigator.sendBeacon) {
								const blob = new Blob([body], { type: "application/json" });
								if (navigator.sendBeacon("/api/performance/navigation", blob)) return;
							}
							fetch("/api/performance/navigation", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								credentials: "same-origin",
								keepalive: true,
								body
							}).catch(() => {});
						} catch {
							// Operational feedback telemetry must never affect navigation.
						}
					};
					const showSkeleton = () => {
						if (!activeNavigation) return;
						const shell = skeletonRoot();
						const main = mainContent();
						if (!(shell instanceof HTMLElement) || !(main instanceof HTMLElement)) return;
						shell.innerHTML = buildRouteSkeleton(activeNavigation.path);
						shell.hidden = false;
						shell.setAttribute("aria-hidden", "false");
						activeNavigation.skeletonVisibleAt = performance.now();
						main.setAttribute("aria-busy", "true");
						root.classList.add("is-route-skeleton-visible");
						const live = announcer();
						if (live instanceof HTMLElement) live.textContent = `Loading ${pageLabel(activeNavigation.path)}...`;
					};
					const showSlowState = () => {
						if (!activeNavigation?.skeletonVisibleAt) return;
						const shell = skeletonRoot();
						if (shell instanceof HTMLElement) {
							shell.innerHTML = `<section class="route-skeleton-shell route-skeleton-error" role="status">${skeletonHeader(pageLabel(activeNavigation.path))}<p>This page is taking longer than expected. DogEared will keep trying.</p></section>`;
						}
						const live = announcer();
						if (live instanceof HTMLElement) live.textContent = `${pageLabel(activeNavigation.path)} is taking longer than expected.`;
					};
					const start = (path) => {
						if (activeNavigation && !activeNavigation.sent) {
							sendNavigationTelemetry(activeNavigation, false, "superseded");
						}
						const targetPath = pathFromUrl(path) || window.location.pathname;
						activeNavigation = {
							path: targetPath,
							route: routePattern(targetPath),
							startedAt: performance.now(),
							skeletonVisibleAt: 0,
							sent: false
						};
						window.clearTimeout(navigationTimer);
						window.clearTimeout(skeletonTimer);
						window.clearTimeout(slowNavigationTimer);
						navigationTimer = window.setTimeout(() => {
							root.classList.add("is-navigating");
						}, progressDelayMs);
						skeletonTimer = window.setTimeout(showSkeleton, skeletonDelayMs);
						slowNavigationTimer = window.setTimeout(showSlowState, slowNavigationMs);
					};
					const stop = (success = true, reason = "complete") => {
						window.clearTimeout(navigationTimer);
						window.clearTimeout(skeletonTimer);
						window.clearTimeout(slowNavigationTimer);
						root.classList.remove("is-navigating");
						root.classList.remove("is-route-skeleton-visible");
						const shell = skeletonRoot();
						if (shell instanceof HTMLElement) {
							shell.hidden = true;
							shell.setAttribute("aria-hidden", "true");
							shell.innerHTML = "";
						}
						const main = mainContent();
						if (main instanceof HTMLElement) main.removeAttribute("aria-busy");
						const live = announcer();
						if (live instanceof HTMLElement) live.textContent = "";
						if (activeNavigation) sendNavigationTelemetry(activeNavigation, success, reason);
						activeNavigation = null;
						pendingPath = "";
					};
					const eligibleLinkPath = (event) => {
						if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return "";
						const target = event.target instanceof Element ? event.target : null;
						const link = target?.closest("a[href]");
						if (!(link instanceof HTMLAnchorElement)) return "";
						if (link.target || link.download || link.hasAttribute("data-no-route-skeleton")) return "";
						const url = new URL(link.href, window.location.href);
						if (url.origin !== window.location.origin) return "";
						if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return "";
						return url.pathname;
					};
					document.addEventListener("click", (event) => {
						const path = eligibleLinkPath(event);
						if (!path) return;
						pendingPath = path;
						start(path);
					}, true);
					document.addEventListener("submit", (event) => {
						const form = event.target instanceof HTMLFormElement ? event.target : null;
						if (!form || form.method.toLowerCase() !== "get") return;
						const action = form.action || window.location.href;
						const url = new URL(action, window.location.href);
						if (url.origin !== window.location.origin) return;
						pendingPath = url.pathname;
						start(url.pathname);
					}, true);
					document.addEventListener("astro:before-preparation", (event) => {
						const path = pathFromEvent(event);
						if (!activeNavigation || routePattern(path) !== activeNavigation.route) start(path);
					});
					document.addEventListener("astro:after-swap", () => stop(true, "swap"));
					document.addEventListener("astro:page-load", () => stop(true, "page-load"));
					window.addEventListener("pageshow", () => stop(true, "pageshow"));
				})();
			</script>
			<script define:vars={{ currentPath }}>
				(() => {
					const endpoint = "/api/analytics/event";
					const sentImpressions = new Set();
					const featureByRoute = (path) => {
						if (path === "/") return "Home";
						if (path === "/discover") return "Discover";
						if (path === "/journal") return "Reading Journal";
						if (path === "/reading-life") return "My Reading Life";
						if (path === "/search") return "Search";
						if (path === "/books") return "Books";
						if (path === "/authors" || path.startsWith("/author/")) return "Authors";
						if (path === "/book") return "Book Detail";
						if (path === "/collections" || path.startsWith("/collections/")) return "Collections";
						if (path.startsWith("/profile")) return "Profile";
						if (path === "/following") return "Following";
						return "";
					};
					const post = (payload) => {
						try {
							const body = JSON.stringify({
								route: currentPath,
								...payload
							});
							if (navigator.sendBeacon) {
								const blob = new Blob([body], { type: "application/json" });
								if (navigator.sendBeacon(endpoint, blob)) return;
							}
							fetch(endpoint, {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								credentials: "same-origin",
								keepalive: true,
								body
							}).catch(() => {});
						} catch {
							// Product analytics must never block the reading experience.
						}
					};
					window.dogearedTrackProductEvent = post;
					post({ eventName: "page_view", eventGroup: "navigation", source: featureByRoute(currentPath) || currentPath });
					const feature = featureByRoute(currentPath);
					if (feature) post({ eventName: "feature_view", eventGroup: "feature", source: feature });
					if (document.querySelector("[data-feature='series']")) {
						post({ eventName: "feature_view", eventGroup: "feature", source: "Series" });
					}
					const recommendationCards = Array.from(document.querySelectorAll("[data-analytics-recommendation-book-id]"));
					const sendImpression = (card) => {
						if (!(card instanceof HTMLElement)) return;
						const bookId = card.dataset.analyticsRecommendationBookId || "";
						if (!bookId || sentImpressions.has(bookId)) return;
						sentImpressions.add(bookId);
						post({
							eventName: "recommendation_impression",
							eventGroup: "discovery",
							source: card.dataset.analyticsRecommendationSource || "unknown",
							subjectType: "book",
							subjectId: bookId
						});
					};
					if ("IntersectionObserver" in window) {
						const observer = new IntersectionObserver((entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								sendImpression(entry.target);
								observer.unobserve(entry.target);
							}
						}, { threshold: 0.45 });
						for (const card of recommendationCards) observer.observe(card);
					} else {
						for (const card of recommendationCards) sendImpression(card);
					}
					document.addEventListener("click", (event) => {
						const target = event.target instanceof Element ? event.target : null;
						if (!target) return;
						const recommendationCard = target.closest("[data-analytics-recommendation-book-id]");
						if (!(recommendationCard instanceof HTMLElement)) return;
						const bookId = recommendationCard.dataset.analyticsRecommendationBookId || "";
						const source = recommendationCard.dataset.analyticsRecommendationSource || "unknown";
						if (target.closest("a[href*='/book']")) {
							post({
								eventName: "recommendation_click",
								eventGroup: "discovery",
								source,
								subjectType: "book",
								subjectId: bookId
							});
						}
						const shelfOption = target.closest("[data-action='set-shelf'], [data-action='assign-custom-shelf']");
						if (shelfOption) {
							post({
								eventName: "recommendation_add_to_shelf",
								eventGroup: "discovery",
								source,
								subjectType: "book",
								subjectId: bookId,
								metadata: {
									status: shelfOption instanceof HTMLElement ? shelfOption.dataset.status || "" : ""
								}
							});
						}
					});
				})();
			</script>
		</body>
