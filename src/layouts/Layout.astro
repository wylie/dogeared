---
import LeftHand from '../components/LeftHand.astro';
import FloatingActions from '../components/FloatingActions.astro';
import ReaderGuidance from '../components/ReaderGuidance.astro';
import { resolveAdminSession } from '../lib/admin';
import { resolveUserBySession } from '../lib/auth';
import { DEFAULT_SOCIAL_IMAGE, METADATA_ICON_LINKS, SITE_THEME_COLOR } from '../lib/metadataAssets';
import { buildSeoMetadata } from '../lib/seo';
type SectionLink = { id: string; label: string };
const {
	title = "DogEared",
	sectionLinks = [],
	metaDescription = "",
	robots = "index,follow",
	canonicalUrl = "",
	socialImage = DEFAULT_SOCIAL_IMAGE,
	socialImageAlt = "DogEared, a calm reading community and personal reading journal",
	ogType = "website",
	structuredData = ""
} = Astro.props as {
	title?: string;
	sectionLinks?: SectionLink[];
	metaDescription?: string;
	robots?: string;
	canonicalUrl?: string;
	socialImage?: string;
	socialImageAlt?: string;
	ogType?: "website" | "article" | "book" | "profile";
	structuredData?: string;
};
const currentPath = Astro.url.pathname;
const shouldLoadAnalytics = !["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const session = await resolveUserBySession(Astro.request);
const isAuthenticated = !!session?.userId;
const adminSession = isAuthenticated ? await resolveAdminSession(Astro.request) : { isAdmin: false };
const isAdmin = !!adminSession.isAdmin;
const seo = buildSeoMetadata({
	title,
	description: metaDescription,
	canonicalUrl: String(canonicalUrl || "").trim() || currentPath,
	socialImage,
	site: Astro.site ?? Astro.url
});
const pageTitle = seo.title;
const canonicalHref = seo.canonicalUrl;
const ogImageUrl = seo.imageUrl;
const siteOrigin = new URL(canonicalHref).origin;
const websiteStructuredData = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "DogEared",
	url: siteOrigin,
	potentialAction: {
		"@type": "SearchAction",
		target: `${siteOrigin}/search?q={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
});
const pageStructuredData = String(structuredData || "").trim();
import '../assets/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google Analytics: Only load in production -->
		{shouldLoadAnalytics ? (
			<>
				<script async src="https://www.googletagmanager.com/gtag/js?id=G-RT7DKML8JY"></script>
				<script is:inline>
				// @ts-ignore
				window.dataLayer = window.dataLayer || [];
				// @ts-ignore
				function gtag(){dataLayer.push(arguments);}
				// @ts-ignore
				gtag('js', new Date());
				// @ts-ignore
				gtag('config', 'G-RT7DKML8JY');
				</script>
			</>
		) : null}
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{METADATA_ICON_LINKS.map((link) => (
			<link rel={link.rel} type={link.type} sizes={link.sizes} href={link.href} />
		))}
		<meta name="theme-color" content={SITE_THEME_COLOR} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalHref} />
		<meta name="description" content={seo.description} />
		<meta name="robots" content={robots} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="DogEared" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={socialImageAlt} />
		{seo.imageIsDefault ? <meta property="og:image:width" content="1200" /> : null}
		{seo.imageIsDefault ? <meta property="og:image:height" content="630" /> : null}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={seo.description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
		<script type="application/ld+json" set:html={websiteStructuredData}></script>
		{pageStructuredData ? <script type="application/ld+json" set:html={pageStructuredData}></script> : null}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preconnect" href="https://books.google.com">
		<link href="https://fonts.googleapis.com/css2?family=Copse&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons&display=swap" rel="stylesheet">
	</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<div class="container">
				<div class="column" style="padding-bottom: 0;">
					<slot name="left">
						<LeftHand current={currentPath} sectionLinks={sectionLinks} isAuthenticated={isAuthenticated} isAdmin={isAdmin} />
					</slot>
				</div>
				<main id="main-content" class="column content-column" tabindex="-1">
					<slot name="right">
						<slot />
					</slot>
				</main>
			</div>
			<ReaderGuidance isAuthenticated={isAuthenticated} />
			<FloatingActions isAuthenticated={isAuthenticated} />
		</body>
	</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;

	}
	.container {
		max-width: 1280px;
		margin: auto;
		display: grid;
		grid-template-columns: minmax(238px, 24%) minmax(0, 1fr);
		min-height: 100vh;
		align-items: start;
		overflow-x: clip;
		column-gap: clamp(0.5rem, 2vw, 1.5rem);
	}
	.column {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.column {
		padding: clamp(0.85rem, 1.4vw, 1.35rem);
		box-sizing: border-box;
	}
	.content-column {
		padding-top: clamp(1rem, 2.1vw, 2rem);
		padding-bottom: 2.5rem;
	}
	.container > .column:first-child {
		position: sticky;
		top: 0;
		align-self: start;
		height: 100vh;
		max-height: 100vh;
		min-height: 0;
		overflow-y: auto;
	}
	.skip-link {
		position: fixed;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 15000;
		background: #111;
		color: #fff;
		padding: 0.5rem 0.75rem;
		border-radius: 6px;
		text-decoration: none;
		transform: translateY(-200%);
		opacity: 0;
		pointer-events: none;
	}
	.skip-link:focus {
		transform: translateY(0);
		opacity: 1;
		pointer-events: auto;
	}
	@media (max-width: 900px) {
		html,
		body {
			overflow-x: hidden;
		}
		.container {
			max-width: 100%;
			grid-template-columns: 1fr;
			min-height: 0;
			align-content: start;
			padding: 0 0.5rem 1rem;
			box-sizing: border-box;
			overflow-x: clip;
		}
		.column {
			padding: 0.6rem 0.5rem;
			min-width: 0;
		}
		.content-column {
			padding-top: 0.85rem;
			padding-bottom: 1.5rem;
		}
		.container > .column:first-child {
			position: sticky;
			top: 0;
			z-index: 40;
			height: auto;
			overflow: visible;
			padding-top: 0;
		}
	}
</style>
