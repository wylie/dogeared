---
import Layout from "../layouts/Layout.astro";
import BookCard from "../components/BookCard.astro";
import ShelfDropdown from "../components/ShelfDropdown.astro";
import ReaderCard from "../components/ReaderCard.astro";
import { authorHref } from "../lib/author";
import { getNeonSql } from "../lib/neon";
import { resolveUserBySession } from "../lib/auth";
import {
	activityHeading,
	formatActivityDate,
	renderRatingStars,
	resolveFollowingCount,
	resolveFollowingFeedActivity,
	resolveFollowingReaders,
	resolvePublicReaderSuggestions,
	READER_SUGGESTIONS_EMPTY_MESSAGE
} from "../lib/feed";

export const prerender = false;

const session = await resolveUserBySession(Astro.request);
if (!session?.userId) {
	return Astro.redirect("/");
}

const viewerUserId = session.userId;
const [followingCount, suggestionRows] = await Promise.all([
	resolveFollowingCount(viewerUserId),
	resolvePublicReaderSuggestions(viewerUserId, 60)
]);
const [activity, suggestions, followingReaders] = await Promise.all([
	followingCount > 0 ? resolveFollowingFeedActivity(viewerUserId, 60) : Promise.resolve([]),
	Promise.resolve(suggestionRows),
	followingCount > 0 ? resolveFollowingReaders(viewerUserId, 60) : Promise.resolve([])
]);
const viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
const viewerRatingByBookId = new Map<number, number>();
if (activity.length > 0) {
	const sql = getNeonSql();
	const bookIds = Array.from(new Set(activity.map((item) => Number(item.bookId || 0)).filter((id) => id > 0)));
	if (bookIds.length > 0) {
		const shelfRows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>>`
			select book_id, status, rating
			from user_book
			where user_id = ${viewerUserId}::uuid
				and book_id = any(${bookIds}::bigint[])
		`;
		for (const row of shelfRows) {
			const bookId = Number(row.book_id || 0);
			if (bookId > 0) viewerStatusByBookId.set(bookId, row.status);
			const rating = Math.max(0, Math.min(5, Number(row.rating || 0)));
			if (bookId > 0 && rating > 0) viewerRatingByBookId.set(bookId, rating);
		}
	}
}
const peopleToFollow = suggestions;
const sectionLinks = [
	{ id: "people-to-follow", label: "People to Follow" },
	...(followingReaders.length > 0 ? [{ id: "currently-following", label: "Currently Following" }] : []),
	...(followingCount > 0 ? [{ id: "following-activity", label: "Following Activity" }] : [])
];
---

<Layout title="Following" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="feed-page">
		<header class="feed-header">
			<h1>Following</h1>
			<p>Recent shelf activity from readers you follow.</p>
		</header>

		<section id="people-to-follow" class="people-strip-section" aria-labelledby="people-strip-title">
			<div class="section-heading-row">
				<h2 id="people-strip-title">People to Follow</h2>
			</div>
			<p class="people-strip-copy">
				Follow other DogEared users to discover books from readers across the community.
			</p>
			{peopleToFollow.length === 0 ? (
				<p class="empty-note">{READER_SUGGESTIONS_EMPTY_MESSAGE}</p>
			) : (
			<ul class="people-strip" aria-label="People to follow">
				{peopleToFollow.map((reader) => (
					<ReaderCard reader={reader} />
				))}
			</ul>
			)}
		</section>

		{followingReaders.length > 0 && (
			<section id="currently-following" class="following-management-section" aria-labelledby="following-management-title">
				<div class="section-heading-row">
					<h2 id="following-management-title">Currently Following</h2>
					<span>{followingReaders.length} reader{followingReaders.length === 1 ? "" : "s"}</span>
				</div>
				<ul class="following-management-grid">
					{followingReaders.map((reader) => (
						<ReaderCard
							reader={reader}
							action="unfollow"
							extraClass="following-management-card"
							extraAttrs={{ "data-following-card": true }}
						/>
					))}
				</ul>
			</section>
		)}

		{followingCount > 0 && (
			<section id="following-activity" class="feed-activity" aria-labelledby="feed-activity-title">
				<h2 id="feed-activity-title">Following Activity</h2>
				{activity.length === 0 ? (
					<div class="empty-following-panel">
						<h2>No activity yet</h2>
						<p>Your followed readers have not posted recent activity yet. Follow a few more readers or check back after your next reading update.</p>
					</div>
				) : (
					<ul class="activity-grid">
						{activity.map((item) => (
							<BookCard
								title={item.title}
								titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
								author={item.author}
								authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
								thumbnail={item.thumbnail}
								readers={1}
								shelfEntries={1}
								publishedLabel={item.publishedLabel}
								pageCount={item.pageCount}
								averageRating={item.averageRating || 0}
							>
								<p slot="preTitle" class="meta activity-headline">
									<a class="actor-link" href={`/profile/${encodeURIComponent(item.actorUsername)}`}>@{item.actorUsername}</a>
									{" "}
									<span class="activity-prefix">{activityHeading(item.eventType).prefix}</span>
									{activityHeading(item.eventType).shelf && <>&nbsp;<em>{activityHeading(item.eventType).shelf}</em></>}
									{formatActivityDate(item.updatedAt) && (
										<>
											<br />
											<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
										</>
									)}
								</p>
								<div slot="meta">
									{viewerRatingByBookId.get(Number(item.bookId || 0)) && (
										<p class="meta rating-meta">{renderRatingStars(viewerRatingByBookId.get(Number(item.bookId || 0)) || 0)} {viewerRatingByBookId.get(Number(item.bookId || 0))}/5</p>
									)}
								</div>
								<div slot="actions">
									<ShelfDropdown attrs={{
										"data-book-id": String(item.bookId || 0),
										"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
										"data-title": item.title,
										"data-author": item.author,
										"data-description": item.description,
										"data-pages": String(Math.max(0, Number(item.pageCount || 0))),
										"data-cover": item.thumbnail,
										"data-format": "Book",
										"data-language": item.language,
										"data-isbn10": item.isbn10,
										"data-isbn13": item.isbn13
									}} />
								</div>
								<div
									slot="social"
									class="activity-comments-wrap"
									data-comments-wrap
									data-activity-id={String(item.id || 0)}
									data-comments-empty={Math.max(0, Number(item.commentCount || 0)) > 0 ? "0" : "1"}
								>
									<div class="activity-social-row">
										<div class="activity-like-wrap">
											<button
												type="button"
												class={`activity-like-button${item.viewerLiked ? " is-liked" : ""}`}
												data-action="toggle-activity-like"
												data-activity-id={String(item.id || 0)}
												data-liked={item.viewerLiked ? "1" : "0"}
												data-like-count={String(Math.max(0, Number(item.likeCount || 0)))}
												aria-label={item.viewerLiked ? "Unlike this activity" : "Like this activity"}
												title={item.viewerLiked ? "Unlike" : "Like"}
											>
												<span class="activity-like-label">{item.viewerLiked ? "Liked" : "Like"}</span>
											</button>
											<span class="activity-like-count" data-like-count-static>{Math.max(0, Number(item.likeCount || 0))}</span>
										</div>
										<form class="activity-comment-form" data-comment-form>
											<input type="text" name="comment" maxlength="500" placeholder="Leave a comment…" />
											<button type="submit">Post</button>
										</form>
									</div>
									{String(item.eventType || "").trim().toLowerCase() === "finished" && item.finishedReflection && (
										<p class="meta finished-reflection">“{item.finishedReflection}”</p>
									)}
									<div class="activity-comments-list" data-comments-list></div>
									<p class="activity-comment-feedback" data-comment-feedback role="status" aria-live="polite" hidden></p>
								</div>
							</BookCard>
						))}
					</ul>
				)}
			</section>
		)}
	</div>
</Layout>

<style>
	.feed-page {
		max-width: 860px;
		display: grid;
		gap: 0.9rem;
		min-width: 0;
	}
	.feed-page > * { min-width: 0; }
	.feed-header h1,
	.feed-header p,
	.feed-activity h2,
	.empty-following-panel h2 {
		margin: 0;
	}
	.feed-header p {
		margin-top: 0.35rem;
		color: #444;
		overflow-wrap: anywhere;
	}
	.section-heading-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.25rem;
	}
	.section-heading-row h2 {
		margin: 0;
		font-size: 1.15rem;
		color: var(--color-text);
		font-weight: 680;
		line-height: 1.16;
	}
	.section-heading-row span {
		color: var(--color-text-muted);
		font-size: 0.82rem;
		font-weight: 700;
	}
	.people-strip-section {
		min-width: 0;
	}
	.people-strip-copy {
		margin: 0 0 0.6rem;
		color: #444;
		overflow-wrap: anywhere;
	}
	.feed-activity h2 {
		margin-bottom: 0.6rem;
	}
	.activity-grid,
	.reader-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
	.activity-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: stretch;
		row-gap: 0.75rem;
		column-gap: 0.75rem;
	}
	.feed-page :global(.activity-grid .book-card .card-body h3) {
		padding-right: 4.5rem;
	}
	.feed-page :global(.activity-grid .book-card) {
		overflow: hidden;
	}
	.feed-page :global(.activity-grid .book-card .card-body) {
		min-height: 0;
	}
	.feed-page :global(.activity-grid .book-card .card-social) {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-top: none !important;
		padding-top: 0 !important;
		margin-top: 0 !important;
	}
	.activity-headline {
		font-weight: 700;
		color: #2f2f2f;
	}
	.activity-prefix,
	.actor-link {
		color: var(--color-nav);
	}
	.actor-link {
		text-decoration: none;
	}
	.actor-link:hover,
	.actor-link:focus-visible {
		color: var(--color-nav-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.activity-date {
		color: #5b6470;
		font-weight: 600;
	}
	.rating-meta {
		color: var(--color-rating);
		font-weight: 700;
	}
	.finished-reflection {
		margin: 0;
		font-style: italic;
		color: #475569;
		overflow-wrap: anywhere;
	}
	.feed-page :global(.shelf-state) {
		display: none !important;
	}
	.activity-social-row {
		display: flex;
		align-items: stretch;
		gap: 0.6rem;
		width: 100%;
		min-width: 0;
		flex-wrap: nowrap;
		border-top: var(--border-subtle);
		padding-top: 0.48rem;
	}
	.activity-like-button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: none;
		background: transparent;
		color: var(--color-nav);
		padding: 0;
		min-height: 2rem;
		font: inherit;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: color .16s ease;
		box-sizing: border-box;
	}
	.activity-like-wrap {
		display: flex;
		align-items: stretch;
		gap: 0.45rem;
		line-height: 1;
		min-height: 2rem;
	}
	.activity-like-button:hover,
	.activity-like-button:focus-visible {
		color: var(--color-nav-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.activity-like-button.is-liked {
		color: var(--color-nav-active);
	}
	.activity-like-button:disabled {
		opacity: .72;
		cursor: default;
	}
	.activity-like-label {
		line-height: 1.2;
	}
	.activity-like-count {
		font-size: 0.86rem;
		color: #64748b;
		line-height: 1.2;
		align-self: center;
	}
	.activity-comments-wrap {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		height: 100%;
		min-height: 0;
	}
	.activity-comments-wrap[data-comments-empty="1"] {
		justify-content: flex-end;
	}
	.activity-comments-wrap[data-comments-empty="0"] {
		justify-content: flex-start;
	}
	.activity-comments-list {
		display: grid;
		gap: 0.15rem;
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		padding-right: 0.1rem;
	}
	.activity-comments-list:empty {
		display: none;
		max-height: 0;
		overflow: hidden;
		padding-right: 0;
	}
	:global(.activity-comment-item) {
		margin: 0;
		padding: 0.45rem 0;
		font-size: 0.84rem;
		color: #334155;
		line-height: 1.35;
		overflow-wrap: anywhere;
		display: grid;
		gap: 0.12rem;
	}
	:global(.activity-comment-head) {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.4rem;
	}
	:global(.activity-comment-meta) {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	:global(.activity-comment-body) {
		display: block;
	}
	:global(.activity-comment-age) {
		font-size: 0.75rem;
		font-weight: 600;
		color: #7b8794;
		white-space: nowrap;
	}
	:global(.activity-comment-delete) {
		padding: 0 0.2rem;
		border: 0;
		background: transparent;
		color: #52627c;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}
	:global(.activity-comment-delete:hover),
	:global(.activity-comment-delete:focus-visible) {
		color: #1f2a44;
	}
	:global(.activity-comment-item + .activity-comment-item) {
		border-top: var(--border-subtle);
	}
	:global(.activity-comment-user) {
		font-weight: 700;
		color: #1e3a5f;
		text-decoration: none;
	}
	:global(.activity-comment-user:hover),
	:global(.activity-comment-user:focus-visible) {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.activity-comment-form {
		display: flex;
		gap: 0.45rem;
		align-items: flex-start;
		flex: 1 1 340px;
		min-width: 240px;
	}
	.activity-comment-form input {
		flex: 1 1 auto;
		min-width: 0;
		border: var(--border-strong);
		border-radius: 999px;
		padding: 0.35rem 0.65rem;
		min-height: 2rem;
		font: inherit;
		font-size: 0.84rem;
		background: #fff;
		box-sizing: border-box;
	}
	.activity-comment-form button {
		border: none;
		border-radius: 999px;
		padding: 0 0.9rem;
		min-width: 3.1rem;
		min-height: 2rem;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		background: var(--color-nav-surface);
		color: var(--color-nav);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		cursor: pointer;
		box-sizing: border-box;
	}
	.activity-comment-feedback {
		margin: 0;
		min-height: 1rem;
		font-size: 0.78rem;
		color: #64748b;
	}
	.activity-comment-feedback[hidden] {
		display: block;
		visibility: hidden;
	}
	@media (max-width: 600px) {
		.activity-social-row {
			flex-wrap: wrap;
		}
	}
	.empty-following-panel {
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface-raised);
		padding: 1rem;
	}
	.empty-copy p,
	.empty-note {
		margin: 0.35rem 0 0;
		color: #444;
	}
	.following-management-grid {
		list-style: none;
		margin: 0;
		padding: 0 0 0.2rem;
		display: flex;
		flex-wrap: nowrap;
		gap: 0.75rem;
		overflow-x: auto;
		max-width: 100%;
		scroll-snap-type: x proximity;
	}
	.following-management-card {
		flex: 0 0 min(255px, 82vw);
		max-width: min(255px, 82vw);
		min-height: 220px;
	}
	@media (max-width: 740px) {
		.activity-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		resolveShelfDropdownFromTarget,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		saveShelfEntryWithRetry,
		toggleShelfMenu
	} from "../lib/shelfClient.ts";

	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const feedbackTimers = new WeakMap();
	const escapeHtml = (value) => String(value || "")
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
	const parseDate = (value) => {
		if (!value) return null;
		const date = new Date(String(value));
		return Number.isNaN(date.getTime()) ? null : date;
	};
	const formatCommentAge = (value) => {
		const date = parseDate(value);
		if (!date) return "";
		const diffMs = Math.max(0, Date.now() - date.getTime());
		const diffHours = diffMs / (1000 * 60 * 60);
		if (diffHours < 24) {
			const roundedHours = Math.max(0, Math.round(diffHours));
			return `${roundedHours} ${roundedHours === 1 ? "hour" : "hours"}`;
		}
		const diffDays = diffHours / 24;
		const roundedDays = Math.max(1, Math.round(diffDays));
		return `${roundedDays} ${roundedDays === 1 ? "day" : "days"}`;
	};
	const renderCommentHtml = (comment) => {
		const username = String(comment?.username || "reader");
		const body = String(comment?.body || "");
		const createdAt = String(comment?.createdAt || "");
		const commentId = Math.max(0, Number(comment?.id || 0) || 0);
		const isMine = !!comment?.isMine && commentId > 0;
		const profileHref = `/profile/${encodeURIComponent(username)}`;
		const ageLabel = formatCommentAge(createdAt);
		return `<p class="activity-comment-item"${commentId > 0 ? ` data-comment-id="${commentId}"` : ""}><span class="activity-comment-head"><a class="activity-comment-user" href="${profileHref}">@${escapeHtml(username)}</a><span class="activity-comment-meta">${ageLabel ? `<span class="activity-comment-age">${escapeHtml(ageLabel)}</span>` : ""}${isMine ? `<button type="button" class="activity-comment-delete" data-action="delete-comment" data-comment-id="${commentId}" aria-label="Delete comment" title="Delete comment">&times;</button>` : ""}</span></span><span class="activity-comment-body">${escapeHtml(body)}</span></p>`;
	};

	document.addEventListener("click", async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const dropdown = resolveShelfDropdownFromTarget(target);
		if (!dropdown) {
			closeShelfMenus(shelfDropdowns);
			return;
		}
		const action = target.closest("[data-action]");
		if (!(action instanceof HTMLElement)) return;
		if (action.dataset.action === "toggle-shelf") {
			toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}
		if (action.dataset.action === "set-shelf") {
			const status = String(action.dataset.status || "want_to_read");
			const entry = buildShelfEntryFromRecord({
				title: dropdown.getAttribute("data-title"),
				author: dropdown.getAttribute("data-author"),
				description: dropdown.getAttribute("data-description"),
				pageCount: dropdown.getAttribute("data-pages"),
				coverUrl: dropdown.getAttribute("data-cover"),
				format: dropdown.getAttribute("data-format"),
				language: dropdown.getAttribute("data-language"),
				isbn10: dropdown.getAttribute("data-isbn10"),
				isbn13: dropdown.getAttribute("data-isbn13")
			}, { status });
			Object.assign(entry, { bookId: Number(dropdown.getAttribute("data-book-id") || 0) || undefined });
			showShelfFeedback(dropdown, "Saving...", feedbackTimers);
			const result = await saveShelfEntryWithRetry(entry, { redirectPath: "/settings#account-settings" });
			if (!result.ok) {
				showShelfFeedback(dropdown, result.message || "Failed to save.", feedbackTimers);
				return;
			}
			setDropdownLabel(dropdown, status);
			setShelvedState(dropdown, true);
			closeShelfMenus(shelfDropdowns);
			showShelfFeedback(dropdown, "Saved.", feedbackTimers);
		}
	});

	document.addEventListener("click", async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const deleteButton = target.closest('[data-action="delete-comment"]');
		if (deleteButton instanceof HTMLButtonElement) {
			const commentId = Number(deleteButton.dataset.commentId || 0);
			if (!Number.isFinite(commentId) || commentId <= 0) return;
			const commentItem = deleteButton.closest(".activity-comment-item");
			const wrap = deleteButton.closest("[data-comments-wrap]");
			const feedback = wrap?.querySelector("[data-comment-feedback]");
			const activityId = Number(wrap?.getAttribute("data-activity-id") || 0);
			deleteButton.disabled = true;
			try {
				const response = await fetch("/api/activity/comments", {
					method: "DELETE",
					credentials: "same-origin",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ commentId, activityId })
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 401) {
					window.location.href = "/?next=/following";
					return;
				}
				if (!response.ok) {
					deleteButton.disabled = false;
					if (feedback instanceof HTMLElement) {
						feedback.hidden = false;
						feedback.textContent = String(data?.error || "Failed to delete comment.");
					}
					return;
				}
				commentItem?.remove();
				if (wrap instanceof HTMLElement) {
					const remaining = wrap.querySelectorAll(".activity-comment-item").length;
					wrap.dataset.commentsEmpty = remaining > 0 ? "0" : "1";
				}
				if (feedback instanceof HTMLElement) {
					feedback.hidden = true;
					feedback.textContent = "";
				}
			} catch {
				deleteButton.disabled = false;
			}
			return;
		}
		const likeButton = target.closest('[data-action="toggle-activity-like"]');
		if (likeButton instanceof HTMLButtonElement) {
			const activityId = Number(likeButton.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) return;
			const currentLiked = String(likeButton.dataset.liked || "") === "1";
			const currentCount = Math.max(0, Number(likeButton.dataset.likeCount || 0) || 0);
			const nextLiked = !currentLiked;
			const nextCount = Math.max(0, currentCount + (nextLiked ? 1 : -1));
			const countNode = likeButton.parentElement?.querySelector("[data-like-count-static]");
			const applyState = (liked, count) => {
				likeButton.dataset.liked = liked ? "1" : "0";
				likeButton.dataset.likeCount = String(Math.max(0, count));
				likeButton.classList.toggle("is-liked", liked);
				likeButton.setAttribute("aria-label", liked ? "Unlike this activity" : "Like this activity");
				likeButton.setAttribute("title", liked ? "Unlike" : "Like");
				const label = likeButton.querySelector(".activity-like-label");
				if (label instanceof HTMLElement) label.textContent = liked ? "Liked" : "Like";
				if (countNode instanceof HTMLElement) countNode.textContent = String(Math.max(0, count));
			};
			applyState(nextLiked, nextCount);
			likeButton.disabled = true;
			try {
				const response = await fetch("/api/activity/like", {
					method: nextLiked ? "POST" : "DELETE",
					credentials: "same-origin",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ activityId })
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 401) {
					window.location.href = "/?next=/following";
					return;
				}
				if (!response.ok) {
					applyState(currentLiked, currentCount);
					return;
				}
				applyState(!!data?.viewerLiked, Math.max(0, Number(data?.likeCount || 0) || 0));
			} catch {
				applyState(currentLiked, currentCount);
			} finally {
				likeButton.disabled = false;
			}
			return;
		}
		const unfollowButton = target.closest('[data-action="unfollow-reader"]');
		if (unfollowButton instanceof HTMLButtonElement) {
			const card = unfollowButton.closest("[data-reader-card]");
			const feedback = card?.querySelector("[data-reader-feedback]");
			const username = String(unfollowButton.dataset.username || "").trim();
			if (!username) return;
			unfollowButton.disabled = true;
			if (card instanceof HTMLElement) card.classList.add("is-removing");
			if (feedback instanceof HTMLElement) {
				feedback.textContent = "Unfollowing...";
				feedback.hidden = false;
			}
			try {
				const response = await fetch("/api/follow", {
					method: "DELETE",
					credentials: "same-origin",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ username })
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok) {
					unfollowButton.disabled = false;
					if (card instanceof HTMLElement) card.classList.remove("is-removing");
					if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to unfollow.");
					return;
				}
				if (feedback instanceof HTMLElement) feedback.textContent = "Unfollowed.";
				if (card instanceof HTMLElement) {
					setTimeout(() => {
						card.remove();
					}, 250);
				}
			} catch {
				unfollowButton.disabled = false;
				if (card instanceof HTMLElement) card.classList.remove("is-removing");
				if (feedback instanceof HTMLElement) feedback.textContent = "Failed to unfollow.";
			}
			return;
		}
		const button = target.closest('[data-action="follow-reader"]');
		if (!(button instanceof HTMLButtonElement)) return;
		const card = button.closest("[data-reader-card]");
		const feedback = card?.querySelector("[data-reader-feedback]");
		const username = String(button.dataset.username || "").trim();
		if (!username) return;
		button.disabled = true;
		if (feedback instanceof HTMLElement) {
			feedback.textContent = "Following...";
			feedback.hidden = false;
		}
		try {
			const response = await fetch("/api/follow", {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ username })
			});
			const data = await response.json().catch(() => ({}));
			if (!response.ok) {
				button.disabled = false;
				if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to follow.");
				return;
			}
			button.textContent = "Following";
			if (feedback instanceof HTMLElement) feedback.textContent = "Added to Following.";
		} catch {
			button.disabled = false;
			if (feedback instanceof HTMLElement) feedback.textContent = "Failed to follow.";
		}
	});

	document.addEventListener("submit", async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLFormElement)) return;
		if (!target.matches("[data-comment-form]")) return;
		event.preventDefault();
		const wrap = target.closest("[data-comments-wrap]");
		if (!(wrap instanceof HTMLElement)) return;
		const activityId = Number(wrap.dataset.activityId || 0);
		if (!Number.isFinite(activityId) || activityId <= 0) return;
		const input = target.querySelector('input[name="comment"]');
		const list = wrap.querySelector("[data-comments-list]");
		const feedback = wrap.querySelector("[data-comment-feedback]");
		const button = target.querySelector("button[type='submit']");
		if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
		const body = String(input.value || "").trim().slice(0, 500);
		if (!body) return;
		input.disabled = true;
		button.disabled = true;
		if (feedback instanceof HTMLElement) {
			feedback.hidden = false;
			feedback.textContent = "Posting...";
		}
		try {
			const response = await fetch("/api/activity/comments", {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ activityId, body })
			});
			const data = await response.json().catch(() => ({}));
			if (response.status === 401) {
				window.location.href = "/?next=/following";
				return;
			}
			if (!response.ok) {
				if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to post comment.");
				return;
			}
			if (list instanceof HTMLElement) {
				const wrapper = document.createElement("div");
				wrapper.innerHTML = renderCommentHtml(data?.comment || {});
				const nextComment = wrapper.firstElementChild;
				if (nextComment) list.append(nextComment);
				wrap.dataset.commentsEmpty = "0";
			}
			input.value = "";
			wrap.dataset.loaded = "1";
			if (feedback instanceof HTMLElement) {
				feedback.hidden = true;
				feedback.textContent = "";
			}
		} catch {
			if (feedback instanceof HTMLElement) {
				feedback.hidden = false;
				feedback.textContent = "Failed to post comment.";
			}
		} finally {
			input.disabled = false;
			button.disabled = false;
		}
	});

	const commentWraps = Array.from(document.querySelectorAll("[data-comments-wrap]"));
	for (const wrap of commentWraps) {
		if (!(wrap instanceof HTMLElement)) continue;
		const activityId = Number(wrap.dataset.activityId || 0);
		if (!Number.isFinite(activityId) || activityId <= 0) continue;
		const list = wrap.querySelector("[data-comments-list]");
		const feedback = wrap.querySelector("[data-comment-feedback]");
			if (feedback instanceof HTMLElement) {
				feedback.hidden = true;
				feedback.textContent = "";
			}
		try {
			const response = await fetch(`/api/activity/comments?activityId=${encodeURIComponent(String(activityId))}`, {
				credentials: "same-origin"
			});
			const data = await response.json().catch(() => ({}));
			if (response.status === 401) {
				window.location.href = "/?next=/following";
				break;
			}
			if (!response.ok) {
				if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to load comments.");
				continue;
			}
			if (list instanceof HTMLElement) {
				const comments = Array.isArray(data?.comments) ? data.comments : [];
				const commentsForDisplay = [...comments];
				list.innerHTML = commentsForDisplay.map((comment) => renderCommentHtml(comment)).join("");
				wrap.dataset.commentsEmpty = commentsForDisplay.length > 0 ? "0" : "1";
			}
			wrap.dataset.loaded = "1";
			if (feedback instanceof HTMLElement) feedback.hidden = true;
		} catch {
			if (feedback instanceof HTMLElement) {
				feedback.hidden = false;
				feedback.textContent = "Failed to load comments.";
			}
		}
	}
</script>
