---
import Layout from '../layouts/Layout.astro';

const sectionLinks = [
	{ id: "support", label: "Support" },
	{ id: "roadmap", label: "Roadmap" }
];

const SUPPORT_LINKS = {
	buyMeACoffee: "https://buymeacoffee.com/wylie"
};

const roadmapItems = [
	{
		status: "Now",
		title: "Security + Dependency Maintenance",
		description: "Resolve flagged dependency vulnerabilities and keep dependency updates part of the regular maintenance rhythm."
	},
	{
		status: "Now",
		title: "Admin/Data Health Dashboard",
		description: "Surface missing covers/authors/genres, duplicate clusters, failed imports, and backfill progress in one maintenance view."
	},
	{
		status: "Next",
		title: "Reader Onboarding v2",
		description: "Guide new readers through importing, setting favorites, following people, and rating a few read books."
	},
	{
		status: "Next",
		title: "Shelf Editing Controls",
		description: "Add easier bulk edits, move/remove actions, metadata fixes, and duplicate management from one library view."
	},
	{
		status: "Next",
		title: "SEO Foundation Pass",
		description: "Improve crawlability and discoverability with tighter metadata, structured data, internal linking, and index/sitemap hygiene."
	},
	{
		status: "Next",
		title: "Ratings + Taste Signals",
		description: "Use ratings, follows, favorite books, and shelf behavior to improve recommendations and reader discovery."
	},
	{
		status: "Next",
		title: "Recommendations v1",
		description: "Ship lightweight “because you shelved X” recommendations from genre and author overlap."
	},
	{
		status: "Next",
		title: "Richer Metrics Views",
		description: "Expand drill-downs from authors to genres, tags, and location snapshots with cleaner exportable views."
	},
	{
		status: "Next",
		title: "Accessibility Pass",
		description: "Tighten keyboard flows, focus states, screen-reader labels, reduced motion, and contrast across core workflows."
	},
	{
		status: "Next",
		title: "Mobile Reading Workflow Pass",
		description: "Tune add-to-shelf, progress updates, ratings, and search specifically for small screens."
	},
	{
		status: "Next",
		title: "Library Export Improvements",
		description: "Export filtered shelves, ratings, progress, and profile data in friendlier CSV and JSON formats."
	},
	{
		status: "Later",
		title: "Reading Trends Over Time",
		description: "Add month-over-month trend lines for genres, completion rates, and reading velocity."
	},
	{
		status: "Later",
		title: "Review Notes / Private Notes",
		description: "Let readers add private notes or short public blurbs to rated and read books."
	},
	{
		status: "Later",
		title: "Public Sharing Cards",
		description: "Create polished preview cards for profiles, books, shelves, and reading goals when shared."
	},
	{
		status: "Later",
		title: "Notification Preferences + Email Digests",
		description: "Add per-user digest preferences for follows, ratings, and reading activity before browser notifications."
	},
	{
		status: "Later",
		title: "Browser Notifications",
		description: "Add opt-in browser notifications for key events like follows, reading reminders, and activity digests with per-user controls."
	},
	{
		status: "Later",
		title: "Audiobooks Support",
		description: "Add audiobook-specific search, edition handling, and shelf views once core book workflows are fully stable."
	},
	{
		status: "Finished",
		title: "Import Pipeline Reliability",
		description: "Made Goodreads/CSV imports idempotent with dry-run planning, duplicate protection, retrying sync, and clearer progress."
	},
	{
		status: "Finished",
		title: "Data Quality & Metadata Backfills",
		description: "Added recurring metadata backfill orchestration, scheduled automation, and quality coverage reporting for authors/books."
	},
	{
		status: "Finished",
		title: "Performance & Caching Pass",
		description: "Added cache headers/runtime memoization for read APIs and capped heavy metrics payload generation for faster repeat loads."
	},
	{
		status: "Finished",
		title: "Production QA + Monitoring",
		description: "Added CI smoke coverage for critical endpoints plus scheduled production health/API checks with automatic issue alerts."
	},
	{
		status: "Finished",
		title: "Rating UX Polish",
		description: "Cleaned up editable rating controls, rating feedback, clear actions, and community-versus-personal rating presentation."
	},
	{
		status: "Finished",
		title: "Release Workflow + Main Protection",
		description: "Added semantic versioning, changelog tracking, GitHub Releases, CI checks, and branch protection rules for main."
	},
	{
		status: "Finished",
		title: "Following Activity Feed",
		description: "Shipped Following as a logged-in activity page with reader discovery, follow management, and followed-reader shelf activity."
	},
	{
		status: "Finished",
		title: "Book Ratings",
		description: "Let readers rate books from key surfaces and feed those ratings into profile, activity, and book pages."
	},
	{
		status: "Finished",
		title: "Profile & Library Polish",
		description: "Refined profile pages, responsive book cards, mobile navigation, section highlighting, and book metadata presentation."
	},
	{
		status: "Finished",
		title: "New Account Creation",
		description: "Added a clear sign-up flow so new readers can create an account, set a username, and land in profile setup."
	},
	{
		status: "Finished",
		title: "Genre Cleanup & Normalization",
		description: "Deduplicate genres, split combo genres, and standardize genre names/slugs so shelves and discovery stay clean."
	},
	{
		status: "Finished",
		title: "Shelf & Search Reliability",
		description: "Improve add-to-shelf flows, deduplication, and search result quality so the core reading workflow is dependable."
	},
	{
		status: "Finished",
		title: "Public Profiles + Follow Graph Foundations",
		description: "Shipped public profile privacy gates, follow relationships, and profile activity views for multi-user groundwork."
	},
	{
		status: "Finished",
		title: "Auth & Account Hardening",
		description: "Tighten sign-in/session behavior, account recovery, and auth error handling so onboarding is stable."
	},
	{
		status: "Finished",
		title: "Centralized Auth State + Local Auth Preview",
		description: "Unified auth handling across the site with localhost-only auth state preview switching for fast UX checks."
	},
	{
		status: "Finished",
		title: "Reusable Book Card System",
		description: "Standardized book display UI across index, profile, search, and book pages with shared components."
	},
	{
		status: "Finished",
		title: "Core Site Setup & Stabilization",
		description: "Finish baseline setup, tighten navigation and mobile UX, and make key pages feel consistent and reliable."
	}
];

const statusOrder: Record<string, number> = { Now: 0, Next: 1, Later: 2 };
const activeRoadmapItems = roadmapItems
	.filter((item) => item.status !== "Finished")
	.sort((a, b) => (statusOrder[a.status] ?? 99) - (statusOrder[b.status] ?? 99));
const finishedRoadmapItems = roadmapItems.filter((item) => item.status === "Finished");

const supportOptions = [
	{
		title: "One-Time Support",
		description: "Contribute once to help cover hosting, APIs, and development time.",
		cta: "Buy Me a Coffee",
		href: SUPPORT_LINKS.buyMeACoffee,
		share: false
	},
	{
		title: "Share With Readers",
		description: "Sharing the project is one of the fastest ways to help it grow.",
		cta: "Share Dogeared",
		href: "",
		share: true
	}
];
---

<Layout title="Roadmap" sectionLinks={sectionLinks}>
	<div slot="right" class="roadmap-page">
		<header class="hero">
			<h1>What’s coming next for Dogeared, and how readers can help.</h1>
		</header>

		<section id="support" class="panel panel-plain support-panel">
			<div class="support-feature">
				<div>
					<p class="feature-eyebrow">Support Dogeared</p>
					<h2>Help keep Dogeared independent and improving.</h2>
					<p>Your support helps cover hosting and gives me more time to ship the roadmap faster.</p>
				</div>
				<a class="support-feature-cta" href={SUPPORT_LINKS.buyMeACoffee} target="_blank" rel="noopener noreferrer">Buy Me a Coffee</a>
			</div>
			<div class="panel-head">
				<h2>Support Dogeared</h2>
				<p>More ways readers can support the site and help fund new features.</p>
			</div>
			<div class="support-grid">
				{supportOptions.map((option) => (
					<article class="support-card">
						<h3>{option.title}</h3>
						<p>{option.description}</p>
						{option.href ? (
							<a class="support-cta" href={option.href} target="_blank" rel="noopener noreferrer">{option.cta}</a>
						) : (
							<button type="button" class="support-cta ghost" data-share={option.share ? "true" : "false"}>{option.cta}</button>
						)}
					</article>
				))}
			</div>
		</section>

		<section id="roadmap" class="panel panel-plain">
			<div class="panel-head">
				<h2>Roadmap</h2>
				<p>Upcoming additions planned for Dogeared.</p>
			</div>
			<div class="roadmap-grid">
				{activeRoadmapItems.map((item, index) => (
					<article class="roadmap-item">
						<div class="roadmap-item-head">
							<p class={`status-pill status-${item.status.toLowerCase()}`}>{item.status}</p>
							<p class="rank-pill">#{index + 1}</p>
						</div>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
			{finishedRoadmapItems.length > 0 && (
				<>
					<div class="panel-head finished-head">
						<h3>Finished</h3>
					</div>
					<div class="roadmap-grid finished-grid">
						{finishedRoadmapItems.map((item, index) => (
							<article class="roadmap-item roadmap-item-finished">
								<div class="roadmap-item-head">
									<p class="status-pill status-finished">Finished</p>
									<p class="rank-pill finished-rank-pill">#{index + 1}</p>
								</div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</article>
						))}
					</div>
				</>
			)}
		</section>

	</div>
</Layout>

<script>
	const shareButtons = Array.from(document.querySelectorAll("[data-share='true']"));
	shareButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const url = window.location.origin;
			try {
				if (navigator.share) {
					await navigator.share({ title: "Dogeared", text: "Check out Dogeared", url });
					return;
				}
			} catch {
				// no-op
			}
			try {
				await navigator.clipboard.writeText(url);
				if (button instanceof HTMLButtonElement) button.textContent = "Link Copied";
				window.setTimeout(() => {
					if (button instanceof HTMLButtonElement) button.textContent = "Share Dogeared";
				}, 1600);
			} catch {
				window.open(url, "_blank", "noopener,noreferrer");
			}
		});
	});
</script>

<style>
	.roadmap-page { max-width: 960px; }
	.hero { margin-bottom: 1rem; }
	.eyebrow { margin: 0 0 0.35rem; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6a5c3d; }
	.roadmap-page h1 { margin: 0; line-height: 1.05; font-size: clamp(2rem, 3.8vw, 3.4rem); }
	.panel { margin-top: 0.9rem; border: none; border-radius: 12px; background: #fff; padding: 0.8rem; }
	.panel-plain { border: none; background: transparent; padding: 0; border-radius: 0; }
	.panel-head h2 { margin: 0; }
	.panel-head p { margin: 0.3rem 0 0; color: #515151; }
	.roadmap-grid { margin-top: 0.7rem; display: grid; gap: 0.6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.roadmap-item { border: none; border-radius: 12px; padding: 0.75rem; background: #fcfbf8; }
	.roadmap-item-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
	.roadmap-item h3 { margin: 0.35rem 0 0; font-size: 1rem; }
	.roadmap-item p { margin: 0.45rem 0 0; color: #4f4f4f; line-height: 1.5; }
	.status-pill { display: inline-flex; margin: 0; border-radius: 999px; padding: 0.14rem 0.5rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
	.rank-pill { display: inline-flex; margin: 0; border-radius: 999px; background: #c7e2b8; color: #21351a; padding: 0.15rem 0.48rem; font-size: 0.8rem; font-weight: 700; line-height: 1.2; }
	.status-now { background: #d7f1df; color: #176339; }
	.status-next { background: #f6ebcf; color: #7a5a19; }
	.status-later { background: #e8e8e8; color: #5e5e5e; }
	.status-finished { background: #dbeafe; color: #1e40af; }
	.finished-rank-pill { background: #e2e8f0; color: #475569; }
	.finished-head { margin-top: 0.9rem; }
	.finished-head h3 { margin: 0; font-size: 1rem; }
	.finished-grid { margin-top: 0.45rem; }
	.roadmap-item-finished { background: #f8fbff; }
	.support-grid { margin-top: 0.7rem; display: grid; gap: 0.6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.support-card { border: none; border-radius: 12px; padding: 0.75rem; background: #fcfbf8; display: flex; flex-direction: column; min-height: 180px; }
	.support-card h3 { margin: 0; font-size: 1rem; }
	.support-card p { margin: 0.45rem 0 0; color: #4f4f4f; line-height: 1.5; }
	.support-feature { margin-bottom: 0.75rem; border: none; background: linear-gradient(135deg, #f8f2e4 0%, #fdfaf3 100%); border-radius: 12px; padding: 0.8rem; display: flex; justify-content: space-between; gap: 0.75rem; align-items: center; }
	.feature-eyebrow { margin: 0; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; color: #735d34; font-weight: 700; }
	.support-feature h2 { margin: 0.24rem 0 0; font-size: clamp(1.15rem, 2.2vw, 1.6rem); }
	.support-feature p { margin: 0.33rem 0 0; color: #4f4f4f; max-width: 54ch; }
	.support-feature-cta { flex: 0 0 auto; text-decoration: none; border-radius: 999px; background: #121212; color: #fff; padding: 0.58rem 0.86rem; font-weight: 700; }
	.support-feature-cta:hover { background: #2f8f57; }
	.support-cta { margin-top: auto; align-self: flex-start; text-decoration: none; border: none; background: #1f1f1f; color: #fff; border-radius: 999px; padding: 0.5rem 0.75rem; font: inherit; font-size: 0.83rem; cursor: pointer; }
	.support-cta:hover { background: #2f8f57; }
	.support-cta.ghost { background: #efe9da; color: #4c3d21; }
	.support-cta.ghost:hover { background: #e4ddcd; }
	.support-hint { margin: 0.7rem 0 0; font-size: 0.84rem; color: #5d5d5d; }
	.support-hint code { background: #f1efe9; border-radius: 6px; padding: 0.1rem 0.28rem; }
	@media (max-width: 980px) {
		.support-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 720px) {
		.support-feature { flex-direction: column; align-items: flex-start; }
		.roadmap-grid,
		.support-grid { grid-template-columns: 1fr; }
	}
</style>
