---
import Layout from "../layouts/Layout.astro";
import { getNeonSql } from "../lib/neon";
import { loadPublishedReleases, releaseLines, type ReleaseRecord } from "../lib/releases";
import { ROADMAP_ITEMS, ROADMAP_SECTIONS, RECENTLY_COMPLETED_ITEMS, type RoadmapCategory, type RoadmapItem } from "../lib/roadmap";
import { buildBreadcrumbList } from "../lib/seo";

export const prerender = false;

const sectionLinks = [
	{ id: "now", label: "Now" },
	{ id: "next", label: "Next" },
	{ id: "later", label: "Later" },
	{ id: "recently-shipped", label: "Shipped" },
	{ id: "recently-completed", label: "Completed" }
];
const shippedReleases = await loadPublishedReleases(getNeonSql(), 3).catch(() => [] as ReleaseRecord[]);

const roadmapStructuredData = JSON.stringify(buildBreadcrumbList([
	{ name: "Home", item: "/" },
	{ name: "Roadmap", item: "/roadmap" }
], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV }));

const itemsByCategory = ROADMAP_ITEMS.reduce((groups, item) => {
	const current = groups.get(item.category) ?? [];
	current.push(item);
	groups.set(item.category, current);
	return groups;
}, new Map<RoadmapCategory, RoadmapItem[]>());
---

<Layout
	title="Roadmap"
	sectionLinks={sectionLinks}
	metaDescription="See what DogEared is working on now, what is planned next, and what has recently shipped."
	canonicalUrl="/roadmap"
	structuredData={roadmapStructuredData}
>
	<div slot="right" class="roadmap-page">
		<header class="roadmap-hero">
			<p class="eyebrow">Product Roadmap</p>
			<h1>Building a calmer home for serious readers.</h1>
			<p class="hero-copy">
				DogEared is focused on helping readers track books, discover better recommendations, and share reading life without turning it into another feed to manage.
			</p>
		</header>

		<div class="roadmap-sections" aria-label="Roadmap priorities">
			{ROADMAP_SECTIONS.map((section) => {
				const items = itemsByCategory.get(section.id) ?? [];
				return (
					<section id={section.id} class="roadmap-section">
						<div class="section-head">
							<p class="section-kicker">{section.title}</p>
							<h2>{section.title === "Now" ? "What we are improving now" : (section.title === "Next" ? "What comes next" : "Ideas for later")}</h2>
							<p>{section.description}</p>
						</div>
						<div class="roadmap-grid">
							{items.map((item) => (
								<article class="roadmap-card">
									<div class="card-topline">
										<span class={`status-badge status-${item.status.toLowerCase().replace(/\s+/g, "-")}`}>{item.status}</span>
										{item.priority ? <span class="priority-label">{item.priority}</span> : null}
									</div>
									<h3>{item.title}</h3>
									<p>{item.description}</p>
								</article>
							))}
						</div>
					</section>
				);
			})}
		</div>

		<section id="recently-shipped" class="completed-section">
			<div class="section-head">
				<p class="section-kicker">Recently Shipped</p>
				<h2>What readers can use now</h2>
				<p>Automatically sourced from published release notes.</p>
			</div>
			<div class="shipped-grid">
				{shippedReleases.length === 0 ? (
					<article class="completed-card">
						<span class="completed-mark" aria-hidden="true">✓</span>
						<div>
							<h3>Release notes are coming online</h3>
							<p>Published releases will appear here as DogEared moves through the Founding Reader phase.</p>
						</div>
					</article>
				) : shippedReleases.map((release) => (
					<article class="roadmap-card shipped-card">
						<div class="card-topline">
							<span class="status-badge status-completed">{release.version}</span>
							<a href="/release-notes">Release notes</a>
						</div>
						<h3>{release.title}</h3>
						<p>{release.summary}</p>
						{releaseLines(release.highlights).length > 0 && (
							<ul>{releaseLines(release.highlights).slice(0, 3).map((item) => <li>{item}</li>)}</ul>
						)}
					</article>
				))}
			</div>
		</section>

		<section id="recently-completed" class="completed-section">
			<div class="section-head">
				<p class="section-kicker">Recently Completed</p>
				<h2>Meaningful work already shipped</h2>
				<p>A short snapshot of recent improvements, not a full changelog.</p>
			</div>
			<div class="completed-grid">
				{RECENTLY_COMPLETED_ITEMS.map((item) => (
					<article class="completed-card">
						<span class="completed-mark" aria-hidden="true">✓</span>
						<div>
							<div class="card-topline">
								<h3>{item.title}</h3>
								<span class="status-badge status-completed">{item.status}</span>
							</div>
							<p>{item.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.roadmap-page {
		max-width: 980px;
	}
	.roadmap-hero {
		padding: 0.25rem 0 1.4rem;
		border-bottom: var(--border-subtle);
	}
	.eyebrow,
	.section-kicker {
		margin: 0 0 0.4rem;
		font-size: 0.76rem;
		font-weight: 760;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-subtle);
	}
	.roadmap-page h1 {
		margin: 0;
		max-width: 12ch;
		font-size: clamp(2.15rem, 4vw, 3.65rem);
		font-weight: 580;
		line-height: 1.04;
	}
	.hero-copy {
		margin: 0.85rem 0 0;
		max-width: 66ch;
		color: var(--color-text-muted);
		font-size: 1.02rem;
		line-height: 1.65;
	}
	.roadmap-sections {
		display: grid;
		gap: 1.35rem;
		margin-top: 1.35rem;
	}
	.roadmap-section,
	.completed-section {
		padding-top: 1.2rem;
		border-top: var(--border-subtle);
	}
	.roadmap-section:first-child {
		padding-top: 0;
		border-top: 0;
	}
	.section-head {
		display: grid;
		gap: 0.22rem;
		max-width: 68ch;
	}
	.section-head h2 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(1.35rem, 2vw, 1.75rem);
		font-weight: 680;
		line-height: 1.18;
	}
	.section-head p:last-child {
		margin: 0.15rem 0 0;
		color: var(--color-text-muted);
		line-height: 1.55;
	}
	.roadmap-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.72rem;
		margin-top: 0.78rem;
	}
	.roadmap-card,
	.completed-card {
		background: rgba(255, 255, 255, 0.68);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-xs);
	}
	.roadmap-card {
		display: flex;
		flex-direction: column;
		min-height: 168px;
		padding: 0.86rem;
	}
	.card-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
	}
	.roadmap-card h3,
	.completed-card h3 {
		margin: 0;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 680;
		line-height: 1.25;
	}
	.roadmap-card h3 {
		margin-top: 0.58rem;
	}
	.roadmap-card p,
	.completed-card p {
		margin: 0.45rem 0 0;
		color: var(--color-text-muted);
		line-height: 1.54;
	}
	.status-badge,
	.priority-label {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		border-radius: 999px;
		padding: 0 0.58rem;
		font-size: 0.74rem;
		font-weight: 720;
		line-height: 1;
		white-space: nowrap;
	}
	.status-in-progress {
		background: var(--color-nav-surface);
		color: var(--color-nav-active);
	}
	.status-planning {
		background: #f5ead3;
		color: #73521a;
	}
	.status-research {
		background: #edf5fb;
		color: #365f7a;
	}
	.status-future {
		background: #eef1f2;
		color: #4f5e66;
	}
	.status-completed {
		background: #edf4e8;
		color: #1f5138;
	}
	.priority-label {
		color: var(--color-text-subtle);
		background: rgba(255, 255, 255, 0.64);
	}
	.completed-section {
		margin-top: 1.45rem;
	}
	.completed-grid {
		display: grid;
		gap: 0.58rem;
		margin-top: 0.78rem;
	}
	.shipped-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.72rem;
		margin-top: 0.78rem;
	}
	.shipped-card {
		min-height: 0;
	}
	.shipped-card a {
		color: var(--color-nav);
		font-size: 0.78rem;
		font-weight: 800;
		text-decoration: none;
	}
	.shipped-card a:hover {
		color: var(--color-nav-hover);
		text-decoration: underline;
	}
	.shipped-card ul {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
		color: var(--color-text-muted);
		line-height: 1.45;
	}
	.completed-card {
		display: grid;
		grid-template-columns: 28px minmax(0, 1fr);
		gap: 0.62rem;
		padding: 0.76rem 0.82rem;
	}
	.completed-mark {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 999px;
		background: var(--color-nav-surface);
		color: var(--color-nav-active);
		font-weight: 800;
		line-height: 1;
	}
	.completed-card .card-topline {
		align-items: flex-start;
	}
	.completed-card .status-badge {
		flex: 0 0 auto;
	}
	@media (max-width: 720px) {
		.roadmap-page h1 {
			max-width: none;
		}
		.roadmap-grid {
			grid-template-columns: 1fr;
		}
		.shipped-grid {
			grid-template-columns: 1fr;
		}
		.card-topline {
			align-items: flex-start;
		}
		.completed-card .card-topline {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
