---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import ShelfDropdown from '../components/ShelfDropdown.astro';
import Chip from '../components/Chip.astro';
import RatingControl from '../components/RatingControl.astro';
import { resolveUserBySession } from '../lib/auth';
import { getNeonSql } from '../lib/neon';
import { formatPublishedLabel, resolvePublicHomeSections, type BrowseSection } from "../lib/homeSections";

export const prerender = false;
const shouldProfileHome = import.meta.env.DEV;
const homeSsrStarted = performance.now();

function logHomeTiming(label: string, durationMs: number) {
	if (!shouldProfileHome) return;
	console.info(`[home:ssr] ${label}: ${durationMs.toFixed(1)}ms`);
}

async function timedSsr<T>(label: string, loader: () => Promise<T>) {
	const start = performance.now();
	try {
		return await loader();
	} finally {
		logHomeTiming(label, performance.now() - start);
	}
}

function renderStars(value: number) {
	const rounded = Math.round(Math.max(0, Math.min(5, Number(value) || 0)));
	return Array.from({ length: 5 }, (_, index) => (index < rounded ? "★" : "☆")).join("");
}

let session: Awaited<ReturnType<typeof resolveUserBySession>> = null;
try {
	session = await timedSsr("session", () => resolveUserBySession(Astro.request));
} catch (error) {
	console.error("Home session lookup failed; rendering as logged out.", error);
}
const isAuthenticated = !!session?.userId;

type ShelfIdea = {
	name: string;
	description: string;
	exampleBooks: string[];
	icon: string;
};

let sections: BrowseSection[] = [];
let errorMessage = "";
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let viewerRatingByBookId = new Map<number, number>();
let onboardingProgress = {
	totalBooks: 0,
	ratedBooks: 0,
	finishedWithReview: 0,
	follows: 0,
	profileComplete: false
};
const shelfIdeas: ShelfIdea[] = [
	{
		name: "Weekend One-Sitting Reads",
		description: "Short, high-momentum books under ~260 pages for quick wins.",
		exampleBooks: ["Project Hail Mary", "Piranesi", "The Sense of an Ending"],
		icon: "bolt"
	},
	{
		name: "Books That Explain the News",
		description: "Evergreen primers for policy, economics, and world context.",
		exampleBooks: ["The Fifth Risk", "The Deficit Myth", "The World for Sale"],
		icon: "public"
	},
	{
		name: "Comfort Re-Reads",
		description: "Reliable mood reset books worth returning to each year.",
		exampleBooks: ["A Wrinkle in Time", "Anne of Green Gables", "The Hobbit"],
		icon: "self_improvement"
	}
];

try {
	const sql = getNeonSql();
	sections = await resolvePublicHomeSections({ onTiming: logHomeTiming });
	if (session?.userId && sections.length > 0) {
		const bookIds = Array.from(new Set(
			sections
				.flatMap((section) => section.books)
				.map((book) => Number(String(book.id || "").replace(/^book_/, "")))
				.filter((value) => Number.isFinite(value) && value > 0)
		));
		if (bookIds.length > 0) {
			const statusRows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>>`
				select book_id, status, rating
				from user_book
				where user_id = ${session.userId}::uuid
					and book_id = any(${bookIds}::bigint[])
			`;
			viewerStatusByBookId = new Map(
				statusRows.map((row) => [Number(row.book_id || 0), row.status])
			);
			viewerRatingByBookId = new Map(
				statusRows.map((row) => [Number(row.book_id || 0), Math.max(0, Math.min(5, Number(row.rating || 0) || 0))])
			);
		}
	}
	if (session?.userId) {
		try {
			const [bookRows, followRows, profileRows] = await Promise.all([
				sql<Array<{ total_books: number; rated_books: number; finished_with_review: number }>>`
					select
						count(*)::int as total_books,
						count(*) filter (where rating is not null)::int as rated_books,
						count(*) filter (where status = 'finished' and char_length(trim(coalesce(finished_reflection, ''))) > 0)::int as finished_with_review
					from user_book
					where user_id = ${session.userId}::uuid
				`,
				sql<Array<{ follows: number }>>`
					select count(*)::int as follows
					from user_follow
					where follower_user_id = ${session.userId}::uuid
				`,
				sql<Array<{ profile_data: unknown }>>`
					select profile_data
					from app_user
					where id = ${session.userId}::uuid
					limit 1
				`
			]);
			const profileData = (profileRows[0]?.profile_data && typeof profileRows[0]?.profile_data === "object")
				? profileRows[0].profile_data as Record<string, unknown>
				: {};
			onboardingProgress = {
				totalBooks: Math.max(0, Number(bookRows[0]?.total_books || 0)),
				ratedBooks: Math.max(0, Number(bookRows[0]?.rated_books || 0)),
				finishedWithReview: Math.max(0, Number(bookRows[0]?.finished_with_review || 0)),
				follows: Math.max(0, Number(followRows[0]?.follows || 0)),
				profileComplete: !!String(profileData.blurb || "").trim()
			};
		} catch (error) {
			console.error("Home onboarding progress query failed.", error);
		}
	}
} catch (error) {
	console.error("Home shelves query failed.", error);
	errorMessage = "Live home shelves are temporarily unavailable.";
}
const isOnboardingComplete = (
	onboardingProgress.totalBooks > 0
	&& onboardingProgress.ratedBooks > 0
	&& onboardingProgress.finishedWithReview > 0
	&& onboardingProgress.follows > 0
	&& onboardingProgress.profileComplete
);
logHomeTiming("total-before-render", performance.now() - homeSsrStarted);
---

<Layout
	title="Home"
	metaDescription="Discover books readers are shelving right now on DogEared. Track your reading, save books, and find your next favorite."
	canonicalUrl="/"
>
	<div slot="right" class="browse-page" id="browse-page" data-authenticated={String(isAuthenticated)}>
		<header class="intro">
			<h1>Find your next book.<br/>Keep your reading life your own.</h1>
			<p class="subhead">Browse popular shelves, save what matters, and build your reading history without the noise.</p>
		</header>
		{isAuthenticated && !isOnboardingComplete && (
			<section class="onboarding-checklist" data-onboarding-checklist>
				<div class="checklist-head">
					<h2>Getting Started</h2>
					<button type="button" class="checklist-dismiss" data-action="dismiss-onboarding-checklist">Dismiss</button>
				</div>
				<p class="checklist-copy">These steps help DogEared learn your taste faster and improve recommendations.</p>
				<ul>
					<li class={onboardingProgress.totalBooks > 0 ? "is-done" : ""}>{onboardingProgress.totalBooks > 0 ? "Done" : "Next"}: Add your first book to a shelf.</li>
					<li class={onboardingProgress.ratedBooks > 0 ? "is-done" : ""}>{onboardingProgress.ratedBooks > 0 ? "Done" : "Next"}: Rate a book you finished.</li>
					<li class={onboardingProgress.finishedWithReview > 0 ? "is-done" : ""}>{onboardingProgress.finishedWithReview > 0 ? "Done" : "Next"}: Write one short review.</li>
					<li class={onboardingProgress.follows > 0 ? "is-done" : ""}>{onboardingProgress.follows > 0 ? "Done" : "Next"}: Follow a reader you trust.</li>
					<li class={onboardingProgress.profileComplete ? "is-done" : ""}>{onboardingProgress.profileComplete ? "Done" : "Next"}: Add a profile blurb so readers can find you.</li>
				</ul>
			</section>
		)}
		{!errorMessage && sections.length > 0 && (
			<nav class="home-jump-links" aria-label="Jump to discovery sections">
				{sections.map((section) => (
					<a href={`#${section.id}`}>{section.title}</a>
				))}
			</nav>
		)}

		{errorMessage && <p class="error">{errorMessage}</p>}
		{!errorMessage && sections.length === 0 && (
			<p class="empty">
				We do not have enough personalized data yet. Start by searching for a favorite book, add it to a shelf, and rate one finished read.
			</p>
		)}

		{!errorMessage && sections.length > 0 && (
			<>
				{sections.map((section, sectionIndex) => (
					<>
					<section id={section.id} class="browse-section">
						<div class="section-head">
							<div>
								<h2>{section.title}</h2>
								<p class="section-explanation">{section.subtitle}</p>
							</div>
						</div>
						{section.books.length === 0 && <p class="empty">{section.emptyState || "No community recommendations found yet."}</p>}
						{section.books.length > 0 && (
							<ul class="book-grid">
								{section.books.map((book, index) => {
									const numericBookId = Number(String(book.id || "").replace(/^book_/, ""));
									const titleHref = book.titleHref || `/book?bookId=${encodeURIComponent(String(book.id).replace(/^book_/, ""))}`;
									const hasPersonalRatingControl = viewerStatusByBookId.get(numericBookId) === "finished";
									const viewerRating = Math.max(0, Math.min(5, Number(viewerRatingByBookId.get(numericBookId) || 0)));
									const displayAverageRating = Number(book.averageRating || 0) > 0
										? Number(book.averageRating || 0)
										: viewerRating;
									const reviewRating = Math.max(0, Math.min(5, Number(book.reviewRating || 0) || 0));
									return (
										<BookCard
										title={book.title}
										titleHref={titleHref}
										author={book.authors.length > 0 ? book.authors.join(", ") : "Unknown author"}
										authorHref={book.authors.length === 1 && book.authors[0] ? book.authorHref : ""}
										thumbnail={book.thumbnail}
										description={book.reviewSnippet ? `“${book.reviewSnippet}”` : (book.description || "Synopsis unavailable for this edition.")}
										readers={book.shelfCount}
										shelfEntries={book.shelfCount}
										publishedLabel={book.publishedDate ? formatPublishedLabel(book.publishedDate) : ""}
										pageCount={book.pageCount}
										averageRating={displayAverageRating}
									>
										{book.discoveryReason && (
											<p slot="preTitle" class="discovery-reason">{book.discoveryReason}</p>
										)}
										<div slot="footer" class="rank-stack rank-stack-footer">
											<Chip className="rank-badge" label={`#${index + 1}`} />
										</div>
										<div slot="meta">
											{hasPersonalRatingControl && (
												<RatingControl
													bookId={String(numericBookId)}
													rating={viewerRating}
													editable={true}
												/>
											)}
										</div>
										{book.reviewerName && (
											<p slot="preMeta" class="review-attribution">
												Reviewed by{" "}
												{book.reviewerHref
													? <a href={book.reviewerHref}>@{book.reviewerName.replace(/^@+/, "")}</a>
													: book.reviewerName}
												{reviewRating > 0 && (
													<span> · {renderStars(reviewRating)} {reviewRating}/5</span>
												)}
											</p>
										)}
										<div slot="actions">
											<ShelfDropdown attrs={{
												'data-book-id': String(book.id || "").replace(/^book_/, ""),
												'data-initial-status': viewerStatusByBookId.get(Number(String(book.id || "").replace(/^book_/, ""))) || "",
												'data-title': book.title,
												'data-author': book.authors[0] ?? "",
												'data-description': book.description,
												'data-pages': String(book.pageCount ?? 0),
												'data-cover': book.thumbnail,
												'data-format': book.format,
												'data-language': book.language,
												'data-isbn10': book.isbn10 ?? "",
												'data-isbn13': book.isbn13 ?? "",
												'data-source': book.source,
												'data-source-work-id': book.sourceWorkId ?? "",
												'data-source-edition-id': book.sourceEditionId ?? "",
												'data-source-url': book.sourceUrl ?? ""
											}} />
										</div>
									</BookCard>
									);
								})}
							</ul>
						)}
					</section>
					{((sectionIndex === 1 && isAuthenticated) || sectionIndex === 4) && (
						<section class="browse-section community-discovery-section">
							<div class="section-head">
								<h2>{sectionIndex === 1 ? "Readers You Might Like" : "Custom Shelf Ideas"}</h2>
							</div>
							{sectionIndex === 1 ? (
								<ul class="community-suggestion-grid" data-reader-suggestions aria-busy="true">
									{Array.from({ length: 3 }, () => (
										<li class="community-suggestion-card community-suggestion-skeleton" aria-hidden="true">
											<span></span>
											<span></span>
											<span></span>
										</li>
									))}
								</ul>
							) : (
								<ul class="community-suggestion-grid">
									{shelfIdeas.map((idea) => (
										<li class="community-suggestion-card">
											<h3>{idea.name}</h3>
											<p>{idea.description}</p>
											<div class="suggestion-chip-row">
												{idea.exampleBooks.map((title) => <Chip className="shelf-count-badge" label={title} />)}
											</div>
											<button
												type="button"
												class="mock-shelf-add-button"
												data-action="create-mock-shelf"
												data-shelf-name={idea.name}
												data-shelf-icon={idea.icon}
											>
												Add Shelf
											</button>
										</li>
									))}
								</ul>
							)}
						</section>
					)}
					</>
				))}
			</>
		)}
	</div>
</Layout>

<style>
	.browse-page {
		max-width: 1020px;
	}

	.intro {
		margin-bottom: 2.15rem;
		min-width: 0;
	}
	.home-jump-links {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.45rem;
		margin: -0.1rem 0 1.2rem;
		overflow-x: auto;
		overflow-y: hidden;
		white-space: nowrap;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior-x: contain;
		position: sticky;
		top: var(--mobile-sticky-offset, 0px);
		z-index: 25;
  	background-color: var(--background-color);
		padding: 0.5rem 0.25rem 0.55rem;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		--home-jump-links-offset: 40px;
	}
	.home-jump-links::-webkit-scrollbar {
		display: none;
	}
	.home-jump-links a {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		text-decoration: none;
		color: var(--color-nav);
		background: var(--color-nav-surface);
		border: var(--border-subtle);
		border-radius: 999px;
		padding: 0.26rem 0.66rem;
		font-size: 0.82rem;
		font-weight: 680;
		line-height: 1.2;
	}
	.home-jump-links a:hover,
	.home-jump-links a:focus-visible {
		text-decoration: none;
		color: var(--color-nav-hover);
		background: var(--color-nav-surface-hover);
		border-color: var(--color-border);
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-subtle);
	}

	.browse-page h1 {
		margin: 0;
		line-height: 1.08;
		font-weight: 600;
		font-size: clamp(1.85rem, 3.2vw, 2.75rem);
	}

	.subhead {
		margin: 0.9rem 0 0;
		color: var(--color-text-muted);
		max-width: 44rem;
		font-size: 1.06rem;
		line-height: 1.55;
	}

	.error {
		background: #fff1f2;
		color: #9f1239;
		border: 1px solid #fecdd3;
		padding: 0.7rem 0.8rem;
		border-radius: var(--radius-md);
	}
	.onboarding-checklist {
		margin: 0 0 1rem;
		background: rgba(255, 255, 255, 0.56);
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		padding: 0.82rem;
	}
	.checklist-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.checklist-head h2 { margin: 0; font-size: 1rem; }
	.checklist-copy { margin: 0.35rem 0 0; font-size: 0.9rem; color: var(--color-text-muted); }
	.onboarding-checklist ul { margin: 0.5rem 0 0; padding-left: 1rem; display: grid; gap: 0.2rem; }
	.onboarding-checklist li { font-size: 0.9rem; color: #2f3b52; }
	.onboarding-checklist li.is-done { color: #1f7a45; }
	.checklist-dismiss {
		border: none;
		background: transparent;
		color: var(--color-nav);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
		padding: 0.2rem 0.35rem;
	}

	.browse-section {
		margin-top: 1.7rem;
	}

	.section-head {
		position: sticky;
		top: calc(var(--mobile-sticky-offset, 0px) + var(--home-jump-links-offset, 44px) - 12px);
		padding: 0.85rem 0;
  	background-color: var(--background-color);
		z-index: 24;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: clamp(1.25rem, 2vw, 1.65rem);
		line-height: 1.16;
		font-weight: 680;
	}
	.section-explanation {
		margin: 0.2rem 0 0;
		max-width: 42rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		line-height: 1.42;
	}
	.section-head-link {
		font-size: 0.84rem;
		font-weight: 680;
		color: var(--color-nav);
		text-decoration: none;
		white-space: nowrap;
	}
	.section-head-link:hover,
	.section-head-link:focus-visible {
		color: var(--color-nav-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.list-date {
		margin-top: -0.35rem;
		color: var(--color-text-muted);
		font-size: 0.84rem;
	}

	.book-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.95rem;
	}

	.community-discovery-section {
		margin-top: 1.15rem;
	}
	.community-suggestion-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
	}
	.community-suggestion-card {
		background: var(--color-surface-raised);
		border-radius: var(--radius-lg);
		padding: 0.95rem;
		border: var(--border-subtle);
	}
	.community-suggestion-skeleton {
		display: grid;
		gap: 0.55rem;
		min-height: 150px;
	}
	.community-suggestion-skeleton span {
		display: block;
		height: 0.8rem;
		border-radius: var(--radius-pill);
		background: rgba(82, 96, 109, 0.14);
	}
	.community-suggestion-skeleton span:first-child {
		width: 58%;
		height: 1rem;
	}
	.community-suggestion-skeleton span:nth-child(2) {
		width: 92%;
	}
	.community-suggestion-skeleton span:last-child {
		width: 74%;
	}
	.community-suggestion-card h3 {
		margin: 0;
		font-size: 1rem;
	}
	.community-suggestion-card p {
		margin: 0.35rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.suggestion-chip-row {
		margin-top: 0.55rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.reader-follow-button {
		margin-top: 0.65rem;
		border: none;
		border-radius: var(--radius-pill);
		padding: 0.46rem 0.78rem;
		background: #151515;
		color: #fff;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		cursor: pointer;
	}
	.reader-follow-button:disabled {
		opacity: 0.72;
		cursor: not-allowed;
	}
	.reader-feedback {
		margin: 0.35rem 0 0;
		min-height: 1.05rem;
		color: #2f8f57;
		font-size: 0.82rem;
		font-weight: 700;
	}
	.reader-feedback[hidden] {
		display: block;
		visibility: hidden;
	}
	.mock-shelf-add-button {
		margin-top: 0.65rem;
		border: none;
		border-radius: 999px;
		padding: 0.4rem 0.72rem;
		background: var(--color-primary);
		color: #fff;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		cursor: pointer;
	}
	.mock-shelf-add-button.is-added {
		background: #dbe7ef;
		color: #345067;
	}
	.mock-shelf-add-button:disabled {
		opacity: 0.72;
		cursor: not-allowed;
	}

	.rank-stack {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 0.28rem;
		max-width: 100%;
	}
	.rank-stack-footer {
		margin-top: auto;
		padding-top: 0.45rem;
		width: 100%;
	}
	.discovery-reason {
		margin: 0 2rem 0.24rem 0;
		color: var(--color-nav);
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.review-attribution {
		margin: 0.16rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.84rem;
		line-height: 1.35;
	}
	.review-attribution a {
		color: var(--color-nav);
		font-weight: 680;
		text-decoration: none;
	}
	.review-attribution a:hover,
	.review-attribution a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	:global(.shelf-count-badge) {
		white-space: nowrap;
	}

	.rating-meta {
		color: #4d4d4d;
		font-weight: 400;
	}

	.community-rating-meta {
		color: #4d4d4d;
		font-size: 0.87rem;
		font-weight: 400;
	}

	.shelf-dropdown {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.shelf-trigger {
		border: none;
		border-radius: 8px;
		padding: 0.5rem 0.8rem;
		font-size: 0.92rem;
		background: var(--color-primary);
		color: #fff;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.shelf-trigger:hover {
		background: var(--color-primary-hover);
	}

	.shelf-check {
		font-size: 1rem;
		line-height: 1;
		opacity: 0;
