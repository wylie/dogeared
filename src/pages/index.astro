---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import ShelfDropdown from '../components/ShelfDropdown.astro';
import { resolveUserBySession } from '../lib/auth';
import { getNeonSql } from '../lib/neon';
import { formatGenreLabel } from '../lib/genres';

export const prerender = false;
const session = await resolveUserBySession(Astro.request);
const isAuthenticated = !!session?.userId;

type BrowseBook = {
	id: string;
	title: string;
	authors: string[];
	shelfCount: number;
	thumbnail: string;
	publishedDate: string;
	description: string;
	pageCount: number;
	format: string;
	language: string;
	isbn10?: string;
	isbn13?: string;
	averageRating: number;
	ratingCount: number;
	source: "google_books" | "open_library" | "nyt";
	sourceWorkId?: string;
	sourceEditionId?: string;
	sourceUrl?: string;
};

type BrowseSection = {
	id: string;
	title: string;
	subtitle: string;
	books: BrowseBook[];
};

const NON_GENRE_SLUGS = new Set([
	"",
	"all",
	"book-club",
	"books-i-own",
	"currently-reading",
	"default",
	"did-not-finish",
	"dnf",
	"faves",
	"favorites",
	"fiction",
	"general",
	"kindle",
	"library",
	"maybe",
	"owned",
	"physical",
	"read",
	"re-read",
	"reread",
	"tbr",
	"to-buy",
	"to-read",
	"want-to-buy",
	"want-to-own"
]);

function isGenreSlug(slug: string) {
	if (!slug || NON_GENRE_SLUGS.has(slug)) return false;
	if (/^\d{4}(-reads)?$/.test(slug)) return false;
	if (/^\d+$/.test(slug)) return false;
	return true;
}

function formatGenreTitle(slug: string, fallback: string) {
	const source = String(fallback || slug || "").trim();
	return formatGenreLabel(source, "Genre");
}

function formatPublishedLabel(value: string) {
	const text = String(value || "").trim();
	if (!text) return "";
	if (/^\d{4}$/.test(text)) return text;
	if (/^\d{4}-\d{2}$/.test(text)) {
		const parsed = new Date(`${text}-01`);
		if (!Number.isFinite(parsed.getTime())) return text;
		return parsed.toLocaleDateString("en-US", {
			month: "long",
			year: "numeric"
		});
	}
	const parsed = new Date(text);
	if (!Number.isFinite(parsed.getTime())) return text;
	return parsed.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric"
	});
}

function renderAverageStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	const rounded = Math.round(clamped);
	return Array.from({ length: 5 }, (_, index) => (index < rounded ? "★" : "☆")).join("");
}

function sanitizeDescription(value: string, maxLength = 220) {
	const text = String(value || "")
		.replace(/<[^>]+>/g, " ")
		.replace(/\s+/g, " ")
		.trim();
	if (!text) return "";
	if (text.length <= maxLength) return text;
	return `${text.slice(0, maxLength).trimEnd()}…`;
}

let sections: BrowseSection[] = [];
let errorMessage = "";
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();

try {
	const sql = getNeonSql();
	const genreRows = await sql<Array<{
		genre_slug: string;
		genre_name: string;
		book_count: number;
	}>>`
		select
			bg.genre_slug,
			min(bg.genre_name) as genre_name,
			count(distinct bg.book_id) as book_count
		from book_genre bg
		join user_book ub on ub.book_id = bg.book_id
		group by bg.genre_slug
		order by count(distinct bg.book_id) desc, min(bg.genre_name) asc
		limit 24
	`;

	const sectionsConfig = genreRows
		.filter((row) => isGenreSlug(String(row.genre_slug || "").trim()))
		.slice(0, 10)
		.map((row) => {
			const id = String(row.genre_slug || "").trim();
			const title = formatGenreTitle(id, String(row.genre_name || "").trim());
			return {
				id,
				title,
				subtitle: `Books readers on Dogeared are shelving in ${title.toLowerCase()}.`
			};
		});

	const results = await Promise.all(sectionsConfig.map(async (section) => {
		const rows = await sql<Array<{
			book_id: number;
			title: string;
			primary_author: string;
			shelf_count: number;
			synopsis: string;
			cover_url: string;
			published_year: number | null;
			language: string;
			isbn10: string;
			isbn13: string;
			google_books_id: string;
			average_rating: number | null;
			rating_count: number;
			source: "google_books" | "open_library" | "nyt" | null;
			source_work_id: string | null;
			source_edition_id: string | null;
			source_url: string | null;
		}>>`
			with ranked as (
				select book_id
				from get_top_books_by_genre(${section.id}, 20, 3650)
			)
			select
				b.id as book_id,
				b.title,
				b.primary_author,
				coalesce(sc.shelf_count, 0)::int as shelf_count,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				b.cover_url,
				b.published_year,
				b.language,
				b.isbn10,
				b.isbn13,
				b.google_books_id,
				coalesce(ra.average_rating, 0) as average_rating,
				coalesce(ra.rating_count, 0)::int as rating_count,
				bs.source,
				bs.source_work_id,
				bs.source_edition_id,
				bs.source_url
			from ranked r
			join book b on b.id = r.book_id
			left join lateral (
				select count(*)::int as shelf_count
				from user_book ub
				where ub.book_id = b.id
			) sc on true
			left join lateral (
				select
					round(avg(ub.rating)::numeric, 1) as average_rating,
					count(*) filter (where ub.rating is not null) as rating_count
				from user_book ub
				where ub.book_id = b.id
			) ra on true
			left join lateral (
				select
					source,
					source_work_id,
					source_edition_id,
					source_url
				from book_source
				where book_id = b.id
				order by
					case source
						when 'google_books' then 1
						when 'open_library' then 2
						when 'nyt' then 3
						else 9
					end,
					id asc
				limit 1
			) bs on true
			order by coalesce(sc.shelf_count, 0) desc, b.title asc
		`;

		const books: BrowseBook[] = rows.map((row) => ({
			id: `book_${row.book_id}`,
			title: String(row.title || "").trim(),
			authors: [String(row.primary_author || "").trim()].filter(Boolean),
			shelfCount: Number(row.shelf_count || 0),
			thumbnail: String(row.cover_url || "").trim(),
			publishedDate: row.published_year ? String(row.published_year) : "",
			description: sanitizeDescription(String(row.synopsis || "")),
			pageCount: 0,
			format: "Book",
			language: String(row.language || "").trim().toUpperCase(),
			isbn10: String(row.isbn10 || "").trim(),
			isbn13: String(row.isbn13 || "").trim(),
			averageRating: Number(row.average_rating || 0),
			ratingCount: Number(row.rating_count || 0),
			source: row.source || (row.google_books_id ? "google_books" : "open_library"),
			sourceWorkId: String(row.source_work_id || row.google_books_id || "").trim(),
			sourceEditionId: String(row.source_edition_id || "").trim(),
			sourceUrl: String(
				row.source_url ||
				(row.google_books_id ? `https://books.google.com/books?id=${encodeURIComponent(String(row.google_books_id).trim())}` : "")
			).trim()
		}));

		return { ...section, books };
	}));

	sections = results.filter((section) => section.books.length > 0);
	if (session?.userId && sections.length > 0) {
		const bookIds = Array.from(new Set(
			sections
				.flatMap((section) => section.books)
				.map((book) => Number(String(book.id || "").replace(/^book_/, "")))
				.filter((value) => Number.isFinite(value) && value > 0)
		));
		if (bookIds.length > 0) {
			const statusRows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished" }>>`
				select book_id, status
				from user_book
				where user_id = ${session.userId}::uuid
					and book_id = any(${bookIds}::bigint[])
			`;
			viewerStatusByBookId = new Map(
				statusRows.map((row) => [Number(row.book_id || 0), row.status])
			);
		}
	}
} catch (error) {
	errorMessage = error instanceof Error ? error.message : "Failed to load shelves from Dogeared.";
}
---

<Layout title="Home" sectionLinks={sections.map((section) => ({ id: section.id, label: section.title }))}>
	<div slot="right" class="browse-page" id="browse-page" data-authenticated={String(isAuthenticated)}>
		<header class="intro">
			<h1>Find your next book.<br/>Keep your reading life your own.</h1>
			<p class="subhead">Browse popular shelves, save what matters, and build your reading history without the noise.</p>
		</header>

		{errorMessage && <p class="error">Home shelves unavailable: {errorMessage}</p>}
		{!errorMessage && sections.length === 0 && (
			<p class="empty">
				No real genre shelves are ready yet. Right now Dogeared mostly has reading-status shelves rather than subject genres.
			</p>
		)}

		{!errorMessage && sections.length > 0 && (
			<>
				{sections.map((section) => (
					<section id={section.id} class="browse-section">
						<div class="section-head">
							<h2>{section.title}</h2>
							<p>{section.subtitle}</p>
						</div>
						{section.books.length === 0 && <p class="empty">No books found for this shelf yet.</p>}
						{section.books.length > 0 && (
							<ul class="book-grid">
								{section.books.map((book, index) => (
									<BookCard
										title={book.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(book.id).replace(/^book_/, ""))}`}
										author={book.authors.length > 0 ? book.authors.join(", ") : "Unknown author"}
										authorHref={book.authors.length === 1 && book.authors[0] ? `/related?kind=author&value=${encodeURIComponent(book.authors[0])}` : ""}
										thumbnail={book.thumbnail}
										description={book.description || "Synopsis unavailable for this edition."}
									>
										<div slot="topRight" class="rank-stack">
											<div class="rank-badge" aria-label={`Rank ${index + 1}`}>#{index + 1}</div>
											<div class="shelf-count-badge" aria-label={`${book.shelfCount} shelves`}>
												{book.shelfCount.toLocaleString()} {book.shelfCount === 1 ? "shelf" : "shelves"}
											</div>
										</div>
										<div slot="meta">
											{book.publishedDate && <p class="meta">Published: {formatPublishedLabel(book.publishedDate)}</p>}
											{book.ratingCount > 0 && (
												<p class="meta rating-meta">{renderAverageStars(book.averageRating)} {book.averageRating.toFixed(1)} · {book.ratingCount} rating{book.ratingCount === 1 ? "" : "s"}</p>
											)}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												'data-book-id': String(book.id || "").replace(/^book_/, ""),
												'data-initial-status': viewerStatusByBookId.get(Number(String(book.id || "").replace(/^book_/, ""))) || "",
												'data-title': book.title,
												'data-author': book.authors[0] ?? "",
												'data-description': book.description,
												'data-pages': String(book.pageCount ?? 0),
												'data-cover': book.thumbnail,
												'data-format': book.format,
												'data-language': book.language,
												'data-isbn10': book.isbn10 ?? "",
												'data-isbn13': book.isbn13 ?? "",
												'data-source': book.source,
												'data-source-work-id': book.sourceWorkId ?? "",
												'data-source-edition-id': book.sourceEditionId ?? "",
												'data-source-url': book.sourceUrl ?? ""
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
					</section>
				))}
			</>
		)}
	</div>
</Layout>

<style>
	.browse-page {
		max-width: 920px;
	}

	.intro {
		margin-bottom: 1.5rem;
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6a5c3d;
	}

	.browse-page h1 {
		margin: 0;
		line-height: 1.08;
		font-weight: 760;
		font-size: clamp(1.85rem, 3.2vw, 2.75rem);
	}

	.subhead {
		margin: 0.75rem 0 0;
		color: #4d4d4d;
		max-width: 44rem;
		font-size: 1.06rem;
		line-height: 1.55;
	}

	.error {
		background: #fff1f2;
		color: #9f1239;
		border: 1px solid #fecdd3;
		padding: 0.7rem 0.8rem;
		border-radius: 10px;
	}

	.browse-section {
		margin-top: 1.35rem;
	}

	.section-head {
		position: sticky;
		top: 0;
		padding-bottom: .5rem;
		background-color: #efefef;
		z-index: 100;
	}
	.section-head h2 {
		margin: 0;
	}

	.section-head p {
		margin: 0.25rem 0 0.7rem;
		color: #4d4d4d;
		font-size: 0.92rem;
	}

	.list-date {
		margin-top: -0.35rem;
		color: #5f5f5f;
		font-size: 0.84rem;
	}

	.book-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.rank-badge {
		padding: 0.14rem 0.42rem;
		border-radius: 999px;
		background: #f4efe2;
		color: #6a5c3d;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		line-height: 1.2;
	}

	.rank-stack {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.28rem;
	}

	.shelf-count-badge {
		padding: 0.12rem 0.42rem;
		border-radius: 999px;
		background: #f7f7f7;
		color: #5f5f5f;
		font-size: 0.7rem;
		font-weight: 600;
		line-height: 1.2;
		white-space: nowrap;
	}

	.rating-meta {
		color: #8a6a15;
		font-weight: 600;
	}

	.shelf-dropdown {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.shelf-trigger {
		border: none;
		border-radius: 8px;
		padding: 0.5rem 0.8rem;
		font-size: 0.92rem;
		background: #2f8f57;
		color: #fff;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.shelf-trigger:hover {
		background: #267647;
	}

	.shelf-check {
