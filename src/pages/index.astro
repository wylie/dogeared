		opacity: 1;
	}

	.shelf-icon {
		font-size: 1.1rem;
		line-height: 1;
	}

	.shelf-menu {
		position: absolute;
		top: calc(100% + 4px);
		left: 0;
		min-width: 180px;
		background: #fff;
		border: 1px solid #c9c9c9;
		border-radius: 8px;
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
		padding: 0.25rem 0;
		z-index: 25;
	}

	.shelf-option {
		display: block;
		width: 100%;
		text-align: left;
		border: none;
