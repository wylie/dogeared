---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import ShelfDropdown from '../components/ShelfDropdown.astro';
import Chip from '../components/Chip.astro';
import RatingControl from '../components/RatingControl.astro';
import { resolveUserBySession } from '../lib/auth';
import { getNeonSql } from '../lib/neon';
import { formatGenreLabel } from '../lib/genres';
import { authorHref } from '../lib/author';
import { resolvePublicReaderSuggestions } from "../lib/feed";

export const prerender = false;
let session: Awaited<ReturnType<typeof resolveUserBySession>> = null;
try {
	session = await resolveUserBySession(Astro.request);
} catch (error) {
	console.error("Home session lookup failed; rendering as logged out.", error);
}
const isAuthenticated = !!session?.userId;

type BrowseBook = {
	id: string;
	title: string;
	authors: string[];
	authorId: number;
	shelfCount: number;
	thumbnail: string;
	publishedDate: string;
	description: string;
	pageCount: number;
	format: string;
	language: string;
	isbn10?: string;
	isbn13?: string;
	averageRating: number;
	ratingCount: number;
	source: "google_books" | "open_library" | "nyt";
	sourceWorkId?: string;
	sourceEditionId?: string;
	sourceUrl?: string;
};

type BrowseSection = {
	id: string;
	title: string;
	subtitle: string;
	books: BrowseBook[];
};

type ShelfIdea = {
	name: string;
	description: string;
	exampleBooks: string[];
	icon: string;
};

const NON_GENRE_SLUGS = new Set([
	"",
	"all",
	"book-club",
	"books-i-own",
	"currently-reading",
	"default",
	"did-not-finish",
	"dnf",
	"faves",
	"favorites",
	"fiction",
	"general",
	"kindle",
	"library",
	"maybe",
	"owned",
	"physical",
	"read",
	"re-read",
	"reread",
	"tbr",
	"to-buy",
	"to-read",
	"want-to-buy",
	"want-to-own"
]);

function isGenreSlug(slug: string) {
	if (!slug || NON_GENRE_SLUGS.has(slug)) return false;
	if (/^\d{4}(-reads)?$/.test(slug)) return false;
	if (/^\d+$/.test(slug)) return false;
	return true;
}

function formatGenreTitle(slug: string, fallback: string) {
	const source = String(fallback || slug || "").trim();
	return formatGenreLabel(source, "Genre");
}

function formatPublishedLabel(value: string) {
	const text = String(value || "").trim();
	if (!text) return "";
	if (/^\d{4}$/.test(text)) return text;
	if (/^\d{4}-\d{2}$/.test(text)) {
		const parsed = new Date(`${text}-01`);
		if (!Number.isFinite(parsed.getTime())) return text;
		return parsed.toLocaleDateString("en-US", {
			month: "long",
			year: "numeric"
		});
	}
	const parsed = new Date(text);
	if (!Number.isFinite(parsed.getTime())) return text;
	return parsed.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric"
	});
}

function renderAverageStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	const rounded = Math.round(clamped);
	return Array.from({ length: 5 }, (_, index) => (index < rounded ? "★" : "☆")).join("");
}

function sanitizeDescription(value: string, maxLength = 220) {
	const text = String(value || "")
		.replace(/<[^>]+>/g, " ")
		.replace(/\s+/g, " ")
		.trim();
	if (!text) return "";
	if (text.length <= maxLength) return text;
	return `${text.slice(0, maxLength).trimEnd()}…`;
}

let sections: BrowseSection[] = [];
let errorMessage = "";
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let viewerRatingByBookId = new Map<number, number>();
let readerSuggestions: Awaited<ReturnType<typeof resolvePublicReaderSuggestions>> = [];
let onboardingProgress = {
	totalBooks: 0,
	ratedBooks: 0,
	finishedWithReview: 0,
	follows: 0,
	profileComplete: false
};
if (session?.userId) {
	try {
		readerSuggestions = await resolvePublicReaderSuggestions(session.userId, 6);
	} catch (error) {
		console.error("Home reader suggestions unavailable.", error);
	}
}
const shelfIdeas: ShelfIdea[] = [
	{
		name: "Weekend One-Sitting Reads",
		description: "Short, high-momentum books under ~260 pages for quick wins.",
		exampleBooks: ["Project Hail Mary", "Piranesi", "The Sense of an Ending"],
		icon: "bolt"
	},
	{
		name: "Books That Explain the News",
		description: "Evergreen primers for policy, economics, and world context.",
		exampleBooks: ["The Fifth Risk", "The Deficit Myth", "The World for Sale"],
		icon: "public"
	},
	{
		name: "Comfort Re-Reads",
		description: "Reliable mood reset books worth returning to each year.",
		exampleBooks: ["A Wrinkle in Time", "Anne of Green Gables", "The Hobbit"],
		icon: "self_improvement"
	}
];

try {
	const sql = getNeonSql();
	const genreRows = await sql<Array<{
		genre_slug: string;
		genre_name: string;
		book_count: number;
	}>>`
		select
			bg.genre_slug,
			min(bg.genre_name) as genre_name,
			count(distinct bg.book_id) as book_count
		from book_genre bg
		join user_book ub on ub.book_id = bg.book_id
		group by bg.genre_slug
		order by count(distinct bg.book_id) desc, min(bg.genre_name) asc
		limit 24
	`;

	const sectionsConfig = genreRows
		.filter((row) => isGenreSlug(String(row.genre_slug || "").trim()))
		.slice(0, 10)
		.map((row) => {
			const id = String(row.genre_slug || "").trim();
			const title = formatGenreTitle(id, String(row.genre_name || "").trim());
			return {
				id,
				title,
				subtitle: `Books readers on DogEared are shelving in ${title.toLowerCase()}.`
			};
		});

	const results = await Promise.all(sectionsConfig.map(async (section) => {
		const rows = await sql<Array<{
			book_id: number;
			title: string;
			primary_author: string;
			author_id: number | null;
			shelf_count: number;
			synopsis: string;
			cover_url: string;
			published_year: number | null;
			language: string;
			isbn10: string;
			isbn13: string;
			google_books_id: string;
			page_count: number;
			average_rating: number | null;
			rating_count: number;
			page_count: number;
			source: "google_books" | "open_library" | "nyt" | null;
			source_work_id: string | null;
			source_edition_id: string | null;
			source_url: string | null;
		}>>`
			with ranked as (
				select book_id
				from get_top_books_by_genre(${section.id}, 20, 3650)
			)
			select
				b.id as book_id,
				b.title,
				b.primary_author,
				b.author_id,
				coalesce(sc.shelf_count, 0)::int as shelf_count,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				b.cover_url,
				b.published_year,
				b.language,
				b.isbn10,
				b.isbn13,
				b.google_books_id,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(ra.average_rating, 0) as average_rating,
				coalesce(ra.rating_count, 0)::int as rating_count,
				bs.source,
				bs.source_work_id,
				bs.source_edition_id,
				bs.source_url
			from ranked r
			join book b on b.id = r.book_id
			left join lateral (
				select count(*)::int as shelf_count
				from user_book ub
				where ub.book_id = b.id
			) sc on true
			left join lateral (
				select
					round(avg(ub.rating)::numeric, 1) as average_rating,
					count(*) filter (where ub.rating is not null) as rating_count
				from user_book ub
				where ub.book_id = b.id
			) ra on true
			left join lateral (
				select
					source,
					source_work_id,
					source_edition_id,
					source_url
				from book_source
				where book_id = b.id
				order by
					case source
						when 'google_books' then 1
						when 'open_library' then 2
						when 'nyt' then 3
						else 9
					end,
					id asc
				limit 1
			) bs on true
			order by coalesce(sc.shelf_count, 0) desc, b.title asc
		`;

		const books: BrowseBook[] = rows.map((row) => ({
			id: `book_${row.book_id}`,
			title: String(row.title || "").trim(),
			authors: [String(row.primary_author || "").trim()].filter(Boolean),
			authorId: Number(row.author_id || 0),
			shelfCount: Number(row.shelf_count || 0),
			thumbnail: String(row.cover_url || "").trim(),
			publishedDate: row.published_year ? String(row.published_year) : "",
			description: sanitizeDescription(String(row.synopsis || "")),
			pageCount: Math.max(0, Number(row.page_count || 0) || 0),
			format: "Book",
			language: String(row.language || "").trim().toUpperCase(),
			isbn10: String(row.isbn10 || "").trim(),
			isbn13: String(row.isbn13 || "").trim(),
			averageRating: Number(row.average_rating || 0),
			ratingCount: Number(row.rating_count || 0),
			source: row.source || (row.google_books_id ? "google_books" : "open_library"),
			sourceWorkId: String(row.source_work_id || row.google_books_id || "").trim(),
			sourceEditionId: String(row.source_edition_id || "").trim(),
			sourceUrl: String(
				row.source_url ||
				(row.google_books_id ? `https://books.google.com/books?id=${encodeURIComponent(String(row.google_books_id).trim())}` : "")
			).trim()
		}));

		return { ...section, books };
	}));

	sections = results.filter((section) => section.books.length > 0);
	if (session?.userId && sections.length > 0) {
		const bookIds = Array.from(new Set(
			sections
				.flatMap((section) => section.books)
				.map((book) => Number(String(book.id || "").replace(/^book_/, "")))
				.filter((value) => Number.isFinite(value) && value > 0)
		));
		if (bookIds.length > 0) {
			const statusRows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>>`
				select book_id, status, rating
				from user_book
				where user_id = ${session.userId}::uuid
					and book_id = any(${bookIds}::bigint[])
			`;
			viewerStatusByBookId = new Map(
				statusRows.map((row) => [Number(row.book_id || 0), row.status])
			);
			viewerRatingByBookId = new Map(
				statusRows.map((row) => [Number(row.book_id || 0), Math.max(0, Math.min(5, Number(row.rating || 0) || 0))])
			);
		}
	}
	if (session?.userId) {
		try {
			const [bookRows, followRows, profileRows] = await Promise.all([
				sql<Array<{ total_books: number; rated_books: number; finished_with_review: number }>>`
					select
						count(*)::int as total_books,
						count(*) filter (where rating is not null)::int as rated_books,
						count(*) filter (where status = 'finished' and char_length(trim(coalesce(finished_reflection, ''))) > 0)::int as finished_with_review
					from user_book
					where user_id = ${session.userId}::uuid
				`,
				sql<Array<{ follows: number }>>`
					select count(*)::int as follows
					from user_follow
					where follower_user_id = ${session.userId}::uuid
				`,
				sql<Array<{ profile_data: unknown }>>`
					select profile_data
					from app_user
					where id = ${session.userId}::uuid
					limit 1
				`
			]);
			const profileData = (profileRows[0]?.profile_data && typeof profileRows[0]?.profile_data === "object")
				? profileRows[0].profile_data as Record<string, unknown>
				: {};
			onboardingProgress = {
				totalBooks: Math.max(0, Number(bookRows[0]?.total_books || 0)),
				ratedBooks: Math.max(0, Number(bookRows[0]?.rated_books || 0)),
				finishedWithReview: Math.max(0, Number(bookRows[0]?.finished_with_review || 0)),
				follows: Math.max(0, Number(followRows[0]?.follows || 0)),
				profileComplete: !!String(profileData.blurb || "").trim()
			};
		} catch (error) {
			console.error("Home onboarding progress query failed.", error);
		}
	}
	if (!errorMessage && sections.length === 0) {
		const fallbackRows = await sql<Array<{
			book_id: number;
			title: string;
			primary_author: string;
			author_id: number | null;
			shelf_count: number;
			synopsis: string;
			cover_url: string;
			published_year: number | null;
			language: string;
			isbn10: string;
			isbn13: string;
			google_books_id: string;
			page_count: number;
			average_rating: number | null;
			rating_count: number;
		}>>`
			select
				b.id as book_id,
				b.title,
				b.primary_author,
				b.author_id,
				coalesce(sc.shelf_count, 0)::int as shelf_count,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				b.cover_url,
				b.published_year,
				b.language,
				b.isbn10,
				b.isbn13,
				b.google_books_id,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(ra.average_rating, 0) as average_rating,
				coalesce(ra.rating_count, 0)::int as rating_count
			from book b
			left join lateral (
				select count(*)::int as shelf_count
				from user_book ub
				where ub.book_id = b.id
			) sc on true
			left join lateral (
				select
					round(avg(ub.rating)::numeric, 1) as average_rating,
					count(*) filter (where ub.rating is not null) as rating_count
				from user_book ub
				where ub.book_id = b.id
			) ra on true
			where coalesce(sc.shelf_count, 0) > 0
			order by coalesce(sc.shelf_count, 0) desc, coalesce(ra.average_rating, 0) desc
			limit 16
		`;
		if (fallbackRows.length > 0) {
			sections = [{
				id: "popular-now",
				title: "Popular With Readers",
				subtitle: "Start here while DogEared learns your taste. These books are popular with active readers.",
				books: fallbackRows.map((row) => ({
					id: `book_${row.book_id}`,
					title: String(row.title || "").trim(),
					authors: [String(row.primary_author || "").trim()].filter(Boolean),
					authorId: Number(row.author_id || 0),
					shelfCount: Number(row.shelf_count || 0),
					thumbnail: String(row.cover_url || "").trim(),
					publishedDate: row.published_year ? String(row.published_year) : "",
					description: sanitizeDescription(String(row.synopsis || "")),
					pageCount: Math.max(0, Number(row.page_count || 0) || 0),
					format: "Book",
					language: String(row.language || "").trim().toUpperCase(),
					isbn10: String(row.isbn10 || "").trim(),
					isbn13: String(row.isbn13 || "").trim(),
					averageRating: Number(row.average_rating || 0),
					ratingCount: Number(row.rating_count || 0),
					source: row.google_books_id ? "google_books" : "open_library",
					sourceWorkId: String(row.google_books_id || "").trim(),
					sourceUrl: row.google_books_id ? `https://books.google.com/books?id=${encodeURIComponent(String(row.google_books_id).trim())}` : ""
				}))
			}];
		}
	}
} catch (error) {
	console.error("Home shelves query failed.", error);
	errorMessage = "Live home shelves are temporarily unavailable.";
}
const isOnboardingComplete = (
	onboardingProgress.totalBooks > 0
	&& onboardingProgress.ratedBooks > 0
	&& onboardingProgress.finishedWithReview > 0
	&& onboardingProgress.follows > 0
	&& onboardingProgress.profileComplete
);
---

<Layout
	title="Home"
	metaDescription="Discover books readers are shelving right now on DogEared. Track your reading, save books, and find your next favorite."
	canonicalUrl="/"
>
	<div slot="right" class="browse-page" id="browse-page" data-authenticated={String(isAuthenticated)}>
		<header class="intro">
			<h1>Find your next book.<br/>Keep your reading life your own.</h1>
			<p class="subhead">Browse popular shelves, save what matters, and build your reading history without the noise.</p>
		</header>
		{isAuthenticated && !isOnboardingComplete && (
			<section class="onboarding-checklist" data-onboarding-checklist>
				<div class="checklist-head">
					<h2>Getting Started</h2>
					<button type="button" class="checklist-dismiss" data-action="dismiss-onboarding-checklist">Dismiss</button>
				</div>
				<p class="checklist-copy">These steps help DogEared learn your taste faster and improve recommendations.</p>
				<ul>
					<li class={onboardingProgress.totalBooks > 0 ? "is-done" : ""}>{onboardingProgress.totalBooks > 0 ? "Done" : "Next"}: Add your first book to a shelf.</li>
					<li class={onboardingProgress.ratedBooks > 0 ? "is-done" : ""}>{onboardingProgress.ratedBooks > 0 ? "Done" : "Next"}: Rate a book you finished.</li>
					<li class={onboardingProgress.finishedWithReview > 0 ? "is-done" : ""}>{onboardingProgress.finishedWithReview > 0 ? "Done" : "Next"}: Write one short review.</li>
					<li class={onboardingProgress.follows > 0 ? "is-done" : ""}>{onboardingProgress.follows > 0 ? "Done" : "Next"}: Follow a reader you trust.</li>
					<li class={onboardingProgress.profileComplete ? "is-done" : ""}>{onboardingProgress.profileComplete ? "Done" : "Next"}: Add a profile blurb so readers can find you.</li>
				</ul>
			</section>
		)}
		{!errorMessage && sections.length > 0 && (
			<nav class="home-jump-links" aria-label="Jump to genres">
				{sections.map((section) => (
					<a href={`#${section.id}`}>{section.title}</a>
				))}
			</nav>
		)}

		{errorMessage && <p class="error">{errorMessage}</p>}
		{!errorMessage && sections.length === 0 && (
			<p class="empty">
				We do not have enough personalized data yet. Start by searching for a favorite book, add it to a shelf, and rate one finished read.
			</p>
		)}

		{!errorMessage && sections.length > 0 && (
			<>
				{sections.map((section, sectionIndex) => (
					<>
					<section id={section.id} class="browse-section">
						<div class="section-head">
							<h2>{section.title}</h2>
							<a class="section-head-link" href={`/related?kind=genre&value=${encodeURIComponent(section.title)}`}>Explore {section.title}</a>
						</div>
						{section.books.length === 0 && <p class="empty">No books found for this shelf yet.</p>}
						{section.books.length > 0 && (
							<ul class="book-grid">
								{section.books.map((book, index) => {
									const numericBookId = Number(String(book.id || "").replace(/^book_/, ""));
									const hasPersonalRatingControl = viewerStatusByBookId.get(numericBookId) === "finished";
									const viewerRating = Math.max(0, Math.min(5, Number(viewerRatingByBookId.get(numericBookId) || 0)));
									const displayAverageRating = Number(book.averageRating || 0) > 0
										? Number(book.averageRating || 0)
										: viewerRating;
									const displayRatingCount = Number(book.ratingCount || 0) > 0
										? Number(book.ratingCount || 0)
										: (viewerRating > 0 ? 1 : 0);
									return (
									<BookCard
										title={book.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(book.id).replace(/^book_/, ""))}`}
										author={book.authors.length > 0 ? book.authors.join(", ") : "Unknown author"}
										authorHref={book.authors.length === 1 && book.authors[0] ? authorHref(book.authors[0], book.authorId) : ""}
										thumbnail={book.thumbnail}
										description={book.description || "Synopsis unavailable for this edition."}
										readers={book.shelfCount}
										shelfEntries={book.shelfCount}
										publishedLabel={book.publishedDate ? formatPublishedLabel(book.publishedDate) : ""}
										pageCount={book.pageCount}
										averageRating={displayAverageRating}
									>
										<div slot="footer" class="rank-stack rank-stack-footer">
											<Chip className="rank-badge" label={`#${index + 1}`} />
										</div>
										<div slot="meta">
											{hasPersonalRatingControl && (
												<RatingControl
													bookId={String(numericBookId)}
													rating={viewerRating}
													editable={true}
												/>
											)}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												'data-book-id': String(book.id || "").replace(/^book_/, ""),
												'data-initial-status': viewerStatusByBookId.get(Number(String(book.id || "").replace(/^book_/, ""))) || "",
												'data-title': book.title,
												'data-author': book.authors[0] ?? "",
												'data-description': book.description,
												'data-pages': String(book.pageCount ?? 0),
												'data-cover': book.thumbnail,
												'data-format': book.format,
												'data-language': book.language,
												'data-isbn10': book.isbn10 ?? "",
												'data-isbn13': book.isbn13 ?? "",
												'data-source': book.source,
												'data-source-work-id': book.sourceWorkId ?? "",
												'data-source-edition-id': book.sourceEditionId ?? "",
												'data-source-url': book.sourceUrl ?? ""
											}} />
										</div>
									</BookCard>
									);
								})}
							</ul>
						)}
					</section>
					{((sectionIndex === 1 && readerSuggestions.length > 0) || sectionIndex === 4) && (
						<section class="browse-section community-discovery-section">
							<div class="section-head">
								<h2>{sectionIndex === 1 ? "Readers You Might Like" : "Custom Shelf Ideas"}</h2>
							</div>
							{sectionIndex === 1 ? (
								<ul class="community-suggestion-grid">
									{readerSuggestions.map((reader) => (
										<li class="community-suggestion-card" data-reader-card>
											<h3><a href={`/profile/${encodeURIComponent(reader.username)}`}>@{reader.username}</a></h3>
											<p>{reader.blurb || "Public profile with recent reading activity."}</p>
											<div class="suggestion-chip-row">
												{reader.favoriteAuthor && <Chip className="shelf-count-badge" label={reader.favoriteAuthor} />}
												{reader.favoriteBook && <Chip className="shelf-count-badge" label={reader.favoriteBook} />}
												{reader.location && <Chip className="shelf-count-badge" label={reader.location} />}
											</div>
											<button type="button" class="reader-follow-button" data-action="follow-reader" data-username={reader.username}>Follow</button>
											<p class="reader-feedback" data-reader-feedback role="status" aria-live="polite" hidden></p>
										</li>
									))}
								</ul>
							) : (
								<ul class="community-suggestion-grid">
									{shelfIdeas.map((idea) => (
										<li class="community-suggestion-card">
											<h3>{idea.name}</h3>
											<p>{idea.description}</p>
											<div class="suggestion-chip-row">
												{idea.exampleBooks.map((title) => <Chip className="shelf-count-badge" label={title} />)}
											</div>
											<button
												type="button"
												class="mock-shelf-add-button"
												data-action="create-mock-shelf"
												data-shelf-name={idea.name}
												data-shelf-icon={idea.icon}
											>
												Add Shelf
											</button>
										</li>
									))}
								</ul>
							)}
						</section>
					)}
					</>
				))}
			</>
		)}
	</div>
</Layout>

