		min-width: 180px;
		background: #fff;
		border: none;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-popover);
		padding: 0.28rem;
		z-index: 25;
	}

	.shelf-option {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		text-align: left;
		border: none;
		background: transparent;
		padding: 0.5rem 0.75rem;
		font-size: 0.9rem;
		cursor: pointer;
		color: var(--color-text);
		border-radius: var(--radius-sm);
	}

	.shelf-option:hover {
		background: rgba(87, 117, 144, 0.09);
	}

	.shelf-feedback {
		margin-top: 0.25rem;
		font-size: 0.8rem;
		color: #1f7a45;
		line-height: 1.25;
	}

	.empty {
		margin: 0;
		font-size: 0.9rem;
		color: #666;
	}

	.login-confirm-overlay {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100dvh;
		min-height: 100vh;
		background: rgba(0, 0, 0, 0.62);
		z-index: 110;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.login-confirm-dialog {
		width: min(460px, 100%);
		background: #111;
		color: #fff;
		border-radius: var(--radius-lg);
		padding: 1rem;
		box-shadow: var(--shadow-md);
	}

	.login-confirm-dialog p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.45;
	}

	.login-confirm-actions {
		margin-top: 0.95rem;
		display: flex;
		justify-content: flex-end;
		gap: 0.55rem;
	}

	.login-confirm-actions button {
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: transparent;
		color: #d9e3ff;
		font: inherit;
		font-weight: 600;
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		cursor: pointer;
	}

	.login-confirm-actions .confirm {
		background: #2e8f57;
		border-color: #2e8f57;
		color: #fff;
	}

	@media (max-width: 860px) {
		.home-jump-links {
			padding: 0.35rem 0 0.4rem;
			--home-jump-links-offset: 36px;
		}
		.browse-page h1 {
			max-width: 100%;
			font-size: clamp(1.95rem, 7.2vw, 2.4rem);
			line-height: 1.1;
			font-weight: 600;
		}
		.subhead { font-size: 0.95rem; line-height: 1.45; max-width: 36ch; }

		.book-grid {
			grid-template-columns: 1fr;
		}
		.community-suggestion-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 420px) {
		.rank-stack {
			justify-content: flex-end;
		}
		:global(.browse-page .book-card .card-body h3) {
			line-height: 1.18;
		}
		:global(.browse-page .book-card .description) {
			display: -webkit-box;
			-webkit-line-clamp: 5;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

</style>

<script>
	import { resolveClientAuthState } from "../lib/clientAuth.ts";
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		promptForShelfLogin,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		toggleShelfMenu,
		initRatingControls
	} from "../lib/shelfClient.ts";
	import {
		loadShelfEntries,
		loadShelfUpdates,
		migrateShelfEntriesInPlace,
		saveShelfEntries,
		saveShelfUpdates
	} from "../lib/shelfStorage.ts";

	const browsePage = document.getElementById("browse-page");
	let isAuthenticated = browsePage?.dataset.authenticated === "true";
	const feedbackTimers = new WeakMap();
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const onboardingChecklist = document.querySelector("[data-onboarding-checklist]");
	const onboardingDismissKey = "dogeared:onboarding-checklist:dismissed";
	initRatingControls();
	if (onboardingChecklist instanceof HTMLElement) {
		const dismissed = localStorage.getItem(onboardingDismissKey) === "1";
		if (dismissed) onboardingChecklist.hidden = true;
	}

	function normalizeText(value) {
		return String(value || "").trim().toLowerCase();
	}

	function canonicalizeTitle(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/\([^)]*\)/g, " ")
			.replace(/\b(abridged|unabridged|audio ?book|audiobook|kindle edition|paperback|hardcover|ebook|e-book|digital edition|color edition)\b/g, " ")
			.split(":")[0]
			.replace(/^(the|a|an)\s+/g, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function canonicalizeAuthor(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/^(by\s+)/, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function findEntry(entries, input) {
		const bookId = Number(input?.bookId || 0);
		if (bookId > 0) {
			const byBookId = entries.find((entry) => Number(entry?.bookId || 0) === bookId);
			if (byBookId) return byBookId;
		}
		const isbn13 = normalizeText(input?.isbn13 || "");
		const isbn10 = normalizeText(input?.isbn10 || "");
		const googleBooksId = normalizeText(input?.googleBooksId || "");
		if (isbn13 || isbn10 || googleBooksId) {
			const byIdentifier = entries.find((entry) => {
				const entryIsbn13 = normalizeText(entry?.isbn13 || "");
				const entryIsbn10 = normalizeText(entry?.isbn10 || "");
				const entryGoogleBooksId = normalizeText(entry?.googleBooksId || "");
				if (isbn13 && entryIsbn13 && isbn13 === entryIsbn13) return true;
				if (isbn10 && entryIsbn10 && isbn10 === entryIsbn10) return true;
				if (googleBooksId && entryGoogleBooksId && googleBooksId === entryGoogleBooksId) return true;
				return false;
			});
			if (byIdentifier) return byIdentifier;
		}
		const t = canonicalizeTitle(input?.title || "");
		const a = canonicalizeAuthor(input?.author || "");
		return entries.find((entry) => (
			canonicalizeTitle(entry?.title) === t && canonicalizeAuthor(entry?.author) === a
		));
	}

	function logShelfUpdate(entry, status) {
		if (!entry?.title) return;
		const updates = loadShelfUpdates();
		updates.unshift({
			id: `upd_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
			timestamp: Date.now(),
			status: status || entry.status || "want_to_read",
			title: entry.title,
			author: entry.author || "",
			coverUrl: entry.coverUrl || "",
			format: entry.format || "",
			language: entry.language || ""
		});
		saveShelfUpdates(updates);
	}

	function applyStatus(entry, selectedStatus, totalPages) {
		entry.status = selectedStatus;
		if (selectedStatus === "finished") {
			if (totalPages > 0) entry.currentPage = totalPages;
			entry.finishedDate = entry.finishedDate || new Date().toISOString().slice(0, 10);
			return;
		}
		if (selectedStatus === "reading") {
			entry.currentPage = Math.max(0, Number(entry.currentPage) || 0);
		}
		if (selectedStatus === "want_to_read") {
			entry.currentPage = 0;
		}
		entry.finishedDate = "";
	}

	function mergeServerEntry(entries, localEntry, serverEntry) {
		if (!serverEntry || typeof serverEntry !== "object") return;
		const incoming = serverEntry;
		const byId = String(incoming.id || "").trim();
		const byTitle = String(incoming.title || localEntry?.title || "").trim();
		const byAuthor = String(incoming.author || localEntry?.author || "").trim();
		const existingById = byId ? entries.findIndex((item) => String(item?.id || "") === byId) : -1;
		const existingByTitle = existingById === -1 ? entries.findIndex((item) => findEntry([item], { title: byTitle, author: byAuthor })) : -1;
		const nextEntry = {
			...(localEntry || {}),
			...incoming
		};
		if (existingById >= 0) {
			entries[existingById] = nextEntry;
			return;
		}
		if (existingByTitle >= 0) {
			entries[existingByTitle] = nextEntry;
			return;
		}
		entries.unshift(nextEntry);
	}

	function setMockShelfButtonState(button, state) {
		if (!(button instanceof HTMLButtonElement)) return;
		const label = state === "added"
			? "Added"
			: state === "saving"
				? "Adding..."
				: state === "retry"
					? "Retry"
					: "Add Shelf";
		button.textContent = label;
		button.disabled = state === "saving" || state === "added";
		button.classList.toggle("is-added", state === "added");
	}

	function markMatchingMockShelfButtonsAsAdded(shelfName) {
		const normalized = normalizeText(shelfName);
		if (!normalized) return;
		const buttons = Array.from(document.querySelectorAll('[data-action="create-mock-shelf"]'));
		for (const node of buttons) {
			if (!(node instanceof HTMLButtonElement)) continue;
			if (normalizeText(node.dataset.shelfName || "") !== normalized) continue;
			setMockShelfButtonState(node, "added");
		}
	}

	function escapeHtml(value) {
		return String(value || "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#39;");
	}

	function renderSuggestionChip(label) {
		const text = String(label || "").trim();
		if (!text) return "";
		return `<span class="chip chip--highlight chip--static shelf-count-badge">${escapeHtml(text)}</span>`;
	}

	function renderReaderSuggestion(reader) {
		const username = String(reader?.username || "").trim();
		if (!username) return "";
		const chips = [
			renderSuggestionChip(reader?.favoriteAuthor),
			renderSuggestionChip(reader?.favoriteBook),
			renderSuggestionChip(reader?.location)
		].join("");
		return `
			<li class="community-suggestion-card" data-reader-card>
				<h3><a href="/profile/${encodeURIComponent(username)}">@${escapeHtml(username)}</a></h3>
				<p>${escapeHtml(reader?.blurb || "Public profile with recent reading activity.")}</p>
				${chips ? `<div class="suggestion-chip-row">${chips}</div>` : ""}
				<button type="button" class="reader-follow-button" data-action="follow-reader" data-username="${escapeHtml(username)}">Follow</button>
				<p class="reader-feedback" data-reader-feedback role="status" aria-live="polite" hidden></p>
			</li>
		`;
	}

	async function loadReaderSuggestions() {
		const list = document.querySelector("[data-reader-suggestions]");
		if (!(list instanceof HTMLElement)) return;
		if (!isAuthenticated) {
			list.closest(".community-discovery-section")?.remove();
			return;
		}
		if (import.meta.env.DEV) performance.mark("home:reader-suggestions:start");
		try {
			const response = await fetch("/api/home/reader-suggestions", { credentials: "same-origin" });
			const data = await response.json().catch(() => ({}));
			const readers = Array.isArray(data?.readers) ? data.readers : [];
			if (!response.ok || readers.length === 0) {
				list.closest(".community-discovery-section")?.remove();
				return;
			}
			list.innerHTML = readers.map(renderReaderSuggestion).join("");
			list.setAttribute("aria-busy", "false");
		} catch {
			list.closest(".community-discovery-section")?.remove();
		} finally {
			if (import.meta.env.DEV) {
				performance.mark("home:reader-suggestions:end");
				performance.measure("home:reader-suggestions", "home:reader-suggestions:start", "home:reader-suggestions:end");
				const measure = performance.getEntriesByName("home:reader-suggestions").pop();
				console.info(`[home:client] reader suggestions: ${Math.round(measure?.duration || 0)}ms`);
			}
		}
	}

	async function createMockShelf(button) {
		if (!(button instanceof HTMLButtonElement)) return;
		if (!isAuthenticated) {
			promptForShelfLogin();
			return;
		}
		const shelfName = String(button.dataset.shelfName || "").trim();
		const shelfIcon = String(button.dataset.shelfIcon || "").trim();
		if (!shelfName) return;
		setMockShelfButtonState(button, "saving");
		try {
			const existingResponse = await fetch("/api/shelf/custom-shelves", { credentials: "same-origin" });
			if (existingResponse.status === 401) {
				setMockShelfButtonState(button, "default");
				promptForShelfLogin();
				return;
			}
			if (!existingResponse.ok) throw new Error("Failed to load shelves");
			const existingPayload = await existingResponse.json().catch(() => ({}));
			const shelves = Array.isArray(existingPayload?.shelves) ? existingPayload.shelves : [];
			const alreadyExists = shelves.some((shelf) => normalizeText(shelf?.name || "") === normalizeText(shelfName));
			if (alreadyExists) {
				markMatchingMockShelfButtonsAsAdded(shelfName);
				return;
			}
			const createResponse = await fetch("/api/shelf/custom-shelves", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				credentials: "same-origin",
				body: JSON.stringify({ name: shelfName, icon: shelfIcon || "bookmarks" })
			});
			if (createResponse.status === 401) {
				setMockShelfButtonState(button, "default");
				promptForShelfLogin();
				return;
			}
			if (!createResponse.ok) throw new Error("Failed to create shelf");
			markMatchingMockShelfButtonsAsAdded(shelfName);
		} catch (_error) {
			setMockShelfButtonState(button, "retry");
		}
	}

	function setShelf(dropdown, selectedStatus) {
		if (!isAuthenticated) {
			promptForShelfLogin();
			return;
		}
		const title = String(dropdown.dataset.title || "").trim();
		if (!title) return;
		const author = String(dropdown.dataset.author || "").trim();
		const description = String(dropdown.dataset.description || "").trim();
		const totalPages = Math.max(0, Number(dropdown.dataset.pages || 0) || 0);
		const coverUrl = String(dropdown.dataset.cover || "").trim();
		const format = String(dropdown.dataset.format || "").trim();
		const language = String(dropdown.dataset.language || "").trim();
		const isbn10 = String(dropdown.dataset.isbn10 || "").trim();
		const isbn13 = String(dropdown.dataset.isbn13 || "").trim();
		const source = String(dropdown.dataset.source || "").trim();
		const sourceWorkId = String(dropdown.dataset.sourceWorkId || "").trim();
		const sourceEditionId = String(dropdown.dataset.sourceEditionId || "").trim();
		const sourceUrl = String(dropdown.dataset.sourceUrl || "").trim();

		const entries = loadShelfEntries();
		const existing = findEntry(entries, {
			bookId: Number(dropdown.dataset.bookId || 0),
			title,
			author,
			isbn10: String(dropdown.dataset.isbn10 || "").trim(),
			isbn13: String(dropdown.dataset.isbn13 || "").trim(),
			googleBooksId: String(dropdown.dataset.googleBooksId || "").trim()
		});
		if (existing) {
			const previousStatus = existing.status;
			if (!existing.totalPages && totalPages > 0) existing.totalPages = totalPages;
			if (!existing.coverUrl && coverUrl) existing.coverUrl = coverUrl;
			if (format && !existing.format) existing.format = format;
			if (language && !existing.language) existing.language = language;
			if (isbn10) existing.isbn10 = isbn10;
			if (isbn13) existing.isbn13 = isbn13;
			if (source) existing.source = source;
			if (sourceWorkId) existing.sourceWorkId = sourceWorkId;
			if (sourceEditionId) existing.sourceEditionId = sourceEditionId;
			if (sourceUrl) existing.sourceUrl = sourceUrl;
			if (description && !existing.description) existing.description = description;
			applyStatus(existing, selectedStatus, totalPages || Number(existing.totalPages) || 0);
			existing.updatedAt = Date.now();
			saveShelfEntries(entries);
			if (previousStatus !== selectedStatus) {
				logShelfUpdate(existing, selectedStatus);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(selectedStatus)}.`, feedbackTimers);
			} else {
				showShelfFeedback(dropdown, `Already on ${statusLabel(selectedStatus)}.`, feedbackTimers);
			}
			setDropdownLabel(dropdown, selectedStatus);
			setShelvedState(dropdown, true);
			void (async () => {
				const result = await saveShelfEntryWithRetry(existing);
				const serverEntry = result?.data && typeof result.data === "object" ? result.data.entry : null;
				if (result.ok && serverEntry) {
					const latest = loadShelfEntries();
					mergeServerEntry(latest, existing, serverEntry);
					saveShelfEntries(latest);
					syncExistingState();
				} else if (!result.ok && result.message) {
					showShelfFeedback(dropdown, result.message, feedbackTimers);
				}
			})();
			return;
		}

		const next = buildShelfEntryFromRecord({
			title,
			author,
			description,
			pageCount: totalPages,
			coverUrl,
			format,
			language,
			isbn10,
			isbn13
		}, {
			status: selectedStatus,
			totalPages,
			currentPage: 0,
			finishedDate: "",
			source,
			sourceWorkId,
			sourceEditionId,
			sourceUrl,
			updatedAt: Date.now()
		});
		applyStatus(next, selectedStatus, totalPages);
		entries.unshift(next);
		saveShelfEntries(entries);
		logShelfUpdate(next, selectedStatus);
		setDropdownLabel(dropdown, selectedStatus);
		setShelvedState(dropdown, true);
		showShelfFeedback(dropdown, `Saved to ${statusLabel(selectedStatus)}.`, feedbackTimers);
		void (async () => {
			const result = await saveShelfEntryWithRetry(next);
			const serverEntry = result?.data && typeof result.data === "object" ? result.data.entry : null;
			if (result.ok && serverEntry) {
				const latest = loadShelfEntries();
				mergeServerEntry(latest, next, serverEntry);
				saveShelfEntries(latest);
				syncExistingState();
			} else if (!result.ok && result.message) {
				showShelfFeedback(dropdown, result.message, feedbackTimers);
			}
		})();
	}

	function syncExistingState() {
		if (!isAuthenticated) {
			for (const dropdown of shelfDropdowns) {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
			return;
		}
		const entries = loadShelfEntries();
		for (const dropdown of shelfDropdowns) {
			const seededStatus = String(dropdown.dataset.initialStatus || "").trim();
			let appliedSeed = false;
			if (seededStatus === "want_to_read" || seededStatus === "reading" || seededStatus === "finished") {
				setDropdownLabel(dropdown, seededStatus);
				setShelvedState(dropdown, true);
				appliedSeed = true;
			}
			const existing = findEntry(entries, {
				bookId: Number(dropdown.dataset.bookId || 0),
				title: dropdown.dataset.title || "",
				author: dropdown.dataset.author || "",
				isbn10: String(dropdown.dataset.isbn10 || "").trim(),
				isbn13: String(dropdown.dataset.isbn13 || "").trim(),
				googleBooksId: String(dropdown.dataset.googleBooksId || "").trim()
			});
			if (existing) {
				setDropdownLabel(dropdown, existing.status || "");
				setShelvedState(dropdown, true);
			} else if (!appliedSeed) {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
		}
	}

	async function initAuthState() {
		if (import.meta.env.DEV) performance.mark("home:hydration:start");
		migrateShelfEntriesInPlace();
		const state = await resolveClientAuthState({ ssrAuthenticated: isAuthenticated });
		isAuthenticated = state.authenticated;
		syncExistingState();
		if (import.meta.env.DEV) {
			performance.mark("home:hydration:end");
			performance.measure("home:hydration", "home:hydration:start", "home:hydration:end");
			const measure = performance.getEntriesByName("home:hydration").pop();
			console.info(`[home:client] hydration/auth sync: ${Math.round(measure?.duration || 0)}ms`);
		}
		void loadReaderSuggestions();
	}

	if (import.meta.env.DEV) {
		window.addEventListener("load", () => {
			const covers = Array.from(document.querySelectorAll(".book-card img.cover"));
			const loaded = covers.filter((cover) => cover instanceof HTMLImageElement && cover.complete).length;
			console.info(`[home:client] cover images loaded at window load: ${loaded}/${covers.length}`);
		}, { once: true });
	}

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle instanceof HTMLElement) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown instanceof HTMLElement) {
				toggleShelfMenu(dropdown, shelfDropdowns);
			}
			return;
		}
		const option = target.closest('[data-action="set-shelf"]');
		if (option instanceof HTMLElement) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = option.closest(".shelf-dropdown");
			if (dropdown instanceof HTMLElement) {
				const status = option.dataset.status || "want_to_read";
				setShelf(dropdown, status);
				closeShelfMenus(shelfDropdowns);
			}
			return;
		}
		const createShelfButton = target.closest('[data-action="create-mock-shelf"]');
		if (createShelfButton instanceof HTMLButtonElement) {
			event.preventDefault();
			void createMockShelf(createShelfButton);
			return;
		}
		const followButton = target.closest('[data-action="follow-reader"]');
		if (followButton instanceof HTMLButtonElement) {
			event.preventDefault();
			if (!isAuthenticated) {
				promptForShelfLogin();
				return;
			}
			const username = String(followButton.dataset.username || "").trim();
			if (!username) return;
			const card = followButton.closest("[data-reader-card]");
			const feedback = card?.querySelector("[data-reader-feedback]");
			followButton.disabled = true;
			if (feedback instanceof HTMLElement) {
				feedback.textContent = "Following...";
				feedback.hidden = false;
			}
			void (async () => {
				try {
					const response = await fetch("/api/follow", {
						method: "POST",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ username })
					});
					const data = await response.json().catch(() => ({}));
					if (!response.ok) {
						followButton.disabled = false;
						if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to follow.");
						return;
					}
					followButton.textContent = "Following";
					if (feedback instanceof HTMLElement) feedback.textContent = "Added to Following.";
				} catch {
					followButton.disabled = false;
					if (feedback instanceof HTMLElement) feedback.textContent = "Failed to follow.";
				}
			})();
			return;
		}
		const dismissChecklistButton = target.closest('[data-action="dismiss-onboarding-checklist"]');
		if (dismissChecklistButton instanceof HTMLButtonElement && onboardingChecklist instanceof HTMLElement) {
			onboardingChecklist.hidden = true;
			localStorage.setItem(onboardingDismissKey, "1");
			return;
		}
		if (target.closest(".shelf-dropdown")) return;
		closeShelfMenus(shelfDropdowns);
	});

	void initAuthState();
</script>
