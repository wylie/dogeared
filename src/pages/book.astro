export const prerender = false;

function normalizeText(value: unknown) {
	return String(value || "").trim();
}

function canonicalizeTitle(value: unknown) {
	return normalizeText(value)
		.toLowerCase()
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/\([^)]*\)/g, " ")
		.replace(/\b(abridged|unabridged|audio ?book|audiobook|kindle edition|paperback|hardcover|ebook|e-book|digital edition|color edition)\b/g, " ")
		.split(":")[0]
		.replace(/^(the|a|an)\s+/g, "")
		.replace(/[^a-z0-9\s]/g, " ")
		.replace(/\s+/g, " ")
		.trim();
}

function canonicalizeAuthor(value: unknown) {
	return normalizeText(value)
		.toLowerCase()
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/^(by\s+)/, "")
		.replace(/[^a-z0-9\s]/g, " ")
		.replace(/\s+/g, " ")
		.trim();
}

function sanitizeSynopsis(value: unknown) {
	return String(value || "")
		.replace(/<[^>]+>/g, " ")
		.replace(/\s+/g, " ")
		.trim();
}

function synopsisParagraphs(value: string) {
	const text = sanitizeSynopsis(value);
	if (!text) return [] as string[];
	const chunks: string[] = [];
	let current = "";
	for (const sentence of text.split(/(?<=[.!?])\s+/)) {
		const next = current ? `${current} ${sentence}` : sentence;
		if (next.length > 320 && current) {
			chunks.push(current);
			current = sentence;
		} else {
			current = next;
		}
	}
	if (current) chunks.push(current);
	return chunks;
}

function formatPublishedLabel(input: string) {
	const text = normalizeText(input);
	if (!text) return "";
	if (/^\d{4}$/.test(text)) return text;
	if (/^\d{4}-\d{2}$/.test(text)) {
		const parsed = new Date(`${text}-01`);
		if (!Number.isFinite(parsed.getTime())) return text;
		return parsed.toLocaleDateString("en-US", { month: "long", year: "numeric" });
	}
	const parsed = new Date(text);
	if (!Number.isFinite(parsed.getTime())) return text;
	return parsed.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

function renderAverageStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	const rounded = Math.round(clamped);
	return Array.from({ length: 5 }, (_, i) => (i < rounded ? "★" : "☆")).join("");
}

function formatActivityDate(value: string) {
	const parsed = new Date(normalizeText(value));
	if (!Number.isFinite(parsed.getTime())) return "";
	return parsed.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

function activityHeading(eventType: string) {
	const type = normalizeText(eventType).toLowerCase();
	if (type === "reading") return { prefix: "Started Reading", shelf: "" };
	if (type === "finished") return { prefix: "Finished Reading", shelf: "" };
	if (type === "want_to_read") return { prefix: "Added to", shelf: "Want to Read" };
	if (type === "rating") return { prefix: "Rated this book", shelf: "" };
	return { prefix: "Updated shelf", shelf: "" };
}

function shelfStatusLabel(status: ShelfStatus) {
	if (status === "reading") return "Currently Reading";
	if (status === "finished") return "Read";
	if (status === "want_to_read") return "Want to Read";
	return "";
}

function formatTopicLabel(value: string) {
	return normalizeText(value)
		.replace(/[-_]+/g, " ")
		.replace(/\s+/g, " ")
		.trim()
		.toLowerCase()
		.split(" ")
		.filter(Boolean)
		.map((word) => `${word[0]?.toUpperCase() || ""}${word.slice(1)}`)
		.join(" ");
}

function canonicalTagKey(value: string) {
	return normalizeText(value)
		.toLowerCase()
		.replace(/\bscifi\b/g, "science fiction")
		.replace(/\bsci[\s-]*fi\b/g, "science fiction")
		.replace(/&/g, "and")
		.replace(/[^a-z0-9]+/g, " ")
		.trim();
}

function isDisplayNoise(value: string) {
	const text = normalizeText(value).toLowerCase();
	if (!text) return true;
	if (text.includes(":") && text.includes("=")) return true;
	if (/^nyt[:\s_-]/.test(text)) return true;
	if (/^\d{4}-\d{2}-\d{2}$/.test(text)) return true;
	if (/^[a-z0-9_-]{0,20}[:][a-z0-9_-]{0,30}[=][a-z0-9_-]{0,30}$/.test(text)) return true;
	return false;
}

type BookDetails = {
	id: number;
	workId: number;
	title: string;
	author: string;
	authorId: number;
	synopsis: string;
	coverUrl: string;
	language: string;
	isbn10: string;
	isbn13: string;
	googleBooksId: string;
	publishedLabel: string;
	shelves: number;
	readers: number;
	averageRating: number;
	ratingCount: number;
	pageCount: number;
};

type AvailableEdition = {
	id: number;
	bookId: number;
	format: string;
	publisher: string;
	language: string;
	publicationLabel: string;
	pageCount: number;
	isbn: string;
	coverUrl: string;
};

const params = Astro.url.searchParams;
const queryBookId = Number(params.get("bookId") || 0);
const queryIsbn13 = normalizeText(params.get("isbn13"));
const queryIsbn10 = normalizeText(params.get("isbn10"));
const queryGoogleBooksId = normalizeText(params.get("googleBooksId"));
const queryTitle = normalizeText(params.get("title"));
const queryAuthor = normalizeText(params.get("author"));

let book: BookDetails | null = null;
let activity: Array<{
	id: number;
	eventType: string;
	timestamp: string;
	actorName: string;
	actorUsername: string;
	rating: number;
	likeCount: number;
	viewerLiked: boolean;
}> = [];
let reviews: BookReview[] = [];
let errorMessage = "";
const session = await resolveUserBySession(Astro.request);
const isAuthenticated = !!session?.userId;
let viewerShelfStatus: "want_to_read" | "reading" | "finished" | "" = "";
let viewerRating = 0;
let viewerReviewTitle = "";
let viewerReviewBody = "";
let viewerReviewSpoiler = false;
let bookGenres: string[] = [];
let bookTopics: string[] = [];
let customShelfOptionsJson = "[]";
let seriesContext: BookSeriesContext | null = null;
let journalEntries: JournalSearchResult[] = [];
let readerOwnsBook = false;
let readersAlsoEnjoyed: RecommendationSection | null = null;
let availableEditions: AvailableEdition[] = [];

async function fetchGoogleBook() {
	const apiKey = normalizeText(import.meta.env.GOOGLE_BOOKS_API_KEY);
	if (!apiKey) return null;

	const fetchJson = async (url: string) => {
		try {
			const response = await fetch(url);
			if (!response.ok) return null;
			return await response.json();
		} catch {
			return null;
		}
	};

	if (queryGoogleBooksId) {
		const data = await fetchJson(`https://www.googleapis.com/books/v1/volumes/${encodeURIComponent(queryGoogleBooksId)}?key=${encodeURIComponent(apiKey)}`);
		if (data?.volumeInfo) return data;
	}

	const queryParts = [
		queryIsbn13 ? `isbn:${queryIsbn13}` : "",
		queryIsbn10 ? `isbn:${queryIsbn10}` : "",
		queryTitle && queryAuthor ? `intitle:${queryTitle} inauthor:${queryAuthor}` : "",
		queryTitle ? `intitle:${queryTitle}` : ""
	].filter(Boolean);

	for (const q of queryParts) {
		const url = `https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(q)}&key=${encodeURIComponent(apiKey)}&maxResults=5&printType=books`;
		const data = await fetchJson(url);
		const items = Array.isArray(data?.items) ? data.items : [];
		if (items.length > 0) return items[0];
	}
	return null;
}

function normalizeCatalogPageCount(value: unknown) {
	const numeric = Math.max(0, Number(value || 0) || 0);
	return Number.isFinite(numeric) ? Math.floor(numeric) : 0;
}

async function fetchOpenLibraryBook() {
	const fetchJson = async (url: string) => {
		try {
			const response = await fetch(url);
			if (!response.ok) return null;
			return await response.json();
		} catch {
			return null;
		}
	};

	for (const isbn of [queryIsbn13, queryIsbn10].filter(Boolean)) {
		const key = `ISBN:${isbn}`;
		const data = await fetchJson(`https://openlibrary.org/api/books?bibkeys=${encodeURIComponent(key)}&format=json&jscmd=data`);
		const row = data?.[key];
		if (!row) continue;
		return {
			title: normalizeText(row.title),
			author: normalizeText(Array.isArray(row.authors) ? row.authors[0]?.name : ""),
			synopsis: sanitizeSynopsis(typeof row.description === "string" ? row.description : row.description?.value),
			coverUrl: normalizeText(row.cover?.large || row.cover?.medium || row.cover?.small),
			publishedLabel: formatPublishedLabel(normalizeText(row.publish_date))
		};
	}
	return null;
}

try {
	const sql = getNeonSql();
	await ensureCanonicalWorkSchema(sql);
	let rows: Array<{
		id: number;
		title: string;
		author: string;
		author_id: number | null;
		synopsis: string;
		cover_url: string;
		language: string;
		isbn10: string;
		isbn13: string;
		google_books_id: string;
		published_year: number | null;
		shelves: number;
		readers: number;
		average_rating: number | null;
		rating_count: number;
		page_count: number;
	}> = [];

	if (queryBookId > 0) {
		rows = await sql`
			select
				b.id,
				b.title,
				coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				b.author_id,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				coalesce(nullif(trim(b.cover_url), ''), '') as cover_url,
				coalesce(nullif(trim(b.language), ''), '') as language,
				coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
				coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
				coalesce(nullif(trim(b.google_books_id), ''), '') as google_books_id,
				b.published_year,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(sc.shelves, 0)::int as shelves,
				coalesce(sc.readers, 0)::int as readers,
				coalesce(rt.average_rating, 0) as average_rating,
				coalesce(rt.rating_count, 0)::int as rating_count
			from book b
			left join lateral (
				select count(*)::int as shelves, count(distinct user_id)::int as readers
				from user_book ub2
				where ub2.book_id = b.id
			) sc on true
			left join lateral (
				select round(avg(ub3.rating)::numeric, 1) as average_rating, count(*) filter (where ub3.rating is not null)::int as rating_count
				from user_book ub3
				where ub3.book_id = b.id
			) rt on true
			where b.id = ${queryBookId}
			group by b.id, b.title, b.primary_author, b.author_id, b.synopsis, b.cover_url, b.language, b.isbn10, b.isbn13, b.google_books_id, b.published_year, b.page_count, sc.shelves, sc.readers, rt.average_rating, rt.rating_count
			limit 1
		`;
	}

	if (!rows[0] && queryIsbn13) {
		rows = await sql`
			select b.id, b.title, coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				b.author_id,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				coalesce(nullif(trim(b.cover_url), ''), '') as cover_url,
				coalesce(nullif(trim(b.language), ''), '') as language,
				coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
				coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
				coalesce(nullif(trim(b.google_books_id), ''), '') as google_books_id,
				b.published_year,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(sc.shelves, 0)::int as shelves,
				coalesce(sc.readers, 0)::int as readers,
				coalesce(rt.average_rating, 0) as average_rating,
				coalesce(rt.rating_count, 0)::int as rating_count
			from book b
			left join lateral (select count(*)::int as shelves, count(distinct ub.user_id)::int as readers from user_book ub where ub.book_id = b.id) sc on true
			left join lateral (select round(avg(ub.rating)::numeric, 1) as average_rating, count(*) filter (where ub.rating is not null)::int as rating_count from user_book ub where ub.book_id = b.id) rt on true
			where b.isbn13 = ${queryIsbn13}
			group by b.id, b.title, b.primary_author, b.author_id, b.synopsis, b.cover_url, b.language, b.isbn10, b.isbn13, b.google_books_id, b.published_year, b.page_count, sc.shelves, sc.readers, rt.average_rating, rt.rating_count
			limit 1
		`;
	}

	if (!rows[0] && queryIsbn10) {
		rows = await sql`
			select b.id, b.title, coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				b.author_id,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				coalesce(nullif(trim(b.cover_url), ''), '') as cover_url,
				coalesce(nullif(trim(b.language), ''), '') as language,
				coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
				coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
				coalesce(nullif(trim(b.google_books_id), ''), '') as google_books_id,
				b.published_year,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(sc.shelves, 0)::int as shelves,
				coalesce(sc.readers, 0)::int as readers,
				coalesce(rt.average_rating, 0) as average_rating,
				coalesce(rt.rating_count, 0)::int as rating_count
			from book b
			left join lateral (select count(*)::int as shelves, count(distinct ub.user_id)::int as readers from user_book ub where ub.book_id = b.id) sc on true
			left join lateral (select round(avg(ub.rating)::numeric, 1) as average_rating, count(*) filter (where ub.rating is not null)::int as rating_count from user_book ub where ub.book_id = b.id) rt on true
			where b.isbn10 = ${queryIsbn10}
			group by b.id, b.title, b.primary_author, b.author_id, b.synopsis, b.cover_url, b.language, b.isbn10, b.isbn13, b.google_books_id, b.published_year, b.page_count, sc.shelves, sc.readers, rt.average_rating, rt.rating_count
			limit 1
		`;
	}

	if (!rows[0] && queryGoogleBooksId) {
		rows = await sql`
			select b.id, b.title, coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				b.author_id,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				coalesce(nullif(trim(b.cover_url), ''), '') as cover_url,
				coalesce(nullif(trim(b.language), ''), '') as language,
				coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
				coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
				coalesce(nullif(trim(b.google_books_id), ''), '') as google_books_id,
				b.published_year,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(sc.shelves, 0)::int as shelves,
				coalesce(sc.readers, 0)::int as readers,
				coalesce(rt.average_rating, 0) as average_rating,
				coalesce(rt.rating_count, 0)::int as rating_count
			from book b
			left join lateral (select count(*)::int as shelves, count(distinct ub.user_id)::int as readers from user_book ub where ub.book_id = b.id) sc on true
			left join lateral (select round(avg(ub.rating)::numeric, 1) as average_rating, count(*) filter (where ub.rating is not null)::int as rating_count from user_book ub where ub.book_id = b.id) rt on true
			where b.google_books_id = ${queryGoogleBooksId}
			group by b.id, b.title, b.primary_author, b.author_id, b.synopsis, b.cover_url, b.language, b.isbn10, b.isbn13, b.google_books_id, b.published_year, b.page_count, sc.shelves, sc.readers, rt.average_rating, rt.rating_count
			limit 1
		`;
	}

	if (!rows[0] && queryTitle) {
		const ct = canonicalizeTitle(queryTitle);
		const ca = canonicalizeAuthor(queryAuthor);
		rows = await sql`
			select b.id, b.title, coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				b.author_id,
				coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
				coalesce(nullif(trim(b.cover_url), ''), '') as cover_url,
				coalesce(nullif(trim(b.language), ''), '') as language,
				coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
				coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
				coalesce(nullif(trim(b.google_books_id), ''), '') as google_books_id,
				b.published_year,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(sc.shelves, 0)::int as shelves,
				coalesce(sc.readers, 0)::int as readers,
				coalesce(rt.average_rating, 0) as average_rating,
				coalesce(rt.rating_count, 0)::int as rating_count
			from book b
			left join lateral (select count(*)::int as shelves, count(distinct ub.user_id)::int as readers from user_book ub where ub.book_id = b.id) sc on true
			left join lateral (select round(avg(ub.rating)::numeric, 1) as average_rating, count(*) filter (where ub.rating is not null)::int as rating_count from user_book ub where ub.book_id = b.id) rt on true
			where lower(regexp_replace(coalesce(b.title, ''), '[^[:alnum:]]+', '', 'g')) = ${ct.replace(/[^a-z0-9]+/g, "")}
				and (${ca} = '' or lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) = ${ca.replace(/[^a-z0-9]+/g, "")})
			group by b.id, b.title, b.primary_author, b.author_id, b.synopsis, b.cover_url, b.language, b.isbn10, b.isbn13, b.google_books_id, b.published_year, b.page_count, sc.shelves, sc.readers, rt.average_rating, rt.rating_count
			limit 1
		`;
	}

	const row = rows[0];
	if (row?.id) {
		const resolvedBookId = Number(row.id || 0);
		const representativeBookId = resolvedBookId > 0 ? await resolveRepresentativeBookId(sql, resolvedBookId) : 0;
		if (representativeBookId > 0 && representativeBookId !== resolvedBookId) {
			return Astro.redirect(`/book?bookId=${encodeURIComponent(String(representativeBookId))}`, 302);
		}
		if (resolvedBookId > 0 && queryBookId !== resolvedBookId) {
			return Astro.redirect(`/book?bookId=${encodeURIComponent(String(resolvedBookId))}`, 302);
		}
		const workRows = await sql<Array<{ work_id: number | null }>>`
			select work_id
			from book
			where id = ${resolvedBookId}
			limit 1
		`;
		book = {
			id: resolvedBookId,
			workId: Number(workRows[0]?.work_id || 0),
			title: normalizeText(row.title),
			author: normalizeText(row.author),
			authorId: Number(row.author_id || 0),
			synopsis: sanitizeSynopsis(row.synopsis),
			coverUrl: normalizeText(row.cover_url),
			language: normalizeText(row.language),
			isbn10: normalizeText(row.isbn10),
			isbn13: normalizeText(row.isbn13),
			googleBooksId: normalizeText(row.google_books_id),
			publishedLabel: row.published_year ? String(row.published_year) : "",
			shelves: Number(row.shelves || 0),
			readers: Number((row as { readers?: number }).readers || 0),
			averageRating: Number(row.average_rating || 0),
			ratingCount: Number(row.rating_count || 0)
			,pageCount: normalizeCatalogPageCount(row.page_count)
		};
		if (book.workId > 0) {
			const editionRows = await sql<Array<{
				id: number;
				book_id: number | null;
				format: string | null;
				publisher: string | null;
				language: string | null;
				publication_date: string | null;
				publication_year: number | null;
				page_count: number | null;
				isbn13: string | null;
				isbn10: string | null;
				cover_url: string | null;
			}>>`
				select
					be.id,
					be.book_id,
					coalesce(nullif(trim(be.format), ''), 'Book') as format,
					coalesce(nullif(trim(be.publisher), ''), '') as publisher,
					coalesce(nullif(trim(be.language), ''), '') as language,
					be.publication_date::text as publication_date,
					be.publication_year,
					be.page_count,
					coalesce(nullif(trim(be.isbn13), ''), '') as isbn13,
					coalesce(nullif(trim(be.isbn10), ''), '') as isbn10,
					coalesce(nullif(trim(be.cover_url), ''), '') as cover_url
				from book_edition be
				where be.work_id = ${book.workId}
				order by
					case when be.book_id = ${book.id} then 0 else 1 end,
					case lower(coalesce(be.format, ''))
						when 'hardcover' then 1
						when 'paperback' then 2
						when 'ebook' then 3
						when 'audiobook' then 4
						else 5
					end,
					coalesce(be.publication_date::text, ''),
					be.id
				limit 12
			`;
			const seenEditions = new Set<string>();
			availableEditions = editionRows
				.map((edition) => ({
					id: Number(edition.id || 0),
					bookId: Number(edition.book_id || 0),
					format: normalizeText(edition.format) || "Book",
					publisher: normalizeText(edition.publisher),
					language: normalizeText(edition.language).toUpperCase(),
					publicationLabel: formatPublishedLabel(normalizeText(edition.publication_date)) || (edition.publication_year ? String(edition.publication_year) : ""),
					pageCount: normalizeCatalogPageCount(edition.page_count),
					isbn: normalizeText(edition.isbn13 || edition.isbn10),
					coverUrl: normalizeText(edition.cover_url)
				}))
				.filter((edition) => {
					const key = `${edition.format}|${edition.publisher}|${edition.publicationLabel}|${edition.isbn}|${edition.pageCount}`;
					if (!key.replace(/\|/g, "") || seenEditions.has(key)) return false;
					seenEditions.add(key);
					return true;
				});
		}
		const genreRows = await sql<Array<{ genre_name: string }>>`
			select distinct coalesce(nullif(trim(genre_name), ''), '') as genre_name
			from book_genre
			where book_id = ${book.id}
			order by genre_name asc
			limit 6
		`;
		const genreDedupe = new Set<string>();
		bookGenres = genreRows
			.map((row) => normalizeText(row.genre_name))
			.filter((value) => value && !isDisplayNoise(value))
			.flatMap((value) => normalizeGenreEntry(value))
			.map((item) => item.name)
			.filter((label) => {
				const key = canonicalTagKey(label);
				if (!key || genreDedupe.has(key)) return false;
				genreDedupe.add(key);
				return true;
			})
			.slice(0, 8);
		const topicRows = await sql<Array<{ tag_name: string }>>`
			select distinct coalesce(nullif(trim(tag_name), ''), '') as tag_name
			from book_tag
			where book_id = ${book.id}
			order by tag_name asc
			limit 8
		`;
		const genreKeySet = new Set(bookGenres.map((value) => canonicalTagKey(value)).filter(Boolean));
		const topicDedupe = new Set<string>();
		bookTopics = topicRows
			.map((row) => normalizeText(row.tag_name))
			.filter((value) => value && !isDisplayNoise(value))
			.map((value) => formatTopicLabel(value))
			.filter((label) => {
				const key = canonicalTagKey(label);
				if (!key || genreKeySet.has(key) || topicDedupe.has(key)) return false;
				topicDedupe.add(key);
				return true;
			})
			.filter(Boolean)
			.slice(0, 8);

		const encryptionKey = getEncryptionKey();
		await ensureReviewSchema(sql);
		let activityRows: Array<{
			id: number;
			event_type: string;
			created_at: string;
			username: string | null;
			email_local: string | null;
			rating: number | null;
			like_count: number;
			viewer_liked: boolean;
		}> = [];
		try {
			activityRows = await sql<Array<{
				id: number;
				event_type: string;
				created_at: string;
				username: string | null;
				email_local: string | null;
				rating: number | null;
				like_count: number;
				viewer_liked: boolean;
			}>>`
				select
					ua.id,
					ua.event_type,
					ua.created_at::text as created_at,
					au.username,
					nullif(split_part(coalesce(pgp_sym_decrypt(au.email_enc, ${encryptionKey}), ''), '@', 1), '') as email_local,
					coalesce(ub.rating, ua.rating) as rating,
					coalesce(la.like_count, 0)::int as like_count,
					coalesce(la.viewer_liked, false) as viewer_liked
				from user_activity ua
				join app_user au on au.id = ua.user_id
				left join user_book ub on ub.user_id = ua.user_id and ub.book_id = ua.book_id
				left join lateral (
					select
						count(*)::int as like_count,
						bool_or(ual.user_id = ${session?.userId || "00000000-0000-0000-0000-000000000000"}::uuid) as viewer_liked
					from user_activity_like ual
					where ual.activity_id = ua.id
				) la on true
				where ua.book_id = ${book.id}
				order by ua.created_at desc, ua.id desc
				limit 40
			`;
		} catch {
			activityRows = await sql<Array<{
				id: number;
				actor_user_id: string;
				event_type: string;
				created_at: string;
				username: string | null;
				email_local: string | null;
				rating: number | null;
				like_count: number;
				viewer_liked: boolean;
			}>>`
				select
					ua.id,
					ua.user_id::text as actor_user_id,
					ua.event_type,
					ua.created_at::text as created_at,
					au.username,
					nullif(split_part(coalesce(pgp_sym_decrypt(au.email_enc, ${encryptionKey}), ''), '@', 1), '') as email_local,
					coalesce(ub.rating, ua.rating) as rating,
					0::int as like_count,
					false as viewer_liked
				from user_activity ua
				join app_user au on au.id = ua.user_id
				left join user_book ub on ub.user_id = ua.user_id and ub.book_id = ua.book_id
				where ua.book_id = ${book.id}
				order by ua.created_at desc, ua.id desc
				limit 40
			`;
		}
		activity = activityRows.map((item) => ({
			id: Math.max(0, Number(item.id || 0)),
			eventType: normalizeText(item.event_type),
			timestamp: item.created_at,
			actorUsername: normalizeText(item.username),
			actorName: normalizeText(item.username) || normalizeText(item.email_local) || "A Reader",
			rating: Math.max(0, Math.min(5, Number(item.rating || 0) || 0)),
			likeCount: Math.max(0, Number(item.like_count || 0)),
			viewerLiked: !!item.viewer_liked
		}));
		const reviewRows = await sql<Array<{
			user_id: string;
			username: string | null;
			email_local: string | null;
			rating: number | null;
			review_title: string | null;
			finished_reflection: string | null;
			review_spoiler: boolean | null;
			review_updated_at: string | null;
			updated_at: string;
		}>>`
			select
				ub.user_id::text as user_id,
				au.username,
				nullif(split_part(coalesce(pgp_sym_decrypt(au.email_enc, ${encryptionKey}), ''), '@', 1), '') as email_local,
				ub.rating,
				ub.review_title,
				ub.finished_reflection,
				ub.review_spoiler,
				ub.review_updated_at::text as review_updated_at,
				ub.updated_at::text as updated_at
			from user_book ub
			join app_user au on au.id = ub.user_id
			where ub.book_id = ${book.id}
				and (
					char_length(trim(coalesce(ub.finished_reflection, ''))) > 0
					or char_length(trim(coalesce(ub.review_title, ''))) > 0
				)
			order by ub.updated_at desc, ub.user_id asc
		`;
		reviews = buildBookReviewList(reviewRows);
	} else {
		const google = await fetchGoogleBook();
		if (google) {
			const info = google.volumeInfo || {};
			book = {
				id: 0,
				workId: 0,
				title: normalizeText(info.title || queryTitle),
				author: normalizeText(Array.isArray(info.authors) ? info.authors[0] : queryAuthor),
				authorId: 0,
				synopsis: sanitizeSynopsis(info.description || ""),
				coverUrl: googleBooksCoverUrl(info.imageLinks, "detail"),
				language: normalizeText(info.language),
				isbn10: normalizeText(queryIsbn10),
				isbn13: normalizeText(queryIsbn13),
				googleBooksId: normalizeText(google.id || queryGoogleBooksId),
				publishedLabel: formatPublishedLabel(normalizeText(info.publishedDate || "")),
				shelves: 0,
				readers: 0,
				averageRating: Number(info.averageRating || 0),
				ratingCount: Number(info.ratingsCount || 0)
				,pageCount: normalizeCatalogPageCount(info.pageCount)
			};
		} else {
			const open = await fetchOpenLibraryBook();
			if (open) {
				book = {
					id: 0,
					workId: 0,
					title: open.title || queryTitle,
					author: open.author || queryAuthor,
					authorId: 0,
					synopsis: open.synopsis,
					coverUrl: open.coverUrl,
					language: "",
					isbn10: queryIsbn10,
					isbn13: queryIsbn13,
					googleBooksId: queryGoogleBooksId,
					publishedLabel: open.publishedLabel,
					shelves: 0,
					readers: 0,
					averageRating: 0,
					ratingCount: 0
					,pageCount: 0
				};
			}
		}
	}

if (book && session?.userId) {
	try {
		customShelfOptionsJson = JSON.stringify(await resolveCustomShelfOptions(sql, session.userId));
	} catch {
		customShelfOptionsJson = "[]";
	}
	const directBookId = Number(book.id || 0);
		if (directBookId > 0) {
			const rows = await sql<Array<{ status: "want_to_read" | "reading" | "finished"; rating: number | null; review_title: string | null; finished_reflection: string | null; review_spoiler: boolean | null }>>`
				select ub.status, ub.rating, ub.review_title, ub.finished_reflection, ub.review_spoiler
				from user_book ub
				where ub.user_id = ${session.userId}::uuid
					and ub.book_id = ${directBookId}
				limit 1
			`;
			readerOwnsBook = rows.length > 0;
			const status = String(rows[0]?.status || "").trim();
			if (status === "want_to_read" || status === "reading" || status === "finished") {
				viewerShelfStatus = status;
				viewerRating = Math.max(0, Math.min(5, Number(rows[0]?.rating || 0) || 0));
				viewerReviewTitle = normalizeText(rows[0]?.review_title);
				viewerReviewBody = normalizeText(rows[0]?.finished_reflection);
				viewerReviewSpoiler = rows[0]?.review_spoiler === true;
			}
			if (readerOwnsBook) journalEntries = await loadJournalEntriesForBook(sql, session.userId, directBookId, 5);
		}
		if (!viewerShelfStatus) {
			const isbn13 = normalizeText(book.isbn13);
			const isbn10 = normalizeText(book.isbn10);
			const googleBooksId = normalizeText(book.googleBooksId);
			const normalizedTitle = canonicalizeTitle(book.title).replace(/[^a-z0-9]+/g, "");
			const normalizedAuthor = canonicalizeAuthor(book.author).replace(/[^a-z0-9]+/g, "");
			const rows = await sql<Array<{ status: "want_to_read" | "reading" | "finished"; rating: number | null; review_title: string | null; finished_reflection: string | null; review_spoiler: boolean | null }>>`
				select ub.status, ub.rating, ub.review_title, ub.finished_reflection, ub.review_spoiler
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${session.userId}::uuid
					and (
						(${isbn13} <> '' and b.isbn13 = ${isbn13})
						or (${isbn10} <> '' and b.isbn10 = ${isbn10})
						or (${googleBooksId} <> '' and b.google_books_id = ${googleBooksId})
						or (
							${normalizedTitle} <> ''
							and lower(regexp_replace(coalesce(b.title, ''), '[^[:alnum:]]+', '', 'g')) = ${normalizedTitle}
							and (
								${normalizedAuthor} = ''
								or lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) = ${normalizedAuthor}
							)
						)
					)
				order by ub.updated_at desc nulls last, ub.book_id desc
				limit 1
			`;
			const status = String(rows[0]?.status || "").trim();
			if (status === "want_to_read" || status === "reading" || status === "finished") {
				viewerShelfStatus = status;
				viewerRating = Math.max(0, Math.min(5, Number(rows[0]?.rating || 0) || 0));
				viewerReviewTitle = normalizeText(rows[0]?.review_title);
				viewerReviewBody = normalizeText(rows[0]?.finished_reflection);
				viewerReviewSpoiler = rows[0]?.review_spoiler === true;
			}
		}
	}
	if (book?.id) {
		seriesContext = await loadBookSeriesContext(sql, book.id, session?.userId || "");
		readersAlsoEnjoyed = await loadReadersAlsoEnjoyed(sql, book.id, session?.userId || "", 6).catch(() => null);
	}
} catch (error) {
	errorMessage = error instanceof Error ? error.message : "Failed to load book.";
}

const synopsisBlocks = book ? synopsisParagraphs(book.synopsis) : [];
const canonicalBookId = Math.max(0, Number(book?.id || 0) || 0);
const bookCanonicalUrl = canonicalBookId > 0
	? `/book?bookId=${encodeURIComponent(String(canonicalBookId))}`
	: (
		queryGoogleBooksId
			? `/book?googleBooksId=${encodeURIComponent(queryGoogleBooksId)}`
			: (
				queryIsbn13
					? `/book?isbn13=${encodeURIComponent(queryIsbn13)}`
					: (
						queryIsbn10
							? `/book?isbn10=${encodeURIComponent(queryIsbn10)}`
							: "/book"
					)
			)
	);
const bookRobots = book && canonicalBookId > 0 && !errorMessage ? "index,follow" : "noindex,follow";
const bookDescription = book
	? `${book.title}${book.author ? ` by ${book.author}` : ""}. ${book.pageCount > 0 ? `${book.pageCount.toLocaleString()} pages. ` : ""}${book.shelves.toLocaleString()} shelf entries on DogEared.`
	: "Book details and shelf activity on DogEared.";
const bookStructuredData = book
	? JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Book",
		name: book.title,
		author: book.author ? [{ "@type": "Person", name: book.author }] : undefined,
		image: book.coverUrl || undefined,
		isbn: book.isbn13 || book.isbn10 || undefined,
		numberOfPages: book.pageCount > 0 ? book.pageCount : undefined,
		datePublished: book.publishedLabel || undefined,
		interactionStatistic: book.readers > 0 ? {
			"@type": "InteractionCounter",
			interactionType: "https://schema.org/ReadAction",
			userInteractionCount: book.readers
		} : undefined,
		aggregateRating: book.ratingCount > 0 ? {
			"@type": "AggregateRating",
			ratingValue: Number(book.averageRating || 0).toFixed(2),
			ratingCount: book.ratingCount
		} : undefined,
		url: toAbsoluteUrl(bookCanonicalUrl, Astro.site ?? Astro.url)
	})
	: "";
const bookBreadcrumbStructuredData = JSON.stringify(buildBreadcrumbList([
	{ name: "Home", item: "/" },
	{ name: "Books", item: "/books" },
	{ name: book ? book.title : "Book", item: bookCanonicalUrl }
], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV }));
const bookStructuredDataPayload = bookStructuredData
	? JSON.stringify([JSON.parse(bookStructuredData), JSON.parse(bookBreadcrumbStructuredData)])
	: "";
---

<Layout
	title={book?.title || "Book"}
	metaDescription={bookDescription}
	canonicalUrl={bookCanonicalUrl}
	socialImage={book?.coverUrl || "/og-image.png"}
	socialImageAlt={book ? `Cover of ${book.title}${book.author ? ` by ${book.author}` : ""}` : "DogEared book details"}
	ogType="book"
	robots={bookRobots}
	structuredData={bookStructuredDataPayload}
>
	<div slot="right" class="book-page" data-authenticated={String(isAuthenticated)}>
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			{book ? (
				<>
					<a href="/books">Books</a>
					<span aria-hidden="true">/</span>
					<span>{book.title}</span>
				</>
			) : <span>Book</span>}
		</nav>
		{errorMessage && <p class="error">{errorMessage}</p>}
		{!errorMessage && !book && <p>Book not found.</p>}
		{book && (
			<>
				<section class="book-head">
					<ul class="book-head-grid">
						<BookCard
							title={book.title}
							titleHref=""
							author={book.author}
							authorHref={book.author ? authorHref(book.author, book.authorId) : ""}
							thumbnail={book.coverUrl}
							description=""
							readers={book.readers}
							shelfEntries={book.shelves}
							publishedLabel={book.publishedLabel}
							pageCount={book.pageCount}
							averageRating={book.averageRating}
							seriesLabel={seriesContext?.currentBook ? `${seriesContext.series.name}${seriesContext.currentBook.bookOrder > 0 ? ` · Book ${seriesContext.currentBook.bookOrder}` : ""}` : ""}
						>
							<div slot="meta">
								{book.ratingCount > 0 && (
									<p class="meta rating">Ratings: {book.ratingCount} total</p>
								)}
								{isAuthenticated && book.id > 0 && viewerShelfStatus === "finished" && (
									<RatingControl bookId={book.id} rating={viewerRating} editable={true} />
								)}
							</div>
							<div slot="actions">
								<ShelfDropdown attrs={{
									"data-title": book.title,
									"data-author": book.author,
									"data-description": book.synopsis,
									"data-cover": book.coverUrl,
									"data-pages": String(book.pageCount || 0),
									"data-categories": "[]",
									"data-isbn10": book.isbn10,
									"data-isbn13": book.isbn13,
									"data-google-books-id": book.googleBooksId,
									"data-book-id": String(book.id || 0),
									"data-custom-shelves": customShelfOptionsJson,
									"data-initial-status": viewerShelfStatus,
									"data-hide-label": "true"
								}} />
							</div>
						</BookCard>
					</ul>
				</section>

				{availableEditions.length > 1 && (
					<section class="panel editions-panel" aria-labelledby="available-editions-heading">
						<div class="editions-head">
							<h2 id="available-editions-heading">Available Editions</h2>
						</div>
						<ul class="editions-list">
							{availableEditions.map((edition) => (
								<li class={`edition-item${edition.bookId === book.id ? " is-current" : ""}`}>
									{edition.coverUrl ? (
										<img class="edition-cover" src={edition.coverUrl} alt="" loading="lazy" decoding="async" width="38" height="56" />
									) : (
										<div class="edition-cover edition-cover-placeholder" aria-hidden="true"><span class="material-icons">menu_book</span></div>
									)}
									<div class="edition-main">
										<p class="edition-format">{edition.format}{edition.bookId === book.id ? " · Current" : ""}</p>
										<p class="edition-meta">
											{[edition.publisher, edition.publicationLabel, edition.language, edition.pageCount > 0 ? `${edition.pageCount.toLocaleString()} pages` : "", edition.isbn ? `ISBN ${edition.isbn}` : ""].filter(Boolean).join(" · ")}
										</p>
									</div>
								</li>
							))}
						</ul>
					</section>
				)}

				{seriesContext && (
					<section class="panel series-panel" aria-labelledby="series-heading">
						<div class="series-heading-row">
							{(seriesContext.series.coverUrl || seriesContext.currentBook?.coverUrl || book.coverUrl) ? (
								<img
									class="series-cover"
									src={seriesContext.series.coverUrl || seriesContext.currentBook?.coverUrl || book.coverUrl}
									alt=""
									loading="lazy"
									decoding="async"
									width="54"
									height="78"
								/>
							) : (
								<div class="series-cover series-cover-placeholder" aria-hidden="true"><span class="material-icons">auto_stories</span></div>
							)}
							<div>
								<h2 id="series-heading">Series</h2>
								<p class="series-name">{seriesContext.series.name}</p>
								{seriesContext.currentBook && (
									<p class="series-position">
										{seriesContext.currentBook.orderLabel}{seriesContext.series.totalBooks > 0 ? ` of ${seriesContext.series.totalBooks}` : ""}
									</p>
								)}
								{seriesContext.series.description && <p class="series-description">{seriesContext.series.description}</p>}
							</div>
						</div>
						<ol class="series-list">
							{seriesContext.books.map((seriesBook) => (
								<li class={`series-book${seriesBook.isCurrent ? " is-current" : ""}`} aria-current={seriesBook.isCurrent ? "true" : undefined}>
									{seriesBook.coverUrl ? (
										<img class="series-book-cover" src={seriesBook.coverUrl} alt="" loading="lazy" decoding="async" width="38" height="56" />
									) : (
										<div class="series-book-cover series-book-cover-placeholder" aria-hidden="true"><span class="material-icons">menu_book</span></div>
									)}
									<div class="series-book-main">
										<p class="series-book-order">{seriesBook.orderLabel}</p>
										{seriesBook.bookHref ? (
											<a class="series-book-title" href={seriesBook.bookHref}>{seriesBook.title}</a>
										) : (
											<span class="series-book-title">{seriesBook.title}</span>
										)}
										{seriesBook.isCurrent && <span class="series-current-badge">Current book</span>}
									</div>
									<div class="series-book-state">
										{seriesBook.shelfStatus === "finished" ? (
											<span class="series-state-read"><span aria-hidden="true">✓</span> Read</span>
										) : (
											shelfStatusLabel(seriesBook.shelfStatus || "") || "Not on shelf"
										)}
									</div>
								</li>
							))}
						</ol>
						{viewerShelfStatus === "finished" && seriesContext.nextBook && (
							<div
								class="series-continue"
								data-title={seriesContext.nextBook.title}
								data-author={seriesContext.nextBook.author || ""}
								data-description={seriesContext.nextBook.synopsis || ""}
								data-cover={seriesContext.nextBook.coverUrl || ""}
								data-pages={String(seriesContext.nextBook.pageCount || 0)}
								data-language={seriesContext.nextBook.language || ""}
								data-isbn10={seriesContext.nextBook.isbn10 || ""}
								data-isbn13={seriesContext.nextBook.isbn13 || ""}
								data-google-books-id={seriesContext.nextBook.googleBooksId || ""}
								data-book-id={String(seriesContext.nextBook.bookId || 0)}
							>
								<div>
									<p class="series-continue-eyebrow">Continue the series →</p>
									<p class="series-continue-title">{seriesContext.nextBook.title}</p>
									<p class="series-continue-meta">{seriesContext.nextBook.orderLabel}</p>
								</div>
								{seriesContext.nextBook.shelfStatus ? (
									<p class="series-continue-state">Already on {shelfStatusLabel(seriesContext.nextBook.shelfStatus)}</p>
								) : (
									<button type="button" class="series-continue-button" data-action="series-add-want">Add to Want to Read</button>
								)}
								<p class="series-continue-feedback" role="status" aria-live="polite" hidden></p>
							</div>
						)}
					</section>
				)}

				<section class="panel synopsis-panel">
					<h2>Synopsis</h2>
					{book.author && (
						<div class="related-links-row related-links-row--author">
							<a class="related-link author-link-chip" href={authorHref(book.author, book.authorId)}>More by {book.author}</a>
						</div>
					)}
					{bookGenres.length > 0 && (
						<div class="related-links-row related-links-row--genres">
							{bookGenres.map((genre) => (
								<Chip className="genre-chip" kind="genre" label={genre} href={`/related?kind=genre&value=${encodeURIComponent(genre)}`} />
							))}
						</div>
					)}
					{bookTopics.length > 0 && (
						<div class="related-links-row related-links-row--topics">
							{bookTopics.map((topic) => (
								<Chip className="topic-chip" kind="topic" label={topic} href={`/related?kind=topic&value=${encodeURIComponent(topic)}`} />
							))}
						</div>
					)}
					{synopsisBlocks.length === 0 ? (
						<p class="synopsis-text">Synopsis unavailable.</p>
					) : (
						synopsisBlocks.map((paragraph) => <p class="synopsis-text">{paragraph}</p>)
					)}
				</section>

				{isAuthenticated && readerOwnsBook && book.id > 0 && (
					<section
						class="panel journal-panel"
						id="reading-journal"
						data-journal-panel
						data-book-id={String(book.id)}
						data-current-page={String(viewerShelfStatus === "reading" ? 0 : 0)}
						aria-labelledby="reading-journal-heading"
					>
						<div class="journal-head">
							<div>
								<p class="journal-eyebrow">Private notebook</p>
								<h2 id="reading-journal-heading">Reading Journal</h2>
								<p class="journal-description">Private entries for this book. They never appear in activity feeds or on public profiles.</p>
							</div>
							<a class="journal-all-link" href={`/journal?bookId=${encodeURIComponent(String(book.id))}`}>View all journal entries</a>
						</div>
						{viewerShelfStatus === "reading" ? (
							<div class="journal-write">
								<h3>Write Journal Entry</h3>
								<form class="journal-form" data-journal-form>
									<input type="hidden" name="bookId" value={String(book.id)} />
									<div class="journal-grid-two">
										<label>
											<span>Title <em>optional</em></span>
											<input type="text" name="entryTitle" maxlength="160" placeholder="A thought to remember" />
										</label>
										<label>
											<span>Date and time</span>
											<input type="datetime-local" name="entryAt" />
										</label>
									</div>
									<label>
										<span>Body</span>
										<textarea name="body" rows="6" maxlength="8000" required placeholder="Capture a thought, quote, question, or moment from this reading session."></textarea>
									</label>
									<div class="journal-grid-two">
										<label>
											<span>Reading position <em>optional</em></span>
											<div class="journal-position-row">
												<select name="readingPositionType" aria-label="Reading position type">
													<option value="">No position</option>
													<option value="page">Page</option>
													<option value="percent">Percent</option>
													<option value="chapter">Chapter</option>
													<option value="location">Location</option>
													<option value="audio">Audiobook time</option>
												</select>
												<input type="text" name="readingPositionValue" maxlength="160" placeholder="20, 58%, Chapter 4, Kindle location 1234, or 1h 20m" />
											</div>
										</label>
										<label>
											<span>Mood <em>optional</em></span>
											<input type="text" name="mood" maxlength="80" />
										</label>
									</div>
									<div class="journal-actions">
										<button type="submit" data-journal-save>Save entry</button>
										<p class="journal-status" data-journal-status role="status" aria-live="polite">Drafts autosave as you write.</p>
										<p class="journal-count" data-journal-count>0 characters</p>
									</div>
								</form>
							</div>
						) : (
							<p class="journal-description">Add this book to Currently Reading to create new journal entries from the book page.</p>
						)}
						<div class="journal-recent">
							<h3>Recent entries</h3>
							{journalEntries.length === 0 ? (
								<p class="journal-description">No private entries for this book yet.</p>
							) : (
								<ul>
									{journalEntries.map((entry) => (
										<li>
											<strong>{entry.entryTitle || "Journal entry"}</strong>
											<span>{formatActivityDate(entry.entryAt || entry.updatedAt)}{formatReadingPosition(entry.readingPositionType, entry.readingPositionValue) && <> · {formatReadingPosition(entry.readingPositionType, entry.readingPositionValue)}</>}</span>
											<p>{String(entry.body || "").replace(/\s+/g, " ").trim().slice(0, 180)}</p>
										</li>
									))}
								</ul>
							)}
						</div>
					</section>
				)}

				{readersAlsoEnjoyed && readersAlsoEnjoyed.books.length > 0 && (
					<section class="panel readers-also-panel" id="readers-also-enjoyed">
						<div class="readers-also-head">
							<h2>{readersAlsoEnjoyed.title}</h2>
							<p>{readersAlsoEnjoyed.subtitle}</p>
						</div>
						<ul class="readers-also-list">
							{readersAlsoEnjoyed.books.map((recommendation) => {
								const recommendationBookId = Number(String(recommendation.id || "").replace(/^book_/, ""));
								return (
									<BookCard
										title={recommendation.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(recommendationBookId))}`}
										author={recommendation.authors.join(", ") || "Unknown author"}
										authorHref={recommendation.authorHref}
										thumbnail={recommendation.thumbnail}
										description={recommendation.description || "Synopsis unavailable for this edition."}
										readers={recommendation.shelfCount}
										shelfEntries={recommendation.shelfCount}
										publishedLabel={recommendation.publishedDate ? formatPublishedLabel(recommendation.publishedDate) : ""}
										pageCount={recommendation.pageCount}
										averageRating={recommendation.averageRating}
										seriesLabel={recommendation.seriesLabel}
									>
										<p slot="preTitle" class="recommendation-reason">{recommendation.recommendationReason}</p>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-title": recommendation.title,
												"data-author": recommendation.authors[0] || "",
												"data-description": recommendation.description,
												"data-cover": recommendation.thumbnail,
												"data-pages": String(recommendation.pageCount || 0),
												"data-isbn10": recommendation.isbn10 || "",
												"data-isbn13": recommendation.isbn13 || "",
												"data-google-books-id": recommendation.source === "google_books" ? recommendation.sourceWorkId || "" : "",
												"data-book-id": String(recommendationBookId),
												"data-initial-status": ""
											}} />
										</div>
									</BookCard>
								);
							})}
						</ul>
					</section>
				)}

				<section class="panel reviews-panel" id="reviews">
					<div class="reviews-heading">
						<div>
							<h2>Reviews</h2>
							<p class="reviews-summary">
								{book.ratingCount > 0 ? `${book.averageRating.toFixed(1)}/5 average from ${book.ratingCount} rating${book.ratingCount === 1 ? "" : "s"}.` : "No ratings yet."}
							</p>
						</div>
					</div>
					{isAuthenticated && book.id > 0 && viewerShelfStatus === "finished" && (
						<form
							class="review-editor"
							data-review-editor
							data-book-id={String(book.id)}
							data-draft-key={`dogeared:review-draft:${book.id}`}
						>
							<div>
								<p class="review-editor-eyebrow">Public recommendation</p>
								<h3>{viewerReviewTitle || viewerReviewBody ? "Edit Your Review" : "Write Your Review"}</h3>
								<p>Reviews help other readers decide what to read. Private reading notes belong in your Reading Journal.</p>
							</div>
							<fieldset class="review-rating-field">
								<legend>Rating</legend>
								<div class="review-rating-inputs">
									{[1, 2, 3, 4, 5].map((value) => (
										<label>
											<input type="radio" name="rating" value={String(value)} checked={viewerRating === value} />
											<span aria-hidden="true">★</span>
											<span class="sr-only">{value} star{value === 1 ? "" : "s"}</span>
										</label>
									))}
								</div>
							</fieldset>
							<label>
								<span>Review title <em>optional</em></span>
								<input type="text" name="title" maxlength="160" value={viewerReviewTitle} placeholder="A short headline" />
							</label>
							<label>
								<span>Review <em>optional</em></span>
								<textarea name="body" rows="6" maxlength="4000" placeholder="Would you recommend this book? What should future readers know?">{viewerReviewBody}</textarea>
							</label>
							<label class="review-spoiler-toggle">
								<input type="checkbox" name="spoiler" checked={viewerReviewSpoiler} />
								<span>This review contains spoilers</span>
							</label>
							<div class="review-editor-actions">
								<button type="submit">Save review</button>
								<button type="button" class="secondary" data-action="clear-review-draft">Clear draft</button>
								{(viewerReviewTitle || viewerReviewBody) && <button type="button" class="danger-secondary" data-action="delete-review">Delete review</button>}
								<p class="review-editor-status" data-review-status role="status" aria-live="polite">Drafts autosave locally as you write.</p>
							</div>
						</form>
					)}
					{reviews.length === 0 ? (
						<div class="review-empty">
							<p>No written reviews yet. Reviews help other readers decide what to read next.</p>
							{isAuthenticated && book.id > 0 && viewerShelfStatus === "finished" ? (
								<a href="#reviews">Write your first review</a>
							) : (
								<p class="meta">Finish this book to add a public review. Journal entries stay private.</p>
							)}
						</div>
					) : (
						<ul class="reviews-list">
							{reviews.map((review) => (
								<li class={`review-card${review.hasSpoiler ? " has-spoiler" : ""}`} id={`review-${String(review.userId || "").replace(/[^a-zA-Z0-9_-]/g, "")}`}>
									<div class="review-card-head">
										<p class="review-rating">{review.rating > 0 ? `${renderAverageStars(review.rating)} ${review.rating}/5` : "No rating"}</p>
										<p class="review-user">@{review.username.replace(/^@+/, "")}</p>
										<p class="review-date">{formatActivityDate(review.reviewDate)}</p>
									</div>
									{review.title && <h3 class="review-title">{review.title}</h3>}
									{review.hasSpoiler && <p class="review-spoiler-label">Contains spoilers</p>}
									{review.hasSpoiler ? (
										<details class="review-spoiler-details">
											<summary>Show spoiler review</summary>
											<p class="review-body" data-review-body>{review.body}</p>
										</details>
									) : (
										<>
											<p class="review-body" data-review-body>{review.body}</p>
											{review.body.length > 520 && <button type="button" class="review-expand" data-action="expand-review">Show full review</button>}
										</>
									)}
								</li>
							))}
						</ul>
					)}
				</section>

				<section class="panel activity-panel">
					<h2>Recent Activity</h2>
					{activity.length === 0 ? (
						<p>No recent activity yet. Add this book to your shelf or rate it to start activity.</p>
					) : (
						<ul class="activity-grid">
							{activity.map((item) => (
								<BookCard
									title={book.title}
									titleHref={`/book?bookId=${encodeURIComponent(String(book.id || 0))}`}
									author={book.author}
									authorHref=""
									thumbnail={book.coverUrl}
									readers={1}
									shelfEntries={1}
									publishedLabel={book.publishedLabel}
									pageCount={book.pageCount}
									averageRating={0}
								>
									<p slot="preTitle" class="meta activity-headline">
										{item.actorUsername && <span class="activity-user"><a href={`/profile/${encodeURIComponent(item.actorUsername)}`}>@{item.actorUsername}</a>&nbsp;</span>}
										{!item.actorUsername && item.actorName && <span class="activity-user">{item.actorName}&nbsp;</span>}
										<span class="activity-prefix">{activityHeading(item.eventType).prefix}</span>
										{activityHeading(item.eventType).shelf && <>&nbsp;<em>{activityHeading(item.eventType).shelf}</em></>}
										{formatActivityDate(item.timestamp) && <>&nbsp;<span class="activity-date">· {formatActivityDate(item.timestamp)}</span></>}
									</p>
									<div slot="meta">
										{!item.actorUsername && <p class="meta">{item.actorName}</p>}
										{item.rating > 0 && <p class="meta rating-meta">{renderAverageStars(item.rating)} {item.rating}/5</p>}
									</div>
									<div slot="actions">
										<ShelfDropdown attrs={{
											"data-title": book.title,
											"data-author": book.author,
											"data-description": book.synopsis,
											"data-cover": book.coverUrl,
											"data-pages": String(book.pageCount || 0),
											"data-categories": "[]",
											"data-isbn10": book.isbn10,
											"data-isbn13": book.isbn13,
											"data-google-books-id": book.googleBooksId,
											"data-book-id": String(book.id || 0),
											"data-custom-shelves": customShelfOptionsJson,
											"data-initial-status": viewerShelfStatus
										}} />
									</div>
									<div
										slot="social"
										class="activity-comments-wrap"
										data-comments-wrap
										data-activity-id={String(item.id || 0)}
										data-comments-empty="1"
										data-loaded="0"
									>
										<div class="activity-social-row">
											<div class="activity-like-wrap">
												<button
													type="button"
													class={`activity-like-button${item.viewerLiked ? " is-liked" : ""}`}
													data-action="toggle-activity-like"
													data-activity-id={String(item.id || 0)}
													data-liked={String(!!item.viewerLiked)}
													disabled={!isAuthenticated}
													aria-label={item.viewerLiked ? "Unlike this activity" : "Like this activity"}
													title={!isAuthenticated ? "Log in to like activity" : ""}
												>
													<span class="activity-like-label">{item.viewerLiked ? "Liked" : "Like"}</span>
												</button>
												<span class="activity-like-count" data-like-count-static>{Math.max(0, Number(item.likeCount || 0))}</span>
											</div>
											<form class="activity-comment-form" data-comment-form>
												<input type="text" name="comment" maxlength="500" placeholder="Leave a comment..." {...(!isAuthenticated ? { disabled: true } : {})} />
												<button type="submit" {...(!isAuthenticated ? { disabled: true, title: "Log in to comment" } : {})}>Post</button>
											</form>
										</div>
										<div class="activity-comments-list" data-comments-list></div>
										<p class="activity-comment-feedback" data-comment-feedback role="status" aria-live="polite" hidden></p>
									</div>
								</BookCard>
							))}
						</ul>
					)}
				</section>
			</>
		)}
	</div>
</Layout>

<script type="module">
	const root = document.querySelector(".book-page");
	if (root instanceof HTMLElement) {
		const isAuthenticated = root.dataset.authenticated === "true";
		const nextPath = `${window.location.pathname}${window.location.search}`;
		const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			'"': "&quot;",
			"'": "&#39;"
		}[char] || char));
		const toAgeLabel = (value) => {
			const parsed = new Date(String(value || ""));
			if (!Number.isFinite(parsed.getTime())) return "";
			const diffMs = Math.max(0, Date.now() - parsed.getTime());
			const diffHours = diffMs / (1000 * 60 * 60);
			if (diffHours < 24) {
				const hours = Math.max(0, Math.round(diffHours));
				return `${hours} ${hours === 1 ? "hour" : "hours"}`;
			}
			const days = Math.max(1, Math.round(diffHours / 24));
			return `${days} ${days === 1 ? "day" : "days"}`;
		};
		const renderCommentHtml = (comment) => {
			const username = String(comment?.username || "").trim().replace(/^@+/, "") || "reader";
			const body = String(comment?.body || "").trim();
			if (!body) return "";
			const ageLabel = toAgeLabel(comment?.createdAt);
			const commentId = Math.max(0, Number(comment?.id || 0) || 0);
			const isMine = !!comment?.isMine && commentId > 0;
			const profileHref = `/profile/${encodeURIComponent(username)}`;
			return `<p class="activity-comment-item"${commentId > 0 ? ` data-comment-id="${commentId}"` : ""}><span class="activity-comment-head"><a class="activity-comment-user" href="${profileHref}">@${escapeHtml(username)}</a><span class="activity-comment-meta">${ageLabel ? `<span class="activity-comment-age">${escapeHtml(ageLabel)}</span>` : ""}${isMine ? `<button type="button" class="activity-comment-delete" data-action="delete-comment" data-comment-id="${commentId}" aria-label="Delete comment" title="Delete comment">&times;</button>` : ""}</span></span><span class="activity-comment-body">${escapeHtml(body)}</span></p>`;
		};

		for (const button of Array.from(document.querySelectorAll('[data-action="expand-review"]'))) {
			button.addEventListener("click", () => {
				const card = button.closest(".review-card");
				const body = card?.querySelector("[data-review-body]");
				if (body instanceof HTMLElement) body.classList.add("is-expanded");
				button.remove();
			});
		}

		const reviewEditor = document.querySelector("[data-review-editor]");
		if (reviewEditor instanceof HTMLFormElement) {
			const bookId = Math.max(0, Number(reviewEditor.dataset.bookId || 0) || 0);
			const draftKey = String(reviewEditor.dataset.draftKey || `dogeared:review-draft:${bookId}`);
			const status = reviewEditor.querySelector("[data-review-status]");
			const setReviewStatus = (message, isError = false) => {
				if (!(status instanceof HTMLElement)) return;
				status.textContent = message;
				status.classList.toggle("is-error", isError);
			};
			const readReviewPayload = () => {
				const formData = new FormData(reviewEditor);
				const ratingRaw = Number(formData.get("rating") || 0);
				return {
					bookId,
					rating: Number.isFinite(ratingRaw) && ratingRaw >= 1 && ratingRaw <= 5 ? ratingRaw : null,
					title: String(formData.get("title") || "").trim(),
					body: String(formData.get("body") || "").trim(),
					spoiler: formData.get("spoiler") === "on"
				};
			};
			const saveDraft = () => {
				try {
					localStorage.setItem(draftKey, JSON.stringify(readReviewPayload()));
					setReviewStatus("Draft saved locally.");
				} catch {
					setReviewStatus("Draft autosave is unavailable in this browser.");
				}
			};
			try {
				const draft = JSON.parse(localStorage.getItem(draftKey) || "null");
				if (draft && (draft.title || draft.body)) {
					const title = reviewEditor.querySelector('[name="title"]');
					const body = reviewEditor.querySelector('[name="body"]');
					const spoiler = reviewEditor.querySelector('[name="spoiler"]');
					if (title instanceof HTMLInputElement && !title.value) title.value = String(draft.title || "");
					if (body instanceof HTMLTextAreaElement && !body.value) body.value = String(draft.body || "");
					if (spoiler instanceof HTMLInputElement) spoiler.checked = !!draft.spoiler;
					setReviewStatus("Recovered an unsaved local draft.");
				}
			} catch {
				// Ignore broken local drafts.
			}
			reviewEditor.addEventListener("input", saveDraft);
			reviewEditor.addEventListener("change", saveDraft);
			reviewEditor.addEventListener("submit", async (event) => {
				event.preventDefault();
				const submitButton = reviewEditor.querySelector('button[type="submit"]');
				if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
				setReviewStatus("Saving review...");
				try {
					const response = await fetch("/api/reviews/entry", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(readReviewPayload())
					});
					const data = await response.json().catch(() => ({}));
					if (!response.ok || data?.error) throw new Error(String(data?.error || "Failed to save review."));
					localStorage.removeItem(draftKey);
					setReviewStatus("Review saved. Refreshing...");
					window.location.hash = "reviews";
					window.location.reload();
				} catch (error) {
					setReviewStatus(error instanceof Error ? error.message : "Failed to save review.", true);
				} finally {
					if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
				}
			});
			reviewEditor.querySelector('[data-action="clear-review-draft"]')?.addEventListener("click", () => {
				localStorage.removeItem(draftKey);
				setReviewStatus("Local draft cleared.");
			});
			reviewEditor.querySelector('[data-action="delete-review"]')?.addEventListener("click", async () => {
				if (!window.confirm("Delete your public review for this book? Your rating will stay unless you clear it separately.")) return;
				setReviewStatus("Deleting review...");
				try {
					const response = await fetch("/api/reviews/entry", {
						method: "DELETE",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ bookId })
					});
					const data = await response.json().catch(() => ({}));
					if (!response.ok || data?.error) throw new Error(String(data?.error || "Failed to delete review."));
					localStorage.removeItem(draftKey);
					setReviewStatus("Review deleted. Refreshing...");
					window.location.hash = "reviews";
					window.location.reload();
				} catch (error) {
					setReviewStatus(error instanceof Error ? error.message : "Failed to delete review.", true);
				}
			});
		}

		const journalPanel = document.querySelector("[data-journal-panel]");
		if (journalPanel instanceof HTMLElement) {
			const form = journalPanel.querySelector("[data-journal-form]");
			const status = journalPanel.querySelector("[data-journal-status]");
			const count = journalPanel.querySelector("[data-journal-count]");
			const saveButton = journalPanel.querySelector("[data-journal-save]");
			const bookId = Math.max(0, Number(journalPanel.dataset.bookId || 0) || 0);
			const draftKey = `dogeared:journal-draft:${bookId}`;
			let saving = false;

			const setStatus = (message) => {
				if (status instanceof HTMLElement) status.textContent = message;
			};
			const fields = () => ({
				entryTitle: form?.querySelector('[name="entryTitle"]'),
				entryAt: form?.querySelector('[name="entryAt"]'),
				body: form?.querySelector('[name="body"]'),
				readingPositionType: form?.querySelector('[name="readingPositionType"]'),
				readingPositionValue: form?.querySelector('[name="readingPositionValue"]'),
				mood: form?.querySelector('[name="mood"]')
			});
			const readJournalPayload = () => {
				const currentFields = fields();
				const readText = (field) => field instanceof HTMLTextAreaElement || field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value : "";
				return {
					bookId,
					entryTitle: readText(currentFields.entryTitle),
					entryAt: readText(currentFields.entryAt),
					body: readText(currentFields.body),
					readingPositionType: readText(currentFields.readingPositionType),
					readingPositionValue: readText(currentFields.readingPositionValue),
					mood: readText(currentFields.mood),
					visibility: "private"
				};
			};
			const writeJournalPayload = (payload) => {
				const currentFields = fields();
				const writeText = (field, value) => {
					if (field instanceof HTMLTextAreaElement || field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = String(value || "");
				};
				writeText(currentFields.entryTitle, payload.entryTitle);
				writeText(currentFields.entryAt, payload.entryAt);
				writeText(currentFields.body, payload.body);
				writeText(currentFields.readingPositionType, payload.readingPositionType);
				writeText(currentFields.readingPositionValue, payload.readingPositionValue);
				writeText(currentFields.mood, payload.mood);
			};
			const updateCharacterCount = () => {
				const payload = readJournalPayload();
				const total = String(payload.body || "").length;
				if (count instanceof HTMLElement) count.textContent = `${total.toLocaleString()} ${total === 1 ? "character" : "characters"}`;
			};
			const rememberDraft = () => {
				try {
					window.localStorage.setItem(draftKey, JSON.stringify({ savedAt: new Date().toISOString(), payload: readJournalPayload() }));
				} catch {
					// Ignore local draft storage failures.
				}
			};
			const recoverDraft = () => {
				try {
					const raw = window.localStorage.getItem(draftKey);
					if (!raw) return;
					const draft = JSON.parse(raw);
					if (draft?.payload?.body) {
						writeJournalPayload(draft?.payload || {});
						setStatus("Recovered an unsaved local draft.");
					}
				} catch {
					// Ignore malformed drafts.
				}
			};
			const saveJournal = async () => {
				if (!bookId || saving) return;
					if (!String(readJournalPayload().body || "").trim()) {
						setStatus("Write a body before saving.");
						return;
					}
					const payload = readJournalPayload();
					if (String(payload.readingPositionValue || "").trim() && !String(payload.readingPositionType || "").trim()) {
						setStatus("Choose a reading position type or clear the position value.");
						return;
					}
					saving = true;
					if (saveButton instanceof HTMLButtonElement) saveButton.disabled = true;
					setStatus("Saving...");
					try {
						const response = await fetch("/api/journal/entries", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							credentials: "same-origin",
							body: JSON.stringify(payload)
						});
					const data = await response.json().catch(() => ({}));
					if (!response.ok) throw new Error(String(data?.error || "Failed to save journal."));
					try { window.localStorage.removeItem(draftKey); } catch {}
					writeJournalPayload({});
					updateCharacterCount();
					setStatus("Saved privately. Refresh to see the new entry in the list.");
				} catch (error) {
					setStatus(error instanceof Error ? error.message : "Failed to save journal.");
				} finally {
					saving = false;
					if (saveButton instanceof HTMLButtonElement) saveButton.disabled = false;
				}
			};
			const queueAutosave = () => {
				rememberDraft();
				updateCharacterCount();
				setStatus("Draft saved on this device.");
			};

			recoverDraft();
			const entryAt = form?.querySelector('[name="entryAt"]');
			if (entryAt instanceof HTMLInputElement && !entryAt.value) {
				const now = new Date();
				const local = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
				entryAt.value = local.toISOString().slice(0, 16);
			}
			updateCharacterCount();
			if (form instanceof HTMLFormElement) {
				form.addEventListener("input", queueAutosave);
				form.addEventListener("submit", (event) => {
					event.preventDefault();
					void saveJournal();
				});
			}
		}

		document.addEventListener("click", async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const deleteButton = target.closest('[data-action="delete-comment"]');
			if (deleteButton instanceof HTMLButtonElement) {
				const commentId = Number(deleteButton.dataset.commentId || 0);
				if (!Number.isFinite(commentId) || commentId <= 0) return;
				const commentItem = deleteButton.closest(".activity-comment-item");
				const wrap = deleteButton.closest("[data-comments-wrap]");
				const feedback = wrap?.querySelector("[data-comment-feedback]");
				const activityId = Number(wrap?.getAttribute("data-activity-id") || 0);
				deleteButton.disabled = true;
				try {
					const response = await fetch("/api/activity/comments", {
						method: "DELETE",
						headers: { "Content-Type": "application/json" },
						credentials: "same-origin",
						body: JSON.stringify({ commentId, activityId })
					});
					const data = await response.json().catch(() => ({}));
					if (response.status === 401) {
						window.location.href = `/?next=${encodeURIComponent(nextPath)}`;
						return;
					}
					if (!response.ok) {
						deleteButton.disabled = false;
						if (feedback instanceof HTMLElement) {
							feedback.hidden = false;
							feedback.textContent = String(data?.error || "Failed to delete comment.");
						}
						return;
					}
					commentItem?.remove();
					if (wrap instanceof HTMLElement) {
						const remaining = wrap.querySelectorAll(".activity-comment-item").length;
						wrap.dataset.commentsEmpty = remaining > 0 ? "0" : "1";
					}
					if (feedback instanceof HTMLElement) {
						feedback.hidden = true;
						feedback.textContent = "";
					}
				} catch {
					deleteButton.disabled = false;
				}
				return;
			}
			const likeButton = target.closest('[data-action="toggle-activity-like"]');
			if (!(likeButton instanceof HTMLButtonElement)) return;
			const activityId = Number(likeButton.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) return;
			if (!isAuthenticated) {
				window.location.href = `/?next=${encodeURIComponent(nextPath)}`;
				return;
			}
			const liked = likeButton.dataset.liked === "true";
			likeButton.disabled = true;
			try {
				const response = await fetch("/api/activity/like", {
					method: liked ? "DELETE" : "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ activityId })
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(String(data?.error || "Request failed"));
				const nextLiked = !!data.viewerLiked;
				likeButton.dataset.liked = String(nextLiked);
				likeButton.classList.toggle("is-liked", nextLiked);
				likeButton.setAttribute("aria-label", nextLiked ? "Unlike this activity" : "Like this activity");
				const label = likeButton.querySelector(".activity-like-label");
				if (label) label.textContent = nextLiked ? "Liked" : "Like";
				const countTarget = likeButton.closest(".activity-like-wrap")?.querySelector("[data-like-count-static]");
				if (countTarget) countTarget.textContent = String(Math.max(0, Number(data.likeCount || 0)));
			} catch {
				// no-op
			} finally {
				likeButton.disabled = false;
			}
		});

		document.addEventListener("submit", async (event) => {
			const form = event.target;
			if (!(form instanceof HTMLFormElement) || !form.matches("[data-comment-form]")) return;
			event.preventDefault();
			const wrap = form.closest("[data-comments-wrap]");
			if (!(wrap instanceof HTMLElement)) return;
			const activityId = Number(wrap.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) return;
			const input = form.querySelector('input[name="comment"]');
			const button = form.querySelector('button[type="submit"]');
			const list = wrap.querySelector("[data-comments-list]");
			const feedback = wrap.querySelector("[data-comment-feedback]");
			if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
			const message = String(input.value || "").trim();
			if (!message) return;
			input.disabled = true;
			button.disabled = true;
			try {
				const response = await fetch("/api/activity/comments", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ activityId, body: message })
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 401) {
					window.location.href = `/?next=${encodeURIComponent(nextPath)}`;
					return;
				}
				if (!response.ok) throw new Error(String(data?.error || "Failed to post comment."));
				if (list instanceof HTMLElement && data?.comment) {
					const wrapper = document.createElement("div");
					wrapper.innerHTML = renderCommentHtml(data.comment);
					const node = wrapper.firstElementChild;
					if (node) list.append(node);
				}
				input.value = "";
				if (feedback instanceof HTMLElement) {
					feedback.hidden = true;
					feedback.textContent = "";
				}
			} catch {
				if (feedback instanceof HTMLElement) {
					feedback.hidden = false;
					feedback.textContent = "Failed to post comment.";
				}
			} finally {
				input.disabled = false;
				button.disabled = false;
			}
		});

		const wraps = Array.from(document.querySelectorAll(".activity-panel [data-comments-wrap]"));
		for (const wrap of wraps) {
			if (!(wrap instanceof HTMLElement)) continue;
			const activityId = Number(wrap.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) continue;
			const list = wrap.querySelector("[data-comments-list]");
			const feedback = wrap.querySelector("[data-comment-feedback]");
			if (feedback instanceof HTMLElement) {
				feedback.hidden = true;
				feedback.textContent = "";
			}
			try {
				const response = await fetch(`/api/activity/comments?activityId=${encodeURIComponent(String(activityId))}`, { credentials: "same-origin" });
				const data = await response.json().catch(() => ({}));
				if (response.status === 401) {
					if (list instanceof HTMLElement) list.innerHTML = "";
					if (feedback instanceof HTMLElement) feedback.hidden = true;
					continue;
				}
				if (!response.ok) {
					if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to load comments.");
					continue;
				}
				if (list instanceof HTMLElement) {
					const comments = Array.isArray(data?.comments) ? data.comments : [];
					list.innerHTML = comments.map((comment) => renderCommentHtml(comment)).join("");
				}
				if (feedback instanceof HTMLElement) feedback.hidden = true;
			} catch {
				if (feedback instanceof HTMLElement) {
					feedback.hidden = false;
					feedback.textContent = "Failed to load comments.";
				}
			}
		}
	}
</script>

