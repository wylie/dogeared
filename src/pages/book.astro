<script>
	import { resolveClientAuthState } from "../lib/clientAuth.ts";
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		promptForShelfLogin,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		removeBookFromAllShelvesOnServer,
		resolveShelfRemoveMessage,
		toggleShelfMenu,
		initRatingControls
	} from "../lib/shelfClient.ts";
	import { normalizeBookPayload } from "../lib/bookPayload.ts";

	const page = document.querySelector(".book-page");
	let isAuthenticated = page?.dataset.authenticated === "true";
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const feedbackTimers = new WeakMap();
	initRatingControls();
	function buildEntry(source, status) {
		if (!(source instanceof HTMLElement)) return null;
		const bookPayload = normalizeBookPayload({
			title: String(source.dataset.title || "").trim(),
			author: String(source.dataset.author || "").trim(),
			description: String(source.dataset.description || "").trim(),
			pageCount: Number(source.dataset.pages || 0) || 0,
			coverUrl: String(source.dataset.cover || "").trim(),
			categories: [],
			format: "",
			language: String(source.dataset.language || "").trim(),
			publisher: "",
			publishedDate: "",
			isbn10: String(source.dataset.isbn10 || "").trim(),
			isbn13: String(source.dataset.isbn13 || "").trim(),
			googleBooksId: String(source.dataset.googleBooksId || "").trim()
		});
		return buildShelfEntryFromRecord({
			bookId: Number(source.dataset.bookId || 0),
			title: bookPayload.title,
			author: bookPayload.author,
			description: bookPayload.description,
			pageCount: bookPayload.pageCount,
			coverUrl: bookPayload.coverUrl,
			categories: bookPayload.categories,
			format: bookPayload.format,
			language: bookPayload.language,
			publisher: bookPayload.publisher,
			publishedDate: bookPayload.publishedDate,
			isbn10: bookPayload.isbn10,
			isbn13: bookPayload.isbn13,
			googleBooksId: bookPayload.googleBooksId
		}, {
			status,
			addedAt: Date.now(),
			updatedAt: Date.now()
		});
	}

	function setSelected(dropdown, status) {
		if (!(dropdown instanceof HTMLElement)) return;
		setShelvedState(dropdown, true);
		setDropdownLabel(dropdown, status);
	}

	function showSeriesFeedback(container, message) {
		const feedback = container?.querySelector?.(".series-continue-feedback");
		if (feedback instanceof HTMLElement) {
			feedback.hidden = false;
			feedback.textContent = message;
		}
	}

	resolveClientAuthState().then((state) => {
		isAuthenticated = !!state.isAuthenticated;
	}).catch(() => {});

	document.addEventListener("click", async (event) => {
		const target = event.target instanceof HTMLElement ? event.target : null;
		if (!target) return;

		const seriesAdd = target.closest('[data-action="series-add-want"]');
		if (seriesAdd instanceof HTMLButtonElement) {
			const container = seriesAdd.closest(".series-continue");
			if (!isAuthenticated) {
				promptForShelfLogin();
				return;
			}
			if (!(container instanceof HTMLElement)) return;
			const entry = buildEntry(container, "want_to_read");
			if (!entry?.title) return;
			seriesAdd.disabled = true;
			const result = await saveShelfEntryWithRetry(entry);
			if (result.ok) {
				seriesAdd.replaceWith(Object.assign(document.createElement("p"), {
					className: "series-continue-state",
					textContent: "Added to Want to Read"
				}));
				showSeriesFeedback(container, "Saved to Want to Read.");
			} else if (result.message) {
				seriesAdd.disabled = false;
				showSeriesFeedback(container, result.message);
			}
			return;
		}

		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle) {
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown instanceof HTMLElement) toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}

		const option = target.closest('[data-action="set-shelf"]');
		const removeOption = target.closest('[data-action="remove-from-shelves"]');
		const dropdown = target.closest(".shelf-dropdown");
		if (removeOption && dropdown instanceof HTMLElement) {
			closeShelfMenus(shelfDropdowns);
			if (!isAuthenticated) {
				promptForShelfLogin();
				return;
			}
			const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
			const entry = buildEntry(dropdown, "want_to_read");
			const result = await removeBookFromAllShelvesOnServer(bookId, entry);
			if (result.ok) {
				setShelvedState(dropdown, false);
				setDropdownLabel(dropdown, "");
				showShelfFeedback(dropdown, "Removed from shelves.", feedbackTimers);
			} else {
				showShelfFeedback(dropdown, resolveShelfRemoveMessage(result), feedbackTimers);
			}
			return;
		}
		if (option && dropdown instanceof HTMLElement) {
			const status = String(option.getAttribute("data-status") || "want_to_read");
			closeShelfMenus(shelfDropdowns);
			if (!isAuthenticated) {
				promptForShelfLogin();
				return;
			}
			const entry = buildEntry(dropdown, status);
			if (!entry?.title) return;
			const result = await saveShelfEntryWithRetry(entry);
			if (result.ok) {
				setSelected(dropdown, status);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
			} else if (result.message) {
				showShelfFeedback(dropdown, result.message, feedbackTimers);
			}
			return;
		}

		if (!target.closest(".shelf-dropdown")) closeShelfMenus(shelfDropdowns);
	});
</script>
