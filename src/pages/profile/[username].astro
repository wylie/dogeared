	function promptForCustomShelfIcon(currentIcon) {
		return new Promise((resolve) => {
			const existing = document.getElementById("icon-picker-overlay");
			if (existing) existing.remove();

			const overlay = document.createElement("div");
			overlay.id = "icon-picker-overlay";
			overlay.className = "icon-picker-overlay";

			const modal = document.createElement("div");
			modal.className = "icon-picker-modal";
			modal.setAttribute("role", "dialog");
			modal.setAttribute("aria-modal", "true");
			modal.setAttribute("aria-label", "Choose shelf icon");

			const title = document.createElement("p");
			title.className = "icon-picker-title";
			title.textContent = "Choose shelf icon";

			const grid = document.createElement("div");
			grid.className = "icon-picker-grid";

			const actions = document.createElement("div");
			actions.className = "icon-picker-actions";

			const cancelButton = document.createElement("button");
			cancelButton.type = "button";
			cancelButton.className = "icon-picker-cancel";
			cancelButton.textContent = "Cancel";

			const saveButton = document.createElement("button");
			saveButton.type = "button";
			saveButton.className = "icon-picker-save";
			saveButton.textContent = "Save";

			let selectedIcon = CUSTOM_SHELF_ICON_OPTIONS.includes(String(currentIcon || ""))
				? String(currentIcon || "")
				: CUSTOM_SHELF_ICON_OPTIONS[0];

			const renderSelection = () => {
				for (const optionButton of Array.from(grid.querySelectorAll(".icon-picker-option"))) {
					const iconValue = String(optionButton.getAttribute("data-icon") || "");
					optionButton.classList.toggle("is-selected", iconValue === selectedIcon);
				}
			};

			const close = (value) => {
				overlay.remove();
				resolve(value);
			};

			for (const iconName of CUSTOM_SHELF_ICON_OPTIONS) {
				const optionButton = document.createElement("button");
				optionButton.type = "button";
				optionButton.className = "icon-picker-option";
				optionButton.setAttribute("data-icon", iconName);
				optionButton.setAttribute("aria-label", `Select ${iconName}`);
				optionButton.innerHTML = `<span class="material-icons" aria-hidden="true">${iconName}</span>`;
				optionButton.addEventListener("click", () => {
					selectedIcon = iconName;
					renderSelection();
				});
				grid.append(optionButton);
			}

			cancelButton.addEventListener("click", () => close(""));
			saveButton.addEventListener("click", () => close(selectedIcon));
			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) close("");
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && document.body.contains(overlay)) close("");
			}, { once: true });

			actions.append(cancelButton, saveButton);
			modal.append(title, grid, actions);
			overlay.append(modal);
			document.body.append(overlay);
			renderSelection();
		});
	}

