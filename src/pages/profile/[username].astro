	function positionMomentumTooltip() {
		if (!(momentumHelp instanceof HTMLElement)) return;
		if (!(momentumHelpTooltip instanceof HTMLElement)) return;
		momentumHelpTooltip.style.left = "0px";
		const gutter = 8;
		const helpRect = momentumHelp.getBoundingClientRect();
		const tooltipRect = momentumHelpTooltip.getBoundingClientRect();
		let offset = 0;
		const overflowRight = tooltipRect.right - (window.innerWidth - gutter);
		if (overflowRight > 0) offset -= overflowRight;
		const overflowLeft = (helpRect.left + offset) - gutter;
		if (overflowLeft < 0) offset += Math.abs(overflowLeft);
		momentumHelpTooltip.style.left = `${Math.round(offset)}px`;
	}

	function promptForFinishRating(options = {}) {
		const initialRating = Math.max(0, Math.min(5, Number(options?.initialRating || 0) || 0));
		const initialReflection = String(options?.initialReflection || "").trim().slice(0, 280);
		const initialError = String(options?.errorMessage || "").trim();
		const onSubmit = typeof options?.onSubmit === "function" ? options.onSubmit : null;
		return new Promise((resolve) => {
			const existing = document.getElementById("finish-rating-overlay");
			if (existing) existing.remove();

			const overlay = document.createElement("div");
			overlay.id = "finish-rating-overlay";
			overlay.className = "finish-rating-overlay";
			Object.assign(overlay.style, {
				position: "fixed",
				inset: "0",
				background: "rgba(0,0,0,0.45)",
				display: "grid",
				placeItems: "center",
				zIndex: "1200",
				padding: "1rem"
			});

			const modal = document.createElement("div");
			modal.className = "finish-rating-modal";
			modal.setAttribute("role", "dialog");
			modal.setAttribute("aria-modal", "true");
			modal.setAttribute("aria-label", "Rate this finished book");
			Object.assign(modal.style, {
				width: "min(460px, 100%)",
				background: "#fff",
				borderRadius: "14px",
				padding: "1rem",
				boxShadow: "0 10px 26px rgba(0,0,0,0.2)"
			});

			const title = document.createElement("p");
			title.className = "finish-rating-title";
			title.textContent = "Finish this book";

			const subtitle = document.createElement("p");
			subtitle.className = "finish-rating-subtitle";
			subtitle.textContent = "Add a rating and an optional reflection.";
			const errorNode = document.createElement("p");
			errorNode.className = "finish-rating-error";
			errorNode.hidden = !initialError;
			errorNode.textContent = initialError;

			const stars = document.createElement("div");
			stars.className = "finish-rating-stars";
			stars.setAttribute("aria-label", "Rating stars");
			const reflectionLabel = document.createElement("label");
			reflectionLabel.className = "finish-reflection-label";
			reflectionLabel.textContent = "Reflection (optional)";

			const reflectionInput = document.createElement("textarea");
			reflectionInput.className = "finish-reflection-input";
			reflectionInput.maxLength = 280;
			reflectionInput.rows = 3;
			reflectionInput.placeholder = "What stood out?";
			reflectionInput.value = initialReflection;

			const reflectionCount = document.createElement("p");
			reflectionCount.className = "finish-reflection-count";
			reflectionCount.textContent = "0/280";
			reflectionInput.addEventListener("input", () => {
				reflectionCount.textContent = `${reflectionInput.value.length}/280`;
			});
			const reflectionWrap = document.createElement("div");
			reflectionWrap.className = "finish-reflection-wrap";
			reflectionWrap.append(reflectionLabel, reflectionInput, reflectionCount);

			const actions = document.createElement("div");
			actions.className = "finish-rating-actions";
			Object.assign(actions.style, {
				display: "flex",
				justifyContent: "flex-end",
				gap: "0.45rem",
				marginTop: "0.8rem"
			});

			const cancelButton = document.createElement("button");
			cancelButton.type = "button";
			cancelButton.className = "finish-rating-cancel";
			cancelButton.textContent = "Cancel";

			const skipButton = document.createElement("button");
			skipButton.type = "button";
			skipButton.className = "finish-rating-skip";
			skipButton.textContent = "Skip";

			const saveButton = document.createElement("button");
			saveButton.type = "button";
			saveButton.className = "finish-rating-save";
			saveButton.textContent = "Save";
			saveButton.disabled = true;

			let selectedRating = initialRating;

			const renderStars = (hoverValue = 0) => {
				const active = hoverValue || selectedRating;
				const buttons = stars.querySelectorAll("button");
				buttons.forEach((button, index) => {
					const value = index + 1;
					button.textContent = value <= active ? "★" : "☆";
					button.setAttribute("aria-pressed", value === selectedRating ? "true" : "false");
				});
				saveButton.disabled = selectedRating < 1 || selectedRating > 5;
			};

			const close = (result) => {
				overlay.remove();
				resolve(result);
			};
			const setBusy = (busy) => {
				cancelButton.disabled = busy;
				skipButton.disabled = busy;
				saveButton.disabled = busy || selectedRating < 1 || selectedRating > 5;
				reflectionInput.disabled = busy;
				for (const button of Array.from(stars.querySelectorAll("button"))) {
					button.disabled = busy;
				}
				saveButton.textContent = busy ? "Saving..." : "Save";
				skipButton.textContent = busy ? "Saving..." : "Skip";
			};

			for (let i = 1; i <= 5; i += 1) {
				const star = document.createElement("button");
				star.type = "button";
				star.className = "finish-rating-star";
				star.dataset.value = String(i);
				star.setAttribute("aria-label", `${i} star${i === 1 ? "" : "s"}`);
				star.textContent = "☆";
				Object.assign(star.style, {
					border: "none",
					background: "transparent",
					fontSize: "2rem",
					lineHeight: "1",
					padding: "0.1rem",
					color: "#f59e0b",
					cursor: "pointer"
				});
				star.addEventListener("mouseenter", () => renderStars(i));
				star.addEventListener("mouseleave", () => renderStars());
				star.addEventListener("click", () => {
					selectedRating = i;
					renderStars();
				});
				stars.append(star);
			}

			const currentReflection = () => String(reflectionInput.value || "").trim().slice(0, 280);
			const submitResult = async (payload) => {
				if (!onSubmit) {
					close(payload);
					return;
				}
				errorNode.hidden = true;
				errorNode.textContent = "";
				setBusy(true);
				try {
					const result = await onSubmit(payload);
					if (result?.ok) {
						close(payload);
						return;
					}
					errorNode.textContent = String(result?.message || "Failed to save. Please try again.");
					errorNode.hidden = false;
				} catch (error) {
					errorNode.textContent = error instanceof Error ? error.message : "Failed to save. Please try again.";
					errorNode.hidden = false;
				} finally {
					setBusy(false);
				}
			};
			cancelButton.addEventListener("click", () => close({ cancelled: true, rating: null, reflection: "" }));
			skipButton.addEventListener("click", async () => {
				await submitResult({ cancelled: false, rating: null, reflection: currentReflection() });
			});
			saveButton.addEventListener("click", async () => {
				await submitResult({ cancelled: false, rating: selectedRating, reflection: currentReflection() });
			});
			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) close({ cancelled: true, rating: null });
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && document.body.contains(overlay)) close({ cancelled: true, rating: null });
			}, { once: true });

			actions.append(cancelButton, skipButton, saveButton);
			modal.append(title, subtitle, errorNode, stars, reflectionWrap, actions);
			overlay.append(modal);
			document.body.append(overlay);
			renderStars();
		});
	}

	async function promptAndSaveFinishedEntry(entry) {
		const result = await promptForFinishRating({
			onSubmit: async (finishRating) => {
				entry.rating = finishRating.rating;
				entry.finishedReflection = String(finishRating.reflection || "").trim().slice(0, 280);
				const saveResult = await saveShelfEntryWithRetry(entry);
				return {
					ok: !!saveResult?.ok,
					message: String(saveResult?.message || "Failed to save.")
				};
			}
		});
		if (result?.cancelled) return { ok: false, cancelled: true };
		return { ok: true, cancelled: false };
	}

