		momentumHelpTooltip.style.left = "0px";
		const gutter = 8;
		const helpRect = momentumHelp.getBoundingClientRect();
		const tooltipRect = momentumHelpTooltip.getBoundingClientRect();
		let offset = 0;
		const overflowRight = tooltipRect.right - (window.innerWidth - gutter);
		if (overflowRight > 0) offset -= overflowRight;
		const overflowLeft = (helpRect.left + offset) - gutter;
		if (overflowLeft < 0) offset += Math.abs(overflowLeft);
		momentumHelpTooltip.style.left = `${Math.round(offset)}px`;
	}

