})));

const pagedRecent = paginate(recentActivity, recentPage, PAGE_SIZE);
const pagedReading = paginate(currentlyReading, readingPage, PAGE_SIZE);
const pagedWantToRead = paginate(wantToReadBooks, wantToReadPage, PAGE_SIZE);
const pagedFinished = paginate(finishedBooks, finishedPage, PAGE_SIZE);
const shelfSectionOrderJson = JSON.stringify(
	shelfSectionOrderKeys.length > 0
		? shelfSectionOrderKeys
		: defaultProfileSectionOrder(customShelves.map((shelf) => `custom:${shelf.id}`))
);
const profileCanonicalUrl = profile.username ? `/profile/${encodeURIComponent(profile.username)}` : `/profile/${encodeURIComponent(requestedUsername)}`;
const hasIndexableProfileContent = shelfStats.total > 0 || recentActivity.length > 0 || currentlyReading.length > 0 || wantToReadBooks.length > 0 || finishedBooks.length > 0;
const profileRobots = (!notFound && !privateProfile && !!profile.username && hasIndexableProfileContent) ? "index,follow" : "noindex,follow";
const profileDescription = !notFound && !privateProfile
	? `${profile.name || `@${profile.username}`}'s reading profile on Dogeared. ${shelfStats.total.toLocaleString()} books across shelves.`
	: "Reader profile on Dogeared.";
const profileStructuredData = (!notFound && !privateProfile && !!profile.username)
	? JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Person",
		name: profile.name || `@${profile.username}`,
		alternateName: `@${profile.username}`,
		description: profile.blurb || undefined,
		url: toAbsoluteUrl(profileCanonicalUrl, Astro.site ?? Astro.url),
		image: profile.avatar || undefined
	})
	: "";
const profileBreadcrumbStructuredData = JSON.stringify(buildBreadcrumbList([
	{ name: "Home", item: "/" },
	...(profile.username
		? [
			{ name: "Profile", item: "/profile" },
			{ name: `@${profile.username}`, item: profileCanonicalUrl }
		]
		: [{ name: "Profile", item: profileCanonicalUrl }])
], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV }));
const profileStructuredDataPayload = profileStructuredData
	? JSON.stringify([JSON.parse(profileStructuredData), JSON.parse(profileBreadcrumbStructuredData)])
	: "";
momentumBooks = currentlyReading.map((item) => {
	const totalPages = Math.max(0, Number(item.totalPages || 0) || 0);
	const currentPage = Math.max(0, Number(item.currentPage || 0) || 0);
	const percent = totalPages > 0 ? Math.max(0, Math.min(100, Math.round((currentPage / totalPages) * 100))) : 0;
	const daysSinceUpdate = daysSinceDate(item.updatedAt);
	const daysSinceStart = daysSinceDate(String(item.firstAddedAt || item.updatedAt));
	const prediction = resolveMomentumPrediction({
		currentPage,
		totalPages,
		daysSinceUpdate,
		daysSinceStart,
		progressUpdateCount: Math.max(0, Number(item.progressUpdates || 0) || 0)
	});
	return {
		bookId: item.bookId,
		title: item.title,
		currentPage,
		totalPages,
		percent,
		daysSinceUpdate,
		daysSinceStart,
		progressUpdateCount: Math.max(0, Number(item.progressUpdates || 0) || 0),
		finishProbability: prediction.finishProbability,
		confidence: prediction.confidence,
		healthLabel: prediction.label,
		healthTone: prediction.tone,
		predictionEligible: prediction.eligible,
		showOnboardingStatus: false,
		onboardingMessage: prediction.eligible ? "" : prediction.label,
		momentumMessage: prediction.message
	};
});
const firstOnboardingBook = momentumBooks
	.filter((item) => !item.predictionEligible)
	.sort((a, b) => a.daysSinceUpdate - b.daysSinceUpdate)[0];
if (firstOnboardingBook) {
	const target = momentumBooks.find((item) => item.bookId === firstOnboardingBook.bookId);
	if (target) target.showOnboardingStatus = true;
}
momentumStreakDays = readingStreakDateKeys.length > 0
	? computeReadingStreakFromDateKeys(readingStreakDateKeys)
	: computeReadingStreakDays(currentlyReading);
const eligibleMomentumBooks = momentumBooks.filter((item) => item.predictionEligible);
momentumScore = eligibleMomentumBooks.length > 0
	? Math.round(eligibleMomentumBooks.reduce((sum, item) => sum + item.finishProbability, 0) / eligibleMomentumBooks.length)
	: 0;
const mostAtRiskBook = eligibleMomentumBooks
	.filter((item) => item.healthLabel === "Reading momentum slowing")
	.sort((a, b) => b.daysSinceUpdate - a.daysSinceUpdate)[0];
const bestOnTrackBook = eligibleMomentumBooks
	.slice()
	.sort((a, b) => b.finishProbability - a.finishProbability)[0];
if (mostAtRiskBook) {
	const catchupPages = Math.max(
		6,
		Math.min(24, Math.round((mostAtRiskBook.totalPages || 180) * 0.06))
	);
	momentumNextAction = `A short session of about ${catchupPages} pages in ${mostAtRiskBook.title} will rebuild momentum.`;
} else if (bestOnTrackBook) {
	const nextMilestone = Math.min(100, Math.ceil(bestOnTrackBook.percent / 10) * 10);
	momentumNextAction = nextMilestone > bestOnTrackBook.percent
		? `Push ${bestOnTrackBook.title} to ${nextMilestone}% today.`
		: `Keep pace in ${bestOnTrackBook.title} today.`;
} else {
	momentumNextAction = "Add a few progress updates and Dogeared will start estimating reading momentum.";
}
const momentumByBookId = new Map(momentumBooks.map((item) => [item.bookId, item]));
