import type { PerformanceSpanInput } from "../../lib/performanceTelemetry";

export const prerender = false;

const pagePerfStartedAt = performance.now();
const pagePerfSpans: PerformanceSpanInput[] = [];
const readingFormatSelectOptions = readingFormatOptions(true);
const recordPagePerfSpan = (name: string, durationMs: number, startedAt?: number, parentName?: string) => {
	const normalizedDuration = Math.max(0, Math.round(durationMs * 10) / 10);
	pagePerfSpans.push({
		name,
		durationMs: normalizedDuration,
		...(Number.isFinite(startedAt) ? { startMs: Math.max(0, Math.round((Number(startedAt) - pagePerfStartedAt) * 10) / 10) } : {}),
		...(parentName ? { parentName } : {})
	});
};
const timePagePerf = async <T,>(name: string, work: () => Promise<T>) => {
	const startedAt = performance.now();
	try {
		return await work();
	} finally {
		recordPagePerfSpan(name, performance.now() - startedAt, startedAt);
	}
};
const requestedUsername = String(Astro.params.username || "").trim().toLowerCase();
const session = await timePagePerf("authentication/session", () => resolveUserBySession(Astro.request));
const viewerUserId = String(session?.userId || "");
const isAuthenticated = !!viewerUserId;
const editMode = String(Astro.url.searchParams.get("edit") || "").trim() === "1";
const showWelcomeBanner = String(Astro.url.searchParams.get("welcome") || "").trim() === "1";
const dismissWelcomeUrl = (() => {
	const next = new URL(Astro.url);
	next.searchParams.delete("welcome");
	return `${next.pathname}${next.search ? next.search : ""}${next.hash || ""}`;
})();

function normalizeText(value: unknown, maxLength: number) {
	return String(value || "").replace(/\s+/g, " ").trim().slice(0, maxLength);
}

function normalizeUsernameForSave(value: unknown) {
	const raw = normalizeText(value, 40).replace(/^@+/, "").toLowerCase();
	if (!raw) return "";
	return raw.replace(/[^a-z0-9._-]/g, "").slice(0, 40);
}

function normalizeGenres(value: unknown) {
	const parts = String(value || "").split(",");
	const dedupe = new Set<string>();
	const out: string[] = [];
	for (const part of parts) {
		const next = normalizeText(part, 40);
		if (!next) continue;
		const key = next.toLowerCase();
		if (dedupe.has(key)) continue;
		dedupe.add(key);
		out.push(next);
		if (out.length >= 12) break;
	}
	return out;
}

function normalizeBirthYear(value: unknown) {
	const year = Number(String(value ?? "").trim());
	if (!Number.isFinite(year)) return "";
	const rounded = Math.trunc(year);
	if (rounded < 1900 || rounded > 2100) return "";
	return String(rounded);
}

function normalizeBookIdentityPart(value: unknown) {
	return String(value || "")
		.toLowerCase()
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/[^a-z0-9]+/g, " ")
		.trim();
}

function bookIdentityKey(input: { title: unknown; author: unknown }) {
	const title = normalizeBookIdentityPart(input.title);
	const author = normalizeBookIdentityPart(input.author);
	return `${title}::${author}`;
}

function toTimestamp(value: unknown) {
	const time = new Date(String(value || "")).getTime();
	return Number.isFinite(time) ? time : 0;
}

function dedupeByWorkIdentity<T extends {
	title: string;
	author: string;
	updatedAt?: string;
	currentPage?: number;
	totalPages?: number;
}>(
	items: T[]
) {
	const byKey = new Map<string, T>();
	for (const item of items) {
		const key = bookIdentityKey({ title: item.title, author: item.author });
		if (!key || key === "::") continue;
		const existing = byKey.get(key);
		if (!existing) {
			byKey.set(key, item);
			continue;
		}
		const existingTime = toTimestamp(existing.updatedAt);
		const itemTime = toTimestamp(item.updatedAt);
		if (itemTime > existingTime) {
			byKey.set(key, item);
			continue;
		}
		if (itemTime === existingTime) {
			const existingProgress = Math.max(0, Number(existing.currentPage || 0));
			const itemProgress = Math.max(0, Number(item.currentPage || 0));
			if (itemProgress > existingProgress) byKey.set(key, item);
		}
	}
	return Array.from(byKey.values());
}

if (Astro.request.method === "POST" && viewerUserId && requestedUsername) {
	const formData = await Astro.request.formData();
	const profileIntent = String(formData.get("profileIntent") || "").trim().toLowerCase();
	if (profileIntent === "save") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId === viewerUserId) {
			const sql = getNeonSql();
			const existingRows = await sql<Array<{ username: string | null; profile_data: unknown }>>`
				select username, profile_data
				from app_user
				where id = ${viewerUserId}::uuid
				limit 1
			`;
			const currentUsername = normalizeUsernameForSave(existingRows[0]?.username);
			const existingProfileData = (existingRows[0]?.profile_data && typeof existingRows[0].profile_data === "object")
				? existingRows[0].profile_data as Record<string, unknown>
				: {};
			const existingSettings = (existingProfileData.settings && typeof existingProfileData.settings === "object")
				? existingProfileData.settings as Record<string, unknown>
				: {};
			const currentAvatar = normalizeText(existingProfileData.avatar, 500000);
			const submittedAvatar = normalizeText(formData.get("avatarUrl"), 500000);
			const nextAvatar = submittedAvatar || currentAvatar;
			let nextUsername = normalizeUsernameForSave(formData.get("username"));
			if (!nextUsername) nextUsername = currentUsername;
			if (nextUsername && nextUsername !== currentUsername) {
				const takenRows = await sql<Array<{ id: string }>>`
					select id
					from app_user
					where lower(username) = lower(${nextUsername})
						and id <> ${viewerUserId}::uuid
					limit 1
				`;
				if (takenRows.length > 0) {
					nextUsername = currentUsername;
				}
			}
			const nextProfile = {
				avatar: nextAvatar,
				name: normalizeText(formData.get("name"), 80),
				username: nextUsername ? `@${nextUsername}` : "",
				location: normalizeText(formData.get("location"), 80),
				birthYear: normalizeBirthYear(formData.get("birthYear")),
				readingGoal: normalizeText(formData.get("readingGoal"), 80),
				favoriteBook: normalizeText(formData.get("favoriteBook"), 120),
				favoriteAuthor: normalizeText(formData.get("favoriteAuthor"), 120),
				blurb: normalizeText(formData.get("blurb"), 400),
				genres: normalizeGenres(formData.get("genres")),
				settings: existingSettings
			};
			await sql`
				update app_user
				set
					username = ${nextUsername || null},
					profile_data = ${JSON.stringify(nextProfile)}::jsonb
				where id = ${viewerUserId}::uuid
			`;
			return Astro.redirect(`/profile/${encodeURIComponent(nextUsername || requestedUsername)}`);
		}
		return Astro.redirect(`/profile/${encodeURIComponent(requestedUsername)}`);
	}
	const followIntent = String(formData.get("followIntent") || "").trim().toLowerCase();
	if (followIntent === "follow" || followIntent === "unfollow") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId !== viewerUserId) {
			const sql = getNeonSql();
			if (followIntent === "follow") {
				const inserted = await sql<Array<{ inserted: boolean }>>`
					with inserted as (
						insert into user_follow (follower_user_id, followed_user_id)
						values (${viewerUserId}::uuid, ${target.targetUserId}::uuid)
						on conflict (follower_user_id, followed_user_id) do nothing
						returning 1
					)
					select exists(select 1 from inserted) as inserted
				`;
				if (inserted[0]?.inserted) {
					await createNotification(sql, {
						userId: target.targetUserId,
						actorUserId: viewerUserId,
						type: "user_follow",
						groupKey: `user_follow:${target.targetUserId}`,
						actionUrl: `/profile/${encodeURIComponent(requestedUsername)}/followers`
					});
				}
			} else {
				await sql`
					delete from user_follow
					where follower_user_id = ${viewerUserId}::uuid
						and followed_user_id = ${target.targetUserId}::uuid
				`;
			}
		}
		return Astro.redirect(`/profile/${encodeURIComponent(requestedUsername)}`);
	}
}

let notFound = false;
let privateProfile = false;
let profile = {
	avatar: "",
	name: "",
	location: "",
	birthYear: "",
	readingGoal: "",
	favoriteBook: "",
	favoriteAuthor: "",
	blurb: "",
	genres: [] as string[],
	username: ""
};
let canViewActivity = false;
let shelfStats = { wantToRead: 0, reading: 0, finished: 0, total: 0 };
let recentActivity: Array<{
	activityId: number;
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	status: string;
	eventType: string;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	rating: number;
	likeCount: number;
	viewerLiked: boolean;
	updatedAt: string;
	genres: string[];
}> = [];
let currentlyReading: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	googleBooksId: string;
	description: string;
	currentPage: number;
	totalPages: number;
	preferredProgressType: ProgressInputMode;
	readingFormat: ReadingFormat;
	updatedAt: string;
	firstAddedAt: string;
	progressUpdates: number;
	genres: string[];
}> = [];
let wantToReadBooks: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	updatedAt: string;
	genres: string[];
}> = [];
let finishedBooks: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	rating: number;
	reviewTitle: string;
	reviewBody: string;
	reviewSpoiler: boolean;
	reviewUpdatedAt: string;
	finishedDate: string;
	updatedAt: string;
	readingFormat: ReadingFormat;
	genres: string[];
}> = [];
let profileReviews: typeof finishedBooks = [];
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let followState = {
	followersCount: 0,
	followingCount: 0,
	isViewerFollowing: false,
	canFollow: false
};
let isOwnerViewer = false;
let customShelves: Array<{ id: number; name: string; slug: string; icon: string; position: number; bookCount: number }> = [];
let shelfSectionOrderKeys: string[] = [];
let shelfSectionOrderByKey = new Map<string, number>();
const RECENT_ACTIVITY_SECTION_KEY = "recent:activity";
const REVIEWS_SECTION_KEY = "reviews:section";
const PROFILE_ACHIEVEMENT_PREVIEW_COUNT = 4;
let customShelfBooksByShelfId = new Map<number, Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	status: string;
	rating: number;
	updatedAt: string;
	genres: string[];
}>>();
let momentumBooks: ReadingSummaryMomentumBook[] = [];
let momentumScore = 0;
let momentumStreakDays = 0;
let momentumNextAction = "";
let readingStreakDateKeys: string[] = [];
let favoriteBookHref = "";
let favoriteAuthorHref = "";
let ownerProfileData: Record<string, unknown> = {};
let targetProfileData: Record<string, unknown> = {};
let achievements: EarnedAchievement[] = [];
let showAchievementsPublic = true;
const PAGE_SIZE = 12;
const recentPage = Math.max(1, Number(Astro.url.searchParams.get("ra_page") || "1") || 1);
const readingPage = Math.max(1, Number(Astro.url.searchParams.get("cr_page") || "1") || 1);
const wantToReadPage = Math.max(1, Number(Astro.url.searchParams.get("wr_page") || "1") || 1);
const finishedPage = Math.max(1, Number(Astro.url.searchParams.get("rd_page") || "1") || 1);
const WANT_TO_READ_RENDER_WINDOW = PAGE_SIZE * 3;
const RECENT_ACTIVITY_RENDER_LIMIT = Math.min(25, Math.max(PAGE_SIZE, recentPage * PAGE_SIZE));
const CURRENTLY_READING_RENDER_LIMIT = Math.min(120, Math.max(PAGE_SIZE * 3, readingPage * PAGE_SIZE));
const wantToReadOffset = (wantToReadPage - 1) * PAGE_SIZE;
const reviewSort = String(Astro.url.searchParams.get("review_sort") || "newest").trim();
const reviewFilter = String(Astro.url.searchParams.get("review_filter") || "all").trim();

const bundle = await resolvePublicProfileBundle({
	username: requestedUsername,
	viewerUserId,
	onTiming: recordPagePerfSpan
});
if (bundle.status === "not_found") notFound = true;
if (bundle.status === "private") privateProfile = true;
if (bundle.status === "ok" && bundle.profile && bundle.targetUserId) {
	const sql = getNeonSql();
	profile = bundle.profile;
	canViewActivity = bundle.canViewActivity;
	isOwnerViewer = !!viewerUserId && viewerUserId === bundle.targetUserId;
	const favoriteBookStartedAt = performance.now();
	if (profile.favoriteBook) {
		const favoriteRaw = String(profile.favoriteBook || "").trim();
		let favoriteTitle = favoriteRaw;
		let favoriteAuthor = "";
		const byMatch = favoriteRaw.match(/^(.*?)\s+by\s+(.+)$/i);
		if (byMatch) {
			favoriteTitle = String(byMatch[1] || "").trim();
			favoriteAuthor = String(byMatch[2] || "").trim();
		}
		favoriteBookHref = favoriteTitle
			? `/book?title=${encodeURIComponent(favoriteTitle)}${favoriteAuthor ? `&author=${encodeURIComponent(favoriteAuthor)}` : ""}`
			: "";
	}
	recordPagePerfSpan("favorite book link", performance.now() - favoriteBookStartedAt, favoriteBookStartedAt);
	const favoriteAuthorStartedAt = performance.now();
	favoriteAuthorHref = profile.favoriteAuthor ? authorHref(profile.favoriteAuthor) : "";
	recordPagePerfSpan("favorite author link", performance.now() - favoriteAuthorStartedAt, favoriteAuthorStartedAt);
	targetProfileData = bundle.profileData;
	if (isOwnerViewer) ownerProfileData = targetProfileData;
	showAchievementsPublic = resolveAchievementVisibilitySetting(targetProfileData);
	followState = {
		followersCount: bundle.followersCount,
		followingCount: bundle.followingCount,
		isViewerFollowing: bundle.isViewerFollowing,
		canFollow: !!viewerUserId && viewerUserId !== bundle.targetUserId && bundle.allowFollowRequests
	};
	const emptyReadingSummary = buildReaderReadingSummary({ currentlyReading: [], progressDateKeys: [] });
	const customShelfSchemaReady = isOwnerViewer
		? ensureCustomShelfSchema(sql).catch(() => null)
		: Promise.resolve(null);
	const [
		summary,
		updates,
		readerReadingSummary,
		achievementRows,
		wantToReadRows,
		finishedRows,
		customShelfRows,
		customShelfBookRows
	] = await Promise.all([
		timePagePerf("shelf summary", () => resolvePublicShelfSummary(bundle.targetUserId)),
		bundle.canViewActivity
			? timePagePerf("recent activity", () => resolvePublicRecentActivity(bundle.targetUserId, RECENT_ACTIVITY_RENDER_LIMIT, viewerUserId))
			: Promise.resolve([]),
		bundle.canViewActivity
			? loadReaderReadingSummary(sql, bundle.targetUserId, {
				ensureSchema: false,
				currentBookLimit: CURRENTLY_READING_RENDER_LIMIT,
				onTiming: recordPagePerfSpan
			})
			: Promise.resolve(emptyReadingSummary),
		(isOwnerViewer || showAchievementsPublic)
			? timePagePerf("achievements", () => loadEarnedAchievements(sql, bundle.targetUserId, {
				includeHidden: isOwnerViewer,
				limit: 48
			}))
			: Promise.resolve([]),
		bundle.canViewActivity
				? timePagePerf("want to read", () => sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				updated_at: string;
				genres: string[];
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					ub.updated_at::text as updated_at,
					(
						select coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}')
						from book_genre bg where bg.book_id = b.id
					) as genres
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'want_to_read'
				order by ub.updated_at desc
				limit ${WANT_TO_READ_RENDER_WINDOW}
				offset ${wantToReadOffset}
			`)
			: Promise.resolve([]),
		bundle.canViewActivity
			? timePagePerf("Read", () => loadFinishedBooksForReader(sql, bundle.targetUserId))
			: Promise.resolve([]),
		isOwnerViewer
			? timePagePerf("custom shelves", async () => {
				try {
					await customShelfSchemaReady;
					return sql<Array<{ id: number; name: string; slug: string; icon: string; position: number; book_count: number }>>`
						select
							s.id,
							s.name,
							s.slug,
							s.icon,
							s.position,
							coalesce(count(sb.book_id), 0)::int as book_count
						from user_custom_shelf s
						left join user_custom_shelf_book sb
							on sb.shelf_id = s.id
							and sb.user_id = s.user_id
						where s.user_id = ${bundle.targetUserId}::uuid
						group by s.id, s.name, s.slug, s.position
						order by s.position asc, s.id asc
					`;
				} catch {
					return [];
				}
			})
			: Promise.resolve([]),
		isOwnerViewer
			? timePagePerf("custom shelf books", async () => {
				try {
					await customShelfSchemaReady;
					return sql<Array<{
						shelf_id: number;
						book_id: number;
						title: string;
						primary_author: string;
						author_id: number | null;
						cover_url: string;
						language: string;
						isbn10: string;
						isbn13: string;
						status: string | null;
						rating: number | null;
						updated_at: string | null;
						genres: string[];
					}>>`
						select
							sb.shelf_id,
							b.id as book_id,
							b.title,
							b.primary_author,
							b.author_id,
							b.cover_url,
							b.language,
							b.isbn10,
							b.isbn13,
							ub.status,
							ub.rating,
							coalesce(ub.updated_at::text, sb.created_at::text) as updated_at,
							(
								select coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}')
								from book_genre bg where bg.book_id = b.id
							) as genres
						from user_custom_shelf_book sb
						join book b on b.id = sb.book_id
						left join user_book ub
							on ub.user_id = sb.user_id
							and ub.book_id = sb.book_id
						where sb.user_id = ${bundle.targetUserId}::uuid
						order by sb.shelf_id asc, coalesce(ub.updated_at, sb.created_at) desc
					`;
				} catch {
					return [];
				}
			})
			: Promise.resolve([])
	]);
	shelfStats = summary;
	recentActivity = updates;
	currentlyReading = readerReadingSummary.currentlyReading;
	achievements = achievementRows;
	currentlyReading = dedupeByWorkIdentity(currentlyReading);
	wantToReadBooks = wantToReadRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		description: "",
		updatedAt: String(row.updated_at || "").trim(),
		genres: Array.isArray(row.genres) ? row.genres.map((genre) => String(genre || "").trim()).filter(Boolean) : []
	}));
	wantToReadBooks = dedupeByWorkIdentity(wantToReadBooks);
	// Keep default shelves mutually exclusive in the profile UI when catalog duplicates
	// exist for the same work under different book IDs.
	const currentlyReadingKeys = new Set(
		currentlyReading.map((item) => bookIdentityKey({ title: item.title, author: item.author }))
	);
	wantToReadBooks = wantToReadBooks.filter((item) => (
		!currentlyReadingKeys.has(bookIdentityKey({ title: item.title, author: item.author }))
	));
	finishedBooks = finishedRows.map((row) => ({
		bookId: Number(row.bookId || 0),
		title: String(row.title || "").trim(),
		author: String(row.author || "").trim(),
		authorId: Math.max(0, Number(row.authorId || 0) || 0),
		thumbnail: String(row.thumbnail || row.coverUrl || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		description: "",
		rating: Math.max(0, Math.min(5, Number(row.rating || 0) || 0)),
		reviewTitle: String(row.reviewTitle || "").trim(),
		reviewBody: String(row.reviewBody || "").trim(),
		reviewSpoiler: row.reviewSpoiler === true,
		reviewUpdatedAt: String(row.reviewUpdatedAt || "").trim(),
		finishedDate: String(row.finishedDate || "").trim(),
		updatedAt: String(row.updatedAt || "").trim(),
		readingFormat: row.readingFormat || "unknown",
		genres: Array.isArray(row.genreNames) ? row.genreNames.map((genre) => String(genre || "").trim()).filter(Boolean) : []
	}));
	const reviewsStartedAt = performance.now();
	profileReviews = finishedBooks
		.filter((book) => book.reviewTitle || book.reviewBody)
		.filter((book) => {
			if (reviewFilter === "spoilers") return book.reviewSpoiler;
			if (reviewFilter === "no_spoilers") return !book.reviewSpoiler;
			return true;
		})
		.sort((a, b) => {
			if (reviewSort === "highest") return b.rating - a.rating || Date.parse(b.reviewUpdatedAt || b.updatedAt || "") - Date.parse(a.reviewUpdatedAt || a.updatedAt || "");
			if (reviewSort === "oldest") return Date.parse(a.reviewUpdatedAt || a.updatedAt || "") - Date.parse(b.reviewUpdatedAt || b.updatedAt || "");
			return Date.parse(b.reviewUpdatedAt || b.updatedAt || "") - Date.parse(a.reviewUpdatedAt || a.updatedAt || "");
		})
		.slice(0, 24);
	recordPagePerfSpan("reviews", performance.now() - reviewsStartedAt, reviewsStartedAt);
	readingStreakDateKeys = isOwnerViewer ? readerReadingSummary.readingStreakDateKeys : [];
	momentumBooks = readerReadingSummary.momentumBooks;
	momentumScore = readerReadingSummary.momentumScore;
	momentumStreakDays = readerReadingSummary.readingStreakDays;
	momentumNextAction = readerReadingSummary.momentumNextAction;
	customShelves = customShelfRows.map((row) => ({
		id: Math.max(0, Number(row.id || 0) || 0),
		name: String(row.name || "").trim(),
		slug: String(row.slug || "").trim(),
		icon: String(row.icon || "bookmarks").trim() || "bookmarks",
		position: Math.max(0, Number(row.position || 0) || 0),
		bookCount: Math.max(0, Number(row.book_count || 0) || 0)
	})).filter((row) => row.id > 0 && row.name);
	if (isOwnerViewer) {
		const defaultKeys = ["default:reading", RECENT_ACTIVITY_SECTION_KEY, REVIEWS_SECTION_KEY, "default:want_to_read", "default:finished"];
		const customKeys = customShelves.map((shelf) => `custom:${shelf.id}`);
		const allKeys = [...defaultKeys, ...customKeys];
		const defaultOrder = defaultProfileSectionOrder(customKeys);
		const settings = ownerProfileData.settings && typeof ownerProfileData.settings === "object"
			? ownerProfileData.settings as Record<string, unknown>
			: {};
		const storedOrder = Array.isArray(settings.shelfSectionOrder)
			? settings.shelfSectionOrder.map((item) => String(item || "").trim()).filter(Boolean)
			: [];
		shelfSectionOrderKeys = mergeProfileSectionOrder(storedOrder, allKeys, defaultOrder);
		shelfSectionOrderByKey = new Map(shelfSectionOrderKeys.map((key, index) => [key, index]));
		customShelves = [...customShelves].sort((a, b) => {
			const aOrder = shelfSectionOrderByKey.get(`custom:${a.id}`) ?? Number.MAX_SAFE_INTEGER;
			const bOrder = shelfSectionOrderByKey.get(`custom:${b.id}`) ?? Number.MAX_SAFE_INTEGER;
			return aOrder - bOrder || a.position - b.position || a.id - b.id;
		});
	} else {
		const customKeys = customShelves.map((shelf) => `custom:${shelf.id}`);
		shelfSectionOrderKeys = defaultProfileSectionOrder(customKeys);
		shelfSectionOrderByKey = new Map(shelfSectionOrderKeys.map((key, index) => [key, index]));
	}
	customShelfBooksByShelfId = customShelfBookRows.reduce((map, row) => {
		const shelfId = Math.max(0, Number(row.shelf_id || 0) || 0);
		const bookId = Math.max(0, Number(row.book_id || 0) || 0);
		if (!shelfId || !bookId) return map;
		const list = map.get(shelfId) || [];
		list.push({
			bookId,
			title: String(row.title || "").trim(),
			author: String(row.primary_author || "").trim(),
			authorId: Math.max(0, Number(row.author_id || 0) || 0),
			thumbnail: String(row.cover_url || "").trim(),
			language: String(row.language || "").trim(),
			isbn10: String(row.isbn10 || "").trim(),
			isbn13: String(row.isbn13 || "").trim(),
			description: "",
			status: String(row.status || "").trim(),
			rating: Math.max(0, Math.min(5, Number(row.rating || 0) || 0)),
			updatedAt: String(row.updated_at || "").trim(),
			genres: Array.isArray(row.genres) ? row.genres.map((genre) => String(genre || "").trim()).filter(Boolean) : []
		});
		map.set(shelfId, list);
		return map;
	}, new Map<number, Array<{
		bookId: number;
		title: string;
		author: string;
		authorId: number;
		thumbnail: string;
		language: string;
		isbn10: string;
		isbn13: string;
		description: string;
		status: string;
		rating: number;
		updatedAt: string;
		genres: string[];
	}>>());
	if (viewerUserId && (recentActivity.length > 0 || currentlyReading.length > 0 || wantToReadBooks.length > 0 || finishedBooks.length > 0 || customShelfBookRows.length > 0)) {
		const bookIds = Array.from(new Set([
			...recentActivity.map((item) => Number(item.bookId || 0)),
			...currentlyReading.map((item) => Number(item.bookId || 0)),
			...wantToReadBooks.map((item) => Number(item.bookId || 0)),
			...finishedBooks.map((item) => Number(item.bookId || 0)),
			...customShelfBookRows.map((item) => Number(item.book_id || 0))
		].filter((value) => value > 0)));
		if (bookIds.length > 0) {
			const rows = await timePagePerf("viewer shelf state", () => sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished" }>>`
					select book_id, status
					from user_book
					where user_id = ${viewerUserId}::uuid
						and book_id = any(${bookIds}::bigint[])
				`
			);
			viewerStatusByBookId = new Map(
				rows.map((row) => [Number(row.book_id || 0), row.status])
			);
		}
	}
}

function activityHeading(eventType: string) {
	const type = String(eventType || "").trim().toLowerCase();
	if (type === "reading") return { prefix: "Started Reading", shelf: "" };
	if (type === "finished") return { prefix: "Finished Reading", shelf: "" };
	if (type === "want_to_read") return { prefix: "Added to", shelf: "Want to Read" };
	if (type === "rating") return { prefix: "Rated this book", shelf: "" };
	return { prefix: "Added to", shelf: "Shelf" };
}

function renderRatingStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	return Array.from({ length: 5 }, (_, index) => (index < clamped ? "★" : "☆")).join("");
}

function statusLabel(status: string) {
	const normalized = String(status || "").trim();
	if (normalized === "reading") return "Currently Reading";
	if (normalized === "finished") return "Read";
	if (normalized === "want_to_read") return "Want to Read";
	return "Not on Shelf";
}

function formatActivityDate(value: string) {
	const parsed = new Date(String(value || "").trim());
	if (!Number.isFinite(parsed.getTime())) return "";
	return parsed.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric"
	});
}

function achievementAccentStyle(value: string) {
	const token = String(value || "").trim();
	const safeToken = /^--[a-z0-9-]+$/i.test(token) ? token : "--color-primary";
	return `--achievement-accent:var(${safeToken});`;
}

function achievementEarnedLabel(value: string) {
	const formatted = formatActivityDate(value);
	return formatted ? `Earned ${formatted}` : "Earned recently";
}

function finishedDateTimestamp(value: string) {
	const parsed = new Date(String(value || "").trim());
	const time = parsed.getTime();
	return Number.isFinite(time) ? time : 0;
}

function shelfHrefForOwner(sectionId: string) {
	const map: Record<string, string> = {
		want_to_read: "want-to-read",
		reading: "currently-reading",
		finished: "read",
		total: ""
	};
	const target = map[String(sectionId || "").trim()] || "recent-activity";
	return target ? `#${encodeURIComponent(target)}` : "#";
}

function paginate<T>(items: T[], page: number, pageSize: number) {
	const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
	const currentPage = Math.min(Math.max(1, page), totalPages);
	const start = (currentPage - 1) * pageSize;
	return {
		items: items.slice(start, start + pageSize),
		totalPages,
		currentPage
	};
}

function paginateWindow<T>(items: T[], page: number, pageSize: number, totalCount: number) {
	const totalPages = Math.max(1, Math.ceil(Math.max(0, Number(totalCount) || 0) / pageSize));
	const currentPage = Math.min(Math.max(1, page), totalPages);
	return {
		items: items.slice(0, pageSize),
		totalPages,
		currentPage
	};
}

function paginationHref(param: string, value: number, anchor: string) {
	const params = new URLSearchParams(Astro.url.searchParams);
	if (value <= 1) params.delete(param);
	else params.set(param, String(value));
	const query = params.toString();
	return `${Astro.url.pathname}${query ? `?${query}` : ""}#${anchor}`;
}

function defaultProfileSectionOrder(customKeys: string[]) {
	return [
		"default:reading",
		RECENT_ACTIVITY_SECTION_KEY,
		REVIEWS_SECTION_KEY,
		"default:want_to_read",
		"default:finished",
		...customKeys
	];
}

function mergeProfileSectionOrder(storedOrder: string[], allKeys: string[], defaultOrder: string[]) {
	const knownKeys = new Set(allKeys);
	const dedupedStored = Array.from(new Set(
		storedOrder
			.map((key) => String(key || "").trim())
			.filter((key) => knownKeys.has(key))
	));
	if (dedupedStored.length === 0) return defaultOrder.filter((key) => knownKeys.has(key));
	const merged = [...dedupedStored];
	for (const key of defaultOrder) {
		if (!knownKeys.has(key) || merged.includes(key)) continue;
		if (key === RECENT_ACTIVITY_SECTION_KEY) {
			const readingIndex = merged.indexOf("default:reading");
			if (readingIndex >= 0) merged.splice(readingIndex + 1, 0, key);
			else merged.unshift(key);
			continue;
		}
		merged.push(key);
	}
	return merged;
}

function shelfSectionOrderValue(key: string) {
	const value = shelfSectionOrderByKey.get(String(key || "").trim());
	return Number.isFinite(value as number) ? Number(value) : 999;
}

function shelfSectionOrderStyle(key: string) {
	return `order:${300 + shelfSectionOrderValue(key)}`;
}

function shelfSectionMoveAttrs(key: string, direction: "up" | "down") {
	const order = shelfSectionOrderKeys.length > 0
		? shelfSectionOrderKeys
		: defaultProfileSectionOrder(customShelves.map((shelf) => `custom:${shelf.id}`));
	const index = order.indexOf(key);
	const canMove = direction === "up"
		? index > 0
		: index >= 0 && index < order.length - 1;
	return canMove ? {} : { disabled: true, "aria-disabled": "true" };
}

const baseSectionLinks = [
	{ id: "about", label: "About" },
	{ id: "reading-goal", label: "Reading Goal" },
	{ id: "shelf-summary", label: "Shelf Summary" }
];
const canShowAchievementsInHeader = isOwnerViewer || (showAchievementsPublic && achievements.length > 0);
const orderedShelfSectionLinks = isOwnerViewer
	? [
		{ id: "currently-reading", label: "Currently Reading", key: "default:reading" },
		{ id: "recent-activity", label: "Recent Activity", key: RECENT_ACTIVITY_SECTION_KEY },
		{ id: "reviews", label: "Reviews", key: REVIEWS_SECTION_KEY },
		{ id: "want-to-read", label: "Want to Read", key: "default:want_to_read" },
		{ id: "read", label: "Read", key: "default:finished" },
		...customShelves.map((shelf) => ({
			id: `custom-shelf-${shelf.slug || shelf.id}`,
			label: shelf.name,
			key: `custom:${shelf.id}`
		}))
	]
		.sort((a, b) => shelfSectionOrderValue(String(a.key || "")) - shelfSectionOrderValue(String(b.key || "")))
		.map(({ id, label }) => ({ id, label }))
	: [
		{ id: "currently-reading", label: "Currently Reading" },
		{ id: "recent-activity", label: "Recent Activity" },
		{ id: "reviews", label: "Reviews" },
		{ id: "want-to-read", label: "Want to Read" },
		{ id: "read", label: "Read" }
	];
const sectionLinks = [...baseSectionLinks, ...orderedShelfSectionLinks];
const customShelfOptionsJson = JSON.stringify(customShelves.map((shelf) => ({
	id: shelf.id,
	name: shelf.name,
	icon: shelf.icon
})));

const pagedRecent = paginate(recentActivity, recentPage, PAGE_SIZE);
const pagedReading = paginate(currentlyReading, readingPage, PAGE_SIZE);
const pagedWantToRead = paginateWindow(wantToReadBooks, wantToReadPage, PAGE_SIZE, shelfStats.wantToRead);
const pagedFinished = paginate(finishedBooks, finishedPage, PAGE_SIZE);
const profileAchievementPreview = achievements.slice(0, PROFILE_ACHIEVEMENT_PREVIEW_COUNT);
const profileAchievementMore = achievements.slice(PROFILE_ACHIEVEMENT_PREVIEW_COUNT);
const readingGoalStartedAt = performance.now();
const currentGoalYear = readingGoalYear();
const finishedThisYearStartedAt = performance.now();
const booksCompletedThisYear = filterCanonicalFinishedBooksForYear(finishedBooks, currentGoalYear)
	.sort((a, b) => finishedDateTimestamp(b.finishedDate) - finishedDateTimestamp(a.finishedDate));
recordPagePerfSpan("finished-this-year books", performance.now() - finishedThisYearStartedAt, finishedThisYearStartedAt);
const readingGoal = resolveReadingGoalProgress({
	goal: profile.readingGoal,
	completed: booksCompletedThisYear.length
});
recordPagePerfSpan("reading goal", performance.now() - readingGoalStartedAt, readingGoalStartedAt);
const dnfStartedAt = performance.now();
recordPagePerfSpan("DNF", performance.now() - dnfStartedAt, dnfStartedAt);
const shelfSectionOrderJson = JSON.stringify(
	shelfSectionOrderKeys.length > 0
		? shelfSectionOrderKeys
		: defaultProfileSectionOrder(customShelves.map((shelf) => `custom:${shelf.id}`))
);
const profileCanonicalUrl = profile.username ? `/profile/${encodeURIComponent(profile.username)}` : `/profile/${encodeURIComponent(requestedUsername)}`;
const hasIndexableProfileContent = shelfStats.total > 0 || recentActivity.length > 0 || currentlyReading.length > 0 || wantToReadBooks.length > 0 || finishedBooks.length > 0 || (showAchievementsPublic && achievements.length > 0);
const profileRobots = (!notFound && !privateProfile && !!profile.username && hasIndexableProfileContent) ? "index,follow" : "noindex,follow";
const profileDescription = !notFound && !privateProfile
	? `${profile.name || `@${profile.username}`}'s reading profile on DogEared. ${shelfStats.total.toLocaleString()} books across shelves.`
	: "Reader profile on DogEared.";
const profileStructuredData = (!notFound && !privateProfile && !!profile.username)
	? JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Person",
		name: profile.name || `@${profile.username}`,
		alternateName: `@${profile.username}`,
		description: profile.blurb || undefined,
		url: toAbsoluteUrl(profileCanonicalUrl, Astro.site ?? Astro.url),
		image: profile.avatar || undefined
	})
	: "";
const profileBreadcrumbStructuredData = JSON.stringify(buildBreadcrumbList([
	{ name: "Home", item: "/" },
	...(profile.username
		? [
			{ name: "Profile", item: "/profile" },
			{ name: `@${profile.username}`, item: profileCanonicalUrl }
		]
		: [{ name: "Profile", item: profileCanonicalUrl }])
], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV }));
const profileStructuredDataPayload = profileStructuredData
	? JSON.stringify([JSON.parse(profileStructuredData), JSON.parse(profileBreadcrumbStructuredData)])
	: "";
const momentumByBookId = new Map(momentumBooks.map((item) => [item.bookId, item]));

const profilePerformanceTelemetry = {
	operationName: "page.profile",
	route: "/profile/[username]",
	startedAt: pagePerfStartedAt,
	success: !notFound && !privateProfile,
	httpStatus: notFound ? 404 : privateProfile ? 403 : 200,
	spans: pagePerfSpans,
	metadata: {
		authenticated: isAuthenticated,
		isOwnerViewer,
		status: notFound ? "not_found" : privateProfile ? "private" : "ok",
		shelfTotal: shelfStats.total,
		activityCount: recentActivity.length,
		currentlyReadingCount: currentlyReading.length,
		wantToReadCount: wantToReadBooks.length,
		finishedCount: finishedBooks.length,
		customShelfCount: customShelves.length,
		achievementCount: achievements.length
	}
};
---

<Layout
	title={profile.username ? `${profile.username} • Profile` : "Profile"}
	sectionLinks={sectionLinks}
	metaDescription={profileDescription}
	canonicalUrl={profileCanonicalUrl}
	robots={profileRobots}
	structuredData={profileStructuredDataPayload}
	resolvedSession={session}
	performanceTelemetry={profilePerformanceTelemetry}
>
	<div
		slot="right"
		class="public-profile-page"
		data-authenticated={String(isAuthenticated)}
		data-shelf-section-order={shelfSectionOrderJson}
		data-reading-streak-days={JSON.stringify(readingStreakDateKeys)}
	>
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			{profile.username ? (
				<>
					<a href="/profile">Profile</a>
					<span aria-hidden="true">/</span>
					<span>@{profile.username}</span>
				</>
			) : <span>Profile</span>}
		</nav>
		{notFound && (
			<section class="state-card">
				<h1>Profile not found</h1>
				<p>That username does not exist.</p>
			</section>
		)}
		{!notFound && privateProfile && (
			<section class="state-card">
				<h1>@{requestedUsername}</h1>
				<p>This profile is private.</p>
			</section>
		)}
		{!notFound && !privateProfile && (
			<>
				{showWelcomeBanner && (
					<section class="welcome-banner" role="status" aria-live="polite">
						<p><strong>Welcome to DogEared.</strong> Your account setup is complete and your profile is live.</p>
						<a id="dismiss-welcome-banner" class="welcome-banner-dismiss" href={dismissWelcomeUrl}>Dismiss</a>
					</section>
				)}
				<section id="about" class="profile-card">
					{isOwnerViewer && (
						<div class="profile-card-actions">
							<div class="profile-actions-menu-wrap" data-profile-actions-menu>
								<button
									type="button"
									class="profile-actions-menu-trigger"
									data-action="toggle-profile-actions-menu"
									aria-expanded="false"
									aria-label="Profile actions"
								>
									<span class="material-icons" aria-hidden="true">more_vert</span>
								</button>
								<div class="profile-actions-menu" hidden>
									<a class="profile-actions-menu-item" href={`/profile/${encodeURIComponent(profile.username)}?edit=1`}>
										{editMode ? "Editing..." : "Edit Profile"}
									</a>
									<a class="profile-actions-menu-item" href="/reading-life">My Reading Life</a>
									<a class="profile-actions-menu-item" href="/settings">Settings</a>
								</div>
							</div>
						</div>
					)}
					<div class="profile-head">
						<div class="avatar-wrap" aria-hidden="true">
							{profile.avatar ? (
								<img
									src={profile.avatar}
									alt=""
									class="avatar"
									loading="lazy"
									decoding="async"
									width="64"
									height="64"
									onerror="this.outerHTML='<div class=&quot;avatar-fallback&quot; aria-hidden=&quot;true&quot;>@</div>';"
								/>
							) : (
								<div class="avatar-fallback">@</div>
							)}
						</div>
						<div>
							<h1>{profile.name || `@${profile.username}`}</h1>
							<p class="username">@{profile.username}</p>
							<p class="meta">
								<a class="meta-link" href={`/profile/${encodeURIComponent(profile.username)}/followers`}>Followers: <span id="follow-count-followers">{followState.followersCount}</span></a>
								{" · "}
								<a class="meta-link" href="/following">Following: <span id="follow-count-following">{followState.followingCount}</span></a>
							</p>
						</div>
					</div>
					{followState.canFollow && (
						<div class="follow-actions">
							<form method="post" action={`/profile/${encodeURIComponent(profile.username)}`}>
								<input type="hidden" name="followIntent" value={followState.isViewerFollowing ? "unfollow" : "follow"} />
								<button
									id="follow-toggle"
									type="submit"
									data-username={profile.username}
									data-following={String(followState.isViewerFollowing)}
								>
									{followState.isViewerFollowing ? "Following" : "Follow"}
								</button>
							</form>
							<p id="follow-feedback" class="meta" hidden></p>
						</div>
					)}
					{isOwnerViewer && editMode ? (
						<form method="post" action={`/profile/${encodeURIComponent(profile.username)}?edit=1`} class="inline-profile-form">
							<input type="hidden" name="profileIntent" value="save" />
							<label>Name<input type="text" name="name" maxlength="80" value={profile.name || ""} required /></label>
							<label>Username<input type="text" name="username" maxlength="40" value={profile.username ? `@${profile.username}` : ""} required /></label>
							<input type="hidden" name="avatarUrl" maxlength="500000" value={profile.avatar || ""} />
							<label>Upload Avatar<input type="file" name="avatarFile" accept="image/*" data-avatar-file /></label>
							<label>Location<input type="text" name="location" maxlength="80" value={profile.location || ""} /></label>
							<label>Birth year<input type="number" name="birthYear" min="1900" max="2100" inputmode="numeric" value={profile.birthYear || ""} placeholder="1985" /></label>
							<label>Reading goal<input type="text" name="readingGoal" maxlength="80" value={profile.readingGoal || ""} /></label>
							<label>Favorite book<input type="text" name="favoriteBook" maxlength="120" value={profile.favoriteBook || ""} /></label>
							<label>Favorite author<input type="text" name="favoriteAuthor" maxlength="120" value={profile.favoriteAuthor || ""} /></label>
							<label class="full-width">Blurb<textarea name="blurb" rows={3} maxlength={400}>{profile.blurb || ""}</textarea></label>
							<label class="full-width">Genres (comma separated)<input type="text" name="genres" value={profile.genres.join(", ")} /></label>
							<div class="inline-profile-actions">
								<button type="submit">Save Profile</button>
								<a class="secondary" href={`/profile/${encodeURIComponent(profile.username)}`}>Cancel</a>
							</div>
						</form>
					) : (
						<>
							{profile.blurb && <p class="blurb">{profile.blurb}</p>}
							<div class="meta-grid">
								{profile.location && <p><strong>Location:</strong> {profile.location}</p>}
								{profile.favoriteBook && (
									<p>
										<strong>Favorite book:</strong>{" "}
										<a class="author-link" href={favoriteBookHref || `/book?title=${encodeURIComponent(profile.favoriteBook)}`}>{profile.favoriteBook}</a>
									</p>
								)}
								{profile.favoriteAuthor && (
									<p>
										<strong>Favorite author:</strong>{" "}
										{favoriteAuthorHref
											? <a class="author-link" href={favoriteAuthorHref}>{profile.favoriteAuthor}</a>
											: profile.favoriteAuthor}
									</p>
								)}
							</div>
							{profile.genres.length > 0 && (
								<ul class="genre-list">
									{profile.genres.map((genre) => (
										<li>
											<Chip
												label={genre}
												className="genre-chip"
												href={`/related?kind=genre&value=${encodeURIComponent(genre)}`}
											/>
										</li>
									))}
								</ul>
							)}
							{canShowAchievementsInHeader && achievements.length > 0 && (
								<div id="achievements" class="profile-achievements" aria-labelledby="profile-achievements-title">
									<div class="profile-achievements-head">
										<h2 id="profile-achievements-title">Achievements</h2>
										{isOwnerViewer && !showAchievementsPublic && (
											<p>Hidden from other readers</p>
										)}
									</div>
									<ul class="profile-achievement-row" aria-label="Earned achievements">
										{profileAchievementPreview.map((achievement) => (
