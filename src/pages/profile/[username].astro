	function recalcMomentumFromDom() {
		if (!momentumPanel) return;
		const cards = Array.from(document.querySelectorAll('#currently-reading [data-momentum-reading-item="true"]'));
		const items = cards.map((card) => {
			if (!(card instanceof HTMLElement)) return null;
			const title = String(card.dataset.momentumTitle || "").trim();
			const currentPage = Math.max(0, Number(card.dataset.momentumCurrentPage || 0) || 0);
			const totalPages = Math.max(0, Number(card.dataset.momentumTotalPages || 0) || 0);
			const updatedAt = String(card.dataset.momentumUpdatedAt || "").trim();
			const firstAddedAt = String(card.dataset.momentumFirstAddedAt || updatedAt).trim();
			const progressUpdateCount = Math.max(0, Number(card.dataset.momentumProgressUpdates || 0) || 0);
			const percent = totalPages > 0 ? Math.max(0, Math.min(100, Math.round((currentPage / totalPages) * 100))) : 0;
			const daysSinceUpdate = daysSinceMomentumDate(updatedAt);
			const daysSinceStart = daysSinceMomentumDate(firstAddedAt);
			const prediction = resolveClientMomentumPrediction({
				currentPage,
				totalPages,
				daysSinceUpdate,
				daysSinceStart,
				progressUpdateCount
			});
			return { card, title, currentPage, totalPages, percent, daysSinceUpdate, ...prediction };
		}).filter(Boolean);
		if (items.length === 0) {
			if (momentumScoreNode instanceof HTMLElement) momentumScoreNode.textContent = "0";
			if (momentumStreakNode instanceof HTMLElement) {
				const streak = computeClientReadingStreak(Array.from(readingStreakDayKeys));
				momentumStreakNode.textContent = String(streak);
			}
			if (momentumNextActionNode instanceof HTMLElement) {
				momentumNextActionNode.textContent = "Add a few progress updates and Dogeared will start estimating reading momentum.";
			}
			return;
		}
		const eligibleItems = items.filter((item) => item.eligible);
		const firstOnboardingItem = items
			.filter((item) => !item.eligible)
			.sort((a, b) => a.daysSinceUpdate - b.daysSinceUpdate)[0] || null;
		for (const item of items) {
			const healthNode = item.card.querySelector(".momentum-health");
			if (!(healthNode instanceof HTMLElement)) continue;
			healthNode.classList.remove("momentum-health-good", "momentum-health-neutral");
			healthNode.classList.add(`momentum-health-${item.tone}`);
			if (item.eligible) {
				healthNode.hidden = false;
				healthNode.textContent = `${item.label} · ${item.message}`;
				continue;
			}
			if (!firstOnboardingItem || firstOnboardingItem.card !== item.card) {
				healthNode.hidden = true;
				healthNode.textContent = "";
				continue;
			}
			healthNode.hidden = false;
			healthNode.textContent = item.label;
		}
		const avgScore = eligibleItems.length > 0
			? Math.round(eligibleItems.reduce((sum, item) => sum + item.finishProbability, 0) / eligibleItems.length)
			: 0;
		if (momentumScoreNode instanceof HTMLElement) momentumScoreNode.textContent = String(avgScore);

		const seenDays = new Set([
			...Array.from(readingStreakDayKeys),
			...items.map((item) => {
				const d = new Date(String(item.card.dataset.momentumUpdatedAt || "").trim());
				return Number.isFinite(d.getTime()) ? d.toISOString().slice(0, 10) : "";
			}).filter(Boolean)
		]);
		let streak = computeClientReadingStreak(Array.from(seenDays));
		if (momentumStreakNode instanceof HTMLElement) momentumStreakNode.textContent = String(streak);

		const atRisk = eligibleItems
			.slice()
			.sort((a, b) => b.daysSinceUpdate - a.daysSinceUpdate)
			.find((item) => item.label === "Reading momentum slowing");
		const best = eligibleItems.slice().sort((a, b) => b.finishProbability - a.finishProbability)[0];
		if (momentumNextActionNode instanceof HTMLElement) {
			if (atRisk) {
				const catchupPages = Math.max(6, Math.min(24, Math.round((atRisk.totalPages || 180) * 0.06)));
				momentumNextActionNode.textContent = `A short session of about ${catchupPages} pages in ${atRisk.title} will rebuild momentum.`;
			} else if (best) {
				const nextMilestone = Math.min(100, Math.ceil(best.percent / 10) * 10);
				momentumNextActionNode.textContent = nextMilestone > best.percent
					? `Push ${best.title} to ${nextMilestone}% today.`
					: `Keep pace in ${best.title} today.`;
			} else {
				momentumNextActionNode.textContent = "Add a few progress updates and Dogeared will start estimating reading momentum.";
			}
		}
	}

	function computeClientReadingStreak(dateKeys) {
		const seenDays = new Set(
			(Array.isArray(dateKeys) ? dateKeys : [])
				.map((key) => String(key || "").trim().slice(0, 10))
				.filter(Boolean)
		);
		if (seenDays.size === 0) return 0;
		let streak = 0;
		const cursor = new Date();
		while (true) {
			const key = cursor.toISOString().slice(0, 10);
			if (!seenDays.has(key)) break;
			streak += 1;
			cursor.setUTCDate(cursor.getUTCDate() - 1);
		}
		return streak;
	}

