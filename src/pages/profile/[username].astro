	function ensureProgressDisplay(card, currentPage, totalPages) {
		if (!(card instanceof HTMLElement)) return null;
		const progressBlock = card.querySelector(".reading-progress-block");
		if (!(progressBlock instanceof HTMLElement)) return null;
		let progressNode = progressBlock.querySelector(".progress-current-value");
		let progressTrack = progressBlock.querySelector(".progress-track");
		let progressFill = progressBlock.querySelector(".progress-fill");
		const healthNode = progressBlock.querySelector(".momentum-health");
		if (!(progressNode instanceof HTMLElement)) {
			progressNode = document.createElement("p");
			progressNode.className = "meta progress-current-value";
			progressBlock.insertBefore(progressNode, healthNode || progressBlock.firstChild);
		}
		if (totalPages > 0 && !(progressTrack instanceof HTMLElement)) {
			progressTrack = document.createElement("div");
			progressTrack.className = "progress-track progress-bar-track";
			progressTrack.setAttribute("aria-hidden", "true");
			progressFill = document.createElement("div");
			progressFill.className = "progress-fill progress-bar-fill";
			progressTrack.append(progressFill);
			progressNode.insertAdjacentElement("afterend", progressTrack);
		}
		if (totalPages > 0 && !(progressFill instanceof HTMLElement) && progressTrack instanceof HTMLElement) {
			progressFill = document.createElement("div");
			progressFill.className = "progress-fill progress-bar-fill";
			progressTrack.append(progressFill);
		}
		const percent = totalPages > 0 ? Math.max(0, Math.min(100, Math.round((currentPage / totalPages) * 100))) : 0;
		progressNode.textContent = totalPages > 0
			? `Progress: ${currentPage}/${totalPages} pages (${percent}%)`
			: `Progress: ${currentPage} pages`;
		if (progressFill instanceof HTMLElement) progressFill.style.width = `${percent}%`;
		return { progressNode, progressFill };
	}

