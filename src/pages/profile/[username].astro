			if (!(row instanceof HTMLElement)) return;
			const thisMenu = row.querySelector(".custom-shelf-menu");
			const willOpen = thisMenu instanceof HTMLElement ? thisMenu.hidden : false;
			closeAllShelfSectionMenus();
			if (thisMenu instanceof HTMLElement) {
				thisMenu.hidden = !willOpen;
				toggleButton.setAttribute("aria-expanded", willOpen ? "true" : "false");
			}
			return;
		}
		const row = target.closest("[data-custom-shelf-row], [data-shelf-section-key]");
		if (!(row instanceof HTMLElement)) {
			if (!target.closest(".custom-shelf-menu") && !target.closest('[data-action="toggle-custom-shelf-menu"]')) {
				closeAllShelfSectionMenus();
			}
			return;
		}
		const sectionKey = String(row.getAttribute("data-shelf-section-key") || "").trim();
		let shelfId = Math.max(0, Number(row.dataset.shelfId || 0) || 0);
		if (!shelfId && sectionKey.startsWith("custom:")) {
			shelfId = Math.max(0, Number(sectionKey.slice("custom:".length)) || 0);
		}
		const renameButton = target.closest('[data-action="rename-custom-shelf"]');
		const iconButton = target.closest('[data-action="change-custom-shelf-icon"]');
		const moveUpButton = target.closest('[data-action="move-shelf-section-up"]');
		const moveDownButton = target.closest('[data-action="move-shelf-section-down"]');
		if (moveUpButton || moveDownButton) {
			if ((moveUpButton instanceof HTMLButtonElement && (moveUpButton.disabled || moveUpButton.getAttribute("aria-disabled") === "true"))
				|| (moveDownButton instanceof HTMLButtonElement && (moveDownButton.disabled || moveDownButton.getAttribute("aria-disabled") === "true"))) {
				event.preventDefault();
				event.stopPropagation();
				return;
			}
			if (!sectionKey) return;
			const workingOrder = shelfSectionOrder.length > 0
				? [...shelfSectionOrder]
				: shelfSectionNodes
					.map((node) => String(node.getAttribute("data-shelf-section-key") || "").trim())
					.filter(Boolean);
			const index = workingOrder.indexOf(sectionKey);
			if (index < 0) return;
			const targetIndex = moveUpButton ? index - 1 : index + 1;
			if (targetIndex < 0 || targetIndex >= workingOrder.length) return;
			const swapped = [...workingOrder];
			const [moved] = swapped.splice(index, 1);
			swapped.splice(targetIndex, 0, moved);
			setCustomShelfFeedback("Updating order...");
			const result = await saveShelfSectionOrder(swapped);
			if (!result.ok) {
				setCustomShelfFeedback(String(result.data?.error || "Failed to update profile section order."), true);
				return;
			}
			shelfSectionOrder = swapped;
			applyShelfSectionOrderToDom(shelfSectionOrder);
			syncLeftNavShelfOrder(shelfSectionOrder);
			saveStoredShelfSectionOrder(shelfSectionOrder);
			setCustomShelfFeedback("Profile section order updated.");
			closeAllShelfSectionMenus();
			return;
		}
		if (!shelfId) return;
		if (iconButton) {
			const currentIcon = String(
				iconButton.getAttribute("data-current-icon")
				|| row.querySelector(".custom-shelf-heading-icon")?.textContent
				|| "bookmarks"
			).trim() || "bookmarks";
			const nextIcon = await promptForCustomShelfIcon(currentIcon);
			if (!nextIcon) return;
			setCustomShelfFeedback("Saving icon...");
			const result = await changeCustomShelfIcon(shelfId, nextIcon);
			if (!result.ok) {
				setCustomShelfFeedback(String(result.data?.error || "Failed to update icon."), true);
				return;
			}
			window.location.reload();
			return;
		}
		if (renameButton) {
			const currentName = String(row.querySelector("strong")?.textContent || "").trim();
			const nextName = window.prompt("Rename shelf", currentName);
			if (!nextName || nextName.trim() === currentName) return;
			setCustomShelfFeedback("Saving...");
			const result = await renameCustomShelf(shelfId, nextName);
			if (!result.ok) {
				setCustomShelfFeedback(String(result.data?.error || "Failed to rename shelf."), true);
				return;
			}
			closeAllShelfSectionMenus();
			window.location.reload();
			return;
		}
		const deleteButton = target.closest('[data-action="delete-custom-shelf"]');
		if (deleteButton) {
			if (!window.confirm("Delete this custom shelf?")) return;
			setCustomShelfFeedback("Deleting...");
			const result = await deleteCustomShelf(shelfId);
			if (!result.ok) {
				setCustomShelfFeedback(String(result.data?.error || "Failed to delete shelf."), true);
				return;
			}
			closeAllShelfSectionMenus();
			window.location.reload();
		}
	});

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		if (target.closest("[data-profile-actions-menu]")) return;
		const menu = profileActionsMenu?.querySelector(".profile-actions-menu");
		if (menu instanceof HTMLElement) menu.hidden = true;
		const trigger = profileActionsMenu?.querySelector('[data-action="toggle-profile-actions-menu"]');
		if (trigger instanceof HTMLButtonElement) trigger.setAttribute("aria-expanded", "false");
	});

	void (async () => {
		migrateShelfEntriesInPlace();
		await hydrateShelfEntriesFromServer();
		syncExistingState();
	})();

	const localOrder = loadStoredShelfSectionOrder();
	if (localOrder.length > 0) {
		const liveKeys = new Set(shelfSectionNodes.map((node) => String(node.getAttribute("data-shelf-section-key") || "").trim()).filter(Boolean));
		const localWithRecent = mergeStoredProfileSectionOrder(localOrder, Array.from(liveKeys));
		const mergedOrder = [
			...localWithRecent,
			...Array.from(liveKeys).filter((key) => !localWithRecent.includes(key))
		];
		if (mergedOrder.length > 0) shelfSectionOrder = mergedOrder;
	}
	applyShelfSectionOrderToDom(shelfSectionOrder);
	syncLeftNavShelfOrder(shelfSectionOrder);
</script>
<script type="module">
	const page = document.querySelector(".public-profile-page");
	if (!(page instanceof HTMLElement)) {
		// no-op
	} else {
		const isAuthenticated = page.dataset.authenticated === "true";

		const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			'"': "&quot;",
			"'": "&#39;"
		}[char] || char));
		const toAgeLabel = (value) => {
			const parsed = new Date(String(value || ""));
			if (!Number.isFinite(parsed.getTime())) return "";
			const diffMs = Math.max(0, Date.now() - parsed.getTime());
			const diffHours = diffMs / (1000 * 60 * 60);
			if (diffHours < 24) {
				const hours = Math.max(0, Math.round(diffHours));
				return `${hours} ${hours === 1 ? "hour" : "hours"}`;
			}
			const days = Math.max(1, Math.round(diffHours / 24));
			return `${days} ${days === 1 ? "day" : "days"}`;
		};
		const renderCommentHtml = (comment) => {
			const username = String(comment?.username || "").trim().replace(/^@+/, "") || "reader";
			const body = String(comment?.body || "").trim();
			if (!body) return "";
			const ageLabel = toAgeLabel(comment?.createdAt);
			const commentId = Math.max(0, Number(comment?.id || 0) || 0);
			const isMine = !!comment?.isMine && commentId > 0;
			const profileHref = `/profile/${encodeURIComponent(username)}`;
			return `<p class="activity-comment-item"${commentId > 0 ? ` data-comment-id="${commentId}"` : ""}><span class="activity-comment-head"><a class="activity-comment-user" href="${profileHref}">@${escapeHtml(username)}</a><span class="activity-comment-meta">${ageLabel ? `<span class="activity-comment-age">${escapeHtml(ageLabel)}</span>` : ""}${isMine ? `<button type="button" class="activity-comment-delete" data-action="delete-comment" data-comment-id="${commentId}" aria-label="Delete comment" title="Delete comment">&times;</button>` : ""}</span></span><span class="activity-comment-body">${escapeHtml(body)}</span></p>`;
		};

		document.addEventListener("click", async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const deleteButton = target.closest('[data-action="delete-comment"]');
			if (deleteButton instanceof HTMLButtonElement) {
				const commentId = Number(deleteButton.dataset.commentId || 0);
				if (!Number.isFinite(commentId) || commentId <= 0) return;
				const commentItem = deleteButton.closest(".activity-comment-item");
				const wrap = deleteButton.closest("[data-comments-wrap]");
				const feedback = wrap?.querySelector("[data-comment-feedback]");
				const activityId = Number(wrap?.getAttribute("data-activity-id") || 0);
				deleteButton.disabled = true;
				try {
					const response = await fetch("/api/activity/comments", {
						method: "DELETE",
						headers: { "Content-Type": "application/json" },
						credentials: "same-origin",
						body: JSON.stringify({ commentId, activityId })
					});
					const data = await response.json().catch(() => ({}));
					if (response.status === 401) {
						window.location.href = "/?next=/profile";
						return;
					}
					if (!response.ok) {
						deleteButton.disabled = false;
						if (feedback instanceof HTMLElement) {
							feedback.hidden = false;
							feedback.textContent = String(data?.error || "Failed to delete comment.");
						}
						return;
					}
					commentItem?.remove();
					if (wrap instanceof HTMLElement) {
						const remaining = wrap.querySelectorAll(".activity-comment-item").length;
						wrap.dataset.commentsEmpty = remaining > 0 ? "0" : "1";
					}
					if (feedback instanceof HTMLElement) {
						feedback.hidden = true;
						feedback.textContent = "";
					}
				} catch {
					deleteButton.disabled = false;
				}
				return;
			}
			const likeButton = target.closest('[data-action="toggle-activity-like"]');
			if (!(likeButton instanceof HTMLButtonElement)) return;
			const activityId = Number(likeButton.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) return;
			if (!isAuthenticated) {
				window.location.href = "/?next=/profile";
				return;
			}
			const liked = likeButton.dataset.liked === "true";
			likeButton.disabled = true;
			try {
				const response = await fetch("/api/activity/like", {
					method: liked ? "DELETE" : "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ activityId })
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(String(data?.error || "Request failed"));
				const nextLiked = !!data.viewerLiked;
				const nextCount = Math.max(0, Number(data.likeCount || 0));
				likeButton.dataset.liked = String(nextLiked);
				likeButton.classList.toggle("is-liked", nextLiked);
				likeButton.setAttribute("aria-label", nextLiked ? "Unlike this activity" : "Like this activity");
				const label = likeButton.querySelector(".activity-like-label");
				if (label) label.textContent = nextLiked ? "Liked" : "Like";
				const countTarget = likeButton.closest(".activity-like-wrap")?.querySelector("[data-like-count-static]");
				if (countTarget) countTarget.textContent = String(nextCount);
			} catch {
				// no-op
			} finally {
				likeButton.disabled = false;
			}
		});

		document.addEventListener("submit", async (event) => {
			const form = event.target;
			if (!(form instanceof HTMLFormElement) || !form.matches("[data-comment-form]")) return;
			event.preventDefault();
			const wrap = form.closest("[data-comments-wrap]");
			if (!(wrap instanceof HTMLElement)) return;
			const activityId = Number(wrap.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) return;
			const input = form.querySelector('input[name="comment"]');
			const button = form.querySelector('button[type="submit"]');
			const list = wrap.querySelector("[data-comments-list]");
			const feedback = wrap.querySelector("[data-comment-feedback]");
			if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
			const message = String(input.value || "").trim();
			if (!message) return;
			input.disabled = true;
			button.disabled = true;
			try {
				const response = await fetch("/api/activity/comments", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ activityId, body: message })
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 401) {
					window.location.href = "/?next=/profile";
					return;
				}
				if (!response.ok) throw new Error(String(data?.error || "Failed to post comment."));
					if (list instanceof HTMLElement && data?.comment) {
						const wrapper = document.createElement("div");
						wrapper.innerHTML = renderCommentHtml(data.comment);
						const node = wrapper.firstElementChild;
						if (node) list.append(node);
						wrap.dataset.commentsEmpty = "0";
				}
				input.value = "";
				if (feedback instanceof HTMLElement) {
					feedback.hidden = true;
					feedback.textContent = "";
				}
			} catch {
				if (feedback instanceof HTMLElement) {
					feedback.hidden = false;
					feedback.textContent = "Failed to post comment.";
				}
			} finally {
				input.disabled = false;
				button.disabled = false;
			}
		});

		const wraps = Array.from(document.querySelectorAll("#recent-activity [data-comments-wrap]"));
		for (const wrap of wraps) {
			if (!(wrap instanceof HTMLElement)) continue;
			const activityId = Number(wrap.dataset.activityId || 0);
			if (!Number.isFinite(activityId) || activityId <= 0) continue;
			const list = wrap.querySelector("[data-comments-list]");
			const feedback = wrap.querySelector("[data-comment-feedback]");
			if (feedback instanceof HTMLElement) {
				feedback.hidden = true;
				feedback.textContent = "";
			}
			try {
				const response = await fetch(`/api/activity/comments?activityId=${encodeURIComponent(String(activityId))}`, {
					credentials: "same-origin"
				});
				const data = await response.json().catch(() => ({}));
				if (response.status === 401) {
					if (list instanceof HTMLElement) list.innerHTML = "";
					wrap.dataset.commentsEmpty = "1";
					if (feedback instanceof HTMLElement) feedback.hidden = true;
					continue;
				}
				if (!response.ok) {
					if (feedback instanceof HTMLElement) feedback.textContent = String(data?.error || "Failed to load comments.");
					continue;
				}
				if (list instanceof HTMLElement) {
					const comments = Array.isArray(data?.comments) ? data.comments : [];
					list.innerHTML = comments.map((comment) => renderCommentHtml(comment)).join("");
					wrap.dataset.commentsEmpty = comments.length > 0 ? "0" : "1";
				}
				if (feedback instanceof HTMLElement) feedback.hidden = true;
			} catch {
				if (feedback instanceof HTMLElement) {
					feedback.hidden = false;
					feedback.textContent = "Failed to load comments.";
				}
			}
		}
	}
</script>
