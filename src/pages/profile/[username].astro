				marginTop: "0.8rem"
			});

			const cancelButton = document.createElement("button");
			cancelButton.type = "button";
			cancelButton.className = "finish-rating-cancel";
			cancelButton.textContent = "Cancel";

			const skipButton = document.createElement("button");
			skipButton.type = "button";
			skipButton.className = "finish-rating-skip";
			skipButton.textContent = "Finish without rating";

			const saveButton = document.createElement("button");
			saveButton.type = "button";
			saveButton.className = "finish-rating-save";
			saveButton.textContent = "Finish";
			saveButton.disabled = true;

			let selectedRating = initialRating;

			const renderStars = (hoverValue = 0) => {
				const active = hoverValue || selectedRating;
				const buttons = stars.querySelectorAll("button");
				buttons.forEach((button, index) => {
					const value = index + 1;
					button.textContent = value <= active ? "★" : "☆";
					button.setAttribute("aria-pressed", value === selectedRating ? "true" : "false");
				});
				saveButton.disabled = selectedRating < 1 || selectedRating > 5;
			};

			const close = (result) => {
				overlay.remove();
				resolve(result);
			};
			const setBusy = (busy) => {
				cancelButton.disabled = busy;
				skipButton.disabled = busy;
				saveButton.disabled = busy || selectedRating < 1 || selectedRating > 5;
				reflectionInput.disabled = busy;
				reviewTitleInput.disabled = busy;
				spoilerInput.disabled = busy;
				for (const button of Array.from(stars.querySelectorAll("button"))) {
					button.disabled = busy;
				}
				saveButton.textContent = busy ? "Saving..." : "Finish";
				skipButton.textContent = busy ? "Saving..." : "Finish without rating";
			};

			for (let i = 1; i <= 5; i += 1) {
				const star = document.createElement("button");
				star.type = "button";
				star.className = "finish-rating-star";
				star.dataset.value = String(i);
				star.setAttribute("aria-label", `${i} star${i === 1 ? "" : "s"}`);
				star.textContent = "☆";
				Object.assign(star.style, {
					border: "none",
					background: "transparent",
					fontSize: "2rem",
					lineHeight: "1",
					padding: "0.1rem",
					color: "#f59e0b",
					cursor: "pointer"
				});
				star.addEventListener("mouseenter", () => renderStars(i));
				star.addEventListener("mouseleave", () => renderStars());
				star.addEventListener("click", () => {
					selectedRating = i;
					renderStars();
				});
				stars.append(star);
			}

			const currentReflection = () => String(reflectionInput.value || "").trim().slice(0, 4000);
			const currentReviewTitle = () => String(reviewTitleInput.value || "").trim().slice(0, 160);
			const submitResult = async (payload) => {
				if (!onSubmit) {
					close(payload);
					return;
				}
				errorNode.hidden = true;
				errorNode.textContent = "";
				setBusy(true);
				try {
					const result = await onSubmit(payload);
					if (result?.ok) {
						close(payload);
						return;
					}
					errorNode.textContent = String(result?.message || "Failed to save. Please try again.");
					errorNode.hidden = false;
				} catch (error) {
					errorNode.textContent = error instanceof Error ? error.message : "Failed to save. Please try again.";
					errorNode.hidden = false;
				} finally {
					setBusy(false);
				}
			};
			cancelButton.addEventListener("click", () => close({ cancelled: true, rating: null, title: "", reflection: "", spoiler: false }));
			skipButton.addEventListener("click", async () => {
				await submitResult({ cancelled: false, rating: null, title: currentReviewTitle(), reflection: currentReflection(), spoiler: spoilerInput.checked });
			});
			saveButton.addEventListener("click", async () => {
				await submitResult({ cancelled: false, rating: selectedRating, title: currentReviewTitle(), reflection: currentReflection(), spoiler: spoilerInput.checked });
			});
			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) close({ cancelled: true, rating: null });
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && document.body.contains(overlay)) close({ cancelled: true, rating: null });
			}, { once: true });

			actions.append(cancelButton, skipButton, saveButton);
			modal.append(title, subtitle, errorNode, stars, titleWrap, reflectionWrap, spoilerLabel, actions);
			overlay.append(modal);
			document.body.append(overlay);
			renderStars();
		});
	}

	async function promptAndSaveFinishedEntry(entry) {
		const result = await promptForFinishRating({
			onSubmit: async (finishRating) => {
				entry.rating = finishRating.rating;
				entry.reviewTitle = String(finishRating.title || "").trim().slice(0, 160);
				entry.finishedReflection = String(finishRating.reflection || "").trim().slice(0, 4000);
				entry.reviewSpoiler = finishRating.spoiler === true;
				const saveResult = await saveShelfEntryWithRetry(entry);
				return {
					ok: !!saveResult?.ok,
					message: String(saveResult?.message || "Failed to save.")
				};
			}
		});
		if (result?.cancelled) return { ok: false, cancelled: true };
		return { ok: true, cancelled: false };
	}

	function buildEntryFromDropdown(dropdown, status) {
		const nextStatus = String(status || "").trim();
		const card = dropdown.closest(".book-card");
		const cardReadingFormat = card instanceof HTMLElement ? card.dataset.readingFormat : "";
		return buildShelfEntryFromRecord({
			bookId: Number(dropdown.dataset.bookId || 0),
			title: String(dropdown.dataset.title || "").trim(),
			author: String(dropdown.dataset.author || "").trim(),
			description: String(dropdown.dataset.description || "").trim(),
			pageCount: 0,
			coverUrl: String(dropdown.dataset.cover || "").trim(),
			format: String(dropdown.dataset.format || "Book").trim(),
			language: String(dropdown.dataset.language || "").trim(),
			isbn10: String(dropdown.dataset.isbn10 || "").trim(),
			isbn13: String(dropdown.dataset.isbn13 || "").trim(),
			googleBooksId: String(dropdown.dataset.googleBooksId || "").trim()
		}, {
			status: nextStatus,
			totalPages: 0,
			currentPage: nextStatus === "reading" ? 1 : 0,
			readingFormat: String(dropdown.dataset.readingFormat || cardReadingFormat || "").trim(),
			finishedDate: nextStatus === "finished" ? new Date().toISOString().slice(0, 10) : ""
		});
	}

	function removeCardFromShelfSection(dropdown, status) {
		const normalizedStatus = String(status || "").trim();
		const card = dropdown?.closest?.(".book-card");
		if (!(card instanceof HTMLElement)) return;
		if (normalizedStatus === "reading") return;
		const section = dropdown.closest(".activity-card");
		if (!(section instanceof HTMLElement)) return;
		const sectionId = String(section.id || "");
		const grid = section.querySelector(".activity-grid");

		if (normalizedStatus === "finished") {
			const readSection = document.getElementById("read");
			if (readSection instanceof HTMLElement) {
				let readGrid = readSection.querySelector(".activity-grid");
				if (!(readGrid instanceof HTMLUListElement)) {
					const empty = Array.from(readSection.children).find((child) => child.tagName === "P");
					empty?.remove();
					readGrid = document.createElement("ul");
					readGrid.className = "activity-grid";
					readSection.append(readGrid);
				}
				const activityClone = card.cloneNode(true);
				clearMomentumTracking(card);
				if (activityClone instanceof HTMLElement) clearMomentumTracking(activityClone);
				card.querySelector(".reading-progress-block")?.remove();
				card.querySelector('[data-action="mark-finished-quick"]')?.remove();
				const prefix = card.querySelector(".activity-prefix");
				if (prefix instanceof HTMLElement) prefix.textContent = "Read";
				const date = card.querySelector(".activity-date");
				if (date instanceof HTMLElement) date.textContent = `Updated ${safeFormatActivityDate(new Date().toISOString())}`;
				readGrid.prepend(card);

				const recentSection = document.getElementById("recent-activity");
				if (recentSection instanceof HTMLElement && activityClone instanceof HTMLElement) {
					activityClone.querySelector(".reading-progress-block")?.remove();
					activityClone.querySelector(".cover-actions")?.remove();
					activityClone.querySelector(".card-menu")?.remove();
					const recentPrefix = activityClone.querySelector(".activity-prefix");
					if (recentPrefix instanceof HTMLElement) recentPrefix.textContent = "Finished Reading";
					let recentGrid = recentSection.querySelector(".activity-grid");
					if (!(recentGrid instanceof HTMLUListElement)) {
						const empty = Array.from(recentSection.children).find((child) => child.tagName === "P");
						empty?.remove();
						recentGrid = document.createElement("ul");
						recentGrid.className = "activity-grid";
						recentSection.append(recentGrid);
					}
					activityClone.dataset.optimisticActivity = "finished";
					recentGrid.prepend(activityClone);
				}
			}
			const readingCount = document.querySelector('[data-shelf-count="reading"]');
			const finishedCount = document.querySelector('[data-shelf-count="finished"]');
			if (sectionId === "currently-reading" && readingCount instanceof HTMLElement) {
				readingCount.textContent = String(Math.max(0, Number(readingCount.textContent || 0) - 1));
			}
			if (finishedCount instanceof HTMLElement) finishedCount.textContent = String(Math.max(0, Number(finishedCount.textContent || 0)) + 1);
		} else {
			card.remove();
		}

		if (!(grid instanceof HTMLElement)) return;
		if (grid.querySelector(".book-card")) return;
		const emptyState = sectionId === "currently-reading"
			? {
				text: "No books are currently marked as Currently Reading. Move a book here to track progress after each reading session.",
				href: "/search",
				label: "Find a book to start"
			}
			: (sectionId === "want-to-read" ? {
				text: "Your Want to Read shelf is where future books wait. Save a few titles to build your reading queue.",
				href: "/search",
				label: "Search for books"
			} : {
				text: "No books marked Read yet. Finish a book, add a rating, and DogEared will start building your reading history.",
				href: "/search",
				label: "Add a finished book"
			});
		const empty = document.createElement("div");
		empty.className = "profile-empty-state";
		const text = document.createElement("p");
		text.textContent = emptyState.text;
		const link = document.createElement("a");
		link.href = emptyState.href;
		link.textContent = emptyState.label;
		empty.append(text, link);
		grid.replaceWith(empty);
	}

	followToggle?.addEventListener("click", async () => {
		if (!(followToggle instanceof HTMLButtonElement)) return;
		const username = String(followToggle.dataset.username || "").trim();
		const isFollowing = String(followToggle.dataset.following || "") === "true";
		if (!username) return;
		followToggle.disabled = true;
		setFollowFeedback(isFollowing ? "Unfollowing..." : "Following...");
		try {
			const response = await fetch("/api/follow", {
				method: isFollowing ? "DELETE" : "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ username })
			});
			const data = await response.json().catch(() => ({}));
			if (response.status === 401) {
				window.location.href = "/settings#account-settings";
				return;
			}
			if (!response.ok) {
				setFollowFeedback(String(data?.error || "Unable to update follow state."), true);
				return;
			}
			const nextFollowing = !!data?.isViewerFollowing;
			followToggle.dataset.following = nextFollowing ? "true" : "false";
			followToggle.textContent = nextFollowing ? "Following" : "Follow";
			if (followersCountNode instanceof HTMLElement) {
				followersCountNode.textContent = String(Number(data?.followersCount || 0));
			}
			if (followingCountNode instanceof HTMLElement) {
				followingCountNode.textContent = String(Number(data?.followingCount || 0));
			}
			setFollowFeedback(nextFollowing ? "You are now following this reader." : "You unfollowed this reader.");
		} catch {
			setFollowFeedback("Unable to update follow state.", true);
		} finally {
			followToggle.disabled = false;
		}
	});

	for (const dropdown of shelfDropdowns) {
		const trigger = dropdown.querySelector('[data-action="toggle-shelf"]');
		const options = Array.from(dropdown.querySelectorAll('[data-action="set-shelf"], [data-action="assign-custom-shelf"]'));
		if (trigger) {
			trigger.addEventListener("click", (event) => {
				event.preventDefault();
				event.stopPropagation();
				toggleShelfMenu(dropdown, shelfDropdowns);
			});
		}
		for (const option of options) {
			option.addEventListener("click", async (event) => {
				event.preventDefault();
				event.stopPropagation();
				const action = String(option.dataset.action || "");
				if (action === "assign-custom-shelf") {
					const shelfId = Math.max(0, Number(option.dataset.shelfId || 0) || 0);
					const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
					if (!shelfId || !bookId) return;
					try {
						const result = await assignBookToCustomShelf(shelfId, bookId);
						if (!result.ok) throw new Error(String(result.data?.error || "Failed to assign custom shelf."));
						showShelfFeedback(dropdown, "Saved to custom shelf.", feedbackTimers);
						closeShelfMenus(shelfDropdowns);
					} catch (error) {
						showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
					}
					return;
				}
				if (action === "remove-from-shelves") {
					const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
					const entry = buildEntryFromDropdown(dropdown, "want_to_read");
					try {
						const result = await removeBookFromAllShelves(bookId, entry);
						if (!result.ok) throw new Error(resolveShelfRemoveMessage(result));
						setDropdownLabel(dropdown, "");
						setShelvedState(dropdown, false);
						showShelfFeedback(dropdown, "Removed from shelves.", feedbackTimers);
						removeCardFromShelfSection(dropdown, "remove");
						closeShelfMenus(shelfDropdowns);
						await refreshProfileReadingUiAfterMutation();
					} catch (error) {
						showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to remove.", feedbackTimers);
					}
					return;
				}
				const status = option.dataset.status || "want_to_read";
				const entry = buildEntryFromDropdown(dropdown, status);
				if (!(await prepareReadingFormatForShelfStatus(entry, status))) return;
				if (status === "finished") {
					const finishResult = await promptAndSaveFinishedEntry(entry);
					if (!finishResult.ok) return;
					rememberReadingActivityToday();
				}
				if (!entry.title) return;
				try {
					if (status !== "finished") {
						const result = await saveShelfEntryWithRetry(entry);
						if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
					}
					setDropdownLabel(dropdown, status);
					setShelvedState(dropdown, true);
					showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
					removeCardFromShelfSection(dropdown, status);
					closeShelfMenus(shelfDropdowns);
					await refreshProfileReadingUiAfterMutation();
				} catch (error) {
					showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
				}
			});
		}
	}

	const journalPromptDismissKey = (bookId, currentPage) => `dogeared:progress-journal-prompt-dismissed:${bookId}:${currentPage}`;

	const isJournalProgressPromptDismissed = (bookId, currentPage) => {
		try {
			return window.sessionStorage?.getItem(journalPromptDismissKey(bookId, currentPage)) === "true";
		} catch {
			return false;
		}
	};

	const dismissJournalProgressPrompt = (bookId, currentPage) => {
		try {
			window.sessionStorage?.setItem(journalPromptDismissKey(bookId, currentPage), "true");
		} catch {
			// Dismissal is helpful session guidance, not required for progress saving.
		}
	};

	const resolveJournalProgressPromptAnchor = (bookId, fallback) => {
		const targetBookId = String(Math.max(0, Number(bookId || 0) || 0));
		const candidates = Array.from(document.querySelectorAll("[data-progress-journal-anchor]"));
		const card = candidates.find((candidate) => candidate instanceof HTMLElement && candidate.dataset.momentumBookId === targetBookId);
		if (card instanceof HTMLElement) {
			const controls = card.querySelector(".progress-inline-controls");
			if (controls instanceof HTMLElement) return controls;
			const saveButton = card.querySelector('[data-action="save-reading-progress"]');
			if (saveButton instanceof HTMLElement) return saveButton;
			return card;
		}
		if (fallback instanceof HTMLElement && document.documentElement.contains(fallback)) {
			const fallbackCard = fallback.closest(".book-card");
			if (fallbackCard instanceof HTMLElement && fallbackCard.dataset.momentumBookId === targetBookId) {
				const controls = fallbackCard.querySelector(".progress-inline-controls");
				if (controls instanceof HTMLElement) return controls;
				return fallbackCard;
			}
			return fallback;
		}
		return null;
	};

	const showJournalProgressPrompt = (card, bookId, currentPage, trigger) => {
		if (!(card instanceof HTMLElement) || !bookId) return;
		if (isJournalProgressPromptDismissed(bookId, currentPage)) return;
		const anchor = resolveJournalProgressPromptAnchor(bookId, trigger instanceof HTMLElement ? trigger : card);
		if (!(anchor instanceof HTMLElement)) return;
		const params = new URLSearchParams({
			bookId: String(bookId),
			readingPositionType: "page",
			readingPositionValue: String(currentPage)
		});
		window.dispatchEvent(new CustomEvent("dogeared:progress-journal-prompt", {
			detail: {
				anchor,
				trigger: trigger instanceof HTMLElement ? trigger : anchor,
				bookId,
				currentPage,
				bookTitle: card.dataset.momentumTitle || "",
				href: `/journal?${params.toString()}#new-entry`
			}
		}));
	};

	window.addEventListener("dogeared:progress-journal-prompt-dismissed", (event) => {
		const detail = event instanceof CustomEvent ? event.detail || {} : {};
		const bookId = Math.max(0, Number(detail.bookId || 0) || 0);
		const currentPage = Math.max(0, Number(detail.currentPage || 0) || 0);
		if (bookId && currentPage) dismissJournalProgressPrompt(bookId, currentPage);
	});

	document.addEventListener("click", async (event) => {
		const rawTarget = event.target;
		const target = rawTarget instanceof Element
			? rawTarget
			: (rawTarget instanceof Node ? rawTarget.parentElement : null);
		if (!(target instanceof HTMLElement)) return;
		const quickFinish = target.closest('[data-action="mark-finished-quick"]');
		if (quickFinish instanceof HTMLButtonElement) {
			event.preventDefault();
			event.stopPropagation();
			const card = quickFinish.closest(".book-card");
			const totalPages = resolveProgressTotalPages(quickFinish, card);
			const currentPageRaw = positiveDatasetNumber(quickFinish.dataset.currentPage);
			const readingFormat = normalizeReadingFormat(quickFinish.dataset.readingFormat || (card instanceof HTMLElement ? card.dataset.readingFormat : ""));
			const finishedPage = totalPages > 0 ? totalPages : currentPageRaw;
			const entry = buildShelfEntryFromRecord({
				bookId: Number(quickFinish.dataset.bookId || 0),
				title: String(quickFinish.dataset.title || "").trim(),
				author: String(quickFinish.dataset.author || "").trim(),
				description: String(quickFinish.dataset.description || "").trim(),
				pageCount: totalPages,
				coverUrl: String(quickFinish.dataset.cover || "").trim(),
				format: "Book",
				language: String(quickFinish.dataset.language || "").trim(),
				isbn10: String(quickFinish.dataset.isbn10 || "").trim(),
				isbn13: String(quickFinish.dataset.isbn13 || "").trim(),
				googleBooksId: String(quickFinish.dataset.googleBooksId || "").trim()
			}, {
				status: "finished",
				totalPages,
				currentPage: finishedPage,
				readingFormat,
				finishedDate: new Date().toISOString().slice(0, 10)
			});
			if (!entry.title) return;
			quickFinish.disabled = true;
			const dropdown = card?.querySelector(".shelf-dropdown");
			try {
				const finishResult = await promptAndSaveFinishedEntry(entry);
				if (!finishResult.ok) return;
				rememberReadingActivityToday();
				if (dropdown) {
					setDropdownLabel(dropdown, "finished");
					setShelvedState(dropdown, true);
					showShelfFeedback(dropdown, "Saved to Read.", feedbackTimers);
					removeCardFromShelfSection(dropdown, "finished");
				}
				await refreshProfileReadingUiAfterMutation();
			} catch (error) {
				if (dropdown) {
					showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
				} else {
					quickFinish.title = error instanceof Error ? error.message : "Failed to save.";
				}
			} finally {
				quickFinish.disabled = false;
			}
			return;
		}
		const progressSave = target.closest('[data-action="save-reading-progress"]');
		if (progressSave instanceof HTMLButtonElement) {
			event.preventDefault();
			event.stopPropagation();
			const card = progressSave.closest(".book-card");
			const input = card?.querySelector(".progress-inline-input");
			const progressTypeInput = card?.querySelector(".progress-inline-type");
			const readingFormatInput = card?.querySelector(".progress-inline-format");
			if (!(input instanceof HTMLInputElement)) return;
			const progressType = progressTypeInput instanceof HTMLSelectElement ? progressTypeInput.value : "page";
			const readingFormat = readingFormatInput instanceof HTMLSelectElement
				? normalizeReadingFormat(readingFormatInput.value)
				: normalizeReadingFormat(card instanceof HTMLElement ? card.dataset.readingFormat : "");
			const totalPages = resolveProgressTotalPages(progressSave, card);
			clearProgressSaveError(input);
			const parsed = normalizeProgressUpdateInput({
				rawValue: input.value,
				totalPages,
				progressType,
				allowMissingTotalPagesForPercent: true
			});
			if (!parsed.valid) {
				progressSave.textContent = "Save";
				surfaceProgressSaveError(input, "Enter a valid progress value.");
				return;
			}
			const currentPage = parsed.currentPage;
			const shouldFinish = totalPages > 0 && currentPage >= totalPages;
			if (shouldFinish) {
				const finishEntry = buildShelfEntryFromRecord({
					title: String(progressSave.dataset.title || "").trim(),
					author: String(progressSave.dataset.author || "").trim(),
					description: String(progressSave.dataset.description || "").trim(),
					pageCount: totalPages,
					coverUrl: String(progressSave.dataset.cover || "").trim(),
					format: "Book",
					language: String(progressSave.dataset.language || "").trim(),
					isbn10: String(progressSave.dataset.isbn10 || "").trim(),
					isbn13: String(progressSave.dataset.isbn13 || "").trim(),
					googleBooksId: String(progressSave.dataset.googleBooksId || "").trim()
				}, {
					status: "finished",
					totalPages,
					currentPage: totalPages,
					preferredProgressType: progressType,
					readingFormat,
					finishedDate: new Date().toISOString().slice(0, 10)
				});
				const directBookId = Math.max(0, Number(progressSave.dataset.bookId || 0) || 0);
				if (directBookId > 0) finishEntry.bookId = directBookId;
				if (!finishEntry.title) return;

				const card = progressSave.closest(".book-card");
				const dropdown = card?.querySelector(".shelf-dropdown");
				const originalLabel = progressSave.textContent || "Save";
				progressSave.disabled = true;
				progressSave.textContent = "Saving...";
				if (card instanceof HTMLElement) card.setAttribute("aria-busy", "true");
				try {
					const finishResult = await promptAndSaveFinishedEntry(finishEntry);
					if (!finishResult.ok) return;
					rememberReadingActivityToday();
					if (dropdown) {
						setDropdownLabel(dropdown, "finished");
						setShelvedState(dropdown, true);
						showShelfFeedback(dropdown, "Saved to Read.", feedbackTimers);
						removeCardFromShelfSection(dropdown, "finished");
					}
					await refreshProfileReadingUiAfterMutation();
				} catch (error) {
					const message = error instanceof Error ? error.message : "Failed to save progress.";
					console.error("[progress.save.request.failed]", {
						progressType,
						totalPages,
						currentPage,
						title: finishEntry.title,
						bookId: finishEntry.bookId || directBookId || 0,
						error: message
					});
					surfaceProgressSaveError(input, message);
					if (dropdown) {
						showShelfFeedback(dropdown, message, feedbackTimers);
					}
					progressSave.textContent = originalLabel;
				} finally {
					progressSave.disabled = false;
					if (card instanceof HTMLElement) card.setAttribute("aria-busy", "false");
				}
				return;
			}

			const directBookId = Math.max(0, Number(progressSave.dataset.bookId || 0) || 0);
			if (directBookId <= 0) {
				surfaceProgressSaveError(input, "Missing book id. Reload and try again.");
				return;
			}

			const originalLabel = progressSave.textContent || "Save";
			const dropdown = card?.querySelector(".shelf-dropdown");
			progressSave.disabled = true;
			progressSave.textContent = "Saving...";
			if (card instanceof HTMLElement) card.setAttribute("aria-busy", "true");
			let persisted = false;
			try {
				const result = await saveReadingProgressUpdate({
					bookId: directBookId,
					rawValue: input.value,
					currentPage,
					totalPages,
					preferredProgressType: progressType,
					readingFormat
				});
				if (!result.ok) throw new Error(result.message || "Failed to save progress.");
				persisted = true;
				try {
					const persistedProgress = result?.data && typeof result.data === "object"
						? (result.data.progress || null)
						: null;
					const nextTotalPages = Math.max(0, Number((persistedProgress && persistedProgress.totalPages) || totalPages || 0) || 0);
					const nextCurrentPage = Math.max(0, Number((persistedProgress && persistedProgress.currentPage) || currentPage || 0) || 0);
					const nextPreferredProgressType = String((persistedProgress && persistedProgress.preferredProgressType) || progressType || "page").trim() || "page";
					const nextReadingFormat = normalizeReadingFormat((persistedProgress && persistedProgress.readingFormat) || readingFormat);
					const previousCurrentPage = card instanceof HTMLElement
						? Math.max(0, Number(card.dataset.momentumCurrentPage || 0) || 0)
						: 0;
					const hasForwardProgress = Boolean(persistedProgress && persistedProgress.progressEventRecorded)
						|| nextCurrentPage > previousCurrentPage;
					const updatedAtValue = normalizePersistedDateValue(persistedProgress && persistedProgress.updatedAt) || new Date().toISOString();
					const persistedProgressUpdates = Math.max(0, Number(persistedProgress && persistedProgress.progressUpdates) || 0);
					ensureProgressDisplay(card, nextCurrentPage, nextTotalPages);
					const quickFinish = card?.querySelector('[data-action="mark-finished-quick"]');
					if (quickFinish instanceof HTMLButtonElement) {
						quickFinish.dataset.currentPage = String(nextCurrentPage);
						quickFinish.dataset.totalPages = String(nextTotalPages);
						quickFinish.dataset.readingFormat = nextReadingFormat;
					}
					if (card instanceof HTMLElement) {
						card.dataset.momentumCurrentPage = String(nextCurrentPage);
						card.dataset.momentumTotalPages = String(nextTotalPages);
						card.dataset.preferredProgressType = nextPreferredProgressType;
						updateReadingFormatUi(card, nextReadingFormat);
						card.dataset.momentumUpdatedAt = updatedAtValue;
						const priorUpdates = Math.max(0, Number(card.dataset.momentumProgressUpdates || 0) || 0);
						card.dataset.momentumProgressUpdates = String(persistedProgressUpdates > 0
							? persistedProgressUpdates
							: (hasForwardProgress ? priorUpdates + 1 : priorUpdates));
					}
					if (progressTypeInput instanceof HTMLSelectElement) {
						progressTypeInput.value = nextPreferredProgressType;
						updateProgressInputPlaceholder(progressTypeInput);
					}
					const appliedSummary = applyAuthoritativeReadingSummary(result?.data?.summary);
					if (appliedSummary) lastAuthoritativeReadingSummaryAt = Date.now();
					if (hasForwardProgress) rememberReadingActivityToday();
					notifyReadingDataChanged();
					const updatedLabel = safeFormatActivityDate(updatedAtValue);
					if (card instanceof HTMLElement) {
						card.dataset.updatedAt = updatedAtValue;
					}
					const dateNode = card?.querySelector(".activity-date");
					if (dateNode instanceof HTMLElement) {
						dateNode.textContent = `Updated ${updatedLabel}`;
					}
					if (hasForwardProgress && directBookId > 0) {
						showJournalProgressPrompt(card, directBookId, nextCurrentPage, progressSave);
					}
				} catch (uiError) {
					console.warn("Progress saved but local UI sync failed.", uiError);
				}
				input.value = "";
				clearProgressSaveError(input);
				progressSave.textContent = "Saved";
				setTimeout(() => {
					progressSave.textContent = originalLabel;
				}, 900);
			} catch (error) {
				const message = error instanceof Error ? error.message : "Failed to save progress.";
				console.warn("Failed to save reading progress.", error);
				surfaceProgressSaveError(input, message);
				if (dropdown) showShelfFeedback(dropdown, message, feedbackTimers);
				progressSave.textContent = persisted ? "Saved" : originalLabel;
				if (persisted) {
					setTimeout(() => {
						progressSave.textContent = originalLabel;
					}, 900);
				}
			} finally {
				progressSave.disabled = false;
				if (card instanceof HTMLElement) card.setAttribute("aria-busy", "false");
			}
			return;
		}
		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown) toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}
		const option = target.closest('[data-action="set-shelf"]');
		if (option) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = resolveShelfDropdownFromTarget(option);
			if (!dropdown) return;
			const status = option.dataset.status || "want_to_read";
			const entry = buildEntryFromDropdown(dropdown, status);
			if (!(await prepareReadingFormatForShelfStatus(entry, status))) return;
			if (status === "finished") {
				const finishResult = await promptAndSaveFinishedEntry(entry);
				if (!finishResult.ok) return;
				rememberReadingActivityToday();
			}
			if (!entry.title) return;
			try {
				if (status !== "finished") {
					const result = await saveShelfEntryWithRetry(entry);
					if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
				}
				setDropdownLabel(dropdown, status);
				setShelvedState(dropdown, true);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
				removeCardFromShelfSection(dropdown, status);
				closeShelfMenus(shelfDropdowns);
				await refreshProfileReadingUiAfterMutation();
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
			}
			return;
		}
		const assignOption = target.closest('[data-action="assign-custom-shelf"]');
		if (assignOption) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = resolveShelfDropdownFromTarget(assignOption);
			if (!(dropdown instanceof HTMLElement)) return;
			const shelfId = Math.max(0, Number(assignOption.getAttribute("data-shelf-id") || 0) || 0);
			const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
			if (!shelfId || !bookId) return;
			try {
				const result = await assignBookToCustomShelf(shelfId, bookId);
				if (!result.ok) throw new Error(String(result.data?.error || "Failed to assign custom shelf."));
				showShelfFeedback(dropdown, "Saved to custom shelf.", feedbackTimers);
				closeShelfMenus(shelfDropdowns);
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
			}
			return;
		}
		const removeOption = target.closest('[data-action="remove-from-shelves"]');
		if (removeOption) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = resolveShelfDropdownFromTarget(removeOption);
			if (!(dropdown instanceof HTMLElement)) return;
			const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
			const entry = buildEntryFromDropdown(dropdown, "want_to_read");
			try {
				const result = await removeBookFromAllShelves(bookId, entry);
				if (!result.ok) throw new Error(resolveShelfRemoveMessage(result));
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
				showShelfFeedback(dropdown, "Removed from shelves.", feedbackTimers);
				removeCardFromShelfSection(dropdown, "remove");
				closeShelfMenus(shelfDropdowns);
				await refreshProfileReadingUiAfterMutation();
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to remove.", feedbackTimers);
			}
			return;
		}
		if (isShelfDropdownOrMenuTarget(target)) return;
		closeShelfMenus(shelfDropdowns);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Enter") return;
		const target = event.target;
		if (!(target instanceof HTMLInputElement)) return;
		if (!target.classList.contains("progress-inline-input")) return;
		event.preventDefault();
		const card = target.closest(".book-card");
		if (!(card instanceof HTMLElement)) return;
		const saveButton = card.querySelector('[data-action="save-reading-progress"]');
		if (!(saveButton instanceof HTMLButtonElement)) return;
		if (saveButton.disabled) return;
		saveButton.click();
	});

	customShelfCreateForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!(customShelfCreateForm instanceof HTMLFormElement)) return;
		const input = customShelfCreateForm.querySelector('input[name="name"]');
		const iconInput = customShelfCreateForm.querySelector('select[name="icon"]');
		if (!(input instanceof HTMLInputElement)) return;
		const name = String(input.value || "").trim();
		const icon = iconInput instanceof HTMLSelectElement ? String(iconInput.value || "").trim() : "";
		if (!name) return;
		input.disabled = true;
		if (iconInput instanceof HTMLSelectElement) iconInput.disabled = true;
		setCustomShelfFeedback("Creating...");
		try {
			const result = await createCustomShelf(name, icon);
			if (!result.ok) throw new Error(String(result.data?.error || "Failed to create shelf."));
			window.location.reload();
		} catch (error) {
			setCustomShelfFeedback(error instanceof Error ? error.message : "Failed to create shelf.", true);
			input.disabled = false;
			if (iconInput instanceof HTMLSelectElement) iconInput.disabled = false;
