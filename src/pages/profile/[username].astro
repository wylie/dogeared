	function parseProgressInput(rawValue, totalPages) {
		const raw = String(rawValue || "").trim();
		if (!raw) return { valid: false, currentPage: 0, mode: "page", normalizedText: "" };
		const maxPages = Math.max(0, Number(totalPages || 0) || 0);
		if (raw.endsWith("%")) {
			const percentValue = Number(raw.slice(0, -1).trim());
			if (!Number.isFinite(percentValue)) return { valid: false, currentPage: 0, mode: "percent", normalizedText: raw };
			const clampedPercent = Math.max(0, Math.min(100, percentValue));
			const currentPage = maxPages > 0
				? Math.round((clampedPercent / 100) * maxPages)
				: 0;
			return {
				valid: true,
				currentPage,
				mode: "percent",
				normalizedText: `${clampedPercent}%`,
				percent: clampedPercent
			};
		}
		const numericPages = Number(raw);
		if (!Number.isFinite(numericPages)) return { valid: false, currentPage: 0, mode: "page", normalizedText: raw };
		const currentPage = Math.max(0, Math.min(maxPages > 0 ? maxPages : Number.MAX_SAFE_INTEGER, Math.round(numericPages)));
		return {
			valid: true,
			currentPage,
			mode: "page",
			normalizedText: String(currentPage)
		};
	}

	function safeFormatActivityDate(value) {
		const parsed = new Date(String(value || "").trim());
		if (!Number.isFinite(parsed.getTime())) return "";
		return parsed.toLocaleDateString("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric"
		});
	}

