<script>
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		isShelfDropdownOrMenuTarget,
		removeBookFromAllShelvesOnServer,
		resolveShelfDropdownFromTarget,
		resolveShelfRemoveMessage,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		prepareReadingFormatForShelfStatus,
		notifyReadingDataChanged,
		toggleShelfMenu,
		initRatingControls
	} from "../../lib/shelfClient.ts";
	import {
		loadShelfEntries,
		migrateShelfEntriesInPlace
	} from "../../lib/shelfStorage.ts";
	import { normalizeProgressUpdateInput } from "../../lib/readingProgress.ts";
	import { normalizeReadingFormat } from "../../lib/readingFormats.ts";
	const followToggle = document.getElementById("follow-toggle");
	const followFeedback = document.getElementById("follow-feedback");
	const dismissWelcomeBanner = document.getElementById("dismiss-welcome-banner");
	const followersCountNode = document.getElementById("follow-count-followers");
	const followingCountNode = document.getElementById("follow-count-following");
	const profilePageRoot = document.querySelector(".public-profile-page");
	const customShelfFeedback = document.querySelector("[data-custom-shelf-feedback]");
	const customShelfCreateForm = document.querySelector("[data-custom-shelf-create]");
	const createCustomShelfModal = document.querySelector("[data-create-custom-shelf-modal]");
	const profileActionsMenu = document.querySelector("[data-profile-actions-menu]");
	const avatarUrlInput = document.querySelector('input[name="avatarUrl"]');
	const avatarFileInput = document.querySelector("[data-avatar-file]");
	const momentumPanel = document.querySelector("[data-momentum-panel]");
	const momentumHelp = document.querySelector(".momentum-help");
	const momentumHelpTrigger = document.querySelector(".momentum-help-trigger");
	const momentumHelpTooltip = document.querySelector(".momentum-help-tooltip");
	const momentumScoreNode = document.querySelector("[data-momentum-score]");
	const momentumStreakNode = document.querySelector("[data-momentum-streak]");
	const momentumStreakUnitNode = document.querySelector("[data-momentum-streak-unit]");
	const momentumNextActionNode = document.querySelector("[data-momentum-next-action]");
	const RECENT_ACTIVITY_SECTION_KEY = "recent:activity";
	const REVIEWS_SECTION_KEY = "reviews:section";
	const shelfSectionNodes = Array.from(document.querySelectorAll("[data-shelf-section-key]"));
	let readingStreakDayKeys = (() => {
		try {
			const raw = String(profilePageRoot?.getAttribute("data-reading-streak-days") || "[]");
			const parsed = JSON.parse(raw);
			return new Set(Array.isArray(parsed) ? parsed.map((item) => String(item || "").trim().slice(0, 10)).filter(Boolean) : []);
		} catch {
			return new Set();
		}
	})();
	let shelfSectionOrder = (() => {
		try {
			const raw = String(profilePageRoot?.getAttribute("data-shelf-section-order") || "[]");
			const parsed = JSON.parse(raw);
			return Array.isArray(parsed) ? parsed.map((item) => String(item || "").trim()).filter(Boolean) : [];
		} catch {
			return [];
		}
	})();
	const shelfOrderStorageKey = `dogeared:shelf-order:${String(window.location.pathname || "").toLowerCase()}`;
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const feedbackTimers = new WeakMap();
	initRatingControls();

	function loadStoredShelfSectionOrder() {
		try {
			const raw = localStorage.getItem(shelfOrderStorageKey);
			if (!raw) return [];
			const parsed = JSON.parse(raw);
			return Array.isArray(parsed) ? parsed.map((item) => String(item || "").trim()).filter(Boolean) : [];
		} catch {
			return [];
		}
	}

	function saveStoredShelfSectionOrder(orderKeys) {
		try {
			localStorage.setItem(shelfOrderStorageKey, JSON.stringify(orderKeys));
		} catch {
			// Ignore storage errors.
		}
	}

	function mergeStoredProfileSectionOrder(storedOrder, liveKeys) {
		const knownKeys = new Set(liveKeys);
		const deduped = Array.from(new Set(
			(Array.isArray(storedOrder) ? storedOrder : [])
				.map((key) => String(key || "").trim())
				.filter((key) => knownKeys.has(key))
		));
		if (knownKeys.has(RECENT_ACTIVITY_SECTION_KEY) && !deduped.includes(RECENT_ACTIVITY_SECTION_KEY)) {
			const readingIndex = deduped.indexOf("default:reading");
			if (readingIndex >= 0) deduped.splice(readingIndex + 1, 0, RECENT_ACTIVITY_SECTION_KEY);
			else deduped.unshift(RECENT_ACTIVITY_SECTION_KEY);
		}
		if (knownKeys.has(REVIEWS_SECTION_KEY) && !deduped.includes(REVIEWS_SECTION_KEY)) {
			const recentIndex = deduped.indexOf(RECENT_ACTIVITY_SECTION_KEY);
			if (recentIndex >= 0) deduped.splice(recentIndex + 1, 0, REVIEWS_SECTION_KEY);
			else deduped.push(REVIEWS_SECTION_KEY);
		}
		return deduped;
	}

	function orderedShelfSectionKeys(orderKeys) {
		const liveKeys = shelfSectionNodes
			.map((node) => String(node.getAttribute("data-shelf-section-key") || "").trim())
			.filter(Boolean);
		const deduped = Array.from(new Set(
			(Array.isArray(orderKeys) ? orderKeys : [])
				.map((key) => String(key || "").trim())
				.filter((key) => liveKeys.includes(key))
		));
		return [
			...deduped,
			...liveKeys.filter((key) => !deduped.includes(key))
		];
	}

	function updateShelfSectionMoveControls(orderKeys = shelfSectionOrder) {
		const orderedKeys = orderedShelfSectionKeys(orderKeys);
		for (const node of shelfSectionNodes) {
			if (!(node instanceof HTMLElement)) continue;
			const key = String(node.getAttribute("data-shelf-section-key") || "").trim();
			const index = orderedKeys.indexOf(key);
			const upButton = node.querySelector('[data-action="move-shelf-section-up"]');
			const downButton = node.querySelector('[data-action="move-shelf-section-down"]');
			const canMoveUp = index > 0;
			const canMoveDown = index >= 0 && index < orderedKeys.length - 1;
			if (upButton instanceof HTMLButtonElement) {
				upButton.disabled = !canMoveUp;
				upButton.setAttribute("aria-disabled", canMoveUp ? "false" : "true");
			}
			if (downButton instanceof HTMLButtonElement) {
				downButton.disabled = !canMoveDown;
				downButton.setAttribute("aria-disabled", canMoveDown ? "false" : "true");
			}
		}
	}

	function applyShelfSectionOrderToDom(orderKeys) {
		const normalizedOrder = orderedShelfSectionKeys(orderKeys);
		const lookup = new Map(normalizedOrder.map((key, index) => [String(key || "").trim(), index]));
		for (const node of shelfSectionNodes) {
			if (!(node instanceof HTMLElement)) continue;
			const key = String(node.getAttribute("data-shelf-section-key") || "").trim();
			const position = lookup.has(key) ? Number(lookup.get(key)) : 999;
			node.style.order = String(300 + position);
		}
		if (profilePageRoot instanceof HTMLElement) {
			const orderedNodes = normalizedOrder
				.map((key) => shelfSectionNodes.find((node) => String(node.getAttribute("data-shelf-section-key") || "").trim() === key))
				.filter((node) => node instanceof HTMLElement);
			for (const node of orderedNodes) {
				profilePageRoot.append(node);
			}
		}
		updateShelfSectionMoveControls(normalizedOrder);
	}

	function syncLeftNavShelfOrder(orderKeys) {
		const order = Array.isArray(orderKeys) ? orderKeys.map((item) => String(item || "").trim()).filter(Boolean) : [];
		if (order.length === 0) return;
		const sectionIdByKey = new Map();
		const sectionLabelById = new Map();
		for (const node of shelfSectionNodes) {
			if (!(node instanceof HTMLElement)) continue;
			const key = String(node.getAttribute("data-shelf-section-key") || "").trim();
			const id = String(node.id || "").trim();
			if (!key || !id) continue;
			sectionIdByKey.set(key, id);
			const heading = node.querySelector("h2, h3");
			const label = String(heading?.textContent || "").replace(/\s+/g, " ").trim();
			if (label) sectionLabelById.set(id, label);
		}
		const orderedSectionIds = order
			.map((key) => String(sectionIdByKey.get(key) || "").trim())
			.filter(Boolean);
		if (orderedSectionIds.length === 0) return;
		const movableIdSet = new Set(orderedSectionIds);
		const profileSectionList = document.querySelector("#left-hand-profile-item .section-links-nested");
		if (!(profileSectionList instanceof HTMLElement)) return;
		const existingItems = Array.from(profileSectionList.querySelectorAll(":scope > li"));
		const itemsById = new Map();
		for (const li of existingItems) {
			if (!(li instanceof HTMLElement)) continue;
			const link = li.querySelector("[data-section-link]");
			const linkId = String(link?.getAttribute("data-section-link") || "").trim();
			if (linkId) itemsById.set(linkId, li);
		}
		for (const id of orderedSectionIds) {
			if (itemsById.has(id)) continue;
			const li = document.createElement("li");
			const anchor = document.createElement("a");
			anchor.href = `#${id}`;
			anchor.className = "hover";
			anchor.setAttribute("data-section-link", id);
			anchor.textContent = sectionLabelById.get(id) || id;
			li.append(anchor);
			itemsById.set(id, li);
		}
		const existingMovable = existingItems.filter((li) => {
			const link = li.querySelector("[data-section-link]");
			const id = String(link?.getAttribute("data-section-link") || "").trim();
			return movableIdSet.has(id);
		});
		for (const li of existingMovable) li.remove();
		const firstStatic = profileSectionList.querySelector(":scope > li");
		const fragment = document.createDocumentFragment();
		for (const id of orderedSectionIds) {
			const item = itemsById.get(id);
			if (item) fragment.append(item);
		}
		if (firstStatic) profileSectionList.append(fragment);
		else profileSectionList.append(fragment);
	}

	dismissWelcomeBanner?.addEventListener("click", () => {
		const url = new URL(window.location.href);
		url.searchParams.delete("welcome");
		const next = `${url.pathname}${url.searchParams.toString() ? `?${url.searchParams.toString()}` : ""}${url.hash}`;
		window.history.replaceState({}, "", next);
		const banner = dismissWelcomeBanner.closest(".welcome-banner");
		if (banner instanceof HTMLElement) banner.hidden = true;
	});

	function normalizeText(value) {
		return String(value || "").trim().toLowerCase();
	}

	function canonicalizeTitle(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/\([^)]*\)/g, " ")
			.replace(/\b(abridged|unabridged|audio ?book|audiobook|kindle edition|paperback|hardcover|ebook|e-book|digital edition|color edition)\b/g, " ")
			.split(":")[0]
			.replace(/^(the|a|an)\s+/g, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function canonicalizeAuthor(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/^(by\s+)/, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function findEntry(entries, input) {
		const bookId = Number(input?.bookId || 0);
		if (bookId > 0) {
			const byBookId = entries.find((entry) => Number(entry?.bookId || 0) === bookId);
			if (byBookId) return byBookId;
		}
		const isbn13 = normalizeText(input?.isbn13 || "");
		const isbn10 = normalizeText(input?.isbn10 || "");
		const googleBooksId = normalizeText(input?.googleBooksId || "");
		if (isbn13 || isbn10 || googleBooksId) {
			const byIdentifier = entries.find((entry) => {
				const entryIsbn13 = normalizeText(entry?.isbn13 || "");
				const entryIsbn10 = normalizeText(entry?.isbn10 || "");
				const entryGoogleBooksId = normalizeText(entry?.googleBooksId || "");
				if (isbn13 && entryIsbn13 && isbn13 === entryIsbn13) return true;
				if (isbn10 && entryIsbn10 && isbn10 === entryIsbn10) return true;
				if (googleBooksId && entryGoogleBooksId && googleBooksId === entryGoogleBooksId) return true;
				return false;
			});
			if (byIdentifier) return byIdentifier;
		}
		const t = canonicalizeTitle(input?.title || "");
		const a = canonicalizeAuthor(input?.author || "");
		return entries.find((entry) => (
			canonicalizeTitle(entry?.title) === t && canonicalizeAuthor(entry?.author) === a
		));
	}

	function syncExistingState() {
		const entries = loadShelfEntries();
		for (const dropdown of shelfDropdowns) {
			const seededStatus = String(dropdown.dataset.initialStatus || "").trim();
			let appliedSeed = false;
			if (seededStatus === "want_to_read" || seededStatus === "reading" || seededStatus === "finished") {
				setDropdownLabel(dropdown, seededStatus);
				setShelvedState(dropdown, true);
				appliedSeed = true;
			}
			const existing = findEntry(entries, {
				bookId: Number(dropdown.dataset.bookId || 0),
				title: String(dropdown.dataset.title || ""),
				author: String(dropdown.dataset.author || ""),
				isbn10: String(dropdown.dataset.isbn10 || ""),
				isbn13: String(dropdown.dataset.isbn13 || ""),
				googleBooksId: String(dropdown.dataset.googleBooksId || "")
			});
			if (existing) {
				if (appliedSeed) continue;
				setDropdownLabel(dropdown, String(existing.status || ""));
				setShelvedState(dropdown, true);
			} else if (!appliedSeed) {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
		}
	}

	function rememberReadingActivityToday() {
		const today = new Date().toISOString().slice(0, 10);
		readingStreakDayKeys.add(today);
		if (profilePageRoot instanceof HTMLElement) {
			profilePageRoot.setAttribute("data-reading-streak-days", JSON.stringify(Array.from(readingStreakDayKeys)));
		}
	}

	function pulseMetricNode(node) {
		if (!(node instanceof HTMLElement)) return;
		if (window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches) return;
		node.classList.remove("is-updating");
		window.requestAnimationFrame(() => {
			node.classList.add("is-updating");
			window.setTimeout(() => {
				node.classList.remove("is-updating");
			}, 260);
		});
	}

	function setNodeText(node, value, options = {}) {
		if (!(node instanceof HTMLElement)) return;
		const nextValue = String(value);
		if (node.textContent === nextValue) return;
		node.textContent = nextValue;
		if (options?.animate) pulseMetricNode(node);
	}

	function updateMomentumStreakDisplay(streak) {
		const nextStreak = Math.max(0, Number(streak || 0) || 0);
		setNodeText(momentumStreakNode, String(nextStreak), { animate: true });
		setNodeText(momentumStreakUnitNode, nextStreak === 1 ? "day" : "days");
	}

	function momentumCardSelector(bookId) {
		const raw = String(Math.max(0, Number(bookId || 0) || 0));
		const escaped = window.CSS?.escape ? window.CSS.escape(raw) : raw.replace(/"/g, '\\"');
		return `[data-momentum-book-id="${escaped}"]`;
	}

	function applyAuthoritativeMomentumBook(card, book, momentum) {
		if (!(card instanceof HTMLElement) || !book || typeof book !== "object") return;
		const currentPage = Math.max(0, Number(book.currentPage || momentum?.currentPage || 0) || 0);
		const totalPages = Math.max(0, Number(book.totalPages || momentum?.totalPages || 0) || 0);
		const updatedAt = normalizePersistedDateValue(book.updatedAt || "");
		const progressUpdates = Math.max(0, Number(book.progressUpdates || momentum?.progressUpdateCount || 0) || 0);
		const readingFormat = updateReadingFormatUi(card, book.readingFormat || momentum?.readingFormat || card.dataset.readingFormat || "unknown");
		card.dataset.momentumCurrentPage = String(currentPage);
		card.dataset.momentumTotalPages = String(totalPages);
		if (updatedAt) {
			card.dataset.momentumUpdatedAt = updatedAt;
			card.dataset.updatedAt = updatedAt;
		}
		card.dataset.momentumProgressUpdates = String(progressUpdates);
		ensureProgressDisplay(card, currentPage, totalPages);
		const quickFinish = card.querySelector('[data-action="mark-finished-quick"]');
		if (quickFinish instanceof HTMLButtonElement) {
			quickFinish.dataset.currentPage = String(currentPage);
			quickFinish.dataset.totalPages = String(totalPages);
			quickFinish.dataset.readingFormat = readingFormat;
		}
		const dateNode = card.querySelector(".activity-date");
		if (dateNode instanceof HTMLElement && updatedAt) {
			dateNode.textContent = `Updated ${safeFormatActivityDate(updatedAt)}`;
		}
		const healthNode = card.querySelector(".momentum-health");
		if (healthNode instanceof HTMLElement && momentum && typeof momentum === "object") {
			healthNode.classList.remove("momentum-health-good", "momentum-health-neutral");
			const tone = String(momentum.healthTone || "neutral") === "good" ? "good" : "neutral";
			healthNode.classList.add(`momentum-health-${tone}`);
			if (momentum.predictionEligible) {
				healthNode.hidden = false;
				healthNode.textContent = `${momentum.healthLabel || ""} · ${momentum.momentumMessage || ""}`.trim();
			} else if (momentum.showOnboardingStatus) {
				healthNode.hidden = false;
				healthNode.textContent = String(momentum.onboardingMessage || momentum.healthLabel || "");
			} else {
				healthNode.hidden = true;
				healthNode.textContent = "";
			}
		}
	}

	function applyAuthoritativeReadingSummary(summary) {
		if (!summary || typeof summary !== "object") return false;
		const nextDateKeys = Array.isArray(summary.readingStreakDateKeys)
			? summary.readingStreakDateKeys.map((key) => String(key || "").trim().slice(0, 10)).filter(Boolean)
			: [];
		readingStreakDayKeys = new Set(nextDateKeys);
		if (profilePageRoot instanceof HTMLElement) {
			profilePageRoot.setAttribute("data-reading-streak-days", JSON.stringify(nextDateKeys));
		}
		setNodeText(momentumScoreNode, String(Math.max(0, Number(summary.momentumScore || 0) || 0)), { animate: true });
		updateMomentumStreakDisplay(summary.readingStreakDays);
		setNodeText(
			momentumNextActionNode,
			String(summary.momentumNextAction || "Add a few progress updates and DogEared will start estimating reading momentum.")
		);
		const books = Array.isArray(summary.currentlyReading) ? summary.currentlyReading : [];
		const momentumBooks = Array.isArray(summary.momentumBooks) ? summary.momentumBooks : [];
		const bookById = new Map(books.map((book) => [Math.max(0, Number(book?.bookId || 0) || 0), book]));
		for (const momentum of momentumBooks) {
			const bookId = Math.max(0, Number(momentum?.bookId || 0) || 0);
			if (!bookId) continue;
			const card = document.querySelector(momentumCardSelector(bookId));
			applyAuthoritativeMomentumBook(card, bookById.get(bookId) || momentum, momentum);
		}
		return true;
	}

	let authoritativeReadingSummaryPromise = null;
	let lastAuthoritativeReadingSummaryAt = 0;
	async function refreshAuthoritativeReadingSummary(options = {}) {
		if (!(momentumPanel instanceof HTMLElement)) return false;
		const force = options?.force === true;
		const now = Date.now();
		if (!force && now - lastAuthoritativeReadingSummaryAt < 1200) return true;
		if (authoritativeReadingSummaryPromise) return authoritativeReadingSummaryPromise;
		authoritativeReadingSummaryPromise = (async () => {
			try {
				const response = await fetch("/api/reading/summary", {
					credentials: "same-origin",
					cache: "no-store",
					headers: { "Accept": "application/json" }
				});
				if (!response.ok) return false;
				const data = await response.json().catch(() => ({}));
				const applied = applyAuthoritativeReadingSummary(data?.summary);
				if (applied) lastAuthoritativeReadingSummaryAt = Date.now();
				return applied;
			} catch {
				return false;
			} finally {
				authoritativeReadingSummaryPromise = null;
			}
		})();
		return authoritativeReadingSummaryPromise;
	}

	async function refreshProfileSummarySectionsFromServer() {
		try {
			const response = await fetch(window.location.href, {
				credentials: "same-origin",
				cache: "no-store",
				headers: { "X-Dogeared-Partial": "profile-reading-summary" }
			});
			if (!response.ok) return false;
			const html = await response.text();
			const doc = new DOMParser().parseFromString(html, "text/html");
			const sectionIds = ["reading-goal", "shelf-summary"];
			let replaced = false;
			for (const id of sectionIds) {
				const current = document.getElementById(id);
				const next = doc.getElementById(id);
				if (current instanceof HTMLElement && next instanceof HTMLElement) {
					current.replaceWith(next);
					replaced = true;
				}
			}
			return replaced;
		} catch {
			return false;
		}
	}

	async function refreshProfileReadingUiAfterMutation(options = {}) {
		const shouldHydrate = options?.hydrate !== false;
		const shouldNotify = options?.notify !== false;
		if (shouldHydrate) {
			await hydrateShelfEntriesFromServer();
			syncExistingState();
		}
		await refreshAuthoritativeReadingSummary({ force: true });
		await refreshProfileSummarySectionsFromServer();
		if (shouldNotify && typeof window.dispatchEvent === "function" && typeof CustomEvent === "function") {
			window.dispatchEvent(new CustomEvent("dogeared:reading-data-changed"));
		}
	}

	async function saveReadingProgressUpdate(input) {
		const response = await fetch("/api/reading/progress", {
			method: "POST",
			credentials: "same-origin",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(input)
		});
		if (response.status === 401) {
			window.location.href = "/settings#account-settings";
			return { ok: false, unauthorized: true, response, data: null, message: "Please log in to save progress." };
		}
		const data = await response.json().catch(() => ({}));
		if (!response.ok) {
			return {
				ok: false,
				unauthorized: false,
				response,
				data,
				message: String(data?.detail || data?.error || "Failed to save progress.").trim()
			};
		}
		return { ok: true, unauthorized: false, response, data, message: "" };
	}


