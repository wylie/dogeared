	avatarFileInput?.addEventListener("change", async () => {
		if (!(avatarFileInput instanceof HTMLInputElement)) return;
		if (!(avatarUrlInput instanceof HTMLInputElement)) return;
		const file = avatarFileInput.files?.[0];
		if (!file) return;
		const maxBytes = 1024 * 1024 * 2;
		if (file.size > maxBytes) {
			window.alert("Please choose an image under 2MB.");
			avatarFileInput.value = "";
			return;
		}
		try {
			const reader = new FileReader();
			const dataUrl = await new Promise((resolve, reject) => {
				reader.onload = () => resolve(String(reader.result || ""));
				reader.onerror = () => reject(new Error("Failed to read image."));
				reader.readAsDataURL(file);
			});
			avatarUrlInput.value = String(dataUrl || "");
		} catch {
			window.alert("Failed to load avatar image.");
