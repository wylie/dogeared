<Layout
	title={profile.username ? `${profile.username} • Profile` : "Profile"}
	sectionLinks={sectionLinks}
	metaDescription={profileDescription}
	canonicalUrl={profileCanonicalUrl}
	robots={profileRobots}
	structuredData={profileStructuredDataPayload}
>
	<div
		slot="right"
		class="public-profile-page"
		data-authenticated={String(isAuthenticated)}
		data-shelf-section-order={shelfSectionOrderJson}
		data-reading-streak-days={JSON.stringify(readingStreakDateKeys)}
	>
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			{profile.username ? (
				<>
					<a href="/profile">Profile</a>
					<span aria-hidden="true">/</span>
					<span>@{profile.username}</span>
				</>
			) : <span>Profile</span>}
		</nav>
		{notFound && (
			<section class="state-card">
				<h1>Profile not found</h1>
				<p>That username does not exist.</p>
			</section>
		)}
		{!notFound && privateProfile && (
			<section class="state-card">
				<h1>@{requestedUsername}</h1>
				<p>This profile is private.</p>
			</section>
		)}
		{!notFound && !privateProfile && (
			<>
				{showWelcomeBanner && (
					<section class="welcome-banner" role="status" aria-live="polite">
						<p><strong>Welcome to Dogeared.</strong> Your account setup is complete and your profile is live.</p>
						<a id="dismiss-welcome-banner" class="welcome-banner-dismiss" href={dismissWelcomeUrl}>Dismiss</a>
					</section>
				)}
				{isOwnerViewer && (
					<section id="notifications" class={`activity-card activity-card-plain notifications-card${notifications.length === 0 ? " notifications-card-empty" : ""}`}>
						<div class="notifications-head">
							<h2>Notifications</h2>
							<div class="notifications-actions">
								{notifications.some((item) => !item.readAt) && (
									<form method="post" action={`/profile/${encodeURIComponent(profile.username)}#notifications`}>
										<input type="hidden" name="notificationIntent" value="mark_all_read" />
										<button type="submit" class="owner-edit-link">Mark all read</button>
									</form>
								)}
								{notifications.length > 0 && (
									<form method="post" action={`/profile/${encodeURIComponent(profile.username)}#notifications`}>
										<input type="hidden" name="notificationIntent" value="clear_all" />
										<button type="submit" class="owner-edit-link owner-edit-link-muted">Clear all</button>
									</form>
								)}
