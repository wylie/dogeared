								<select name="review_filter">
									<option value="all" selected={reviewFilter === "all"}>All reviews</option>
									<option value="no_spoilers" selected={reviewFilter === "no_spoilers"}>No spoilers</option>
									<option value="spoilers" selected={reviewFilter === "spoilers"}>Spoilers</option>
								</select>
							</label>
							<button type="submit" class="secondary">Apply</button>
						</form>
						{profileReviews.length === 0 ? (
							<div class="profile-review-empty">
								<p>No reviews yet. Reviews help other readers decide what to read.</p>
								{isOwnerViewer && <a href="#read">Write your first review</a>}
							</div>
						) : (
							<ul class="profile-review-list">
								{profileReviews.map((item) => (
									<li class="profile-review-card">
										<a class="profile-review-book" href={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}#reviews`}>{item.title}</a>
										<p class="profile-review-meta">
											{item.author && <span>{item.author}</span>}
											{item.rating > 0 && <span>{renderRatingStars(item.rating)} {item.rating}/5</span>}
											<span>{formatActivityDate(item.reviewUpdatedAt || item.updatedAt)}</span>
											{item.reviewSpoiler && <span>Spoilers</span>}
										</p>
										{item.reviewTitle && <h3>{item.reviewTitle}</h3>}
										{item.reviewBody && <p>{item.reviewBody.length > 360 ? `${item.reviewBody.slice(0, 360).trim()}...` : item.reviewBody}</p>}
									</li>
								))}
							</ul>
						)}
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && (
					<section
						id="currently-reading"
						class="activity-card activity-card-plain currently-reading-section"
						data-shelf-section-key="default:reading"
						style={shelfSectionOrderStyle("default:reading")}
					>
						<div class="custom-shelf-heading-row">
							<h2><span class="material-icons custom-shelf-heading-icon default-shelf-heading-icon" aria-hidden="true">menu_book</span>Currently Reading</h2>
							{isOwnerViewer && (
								<div class="custom-shelf-menu-wrap">
									<button type="button" class="custom-shelf-menu-trigger" data-action="toggle-custom-shelf-menu" aria-expanded="false" aria-label="Actions for Currently Reading">
										<span class="material-icons" aria-hidden="true">more_vert</span>
									</button>
									<div class="custom-shelf-menu" hidden>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up" {...shelfSectionMoveAttrs("default:reading", "up")}>Move up</button>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down" {...shelfSectionMoveAttrs("default:reading", "down")}>Move down</button>
									</div>
								</div>
							)}
						</div>
						{isOwnerViewer && (
							<div class="momentum-panel" data-momentum-panel>
								<div class="momentum-stat">
									<div class="momentum-stat-label momentum-stat-label-with-help">
										<span>Momentum Score</span>
										<span class="momentum-help">
											<button
												type="button"
												class="momentum-help-trigger"
												aria-label="How momentum score works"
												aria-expanded="false"
												aria-controls="momentum-help-tooltip"
											>
												<span class="material-icons" aria-hidden="true">info_outline</span>
											</button>
											<div id="momentum-help-tooltip" class="momentum-help-tooltip" role="tooltip">
												<p><strong>How this score moves:</strong> It averages books with enough reading history, based on progress and recency.</p>
												<p><strong>When estimates appear:</strong> after more than one progress update and enough pages read.</p>
												<p><strong>Early stage:</strong> new books show guidance instead of momentum predictions.</p>
											</div>
										</span>
									</div>
									<p class="momentum-stat-value"><span data-momentum-score>{momentumScore}</span><span class="momentum-stat-scale">/100</span></p>
								</div>
								<div class="momentum-stat">
									<p class="momentum-stat-label">Reading Streak</p>
									<p class="momentum-stat-value"><span data-momentum-streak>{momentumStreakDays}</span> <span data-momentum-streak-unit>day{momentumStreakDays === 1 ? "" : "s"}</span></p>
								</div>
								<div class="momentum-next" data-momentum-next-action>
									{momentumNextAction || "Add progress to keep momentum moving."}
								</div>
							</div>
						)}
						{pagedReading.items.length === 0 ? (
							<div class="profile-empty-state">
								<p>No books are currently marked as Currently Reading. Move a book here to track progress after each reading session.</p>
								{isOwnerViewer && <a href="/search">Find a book to start</a>}
							</div>
						) : (
							<ul class="activity-grid currently-reading-grid">
								{pagedReading.items.map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
										readingFormat={item.readingFormat}
									thumbnail={item.thumbnail}
									readers={1}
									shelfEntries={1}
									genres={item.genres}
									attrs={{
											"data-momentum-reading-item": "true",
											"data-progress-journal-anchor": "true",
											"data-momentum-book-id": String(item.bookId || 0),
											"data-momentum-title": item.title,
											"data-momentum-current-page": String(Math.max(0, Number(item.currentPage || 0))),
											"data-momentum-total-pages": String(Math.max(0, Number(item.totalPages || 0))),
											"data-preferred-progress-type": item.preferredProgressType || "page",
											"data-reading-format": item.readingFormat || "unknown",
											"data-momentum-updated-at": item.updatedAt,
											"data-momentum-first-added-at": item.firstAddedAt || item.updatedAt,
											"data-momentum-progress-updates": String(Math.max(0, Number(item.progressUpdates || 0)))
										}}
									>
										<p slot="preTitle" class="meta activity-headline">
											<span class="activity-prefix">Currently Reading</span>
											{formatActivityDate(item.updatedAt) && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="meta" class="reading-progress-block">
											{item.totalPages > 0 && (
												<>
													<p class="meta progress-current-value">
														Progress: {item.currentPage}/{item.totalPages} pages ({Math.max(0, Math.min(100, Math.round((item.currentPage / Math.max(1, item.totalPages)) * 100)))}%)
													</p>
													<div class="progress-track progress-bar-track" aria-hidden="true">
														<div
															class="progress-fill progress-bar-fill"
															style={`width:${Math.max(0, Math.min(100, Math.round((item.currentPage / Math.max(1, item.totalPages)) * 100)))}%`}
														></div>
													</div>
												</>
											)}
											{(() => {
												const momentum = momentumByBookId.get(item.bookId);
												if (!momentum) return <p class="momentum-health momentum-health-neutral" hidden></p>;
												if (!momentum.predictionEligible) {
													return (
														<p class="momentum-health momentum-health-neutral" hidden={!momentum.showOnboardingStatus}>
															{momentum.onboardingMessage}
														</p>
													);
												}
												return (
													<p class={`momentum-health momentum-health-${momentum.healthTone}`}>
														{momentum.healthLabel} · {momentum.momentumMessage}
													</p>
												);
											})()}
											{isOwnerViewer && (
												<div class="progress-inline">
													<label class="progress-inline-label" for={`progress-inline-${item.bookId}`}>Update progress</label>
													<div class="progress-inline-controls">
														<label class="progress-format-label">
															<span>Reading format</span>
															<select class="progress-inline-format" aria-label="Reading format">
																{readingFormatSelectOptions.map((format) => (
																	<option value={format.value} selected={(item.readingFormat || "unknown") === format.value}>{format.label}</option>
																))}
															</select>
														</label>
														<select class="progress-inline-type" aria-label="Progress type">
															<option value="page" selected={(item.preferredProgressType || "page") === "page"}>Page Number</option>
															<option value="percent" selected={item.preferredProgressType === "percent"}>Percentage</option>
															<option value="chapter" selected={item.preferredProgressType === "chapter"}>Chapter</option>
															<option value="location" selected={item.preferredProgressType === "location"}>Kindle Location</option>
															<option value="audio" selected={item.preferredProgressType === "audio"}>Audiobook Time</option>
														</select>
														<input
															id={`progress-inline-${item.bookId}`}
															class="progress-inline-input"
															type="text"
															inputmode="text"
															placeholder="154"
															value=""
															aria-describedby={`progress-inline-feedback-${item.bookId}`}
														/>
														<button
															type="button"
															class="progress-inline-save"
															data-action="save-reading-progress"
															data-book-id={String(item.bookId || 0)}
															data-title={item.title}
															data-author={item.author}
															data-description={item.description}
															data-cover={item.thumbnail}
															data-language={item.language}
															data-isbn10={item.isbn10}
															data-isbn13={item.isbn13}
															data-google-books-id={item.googleBooksId}
															data-total-pages={String(Math.max(0, Number(item.totalPages || 0)))}
															data-reading-format={item.readingFormat || "unknown"}
														>
															Save
														</button>
														<button
															type="button"
															class="progress-inline-finish"
															data-action="mark-finished-quick"
															data-book-id={String(item.bookId || 0)}
															data-title={item.title}
															data-author={item.author}
															data-description={item.description}
															data-cover={item.thumbnail}
															data-language={item.language}
															data-isbn10={item.isbn10}
															data-isbn13={item.isbn13}
															data-google-books-id={item.googleBooksId}
															data-total-pages={String(Math.max(0, Number(item.totalPages || 0)))}
															data-current-page={String(Math.max(0, Number(item.currentPage || 0)))}
															data-reading-format={item.readingFormat || "unknown"}
															aria-label="Mark as finished"
															title="Finish"
														>
															<span class="material-icons" aria-hidden="true">check</span>
															<span>Finish</span>
														</button>
														<p
															id={`progress-inline-feedback-${item.bookId}`}
															class="progress-inline-feedback"
															role="status"
															aria-live="polite"
															hidden
														></p>
													</div>
												</div>
											)}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": String(item.totalPages || 0),
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
						{pagedReading.totalPages > 1 && (
							<Pagination
								currentPage={pagedReading.currentPage}
								totalPages={pagedReading.totalPages}
								previousHref={pagedReading.currentPage > 1 ? paginationHref("cr_page", pagedReading.currentPage - 1, "currently-reading") : ""}
								nextHref={pagedReading.currentPage < pagedReading.totalPages ? paginationHref("cr_page", pagedReading.currentPage + 1, "currently-reading") : ""}
								label="Currently Reading pagination"
							/>
						)}
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && (
					<section id="want-to-read" class="activity-card activity-card-plain" data-shelf-section-key="default:want_to_read" style={shelfSectionOrderStyle("default:want_to_read")}>
						<div class="custom-shelf-heading-row">
							<h2><span class="material-icons custom-shelf-heading-icon default-shelf-heading-icon default-shelf-heading-icon-bold" aria-hidden="true">add</span>Want to Read</h2>
							{isOwnerViewer && (
								<div class="custom-shelf-menu-wrap">
									<button type="button" class="custom-shelf-menu-trigger" data-action="toggle-custom-shelf-menu" aria-expanded="false" aria-label="Actions for Want to Read">
										<span class="material-icons" aria-hidden="true">more_vert</span>
									</button>
									<div class="custom-shelf-menu" hidden>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up" {...shelfSectionMoveAttrs("default:want_to_read", "up")}>Move up</button>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down" {...shelfSectionMoveAttrs("default:want_to_read", "down")}>Move down</button>
									</div>
								</div>
							)}
						</div>
						{pagedWantToRead.items.length === 0 ? (
							<div class="profile-empty-state">
								<p>Your Want to Read shelf is where future books wait. Save a few titles to build your reading queue.</p>
								{isOwnerViewer && <a href="/search">Search for books</a>}
							</div>
						) : (
							<ul class="activity-grid">
								{pagedWantToRead.items.map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
									thumbnail={item.thumbnail}
									readers={1}
									shelfEntries={1}
									genres={item.genres}
								>
									<p slot="preTitle" class="meta activity-headline">
										<span class="activity-prefix">Want to Read</span>
											{formatActivityDate(item.updatedAt) && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": "0",
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
						{pagedWantToRead.totalPages > 1 && (
							<Pagination
								currentPage={pagedWantToRead.currentPage}
								totalPages={pagedWantToRead.totalPages}
								previousHref={pagedWantToRead.currentPage > 1 ? paginationHref("wr_page", pagedWantToRead.currentPage - 1, "want-to-read") : ""}
								nextHref={pagedWantToRead.currentPage < pagedWantToRead.totalPages ? paginationHref("wr_page", pagedWantToRead.currentPage + 1, "want-to-read") : ""}
								label="Want to Read pagination"
							/>
						)}
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && (
					<section id="read" class="activity-card activity-card-plain" data-shelf-section-key="default:finished" style={shelfSectionOrderStyle("default:finished")}>
						<div class="custom-shelf-heading-row">
							<h2><span class="material-icons custom-shelf-heading-icon default-shelf-heading-icon default-shelf-heading-icon-bold" aria-hidden="true">done</span>Read</h2>
							{isOwnerViewer && (
								<div class="custom-shelf-menu-wrap">
									<button type="button" class="custom-shelf-menu-trigger" data-action="toggle-custom-shelf-menu" aria-expanded="false" aria-label="Actions for Read">
										<span class="material-icons" aria-hidden="true">more_vert</span>
									</button>
									<div class="custom-shelf-menu" hidden>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up" {...shelfSectionMoveAttrs("default:finished", "up")}>Move up</button>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down" {...shelfSectionMoveAttrs("default:finished", "down")}>Move down</button>
									</div>
								</div>
							)}
						</div>
						{pagedFinished.items.length === 0 ? (
							<div class="profile-empty-state">
								<p>No books marked Read yet. Finish a book, add a rating, and DogEared will start building your reading history.</p>
								{isOwnerViewer && <a href="/search">Add a finished book</a>}
							</div>
						) : (
							<ul class="activity-grid">
								{pagedFinished.items.map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
									thumbnail={item.thumbnail}
									readers={1}
									shelfEntries={1}
									genres={item.genres}
								>
									<p slot="preTitle" class="meta activity-headline">
										<span class="activity-prefix">Read</span>
											{item.finishedDate && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.finishedDate || item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="meta">
											{isOwnerViewer ? (
												<RatingControl bookId={item.bookId} rating={item.rating} editable={true} />
											) : (
												item.rating > 0 && <p class="meta rating-meta">{renderRatingStars(item.rating)} {item.rating}/5</p>
											)}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": "0",
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
						{pagedFinished.totalPages > 1 && (
							<Pagination
								currentPage={pagedFinished.currentPage}
								totalPages={pagedFinished.totalPages}
								previousHref={pagedFinished.currentPage > 1 ? paginationHref("rd_page", pagedFinished.currentPage - 1, "read") : ""}
								nextHref={pagedFinished.currentPage < pagedFinished.totalPages ? paginationHref("rd_page", pagedFinished.currentPage + 1, "read") : ""}
								label="Read shelf pagination"
							/>
						)}
					</section>
				)}
			</>
		)}
	</div>
</Layout>

<style>
	.public-profile-page { max-width: 860px; display: grid; gap: 0.9rem; }
	.breadcrumbs {
		display: flex;
		gap: 0.35rem;
		align-items: center;
		flex-wrap: wrap;
		margin: 0;
		font-size: 0.84rem;
		color: var(--color-text-subtle);
	}
	.breadcrumbs a {
		color: var(--color-nav);
		text-decoration: none;
	}
	.breadcrumbs a:hover,
	.breadcrumbs a:focus-visible {
		color: var(--color-nav-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.welcome-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: rgba(255, 255, 255, 0.56);
		padding: 0.75rem 0.85rem;
	}
	.welcome-banner p {
		margin: 0;
		color: #1f3b22;
	}
	.welcome-banner-dismiss {
		display: inline-block;
		text-decoration: none;
		border-radius: 999px;
		background: #1f7a45;
		color: #fff;
		font: inherit;
		font-weight: 700;
		padding: 0.35rem 0.7rem;
		cursor: pointer;
	}
	.state-card, .profile-card, .shelf-card, .activity-card { border: var(--border-subtle); border-radius: var(--radius-lg); background: var(--color-surface-raised); padding: 1rem; }
	.activity-card-plain { border: none; background: transparent; border-radius: 0; padding: 0; }
	.owner-edit-link-muted {
		background: var(--color-nav-surface-hover);
		border-color: var(--color-border-soft);
		color: var(--color-nav);
	}
	.profile-card { position: relative; }
	.profile-card-actions {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		display: flex;
		justify-content: flex-end;
	}
	.profile-actions-menu-wrap {
		position: relative;
	}
	.profile-actions-menu-trigger {
		width: 28px;
		height: 28px;
		border: none;
		border-radius: 0;
		background: transparent;
		color: #374151;
		display: grid;
		place-items: center;
		cursor: pointer;
	}
	.profile-actions-menu-trigger .material-icons {
		font-size: 1.3rem;
		line-height: 1;
		font-variation-settings: "FILL" 1, "wght" 700, "GRAD" 0, "opsz" 24;
	}
	.profile-actions-menu {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		min-width: 132px;
		background: #fff;
		border: none;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-popover);
		padding: 0.28rem;
		z-index: 30;
	}
	.profile-actions-menu-item {
		display: block;
		width: 100%;
		text-align: left;
		border: none;
		background: transparent;
		padding: 0.45rem 0.65rem;
		font: inherit;
		font-size: 0.86rem;
		color: var(--color-text);
		text-decoration: none;
		cursor: pointer;
