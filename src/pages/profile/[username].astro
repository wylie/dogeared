	document.addEventListener("click", async (event) => {
		const rawTarget = event.target;
		const target = rawTarget instanceof Element
			? rawTarget
			: (rawTarget instanceof Node ? rawTarget.parentElement : null);
		if (!(target instanceof HTMLElement)) return;
		const quickFinish = target.closest('[data-action="mark-finished-quick"]');
		if (quickFinish instanceof HTMLButtonElement) {
			event.preventDefault();
			event.stopPropagation();
			const totalPages = Math.max(0, Number(quickFinish.dataset.totalPages || 0) || 0);
			const currentPageRaw = Math.max(0, Number(quickFinish.dataset.currentPage || 0) || 0);
			const finishedPage = totalPages > 0 ? totalPages : currentPageRaw;
			const entry = buildShelfEntryFromRecord({
				bookId: Number(quickFinish.dataset.bookId || 0),
				title: String(quickFinish.dataset.title || "").trim(),
				author: String(quickFinish.dataset.author || "").trim(),
				description: String(quickFinish.dataset.description || "").trim(),
				pageCount: totalPages,
				coverUrl: String(quickFinish.dataset.cover || "").trim(),
				format: "Book",
				language: String(quickFinish.dataset.language || "").trim(),
				isbn10: String(quickFinish.dataset.isbn10 || "").trim(),
				isbn13: String(quickFinish.dataset.isbn13 || "").trim(),
				googleBooksId: String(quickFinish.dataset.googleBooksId || "").trim()
			}, {
				status: "finished",
				totalPages,
				currentPage: finishedPage,
				finishedDate: new Date().toISOString().slice(0, 10)
			});
			if (!entry.title) return;
			quickFinish.disabled = true;
			const card = quickFinish.closest(".book-card");
			const dropdown = card?.querySelector(".shelf-dropdown");
			try {
				const finishResult = await promptAndSaveFinishedEntry(entry);
				if (!finishResult.ok) return;
				rememberReadingActivityToday();
				if (dropdown) {
					setDropdownLabel(dropdown, "finished");
					setShelvedState(dropdown, true);
					showShelfFeedback(dropdown, "Saved to Read.", feedbackTimers);
					removeCardFromShelfSection(dropdown, "finished");
				}
				await refreshProfileReadingUiAfterMutation();
			} catch (error) {
				if (dropdown) {
					showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
				} else {
					quickFinish.title = error instanceof Error ? error.message : "Failed to save.";
				}
			} finally {
				quickFinish.disabled = false;
			}
			return;
		}
		const progressSave = target.closest('[data-action="save-reading-progress"]');
		if (progressSave instanceof HTMLButtonElement) {
			event.preventDefault();
			event.stopPropagation();
			const card = progressSave.closest(".book-card");
			const input = card?.querySelector(".progress-inline-input");
			if (!(input instanceof HTMLInputElement)) return;
			const totalPages = Math.max(0, Number(progressSave.dataset.totalPages || 0) || 0);
			const parsed = parseProgressInput(input.value, totalPages);
			if (!parsed.valid) {
				progressSave.textContent = "Invalid";
				setTimeout(() => {
					progressSave.textContent = "Save";
				}, 1000);
				return;
			}
			const currentPage = parsed.currentPage;
			const shouldFinish = totalPages > 0 && currentPage >= totalPages;
			if (shouldFinish) {
				const finishEntry = buildShelfEntryFromRecord({
					title: String(progressSave.dataset.title || "").trim(),
					author: String(progressSave.dataset.author || "").trim(),
					description: String(progressSave.dataset.description || "").trim(),
					pageCount: totalPages,
					coverUrl: String(progressSave.dataset.cover || "").trim(),
					format: "Book",
					language: String(progressSave.dataset.language || "").trim(),
					isbn10: String(progressSave.dataset.isbn10 || "").trim(),
					isbn13: String(progressSave.dataset.isbn13 || "").trim(),
					googleBooksId: String(progressSave.dataset.googleBooksId || "").trim()
				}, {
					status: "finished",
					totalPages,
					currentPage: totalPages,
					finishedDate: new Date().toISOString().slice(0, 10)
				});
				const directBookId = Math.max(0, Number(progressSave.dataset.bookId || 0) || 0);
				if (directBookId > 0) finishEntry.bookId = directBookId;
				if (!finishEntry.title) return;

				const card = progressSave.closest(".book-card");
				const dropdown = card?.querySelector(".shelf-dropdown");
				const originalLabel = progressSave.textContent || "Save";
				progressSave.disabled = true;
				progressSave.textContent = "Saving...";
				try {
					const finishResult = await promptAndSaveFinishedEntry(finishEntry);
					if (!finishResult.ok) return;
					rememberReadingActivityToday();
					if (dropdown) {
						setDropdownLabel(dropdown, "finished");
						setShelvedState(dropdown, true);
						showShelfFeedback(dropdown, "Saved to Read.", feedbackTimers);
						removeCardFromShelfSection(dropdown, "finished");
					}
					await refreshProfileReadingUiAfterMutation();
				} catch (error) {
					if (dropdown) {
						showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
					}
					progressSave.textContent = "Retry";
					setTimeout(() => {
						progressSave.textContent = originalLabel;
					}, 1200);
				} finally {
					progressSave.disabled = false;
				}
				return;
			}

			const entry = buildShelfEntryFromRecord({
				title: String(progressSave.dataset.title || "").trim(),
				author: String(progressSave.dataset.author || "").trim(),
				description: String(progressSave.dataset.description || "").trim(),
				pageCount: totalPages,
				coverUrl: String(progressSave.dataset.cover || "").trim(),
				format: "Book",
				language: String(progressSave.dataset.language || "").trim(),
				isbn10: String(progressSave.dataset.isbn10 || "").trim(),
				isbn13: String(progressSave.dataset.isbn13 || "").trim(),
				googleBooksId: String(progressSave.dataset.googleBooksId || "").trim()
			}, {
				status: "reading",
				totalPages,
				currentPage,
				finishedDate: ""
			});
			const directBookId = Math.max(0, Number(progressSave.dataset.bookId || 0) || 0);
			if (directBookId > 0) entry.bookId = directBookId;
			if (!entry.title) return;

			const originalLabel = progressSave.textContent || "Save";
			progressSave.disabled = true;
			progressSave.textContent = "Saving...";
			let persisted = false;
			try {
				const result = await saveShelfEntryWithRetry(entry);
				if (!result.ok) throw new Error(result.message || "Failed to save progress.");
				persisted = true;
				try {
					const persistedEntry = result?.data && typeof result.data === "object"
						? (result.data.entry || null)
						: null;
					const nextTotalPages = Math.max(0, Number((persistedEntry && persistedEntry.totalPages) || totalPages || 0) || 0);
					const nextCurrentPage = Math.max(0, Number((persistedEntry && persistedEntry.currentPage) || currentPage || 0) || 0);
					const updatedAtValue = String((persistedEntry && persistedEntry.updatedAt) || "").trim();
					const progressNode = card?.querySelector(".progress-current-value");
					if (progressNode instanceof HTMLElement) {
						const percent = nextTotalPages > 0 ? Math.max(0, Math.min(100, Math.round((nextCurrentPage / nextTotalPages) * 100))) : 0;
						progressNode.textContent = nextTotalPages > 0
							? `Progress: ${nextCurrentPage}/${nextTotalPages} pages (${percent}%)`
							: `Progress: ${nextCurrentPage} pages`;
					}
					const progressFill = card?.querySelector(".progress-fill");
					if (progressFill instanceof HTMLElement && nextTotalPages > 0) {
						const percent = Math.max(0, Math.min(100, Math.round((nextCurrentPage / nextTotalPages) * 100)));
						progressFill.style.width = `${percent}%`;
					}
					const quickFinish = card?.querySelector('[data-action="mark-finished-quick"]');
					if (quickFinish instanceof HTMLButtonElement) {
						quickFinish.dataset.currentPage = String(nextCurrentPage);
						quickFinish.dataset.totalPages = String(nextTotalPages);
					}
					if (card instanceof HTMLElement) {
						card.dataset.momentumCurrentPage = String(nextCurrentPage);
						card.dataset.momentumTotalPages = String(nextTotalPages);
						card.dataset.momentumUpdatedAt = updatedAtValue || new Date().toISOString();
						const priorUpdates = Math.max(0, Number(card.dataset.momentumProgressUpdates || 0) || 0);
						card.dataset.momentumProgressUpdates = String(priorUpdates + 1);
					}
					rememberReadingActivityToday();
					await refreshProfileReadingUiAfterMutation();
					const updatedLabel = safeFormatActivityDate(updatedAtValue) || safeFormatActivityDate(new Date().toISOString());
					if (card instanceof HTMLElement) {
						card.dataset.updatedAt = updatedAtValue || new Date().toISOString();
					}
					const dateNode = card?.querySelector(".activity-date");
					if (dateNode instanceof HTMLElement) {
						dateNode.textContent = `Updated ${updatedLabel}`;
					}
				} catch (uiError) {
					console.warn("Progress saved but local UI sync failed.", uiError);
				}
				input.value = "";
				progressSave.textContent = "Saved";
				setTimeout(() => {
					progressSave.textContent = originalLabel;
				}, 900);
			} catch (error) {
				console.warn("Failed to save reading progress.", error);
				progressSave.textContent = persisted ? "Saved" : "Retry";
				setTimeout(() => {
					progressSave.textContent = originalLabel;
				}, persisted ? 900 : 1200);
			} finally {
				progressSave.disabled = false;
			}
			return;
		}
		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown) toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}
		const option = target.closest('[data-action="set-shelf"]');
		if (option) {
			event.preventDefault();
