---
import Layout from "../../layouts/Layout.astro";
import BookCard from "../../components/BookCard.astro";
import ShelfDropdown from "../../components/ShelfDropdown.astro";
import Chip from "../../components/Chip.astro";
import RatingControl from "../../components/RatingControl.astro";
import { resolveUserBySession } from "../../lib/auth";
import { getNeonSql } from "../../lib/neon";
import { resolvePublicProfileBundle, resolvePublicRecentActivity, resolvePublicShelfSummary } from "../../lib/publicProfile";
import { authorHref } from "../../lib/author";
import { ensureCustomShelfSchema } from "../../lib/customShelves";
import { daysSinceDate, resolveMomentumPrediction } from "../../lib/momentumPrediction";
import { buildBreadcrumbList, toAbsoluteUrl } from "../../lib/seo";

export const prerender = false;

const requestedUsername = String(Astro.params.username || "").trim().toLowerCase();
const session = await resolveUserBySession(Astro.request);
const viewerUserId = String(session?.userId || "");
const isAuthenticated = !!viewerUserId;
const editMode = String(Astro.url.searchParams.get("edit") || "").trim() === "1";
const showWelcomeBanner = String(Astro.url.searchParams.get("welcome") || "").trim() === "1";
const dismissWelcomeUrl = (() => {
	const next = new URL(Astro.url);
	next.searchParams.delete("welcome");
	return `${next.pathname}${next.search ? next.search : ""}${next.hash || ""}`;
})();

function normalizeText(value: unknown, maxLength: number) {
	return String(value || "").replace(/\s+/g, " ").trim().slice(0, maxLength);
}

function normalizeUsernameForSave(value: unknown) {
	const raw = normalizeText(value, 40).replace(/^@+/, "").toLowerCase();
	if (!raw) return "";
	return raw.replace(/[^a-z0-9._-]/g, "").slice(0, 40);
}

function normalizeGenres(value: unknown) {
	const parts = String(value || "").split(",");
	const dedupe = new Set<string>();
	const out: string[] = [];
	for (const part of parts) {
		const next = normalizeText(part, 40);
		if (!next) continue;
		const key = next.toLowerCase();
		if (dedupe.has(key)) continue;
		dedupe.add(key);
		out.push(next);
		if (out.length >= 12) break;
	}
	return out;
}

function normalizeBirthYear(value: unknown) {
	const year = Number(String(value ?? "").trim());
	if (!Number.isFinite(year)) return "";
	const rounded = Math.trunc(year);
	if (rounded < 1900 || rounded > 2100) return "";
	return String(rounded);
}

function normalizeBookIdentityPart(value: unknown) {
	return String(value || "")
		.toLowerCase()
		.normalize("NFKD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/[^a-z0-9]+/g, " ")
		.trim();
}

function bookIdentityKey(input: { title: unknown; author: unknown }) {
	const title = normalizeBookIdentityPart(input.title);
	const author = normalizeBookIdentityPart(input.author);
	return `${title}::${author}`;
}

function toTimestamp(value: unknown) {
	const time = new Date(String(value || "")).getTime();
	return Number.isFinite(time) ? time : 0;
}

function dedupeByWorkIdentity<T extends {
	title: string;
	author: string;
	updatedAt?: string;
	currentPage?: number;
	totalPages?: number;
}>(
	items: T[]
) {
	const byKey = new Map<string, T>();
	for (const item of items) {
		const key = bookIdentityKey({ title: item.title, author: item.author });
		if (!key || key === "::") continue;
		const existing = byKey.get(key);
		if (!existing) {
			byKey.set(key, item);
			continue;
		}
		const existingTime = toTimestamp(existing.updatedAt);
		const itemTime = toTimestamp(item.updatedAt);
		if (itemTime > existingTime) {
			byKey.set(key, item);
			continue;
		}
		if (itemTime === existingTime) {
			const existingProgress = Math.max(0, Number(existing.currentPage || 0));
			const itemProgress = Math.max(0, Number(item.currentPage || 0));
			if (itemProgress > existingProgress) byKey.set(key, item);
		}
	}
	return Array.from(byKey.values());
}

function formatNotificationAge(value: unknown) {
	const date = new Date(String(value || ""));
	if (Number.isNaN(date.getTime())) return "";
	const diffMs = Math.max(0, Date.now() - date.getTime());
	const diffHours = diffMs / (1000 * 60 * 60);
	if (diffHours < 24) {
		const roundedHours = Math.max(0, Math.round(diffHours));
		return `${roundedHours} ${roundedHours === 1 ? "hour" : "hours"}`;
	}
	const diffDays = Math.max(1, Math.round(diffHours / 24));
	return `${diffDays} ${diffDays === 1 ? "day" : "days"}`;
}

if (Astro.request.method === "POST" && viewerUserId && requestedUsername) {
	const formData = await Astro.request.formData();
	const profileIntent = String(formData.get("profileIntent") || "").trim().toLowerCase();
	if (profileIntent === "save") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId === viewerUserId) {
			const sql = getNeonSql();
			const existingRows = await sql<Array<{ username: string | null; profile_data: unknown }>>`
				select username, profile_data
				from app_user
				where id = ${viewerUserId}::uuid
				limit 1
			`;
			const currentUsername = normalizeUsernameForSave(existingRows[0]?.username);
			const existingProfileData = (existingRows[0]?.profile_data && typeof existingRows[0].profile_data === "object")
				? existingRows[0].profile_data as Record<string, unknown>
				: {};
			const existingSettings = (existingProfileData.settings && typeof existingProfileData.settings === "object")
				? existingProfileData.settings as Record<string, unknown>
				: {};
			const currentAvatar = normalizeText(existingProfileData.avatar, 500000);
			const submittedAvatar = normalizeText(formData.get("avatarUrl"), 500000);
			const nextAvatar = submittedAvatar || currentAvatar;
			let nextUsername = normalizeUsernameForSave(formData.get("username"));
			if (!nextUsername) nextUsername = currentUsername;
			if (nextUsername && nextUsername !== currentUsername) {
				const takenRows = await sql<Array<{ id: string }>>`
					select id
					from app_user
					where lower(username) = lower(${nextUsername})
						and id <> ${viewerUserId}::uuid
					limit 1
				`;
				if (takenRows.length > 0) {
					nextUsername = currentUsername;
				}
			}
			const nextProfile = {
				avatar: nextAvatar,
				name: normalizeText(formData.get("name"), 80),
				username: nextUsername ? `@${nextUsername}` : "",
				location: normalizeText(formData.get("location"), 80),
				birthYear: normalizeBirthYear(formData.get("birthYear")),
				readingGoal: normalizeText(formData.get("readingGoal"), 80),
				favoriteBook: normalizeText(formData.get("favoriteBook"), 120),
				favoriteAuthor: normalizeText(formData.get("favoriteAuthor"), 120),
				blurb: normalizeText(formData.get("blurb"), 400),
				genres: normalizeGenres(formData.get("genres")),
				settings: existingSettings
			};
			await sql`
				update app_user
				set
					username = ${nextUsername || null},
					profile_data = ${JSON.stringify(nextProfile)}::jsonb
				where id = ${viewerUserId}::uuid
			`;
			return Astro.redirect(`/profile/${encodeURIComponent(nextUsername || requestedUsername)}`);
		}
		return Astro.redirect(`/profile/${encodeURIComponent(requestedUsername)}`);
	}
	const followIntent = String(formData.get("followIntent") || "").trim().toLowerCase();
	if (followIntent === "follow" || followIntent === "unfollow") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId !== viewerUserId) {
			const sql = getNeonSql();
			if (followIntent === "follow") {
				await sql`
					insert into user_follow (follower_user_id, followed_user_id)
					values (${viewerUserId}::uuid, ${target.targetUserId}::uuid)
					on conflict (follower_user_id, followed_user_id) do nothing
				`;
			} else {
				await sql`
					delete from user_follow
					where follower_user_id = ${viewerUserId}::uuid
						and followed_user_id = ${target.targetUserId}::uuid
				`;
			}
		}
		return Astro.redirect(`/profile/${encodeURIComponent(requestedUsername)}`);
	}
	const notificationIntent = String(formData.get("notificationIntent") || "").trim().toLowerCase();
	if (notificationIntent === "mark_all_read" || notificationIntent === "clear_all" || notificationIntent === "clear_one") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId === viewerUserId) {
			const sql = getNeonSql();
			try {
				if (notificationIntent === "mark_all_read") {
					await sql`
						update user_notification
						set read_at = now()
						where user_id = ${viewerUserId}::uuid
							and read_at is null
					`;
				}
				if (notificationIntent === "clear_all") {
					await sql`
						delete from user_notification
						where user_id = ${viewerUserId}::uuid
					`;
				}
				if (notificationIntent === "clear_one") {
					const notificationId = Math.max(0, Number(formData.get("notificationId") || 0));
					if (notificationId > 0) {
						await sql`
							delete from user_notification
							where id = ${notificationId}
								and user_id = ${viewerUserId}::uuid
						`;
					}
				}
			} catch {
				// Keep profile requests resilient even if notifications table is unavailable.
			}
		}
		return Astro.redirect(`/profile/${encodeURIComponent(requestedUsername)}#notifications`);
	}
}

let notFound = false;
let privateProfile = false;
let profile = {
	avatar: "",
	name: "",
	location: "",
	birthYear: "",
	readingGoal: "",
	favoriteBook: "",
	favoriteAuthor: "",
	blurb: "",
	genres: [] as string[],
	username: ""
};
let canViewActivity = false;
let shelfStats = { wantToRead: 0, reading: 0, finished: 0, total: 0 };
let recentActivity: Array<{
	activityId: number;
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	status: string;
	eventType: string;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	rating: number;
	likeCount: number;
	viewerLiked: boolean;
	updatedAt: string;
	genres: string[];
}> = [];
let currentlyReading: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	googleBooksId: string;
	description: string;
	currentPage: number;
	totalPages: number;
	updatedAt: string;
	firstAddedAt: string;
	progressUpdates: number;
	genres: string[];
}> = [];
let wantToReadBooks: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	updatedAt: string;
	genres: string[];
}> = [];
let finishedBooks: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	rating: number;
	finishedDate: string;
	updatedAt: string;
	genres: string[];
}> = [];
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let followState = {
	followersCount: 0,
	followingCount: 0,
	isViewerFollowing: false,
	canFollow: false
};
let isOwnerViewer = false;
let customShelves: Array<{ id: number; name: string; slug: string; icon: string; position: number; bookCount: number }> = [];
let shelfSectionOrderKeys: string[] = [];
let shelfSectionOrderByKey = new Map<string, number>();
const RECENT_ACTIVITY_SECTION_KEY = "recent:activity";
let customShelfBooksByShelfId = new Map<number, Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	status: string;
	rating: number;
	updatedAt: string;
	genres: string[];
}>>();
type MomentumBook = {
	bookId: number;
	title: string;
	currentPage: number;
	totalPages: number;
	percent: number;
	daysSinceUpdate: number;
	daysSinceStart: number;
	progressUpdateCount: number;
	finishProbability: number;
	confidence: number;
	healthLabel: string;
	healthTone: "good" | "neutral";
	predictionEligible: boolean;
	showOnboardingStatus: boolean;
	onboardingMessage: string;
	momentumMessage: string;
};
let momentumBooks: MomentumBook[] = [];
let momentumScore = 0;
let momentumStreakDays = 0;
let momentumNextAction = "";
let readingStreakDateKeys: string[] = [];
let favoriteBookHref = "";
let favoriteAuthorHref = "";
let ownerProfileData: Record<string, unknown> = {};
let notifications: Array<{
	id: number;
	type: "activity_like" | "activity_comment";
	createdAt: string;
	readAt: string;
	actorUsername: string;
	bookTitle: string;
	bookId: number;
	activityId: number;
}> = [];
const PAGE_SIZE = 12;
const recentPage = Math.max(1, Number(Astro.url.searchParams.get("ra_page") || "1") || 1);
const readingPage = Math.max(1, Number(Astro.url.searchParams.get("cr_page") || "1") || 1);
const wantToReadPage = Math.max(1, Number(Astro.url.searchParams.get("wr_page") || "1") || 1);
const finishedPage = Math.max(1, Number(Astro.url.searchParams.get("rd_page") || "1") || 1);

const bundle = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
if (bundle.status === "not_found") notFound = true;
if (bundle.status === "private") privateProfile = true;
if (bundle.status === "ok" && bundle.profile && bundle.targetUserId) {
	const sql = getNeonSql();
	profile = bundle.profile;
	canViewActivity = bundle.canViewActivity;
	isOwnerViewer = !!viewerUserId && viewerUserId === bundle.targetUserId;
	if (isOwnerViewer) {
		const ownerRows = await sql<Array<{ profile_data: unknown }>>`
			select profile_data
			from app_user
			where id = ${bundle.targetUserId}::uuid
			limit 1
		`;
		ownerProfileData = (ownerRows[0]?.profile_data && typeof ownerRows[0].profile_data === "object")
			? ownerRows[0].profile_data as Record<string, unknown>
			: {};
		try {
			const notificationRows = await sql<Array<{
				id: number;
				type: "activity_like" | "activity_comment";
				created_at: string;
				read_at: string | null;
				actor_username: string | null;
				book_title: string | null;
				book_id: number;
				activity_id: number;
			}>>`
				select
					n.id,
					n.type,
					n.created_at::text as created_at,
					n.read_at::text as read_at,
					actor.username as actor_username,
					coalesce(b.title, '') as book_title,
					ua.book_id,
					n.activity_id
				from user_notification n
				join app_user actor on actor.id = n.actor_user_id
				join user_activity ua on ua.id = n.activity_id
				join book b on b.id = ua.book_id
				where n.user_id = ${viewerUserId}::uuid
				order by n.created_at desc
				limit 100
			`;
			notifications = notificationRows.map((row) => ({
				id: Math.max(0, Number(row.id || 0)),
				type: row.type === "activity_comment" ? "activity_comment" : "activity_like",
				createdAt: String(row.created_at || ""),
				readAt: String(row.read_at || ""),
				actorUsername: String(row.actor_username || "").trim().replace(/^@+/, "") || "reader",
				bookTitle: String(row.book_title || "").trim() || "a book",
				bookId: Math.max(0, Number(row.book_id || 0)),
				activityId: Math.max(0, Number(row.activity_id || 0))
			}));
		} catch {
			notifications = [];
		}
	}
	followState = {
		followersCount: bundle.followersCount,
		followingCount: bundle.followingCount,
		isViewerFollowing: bundle.isViewerFollowing,
		canFollow: !!viewerUserId && viewerUserId !== bundle.targetUserId && bundle.allowFollowRequests
	};
	if (profile.favoriteBook) {
		const favoriteRaw = String(profile.favoriteBook || "").trim();
		let favoriteTitle = favoriteRaw;
		let favoriteAuthor = "";
		const byMatch = favoriteRaw.match(/^(.*?)\s+by\s+(.+)$/i);
		if (byMatch) {
			favoriteTitle = String(byMatch[1] || "").trim();
			favoriteAuthor = String(byMatch[2] || "").trim();
		}
		const favoriteMatch = await sql<Array<{ id: number }>>`
			select b.id
			from book b
			where lower(trim(coalesce(b.title, ''))) = lower(${favoriteTitle})
				and (
					${favoriteAuthor} = ''
					or lower(trim(coalesce(b.primary_author, ''))) = lower(${favoriteAuthor})
				)
			order by b.id desc
			limit 1
		`;
		const bookId = Number(favoriteMatch[0]?.id || 0);
		if (bookId > 0) favoriteBookHref = `/book?bookId=${encodeURIComponent(String(bookId))}`;
		else if (favoriteTitle) {
			favoriteBookHref = `/book?title=${encodeURIComponent(favoriteTitle)}${favoriteAuthor ? `&author=${encodeURIComponent(favoriteAuthor)}` : ""}`;
		}
	}
	if (profile.favoriteAuthor) {
		const favoriteAuthorMatch = await sql<Array<{ id: number }>>`
			select a.id
			from author a
			where lower(trim(coalesce(a.name, ''))) = lower(${profile.favoriteAuthor})
			order by a.id desc
			limit 1
		`;
		const favoriteAuthorId = Number(favoriteAuthorMatch[0]?.id || 0);
		favoriteAuthorHref = authorHref(profile.favoriteAuthor, favoriteAuthorId);
	}
	const [summary, updates, readingRows, wantToReadRows, finishedRows, customShelfRows, customShelfBookRows] = await Promise.all([
		resolvePublicShelfSummary(bundle.targetUserId),
		bundle.canViewActivity ? resolvePublicRecentActivity(bundle.targetUserId, 500, viewerUserId) : Promise.resolve([]),
		bundle.canViewActivity
				? sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				google_books_id: string;
				current_page: number;
				total_pages: number;
				updated_at: string;
				first_added_at: string;
				progress_updates: number;
				genres: string[];
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					b.google_books_id,
					ub.current_page,
					ub.total_pages,
					ub.updated_at::text as updated_at,
					coalesce(ub.first_added_at::text, ub.updated_at::text) as first_added_at,
					coalesce(pe.progress_updates, 0)::int as progress_updates,
					(
						select coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}')
						from book_genre bg where bg.book_id = b.id
					) as genres
				from user_book ub
				join book b on b.id = ub.book_id
				left join lateral (
					select count(*)::int as progress_updates
					from user_reading_progress_event pe
					where pe.user_id = ub.user_id
						and pe.book_id = ub.book_id
				) pe on true
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'reading'
				order by ub.updated_at desc
				limit 500
			`
			: Promise.resolve([]),
		bundle.canViewActivity
				? sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				updated_at: string;
				genres: string[];
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					ub.updated_at::text as updated_at,
					(
						select coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}')
						from book_genre bg where bg.book_id = b.id
					) as genres
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'want_to_read'
				order by ub.updated_at desc
				limit 500
			`
			: Promise.resolve([]),
		bundle.canViewActivity
				? sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				rating: number | null;
				finished_date: string | null;
				updated_at: string;
				genres: string[];
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					ub.rating,
					ub.finished_date::text as finished_date,
					ub.updated_at::text as updated_at,
					(
						select coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}')
						from book_genre bg where bg.book_id = b.id
					) as genres
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'finished'
				order by coalesce(ub.finished_date, ub.updated_at) desc
				limit 500
			`
			: Promise.resolve([]),
		isOwnerViewer
			? (async () => {
				try {
					await ensureCustomShelfSchema(sql);
					return sql<Array<{ id: number; name: string; slug: string; icon: string; position: number; book_count: number }>>`
						select
							s.id,
							s.name,
							s.slug,
							s.icon,
							s.position,
							coalesce(count(sb.book_id), 0)::int as book_count
						from user_custom_shelf s
						left join user_custom_shelf_book sb
							on sb.shelf_id = s.id
							and sb.user_id = s.user_id
						where s.user_id = ${bundle.targetUserId}::uuid
						group by s.id, s.name, s.slug, s.position
						order by s.position asc, s.id asc
					`;
				} catch {
					return [];
				}
			})()
			: Promise.resolve([]),
		isOwnerViewer
			? (async () => {
				try {
					await ensureCustomShelfSchema(sql);
					return sql<Array<{
						shelf_id: number;
						book_id: number;
						title: string;
						primary_author: string;
						author_id: number | null;
						cover_url: string;
						language: string;
						isbn10: string;
						isbn13: string;
						status: string | null;
						rating: number | null;
						updated_at: string | null;
						genres: string[];
					}>>`
						select
							sb.shelf_id,
							b.id as book_id,
							b.title,
							b.primary_author,
							b.author_id,
							b.cover_url,
							b.language,
							b.isbn10,
							b.isbn13,
							ub.status,
							ub.rating,
							coalesce(ub.updated_at::text, sb.created_at::text) as updated_at,
							(
								select coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}')
								from book_genre bg where bg.book_id = b.id
							) as genres
						from user_custom_shelf_book sb
						join book b on b.id = sb.book_id
						left join user_book ub
							on ub.user_id = sb.user_id
							and ub.book_id = sb.book_id
						where sb.user_id = ${bundle.targetUserId}::uuid
						order by sb.shelf_id asc, coalesce(ub.updated_at, sb.created_at) desc
					`;
				} catch {
					return [];
				}
			})()
			: Promise.resolve([])
	]);
	shelfStats = summary;
	recentActivity = updates;
	currentlyReading = readingRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		googleBooksId: String(row.google_books_id || "").trim(),
		description: "",
		currentPage: Math.max(0, Number(row.current_page || 0) || 0),
		totalPages: Math.max(0, Number(row.total_pages || 0) || 0),
		updatedAt: String(row.updated_at || "").trim(),
		firstAddedAt: String(row.first_added_at || row.updated_at || "").trim(),
		progressUpdates: Math.max(0, Number(row.progress_updates || 0) || 0),
		genres: Array.isArray(row.genres) ? row.genres.map((genre) => String(genre || "").trim()).filter(Boolean) : []
	}));
	currentlyReading = dedupeByWorkIdentity(currentlyReading);
	wantToReadBooks = wantToReadRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		description: "",
		updatedAt: String(row.updated_at || "").trim(),
		genres: Array.isArray(row.genres) ? row.genres.map((genre) => String(genre || "").trim()).filter(Boolean) : []
	}));
	wantToReadBooks = dedupeByWorkIdentity(wantToReadBooks);
	// Keep default shelves mutually exclusive in the profile UI when catalog duplicates
	// exist for the same work under different book IDs.
	const currentlyReadingKeys = new Set(
		currentlyReading.map((item) => bookIdentityKey({ title: item.title, author: item.author }))
	);
	wantToReadBooks = wantToReadBooks.filter((item) => (
		!currentlyReadingKeys.has(bookIdentityKey({ title: item.title, author: item.author }))
	));
	finishedBooks = finishedRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		description: "",
		rating: Math.max(0, Math.min(5, Number(row.rating || 0) || 0)),
		finishedDate: String(row.finished_date || "").trim(),
		updatedAt: String(row.updated_at || "").trim(),
		genres: Array.isArray(row.genres) ? row.genres.map((genre) => String(genre || "").trim()).filter(Boolean) : []
	}));
	finishedBooks = dedupeByWorkIdentity(finishedBooks);
	if (isOwnerViewer) {
		try {
			const progressDateRows = await sql<Array<{ activity_day: string }>>`
				select distinct recorded_at::date::text as activity_day
				from user_reading_progress_event
				where user_id = ${bundle.targetUserId}::uuid
				order by activity_day desc
				limit 120
			`;
			readingStreakDateKeys = progressDateRows
				.map((row) => String(row.activity_day || "").trim())
				.filter(Boolean);
		} catch {
			readingStreakDateKeys = [];
		}
	}
	customShelves = customShelfRows.map((row) => ({
		id: Math.max(0, Number(row.id || 0) || 0),
		name: String(row.name || "").trim(),
		slug: String(row.slug || "").trim(),
		icon: String(row.icon || "bookmarks").trim() || "bookmarks",
		position: Math.max(0, Number(row.position || 0) || 0),
		bookCount: Math.max(0, Number(row.book_count || 0) || 0)
	})).filter((row) => row.id > 0 && row.name);
	if (isOwnerViewer) {
		const defaultKeys = ["default:reading", RECENT_ACTIVITY_SECTION_KEY, "default:want_to_read", "default:finished"];
		const customKeys = customShelves.map((shelf) => `custom:${shelf.id}`);
		const allKeys = [...defaultKeys, ...customKeys];
		const defaultOrder = defaultProfileSectionOrder(customKeys);
		const settings = ownerProfileData.settings && typeof ownerProfileData.settings === "object"
			? ownerProfileData.settings as Record<string, unknown>
			: {};
		const storedOrder = Array.isArray(settings.shelfSectionOrder)
			? settings.shelfSectionOrder.map((item) => String(item || "").trim()).filter(Boolean)
			: [];
		shelfSectionOrderKeys = mergeProfileSectionOrder(storedOrder, allKeys, defaultOrder);
		shelfSectionOrderByKey = new Map(shelfSectionOrderKeys.map((key, index) => [key, index]));
		customShelves = [...customShelves].sort((a, b) => {
			const aOrder = shelfSectionOrderByKey.get(`custom:${a.id}`) ?? Number.MAX_SAFE_INTEGER;
			const bOrder = shelfSectionOrderByKey.get(`custom:${b.id}`) ?? Number.MAX_SAFE_INTEGER;
			return aOrder - bOrder || a.position - b.position || a.id - b.id;
		});
	} else {
		const customKeys = customShelves.map((shelf) => `custom:${shelf.id}`);
		shelfSectionOrderKeys = defaultProfileSectionOrder(customKeys);
		shelfSectionOrderByKey = new Map(shelfSectionOrderKeys.map((key, index) => [key, index]));
	}
	customShelfBooksByShelfId = customShelfBookRows.reduce((map, row) => {
		const shelfId = Math.max(0, Number(row.shelf_id || 0) || 0);
		const bookId = Math.max(0, Number(row.book_id || 0) || 0);
		if (!shelfId || !bookId) return map;
		const list = map.get(shelfId) || [];
		list.push({
			bookId,
			title: String(row.title || "").trim(),
			author: String(row.primary_author || "").trim(),
			authorId: Math.max(0, Number(row.author_id || 0) || 0),
			thumbnail: String(row.cover_url || "").trim(),
			language: String(row.language || "").trim(),
			isbn10: String(row.isbn10 || "").trim(),
			isbn13: String(row.isbn13 || "").trim(),
			description: "",
			status: String(row.status || "").trim(),
			rating: Math.max(0, Math.min(5, Number(row.rating || 0) || 0)),
			updatedAt: String(row.updated_at || "").trim(),
			genres: Array.isArray(row.genres) ? row.genres.map((genre) => String(genre || "").trim()).filter(Boolean) : []
		});
		map.set(shelfId, list);
		return map;
	}, new Map<number, Array<{
		bookId: number;
		title: string;
		author: string;
		authorId: number;
		thumbnail: string;
		language: string;
		isbn10: string;
		isbn13: string;
		description: string;
		status: string;
		rating: number;
		updatedAt: string;
		genres: string[];
	}>>());
	if (viewerUserId && (recentActivity.length > 0 || currentlyReading.length > 0 || wantToReadBooks.length > 0 || finishedBooks.length > 0 || customShelfBookRows.length > 0)) {
		const bookIds = Array.from(new Set([
			...recentActivity.map((item) => Number(item.bookId || 0)),
			...currentlyReading.map((item) => Number(item.bookId || 0)),
			...wantToReadBooks.map((item) => Number(item.bookId || 0)),
			...finishedBooks.map((item) => Number(item.bookId || 0)),
			...customShelfBookRows.map((item) => Number(item.book_id || 0))
		].filter((value) => value > 0)));
		if (bookIds.length > 0) {
			const rows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished" }>>`
				select book_id, status
				from user_book
				where user_id = ${viewerUserId}::uuid
					and book_id = any(${bookIds}::bigint[])
			`;
			viewerStatusByBookId = new Map(
				rows.map((row) => [Number(row.book_id || 0), row.status])
			);
		}
	}
}

function activityHeading(eventType: string) {
	const type = String(eventType || "").trim().toLowerCase();
	if (type === "reading") return { prefix: "Added to", shelf: "Currently Reading" };
	if (type === "finished") return { prefix: "Finished Reading", shelf: "" };
	if (type === "want_to_read") return { prefix: "Added to", shelf: "Want to Read" };
	if (type === "rating") return { prefix: "Rated this book", shelf: "" };
	return { prefix: "Added to", shelf: "Shelf" };
}

function renderRatingStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	return Array.from({ length: 5 }, (_, index) => (index < clamped ? "★" : "☆")).join("");
}

function statusLabel(status: string) {
	const normalized = String(status || "").trim();
	if (normalized === "reading") return "Currently Reading";
	if (normalized === "finished") return "Read";
	if (normalized === "want_to_read") return "Want to Read";
	return "Not on Shelf";
}

function formatActivityDate(value: string) {
	const parsed = new Date(String(value || "").trim());
	if (!Number.isFinite(parsed.getTime())) return "";
	return parsed.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric"
	});
}

function computeReadingStreakDays(items: Array<{ updatedAt: string }>) {
	if (items.length === 0) return 0;
	const seenDays = new Set<string>();
	for (const item of items) {
		const parsed = new Date(String(item.updatedAt || "").trim());
		if (!Number.isFinite(parsed.getTime())) continue;
		seenDays.add(parsed.toISOString().slice(0, 10));
	}
	if (seenDays.size === 0) return 0;
	let streak = 0;
	const cursor = new Date();
	while (true) {
		const key = cursor.toISOString().slice(0, 10);
		if (!seenDays.has(key)) break;
		streak += 1;
		cursor.setUTCDate(cursor.getUTCDate() - 1);
	}
	return streak;
}

function computeReadingStreakFromDateKeys(dateKeys: string[]) {
	const seenDays = new Set(
		dateKeys.map((key) => String(key || "").trim().slice(0, 10)).filter(Boolean)
	);
	if (seenDays.size === 0) return 0;
	let streak = 0;
	const cursor = new Date();
	while (true) {
		const key = cursor.toISOString().slice(0, 10);
		if (!seenDays.has(key)) break;
		streak += 1;
		cursor.setUTCDate(cursor.getUTCDate() - 1);
	}
	return streak;
}

function shelfHrefForOwner(sectionId: string) {
	const map: Record<string, string> = {
		want_to_read: "want-to-read",
		reading: "currently-reading",
		finished: "read",
		total: ""
	};
	const target = map[String(sectionId || "").trim()] || "recent-activity";
	return target ? `#${encodeURIComponent(target)}` : "#";
}

function paginate<T>(items: T[], page: number, pageSize: number) {
	const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
	const currentPage = Math.min(Math.max(1, page), totalPages);
	const start = (currentPage - 1) * pageSize;
	return {
		items: items.slice(start, start + pageSize),
		totalPages,
		currentPage
	};
}

function paginationHref(param: string, value: number, anchor: string) {
	const params = new URLSearchParams(Astro.url.searchParams);
	if (value <= 1) params.delete(param);
	else params.set(param, String(value));
	const query = params.toString();
	return `${Astro.url.pathname}${query ? `?${query}` : ""}#${anchor}`;
}

function defaultProfileSectionOrder(customKeys: string[]) {
	return [
		"default:reading",
		RECENT_ACTIVITY_SECTION_KEY,
		"default:want_to_read",
		"default:finished",
		...customKeys
	];
}

function mergeProfileSectionOrder(storedOrder: string[], allKeys: string[], defaultOrder: string[]) {
	const knownKeys = new Set(allKeys);
	const dedupedStored = Array.from(new Set(
		storedOrder
			.map((key) => String(key || "").trim())
			.filter((key) => knownKeys.has(key))
	));
	if (dedupedStored.length === 0) return defaultOrder.filter((key) => knownKeys.has(key));
	const merged = [...dedupedStored];
	for (const key of defaultOrder) {
		if (!knownKeys.has(key) || merged.includes(key)) continue;
		if (key === RECENT_ACTIVITY_SECTION_KEY) {
			const readingIndex = merged.indexOf("default:reading");
			if (readingIndex >= 0) merged.splice(readingIndex + 1, 0, key);
			else merged.unshift(key);
			continue;
		}
		merged.push(key);
	}
	return merged;
}

function shelfSectionOrderValue(key: string) {
	const value = shelfSectionOrderByKey.get(String(key || "").trim());
	return Number.isFinite(value as number) ? Number(value) : 999;
}

function shelfSectionOrderStyle(key: string) {
	return `order:${300 + shelfSectionOrderValue(key)}`;
}

function shelfSectionMoveAttrs(key: string, direction: "up" | "down") {
	const order = shelfSectionOrderKeys.length > 0
		? shelfSectionOrderKeys
		: defaultProfileSectionOrder(customShelves.map((shelf) => `custom:${shelf.id}`));
	const index = order.indexOf(key);
	const canMove = direction === "up"
		? index > 0
		: index >= 0 && index < order.length - 1;
	return canMove ? {} : { disabled: true, "aria-disabled": "true" };
}

const baseSectionLinks = [
	...(isOwnerViewer ? [{ id: "notifications", label: "Notifications" }] : []),
	{ id: "about", label: "About" },
	{ id: "shelf-summary", label: "Shelf Summary" }
];
const orderedShelfSectionLinks = isOwnerViewer
	? [
		{ id: "currently-reading", label: "Currently Reading", key: "default:reading" },
		{ id: "recent-activity", label: "Recent Activity", key: RECENT_ACTIVITY_SECTION_KEY },
		{ id: "want-to-read", label: "Want to Read", key: "default:want_to_read" },
		{ id: "read", label: "Read", key: "default:finished" },
		...customShelves.map((shelf) => ({
			id: `custom-shelf-${shelf.slug || shelf.id}`,
			label: shelf.name,
			key: `custom:${shelf.id}`
		}))
	]
		.sort((a, b) => shelfSectionOrderValue(String(a.key || "")) - shelfSectionOrderValue(String(b.key || "")))
		.map(({ id, label }) => ({ id, label }))
	: [
		{ id: "currently-reading", label: "Currently Reading" },
		{ id: "recent-activity", label: "Recent Activity" },
		{ id: "want-to-read", label: "Want to Read" },
		{ id: "read", label: "Read" }
	];
const sectionLinks = [...baseSectionLinks, ...orderedShelfSectionLinks];
const customShelfOptionsJson = JSON.stringify(customShelves.map((shelf) => ({
	id: shelf.id,
	name: shelf.name,
