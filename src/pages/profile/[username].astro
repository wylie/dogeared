			if (status === "finished") {
				const finishResult = await promptAndSaveFinishedEntry(entry);
				if (!finishResult.ok) return;
				rememberReadingActivityToday();
			}
			if (!entry.title) return;
			try {
				if (status !== "finished") {
					const result = await saveShelfEntryWithRetry(entry);
					if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
				}
				setDropdownLabel(dropdown, status);
				setShelvedState(dropdown, true);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
				removeCardFromShelfSection(dropdown, status);
				closeShelfMenus(shelfDropdowns);
				await refreshProfileReadingUiAfterMutation();
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
			}
			return;
		}
		const assignOption = target.closest('[data-action="assign-custom-shelf"]');
		if (assignOption) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = assignOption.closest(".shelf-dropdown");
			if (!(dropdown instanceof HTMLElement)) return;
			const shelfId = Math.max(0, Number(assignOption.getAttribute("data-shelf-id") || 0) || 0);
			const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
			if (!shelfId || !bookId) return;
			try {
				const result = await assignBookToCustomShelf(shelfId, bookId);
				if (!result.ok) throw new Error(String(result.data?.error || "Failed to assign custom shelf."));
				showShelfFeedback(dropdown, "Saved to custom shelf.", feedbackTimers);
				closeShelfMenus(shelfDropdowns);
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
			}
			return;
		}
		const removeOption = target.closest('[data-action="remove-from-shelves"]');
		if (removeOption) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = removeOption.closest(".shelf-dropdown");
			if (!(dropdown instanceof HTMLElement)) return;
			const bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
			const entry = buildEntryFromDropdown(dropdown, "want_to_read");
			try {
				const result = await removeBookFromAllShelves(bookId, entry);
				if (!result.ok) throw new Error(resolveShelfRemoveMessage(result));
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
				showShelfFeedback(dropdown, "Removed from shelves.", feedbackTimers);
				removeCardFromShelfSection(dropdown, "remove");
				closeShelfMenus(shelfDropdowns);
				await refreshProfileReadingUiAfterMutation();
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to remove.", feedbackTimers);
			}
			return;
		}
		if (target.closest(".shelf-dropdown")) return;
		closeShelfMenus(shelfDropdowns);
