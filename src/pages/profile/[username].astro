	async function moveCustomShelf(shelfId, direction) {
		const rows = Array.from(document.querySelectorAll("[data-custom-shelf-row]"));
		const index = rows.findIndex((row) => Number(row.getAttribute("data-shelf-id") || 0) === shelfId);
		if (index < 0) return { ok: false, data: { error: "Shelf not found." } };
		const targetIndex = direction === "up" ? index - 1 : index + 1;
		if (targetIndex < 0 || targetIndex >= rows.length) return { ok: false, data: { error: "Cannot move shelf further." } };
		const targetRow = rows[targetIndex];
		if (!(targetRow instanceof HTMLElement)) return { ok: false, data: { error: "Invalid shelf target." } };
		const targetShelfId = Math.max(0, Number(targetRow.dataset.shelfId || 0) || 0);
		if (!targetShelfId) return { ok: false, data: { error: "Invalid shelf target." } };

		const response = await fetch("/api/shelf/custom-shelves", {
			method: "PATCH",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ shelfId, swapWithShelfId: targetShelfId })
		});
		const data = await response.json().catch(() => ({}));
		return { ok: response.ok, status: response.status, data };
	}

