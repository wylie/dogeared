	let lastActiveReadingRevalidationAt = 0;
	function revalidateReadingSummaryWhenActive() {
		if (document.hidden) return;
		const now = Date.now();
		if (now - lastActiveReadingRevalidationAt < 5000) return;
		lastActiveReadingRevalidationAt = now;
		void refreshProfileReadingUiAfterMutation({ notify: false });
	}

	document.addEventListener("visibilitychange", () => {
		if (document.visibilityState === "visible") revalidateReadingSummaryWhenActive();
	});
	window.addEventListener("focus", () => revalidateReadingSummaryWhenActive());
	window.addEventListener("storage", (event) => {
		if (event.key === "dogeared:reading-data-changed-at") revalidateReadingSummaryWhenActive();
	});
	try {
		const readingDataChannel = new BroadcastChannel("dogeared:reading-data");
		readingDataChannel.addEventListener("message", (event) => {
			if (event?.data?.type === "changed") revalidateReadingSummaryWhenActive();
		});
	} catch {
		// Focus and visibility refresh still cover inactive tabs and other devices.
	}
