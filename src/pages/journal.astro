---
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import { resolveUserBySession } from "../lib/auth";
import { getNeonSql } from "../lib/neon";
import { countJournalEntries, formatReadingPosition, searchJournalEntries, type JournalSearchResult } from "../lib/readingJournal";

export const prerender = false;

const session = await resolveUserBySession(Astro.request);
const viewerUserId = session?.userId || "";
const query = String(Astro.url.searchParams.get("q") || "").replace(/\s+/g, " ").trim();
const filterBookId = Math.max(0, Number(Astro.url.searchParams.get("bookId") || 0) || 0);
const filterDate = String(Astro.url.searchParams.get("date") || "").trim().slice(0, 10);
const requestedPage = Math.max(1, Number(Astro.url.searchParams.get("page") || 1) || 1);
const pageSize = 20;
const initialReadingPositionType = String(
	Astro.url.searchParams.get("readingPositionType")
	|| Astro.url.searchParams.get("positionType")
	|| (Astro.url.searchParams.get("pageNumber") ? "page" : "")
	|| (Astro.url.searchParams.get("progressSnapshot") ? "percent" : "")
).trim();
const initialReadingPositionValue = String(Astro.url.searchParams.get("readingPositionValue") || Astro.url.searchParams.get("positionValue") || Astro.url.searchParams.get("pageNumber") || Astro.url.searchParams.get("progressSnapshot") || "").trim();
let entries: JournalSearchResult[] = [];
let ownedBookOptions: Array<{ id: number; title: string; author: string }> = [];
let loadError = "";
let totalJournalEntries = 0;
let totalPages = 1;
let currentPage = requestedPage;

if (viewerUserId) {
	try {
		const sql = getNeonSql();
		totalJournalEntries = await countJournalEntries(sql, viewerUserId, query, filterBookId, { date: filterDate });
		totalPages = Math.max(1, Math.ceil(totalJournalEntries / pageSize));
		currentPage = Math.min(requestedPage, totalPages);
		entries = await searchJournalEntries(sql, viewerUserId, query, pageSize, filterBookId, {
			date: filterDate,
			offset: (currentPage - 1) * pageSize
		});
		const rows = await sql<Array<{ id: number; title: string | null; primary_author: string | null }>>`
			select
				b.id,
				b.title,
				b.primary_author
			from user_book ub
			join book b on b.id = ub.book_id
			where ub.user_id = ${viewerUserId}::uuid
			order by lower(coalesce(b.title, '')) asc, b.id asc
			limit 500
		`;
		ownedBookOptions = rows.map((row) => ({
			id: Math.max(0, Number(row.id || 0) || 0),
			title: String(row.title || "").trim() || "Untitled book",
			author: String(row.primary_author || "").trim()
		})).filter((book) => book.id > 0);
	} catch (error) {
		loadError = error instanceof Error ? error.message : "Failed to load journal.";
	}
}

function formatDate(value: string) {
	const date = new Date(String(value || ""));
	if (!Number.isFinite(date.getTime())) return "";
	return new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" }).format(date);
}

function dateTimeInput(value: string) {
	const date = new Date(String(value || ""));
	if (!Number.isFinite(date.getTime())) return "";
	const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
	return local.toISOString().slice(0, 16);
}

function bookHref(entry: JournalSearchResult) {
	return entry.bookId ? `/book?bookId=${encodeURIComponent(String(entry.bookId))}#reading-journal` : "/journal";
}

function bookLabel(book: { title: string; author: string }) {
	return `${book.title}${book.author ? ` by ${book.author}` : ""}`;
}

function bookLabelById(bookId: number) {
	const match = ownedBookOptions.find((book) => book.id === bookId);
	return match ? bookLabel(match) : "";
}

function entryBookLabel(entry: JournalSearchResult) {
	return entry.title ? `${entry.title}${entry.author ? ` by ${entry.author}` : ""}` : "";
}

function excerptFor(entry: JournalSearchResult) {
	const text = String(entry.body || "").replace(/\s+/g, " ").trim();
	return text.length > 220 ? `${text.slice(0, 217).trim()}...` : text;
}

function pageHref(page: number) {
	const params = new URLSearchParams();
	if (query) params.set("q", query);
	if (filterBookId > 0) params.set("bookId", String(filterBookId));
	if (filterDate) params.set("date", filterDate);
	if (page > 1) params.set("page", String(page));
	const suffix = params.toString();
	return suffix ? `/journal?${suffix}#journal-entries` : "/journal#journal-entries";
}

const sectionLinks = viewerUserId ? [
	{ id: "new-entry", label: "New Entry" },
	{ id: "journal-search", label: "Search" },
	{ id: "journal-entries", label: "Entries" }
] : [];
---

<Layout title="Reading Journal" sectionLinks={sectionLinks} metaDescription="Search and write your private DogEared reading journal." canonicalUrl="/journal" robots="noindex,nofollow">
	<div slot="right" class="journal-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span aria-hidden="true">/</span><span>Reading Journal</span>
		</nav>

		{!viewerUserId ? (
			<section class="journal-state-card">
				<h1>Reading Journal</h1>
				<p>Your journal is private. Log in to write, search, and revisit personal notes for your books.</p>
				<a class="primary-link" href={`/?next=${encodeURIComponent("/journal")}`}>Log in</a>
			</section>
		) : (
			<>
				<section class="journal-hero" id="journal-search">
					<div class="journal-hero-head">
						<div>
							<p class="journal-eyebrow">Private notebook</p>
							<h1>Reading Journal</h1>
							<p>Capture what you are thinking while you read. Search your own notes, tags, books, dates, and moods. Entries are private and never appear on profiles or activity feeds.</p>
						</div>
						<a class="journal-button journal-button-primary journal-button-compact" href="#new-entry" data-action="new-journal-entry">New Entry</a>
					</div>
					<form class="journal-search-form" action="/journal" method="get">
						<label class="journal-field" for="journal-query">
							<span>Search journal</span>
							<input id="journal-query" type="search" name="q" value={query} placeholder="Notes, tags, books, or moods" />
						</label>
						<label class="journal-field" for="journal-book-filter-label">
							<span>Book</span>
							<input type="hidden" id="journal-book-filter" name="bookId" value={filterBookId > 0 ? String(filterBookId) : ""} data-book-id-field />
							<input id="journal-book-filter-label" type="search" value={bookLabelById(filterBookId)} placeholder="All books" list="journal-owned-books" data-book-picker />
						</label>
						<label class="journal-field" for="journal-date-filter">
							<span>Date</span>
							<input id="journal-date-filter" type="date" name="date" value={filterDate} />
						</label>
						<div class="journal-search-actions">
							<button type="submit" class="journal-button journal-button-primary journal-button-compact">Search</button>
							{(query || filterBookId || filterDate) && <a class="journal-button journal-button-secondary journal-button-compact" href="/journal">Clear</a>}
						</div>
					</form>
					<datalist id="journal-owned-books">
						{ownedBookOptions.map((book) => <option value={bookLabel(book)} data-book-id={String(book.id)} />)}
					</datalist>
					<script type="application/json" id="journal-owned-books-data" set:html={JSON.stringify(ownedBookOptions.map((book) => ({ ...book, label: bookLabel(book) })))}></script>
				</section>

				<section class="journal-editor" id="new-entry" data-guided-anchor="journal-entry-form" aria-labelledby="journal-editor-title" tabindex="-1">
					<div class="journal-results-head">
						<div>
							<p class="journal-eyebrow">Private entry</p>
							<h2 id="journal-editor-title">New Entry</h2>
						</div>
						<p data-editor-mode>New entry</p>
					</div>
					<form class="journal-entry-form" data-journal-entry-form>
						<input type="hidden" name="id" value="" />
						<div class="journal-grid-two">
							<label><span>Title <em>optional</em></span><input type="text" name="entryTitle" maxlength="160" placeholder="A thought to remember" /></label>
							<label><span>Date and time</span><input type="datetime-local" name="entryAt" value={dateTimeInput(new Date().toISOString())} /></label>
						</div>
						<label><span>Body</span><textarea name="body" rows="8" maxlength="8000" required placeholder="What do you want to remember?"></textarea></label>
						<div class="journal-grid-two">
							<label>
								<span>Book <em>optional</em></span>
								<input type="hidden" name="bookId" value={filterBookId > 0 ? String(filterBookId) : ""} data-book-id-field />
								<input type="search" name="bookLabel" value={bookLabelById(filterBookId)} placeholder="General note" list="journal-owned-books" autocomplete="off" data-book-picker />
							</label>
							<label>
								<span>Reading position <em>optional</em></span>
								<div class="position-row">
									<select name="readingPositionType" aria-label="Reading position type">
										<option value="">No position</option>
										<option value="page" selected={initialReadingPositionType === "page"}>Page</option>
										<option value="percent" selected={initialReadingPositionType === "percent"}>Percent</option>
										<option value="chapter" selected={initialReadingPositionType === "chapter"}>Chapter</option>
										<option value="location" selected={initialReadingPositionType === "location"}>Location</option>
										<option value="audio" selected={initialReadingPositionType === "audio"}>Audiobook time</option>
									</select>
									<input type="text" name="readingPositionValue" maxlength="160" placeholder="20, 58%, Chapter 4, Kindle location 1234, or 1h 20m" value={initialReadingPositionValue} />
								</div>
							</label>
						</div>
						<div class="journal-grid-two">
							<label><span>Mood <em>optional</em></span><input type="text" name="mood" maxlength="80" /></label>
							<label><span>Personal tags <em>optional</em></span><input type="text" name="personalTags" maxlength="400" placeholder="quiet, quote, book club" /></label>
						</div>
						<div class="journal-actions">
							<div class="journal-action-buttons">
								<button type="submit" class="journal-button journal-button-primary" data-journal-save>Save entry</button>
								<button type="button" class="journal-button journal-button-secondary" data-journal-reset>Clear</button>
							</div>
							<div class="journal-form-meta">
								<p class="journal-status" data-journal-status role="status" aria-live="polite">Drafts autosave on this device.</p>
								<p class="journal-count" data-journal-count>0 characters</p>
							</div>
						</div>
					</form>
				</section>

				<section class="journal-results" id="journal-entries">
					<div class="journal-results-head">
						<h2>{query || filterBookId || filterDate ? "Filtered Entries" : "Journal Timeline"}</h2>
						<p>Newest first · page {currentPage.toLocaleString()}</p>
					</div>
					{loadError ? (
						<p class="journal-empty">{loadError}</p>
					) : entries.length === 0 ? (
						<div class="journal-empty-state">
							<h3>{query || filterBookId || filterDate ? "No journal entries matched those filters." : "Start a private record of your reading life."}</h3>
							<p>{query || filterBookId || filterDate ? "Try clearing the filters or searching for a different phrase." : "Use the Reading Journal for thoughts, favorite quotes, questions, predictions, interesting passages, and small reading moments that do not belong in a public review."}</p>
							<p>{query || filterBookId || filterDate ? "Your journal remains private even when filtered." : "Entries are private by default and never appear on public profiles, comments, feeds, or recent activity."}</p>
							<a class="journal-button journal-button-primary journal-button-compact" href="#new-entry">Create your first journal entry</a>
						</div>
					) : (
						<>
							<ul class="journal-entry-list">
								{entries.map((entry) => (
									<li
										class="journal-entry-card"
										data-entry-id={String(entry.id || 0)}
										data-entry-title={entry.entryTitle || ""}
										data-body={entry.body || ""}
										data-entry-at={dateTimeInput(entry.entryAt || entry.updatedAt)}
										data-book-id={String(entry.bookId || "")}
										data-book-label={entryBookLabel(entry)}
										data-reading-position-type={entry.readingPositionType || ""}
										data-reading-position-value={entry.readingPositionValue || ""}
										data-mood={entry.mood || ""}
										data-personal-tags={(entry.personalTags || []).join(", ")}
									>
										<a class="journal-entry-cover-link" href={bookHref(entry)} aria-label={entry.title ? `Open ${entry.title}` : "Open journal"}>
											{entry.coverUrl ? <img src={entry.coverUrl} alt="" loading="lazy" decoding="async" width="52" height="76" /> : <span class="journal-cover-placeholder" aria-hidden="true">book</span>}
										</a>
										<div class="journal-entry-main">
											<h3>{entry.entryTitle || entry.title || "Untitled journal entry"}</h3>
											<dl class="journal-entry-meta">
												{entry.title && (
													<div>
														<dt>Book</dt>
														<dd><a href={bookHref(entry)}>{entryBookLabel(entry)}</a></dd>
													</div>
												)}
												{formatDate(entry.createdAt || entry.entryAt || entry.updatedAt) && (
													<div>
														<dt>Date</dt>
														<dd>{formatDate(entry.createdAt || entry.entryAt || entry.updatedAt)}</dd>
													</div>
												)}
												{formatReadingPosition(entry.readingPositionType, entry.readingPositionValue) && (
													<div>
														<dt>Position</dt>
														<dd>{formatReadingPosition(entry.readingPositionType, entry.readingPositionValue)}</dd>
													</div>
												)}
												{entry.mood && (
													<div>
														<dt>Mood</dt>
														<dd>{entry.mood}</dd>
													</div>
												)}
											</dl>
											{excerptFor(entry) && <p class="journal-entry-excerpt">{excerptFor(entry)}</p>}
											<div class="journal-entry-detail" hidden>
												<p>{entry.body}</p>
											</div>
											{entry.personalTags.length > 0 && <ul class="journal-tags" aria-label="Personal tags">{entry.personalTags.map((tag) => <li>{tag}</li>)}</ul>}
											<div class="journal-entry-actions">
												<button type="button" class="journal-button journal-button-secondary journal-button-small" data-action="view-journal-entry" aria-expanded="false">View</button>
												<button type="button" class="journal-button journal-button-secondary journal-button-small" data-action="edit-journal-entry">Edit</button>
												<button type="button" class="journal-button journal-button-danger journal-button-small" data-action="delete-journal-entry">Delete</button>
											</div>
										</div>
									</li>
								))}
							</ul>
							{totalPages > 1 && (
								<Pagination
									currentPage={currentPage}
									totalPages={totalPages}
									previousHref={currentPage > 1 ? pageHref(currentPage - 1) : ""}
									nextHref={currentPage < totalPages ? pageHref(currentPage + 1) : ""}
									label="Journal pagination"
								/>
							)}
						</>
					)}
				</section>
			</>
		)}
	</div>
</Layout>

<script>
	const form = document.querySelector("[data-journal-entry-form]");
	if (form instanceof HTMLFormElement) {
		const status = document.querySelector("[data-journal-status]");
		const count = document.querySelector("[data-journal-count]");
		const mode = document.querySelector("[data-editor-mode]");
		const draftKey = "dogeared:journal-page-draft";
		let ownedBooks = [];
		try {
			const node = document.getElementById("journal-owned-books-data");
			ownedBooks = JSON.parse(node?.textContent || "[]");
		} catch {
			ownedBooks = [];
		}
		const fields = ["id", "entryTitle", "entryAt", "body", "bookId", "bookLabel", "readingPositionType", "readingPositionValue", "mood", "personalTags"];
		const setStatus = (message) => { if (status instanceof HTMLElement) status.textContent = message; };
		const field = (name) => form.elements.namedItem(name);
		const normalizeBookLabel = (value) => String(value || "").replace(/\s+/g, " ").trim().toLowerCase();
		const resolveBookId = (label) => {
			const normalized = normalizeBookLabel(label);
			if (!normalized) return "";
			const match = ownedBooks.find((book) => normalizeBookLabel(book.label) === normalized);
			return match?.id ? String(match.id) : "";
		};
		const syncBookPicker = (picker) => {
			const label = String(picker?.value || "").trim();
			const wrap = picker?.closest("form") || picker?.parentElement;
			const idField = wrap?.querySelector("[data-book-id-field]");
			if (idField instanceof HTMLInputElement) idField.value = resolveBookId(label);
		};
		const readPayload = () => Object.fromEntries(fields.map((name) => {
			const item = field(name);
			return [name, item instanceof HTMLInputElement || item instanceof HTMLTextAreaElement || item instanceof HTMLSelectElement ? item.value : ""];
		}));
		const writePayload = (payload = {}) => {
			for (const name of fields) {
				const item = field(name);
				if (item instanceof HTMLInputElement || item instanceof HTMLTextAreaElement || item instanceof HTMLSelectElement) item.value = String(payload[name] || "");
			}
			const picker = field("bookLabel");
			if (picker instanceof HTMLInputElement) syncBookPicker(picker);
			if (!String(payload.entryAt || "").trim()) {
				const entryAt = field("entryAt");
				if (entryAt instanceof HTMLInputElement) {
					const now = new Date();
					const local = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
					entryAt.value = local.toISOString().slice(0, 16);
				}
			}
		};
		const updateCount = () => {
			const body = String(readPayload().body || "");
			if (count instanceof HTMLElement) count.textContent = `${body.length.toLocaleString()} ${body.length === 1 ? "character" : "characters"}`;
		};
		const rememberDraft = () => {
			try { window.localStorage.setItem(draftKey, JSON.stringify(readPayload())); } catch {}
			updateCount();
			setStatus("Draft saved on this device.");
		};
		try {
			const raw = window.localStorage.getItem(draftKey);
			if (raw) {
				const draft = JSON.parse(raw);
				if (draft?.body) {
					writePayload(draft);
					setStatus("Recovered an unsaved local draft.");
				}
			}
		} catch {}
		updateCount();
		form.addEventListener("input", rememberDraft);
		document.querySelectorAll("[data-book-picker]").forEach((picker) => {
			if (!(picker instanceof HTMLInputElement)) return;
			picker.addEventListener("input", () => syncBookPicker(picker));
			picker.addEventListener("change", () => syncBookPicker(picker));
		});
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const payload = readPayload();
			if (!String(payload.body || "").trim()) {
				setStatus("Write a body before saving.");
				return;
			}
			if (String(payload.readingPositionValue || "").trim() && !String(payload.readingPositionType || "").trim()) {
				setStatus("Choose a reading position type or clear the position value.");
				return;
			}
			const bookLabel = String(payload.bookLabel || "").trim();
			if (bookLabel && !String(payload.bookId || "").trim()) {
				setStatus("Choose a saved book from the list, or clear the book field for a general note.");
				return;
			}
			setStatus("Saving...");
			const response = await fetch("/api/journal/entries", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				credentials: "same-origin",
				body: JSON.stringify(payload)
			});
			const data = await response.json().catch(() => ({}));
			if (!response.ok) {
				setStatus(String(data?.error || "Failed to save entry."));
				return;
			}
			try { window.localStorage.removeItem(draftKey); } catch {}
			try {
				await fetch("/api/guidance/status", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "same-origin",
					body: JSON.stringify({ action: "mark-onboarding-action", actionId: "first-journal-entry" })
				});
				window.dispatchEvent(new CustomEvent("dogeared:reading-data-changed"));
			} catch {
				// Journal save succeeded; onboarding progress can catch up from server stats.
			}
			setStatus("Saved privately. Refreshing...");
			window.location.href = "/journal";
		});
		document.querySelector("[data-journal-reset]")?.addEventListener("click", () => {
			writePayload({});
			try { window.localStorage.removeItem(draftKey); } catch {}
			if (mode instanceof HTMLElement) mode.textContent = "New entry";
			setStatus("Cleared.");
			updateCount();
		});
		document.addEventListener("click", async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const card = target.closest(".journal-entry-card");
			if (!(card instanceof HTMLElement)) return;
			if (target.closest('[data-action="view-journal-entry"]')) {
				const detail = card.querySelector(".journal-entry-detail");
				const button = target.closest('[data-action="view-journal-entry"]');
				if (detail instanceof HTMLElement && button instanceof HTMLButtonElement) {
					const expanded = button.getAttribute("aria-expanded") === "true";
					detail.hidden = expanded;
					button.setAttribute("aria-expanded", String(!expanded));
					button.textContent = expanded ? "View" : "Hide";
				}
			}
			if (target.closest('[data-action="edit-journal-entry"]')) {
				writePayload(card.dataset);
				if (mode instanceof HTMLElement) mode.textContent = "Editing entry";
				document.getElementById("new-entry")?.scrollIntoView({ behavior: "smooth", block: "start" });
				setStatus("Editing existing entry.");
				updateCount();
			}
			if (target.closest('[data-action="delete-journal-entry"]')) {
				const id = Number(card.dataset.entryId || 0);
				if (!id || !window.confirm("Delete this private journal entry?")) return;
				const response = await fetch(`/api/journal/entries?id=${encodeURIComponent(String(id))}`, { method: "DELETE", credentials: "same-origin" });
				const data = await response.json().catch(() => ({}));
				if (!response.ok) {
					setStatus(String(data?.error || "Failed to delete entry."));
					return;
				}
				card.remove();
				setStatus("Journal entry deleted.");
			}
		});
	}
</script>

<style>
	.journal-page { max-width: 980px; }
	.breadcrumbs { display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; margin: 0 0 0.65rem; font-size: 0.84rem; color: var(--color-text-subtle); }
	.breadcrumbs a, .journal-entry-meta a { color: var(--color-nav); text-decoration: none; }
	.breadcrumbs a:hover, .journal-entry-meta a:hover { color: var(--color-nav-hover); text-decoration: underline; text-underline-offset: 2px; }
	.journal-state-card, .journal-hero, .journal-editor, .journal-results { border: var(--border-subtle); border-radius: var(--radius-lg); background: var(--color-surface-raised); padding: clamp(0.9rem, 2vw, 1.2rem); }
	.journal-hero, .journal-editor, .journal-results { margin-top: 1rem; }
	.journal-hero-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: start; }
	.journal-eyebrow { margin: 0 0 0.25rem; color: var(--color-text-subtle); font-size: 0.78rem; font-weight: 760; text-transform: uppercase; letter-spacing: 0; }
	.journal-state-card h1, .journal-hero h1, .journal-editor h2, .journal-results h2 { margin: 0 0 0.45rem; }
	.journal-state-card p, .journal-hero p, .journal-results-head p, .journal-empty, .journal-status, .journal-count { margin: 0; color: var(--color-text-muted); line-height: 1.45; }
