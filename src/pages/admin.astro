---
import Layout from "../layouts/Layout.astro";
import { resolveAdminSession } from "../lib/admin";
import { getNeonSql } from "../lib/neon";
import {
	emptyAdminOperationsSummary,
	emptyAdminOverviewStats,
	loadAdminOperationsSummary,
	loadAdminOverviewStats
} from "../lib/adminData";
import { formatNumber, safeAdminLoad } from "../lib/adminFormatting";

export const prerender = false;

const admin = await resolveAdminSession(Astro.request);
if (!admin.isAdmin) return Astro.redirect("/");

const sql = getNeonSql();
const [statsResult, operationsResult] = await Promise.all([
	safeAdminLoad("Site statistics", () => loadAdminOverviewStats(sql), emptyAdminOverviewStats()),
	safeAdminLoad("Operations snapshot", () => loadAdminOperationsSummary(sql), emptyAdminOperationsSummary())
]);
const stats = statsResult.data;
const operations = operationsResult.data;
const adminWarnings = [statsResult.warning, operationsResult.warning].filter(Boolean);

const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "operations", label: "Operations" },
	{ id: "site-statistics", label: "Statistics" },
	{ id: "recent-activity", label: "Activity" }
];

const statCards = [
	{ label: "Total books", value: stats.totalBooks },
	{ label: "Total authors", value: stats.totalAuthors },
	{ label: "Total users", value: stats.totalUsers },
	{ label: "Total shelf entries", value: stats.totalShelfEntries },
	{ label: "Total reviews", value: stats.totalReviews },
	{ label: "Total comments", value: stats.totalComments },
	{ label: "Currently Reading", value: stats.totalCurrentlyReading },
	{ label: "Completed books", value: stats.totalCompleted }
];

const quickLinks = [
	{ href: "/admin/founding-readers", label: "Founding Readers", value: operations.growth.totalUsers, copy: "Access, capacity, and early reader onboarding." },
	{ href: "/admin/analytics#community", label: "Engagement", value: operations.engagement.activeUsersWeek, copy: "Active readers, activity, comments, and social signals." },
	{ href: "/admin/data-health", label: "Content", value: operations.content.totalBooks, copy: "Catalog depth, metadata gaps, and duplicate risk." },
	{ href: "/admin/feedback", label: "Feedback", value: operations.feedback.open, copy: "Open Founding Reader reports and operational follow-up." },
	{ href: "/admin/operations#notifications", label: "Notifications", value: operations.notifications.unread, copy: "Unread in-app notification state." },
	{ href: "/admin/operations#recommendations", label: "Recommendations", value: operations.recommendations.clicks, copy: "Recommendation telemetry and source health." },
	{ href: "/admin/analytics#search", label: "Search", value: operations.search.indexedBooks, copy: "Search coverage and no-result diagnostics." },
	{ href: "/admin/operations#imports", label: "Imports", value: operations.imports.missingMetadata, copy: "Shelf import quality and missing metadata." },
	{ href: "/admin/operations#system-health", label: "System Health", value: operations.system.failedJobs, copy: "API, email, jobs, search indexing, and cache status." }
];
---

<Layout title="Admin Overview" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="admin-page">
		<header id="overview" class="hero">
			<h1>Admin Overview</h1>
			<p>A calm control surface for DogEared operations.</p>
		</header>

		{adminWarnings.length > 0 && (
			<div class="warning-list" role="status">
				{adminWarnings.map((warning) => <p>{warning}</p>)}
			</div>
		)}

		<section class="panel" id="site-statistics">
			<div class="panel-head">
				<h2>Site Statistics</h2>
			</div>
			<div class="grid stats-grid">
				{statCards.map((card) => (
					<article class="stat">
						<p>{card.label}</p>
						<strong>{formatNumber(card.value)}</strong>
					</article>
				))}
			</div>
		</section>

		<section class="panel" id="operations">
			<div class="panel-head">
				<h2>Operations</h2>
				<p>Concise Founding Reader health cards with drill-down links.</p>
			</div>
			<div class="quick-link-grid">
				{quickLinks.map((link) => (
					<a class="quick-link" href={link.href}>
						<span>{link.label}</span>
						<strong>{formatNumber(link.value)}</strong>
						<span>{link.copy}</span>
					</a>
				))}
			</div>
		</section>

		<section class="panel" id="recent-activity">
			<div class="panel-head">
				<h2>Recent Activity</h2>
				<p>New activity from the past 7 days.</p>
			</div>
			<div class="grid recent-grid">
				<article class="stat">
					<p>New users this week</p>
					<strong>{formatNumber(stats.newUsersThisWeek)}</strong>
				</article>
				<article class="stat">
					<p>New books added this week</p>
					<strong>{formatNumber(stats.newBooksThisWeek)}</strong>
				</article>
				<article class="stat">
					<p>Reviews added this week</p>
					<strong>{formatNumber(stats.reviewsThisWeek)}</strong>
				</article>
			</div>
		</section>
	</div>
</Layout>

<style>
	.admin-page { max-width: 980px; }
	.hero h1 { margin: 0; }
	.hero p { margin: 0.35rem 0 0; color: var(--color-text-muted); }
	.warning-list {
		margin-top: 1rem;
		border: var(--border-subtle);
		border-radius: var(--radius-md);
		background: #fffaf0;
		color: #6b3f0a;
		padding: 0.65rem 0.75rem;
	}
	.warning-list p { margin: 0; }
	.warning-list p + p { margin-top: 0.3rem; }
	.panel { margin-top: 1rem; border: var(--border-subtle); border-radius: var(--radius-lg); background: var(--color-surface-raised); padding: 1rem; }
	.panel-head h2 { margin: 0; }
	.panel-head p { margin: 0.3rem 0 0; color: #575757; font-size: 0.9rem; }
	.grid { display: grid; gap: 0.55rem; margin-top: 0.7rem; }
	.stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	.recent-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.stat { border: var(--border-subtle); border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.56); padding: 0.6rem; }
	.stat p { margin: 0; color: #606060; font-size: 0.82rem; }
	.stat strong { display: block; margin-top: 0.2rem; font-size: 1.2rem; }
	.quick-link-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; margin-top: 0.7rem; }
	.quick-link {
		display: grid;
		gap: 0.2rem;
		padding: 0.7rem;
		border-radius: var(--radius-md);
		background: #f7fafc;
		color: inherit;
		text-decoration: none;
		border: var(--border-subtle);
	}
	.quick-link:hover { border-color: var(--color-border); background: var(--color-nav-surface-hover); }
	.quick-link > span:first-child { color: #606060; font-size: 0.82rem; font-weight: 700; }
	.quick-link strong { color: var(--color-nav); font-size: 1.2rem; }
	.quick-link span { color: #575757; font-size: 0.88rem; line-height: 1.35; }

	@media (max-width: 900px) {
		.stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.recent-grid,
		.quick-link-grid { grid-template-columns: 1fr; }
	}
</style>
