---
import Layout from "../layouts/Layout.astro";
import BookCard from "../components/BookCard.astro";
import ShelfDropdown from "../components/ShelfDropdown.astro";

import { getNeonSql } from "../lib/neon";
import { authorHref } from "../lib/author";
import { resolveUserBySession } from "../lib/auth";
import { resolveViewerStatusByBookId } from "../lib/feed";

export const prerender = false;

type BookStatsRow = {
	id: number;
	title: string;
	author: string;
	author_id: number | null;
	cover_url: string;
	synopsis: string;
	language: string;
	isbn10: string;
	isbn13: string;
	published_year: number;
	page_count: number;
	readers: number;
	shelves: number;
	rating_avg: number | null;
	rating_count: number;
	recent_readers_30d: number;
	recent_shelves_30d: number;
	last_activity: string | null;
};

type CuratedSection = {
	id: string;
	title: string;
	subtitle: string;
	books: BookStatsRow[];
};

const sql = getNeonSql();
const session = await resolveUserBySession(Astro.request);
const viewerUserId = String(session?.userId || "");
const rows = await sql<BookStatsRow[]>`
	with stats as (
		select
			b.id,
			b.title,
			coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
			b.author_id,
			coalesce(nullif(trim(b.cover_url), ''), '') as cover_url,
			coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
			coalesce(nullif(trim(b.language), ''), '') as language,
			coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
			coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
			coalesce(b.published_year, 0)::int as published_year,
			coalesce(nullif(b.page_count, 0), 0)::int as page_count,
			count(distinct ub.user_id)::int as readers,
			count(ub.book_id)::int as shelves,
			round(avg(ub.rating)::numeric, 2) as rating_avg,
			count(*) filter (where ub.rating is not null)::int as rating_count,
			count(distinct ub.user_id) filter (
				where ub.updated_at >= now() - interval '30 day'
			)::int as recent_readers_30d,
			count(ub.book_id) filter (
				where ub.updated_at >= now() - interval '30 day'
			)::int as recent_shelves_30d,
			max(coalesce(ub.updated_at, b.updated_at, b.created_at))::text as last_activity
		from book b
		left join user_book ub on ub.book_id = b.id
		group by
			b.id, b.title, b.primary_author, b.author_id, b.cover_url,
			b.synopsis, b.language, b.isbn10, b.isbn13, b.published_year, b.page_count
	)
	select *
	from stats
	where shelves > 0
`;
const viewerStatusByBookId = viewerUserId
	? await resolveViewerStatusByBookId(viewerUserId, rows.map((row) => Number(row.id || 0)))
	: new Map<number, "want_to_read" | "reading" | "finished">();

const byTrending = [...rows].sort((a, b) => {
	const scoreA = (a.recent_readers_30d * 5) + (a.recent_shelves_30d * 3) + (Number(a.rating_avg || 0) * 2);
	const scoreB = (b.recent_readers_30d * 5) + (b.recent_shelves_30d * 3) + (Number(b.rating_avg || 0) * 2);
	return scoreB - scoreA || b.readers - a.readers || a.title.localeCompare(b.title);
});
const byShelves = [...rows].sort((a, b) => b.shelves - a.shelves || b.readers - a.readers || a.title.localeCompare(b.title));
const byRating = [...rows]
	.filter((row) => Number(row.rating_count || 0) >= 3)
	.sort((a, b) => Number(b.rating_avg || 0) - Number(a.rating_avg || 0) || b.rating_count - a.rating_count || a.title.localeCompare(b.title));
const byRecent = [...rows].sort((a, b) => {
	const at = new Date(a.last_activity || 0).getTime();
	const bt = new Date(b.last_activity || 0).getTime();
	return bt - at || b.recent_shelves_30d - a.recent_shelves_30d || a.title.localeCompare(b.title);
});

function uniqueBooks(items: BookStatsRow[], used: Set<number>, max = 8) {
	const result: BookStatsRow[] = [];
	for (const item of items) {
		if (used.has(Number(item.id || 0))) continue;
		result.push(item);
		used.add(Number(item.id || 0));
		if (result.length >= max) break;
	}
	return result;
}

const used = new Set<number>();
const sections: CuratedSection[] = [
	{
		id: "trending",
		title: "Trending Now",
		subtitle: "Books with the strongest recent shelf activity in the past 30 days.",
		books: uniqueBooks(byTrending, used)
	},
	{
		id: "most-shelved",
		title: "Most Shelved",
		subtitle: "Books that appear on the most shelves across Dogeared.",
		books: uniqueBooks(byShelves, used)
	},
	{
		id: "top-rated",
		title: "Top Rated",
		subtitle: "Highest-rated books with at least 3 ratings.",
		books: uniqueBooks(byRating, used)
	},
	{
		id: "recent-activity",
		title: "Recently Active",
		subtitle: "Books readers have updated most recently.",
		books: uniqueBooks(byRecent, used)
	}
].filter((section) => section.books.length > 0);

const totalCuratedBooks = sections.reduce((sum, section) => sum + section.books.length, 0);
const booksStructuredData = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: "Books",
		description: "Curated books in Dogeared based on shelf activity.",
		url: "/books"
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: "/" },
			{ "@type": "ListItem", position: 2, name: "Books", item: "/books" }
		]
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: "Curated Books",
		itemListElement: sections
			.flatMap((section) => section.books)
			.slice(0, 24)
			.map((book, index) => ({
				"@type": "ListItem",
				position: index + 1,
				url: `/book?bookId=${encodeURIComponent(String(book.id))}`,
				name: book.title
			}))
	}
]);
---

<Layout
	title="Books"
	metaDescription="Explore curated books in Dogeared: trending now, most shelved, top rated, and recently active picks."
	canonicalUrl="/books"
	structuredData={booksStructuredData}
>
	<div slot="right" class="books-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span aria-hidden="true">/</span><span>Books</span>
		</nav>
		<header class="header">
			<h1>Books</h1>
			<p>Curated picks from Dogeared shelf activity. {totalCuratedBooks.toLocaleString()} books featured right now.</p>
		</header>
		{
			sections.length === 0
				? <p class="empty">No shelf activity yet. Add books to start building curated lists.</p>
				: sections.map((section) => (
					<section class="curated-section" id={section.id}>
						<div class="section-header">
							<h2>{section.title}</h2>
							<p>{section.subtitle}</p>
						</div>
						<ul class="book-grid">
							{section.books.map((row) => (
								<BookCard
									title={row.title}
									titleHref={`/book?bookId=${encodeURIComponent(String(row.id))}`}
									author={row.author}
									authorHref={authorHref(row.author, Number(row.author_id || 0))}
									thumbnail={row.cover_url}
									description={row.synopsis || "Synopsis unavailable for this title."}
									readers={row.readers}
									shelfEntries={row.shelves}
									publishedLabel={row.published_year > 0 ? String(row.published_year) : ""}
									pageCount={row.page_count}
									averageRating={Number(row.rating_avg || 0)}
								>
									<div slot="actions">
										<ShelfDropdown attrs={{
											"data-book-id": String(row.id || 0),
											"data-initial-status": viewerStatusByBookId.get(Number(row.id || 0)) || "",
											"data-title": row.title,
											"data-author": row.author,
											"data-description": row.synopsis,
											"data-pages": String(Math.max(0, Number(row.page_count || 0))),
											"data-cover": row.cover_url,
											"data-format": "Book",
											"data-language": row.language,
											"data-isbn10": row.isbn10,
											"data-isbn13": row.isbn13
										}} />
									</div>
								</BookCard>
							))}
						</ul>
					</section>
				))
		}
	</div>
</Layout>

<style>
	.books-page { max-width: 980px; display: grid; gap: 1rem; }
	.breadcrumbs { display: flex; gap: 0.35rem; font-size: 0.84rem; color: #546374; }
	.breadcrumbs a { color: var(--color-secondary); text-decoration: none; }
	.header h1, .header p { margin: 0; }
	.curated-section { display: grid; gap: 0.55rem; }
	.section-header h2, .section-header p { margin: 0; }
	.section-header p { color: #4f5d6c; font-size: 0.92rem; }
	.book-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.books-page :global(.book-card .card-body h3) { padding-right: 4.5rem; }
	.empty { margin: 0; color: #4f5d6c; }
	@media (max-width: 900px) {
		.book-grid { grid-template-columns: 1fr; }
	}
</style>
