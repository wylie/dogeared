---
import { getNeonSql } from "../lib/neon";
import { authorCanonicalPath } from "../lib/indexing";

export const prerender = false;

const authorId = Math.max(0, Number(Astro.url.searchParams.get("authorId") || 0) || 0);

if (authorId > 0) {
	try {
		const sql = getNeonSql();
		const rows = await sql<Array<{ name: string }>>`
			select name
			from author
			where id = ${authorId}
			limit 1
		`;
		const name = String(rows[0]?.name || "").trim();
		if (name) return Astro.redirect(authorCanonicalPath(name), 301);
	} catch {
		// Fall through to the authors index; the canonical author page remains the clean slug URL.
	}
}

return Astro.redirect("/authors", 301);
---
