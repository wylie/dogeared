			}
		};
		for (const button of startFinishButtons) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.addEventListener("click", () => applyWindow(String(button.dataset.startFinishWindow || "7d")));
		}
		applyWindow("7d");
	}

	const pagesTrendValue = document.querySelector("[data-pages-trend-value]");
	const pagesTrendSubtext = document.querySelector("[data-pages-trend-subtext]");
	const pagesTrendButtons = Array.from(document.querySelectorAll("[data-pages-trend-window]"));
	if (pagesTrendValue instanceof HTMLElement && pagesTrendSubtext instanceof HTMLElement && pagesTrendButtons.length > 0) {
		const applyWindow = (windowKey) => {
			const key = (windowKey === "30d" || windowKey === "90d" || windowKey === "365d") ? windowKey : "7d";
			const pagesRead = Number(pagesTrendValue.getAttribute(`data-pages-read-${key}`) || "0");
			const pagesPrev = Number(pagesTrendValue.getAttribute(`data-pages-prev-${key}`) || "0");
			const pct = Number(pagesTrendValue.getAttribute(`data-pages-pct-${key}`) || "0");
			pagesTrendValue.textContent = pagesRead.toLocaleString();
			pagesTrendSubtext.textContent = `Prev ${key}: ${pagesPrev.toLocaleString()} · ${pct >= 0 ? "+" : ""}${pct.toFixed(1)}%`;
			for (const button of pagesTrendButtons) {
				if (!(button instanceof HTMLButtonElement)) continue;
				const active = button.dataset.pagesTrendWindow === key;
				button.classList.toggle("is-active", active);
				button.setAttribute("aria-pressed", active ? "true" : "false");
			}
		};
		for (const button of pagesTrendButtons) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.addEventListener("click", () => applyWindow(String(button.dataset.pagesTrendWindow || "7d")));
		}
		applyWindow("7d");
	}

	const tasteHelpNodes = Array.from(document.querySelectorAll(".taste-help"));
	function positionTasteTooltip(helpNode) {
		if (!(helpNode instanceof HTMLElement)) return;
		const tip = helpNode.querySelector(".taste-help-tip");
		if (!(tip instanceof HTMLElement)) return;
		tip.style.left = "0px";
		const gutter = 8;
		const helpRect = helpNode.getBoundingClientRect();
		const tipRect = tip.getBoundingClientRect();
		let offset = 0;
		const overflowRight = tipRect.right - (window.innerWidth - gutter);
		if (overflowRight > 0) offset -= overflowRight;
		const overflowLeft = (helpRect.left + offset) - gutter;
		if (overflowLeft < 0) offset += Math.abs(overflowLeft);
		tip.style.left = `${Math.round(offset)}px`;
	}

	for (const node of tasteHelpNodes) {
		if (!(node instanceof HTMLElement)) continue;
		node.addEventListener("mouseenter", () => positionTasteTooltip(node));
		const icon = node.querySelector(".taste-help-icon");
		if (icon instanceof HTMLElement) {
			icon.setAttribute("tabindex", "0");
			icon.addEventListener("focus", () => positionTasteTooltip(node));
		}
	}

	window.addEventListener("resize", () => {
		for (const node of tasteHelpNodes) positionTasteTooltip(node);
	});

</script>

