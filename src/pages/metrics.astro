	const session = await resolveUserBySession(Astro.request);
	const viewerUserId = String(session?.userId || "");
	const sql = getNeonSql();
	await sql`
		create table if not exists user_reading_progress_event (
			id bigserial primary key,
			user_id uuid not null references app_user(id) on delete cascade,
			book_id bigint not null references book(id) on delete cascade,
			from_page int not null default 0,
			to_page int not null default 0,
			page_delta int not null default 0,
			recorded_at timestamptz not null default now()
		)
	`;
	await sql`create index if not exists idx_progress_event_user_recorded_at on user_reading_progress_event(user_id, recorded_at desc)`;
	const [summaryRows, statusRows, topLocationRows, authorRows, genreRows, locationRows, factsRows, myRows, communityRows, topReadingRows, streakRows, finishSpeedRows, genreShiftRows, topicExploreRows, ratingRows, tasteRows, communityAdvancedRows] = await Promise.all([
		sql<Array<{ total_users: number; total_shelved_books: number; distinct_books: number; tracked_genres: number; tracked_topics: number; active_locations: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select
				(select count(*)::int from valid_users) as total_users,
				(select count(*)::int from user_book ub join valid_users vu on vu.id = ub.user_id) as total_shelved_books,
				(select count(distinct ub.book_id)::int from user_book ub join valid_users vu on vu.id = ub.user_id) as distinct_books,
				(select count(distinct bg.genre_slug)::int from book_genre bg) as tracked_genres,
				(select count(distinct bt.tag_slug)::int from book_tag bt) as tracked_topics,
				(
					select count(distinct lower(trim(au.profile_data->>'location')))::int
					from app_user au
					join valid_users vu on vu.id = au.id
					where trim(coalesce(au.profile_data->>'location', '')) <> ''
				) as active_locations
		`,
		sql<Array<{ status: string; users: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select ub.status, count(distinct ub.user_id)::int as users
			from user_book ub
			join valid_users vu on vu.id = ub.user_id
			group by ub.status
			order by users desc, ub.status asc
		`,
		sql<Array<{ location: string; users: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select trim(au.profile_data->>'location') as location, count(*)::int as users
			from app_user au
			join valid_users vu on vu.id = au.id
			where trim(coalesce(au.profile_data->>'location', '')) <> ''
			group by trim(au.profile_data->>'location')
			order by users desc, location asc
		`,
		sql<Array<{ author: string; readers: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select b.primary_author as author, count(distinct ub.user_id)::int as readers
			from user_book ub
			join valid_users vu on vu.id = ub.user_id
			join book b on b.id = ub.book_id
			where trim(coalesce(b.primary_author, '')) <> ''
			group by b.primary_author
			order by readers desc, b.primary_author asc
			limit 16
		`,
		sql<Array<{ author: string; genre_slug: string; genre_name: string; readers: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			), top_authors as (
				select b.primary_author as author, count(distinct ub.user_id)::int as readers
				from user_book ub
				join valid_users vu on vu.id = ub.user_id
				join book b on b.id = ub.book_id
				where trim(coalesce(b.primary_author, '')) <> ''
				group by b.primary_author
				order by readers desc, b.primary_author asc
				limit 16
			)
			select b.primary_author as author, bg.genre_slug, min(bg.genre_name) as genre_name, count(distinct ub.user_id)::int as readers
			from user_book ub
			join valid_users vu on vu.id = ub.user_id
			join book b on b.id = ub.book_id
			join top_authors ta on ta.author = b.primary_author
			join book_genre bg on bg.book_id = b.id
			where trim(coalesce(bg.genre_slug, '')) <> ''
			group by b.primary_author, bg.genre_slug
		`,
		sql<Array<{ author: string; genre_slug: string; location: string; readers: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			), top_authors as (
				select b.primary_author as author, count(distinct ub.user_id)::int as readers
				from user_book ub
				join valid_users vu on vu.id = ub.user_id
				join book b on b.id = ub.book_id
				where trim(coalesce(b.primary_author, '')) <> ''
				group by b.primary_author
				order by readers desc, b.primary_author asc
				limit 16
			), aggregated as (
				select
					b.primary_author as author,
					bg.genre_slug,
					coalesce(nullif(trim(au.profile_data->>'location'), ''), 'Unknown') as location,
					count(distinct ub.user_id)::int as readers
				from user_book ub
				join valid_users vu on vu.id = ub.user_id
				join book b on b.id = ub.book_id
				join top_authors ta on ta.author = b.primary_author
				join book_genre bg on bg.book_id = b.id
				join app_user au on au.id = ub.user_id
				where trim(coalesce(bg.genre_slug, '')) <> ''
				group by b.primary_author, bg.genre_slug, coalesce(nullif(trim(au.profile_data->>'location'), ''), 'Unknown')
			), ranked as (
				select a.*, row_number() over (partition by a.author, a.genre_slug order by a.readers desc, a.location asc) as row_num
				from aggregated a
			)
			select author, genre_slug, location, readers
			from ranked
			where row_num <= 10
		`,
		sql<Array<{
			user_id: string;
			status: string;
			author: string;
			genre: string;
			topic: string;
			book: string;
			location: string;
			language: string;
			published_year: number | null;
		}>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select
				ub.user_id::text as user_id,
				ub.status,
				coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				coalesce(nullif(trim(bg.genre_name), ''), 'Uncategorized') as genre,
				coalesce(nullif(trim(bt.tag_name), ''), 'Untagged') as topic,
				coalesce(nullif(trim(b.title), ''), 'Unknown') as book,
				coalesce(nullif(trim(au.profile_data->>'location'), ''), 'Unknown') as location,
				coalesce(nullif(upper(trim(b.language)), ''), 'Unknown') as language,
				b.published_year
			from user_book ub
			join valid_users vu on vu.id = ub.user_id
			join book b on b.id = ub.book_id
			join app_user au on au.id = ub.user_id
			left join lateral (
				select bt1.tag_name
				from book_tag bt1
				where bt1.book_id = b.id
				order by bt1.tag_name asc
				limit 1
			) bt on true
			left join lateral (
				select bg1.genre_name
				from book_genre bg1
				where bg1.book_id = b.id
				order by bg1.genre_name asc
				limit 1
			) bg on true
			order by ub.updated_at desc, ub.book_id desc
			limit ${METRICS_FACT_LIMIT}
		`,
		sql<Array<{ pages_read_7d: number; pages_read_30d: number; pages_read_90d: number; pages_read_365d: number; books_added_7d: number; books_added_30d: number; books_added_90d: number; books_added_365d: number }>>`
			select
				(
					select coalesce(sum(greatest(0, coalesce(pe.page_delta, 0))), 0)::int
					from user_reading_progress_event pe
					where ${viewerUserId}::text <> ''
						and pe.user_id = ${viewerUserId || null}::uuid
						and pe.recorded_at >= now() - interval '7 days'
				) as pages_read_7d,
				(
					select coalesce(sum(greatest(0, coalesce(pe.page_delta, 0))), 0)::int
					from user_reading_progress_event pe
					where ${viewerUserId}::text <> ''
						and pe.user_id = ${viewerUserId || null}::uuid
						and pe.recorded_at >= now() - interval '30 days'
				) as pages_read_30d,
				(
					select coalesce(sum(greatest(0, coalesce(pe.page_delta, 0))), 0)::int
					from user_reading_progress_event pe
					where ${viewerUserId}::text <> ''
						and pe.user_id = ${viewerUserId || null}::uuid
						and pe.recorded_at >= now() - interval '90 days'
				) as pages_read_90d,
				(
					select coalesce(sum(greatest(0, coalesce(pe.page_delta, 0))), 0)::int
					from user_reading_progress_event pe
					where ${viewerUserId}::text <> ''
						and pe.user_id = ${viewerUserId || null}::uuid
						and pe.recorded_at >= now() - interval '365 days'
				) as pages_read_365d,
				(
					select count(*)::int
					from user_book ub
					where ${viewerUserId}::text <> ''
						and ub.user_id = ${viewerUserId || null}::uuid
						and ub.first_added_at >= now() - interval '7 days'
				) as books_added_7d,
				(
					select count(*)::int
					from user_book ub
					where ${viewerUserId}::text <> ''
						and ub.user_id = ${viewerUserId || null}::uuid
						and ub.first_added_at >= now() - interval '30 days'
				) as books_added_30d,
				(
					select count(*)::int
					from user_book ub
					where ${viewerUserId}::text <> ''
						and ub.user_id = ${viewerUserId || null}::uuid
						and ub.first_added_at >= now() - interval '90 days'
				) as books_added_90d,
				(
					select count(*)::int
					from user_book ub
					where ${viewerUserId}::text <> ''
						and ub.user_id = ${viewerUserId || null}::uuid
						and ub.first_added_at >= now() - interval '365 days'
				) as books_added_365d
		`,
		sql<Array<{ other_users: number; other_users_with_shelves: number; community_shelved_books: number; community_distinct_books: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select
				(select count(*)::int from valid_users) as other_users,
				(select count(distinct ub.user_id)::int from user_book ub join valid_users vu on vu.id = ub.user_id) as other_users_with_shelves,
				(select count(*)::int from user_book ub join valid_users vu on vu.id = ub.user_id) as community_shelved_books,
				(select count(distinct ub.book_id)::int from user_book ub join valid_users vu on vu.id = ub.user_id) as community_distinct_books
		`,
		sql<Array<{ location: string; shelves: number }>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			)
			select
				coalesce(nullif(trim(au.profile_data->>'location'), ''), 'Unknown') as location,
				count(*)::int as shelves
			from user_book ub
			join valid_users vu on vu.id = ub.user_id
			join app_user au on au.id = ub.user_id
			group by coalesce(nullif(trim(au.profile_data->>'location'), ''), 'Unknown')
			order by shelves desc, location asc
			limit 8
		`,
		sql<Array<{ streak_days: number }>>`
			with activity_days as (
				select distinct (ub.updated_at at time zone 'utc')::date as day
				from user_book ub
				where ${viewerUserId}::text <> ''
					and ub.user_id = ${viewerUserId || null}::uuid
					and coalesce(ub.current_page, 0) > 0
			), anchor as (
				select max(day) as last_day
				from activity_days
			), ranked as (
				select
					d.day,
					((a.last_day - d.day))::int as day_gap,
					row_number() over (order by d.day desc) - 1 as rn
				from activity_days d
				cross join anchor a
				where a.last_day is not null
			)
			select count(*)::int as streak_days
			from ranked
			where day_gap = rn
		`,
		sql<Array<{ median_finish_days: number }>>`
			select coalesce(
				percentile_cont(0.5) within group (
					order by greatest(0, (ub.finished_date - (ub.first_added_at::date)))
				),
				0
			)::int as median_finish_days
			from user_book ub
			where ${viewerUserId}::text <> ''
				and ub.user_id = ${viewerUserId || null}::uuid
				and ub.finished_date is not null
				and ub.first_added_at is not null
				and ub.finished_date >= ub.first_added_at::date
		`,
		sql<Array<{
			top_genre_this_month: string | null;
			top_genre_this_month_count: number;
			top_genre_last_month: string | null;
			top_genre_last_month_count: number;
		}>>`
			with month_bounds as (
				select
					date_trunc('month', now()) as cur_start,
					date_trunc('month', now()) - interval '1 month' as prev_start
			), base as (
				select
					case
						when ub.updated_at >= mb.cur_start then 'current'
						when ub.updated_at >= mb.prev_start and ub.updated_at < mb.cur_start then 'previous'
						else null
					end as bucket,
					coalesce(nullif(trim(bg.genre_name), ''), 'Uncategorized') as genre_name,
					count(*)::int as entries
				from user_book ub
				join book_genre bg on bg.book_id = ub.book_id
				cross join month_bounds mb
				where ${viewerUserId}::text <> ''
					and ub.user_id = ${viewerUserId || null}::uuid
					and ub.updated_at >= mb.prev_start
				group by 1, 2
			), current_top as (
				select genre_name, entries
				from base
				where bucket = 'current'
				order by entries desc, genre_name asc
				limit 1
			), previous_top as (
				select genre_name, entries
				from base
				where bucket = 'previous'
				order by entries desc, genre_name asc
				limit 1
			)
			select
				(select genre_name from current_top) as top_genre_this_month,
				coalesce((select entries from current_top), 0)::int as top_genre_this_month_count,
				(select genre_name from previous_top) as top_genre_last_month,
				coalesce((select entries from previous_top), 0)::int as top_genre_last_month_count
		`,
		sql<Array<{ new_topics_7d: number; new_topics_30d: number; new_topics_90d: number; new_topics_365d: number }>>`
			with topic_events as (
				select distinct bt.tag_slug, ub.updated_at
				from user_book ub
				join book_tag bt on bt.book_id = ub.book_id
				where ${viewerUserId}::text <> ''
					and ub.user_id = ${viewerUserId || null}::uuid
			)
			select
				(
					select count(*)::int
					from (select distinct tag_slug from topic_events where updated_at >= now() - interval '7 days') rt
					where not exists (select 1 from topic_events pt where pt.tag_slug = rt.tag_slug and pt.updated_at < now() - interval '7 days')
				) as new_topics_7d,
				(
					select count(*)::int
					from (select distinct tag_slug from topic_events where updated_at >= now() - interval '30 days') rt
					where not exists (select 1 from topic_events pt where pt.tag_slug = rt.tag_slug and pt.updated_at < now() - interval '30 days')
				) as new_topics_30d,
				(
					select count(*)::int
					from (select distinct tag_slug from topic_events where updated_at >= now() - interval '90 days') rt
					where not exists (select 1 from topic_events pt where pt.tag_slug = rt.tag_slug and pt.updated_at < now() - interval '90 days')
				) as new_topics_90d,
				(
					select count(*)::int
					from (select distinct tag_slug from topic_events where updated_at >= now() - interval '365 days') rt
					where not exists (select 1 from topic_events pt where pt.tag_slug = rt.tag_slug and pt.updated_at < now() - interval '365 days')
				) as new_topics_365d
		`,
		sql<Array<{ avg_rating: number; avg_rating_7d: number; avg_rating_30d: number; avg_rating_90d: number; avg_rating_365d: number; ratings_past_7d: number; ratings_past_30d: number; ratings_past_90d: number; ratings_past_365d: number; percent_books_rated: number }>>`
			with base as (
				select
					count(*)::int as total_books,
					count(*) filter (where ub.rating is not null)::int as rated_books,
					count(*) filter (where ub.rating is not null and ub.updated_at >= now() - interval '7 days')::int as ratings_past_7d,
					count(*) filter (where ub.rating is not null and ub.updated_at >= now() - interval '30 days')::int as ratings_past_30d,
					count(*) filter (where ub.rating is not null and ub.updated_at >= now() - interval '90 days')::int as ratings_past_90d,
					count(*) filter (where ub.rating is not null and ub.updated_at >= now() - interval '365 days')::int as ratings_past_365d,
					coalesce(round((avg(ub.rating) filter (where ub.rating is not null and ub.updated_at >= now() - interval '7 days'))::numeric, 2), 0)::float8 as avg_rating_7d,
					coalesce(round((avg(ub.rating) filter (where ub.rating is not null and ub.updated_at >= now() - interval '30 days'))::numeric, 2), 0)::float8 as avg_rating_30d,
					coalesce(round((avg(ub.rating) filter (where ub.rating is not null and ub.updated_at >= now() - interval '90 days'))::numeric, 2), 0)::float8 as avg_rating_90d,
					coalesce(round((avg(ub.rating) filter (where ub.rating is not null and ub.updated_at >= now() - interval '365 days'))::numeric, 2), 0)::float8 as avg_rating_365d
				from user_book ub
				where ${viewerUserId}::text <> ''
					and ub.user_id = ${viewerUserId || null}::uuid
			)
			select
				avg_rating_30d as avg_rating,
				avg_rating_7d,
				avg_rating_30d,
				avg_rating_90d,
				avg_rating_365d,
				ratings_past_7d,
				ratings_past_30d,
				ratings_past_90d,
				ratings_past_365d,
				case when total_books > 0 then round((rated_books::numeric / total_books::numeric) * 100, 1)::float8 else 0::float8 end as percent_books_rated
			from base
		`,
		sql<Array<{ title: string; rating: number; page_count: number; genre: string; tag: string }>>`
			select
				coalesce(b.title, '') as title,
				coalesce(ub.rating, 0)::int as rating,
				coalesce(nullif(b.page_count, 0), 0)::int as page_count,
				coalesce(bg.genre_name, 'Uncategorized') as genre,
				coalesce(bt.tag_name, '') as tag
			from user_book ub
			join book b on b.id = ub.book_id
			left join lateral (
				select genre_name
				from book_genre
				where book_id = b.id
				order by genre_name asc
				limit 1
			) bg on true
			left join lateral (
				select tag_name
				from book_tag
				where book_id = b.id
				order by tag_name asc
				limit 1
			) bt on true
			where ${viewerUserId}::text <> ''
				and ub.user_id = ${viewerUserId || null}::uuid
				and ub.status = 'finished'
				and ub.rating is not null
			order by ub.updated_at desc
			limit 600
		`,
		sql<Array<{
			active_readers_7d: number;
			active_readers_30d: number;
			active_readers_90d: number;
			active_readers_365d: number;
			new_readers_7d: number;
			new_readers_30d: number;
			new_readers_90d: number;
			new_readers_365d: number;
			books_added_7d: number;
			books_added_30d: number;
			books_added_90d: number;
			books_added_365d: number;
			books_started_7d: number;
			books_finished_7d: number;
			completion_rate_7d: number;
			books_started_30d: number;
			books_finished_30d: number;
			completion_rate_30d: number;
			books_started_90d: number;
			books_finished_90d: number;
			completion_rate_90d: number;
			books_started_365d: number;
			books_finished_365d: number;
			completion_rate_365d: number;
			pages_read_7d: number;
			pages_read_prev_7d: number;
			pages_trend_7d_pct: number;
			pages_read_30d: number;
			pages_read_prev_30d: number;
			pages_trend_30d_pct: number;
			pages_read_90d: number;
			pages_read_prev_90d: number;
			pages_trend_90d_pct: number;
			pages_read_365d: number;
			pages_read_prev_365d: number;
			pages_trend_365d_pct: number;
			top_genre_this_month: string | null;
			top_genre_this_month_count: number;
			top_genre_last_month: string | null;
			top_genre_last_month_count: number;
			top_topic_this_month: string | null;
			top_topic_this_month_count: number;
			top_topic_last_month: string | null;
			top_topic_last_month_count: number;
		}>>`
			with valid_users as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			), valid_users_all as (
				select id
				from app_user
				where username is not null
					and length(trim(username)) > 0
			), base as (
				select ub.*
				from user_book ub
				join valid_users vu on vu.id = ub.user_id
			), base_all as (
				select ub.*
				from user_book ub
				join valid_users_all vua on vua.id = ub.user_id
			), month_bounds as (
				select date_trunc('month', now()) as cur_start, date_trunc('month', now()) - interval '1 month' as prev_start
			), genre_counts as (
				select
					case when b.updated_at >= mb.cur_start then 'current' when b.updated_at >= mb.prev_start and b.updated_at < mb.cur_start then 'previous' else null end as bucket,
					coalesce(nullif(trim(bg.genre_name), ''), 'Uncategorized') as label,
					count(*)::int as entries
				from base b
				join book_genre bg on bg.book_id = b.book_id
				cross join month_bounds mb
				where b.updated_at >= mb.prev_start
				group by 1, 2
			), topic_counts as (
				select
					case when b.updated_at >= mb.cur_start then 'current' when b.updated_at >= mb.prev_start and b.updated_at < mb.cur_start then 'previous' else null end as bucket,
					coalesce(nullif(trim(bt.tag_name), ''), 'Untagged') as label,
					count(*)::int as entries
				from base b
				join book_tag bt on bt.book_id = b.book_id
				cross join month_bounds mb
				where b.updated_at >= mb.prev_start
				group by 1, 2
			), genre_top_cur as (
				select label, entries from genre_counts where bucket = 'current' order by entries desc, label asc limit 1
			), genre_top_prev as (
				select label, entries from genre_counts where bucket = 'previous' order by entries desc, label asc limit 1
			), topic_top_cur as (
				select label, entries from topic_counts where bucket = 'current' order by entries desc, label asc limit 1
			), topic_top_prev as (
				select label, entries from topic_counts where bucket = 'previous' order by entries desc, label asc limit 1
			), page_rollups as (
				select
					coalesce(sum(case when pe.recorded_at >= now() - interval '7 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as p7,
					coalesce(sum(case when pe.recorded_at >= now() - interval '14 days' and pe.recorded_at < now() - interval '7 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as pprev7,
					coalesce(sum(case when pe.recorded_at >= now() - interval '30 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as p30,
					coalesce(sum(case when pe.recorded_at >= now() - interval '60 days' and pe.recorded_at < now() - interval '30 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as pprev30,
					coalesce(sum(case when pe.recorded_at >= now() - interval '90 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as p90,
					coalesce(sum(case when pe.recorded_at >= now() - interval '180 days' and pe.recorded_at < now() - interval '90 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as pprev90,
					coalesce(sum(case when pe.recorded_at >= now() - interval '365 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as p365,
					coalesce(sum(case when pe.recorded_at >= now() - interval '730 days' and pe.recorded_at < now() - interval '365 days' then greatest(0, coalesce(pe.page_delta, 0)) else 0 end), 0)::int as pprev365
				from user_reading_progress_event pe
				join valid_users vu on vu.id = pe.user_id
			)
			select
				(select count(distinct b.user_id)::int from base_all b where b.updated_at >= now() - interval '7 days') as active_readers_7d,
				(select count(distinct b.user_id)::int from base_all b where b.updated_at >= now() - interval '30 days') as active_readers_30d,
				(select count(distinct b.user_id)::int from base_all b where b.updated_at >= now() - interval '90 days') as active_readers_90d,
				(select count(distinct b.user_id)::int from base_all b where b.updated_at >= now() - interval '365 days') as active_readers_365d,
				(select count(*)::int from app_user au join valid_users vu on vu.id = au.id where au.created_at >= now() - interval '7 days') as new_readers_7d,
				(select count(*)::int from app_user au join valid_users vu on vu.id = au.id where au.created_at >= now() - interval '30 days') as new_readers_30d,
				(select count(*)::int from app_user au join valid_users vu on vu.id = au.id where au.created_at >= now() - interval '90 days') as new_readers_90d,
				(select count(*)::int from app_user au join valid_users vu on vu.id = au.id where au.created_at >= now() - interval '365 days') as new_readers_365d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '7 days') as books_added_7d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '30 days') as books_added_30d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '90 days') as books_added_90d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '365 days') as books_added_365d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '7 days') as books_started_7d,
				(select count(*)::int from base b where b.finished_date >= current_date - interval '7 days') as books_finished_7d,
				(
					select case when started > 0 then round((finished::numeric / started::numeric) * 100, 1)::float8 else 0::float8 end
					from (
						select
							(select count(*)::int from base b where b.first_added_at >= now() - interval '7 days') as started,
							(select count(*)::int from base b where b.finished_date >= current_date - interval '7 days') as finished
					) x
				) as completion_rate_7d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '30 days') as books_started_30d,
				(select count(*)::int from base b where b.finished_date >= current_date - interval '30 days') as books_finished_30d,
				(
					select case when started > 0 then round((finished::numeric / started::numeric) * 100, 1)::float8 else 0::float8 end
					from (
						select
							(select count(*)::int from base b where b.first_added_at >= now() - interval '30 days') as started,
							(select count(*)::int from base b where b.finished_date >= current_date - interval '30 days') as finished
					) x
				) as completion_rate_30d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '90 days') as books_started_90d,
				(select count(*)::int from base b where b.finished_date >= current_date - interval '90 days') as books_finished_90d,
				(
					select case when started > 0 then round((finished::numeric / started::numeric) * 100, 1)::float8 else 0::float8 end
					from (
						select
							(select count(*)::int from base b where b.first_added_at >= now() - interval '90 days') as started,
							(select count(*)::int from base b where b.finished_date >= current_date - interval '90 days') as finished
					) x
				) as completion_rate_90d,
				(select count(*)::int from base b where b.first_added_at >= now() - interval '365 days') as books_started_365d,
				(select count(*)::int from base b where b.finished_date >= current_date - interval '365 days') as books_finished_365d,
				(
					select case when started > 0 then round((finished::numeric / started::numeric) * 100, 1)::float8 else 0::float8 end
					from (
						select
							(select count(*)::int from base b where b.first_added_at >= now() - interval '365 days') as started,
							(select count(*)::int from base b where b.finished_date >= current_date - interval '365 days') as finished
					) x
				) as completion_rate_365d,
				(select p7 from page_rollups) as pages_read_7d,
				(select pprev7 from page_rollups) as pages_read_prev_7d,
				(
					select case when pprev7 > 0 then round((((p7 - pprev7)::numeric / pprev7::numeric) * 100), 1)::float8 else 0::float8 end
					from page_rollups
				) as pages_trend_7d_pct,
				(select p30 from page_rollups) as pages_read_30d,
				(select pprev30 from page_rollups) as pages_read_prev_30d,
				(
					select case when pprev30 > 0 then round((((p30 - pprev30)::numeric / pprev30::numeric) * 100), 1)::float8 else 0::float8 end
					from page_rollups
				) as pages_trend_30d_pct,
				(select p90 from page_rollups) as pages_read_90d,
				(select pprev90 from page_rollups) as pages_read_prev_90d,
				(
					select case when pprev90 > 0 then round((((p90 - pprev90)::numeric / pprev90::numeric) * 100), 1)::float8 else 0::float8 end
					from page_rollups
				) as pages_trend_90d_pct,
				(select p365 from page_rollups) as pages_read_365d,
				(select pprev365 from page_rollups) as pages_read_prev_365d,
				(
					select case when pprev365 > 0 then round((((p365 - pprev365)::numeric / pprev365::numeric) * 100), 1)::float8 else 0::float8 end
					from page_rollups
				) as pages_trend_365d_pct,
				(select label from genre_top_cur) as top_genre_this_month,
				coalesce((select entries from genre_top_cur), 0)::int as top_genre_this_month_count,
				(select label from genre_top_prev) as top_genre_last_month,
				coalesce((select entries from genre_top_prev), 0)::int as top_genre_last_month_count,
				(select label from topic_top_cur) as top_topic_this_month,
				coalesce((select entries from topic_top_cur), 0)::int as top_topic_this_month_count,
				(select label from topic_top_prev) as top_topic_last_month,
				coalesce((select entries from topic_top_prev), 0)::int as top_topic_last_month_count
		`
	]);

	const summaryRow = summaryRows[0] || { total_users: 0, total_shelved_books: 0, distinct_books: 0, tracked_genres: 0, tracked_topics: 0, active_locations: 0 };
	const usersByStatus: MetricRow[] = statusRows.map((row) => ({
		key: slugify(row.status),
		label: row.status === "want_to_read" ? "Want to Read" : row.status === "reading" ? "Currently Reading" : row.status === "finished" ? "Read" : formatGenreTitle(row.status, row.status),
		value: Number(row.users || 0)
	}));
	const topLocationMap = new Map<string, number>();
	for (const row of topLocationRows) {
		const region = normalizeLocationRegion(row.location);
		topLocationMap.set(region, (topLocationMap.get(region) || 0) + Number(row.users || 0));
	}
	const topLocations: MetricRow[] = Array.from(topLocationMap.entries())
		.map(([label, value]) => ({ key: slugify(label), label, value }))
		.sort((a, b) => b.value - a.value || a.label.localeCompare(b.label))
		.slice(0, 12);

	const authorMap = new Map<string, DrillAuthor>();
	for (const row of authorRows) {
		const label = normalizeLabel(row.author);
		authorMap.set(label, { key: slugify(label), label, value: Number(row.readers || 0), genres: [], fictionNonfiction: [] });
	}

	for (const row of genreRows) {
		const author = authorMap.get(normalizeLabel(row.author));
		if (!author) continue;
		author.genres.push({
			key: slugify(String(row.genre_slug || row.genre_name || "")),
			label: formatGenreTitle(String(row.genre_slug || ""), String(row.genre_name || "")),
			value: Number(row.readers || 0),
			locations: []
		});
	}

	const lookup = new Map<string, DrillGenre>();
	for (const author of authorMap.values()) {
		for (const genre of author.genres) lookup.set(`${author.label}::${genre.key}`, genre);
	}

	for (const row of locationRows) {
		const genre = lookup.get(`${normalizeLabel(row.author)}::${slugify(String(row.genre_slug || ""))}`);
		if (!genre) continue;
		const region = normalizeLocationRegion(row.location);
		const existing = genre.locations.find((item) => item.label === region);
		if (existing) {
			existing.value += Number(row.readers || 0);
		} else {
			genre.locations.push({ key: slugify(region), label: region, value: Number(row.readers || 0) });
		}
	}

	for (const author of authorMap.values()) {
		const mix = new Map<string, number>();
		for (const genre of author.genres) {
			const bucket = classifyGenreType(genre.label);
			mix.set(bucket, (mix.get(bucket) || 0) + genre.value);
		}
		for (const genre of author.genres) {
			genre.locations.sort((a, b) => b.value - a.value || a.label.localeCompare(b.label));
		}
		author.fictionNonfiction = Array.from(mix.entries()).map(([label, value]) => ({ key: slugify(label), label, value }));
		author.genres.sort((a, b) => b.value - a.value || a.label.localeCompare(b.label));
	}

	metricsPayload = {
		generatedAt: new Date().toISOString(),
		dataSource: "live",
		error: "",
		userMetrics: {
			isLoggedIn: !!viewerUserId,
			pagesRead7d: Number(myRows[0]?.pages_read_7d || 0),
			pagesRead30d: Number(myRows[0]?.pages_read_30d || 0),
			pagesRead90d: Number(myRows[0]?.pages_read_90d || 0),
			pagesRead365d: Number(myRows[0]?.pages_read_365d || 0),
			booksAdded7d: Number(myRows[0]?.books_added_7d || 0),
			booksAdded30d: Number(myRows[0]?.books_added_30d || 0),
			booksAdded90d: Number(myRows[0]?.books_added_90d || 0),
			booksAdded365d: Number(myRows[0]?.books_added_365d || 0),
			readingStreakDays: Number(streakRows[0]?.streak_days || 0),
			avgPagesPerDay7d: Math.round((Number(myRows[0]?.pages_read_7d || 0) / 7) * 10) / 10,
			avgPagesPerDay30d: Math.round((Number(myRows[0]?.pages_read_30d || 0) / 30) * 10) / 10,
			avgPagesPerDay90d: Math.round((Number(myRows[0]?.pages_read_90d || 0) / 90) * 10) / 10,
			avgPagesPerDay365d: Math.round((Number(myRows[0]?.pages_read_365d || 0) / 365) * 10) / 10,
			medianFinishDays: Number(finishSpeedRows[0]?.median_finish_days || 0),
			topGenreThisMonth: String(genreShiftRows[0]?.top_genre_this_month || "None"),
			topGenreThisMonthCount: Number(genreShiftRows[0]?.top_genre_this_month_count || 0),
			topGenreLastMonth: String(genreShiftRows[0]?.top_genre_last_month || "None"),
			topGenreLastMonthCount: Number(genreShiftRows[0]?.top_genre_last_month_count || 0),
			newTopics7d: Number(topicExploreRows[0]?.new_topics_7d || 0),
			newTopics30d: Number(topicExploreRows[0]?.new_topics_30d || 0),
			newTopics90d: Number(topicExploreRows[0]?.new_topics_90d || 0),
			newTopics365d: Number(topicExploreRows[0]?.new_topics_365d || 0),
			avgRating7d: Number(ratingRows[0]?.avg_rating_7d || 0),
			avgRating30d: Number(ratingRows[0]?.avg_rating_30d || 0),
			avgRating90d: Number(ratingRows[0]?.avg_rating_90d || 0),
			avgRating365d: Number(ratingRows[0]?.avg_rating_365d || 0),
			avgRating: Number(ratingRows[0]?.avg_rating_30d || 0),
			ratingsPast7d: Number(ratingRows[0]?.ratings_past_7d || 0),
			ratingsPast30d: Number(ratingRows[0]?.ratings_past_30d || 0),
			ratingsPast90d: Number(ratingRows[0]?.ratings_past_90d || 0),
			ratingsPast365d: Number(ratingRows[0]?.ratings_past_365d || 0),
			percentBooksRated: Number(ratingRows[0]?.percent_books_rated || 0)
		},
		communityMetrics: {
			otherUsers: Number(communityRows[0]?.other_users || 0),
			otherUsersWithShelves: Number(communityRows[0]?.other_users_with_shelves || 0),
			communityShelvedBooks: Number(communityRows[0]?.community_shelved_books || 0),
			communityDistinctBooks: Number(communityRows[0]?.community_distinct_books || 0),
			activeReaders7d: Number(communityAdvancedRows[0]?.active_readers_7d || 0),
			activeReaders30d: Number(communityAdvancedRows[0]?.active_readers_30d || 0),
			activeReaders90d: Number(communityAdvancedRows[0]?.active_readers_90d || communityAdvancedRows[0]?.active_readers_30d || 0),
			activeReaders365d: Number(communityAdvancedRows[0]?.active_readers_365d || communityAdvancedRows[0]?.active_readers_30d || 0),
			newReaders7d: Number(communityAdvancedRows[0]?.new_readers_7d || 0),
			newReaders30d: Number(communityAdvancedRows[0]?.new_readers_30d || 0),
			newReaders90d: Number(communityAdvancedRows[0]?.new_readers_90d || communityAdvancedRows[0]?.new_readers_30d || 0),
			newReaders365d: Number(communityAdvancedRows[0]?.new_readers_365d || communityAdvancedRows[0]?.new_readers_30d || 0),
			booksAdded7d: Number(communityAdvancedRows[0]?.books_added_7d || 0),
			booksAdded30d: Number(communityAdvancedRows[0]?.books_added_30d || 0),
			booksAdded90d: Number(communityAdvancedRows[0]?.books_added_90d || communityAdvancedRows[0]?.books_added_30d || 0),
			booksAdded365d: Number(communityAdvancedRows[0]?.books_added_365d || communityAdvancedRows[0]?.books_added_30d || 0),
			booksStarted7d: Number(communityAdvancedRows[0]?.books_started_7d || 0),
			booksFinished7d: Number(communityAdvancedRows[0]?.books_finished_7d || 0),
			completionRate7d: Number(communityAdvancedRows[0]?.completion_rate_7d || 0),
			booksStarted30d: Number(communityAdvancedRows[0]?.books_started_30d || 0),
			booksFinished30d: Number(communityAdvancedRows[0]?.books_finished_30d || 0),
			completionRate30d: Number(communityAdvancedRows[0]?.completion_rate_30d || 0),
			booksStarted90d: Number(communityAdvancedRows[0]?.books_started_90d || communityAdvancedRows[0]?.books_started_30d || 0),
			booksFinished90d: Number(communityAdvancedRows[0]?.books_finished_90d || communityAdvancedRows[0]?.books_finished_30d || 0),
			completionRate90d: Number(communityAdvancedRows[0]?.completion_rate_90d || communityAdvancedRows[0]?.completion_rate_30d || 0),
			booksStarted365d: Number(communityAdvancedRows[0]?.books_started_365d || communityAdvancedRows[0]?.books_started_30d || 0),
			booksFinished365d: Number(communityAdvancedRows[0]?.books_finished_365d || communityAdvancedRows[0]?.books_finished_30d || 0),
			completionRate365d: Number(communityAdvancedRows[0]?.completion_rate_365d || communityAdvancedRows[0]?.completion_rate_30d || 0),
			pagesRead7d: Number(communityAdvancedRows[0]?.pages_read_7d || 0),
			pagesReadPrev7d: Number(communityAdvancedRows[0]?.pages_read_prev_7d || 0),
			pagesTrend7dPct: Number(communityAdvancedRows[0]?.pages_trend_7d_pct || 0),
			pagesRead30d: Number(communityAdvancedRows[0]?.pages_read_30d || 0),
			pagesReadPrev30d: Number(communityAdvancedRows[0]?.pages_read_prev_30d || 0),
			pagesTrend30dPct: Number(communityAdvancedRows[0]?.pages_trend_30d_pct || 0),
			pagesRead90d: Number(communityAdvancedRows[0]?.pages_read_90d || communityAdvancedRows[0]?.pages_read_30d || 0),
			pagesReadPrev90d: Number(communityAdvancedRows[0]?.pages_read_prev_90d || communityAdvancedRows[0]?.pages_read_prev_30d || 0),
			pagesTrend90dPct: Number(communityAdvancedRows[0]?.pages_trend_90d_pct || communityAdvancedRows[0]?.pages_trend_30d_pct || 0),
			pagesRead365d: Number(communityAdvancedRows[0]?.pages_read_365d || communityAdvancedRows[0]?.pages_read_30d || 0),
			pagesReadPrev365d: Number(communityAdvancedRows[0]?.pages_read_prev_365d || communityAdvancedRows[0]?.pages_read_prev_30d || 0),
			pagesTrend365dPct: Number(communityAdvancedRows[0]?.pages_trend_365d_pct || communityAdvancedRows[0]?.pages_trend_30d_pct || 0),
			topGenreThisMonth: String(communityAdvancedRows[0]?.top_genre_this_month || "None"),
			topGenreThisMonthCount: Number(communityAdvancedRows[0]?.top_genre_this_month_count || 0),
			topGenreLastMonth: String(communityAdvancedRows[0]?.top_genre_last_month || "None"),
			topGenreLastMonthCount: Number(communityAdvancedRows[0]?.top_genre_last_month_count || 0),
			topTopicThisMonth: String(communityAdvancedRows[0]?.top_topic_this_month || "None"),
			topTopicThisMonthCount: Number(communityAdvancedRows[0]?.top_topic_this_month_count || 0),
			topTopicLastMonth: String(communityAdvancedRows[0]?.top_topic_last_month || "None"),
			topTopicLastMonthCount: Number(communityAdvancedRows[0]?.top_topic_last_month_count || 0),
			topReadingLocations: (() => {
				const locationMap = new Map<string, number>();
				for (const row of topReadingRows) {
					const label = normalizeLocationRegion(row.location);
					locationMap.set(label, (locationMap.get(label) || 0) + Number(row.shelves || 0));
				}
				return Array.from(locationMap.entries())
					.map(([label, value]) => ({ key: slugify(label), label, value }))
					.sort((a, b) => b.value - a.value || a.label.localeCompare(b.label))
					.slice(0, 8);
			})()
		},
		summary: {
			totalUsers: Number(summaryRow.total_users || 0),
			totalShelvedBooks: Number(summaryRow.total_shelved_books || 0),
			distinctBooks: Number(summaryRow.distinct_books || 0),
			trackedGenres: Number(summaryRow.tracked_genres || 0),
			trackedTopics: Number(summaryRow.tracked_topics || 0),
			activeLocations: Number(summaryRow.active_locations || 0)
		},
		usersByStatus,
		topLocations,
		authors: Array.from(authorMap.values()).sort((a, b) => b.value - a.value || a.label.localeCompare(b.label)),
		analyticsFacts: factsRows.map((row) => {
			const year = Number(row.published_year || 0);
			let yearBucket = "Unknown";
			if (year > 0) {
				if (year < 1900) yearBucket = "Before 1900";
				else yearBucket = `${Math.floor(year / 10) * 10}s`;
			}
			return {
				userId: String(row.user_id || ""),
				status: row.status === "want_to_read" ? "Want to Read" : row.status === "reading" ? "Currently Reading" : row.status === "finished" ? "Read" : formatGenreTitle(row.status, row.status),
				author: normalizeLabel(row.author),
				genre: formatGenreLabel(normalizeLabel(row.genre, "Uncategorized"), "Uncategorized"),
				topic: formatTopicTitle("", normalizeLabel(row.topic, "Untagged")),
				book: normalizeLabel(row.book),
				location: normalizeLocationRegion(row.location),
				language: normalizeLabel(row.language),
				yearBucket
			};
		}),
		tasteGraph: buildTasteGraph(tasteRows.map((row) => ({
			title: String(row.title || ""),
			rating: Number(row.rating || 0),
			pageCount: Number(row.page_count || 0),
			genre: String(row.genre || ""),
			tag: String(row.tag || "")
		})))
	};
} catch (error) {
	metricsPayload = { ...samplePayload, error: error instanceof Error ? error.message : "Failed to load live metrics." };
}

const sectionLinks = [
	{ id: "your-metrics", label: "You" },
	{ id: "taste-graph", label: "Taste Graph" },
	{ id: "community-metrics", label: "Community" },
	{ id: "books-metrics", label: "Books" },
	{ id: "explorer", label: "Explorer" },
	{ id: "compare", label: "Compare" }
];

const metricsPayloadJson = JSON.stringify(metricsPayload)
	.replace(/</g, "\\u003c")
	.replace(/-->/g, "--\\>");
---

<Layout title="Metrics" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="metrics-page">
		<header class="metrics-hero">
			<h1>Explore Dogeared data from readers to tastes to places.</h1>
			{metricsPayload.dataSource === "sample" && metricsPayload.error && (
				<p class="note">Live metrics unavailable. Showing sample data. ({metricsPayload.error})</p>
			)}
			{!metricsPayload.userMetrics.isLoggedIn && (
				<p class="note">Log in to see your personal reading metrics.</p>
			)}
		</header>

		<section id="your-metrics" class="panel">
			<div class="panel-head">
				<h2>Your Metrics</h2>
				<p>Your personal reading velocity.</p>
			</div>
			<div class="widget-grid user-velocity-grid">
				<article class="widget">
					<p>Pages Read</p>
					<div class="toggle pages-read-toggle" role="tablist" aria-label="Pages read window">
						<button type="button" class="is-active" data-pages-read-window="7d" aria-pressed="true">7d</button>
						<button type="button" data-pages-read-window="30d" aria-pressed="false">30d</button>
						<button type="button" data-pages-read-window="90d" aria-pressed="false">90d</button>
						<button type="button" data-pages-read-window="365d" aria-pressed="false">365d</button>
					</div>
					<strong
						id="pages-read-value"
						data-pages-read-value
						data-pages-read-7d={String(Math.round(metricsPayload.userMetrics.pagesRead7d))}
						data-pages-read-30d={String(Math.round(metricsPayload.userMetrics.pagesRead30d))}
						data-pages-read-90d={String(Math.round(metricsPayload.userMetrics.pagesRead90d))}
						data-pages-read-365d={String(Math.round(metricsPayload.userMetrics.pagesRead365d))}
					>
						{Math.round(metricsPayload.userMetrics.pagesRead7d)}
					</strong>
				</article>
				<article class="widget">
					<p>Books Added</p>
					<div class="toggle books-added-toggle" role="tablist" aria-label="Books added window">
						<button type="button" class="is-active" data-books-added-window="7d" aria-pressed="true">7d</button>
						<button type="button" data-books-added-window="30d" aria-pressed="false">30d</button>
						<button type="button" data-books-added-window="90d" aria-pressed="false">90d</button>
						<button type="button" data-books-added-window="365d" aria-pressed="false">365d</button>
					</div>
					<strong
						id="books-added-value"
						data-books-added-value
						data-books-added-7d={String(Math.round(metricsPayload.userMetrics.booksAdded7d))}
						data-books-added-30d={String(Math.round(metricsPayload.userMetrics.booksAdded30d))}
						data-books-added-90d={String(Math.round(metricsPayload.userMetrics.booksAdded90d))}
						data-books-added-365d={String(Math.round(metricsPayload.userMetrics.booksAdded365d))}
					>
						{Math.round(metricsPayload.userMetrics.booksAdded7d)}
					</strong>
				</article>
			</div>
			<div class="panel-head subhead">
				<h3>Advanced Personal Metrics</h3>
			</div>
			<div class="advanced-personal-layout">
				<div class="advanced-personal-column">
				<article class="widget">
					<p>Avg Pages / Day</p>
					<div class="toggle avg-pages-toggle" role="tablist" aria-label="Average pages per day window">
						<button type="button" class="is-active" data-avg-pages-window="7d" aria-pressed="true">7d</button>
						<button type="button" data-avg-pages-window="30d" aria-pressed="false">30d</button>
						<button type="button" data-avg-pages-window="90d" aria-pressed="false">90d</button>
						<button type="button" data-avg-pages-window="365d" aria-pressed="false">365d</button>
					</div>
					<strong
						id="avg-pages-value"
						data-avg-pages-value
						data-avg-pages-7d={String(Math.round(metricsPayload.userMetrics.avgPagesPerDay7d))}
						data-avg-pages-30d={String(Math.round(metricsPayload.userMetrics.avgPagesPerDay30d))}
						data-avg-pages-90d={String(Math.round(metricsPayload.userMetrics.avgPagesPerDay90d))}
						data-avg-pages-365d={String(Math.round(metricsPayload.userMetrics.avgPagesPerDay365d))}
					>
						{Math.round(metricsPayload.userMetrics.avgPagesPerDay7d)}
					</strong>
				</article>
				<article class="widget">
					<p>New Topics Touched</p>
					<div class="toggle" role="tablist" aria-label="New topics touched window">
						<button type="button" class="is-active" data-new-topics-window="7d" aria-pressed="true">7d</button>
						<button type="button" data-new-topics-window="30d" aria-pressed="false">30d</button>
						<button type="button" data-new-topics-window="90d" aria-pressed="false">90d</button>
						<button type="button" data-new-topics-window="365d" aria-pressed="false">365d</button>
					</div>
					<strong
						data-new-topics-value
						data-new-topics-7d={String(metricsPayload.userMetrics.newTopics7d)}
