function clamp(value: number, min: number, max: number) {
	return Math.max(min, Math.min(max, value));
}

function toTitleCase(value: string) {
	return String(value || "")
		.trim()
		.toLowerCase()
		.replace(/\b\w/g, (match) => match.toUpperCase());
}

function splitGenreSegments(label: string) {
	return String(label || "")
		.split(",")
		.map((part) => String(part || "").trim())
		.filter(Boolean);
}

function buildTasteGraph(rows: TasteSignalRow[]): TasteGraphPayload {
	const safeRows = rows.filter((row) => Number(row.rating) >= 1 && Number(row.rating) <= 5);
	const bookCount = safeRows.length;
	if (bookCount === 0) {
		return {
			bookCount: 0,
			paceScore: 0,
			proseScore: 0,
			tone: "Unknown",
			topGenres: [],
			topThemes: [],
			fitReasons: [{ kind: "note", label: "", prefix: "Rate a few finished books to generate your taste graph.", suffix: "" }],
			antiRecs: []
		};
	}

	const avgPages = safeRows.reduce((sum, row) => sum + Math.max(0, Number(row.pageCount || 0)), 0) / bookCount;
	const avgRating = safeRows.reduce((sum, row) => sum + Number(row.rating || 0), 0) / bookCount;
	const paceScore = Math.round(clamp(((avgPages - 120) / 400) * 100, 0, 100));
	const proseScore = Math.round(clamp(((avgRating - 1) / 4) * 100, 0, 100));

	const genreMap = new Map<string, { books: number; ratingSum: number }>();
	const tagMap = new Map<string, number>();
	for (const row of safeRows) {
		const genre = toTitleCase(row.genre || "Uncategorized");
		const tag = toTitleCase(row.tag || "");
		const existingGenre = genreMap.get(genre) || { books: 0, ratingSum: 0 };
		existingGenre.books += 1;
		existingGenre.ratingSum += Number(row.rating || 0);
		genreMap.set(genre, existingGenre);
		if (tag) tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
	}

	const topGenres = Array.from(genreMap.entries())
		.map(([label, stats]) => ({
			label,
			books: stats.books,
			score: Math.round((stats.ratingSum / Math.max(1, stats.books)) * 20)
		}))
		.sort((a, b) => b.score - a.score || b.books - a.books || a.label.localeCompare(b.label))
		.slice(0, 4);

	const topThemes = Array.from(tagMap.entries())
		.map(([label, count]) => ({ label, count }))
		.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
		.slice(0, 5);

	const toneBuckets = {
		dark: 0,
		hopeful: 0,
		intellectual: 0,
		adventurous: 0
	};
	for (const [tag, count] of tagMap.entries()) {
		const text = tag.toLowerCase();
		if (/(dark|bleak|gritty|tragic|dystopian|horror)/.test(text)) toneBuckets.dark += count;
		if (/(hope|uplift|warm|comfort|heart|inspiring)/.test(text)) toneBuckets.hopeful += count;
		if (/(philosophy|psychology|history|science|politics|essay)/.test(text)) toneBuckets.intellectual += count;
		if (/(adventure|action|thriller|mystery|quest|survival)/.test(text)) toneBuckets.adventurous += count;
	}
	const tone = (Object.entries(toneBuckets).sort((a, b) => b[1] - a[1])[0]?.[1] || 0) > 0
		? toTitleCase(Object.entries(toneBuckets).sort((a, b) => b[1] - a[1])[0]?.[0] || "Unknown")
		: "Balanced";

	const fitReasons = [
		...(topGenres[0] ? [{
			kind: "genre" as const,
			label: topGenres[0].label,
			prefix: "Strongest affinity: ",
			suffix: ` (${topGenres[0].score}/100).`
		}] : []),
		...(topThemes[0] ? [{
			kind: "theme" as const,
			label: topThemes[0].label,
			prefix: "Recurring theme: ",
			suffix: "."
		}] : []),
		{
			kind: "note" as const,
			label: "",
			prefix: paceScore >= 60 ? "You tend to like longer, denser books." : "You tend to prefer brisk, lower-friction reads.",
			suffix: ""
		}
	];
	const antiRecs = Array.from(genreMap.entries())
		.map(([label, stats]) => ({ label, avg: stats.ratingSum / Math.max(1, stats.books), books: stats.books }))
		.filter((row) => row.books >= 2 && row.avg <= 2.6)
		.sort((a, b) => a.avg - b.avg || b.books - a.books)
		.slice(0, 3)
		.map((row) => `${row.label} (avg ${row.avg.toFixed(1)}★ across ${row.books} books)`);

	return {
		bookCount,
		paceScore,
		proseScore,
		tone,
		topGenres,
		topThemes,
		fitReasons,
		antiRecs
	};
}

