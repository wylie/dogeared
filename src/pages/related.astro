---
import Layout from "../layouts/Layout.astro";
import BookCard from "../components/BookCard.astro";
import ShelfDropdown from "../components/ShelfDropdown.astro";
import { resolveUserBySession } from "../lib/auth";
import { getNeonSql } from "../lib/neon";
import { formatGenreLabel } from "../lib/genres";
import { authorHref } from "../lib/author";
import { buildBreadcrumbList, toAbsoluteUrl } from "../lib/seo";
import {
	authorCanonicalPath,
	canonicalRelatedValue,
	decideRelatedIndexing,
	normalizeRelatedKind,
	relatedCanonicalPath
} from "../lib/indexing";

export const prerender = false;

type BookRow = {
	id: number;
	title: string;
	author: string;
	authorId: number;
	shelves: number;
	readers: number;
	genres: string[];
	coverUrl: string;
	language: string;
	isbn10: string;
	isbn13: string;
	publishedYear: number;
	pageCount: number;
	averageRating: number;
	ratingCount: number;
};

type AuthorRow = {
	authorId: number;
	author: string;
	books: number;
	shelves: number;
	readers: number;
};

type LandingGenreRow = {
	genre_name: string;
	books: number;
	shelves: number;
	readers: number;
};

function normalizeText(value: unknown, fallback = "") {
	const text = String(value || "").trim();
	return text || fallback;
}

function slugify(value: string) {
	return normalizeText(value)
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "");
}

function canonicalKey(value: string) {
	return normalizeText(value)
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "");
}

function renderAverageStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	return Array.from({ length: 5 }, (_, index) => (index < Math.round(clamped) ? "★" : "☆")).join("");
}

const kind = normalizeText(Astro.url.searchParams.get("kind"), "author");
const rawValue = normalizeText(Astro.url.searchParams.get("value"));
const normalizedKind = normalizeRelatedKind(kind);
const value = canonicalRelatedValue(normalizedKind, rawValue);
const canonical = canonicalKey(value);
const genreSlug = slugify(value);
const canonicalParams = new URLSearchParams();
if (value) {
	canonicalParams.set("kind", normalizedKind);
	canonicalParams.set("value", value);
}
const canonicalSearch = canonicalParams.toString();
const currentSearch = Astro.url.searchParams.toString();
if (currentSearch !== canonicalSearch) {
	const next = canonicalSearch ? `/related?${canonicalSearch}` : "/related";
	return Astro.redirect(next, 301);
}

const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "books", label: "Books" },
	{ id: "related", label: "Related" }
];

let books: BookRow[] = [];
let relatedAuthors: AuthorRow[] = [];
let landingGenres: LandingGenreRow[] = [];
let landingAuthors: AuthorRow[] = [];
let landingBooks: BookRow[] = [];
let pageTitle = "Related";
let subtitle = "Explore related books in DogEared.";
let error = "";
let activeShelves = 0;
let distinctReaders = 0;
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();

const session = await resolveUserBySession(Astro.request);
const viewerUserId = String(session?.userId || "");

if (value) {
	try {
		const sql = getNeonSql();

		if (normalizedKind === "author") {
			pageTitle = value;
			subtitle = "All books by this author in DogEared.";
			books = await sql<BookRow[]>`
				select
					b.id,
					b.title,
					coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
					coalesce(b.author_id, 0)::bigint as "authorId",
					count(distinct ub.user_id)::int as shelves,
					count(distinct ub.user_id)::int as readers,
					coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}') as genres,
					coalesce(nullif(trim(b.cover_url), ''), '') as "coverUrl",
					coalesce(nullif(trim(b.language), ''), '') as language,
					coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
					coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
					coalesce(b.published_year, 0)::int as "publishedYear",
					coalesce(nullif(b.page_count, 0), 0)::int as "pageCount",
					coalesce(ra.average_rating, 0) as "averageRating",
					coalesce(ra.rating_count, 0)::int as "ratingCount"
				from book b
				left join user_book ub on ub.book_id = b.id
				left join book_genre bg on bg.book_id = b.id
				left join lateral (
					select
						round(avg(ub2.rating)::numeric, 1) as average_rating,
						count(*) filter (where ub2.rating is not null)::int as rating_count
					from user_book ub2
					where ub2.book_id = b.id
				) ra on true
				where lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
				group by b.id, b.title, b.primary_author, b.author_id, b.cover_url, b.language, b.isbn10, b.isbn13, b.published_year, b.page_count, ra.average_rating, ra.rating_count
				having count(distinct ub.user_id) > 0
				order by shelves desc, readers desc, b.title asc
			`;
		} else if (normalizedKind === "genre") {
			pageTitle = formatGenreLabel(value, value);
			subtitle = "Books in this genre in DogEared.";
			books = await sql<BookRow[]>`
				select
					b.id,
					b.title,
					coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
					coalesce(b.author_id, 0)::bigint as "authorId",
					count(distinct ub.user_id)::int as shelves,
					count(distinct ub.user_id)::int as readers,
					coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}') as genres,
					coalesce(nullif(trim(b.cover_url), ''), '') as "coverUrl",
					coalesce(nullif(trim(b.language), ''), '') as language,
					coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
					coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
					coalesce(b.published_year, 0)::int as "publishedYear",
					coalesce(nullif(b.page_count, 0), 0)::int as "pageCount",
					coalesce(ra.average_rating, 0) as "averageRating",
					coalesce(ra.rating_count, 0)::int as "ratingCount"
				from book b
				join book_genre g on g.book_id = b.id
				left join user_book ub on ub.book_id = b.id
				left join book_genre bg on bg.book_id = b.id
				left join lateral (
					select
						round(avg(ub2.rating)::numeric, 1) as average_rating,
						count(*) filter (where ub2.rating is not null)::int as rating_count
					from user_book ub2
					where ub2.book_id = b.id
				) ra on true
				where
					lower(regexp_replace(coalesce(g.genre_name, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
					or lower(coalesce(g.genre_slug, '')) = ${genreSlug}
				group by b.id, b.title, b.primary_author, b.author_id, b.cover_url, b.language, b.isbn10, b.isbn13, b.published_year, b.page_count, ra.average_rating, ra.rating_count
				having count(distinct ub.user_id) > 0
				order by shelves desc, readers desc, b.title asc
			`;

			relatedAuthors = await sql<AuthorRow[]>`
				select
					coalesce(min(b.author_id), 0)::bigint as "authorId",
					coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
					count(distinct b.id)::int as books,
					count(distinct (ub.user_id, ub.book_id))::int as shelves,
					count(distinct ub.user_id)::int as readers
				from book b
				join book_genre g on g.book_id = b.id
				left join user_book ub on ub.book_id = b.id
				where
					lower(regexp_replace(coalesce(g.genre_name, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
					or lower(coalesce(g.genre_slug, '')) = ${genreSlug}
				group by b.primary_author
				having count(distinct (ub.user_id, ub.book_id)) > 0
				order by shelves desc, readers desc, author asc
				limit 30
			`;
		} else if (normalizedKind === "book") {
			pageTitle = value;
			subtitle = "Book details and shelf activity in DogEared.";
			books = await sql<BookRow[]>`
				select
					b.id,
					b.title,
					coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
					coalesce(b.author_id, 0)::bigint as "authorId",
					count(distinct ub.user_id)::int as shelves,
					count(distinct ub.user_id)::int as readers,
					coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}') as genres,
					coalesce(nullif(trim(b.cover_url), ''), '') as "coverUrl",
					coalesce(nullif(trim(b.language), ''), '') as language,
					coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
					coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
					coalesce(b.published_year, 0)::int as "publishedYear",
					coalesce(nullif(b.page_count, 0), 0)::int as "pageCount",
					coalesce(ra.average_rating, 0) as "averageRating",
					coalesce(ra.rating_count, 0)::int as "ratingCount"
				from book b
				left join user_book ub on ub.book_id = b.id
				left join book_genre bg on bg.book_id = b.id
				left join lateral (
					select
						round(avg(ub2.rating)::numeric, 1) as average_rating,
						count(*) filter (where ub2.rating is not null)::int as rating_count
					from user_book ub2
					where ub2.book_id = b.id
				) ra on true
				where lower(regexp_replace(coalesce(b.title, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
				group by b.id, b.title, b.primary_author, b.author_id, b.cover_url, b.language, b.isbn10, b.isbn13, b.published_year, b.page_count, ra.average_rating, ra.rating_count
				having count(distinct ub.user_id) > 0
				order by shelves desc, readers desc, b.title asc
			`;
		} else if (normalizedKind === "topic") {
			pageTitle = value;
			subtitle = `Books connected to ${value} in DogEared.`;
			books = await sql<BookRow[]>`
				select
					b.id,
					b.title,
					coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
					coalesce(b.author_id, 0)::bigint as "authorId",
					count(distinct ub.user_id)::int as shelves,
					count(distinct ub.user_id)::int as readers,
					coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}') as genres,
					coalesce(nullif(trim(b.cover_url), ''), '') as "coverUrl",
					coalesce(nullif(trim(b.language), ''), '') as language,
					coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
					coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
					coalesce(b.published_year, 0)::int as "publishedYear",
					coalesce(nullif(b.page_count, 0), 0)::int as "pageCount",
					coalesce(ra.average_rating, 0) as "averageRating",
					coalesce(ra.rating_count, 0)::int as "ratingCount"
				from book b
				join book_tag t on t.book_id = b.id
				left join user_book ub on ub.book_id = b.id
				left join book_genre bg on bg.book_id = b.id
				left join lateral (
					select
						round(avg(ub2.rating)::numeric, 1) as average_rating,
						count(*) filter (where ub2.rating is not null)::int as rating_count
					from user_book ub2
					where ub2.book_id = b.id
				) ra on true
				where lower(regexp_replace(coalesce(t.tag_name, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
				group by b.id, b.title, b.primary_author, b.author_id, b.cover_url, b.language, b.isbn10, b.isbn13, b.published_year, b.page_count, ra.average_rating, ra.rating_count
				having count(distinct ub.user_id) > 0
				order by shelves desc, readers desc, b.title asc
			`;
		}

		if (normalizedKind === "author") {
			const totals = await sql<Array<{ active_shelves: number; readers: number }>>`
				select
					count(distinct ub.status)::int as active_shelves,
					count(distinct ub.user_id)::int as readers
				from user_book ub
				join book b on b.id = ub.book_id
				where lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
			`;
			activeShelves = Number(totals[0]?.active_shelves || 0);
			distinctReaders = Number(totals[0]?.readers || 0);
		} else if (normalizedKind === "genre") {
			const totals = await sql<Array<{ active_shelves: number; readers: number }>>`
				select
					count(distinct ub.status)::int as active_shelves,
					count(distinct ub.user_id)::int as readers
				from user_book ub
				join book b on b.id = ub.book_id
				join book_genre g on g.book_id = b.id
				where
					lower(regexp_replace(coalesce(g.genre_name, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
					or lower(coalesce(g.genre_slug, '')) = ${genreSlug}
			`;
			activeShelves = Number(totals[0]?.active_shelves || 0);
			distinctReaders = Number(totals[0]?.readers || 0);
		} else if (normalizedKind === "book") {
			const totals = await sql<Array<{ active_shelves: number; readers: number }>>`
				select
					count(distinct ub.status)::int as active_shelves,
					count(distinct ub.user_id)::int as readers
				from user_book ub
				join book b on b.id = ub.book_id
				where lower(regexp_replace(coalesce(b.title, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
			`;
			activeShelves = Number(totals[0]?.active_shelves || 0);
			distinctReaders = Number(totals[0]?.readers || 0);
		} else if (normalizedKind === "topic") {
			const totals = await sql<Array<{ active_shelves: number; readers: number }>>`
				select
					count(distinct ub.status)::int as active_shelves,
					count(distinct ub.user_id)::int as readers
				from user_book ub
				join book b on b.id = ub.book_id
				join book_tag t on t.book_id = b.id
				where lower(regexp_replace(coalesce(t.tag_name, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
			`;
			activeShelves = Number(totals[0]?.active_shelves || 0);
			distinctReaders = Number(totals[0]?.readers || 0);
		}

		if (viewerUserId && books.length > 0) {
			const bookIds = Array.from(new Set(books.map((book) => Number(book.id || 0)).filter((id) => id > 0)));
			if (bookIds.length > 0) {
				const rows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished" }>>`
					select book_id, status
					from user_book
					where user_id = ${viewerUserId}::uuid
						and book_id = any(${bookIds}::bigint[])
				`;
				viewerStatusByBookId = new Map(rows.map((row) => [Number(row.book_id || 0), row.status]));
			}
		}
	} catch (cause) {
		error = cause instanceof Error ? cause.message : "Failed to load related data.";
	}
} else {
	try {
		const sql = getNeonSql();
		subtitle = "Explore popular genres, authors, and books in DogEared.";

		landingGenres = await sql<LandingGenreRow[]>`
			select
				coalesce(nullif(trim(bg.genre_name), ''), 'Uncategorized') as genre_name,
				count(distinct b.id)::int as books,
				count(distinct (ub.user_id, ub.book_id))::int as shelves,
				count(distinct ub.user_id)::int as readers
			from book_genre bg
			join book b on b.id = bg.book_id
			left join user_book ub on ub.book_id = b.id
			group by coalesce(nullif(trim(bg.genre_name), ''), 'Uncategorized')
			having count(distinct ub.user_id) > 0
			order by shelves desc, readers desc, genre_name asc
			limit 12
		`;

		landingAuthors = await sql<AuthorRow[]>`
			select
				coalesce(min(b.author_id), 0)::bigint as "authorId",
				coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				count(distinct b.id)::int as books,
				count(distinct (ub.user_id, ub.book_id))::int as shelves,
				count(distinct ub.user_id)::int as readers
			from book b
			left join user_book ub on ub.book_id = b.id
			group by b.primary_author
			having count(distinct ub.user_id) > 0
			order by shelves desc, readers desc, author asc
			limit 12
		`;

		landingBooks = await sql<BookRow[]>`
			select
				b.id,
				b.title,
				coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
				coalesce(b.author_id, 0)::bigint as "authorId",
				count(distinct ub.user_id)::int as shelves,
				count(distinct ub.user_id)::int as readers,
				coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}') as genres,
				coalesce(nullif(trim(b.cover_url), ''), '') as "coverUrl",
				coalesce(nullif(trim(b.language), ''), '') as language,
				coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
				coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
				coalesce(b.published_year, 0)::int as "publishedYear",
				coalesce(nullif(b.page_count, 0), 0)::int as "pageCount",
				coalesce(ra.average_rating, 0) as "averageRating",
				coalesce(ra.rating_count, 0)::int as "ratingCount"
			from book b
			left join user_book ub on ub.book_id = b.id
			left join book_genre bg on bg.book_id = b.id
			left join lateral (
				select
					round(avg(ub2.rating)::numeric, 1) as average_rating,
					count(*) filter (where ub2.rating is not null)::int as rating_count
				from user_book ub2
				where ub2.book_id = b.id
			) ra on true
			group by b.id, b.title, b.primary_author, b.author_id, b.cover_url, b.language, b.isbn10, b.isbn13, b.published_year, b.page_count, ra.average_rating, ra.rating_count
			having count(distinct ub.user_id) > 0
			order by count(distinct ub.user_id) desc, count(ub.book_id) desc, b.title asc
			limit 12
		`;
	} catch (cause) {
		error = cause instanceof Error ? cause.message : "Failed to load related landing data.";
	}
}

if (!activeShelves) activeShelves = 0;
if (!distinctReaders) distinctReaders = Math.max(...books.map((row) => Number(row.readers || 0)), 0);
const uniqueAuthorCount = new Set(
	books
		.map((book) => Number(book.authorId || 0) > 0 ? `id:${Number(book.authorId || 0)}` : `name:${normalizeText(book.author).toLowerCase()}`)
		.filter(Boolean)
).size;
const relatedDecision = decideRelatedIndexing({
	kind: normalizedKind,
	value,
	bookCount: books.length,
	uniqueAuthorCount,
	readerCount: distinctReaders,
	hasError: !!error
});
const duplicateCanonicalUrl = normalizedKind === "author"
	? authorCanonicalPath(books[0]?.author || value)
	: normalizedKind === "book" && books[0]?.id
		? `/book?bookId=${encodeURIComponent(String(books[0].id))}`
		: "";
const relatedCanonicalUrl = duplicateCanonicalUrl || relatedCanonicalPath(normalizedKind, value);
const relatedRobots = relatedDecision.robots;
const seoTitle = value
	? (normalizedKind === "author"
		? `${value} Books`
		: normalizedKind === "genre"
			? `${pageTitle} Books and Readers`
			: normalizedKind === "book"
				? `${value} Shelf Activity`
				: `${value} Related Books`)
	: "Related Books";
const relatedDescription = value
	? `${subtitle} ${books.length.toLocaleString()} books, ${uniqueAuthorCount.toLocaleString()} authors, and ${distinctReaders.toLocaleString()} readers on DogEared.`
	: "Explore related books, authors, and genres in DogEared.";
const relatedIntro = value
	? `${pageTitle} gathers ${books.length.toLocaleString()} ${books.length === 1 ? "book" : "books"} from ${uniqueAuthorCount.toLocaleString()} ${uniqueAuthorCount === 1 ? "author" : "authors"} that DogEared readers have added to their shelves.`
	: "";
const breadcrumbStructuredData = JSON.stringify(buildBreadcrumbList([
	{ name: "Home", item: "/" },
	{ name: "Related", item: "/related" },
	...(value ? [{ name: pageTitle || "Related", item: relatedCanonicalUrl }] : [])
], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV }));
const relatedStructuredData = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: pageTitle || "Related",
	description: subtitle || "",
	url: toAbsoluteUrl(relatedCanonicalUrl, Astro.site ?? Astro.url)
});
const relatedItemListStructuredData = !value
	? JSON.stringify({
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: "Related Highlights",
		itemListElement: [
			...landingGenres.slice(0, 8).map((row, index) => ({
				"@type": "ListItem",
				position: index + 1,
				url: toAbsoluteUrl(`/related?kind=genre&value=${encodeURIComponent(row.genre_name)}`, Astro.site ?? Astro.url),
				name: formatGenreLabel(row.genre_name, "Uncategorized")
			})),
			...landingAuthors.slice(0, 8).map((row, index) => ({
				"@type": "ListItem",
				position: landingGenres.slice(0, 8).length + index + 1,
				url: toAbsoluteUrl(authorHref(row.author, row.authorId), Astro.site ?? Astro.url),
				name: row.author
			})),
			...landingBooks.slice(0, 8).map((row, index) => ({
				"@type": "ListItem",
				position: landingGenres.slice(0, 8).length + landingAuthors.slice(0, 8).length + index + 1,
				url: toAbsoluteUrl(`/book?bookId=${encodeURIComponent(String(row.id || 0))}`, Astro.site ?? Astro.url),
				name: row.title
			}))
		]
	})
	: books.length > 0
		? JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ItemList",
			name: `${pageTitle} Books`,
			itemListElement: books.slice(0, 24).map((book, index) => ({
				"@type": "ListItem",
				position: index + 1,
				url: toAbsoluteUrl(`/book?bookId=${encodeURIComponent(String(book.id || 0))}`, Astro.site ?? Astro.url),
				name: book.title
			}))
		})
		: "";
const relatedStructuredDataPayload = JSON.stringify([
	JSON.parse(relatedStructuredData),
	JSON.parse(breadcrumbStructuredData),
	...(relatedItemListStructuredData ? [JSON.parse(relatedItemListStructuredData)] : [])
]);
---

<Layout
	title={seoTitle}
	sectionLinks={sectionLinks}
	metaDescription={relatedDescription}
	canonicalUrl={relatedCanonicalUrl}
	robots={relatedRobots}
	structuredData={relatedStructuredDataPayload}
>
	<div slot="right" class="related-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/related">Related</a>
			{value && (
				<>
					<span aria-hidden="true">/</span>
					<span>{pageTitle}</span>
				</>
			)}
		</nav>
		<header id="overview" class="hero">
			<h1>{pageTitle || "Related"}</h1>
			<p>{subtitle}</p>
			{relatedIntro && <p class="collection-intro">{relatedIntro}</p>}
		</header>

		{!value && (
			<>
				{error ? (
					<section class="panel"><p class="error">{error}</p></section>
				) : (
					<>
						<section id="overview" class="panel panel-plain">
							<div class="panel-head"><h2>Popular Genres</h2></div>
							<ul class="author-grid">
								{landingGenres.map((genre) => (
									<li class="author-card">
										<h3>
											<a class="metric-link" href={`/related?kind=genre&value=${encodeURIComponent(genre.genre_name)}`}>
												{formatGenreLabel(genre.genre_name, "Uncategorized")}
											</a>
										</h3>
										<p>{genre.books} books</p>
										<p>{genre.shelves} shelf entries · {genre.readers} readers</p>
									</li>
								))}
							</ul>
						</section>
						<section class="panel panel-plain">
							<div class="panel-head"><h2>Active Authors</h2></div>
							<ul class="author-grid">
								{landingAuthors.map((row) => (
									<li class="author-card">
										<h3><a class="author-link" href={authorHref(row.author, row.authorId)}>{row.author}</a></h3>
										<p>{row.books} books</p>
										<p>{row.shelves} shelf entries · {row.readers} readers</p>
									</li>
								))}
							</ul>
						</section>
						<section class="panel panel-plain">
							<div class="panel-head"><h2>Books Readers Keep Shelving</h2></div>
							<ul class="book-grid">
								{landingBooks.map((book) => (
								<BookCard
									title={book.title}
									titleHref={`/book?bookId=${encodeURIComponent(String(book.id))}`}
									author={book.author}
									authorHref={authorHref(book.author, book.authorId)}
									thumbnail={book.coverUrl}
									readers={book.readers}
									shelfEntries={book.shelves}
									publishedLabel={book.publishedYear > 0 ? String(book.publishedYear) : ""}
									pageCount={book.pageCount}
									averageRating={book.averageRating}
									genres={book.genres}
								>
									<div slot="meta">
									</div>
									<div slot="actions">
										<ShelfDropdown attrs={{
											"data-book-id": String(book.id || 0),
											"data-initial-status": viewerStatusByBookId.get(Number(book.id || 0)) || "",
											"data-title": book.title,
											"data-author": book.author,
											"data-cover": book.coverUrl,
											"data-language": book.language,
											"data-isbn10": book.isbn10,
											"data-isbn13": book.isbn13,
											"data-categories": JSON.stringify(book.genres ?? [])
										}} />
									</div>
								</BookCard>
							))}
						</ul>
					</section>
					</>
				)}
			</>
		)}

		{value && (
			<>
				<section class="stats-grid">
					<article class="stat"><p>Books</p><strong>{books.length.toLocaleString()}</strong></article>
					<article class="stat"><p>Active Shelves</p><strong>{activeShelves.toLocaleString()}</strong></article>
					<article class="stat"><p>Distinct Readers</p><strong>{distinctReaders.toLocaleString()}</strong></article>
				</section>

				<section id="books" class="panel panel-plain">
					<div class="panel-head">
						<h2>Books In DogEared</h2>
					</div>
					{error ? (
						<p class="error">{error}</p>
					) : books.length === 0 ? (
						<p>No books match this collection yet. Search for a favorite title and add it to a shelf to help grow this section.</p>
					) : (
						<ul class="book-grid">
							{books.map((book) => (
								<BookCard
									title={book.title}
									titleHref={`/book?bookId=${encodeURIComponent(String(book.id))}`}
									author={book.author}
									authorHref={authorHref(book.author, book.authorId)}
									thumbnail={book.coverUrl}
									readers={book.readers}
									shelfEntries={book.shelves}
									publishedLabel={book.publishedYear > 0 ? String(book.publishedYear) : ""}
									pageCount={book.pageCount}
									averageRating={book.averageRating}
									genres={book.genres}
								>
									<div slot="meta">
									</div>
									<div slot="actions">
										<ShelfDropdown attrs={{
											"data-book-id": String(book.id || 0),
											"data-initial-status": viewerStatusByBookId.get(Number(book.id || 0)) || "",
											"data-title": book.title,
											"data-author": book.author,
											"data-cover": book.coverUrl,
											"data-language": book.language,
											"data-isbn10": book.isbn10,
											"data-isbn13": book.isbn13,
											"data-categories": JSON.stringify(book.genres ?? [])
										}} />
									</div>
								</BookCard>
							))}
						</ul>
					)}
				</section>

				{normalizedKind === "genre" && relatedAuthors.length > 0 && (
					<section id="related" class="panel panel-plain">
						<div class="panel-head">
							<h2>Top Authors In This Genre</h2>
						</div>
						<ul class="author-grid">
							{relatedAuthors.map((row) => (
								<li class="author-card">
									<h3><a class="author-link" href={authorHref(row.author, row.authorId)}>{row.author}</a></h3>
									<p>{row.books} books</p>
									<p>{row.shelves} shelf entries · {row.readers} readers</p>
								</li>
							))}
						</ul>
					</section>
				)}
			</>
		)}
	</div>
</Layout>

<script>
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		isShelfDropdownOrMenuTarget,
		parseCategories,
		resolveShelfDropdownFromTarget,
		setDropdownLabel,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		toggleShelfMenu
	} from "../lib/shelfClient.ts";
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const feedbackTimers = new WeakMap();

	document.addEventListener("click", async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;

		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle instanceof HTMLButtonElement) {
			const dropdown = toggle.closest(".shelf-dropdown");
			if (!(dropdown instanceof HTMLElement)) return;
			toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}

		const option = target.closest('[data-action="set-shelf"]');
		if (option instanceof HTMLButtonElement) {
			const dropdown = resolveShelfDropdownFromTarget(option);
			if (!(dropdown instanceof HTMLElement)) return;
			const status = String(option.dataset.status || "want_to_read");
			const title = String(dropdown.dataset.title || "").trim();
			if (!title) return;
			const author = String(dropdown.dataset.author || "").trim();
			const categories = parseCategories(dropdown.dataset.categories);
			const entry = buildShelfEntryFromRecord({
				title,
				author,
				pageCount: 0,
				coverUrl: String(dropdown.dataset.cover || ""),
				format: "",
				language: String(dropdown.dataset.language || ""),
				isbn10: String(dropdown.dataset.isbn10 || ""),
				isbn13: String(dropdown.dataset.isbn13 || ""),
				categories
			}, {
				status,
				totalPages: 0,
				currentPage: status === "reading" ? 1 : 0,
				finishedDate: status === "finished" ? new Date().toISOString().slice(0, 10) : ""
			});
			try {
				const result = await saveShelfEntryWithRetry(entry);
				if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
				setDropdownLabel(dropdown, status);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
				closeShelfMenus(shelfDropdowns);
			} catch (err) {
				showShelfFeedback(dropdown, err instanceof Error ? err.message : "Failed to save.", feedbackTimers);
			}
			return;
		}

		if (!isShelfDropdownOrMenuTarget(target)) closeShelfMenus(shelfDropdowns);
	});
</script>

