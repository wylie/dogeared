---
import Layout from "../../../layouts/Layout.astro";
import { resolveAdminSession } from "../../../lib/admin";
import { getNeonSql } from "../../../lib/neon";
import { deleteAdminUser, loadAdminUserDetail } from "../../../lib/adminData";
import { formatDate, formatNumber, safeAdminLoad } from "../../../lib/adminFormatting";
import { createReadingMilestoneNotifications } from "../../../lib/notifications";
import {
	addStreakCreditsForRange,
	loadAdminStreakRepairData,
	planStreakCreditRange,
	removeStreakCredit,
	type AdminStreakRepairData
} from "../../../lib/readingStreakCredits";

export const prerender = false;

const admin = await resolveAdminSession(Astro.request);
if (!admin.isAdmin) return Astro.redirect("/");

const username = String(Astro.params.username || "").trim();
const sql = getNeonSql();
let userResult = await safeAdminLoad("Admin user detail", () => loadAdminUserDetail(sql, username), null);
let user = userResult.data;
let deleteMessage = "";
let deleteError = false;
let streakMessage = "";
let streakError = false;

if (Astro.request.method === "POST") {
	try {
		const form = await Astro.request.formData();
		const intent = String(form.get("intent") || "").trim();
		const confirmUsername = String(form.get("confirmUsername") || "").trim().replace(/^@+/, "");
		if (!user?.id) {
			if (intent === "add-streak-credits" || intent === "remove-streak-credit") {
				streakMessage = "User not found.";
				streakError = true;
			} else {
				deleteMessage = "User not found.";
				deleteError = true;
			}
		} else if (intent === "add-streak-credits") {
			const result = await addStreakCreditsForRange(sql, {
				userId: user.id,
				adminUserId: admin.userId,
				startDate: form.get("startDate"),
				endDate: form.get("endDate"),
				reason: form.get("reason")
			});
			streakMessage = result.plan
				? `${result.message} ${result.plan.selectedDates.length} dates selected; ${result.plan.readingActivityDates.length} already contain reading activity; ${result.plan.datesRequiringCredit.length} required credits.`
				: result.message;
			streakError = !result.ok;
			if (result.ok && result.created > 0) {
				await createReadingMilestoneNotifications(sql, user.id, { checkStreak: true });
			}
			userResult = await safeAdminLoad("Admin user detail", () => loadAdminUserDetail(sql, username), null);
			user = userResult.data;
		} else if (intent === "remove-streak-credit") {
			const result = await removeStreakCredit(sql, {
				userId: user.id,
				creditId: form.get("creditId")
			});
			streakMessage = result.message;
			streakError = !result.ok;
			userResult = await safeAdminLoad("Admin user detail", () => loadAdminUserDetail(sql, username), null);
			user = userResult.data;
		} else if (intent !== "delete-user") {
			deleteMessage = "Invalid admin action.";
			deleteError = true;
		} else if (confirmUsername.toLowerCase() !== user.username.toLowerCase()) {
			deleteMessage = "Type the username exactly to confirm deletion.";
			deleteError = true;
		} else {
			const result = await deleteAdminUser(sql, user.id, admin.userId);
			if (result.ok) return Astro.redirect("/admin/users?deleted=1");
			deleteMessage = result.message;
			deleteError = true;
			userResult = await safeAdminLoad("Admin user detail", () => loadAdminUserDetail(sql, username), null);
			user = userResult.data;
		}
	} catch (error) {
		if (import.meta.env.DEV) {
			console.warn("[admin.user-detail.post.failed]", error instanceof Error ? error.message : error);
		}
		streakMessage = "User action could not be completed.";
		streakError = true;
	}
}

const streakRepairResult = user?.id
	? await safeAdminLoad<AdminStreakRepairData>("Reading streak repair", () => loadAdminStreakRepairData(sql, user.id), {
		currentStreakDays: 0,
		qualifyingDateKeys: [],
		readingActivityDateKeys: [],
		streakCreditDateKeys: [],
		gaps: [],
		recentDays: [],
		credits: []
	})
	: { data: null, warning: "" };
const streakRepair = streakRepairResult.data;
const defaultEndDate = new Date().toISOString().slice(0, 10);
const defaultStartDate = streakRepair?.gaps[0] || defaultEndDate;
const defaultPlan = streakRepair
	? planStreakCreditRange({
		startDate: defaultStartDate,
		endDate: defaultEndDate,
		readingDateKeys: streakRepair.readingActivityDateKeys,
		creditDateKeys: streakRepair.streakCreditDateKeys
	})
	: null;

const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "account", label: "Account" },
	{ id: "counts", label: "Counts" },
	{ id: "streak-repair", label: "Streak Repair" },
	{ id: "delete-user", label: "Delete User" }
];

const isSelf = !!user?.id && user.id === admin.userId;
---

<Layout title={user?.username ? `Admin User: @${user.username}` : "Admin User"} sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="admin-user-detail-page">
		<header id="overview" class="hero">
			<p><a class="back-link" href="/admin/users">Back to users</a></p>
			<h1>{user?.username ? `@${user.username}` : "User not found"}</h1>
			<p>Basic user management without exposing authentication secrets.</p>
		</header>

		{userResult.warning && <p class="admin-message error" role="status">{userResult.warning}</p>}

		{!user ? (
			<section class="panel">
				<h2>User not found</h2>
				<p>No account exists for that username.</p>
			</section>
		) : (
			<>
				<section class="panel" id="account">
					<div class="panel-head">
						<h2>Account</h2>
					</div>
					<div class="detail-grid">
						<p><strong>Username</strong><span>@{user.username}</span></p>
						<p><strong>Email</strong><span>{user.email || "Unknown"}</span></p>
						<p><strong>Joined</strong><span>{formatDate(user.joinedAt)}</span></p>
						<p><strong>Last activity</strong><span>{user.lastActivityAt ? formatDate(user.lastActivityAt) : "No activity"}</span></p>
					</div>
				</section>

				<section class="panel" id="counts">
					<div class="panel-head">
						<h2>Counts</h2>
						<p>Shelf entries are books saved to DogEared shelves. The status cards break those entries down by reading state.</p>
					</div>
					<div class="grid stats-grid">
						<article class="stat"><p>Shelf entries</p><strong>{formatNumber(user.shelfEntryCount)}</strong></article>
						<article class="stat"><p>Want to Read</p><strong>{formatNumber(user.wantToReadCount)}</strong></article>
						<article class="stat"><p>Currently Reading</p><strong>{formatNumber(user.currentlyReadingCount)}</strong></article>
						<article class="stat"><p>Read</p><strong>{formatNumber(user.completedCount)}</strong></article>
						<article class="stat"><p>Reviews</p><strong>{formatNumber(user.reviewCount)}</strong></article>
						<article class="stat"><p>Comments</p><strong>{formatNumber(user.commentCount)}</strong></article>
						<article class="stat"><p>Followers</p><strong>{formatNumber(user.followerCount)}</strong></article>
						<article class="stat"><p>Following</p><strong>{formatNumber(user.followingCount)}</strong></article>
					</div>
				</section>

				<section class="panel" id="streak-repair">
					<div class="panel-head">
						<h2>Reading Streak Repair</h2>
						<p>Admin-only streak credits repair calendar continuity without creating page progress, reading volume, books read, or finish events.</p>
					</div>
					{streakRepairResult.warning && <p class="admin-message error" role="status">{streakRepairResult.warning}</p>}
					{streakMessage && <p class={`admin-message${streakError ? " error" : ""}`} role="status">{streakMessage}</p>}
					{streakRepair && (
						<>
							<div class="grid stats-grid">
								<article class="stat"><p>Current streak</p><strong>{formatNumber(streakRepair.currentStreakDays)} days</strong></article>
								<article class="stat"><p>Real reading dates</p><strong>{formatNumber(streakRepair.readingActivityDateKeys.length)}</strong></article>
								<article class="stat"><p>Streak credits</p><strong>{formatNumber(streakRepair.streakCreditDateKeys.length)}</strong></article>
								<article class="stat"><p>Nearest gaps</p><strong>{formatNumber(streakRepair.gaps.length)}</strong></article>
							</div>

							<div class="streak-repair-grid">
								<div class="repair-box">
									<h3>Add streak credits</h3>
									<p>Only dates without genuine reading activity or an existing credit will receive credits.</p>
									{defaultPlan && (
										<p class="repair-plan">
											Default range: {formatNumber(defaultPlan.selectedDates.length)} dates selected,
											{" "}{formatNumber(defaultPlan.readingActivityDates.length)} already contain reading activity,
											{" "}{formatNumber(defaultPlan.datesRequiringCredit.length)} require credits.
										</p>
									)}
									<form method="post" class="repair-form">
										<input type="hidden" name="intent" value="add-streak-credits" />
										<label for="startDate">Start date</label>
										<input id="startDate" name="startDate" type="date" value={defaultStartDate} required />
										<label for="endDate">End date</label>
										<input id="endDate" name="endDate" type="date" value={defaultEndDate} required />
										<label for="reason">Reason</label>
										<select id="reason" name="reason" required>
											<option value="Streak restoration">Streak restoration</option>
											<option value="Missing historical reading data">Missing historical reading data</option>
											<option value="Migration repair">Migration repair</option>
											<option value="Timezone correction">Timezone correction</option>
											<option value="Manual admin adjustment">Manual admin adjustment</option>
										</select>
										<button type="submit" class="primary-button">Add Missing Credits</button>
									</form>
								</div>

								<div class="repair-box">
									<h3>Recent streak dates</h3>
									<ul class="streak-day-list" aria-label="Recent streak repair dates">
										{streakRepair.recentDays.slice(0, 18).map((day) => (
											<li class={`streak-day streak-day-${day.status}`}>
												<span>{day.date}</span>
												<strong>
													{day.status === "both"
														? "Reading activity + credit"
														: day.status === "reading"
															? "Reading activity"
															: day.status === "credit"
																? "Streak credit"
																: "Gap"}
												</strong>
											</li>
										))}
									</ul>
								</div>
							</div>

							<div class="repair-box credit-list-box">
								<h3>Existing streak credits</h3>
								{streakRepair.credits.length === 0 ? (
									<p>No streak credits have been added for this reader.</p>
								) : (
									<table class="admin-table">
										<thead>
											<tr><th>Date credited</th><th>Reason</th><th>Created</th><th>Admin</th><th>Action</th></tr>
										</thead>
										<tbody>
											{streakRepair.credits.map((credit) => (
												<tr>
													<td>{credit.date}</td>
													<td>{credit.reason || "No reason recorded"}</td>
													<td>{formatDate(credit.createdAt)}</td>
													<td>{credit.createdByUsername ? `@${credit.createdByUsername}` : "Unknown admin"}</td>
													<td>
														<form method="post" class="inline-form">
															<input type="hidden" name="intent" value="remove-streak-credit" />
															<input type="hidden" name="creditId" value={String(credit.id)} />
															<button type="submit" class="secondary-button">Remove Credit</button>
														</form>
													</td>
												</tr>
											))}
										</tbody>
									</table>
								)}
							</div>
						</>
					)}
				</section>

				<section class="panel danger-panel" id="delete-user">
					<div class="panel-head">
						<h2>Delete User</h2>
						<p>This deletes the account and reader-owned data: shelves, ratings, reviews, progress events, activity, comments, follows, notifications, sessions, magic links, custom shelves, and pending email changes. Catalog books and authors are preserved.</p>
					</div>
					{deleteMessage && <p class={`admin-message${deleteError ? " error" : ""}`} role="status">{deleteMessage}</p>}
					{isSelf ? (
						<p class="admin-message error" role="status">Admins cannot delete their own account from this page.</p>
					) : (
						<form method="post" class="delete-form" data-delete-user-form>
							<input type="hidden" name="intent" value="delete-user" />
							<label for="confirmUsername">Type <strong>{user.username}</strong> to confirm deletion</label>
							<input id="confirmUsername" name="confirmUsername" autocomplete="off" />
							<button type="submit" class="danger-button">Delete User</button>
						</form>
					)}
				</section>
			</>
		)}
	</div>
</Layout>

<script>
	const deleteForm = document.querySelector("[data-delete-user-form]");
	deleteForm?.addEventListener("submit", (event) => {
		if (!window.confirm("Delete this user and their reader-owned data? This cannot be undone.")) {
			event.preventDefault();
		}
	});
	for (const form of document.querySelectorAll(".inline-form")) {
		form.addEventListener("submit", (event) => {
			if (!window.confirm("Remove this streak credit? The reader's calculated streak may change immediately.")) {
				event.preventDefault();
			}
		});
	}
</script>

<style>
	.admin-user-detail-page { max-width: 980px; }
	.hero h1 { margin: 0.2rem 0 0; }
	.hero p { margin: 0.35rem 0 0; color: var(--color-text-muted); }
	.back-link { color: var(--color-nav); font-weight: 700; text-decoration: none; }
	.back-link:hover { color: var(--color-nav-hover); text-decoration: underline; }
	.panel { margin-top: 1rem; border: var(--border-subtle); border-radius: var(--radius-lg); background: var(--color-surface-raised); padding: 1rem; }
	.panel-head h2,
	.panel h2 { margin: 0; }
	.panel-head p { margin: 0.3rem 0 0; color: #575757; font-size: 0.9rem; line-height: 1.4; }
	.grid { display: grid; gap: 0.55rem; margin-top: 0.7rem; }
	.stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	.stat { border: var(--border-subtle); border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.56); padding: 0.6rem; }
	.stat p { margin: 0; color: #606060; font-size: 0.82rem; }
	.stat strong { display: block; margin-top: 0.2rem; font-size: 1.2rem; }
	.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; margin-top: 0.7rem; }
	.detail-grid p { margin: 0; display: grid; gap: 0.15rem; }
	.detail-grid strong { color: #4b5563; font-size: 0.82rem; }
	.detail-grid span { overflow-wrap: anywhere; }
	.streak-repair-grid { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: 0.75rem; margin-top: 0.8rem; }
	.repair-box { border: var(--border-subtle); border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.58); padding: 0.75rem; }
	.repair-box h3 { margin: 0; font-size: 1rem; }
	.repair-box p { margin: 0.3rem 0 0; color: #575757; font-size: 0.88rem; line-height: 1.4; }
	.repair-plan { font-weight: 700; color: var(--color-text); }
	.repair-form { display: grid; gap: 0.42rem; margin-top: 0.65rem; }
	.repair-form label { font-weight: 700; color: #3f3f3f; font-size: 0.84rem; }
	.repair-form input,
	.repair-form select {
		height: 38px;
		border: var(--border-subtle);
		border-radius: var(--radius-sm);
		background: #fff;
		padding: 0 0.65rem;
		font: inherit;
		box-sizing: border-box;
	}
	.primary-button,
	.secondary-button {
		border-radius: 8px;
		min-height: 38px;
		padding: 0 0.85rem;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.primary-button {
		justify-self: start;
		border: none;
		background: var(--color-primary);
		color: #fff;
	}
	.secondary-button {
		border: var(--border-subtle);
		background: #edf4f7;
		color: var(--color-nav);
	}
	.streak-day-list { list-style: none; display: grid; gap: 0.35rem; margin: 0.65rem 0 0; padding: 0; }
	.streak-day { display: flex; justify-content: space-between; gap: 0.5rem; border: var(--border-subtle); border-radius: var(--radius-sm); background: #fff; padding: 0.38rem 0.5rem; font-size: 0.85rem; }
	.streak-day span { font-variant-numeric: tabular-nums; }
	.streak-day strong { font-size: 0.8rem; text-align: right; }
	.streak-day-reading strong,
	.streak-day-both strong { color: var(--color-primary); }
	.streak-day-credit strong { color: #7c4a03; }
	.streak-day-gap strong { color: #991b1b; }
	.credit-list-box { margin-top: 0.75rem; overflow-x: auto; }
	.admin-table { width: 100%; border-collapse: collapse; margin-top: 0.65rem; font-size: 0.88rem; }
	.admin-table th,
	.admin-table td { border-bottom: var(--border-subtle); padding: 0.48rem; text-align: left; vertical-align: top; }
	.admin-table th { color: #4b5563; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.02em; }
	.inline-form { margin: 0; }
	.danger-panel { border-color: rgba(153, 27, 27, 0.26); }
	.admin-message {
		margin: 0.7rem 0 0;
		min-height: 1.2rem;
		color: var(--color-primary);
		font-weight: 700;
	}
	.admin-message.error { color: #991b1b; }
	.delete-form { display: grid; gap: 0.45rem; margin-top: 0.7rem; max-width: 360px; }
	.delete-form label { font-weight: 700; color: #3f3f3f; }
	.delete-form input {
		height: 38px;
		border: var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0 0.65rem;
		font: inherit;
	}
	.danger-button {
		justify-self: start;
		border: none;
		border-radius: 8px;
		min-height: 38px;
		padding: 0 0.85rem;
		background: #991b1b;
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.danger-button:hover { background: #7f1d1d; }

	@media (max-width: 760px) {
		.stats-grid,
		.detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.streak-repair-grid { grid-template-columns: 1fr; }
	}

	@media (max-width: 520px) {
		.stats-grid,
		.detail-grid { grid-template-columns: 1fr; }
	}
</style>
