---
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import { getNeonSql } from "../../lib/neon";
import { resolveAdminSession } from "../../lib/admin";
import { formatDate, formatNumber, percentOf, safeAdminLoad, safeArray } from "../../lib/adminFormatting";
import { loadCanonicalTitleCleanupCandidates, normalizeCanonicalSeriesTitles } from "../../lib/canonicalTitleCleanup";
import { ignorePotentialDuplicateWork, loadPotentialDuplicateWorks, mergeCatalogWorks, normalizeCanonicalWorkRelationships } from "../../lib/workNormalization";
import { loadCatalogMetadataHealth, type CatalogHealthResult } from "../../lib/adminCatalog";

export const prerender = false;

const admin = await resolveAdminSession(Astro.request);
if (!admin.isAdmin) return Astro.redirect("/");

const sql = getNeonSql();
const publisherSchemaResult = await safeAdminLoad("Publisher schema", async () => {
	await sql`alter table book add column if not exists publisher text not null default ''`;
	return true;
}, false);
const adminNotices: string[] = [];
const catalogPageSize = 25;
const catalogCurrentPage = Math.max(1, Number.parseInt(Astro.url.searchParams.get("catalog_page") || "1", 10) || 1);
const catalogHealthFilters = {
	q: Astro.url.searchParams.get("catalog_q") || "",
	issueType: Astro.url.searchParams.get("catalog_issue") || "all",
	severity: Astro.url.searchParams.get("catalog_severity") || "all",
	format: Astro.url.searchParams.get("catalog_format") || "all",
	provider: Astro.url.searchParams.get("catalog_provider") || "all",
	limit: catalogPageSize,
	offset: (catalogCurrentPage - 1) * catalogPageSize
};
const emptyCatalogHealth: CatalogHealthResult = {
	issues: [],
	records: [],
	pagination: { limit: catalogPageSize, offset: 0, total: 0 },
	facets: { formats: [], providers: [] },
	summary: {
		totalIssues: 0,
		totalRecords: 0,
		critical: 0,
		needsAttention: 0,
		optional: 0,
		missingPageCounts: 0,
		missingAudiobookDurations: 0,
		potentialDuplicates: 0,
		progressBlocking: 0
	}
};

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const action = String(formData.get("action") || "").trim();
	if (action === "canonical-title-cleanup") {
		const cleanupResult = await safeAdminLoad(
			"Canonical title cleanup action",
			() => normalizeCanonicalSeriesTitles(sql, 500),
			{ checked: 0, updated: 0, candidates: [] }
		);
		if (cleanupResult.warning) {
			adminNotices.push(cleanupResult.warning);
		} else {
			adminNotices.push(`Canonical Title Cleanup normalized ${formatNumber(cleanupResult.data.updated)} of ${formatNumber(cleanupResult.data.checked)} candidate titles.`);
		}
	}
	if (action === "canonical-work-normalization") {
		const normalizationResult = await safeAdminLoad(
			"Canonical Work normalization action",
			() => normalizeCanonicalWorkRelationships(sql, {
				apply: true,
				candidateLimit: 1500,
				duplicateLimit: 100,
				maxPasses: 6
			}),
			{
				knownSeriesChecked: 0,
				knownSeriesAttached: 0,
				workKeysChecked: 0,
				workKeysRepaired: 0,
				editionsAttached: 0,
				titlesChecked: 0,
				titlesUpdated: 0,
				seriesPlaceholdersRemoved: 0,
				duplicateGroupsChecked: 0,
				worksMerged: 0,
				metadataConflictsRemaining: 0,
				messages: []
			}
		);
		if (normalizationResult.warning) {
			adminNotices.push(normalizationResult.warning);
		} else {
			adminNotices.push(`Canonical Work normalization attached ${formatNumber(normalizationResult.data.knownSeriesAttached)} known-series relationships, repaired ${formatNumber(normalizationResult.data.workKeysRepaired)} Work keys, moved ${formatNumber(normalizationResult.data.editionsAttached)} editions, removed ${formatNumber(normalizationResult.data.seriesPlaceholdersRemoved)} stale series placeholders, normalized ${formatNumber(normalizationResult.data.titlesUpdated)} titles, and merged ${formatNumber(normalizationResult.data.worksMerged)} high-confidence duplicate Works. Remaining relationship conflicts: ${formatNumber(normalizationResult.data.metadataConflictsRemaining)}.`);
		}
	}
	if (action === "merge-duplicate-work") {
		const mergeResult = await safeAdminLoad(
			"Potential duplicate Work merge",
			() => mergeCatalogWorks(sql, {
				groupKey: formData.get("groupKey"),
				targetBookId: formData.get("targetBookId"),
				sourceBookId: formData.get("sourceBookId"),
				reason: formData.get("reason")
			}),
			{ ok: false, message: "Merge could not be completed." }
		);
		adminNotices.push(mergeResult.warning || mergeResult.data.message);
	}
	if (action === "ignore-duplicate-work") {
		const ignoreResult = await safeAdminLoad(
			"Potential duplicate Work ignore",
			() => ignorePotentialDuplicateWork(sql, {
				groupKey: formData.get("groupKey"),
				targetBookId: formData.get("targetBookId"),
				sourceBookId: formData.get("sourceBookId"),
				reason: formData.get("reason")
			}),
			{ ok: false, message: "Duplicate suggestion could not be ignored." }
		);
		adminNotices.push(ignoreResult.warning || ignoreResult.data.message);
	}
}

const [
	bookCoverageResult,
	genreCoverageResult,
	authorCoverageResult,
	importHealthResult,
	duplicateGroupsResult,
	potentialDuplicateWorksResult,
	relationshipHealthResult,
	catalogMetadataHealthResult,
	canonicalTitleCleanupResult,
	recentBackfillResult
] = await Promise.all([
	safeAdminLoad("Book coverage", () => sql<Array<{
		total_books: number;
		missing_author: number;
		missing_cover: number;
		missing_published_year: number;
		missing_synopsis: number;
		missing_isbn: number;
		missing_page_count: number;
		missing_publisher: number;
		missing_series: number;
	}>>`
		select
			count(*)::int as total_books,
			count(*) filter (where trim(coalesce(b.primary_author, '')) = '')::int as missing_author,
			count(*) filter (where trim(coalesce(b.cover_url, '')) = '')::int as missing_cover,
			count(*) filter (where b.published_year is null or b.published_year <= 0)::int as missing_published_year,
			count(*) filter (where trim(coalesce(b.synopsis, '')) = '')::int as missing_synopsis,
			count(*) filter (
				where coalesce(trim(coalesce(b.isbn13, '')), trim(coalesce(b.isbn10, '')), '') = ''
			)::int as missing_isbn,
			count(*) filter (where coalesce(b.page_count, 0) <= 0)::int as missing_page_count,
			count(*) filter (where trim(coalesce(b.publisher, '')) = '')::int as missing_publisher,
			count(*) filter (
				where lower(b.title) ~ '(#|book [0-9]|series|trilogy|saga|chronicles)'
					and not exists (select 1 from series_book sb where sb.book_id = b.id)
			)::int as missing_series
		from book b
	`, []),
	safeAdminLoad("Genre coverage", () => sql<Array<{ books_without_genres: number; books_with_genres: number }>>`
		with genre_counts as (
			select b.id as book_id, count(bg.genre_slug)::int as genre_count
			from book b
			left join book_genre bg on bg.book_id = b.id
			group by b.id
		)
		select
			count(*) filter (where genre_count = 0)::int as books_without_genres,
			count(*) filter (where genre_count > 0)::int as books_with_genres
		from genre_counts
	`, []),
	safeAdminLoad("Author coverage", () => sql<Array<{
		total_authors: number;
		authors_without_bio: number;
		authors_without_photo: number;
	}>>`
		select
			count(*)::int as total_authors,
			count(*) filter (where trim(coalesce(bio, '')) = '')::int as authors_without_bio,
			count(*) filter (where trim(coalesce(photo_url, '')) = '')::int as authors_without_photo
		from author
	`, []),
	safeAdminLoad("Import health", () => sql<Array<{
		total_user_books: number;
		active_readers: number;
		entries_without_total_pages: number;
		finished_without_date: number;
		reading_with_zero_progress: number;
	}>>`
		select
			count(*)::int as total_user_books,
			count(distinct user_id)::int as active_readers,
			count(*) filter (where total_pages = 0)::int as entries_without_total_pages,
			count(*) filter (where status = 'finished' and finished_date is null)::int as finished_without_date,
			count(*) filter (where status = 'reading' and current_page = 0)::int as reading_with_zero_progress
		from user_book
	`, []),
	safeAdminLoad("Duplicate clusters", () => sql<Array<{
		canonical_work_key: string;
		books: number;
		sample_title: string;
		sample_author: string;
		latest_update_at: string;
	}>>`
		select
			b.canonical_work_key,
			count(*)::int as books,
			min(b.title) as sample_title,
			min(b.primary_author) as sample_author,
			max(b.updated_at)::text as latest_update_at
		from book b
		where trim(coalesce(b.canonical_work_key, '')) <> ''
		group by b.canonical_work_key
		having count(*) > 1
		order by books desc, latest_update_at desc
		limit 25
	`, []),
	safeAdminLoad("Potential duplicate Works", () => loadPotentialDuplicateWorks(sql, 25), []),
	safeAdminLoad("Relationship health", () => sql<Array<{
		duplicate_works: number;
		duplicate_editions: number;
		broken_series: number;
		multiple_canonical_works: number;
		missing_series: number;
		missing_canonical_title: number;
		missing_series_position: number;
		incorrect_standalone: number;
		canonical_title_conflicts: number;
		series_position_conflicts: number;
	}>>`
		with known_series_like as (
			select b.id, b.work_id, b.title, b.primary_author
			from book b
			where lower(b.title) ~ '(wings of fire|harry potter|lord of the rings|empyrean|mistborn|series of unfortunate events|#|book [0-9])'
		),
		duplicate_work_groups as (
			select
				lower(regexp_replace(coalesce(nullif(trim(bw.canonical_title), ''), nullif(trim(bw.title), ''), b.title), '[^[:alnum:]]+', '', 'g')) as normalized_title,
				lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) as normalized_author,
				coalesce(series_info.series_id, 0) as series_id,
				coalesce(series_info.book_order, 0) as book_order,
				count(distinct coalesce(b.work_id, b.id))::int as work_count
			from book b
			left join book_work bw on bw.id = b.work_id
			left join lateral (
				select
					candidate.series_id,
					candidate.book_order
				from (
					select sb.series_id, sb.book_order, 1 as priority
					from series_book sb
					where sb.book_id = b.id
					union all
					select sb.series_id, sb.book_order, 2 as priority
					from book sibling
					join series_book sb on sb.book_id = sibling.id
					where b.work_id is not null
						and sibling.work_id = b.work_id
					union all
					select bw.series_id, bw.series_position as book_order, 3 as priority
					where bw.series_id is not null
				) candidate
				order by candidate.priority asc
				limit 1
			) series_info on true
			where trim(coalesce(b.title, '')) <> ''
				and trim(coalesce(b.primary_author, '')) <> ''
			group by normalized_title, normalized_author, coalesce(series_info.series_id, 0), coalesce(series_info.book_order, 0)
			having count(distinct coalesce(b.work_id, b.id)) > 1
		),
		duplicate_edition_groups as (
			select lower(trim(coalesce(edition_key, ''))) as edition_key, count(distinct work_id)::int as work_count
			from book_edition
			where trim(coalesce(edition_key, '')) <> ''
			group by lower(trim(coalesce(edition_key, '')))
			having count(distinct work_id) > 1
		),
		broken_series_rows as (
			select sb.series_id, sb.book_order
			from series_book sb
			where sb.book_order is null
				or (sb.book_id is null and trim(coalesce(sb.title_override, '')) = '')
				or (
					sb.book_id is not null
					and not exists (select 1 from book b where b.id = sb.book_id)
				)
			union
			select sb.series_id, sb.book_order
			from series_book sb
			where sb.book_id is null
				and exists (
					select 1
					from series_book real_entry
					where real_entry.series_id = sb.series_id
						and real_entry.book_id is not null
						and real_entry.book_order = sb.book_order
				)
		),
		multiple_canonical_work_rows as (
			select b.work_id
			from book b
			where b.work_id is not null
			group by b.work_id
			having count(distinct b.canonical_work_key) > 1
		),
		missing_series_rows as (
			select k.id
			from known_series_like k
			left join book_work bw on bw.id = k.work_id
			where not exists (select 1 from series_book sb where sb.book_id = k.id)
				and bw.series_id is null
		),
		missing_canonical_title_rows as (
			select bw.id
			from book_work bw
			where trim(coalesce(bw.canonical_title, '')) = ''
				or trim(coalesce(bw.work_key, '')) = ''
		),
		missing_series_position_rows as (
			select b.id
			from book b
			join book_work bw on bw.id = b.work_id
			left join series_book sb on sb.book_id = b.id
			where coalesce(sb.series_id, bw.series_id) is not null
				and coalesce(sb.book_order, bw.series_position) is null
		),
		incorrect_standalone_rows as (
			select b.id
			from book b
			join book_work bw on bw.id = b.work_id
			where bw.series_id is not null
				and not exists (
					select 1
					from series_book sb
					where sb.book_id = b.id
				)
		),
		canonical_title_conflict_rows as (
			select b.id
			from book b
			join series_book sb on sb.book_id = b.id
			join series s on s.id = sb.series_id
			where lower(b.title) like '%' || lower(s.name) || '%'
				or lower(b.title) ~ '\\(.*#?[0-9]+.*\\)$'
		),
		series_position_conflict_rows as (
			select sb.series_id, sb.book_order, count(distinct coalesce(b.work_id, b.id))::int as work_count
			from series_book sb
			left join book b on b.id = sb.book_id
			where sb.book_order is not null
			group by sb.series_id, sb.book_order
			having count(distinct coalesce(b.work_id, b.id)) filter (where coalesce(b.work_id, b.id) is not null) > 1
		)
		select
			(select count(*)::int from duplicate_work_groups) as duplicate_works,
			(select count(*)::int from duplicate_edition_groups) as duplicate_editions,
			(select count(*)::int from broken_series_rows) as broken_series,
			(select count(*)::int from multiple_canonical_work_rows) as multiple_canonical_works,
			(select count(*)::int from missing_series_rows) as missing_series,
			(select count(*)::int from missing_canonical_title_rows) as missing_canonical_title,
			(select count(*)::int from missing_series_position_rows) as missing_series_position,
			(select count(*)::int from incorrect_standalone_rows) as incorrect_standalone,
			(select count(*)::int from canonical_title_conflict_rows) as canonical_title_conflicts,
			(select count(*)::int from series_position_conflict_rows) as series_position_conflicts
	`, []),
	safeAdminLoad("Catalog metadata health", () => loadCatalogMetadataHealth(sql, catalogHealthFilters), emptyCatalogHealth),
	safeAdminLoad("Canonical title cleanup", () => loadCanonicalTitleCleanupCandidates(sql, 50), []),
	safeAdminLoad("Backfill movement", () => sql<Array<{
		updated_books_24h: number;
		updated_books_7d: number;
		updated_authors_24h: number;
		updated_authors_7d: number;
	}>>`
		select
			(select count(*)::int from book where updated_at >= now() - interval '24 hours') as updated_books_24h,
			(select count(*)::int from book where updated_at >= now() - interval '7 days') as updated_books_7d,
			(select count(*)::int from author where updated_at >= now() - interval '24 hours') as updated_authors_24h,
			(select count(*)::int from author where updated_at >= now() - interval '7 days') as updated_authors_7d
	`, [])
]);

const bookCoverageRows = safeArray(bookCoverageResult.data);
const genreCoverageRows = safeArray(genreCoverageResult.data);
const authorCoverageRows = safeArray(authorCoverageResult.data);
const importHealthRows = safeArray(importHealthResult.data);
const duplicateGroupsRows = safeArray(duplicateGroupsResult.data);
const potentialDuplicateWorksRows = safeArray(potentialDuplicateWorksResult.data);
const relationshipHealthRows = safeArray(relationshipHealthResult.data);
const catalogClampWarnings: string[] = [];
let catalogMetadataHealth = catalogMetadataHealthResult.data || emptyCatalogHealth;
if (catalogMetadataHealth.pagination.total > 0 && catalogHealthFilters.offset >= catalogMetadataHealth.pagination.total) {
	const clampedPage = Math.max(1, Math.ceil(catalogMetadataHealth.pagination.total / catalogPageSize));
	const clampedHealthResult = await safeAdminLoad(
		"Catalog metadata health page clamp",
		() => loadCatalogMetadataHealth(sql, { ...catalogHealthFilters, offset: (clampedPage - 1) * catalogPageSize }),
		emptyCatalogHealth
	);
	if (clampedHealthResult.warning) catalogClampWarnings.push(clampedHealthResult.warning);
	catalogMetadataHealth = clampedHealthResult.data || emptyCatalogHealth;
}
const canonicalTitleCleanupRows = safeArray(canonicalTitleCleanupResult.data);
const recentBackfillRows = safeArray(recentBackfillResult.data);
const adminWarnings = [
	publisherSchemaResult.warning,
	bookCoverageResult.warning,
	genreCoverageResult.warning,
	authorCoverageResult.warning,
	importHealthResult.warning,
	duplicateGroupsResult.warning,
	potentialDuplicateWorksResult.warning,
	relationshipHealthResult.warning,
	catalogMetadataHealthResult.warning,
	canonicalTitleCleanupResult.warning,
	recentBackfillResult.warning,
	...catalogClampWarnings
].filter(Boolean);

const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "metadata-gaps", label: "Metadata Gaps" },
	{ id: "catalog-metadata", label: "Catalog Metadata" },
	{ id: "import-health", label: "Import Health" },
	{ id: "potential-duplicates", label: "Work Duplicates" },
	{ id: "relationship-health", label: "Relationships" },
	{ id: "canonical-title-cleanup", label: "Titles" },
	{ id: "duplicates", label: "Duplicates" },
	{ id: "backfills", label: "Backfills" }
];

function countWithPct(count: unknown, total: unknown) {
	return `${formatNumber(count)} (${percentOf(count, total)}%)`;
}

function catalogSeverityLabel(value: string) {
	if (value === "critical") return "Critical";
	if (value === "needs_attention") return "Needs attention";
	return "Optional";
}

function catalogIssueLabel(value: string) {
	return String(value || "")
		.replace(/[_-]+/g, " ")
		.replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function catalogFilterHref(overrides: Record<string, string>) {
	const params = new URLSearchParams();
	const next = {
		catalog_q: catalogHealthFilters.q,
		catalog_issue: catalogHealthFilters.issueType,
		catalog_severity: catalogHealthFilters.severity,
		catalog_format: catalogHealthFilters.format,
		catalog_provider: catalogHealthFilters.provider,
		...overrides
	};
	for (const [key, value] of Object.entries(next)) {
		if (value && value !== "all") params.set(key, value);
	}
	return `/admin/data-health${params.toString() ? `?${params.toString()}` : ""}#catalog-metadata`;
}

function catalogPageHref(page: number) {
	const params = new URLSearchParams();
	const next = {
		catalog_q: catalogHealthFilters.q,
		catalog_issue: catalogHealthFilters.issueType,
		catalog_severity: catalogHealthFilters.severity,
		catalog_format: catalogHealthFilters.format,
		catalog_provider: catalogHealthFilters.provider,
		catalog_page: page > 1 ? String(page) : ""
	};
	for (const [key, value] of Object.entries(next)) {
		if (value && value !== "all") params.set(key, value);
	}
	return `/admin/data-health${params.toString() ? `?${params.toString()}` : ""}#catalog-metadata`;
}

const books = bookCoverageRows[0] || {
	total_books: 0,
	missing_author: 0,
	missing_cover: 0,
	missing_published_year: 0,
	missing_synopsis: 0,
	missing_isbn: 0,
	missing_page_count: 0,
	missing_publisher: 0,
	missing_series: 0
};
const genres = genreCoverageRows[0] || { books_without_genres: 0, books_with_genres: 0 };
const authors = authorCoverageRows[0] || { total_authors: 0, authors_without_bio: 0, authors_without_photo: 0 };
const imports = importHealthRows[0] || {
	total_user_books: 0,
	active_readers: 0,
	entries_without_total_pages: 0,
	finished_without_date: 0,
	reading_with_zero_progress: 0
};
const relationships = relationshipHealthRows[0] || {
	duplicate_works: 0,
	duplicate_editions: 0,
	broken_series: 0,
	multiple_canonical_works: 0,
	missing_series: 0,
	missing_canonical_title: 0,
	missing_series_position: 0,
	incorrect_standalone: 0,
	canonical_title_conflicts: 0,
	series_position_conflicts: 0
};
const backfills = recentBackfillRows[0] || {
	updated_books_24h: 0,
	updated_books_7d: 0,
	updated_authors_24h: 0,
	updated_authors_7d: 0
};
const catalogIssueOptions = Array.from(new Set([
	"missing_page_count",
	"missing_audiobook_duration",
	"missing_location_count",
	"missing_chapter_count",
	"missing_reading_format_metadata",
	"missing_cover",
	"missing_author",
	"missing_description",
	"missing_publication_year",
	"missing_publisher",
	"missing_identifiers",
	"missing_series_position",
	"missing_series_relationship",
	"malformed_title",
	"progress_not_normalizable",
	"potential_duplicate_work",
	"potential_duplicate_edition",
	...catalogMetadataHealth.issues.map((issue) => issue.issueType)
])).sort();
const catalogFormatOptions = Array.from(new Set([
	...catalogMetadataHealth.facets.formats,
	catalogHealthFilters.format !== "all" ? catalogHealthFilters.format : ""
].filter(Boolean))).sort();
const catalogProviderOptions = Array.from(new Set([
	...catalogMetadataHealth.facets.providers,
	catalogHealthFilters.provider !== "all" ? catalogHealthFilters.provider : ""
].filter(Boolean))).sort();
const catalogTotalPages = Math.max(1, Math.ceil(catalogMetadataHealth.pagination.total / catalogPageSize));
const catalogSafePage = Math.max(1, Math.min(catalogCurrentPage, catalogTotalPages));
const catalogShowingStart = catalogMetadataHealth.pagination.total > 0 ? ((catalogSafePage - 1) * catalogPageSize) + 1 : 0;
const catalogShowingEnd = Math.min(catalogMetadataHealth.pagination.total, catalogShowingStart + catalogMetadataHealth.records.length - 1);
---

<Layout title="Admin Data Health" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="admin-data-health-page">
		<header id="overview" class="hero">
			<h1>Admin Data Health</h1>
			<p>Coverage, duplicate risk, import quality, and backfill movement in one view.</p>
		</header>

		{adminWarnings.length > 0 && (
			<div class="warning-list" role="status">
				{adminWarnings.map((warning) => <p>{warning}</p>)}
			</div>
		)}

		{adminNotices.length > 0 && (
			<div class="notice-list" role="status">
				{adminNotices.map((notice) => <p>{notice}</p>)}
			</div>
		)}

		<section class="panel" id="metadata-gaps">
			<div class="panel-head">
				<h2>Metadata Gaps</h2>
			</div>
			<div class="grid metadata-stats" role="list">
				<article class="stat">
					<p>Total books</p>
					<strong>{formatNumber(books.total_books)}</strong>
				</article>
				<article class="stat">
					<p>Total authors</p>
					<strong>{formatNumber(authors.total_authors)}</strong>
				</article>
				<article class="stat">
					<p>Cover coverage</p>
					<strong>{percentOf(books.total_books - books.missing_cover, books.total_books)}%</strong>
				</article>
				<article class="stat">
					<p>Synopsis coverage</p>
					<strong>{percentOf(books.total_books - books.missing_synopsis, books.total_books)}%</strong>
				</article>
				<article class="stat">
					<p>Genre coverage</p>
					<strong>{percentOf(genres.books_with_genres, books.total_books)}%</strong>
				</article>
				<article class="stat">
					<p>Page count coverage</p>
					<strong>{percentOf(books.total_books - books.missing_page_count, books.total_books)}%</strong>
				</article>
				<article class="stat">
					<p>Publisher coverage</p>
					<strong>{percentOf(books.total_books - books.missing_publisher, books.total_books)}%</strong>
				</article>
				<article class="stat">
					<p>Potential duplicate Works</p>
					<strong>{formatNumber(potentialDuplicateWorksRows.length)}</strong>
				</article>
				<article class="stat">
					<p>Canonical title cleanup</p>
					<strong>{formatNumber(canonicalTitleCleanupRows.length)}</strong>
				</article>
				<article class="stat">
					<p>Series position conflicts</p>
					<strong>{formatNumber(relationships.series_position_conflicts)}</strong>
				</article>
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Signal</th><th>Count</th></tr>
					</thead>
					<tbody>
						<tr><td>Books missing author</td><td>{formatNumber(books.missing_author)}</td></tr>
						<tr><td>Books missing cover</td><td>{formatNumber(books.missing_cover)}</td></tr>
						<tr><td>Books missing published year</td><td>{formatNumber(books.missing_published_year)}</td></tr>
						<tr><td>Books missing synopsis</td><td>{formatNumber(books.missing_synopsis)}</td></tr>
						<tr><td>Books missing ISBN</td><td>{formatNumber(books.missing_isbn)}</td></tr>
						<tr><td>Books missing page count</td><td>{formatNumber(books.missing_page_count)}</td></tr>
						<tr><td>Books missing publisher</td><td>{formatNumber(books.missing_publisher)}</td></tr>
						<tr><td>Books with possible missing series</td><td>{formatNumber(books.missing_series)}</td></tr>
						<tr><td>Potential duplicate Works</td><td>{formatNumber(potentialDuplicateWorksRows.length)}</td></tr>
						<tr><td>Duplicate Works</td><td>{formatNumber(relationships.duplicate_works)}</td></tr>
						<tr><td>Duplicate Editions</td><td>{formatNumber(relationships.duplicate_editions)}</td></tr>
						<tr><td>Broken Series</td><td>{formatNumber(relationships.broken_series)}</td></tr>
						<tr><td>Multiple Canonical Works</td><td>{formatNumber(relationships.multiple_canonical_works)}</td></tr>
						<tr><td>Missing Canonical Title</td><td>{formatNumber(relationships.missing_canonical_title)}</td></tr>
						<tr><td>Missing Series Position</td><td>{formatNumber(relationships.missing_series_position)}</td></tr>
						<tr><td>Incorrect standalone classification</td><td>{formatNumber(relationships.incorrect_standalone)}</td></tr>
						<tr><td>Canonical title conflicts</td><td>{formatNumber(relationships.canonical_title_conflicts)}</td></tr>
						<tr><td>Series position conflicts</td><td>{formatNumber(relationships.series_position_conflicts)}</td></tr>
						<tr><td>Canonical title cleanup candidates</td><td>{formatNumber(canonicalTitleCleanupRows.length)}</td></tr>
						<tr><td>Books without genres</td><td>{formatNumber(genres.books_without_genres)}</td></tr>
						<tr><td>Authors without bio</td><td>{countWithPct(authors.authors_without_bio, authors.total_authors)}</td></tr>
						<tr><td>Authors without photo</td><td>{countWithPct(authors.authors_without_photo, authors.total_authors)}</td></tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="panel" id="catalog-metadata">
			<div class="panel-head">
				<h2>Catalog Metadata</h2>
				<p>Format-aware Work and Edition health checks for progress normalization, canonical grouping, search dedupe, and reader-facing BookCards.</p>
			</div>
			<div class="grid metadata-stats" role="list">
				<article class="stat">
					<p>Catalog records needing attention</p>
					<strong>{formatNumber(catalogMetadataHealth.summary.totalRecords)}</strong>
				</article>
				<article class="stat">
					<p>Critical</p>
					<strong>{formatNumber(catalogMetadataHealth.summary.critical)}</strong>
				</article>
				<article class="stat">
					<p>Missing page counts</p>
					<strong>{formatNumber(catalogMetadataHealth.summary.missingPageCounts)}</strong>
				</article>
				<article class="stat">
					<p>Missing audiobook duration</p>
					<strong>{formatNumber(catalogMetadataHealth.summary.missingAudiobookDurations)}</strong>
				</article>
				<article class="stat">
					<p>Progress-blocking metadata issues</p>
					<strong>{formatNumber(catalogMetadataHealth.summary.progressBlocking)}</strong>
				</article>
				<article class="stat">
					<p>Potential duplicate Works</p>
					<strong>{formatNumber(catalogMetadataHealth.summary.potentialDuplicates)}</strong>
				</article>
			</div>
			<form class="catalog-health-filters" method="get" action="/admin/data-health">
				<label>
					<span>Search Work or Edition</span>
					<input type="search" name="catalog_q" value={catalogHealthFilters.q} placeholder="Title, author, Work ID, Edition ID, ISBN" />
				</label>
				<label>
					<span>Issue</span>
					<select name="catalog_issue">
						<option value="all">All issues</option>
						{catalogIssueOptions.map((issueType) => (
							<option value={issueType} selected={catalogHealthFilters.issueType === issueType}>{catalogIssueLabel(issueType)}</option>
						))}
					</select>
				</label>
				<label>
					<span>Severity</span>
					<select name="catalog_severity">
						<option value="all">All severities</option>
						<option value="critical" selected={catalogHealthFilters.severity === "critical"}>Critical</option>
						<option value="needs_attention" selected={catalogHealthFilters.severity === "needs_attention"}>Needs attention</option>
						<option value="optional" selected={catalogHealthFilters.severity === "optional"}>Optional</option>
					</select>
				</label>
				<label>
					<span>Format</span>
					<select name="catalog_format">
						<option value="all">All formats</option>
						{catalogFormatOptions.map((format) => (
							<option value={format} selected={catalogHealthFilters.format === format}>{format}</option>
						))}
					</select>
				</label>
				<label>
					<span>Provider</span>
					<select name="catalog_provider">
						<option value="all">All providers</option>
						{catalogProviderOptions.map((provider) => (
							<option value={provider} selected={catalogHealthFilters.provider === provider}>{provider}</option>
						))}
					</select>
				</label>
				<div class="catalog-filter-actions">
					<button type="submit">Apply filters</button>
					<a href="/admin/data-health#catalog-metadata">Clear</a>
				</div>
			</form>
			<div class="quick-filters" aria-label="Catalog health quick filters">
				<a href={catalogFilterHref({ catalog_severity: "critical" })}>Critical</a>
				<a href={catalogFilterHref({ catalog_issue: "missing_audiobook_duration" })}>Audiobook durations</a>
				<a href={catalogFilterHref({ catalog_issue: "progress_not_normalizable" })}>Progress blocking</a>
				<a href={catalogFilterHref({ catalog_issue: "potential_duplicate_work" })}>Duplicate Works</a>
			</div>
			<p class="table-context" aria-live="polite">
				{catalogMetadataHealth.pagination.total > 0
					? `Showing ${formatNumber(catalogShowingStart)}–${formatNumber(catalogShowingEnd)} of ${formatNumber(catalogMetadataHealth.pagination.total)} records`
					: "No records to show"}
			</p>
			<div class="table-wrap catalog-health-table">
				<table>
					<thead>
						<tr><th>Book</th><th>Needs attention</th><th>Severity</th><th>Format</th><th>Source</th><th>Updated</th><th>Action</th></tr>
					</thead>
					<tbody>
						{catalogMetadataHealth.records.length === 0 ? (
							<tr><td colspan="7">No catalog metadata issues matched the current filters.</td></tr>
						) : catalogMetadataHealth.records.map((record) => (
							<tr>
								<td>
									<div class="catalog-book-cell">
										{record.coverUrl ? <img src={record.coverUrl} alt="" loading="lazy" decoding="async" /> : <span class="cover-placeholder" aria-hidden="true"><span class="material-icons">menu_book</span></span>}
										<div>
											<strong>{record.title}</strong><br />
											<span class="muted">{record.author} · Work {record.workId}{record.editionId ? ` · Edition ${record.editionId}` : ""}</span>
										</div>
									</div>
								</td>
								<td>
									<div class="issue-stack">
										{record.issues.slice(0, 3).map((issue) => (
											<span>{issue.issue}</span>
										))}
										{record.issues.length > 3 && <span class="muted">+{formatNumber(record.issues.length - 3)} more</span>}
									</div>
								</td>
								<td><span class={`severity-chip ${record.severity}`}>{catalogSeverityLabel(record.severity)}</span></td>
								<td>{record.format || "unknown"}</td>
								<td>{record.source}</td>
								<td>{formatDate(record.updatedAt)}</td>
								<td><a href={`/admin/books/${record.workId}${record.editionId ? `?editionId=${record.editionId}` : ""}`}>Edit catalog data</a></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			{catalogTotalPages > 1 && (
				<Pagination
					currentPage={catalogSafePage}
					totalPages={catalogTotalPages}
					previousHref={catalogSafePage > 1 ? catalogPageHref(catalogSafePage - 1) : ""}
					nextHref={catalogSafePage < catalogTotalPages ? catalogPageHref(catalogSafePage + 1) : ""}
					label="Catalog metadata pagination"
				/>
			)}
			<p class="note">The queue edits shared catalog records only. Shelf state, reading format, progress, ratings, and journal content remain reader-owned data and are not cached or exposed here.</p>
		</section>

		<section class="panel" id="import-health">
			<div class="panel-head">
				<h2>Import Health</h2>
			</div>
			<div class="grid four">
				<article class="stat">
					<p>Total shelf entries</p>
					<strong>{formatNumber(imports.total_user_books)}</strong>
				</article>
				<article class="stat">
					<p>Active readers</p>
					<strong>{formatNumber(imports.active_readers)}</strong>
				</article>
				<article class="stat">
					<p>Reading with 0 progress</p>
					<strong>{formatNumber(imports.reading_with_zero_progress)}</strong>
				</article>
				<article class="stat">
					<p>Finished missing date</p>
					<strong>{formatNumber(imports.finished_without_date)}</strong>
				</article>
			</div>
			<p class="note">These are reliability proxies for import quality and shelf consistency.</p>
		</section>

		<section class="panel" id="potential-duplicates">
			<div class="panel-head">
				<h2>Potential Duplicate Works</h2>
				<p>{formatNumber(potentialDuplicateWorksRows.length)} high-confidence duplicate Work groups shown for admin review.</p>
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Canonical Work</th><th>Duplicate</th><th>Confidence</th><th>Reasoning</th><th>Action</th></tr>
					</thead>
					<tbody>
						{potentialDuplicateWorksRows.length === 0 ? (
							<tr><td colspan="5">No high-confidence duplicate Works detected.</td></tr>
						) : potentialDuplicateWorksRows.flatMap((group) => group.duplicates.map((duplicate) => (
							<tr>
								<td>
									<strong>{group.target.normalizedTitle || group.target.title}</strong><br />
									<span class="muted">#{group.target.bookId} · {group.target.author || "Unknown"} · {group.target.seriesName ? `${group.target.seriesName}${group.target.seriesBookOrder > 0 ? ` Book ${group.target.seriesBookOrder}` : ""}` : "No series"}</span>
								</td>
								<td>
									<strong>{duplicate.normalizedTitle || duplicate.title}</strong><br />
									<span class="muted">#{duplicate.bookId} · {duplicate.title}</span>
								</td>
								<td>{formatNumber(group.confidenceScore)}%</td>
								<td>{group.reasons.join(" ")}</td>
								<td>
									<div class="row-actions">
										<form method="post">
											<input type="hidden" name="action" value="merge-duplicate-work" />
											<input type="hidden" name="groupKey" value={group.groupKey} />
											<input type="hidden" name="targetBookId" value={String(group.target.bookId)} />
											<input type="hidden" name="sourceBookId" value={String(duplicate.bookId)} />
											<input type="hidden" name="reason" value={group.reasons.join(" ")} />
											<button type="submit">Merge</button>
										</form>
										<form method="post">
											<input type="hidden" name="action" value="ignore-duplicate-work" />
											<input type="hidden" name="groupKey" value={group.groupKey} />
											<input type="hidden" name="targetBookId" value={String(group.target.bookId)} />
											<input type="hidden" name="sourceBookId" value={String(duplicate.bookId)} />
											<input type="hidden" name="reason" value="Reviewed from Data Health." />
											<button class="secondary" type="submit">Ignore</button>
										</form>
									</div>
								</td>
							</tr>
						)))}
					</tbody>
				</table>
			</div>
			<p class="note">Suggestions use canonical title, author, series position, edition identifiers, ISBNs, and provider IDs. Admins approve or ignore each merge; uncertain matches are not merged automatically.</p>
		</section>

		<section class="panel" id="relationship-health">
			<div class="panel-head">
				<h2>Canonical Relationship Health</h2>
				<p>Work, Edition, Series, and standalone-classification checks for catalog normalization.</p>
			</div>
			<div class="actions">
				<form method="post">
					<input type="hidden" name="action" value="canonical-work-normalization" />
					<button type="submit">Normalize canonical Works</button>
				</form>
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Check</th><th>Count</th></tr>
					</thead>
					<tbody>
						<tr><td>Duplicate Works</td><td>{formatNumber(relationships.duplicate_works)}</td></tr>
						<tr><td>Duplicate Editions</td><td>{formatNumber(relationships.duplicate_editions)}</td></tr>
						<tr><td>Broken Series</td><td>{formatNumber(relationships.broken_series)}</td></tr>
						<tr><td>Multiple Canonical Works</td><td>{formatNumber(relationships.multiple_canonical_works)}</td></tr>
						<tr><td>Missing Series</td><td>{formatNumber(relationships.missing_series)}</td></tr>
						<tr><td>Missing Canonical Title</td><td>{formatNumber(relationships.missing_canonical_title)}</td></tr>
						<tr><td>Missing Series Position</td><td>{formatNumber(relationships.missing_series_position)}</td></tr>
						<tr><td>Incorrect Standalone Classification</td><td>{formatNumber(relationships.incorrect_standalone)}</td></tr>
						<tr><td>Canonical Title Conflicts</td><td>{formatNumber(relationships.canonical_title_conflicts)}</td></tr>
						<tr><td>Series Position Conflicts</td><td>{formatNumber(relationships.series_position_conflicts)}</td></tr>
					</tbody>
				</table>
			</div>
			<p class="note">Normalization first attaches known-series metadata, then cleans redundant title suffixes, then merges only high-confidence duplicate Works using the merge path that preserves shelves, ratings, reviews, activity, journal entries, recommendations, editions, and imports.</p>
		</section>

		<section class="panel" id="canonical-title-cleanup">
			<div class="panel-head">
				<h2>Canonical Title Cleanup</h2>
				<p>{formatNumber(canonicalTitleCleanupRows.length)} redundant series title suffixes detected (up to 50 shown).</p>
			</div>
			<div class="actions">
				<form method="post">
					<input type="hidden" name="action" value="canonical-title-cleanup" />
					<button type="submit">Normalize redundant series titles</button>
				</form>
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Current title</th><th>Canonical title</th><th>Series</th><th>Book</th><th>Updated</th></tr>
					</thead>
					<tbody>
						{canonicalTitleCleanupRows.length === 0 ? (
							<tr><td colspan="5">No redundant series title suffixes detected.</td></tr>
						) : canonicalTitleCleanupRows.map((row) => (
							<tr>
								<td>{row.title || "Untitled"}</td>
								<td>{row.normalizedTitle || "Untitled"}</td>
								<td>{row.seriesName || "Unknown series"}</td>
								<td>{row.bookOrder > 0 ? `Book ${row.bookOrder}` : "—"}</td>
								<td>{formatDate(row.updatedAt)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="note">This check only removes trailing parenthetical series text when the book already has matching structured series metadata.</p>
		</section>

		<section class="panel" id="duplicates">
			<div class="panel-head">
				<h2>Duplicate Clusters</h2>
				<p>{formatNumber(duplicateGroupsRows.length)} duplicate canonical work-key groups (top 25 shown).</p>
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Canonical key</th><th>Books</th><th>Sample title</th><th>Author</th><th>Last update</th></tr>
					</thead>
					<tbody>
						{duplicateGroupsRows.length === 0 ? (
							<tr><td colspan="5">No duplicate canonical work-key groups detected.</td></tr>
						) : duplicateGroupsRows.map((row) => (
							<tr>
								<td><code>{row.canonical_work_key}</code></td>
								<td>{formatNumber(row.books)}</td>
								<td>{row.sample_title || "Untitled"}</td>
								<td>{row.sample_author || "Unknown"}</td>
								<td>{formatDate(row.latest_update_at)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="panel" id="backfills">
			<div class="panel-head">
				<h2>Backfill Movement</h2>
			</div>
			<div class="grid four">
				<article class="stat">
					<p>Books updated (24h)</p>
					<strong>{formatNumber(backfills.updated_books_24h)}</strong>
				</article>
				<article class="stat">
					<p>Books updated (7d)</p>
					<strong>{formatNumber(backfills.updated_books_7d)}</strong>
				</article>
				<article class="stat">
					<p>Authors updated (24h)</p>
					<strong>{formatNumber(backfills.updated_authors_24h)}</strong>
				</article>
				<article class="stat">
					<p>Authors updated (7d)</p>
					<strong>{formatNumber(backfills.updated_authors_7d)}</strong>
				</article>
			</div>
			<div class="actions">
				<a href="/roadmap">Roadmap</a>
				<a href="/settings#import-dashboard">Import Dashboard</a>
			</div>
		</section>

	</div>
</Layout>

<style>
	.admin-data-health-page { max-width: 980px; }
	.hero h1 { margin: 0; }
	.hero p { margin: 0.35rem 0 0; color: var(--color-text-muted); }
	.warning-list {
		margin-top: 1rem;
		border: var(--border-subtle);
		border-radius: var(--radius-md);
		background: #fffaf0;
		color: #6b3f0a;
		padding: 0.65rem 0.75rem;
	}
	.warning-list p { margin: 0; }
	.warning-list p + p { margin-top: 0.3rem; }
	.notice-list {
		margin-top: 1rem;
		border: var(--border-subtle);
		border-radius: var(--radius-md);
		background: rgba(31, 122, 69, 0.08);
		color: var(--color-primary);
		padding: 0.65rem 0.75rem;
	}
	.notice-list p { margin: 0; }
	.notice-list p + p { margin-top: 0.3rem; }
