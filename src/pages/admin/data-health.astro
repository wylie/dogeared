		display: grid;
		gap: 0.25rem;
		color: #444;
		font-size: 0.8rem;
		font-weight: 700;
		min-width: 0;
	}
	.catalog-health-filters input,
	.catalog-health-filters select {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		box-sizing: border-box;
		border: var(--border-subtle);
		border-radius: var(--radius-sm);
		background: #fff;
		color: var(--color-text);
		font: inherit;
		font-weight: 500;
		padding: 0.45rem 0.5rem;
	}
	.catalog-filter-actions,
	.quick-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		align-items: center;
	}
