---
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import { resolveAdminSession } from "../../lib/admin";
import { getNeonSql } from "../../lib/neon";
import {
	countAdminUsers,
	deleteAdminUser,
	ensureAdminSupportSchema,
	loadAdminUserListRows,
	normalizeAdminUsersPagination,
	type AdminUserSummary
} from "../../lib/adminData";
import { formatDate, formatNumber, safeAdminLoad } from "../../lib/adminFormatting";
import { recordPerformanceEventSafe, type PerformanceSpanInput } from "../../lib/performanceTelemetry";

export const prerender = false;

const pageStartedAt = performance.now();
const pageSpans: PerformanceSpanInput[] = [];
const recordSpan = (name: string, startedAt: number, status = "OK", parentName = "") => {
	pageSpans.push({
		name,
		durationMs: Math.round(Math.max(0, performance.now() - startedAt) * 10) / 10,
		startMs: Math.round(Math.max(0, startedAt - pageStartedAt) * 10) / 10,
		status,
		...(parentName ? { parentName } : {})
	});
};
const recordMarkerSpan = (name: string, parentName = "") => {
	pageSpans.push({
		name,
		durationMs: 0,
		startMs: Math.round(Math.max(0, performance.now() - pageStartedAt) * 10) / 10,
		status: "OK",
		...(parentName ? { parentName } : {})
	});
};
const authStartedAt = performance.now();
const admin = await resolveAdminSession(Astro.request);
recordSpan("authentication/admin authorization", authStartedAt);
if (!admin.isAdmin) return Astro.redirect("/");

const query = String(Astro.url.searchParams.get("q") || "").trim();
const requestedPage = Astro.url.searchParams.get("page") || "1";
const paginationRequest = normalizeAdminUsersPagination({ query, page: requestedPage, pageSize: 25 });
const sql = getNeonSql();
let actionMessage = Astro.url.searchParams.get("deleted") === "1" ? "User deleted." : "";
let actionError = false;

if (Astro.request.method === "POST") {
	try {
		const form = await Astro.request.formData();
		const intent = String(form.get("intent") || "").trim();
		const userId = String(form.get("userId") || "").trim();
		if (intent !== "delete-user") {
			actionMessage = "Invalid admin action.";
			actionError = true;
		} else {
			const result = await deleteAdminUser(sql, userId, admin.userId);
			actionMessage = result.message;
			actionError = !result.ok;
		}
	} catch (error) {
		if (import.meta.env.DEV) {
			console.warn("[admin.users.post.failed]", error instanceof Error ? error.message : error);
		}
		actionMessage = "User action could not be completed.";
		actionError = true;
	}
}

const schemaResult = await safeAdminLoad("Admin Users schema", async () => {
	const startedAt = performance.now();
	await ensureAdminSupportSchema(sql);
	recordSpan("schema/index setup", startedAt);
	return true;
}, false);

const usersFallback = {
	users: [] as AdminUserSummary[],
	total: 0
};
const usersLoadStartedAt = performance.now();
const [countResult, rowsResult] = schemaResult.data
	? await Promise.all([
		safeAdminLoad("Admin Users count", async () => {
			const startedAt = performance.now();
			const total = await countAdminUsers(sql, paginationRequest.query);
			recordSpan("pagination/count query", startedAt);
			return total;
		}, usersFallback.total),
		safeAdminLoad("Admin Users list", async () => {
			const startedAt = performance.now();
			const rows = await loadAdminUserListRows(sql, paginationRequest.query, paginationRequest.page, paginationRequest.pageSize);
			recordSpan("user-list database query", startedAt);
			recordMarkerSpan("profile data", "user-list database query");
			recordMarkerSpan("shelf/count aggregation", "user-list database query");
			return rows;
		}, usersFallback.users)
	])
	: [
		{ data: usersFallback.total, warning: schemaResult.warning },
		{ data: usersFallback.users, warning: schemaResult.warning }
	];
recordSpan("admin users data loading", usersLoadStartedAt);
recordMarkerSpan("reading statistics deferred to User Detail");
recordMarkerSpan("streak calculations deferred to User Detail");
recordMarkerSpan("achievement loading deferred to User Detail");

const users = rowsResult.data;
const totalUsers = countResult.data;
const totalPages = Math.max(1, Math.ceil(totalUsers / paginationRequest.pageSize));
const currentPage = Math.max(1, Math.min(totalPages, paginationRequest.page));
const pagination = {
	...paginationRequest,
	page: currentPage,
	total: totalUsers,
	totalPages,
	offset: (currentPage - 1) * paginationRequest.pageSize
};
const pageHref = (page: number) => {
	const params = new URLSearchParams();
	if (query) params.set("q", query);
	if (page > 1) params.set("page", String(page));
	const suffix = params.toString();
	return suffix ? `/admin/users?${suffix}` : "/admin/users";
};
const previousHref = pagination.page > 1 ? pageHref(pagination.page - 1) : "";
const nextHref = pagination.page < pagination.totalPages ? pageHref(pagination.page + 1) : "";
const firstItem = users.length > 0 ? pagination.offset + 1 : 0;
const lastItem = users.length > 0 ? pagination.offset + users.length : 0;

const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "user-search", label: "Search" },
	{ id: "user-list", label: "Users" }
];

const renderPrepStartedAt = performance.now();
recordSpan("final server rendering preparation", renderPrepStartedAt);
recordPerformanceEventSafe(sql, {
	operationName: "page.admin-users",
	route: "/admin/users",
	totalMs: performance.now() - pageStartedAt,
	success: !schemaResult.warning && !countResult.warning && !rowsResult.warning,
	httpStatus: 200,
	spans: pageSpans,
	metadata: {
		boundedDataQueryCount: 2,
		userListQueryCount: 1,
		userRowsReturned: users.length,
		totalUsers,
		page: pagination.page,
		pageSize: pagination.pageSize,
		searchActive: query !== "",
		schemaWarning: !!schemaResult.warning,
		countWarning: !!countResult.warning,
		rowsWarning: !!rowsResult.warning
	}
});
---

<Layout title="Admin Users" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="admin-users-page">
		<header id="overview" class="hero">
			<h1>Admin Users</h1>
			<p>Find readers by username or email and review basic account health.</p>
		</header>

		<section class="panel" id="user-search">
			<div class="panel-head">
				<h2>Search</h2>
			</div>
			<form class="search-form" method="get" action="/admin/users">
				<label for="user-search-input">Username or email</label>
				<div class="search-row">
					<input id="user-search-input" name="q" type="search" value={query} placeholder="wylie or reader@example.com" />
					<button type="submit">Search</button>
					{query && <a class="secondary-link" href="/admin/users">Clear</a>}
				</div>
			</form>
		</section>

		<section class="panel" id="user-list">
			<div class="panel-head">
				<h2>Users</h2>
				<p>
					{users.length > 0
						? `${formatNumber(firstItem)}-${formatNumber(lastItem)} of ${formatNumber(totalUsers)} ${totalUsers === 1 ? "user" : "users"}`
						: `0 of ${formatNumber(totalUsers)} users`}
				</p>
			</div>
			<p class="danger-note">Books on shelves are shelf entries from reader accounts, not distinct shelf names. Deleting a user removes reader-owned data including shelves, ratings, reviews, progress, activity, comments, follows, notifications, sessions, magic links, custom shelves, and pending email changes. Catalog books and authors are preserved.</p>
			{actionMessage && <p class={`admin-message${actionError ? " error" : ""}`} role="status">{actionMessage}</p>}
			{schemaResult.warning && <p class="admin-message error" role="status">{schemaResult.warning}</p>}
			{countResult.warning && countResult.warning !== schemaResult.warning && <p class="admin-message error" role="status">{countResult.warning}</p>}
			{rowsResult.warning && rowsResult.warning !== schemaResult.warning && <p class="admin-message error" role="status">{rowsResult.warning}</p>}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Reader</th>
							<th>Email</th>
							<th>Status</th>
							<th>Joined</th>
							<th>Last activity</th>
							<th>Books on shelves</th>
							<th>Reviews</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{users.length === 0 ? (
							<tr><td colspan="8">No users matched that search.</td></tr>
						) : users.map((user) => (
							<tr>
								<td>
									{user.username ? (
										<span class="reader-cell">
											{user.avatar ? <img src={user.avatar} alt="" loading="lazy" decoding="async" /> : <span class="reader-avatar-placeholder" aria-hidden="true">{(user.displayName || user.username || "?").slice(0, 1).toUpperCase()}</span>}
											<span>
												<a class="table-link" href={`/admin/users/${encodeURIComponent(user.username)}`}>{user.displayName || `@${user.username}`}</a>
												<small>@{user.username}</small>
											</span>
										</span>
									) : (
										<span class="muted">No username</span>
									)}
								</td>
								<td>{user.email || "Unknown"}</td>
								<td>{user.status || "active"}</td>
								<td>{formatDate(user.joinedAt)}</td>
								<td>{user.lastActivityAt ? formatDate(user.lastActivityAt) : "No activity"}</td>
								<td>{formatNumber(user.shelfEntryCount)}</td>
								<td>{formatNumber(user.reviewCount)}</td>
								<td>
									{user.id === admin.userId ? (
										<span class="muted">Current admin</span>
									) : (
										<form method="post" class="inline-delete-form" data-delete-user-list-form data-username={user.username ? `@${user.username}` : user.email || "this user"}>
											<input type="hidden" name="intent" value="delete-user" />
											<input type="hidden" name="userId" value={user.id} />
											<button type="submit" class="danger-button">Delete</button>
										</form>
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<Pagination
				currentPage={pagination.page}
				totalPages={pagination.totalPages}
				previousHref={previousHref}
				nextHref={nextHref}
				label="Admin users pagination"
			/>
		</section>
	</div>
</Layout>

<script>
	document.querySelectorAll("[data-delete-user-list-form]").forEach((form) => {
		form.addEventListener("submit", (event) => {
			const username = form instanceof HTMLElement ? form.dataset.username || "this user" : "this user";
			if (!window.confirm(`Delete ${username} and their reader-owned data? This cannot be undone.`)) {
				event.preventDefault();
			}
		});
	});
</script>

<style>
	.admin-users-page { max-width: 980px; }
	.hero h1 { margin: 0; }
	.hero p { margin: 0.35rem 0 0; color: var(--color-text-muted); }
	.panel { margin-top: 1rem; border: var(--border-subtle); border-radius: var(--radius-lg); background: var(--color-surface-raised); padding: 1rem; }
	.panel-head h2 { margin: 0; }
	.panel-head p { margin: 0.3rem 0 0; color: #575757; font-size: 0.9rem; }
	.search-form { display: grid; gap: 0.4rem; margin-top: 0.65rem; }
	.search-form label { font-weight: 700; font-size: 0.9rem; color: #3f3f3f; }
	.search-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
	.search-row input {
		flex: 1 1 260px;
		min-width: 0;
		height: 38px;
		border: var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0 0.65rem;
		font: inherit;
	}
	.search-row button {
		height: 38px;
		border: none;
		border-radius: 8px;
		padding: 0 0.85rem;
		background: var(--color-primary);
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.secondary-link,
	.table-link { color: var(--color-nav); font-weight: 700; text-decoration: none; }
	.secondary-link:hover,
	.table-link:hover { color: var(--color-nav-hover); text-decoration: underline; }
	.danger-note { margin: 0.55rem 0 0; color: #575757; font-size: 0.86rem; line-height: 1.4; }
	.admin-message {
		margin: 0.65rem 0 0;
		min-height: 1.2rem;
		color: var(--color-primary);
		font-weight: 700;
	}
	.admin-message.error { color: #991b1b; }
	.table-wrap { margin-top: 0.7rem; overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
	th, td { text-align: left; padding: 0.45rem; border-bottom: var(--border-subtle); vertical-align: top; }
	th { font-weight: 700; color: #444; }
	.reader-cell {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 180px;
	}
	.reader-cell img,
	.reader-avatar-placeholder {
		width: 32px;
		height: 32px;
		border-radius: 999px;
		flex: 0 0 auto;
		object-fit: cover;
		background: var(--color-nav-surface);
		border: var(--border-subtle);
	}
	.reader-avatar-placeholder {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
		font-weight: 800;
	}
	.reader-cell small {
		display: block;
		margin-top: 0.1rem;
		color: var(--color-text-muted);
	}
	.muted { color: #6b7280; }
	.inline-delete-form { margin: 0; }
	.danger-button {
		border: none;
		border-radius: 8px;
		min-height: 32px;
		padding: 0 0.7rem;
		background: #991b1b;
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.danger-button:hover { background: #7f1d1d; }

	@media (max-width: 720px) {
		.search-row { display: grid; grid-template-columns: 1fr; align-items: stretch; }
		.search-row input,
		.search-row button { width: 100%; }
	}
</style>
