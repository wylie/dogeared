<script>
	const summary = document.querySelector("[data-health-summary]");
	const countNode = summary?.querySelector("[data-health-summary-count]");
	const issueNodes = Array.from(document.querySelectorAll("[data-health-summary-item]"));
	const initialFieldValues = new Map();
	for (const container of document.querySelectorAll("[data-health-field]")) {
		const field = container.getAttribute("data-health-field") || "";
		const values = Array.from(container.querySelectorAll("input, select, textarea")).map((control) => String(control.value || "").trim());
		initialFieldValues.set(field, values);
	}
	function isFieldCorrected(field) {
		const containers = Array.from(document.querySelectorAll(`[data-health-field="${CSS.escape(field)}"]`));
		return containers.some((container) => {
			const controls = Array.from(container.querySelectorAll("input, select, textarea"));
			return controls.some((control, index) => {
				const value = String(control.value || "").trim();
				const initialValue = initialFieldValues.get(field)?.[index] || "";
				if (control instanceof HTMLSelectElement) return value !== "" && value !== "0" && value !== initialValue;
				if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement) return value !== "" && (initialValue === "" || value !== initialValue);
				return false;
			});
		});
	}
	function refreshHealthState() {
		let visibleIssues = 0;
		for (const item of issueNodes) {
			const field = item.getAttribute("data-health-summary-item") || "";
			const corrected = field && isFieldCorrected(field);
			item.toggleAttribute("hidden", corrected);
			if (!corrected) visibleIssues += 1;
			for (const container of document.querySelectorAll(`[data-health-field="${CSS.escape(field)}"]`)) {
				container.classList.toggle("is-corrected", corrected);
			}
		}
		if (countNode) {
			countNode.textContent = visibleIssues > 0
				? `${visibleIssues.toLocaleString()} issue${visibleIssues === 1 ? "" : "s"} require attention`
				: "All visible Data Health issues look corrected. Save to clear them from Data Health.";
		}
		summary?.classList.toggle("is-healthy", visibleIssues === 0);
		summary?.classList.toggle("has-issues", visibleIssues > 0);
	}
	document.addEventListener("input", (event) => {
		if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) refreshHealthState();
	});
	document.addEventListener("change", (event) => {
		if (event.target instanceof HTMLSelectElement || event.target instanceof HTMLInputElement) refreshHealthState();
	});
	for (const link of document.querySelectorAll("[data-health-summary-link]")) {
		link.addEventListener("click", (event) => {
			const targetField = link.getAttribute("data-target-field") || "";
			const target = document.getElementById(`field-${targetField}`);
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: "smooth", block: "center" });
			const focusable = target.querySelector("input, select, textarea, summary");
			if (focusable instanceof HTMLElement) focusable.focus({ preventScroll: true });
			history.replaceState(null, "", `#field-${targetField}`);
		});
	}
	refreshHealthState();
</script>
