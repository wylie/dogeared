	.health-summary.is-healthy { border-color: rgba(31, 122, 69, 0.32); background: rgba(31, 122, 69, 0.06); }
	.health-summary-head {
		display: flex;
		gap: 0.55rem;
		align-items: flex-start;
	}
	.health-summary-head .material-icons {
		color: #6b3f0a;
		font-size: 1.25rem;
		margin-top: 0.05rem;
	}
	.health-summary.is-healthy .material-icons { color: var(--color-primary); }
	.health-summary h2 {
		margin: 0;
		font-size: 1rem;
	}
	.health-summary p {
		margin: 0.16rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}
