	.has-health-issue.needs_attention select,
	.has-health-issue.needs_attention textarea {
		border-color: #991b1b;
		box-shadow: 0 0 0 1px rgba(153, 27, 27, 0.18);
	}
	.has-health-issue.optional input,
	.has-health-issue.optional select,
	.has-health-issue.optional textarea {
		border-color: var(--palette-2);
		box-shadow: 0 0 0 1px rgba(243, 114, 44, 0.16);
	}
	.has-health-issue.critical input:focus,
	.has-health-issue.critical select:focus,
	.has-health-issue.critical textarea:focus,
	.has-health-issue.needs_attention input:focus,
	.has-health-issue.needs_attention select:focus,
	.has-health-issue.needs_attention textarea:focus {
		outline-color: #991b1b;
	}
	.has-health-issue.is-corrected input,
	.has-health-issue.is-corrected select,
	.has-health-issue.is-corrected textarea {
		border: var(--border-subtle);
		box-shadow: none;
	}
	.has-health-issue.is-corrected .warning-icon,
	.has-health-issue.is-corrected .field-warning {
		display: none;
	}
	.field-warning {
		margin: 0.15rem 0 0;
		color: #6b1f1f;
		font-size: 0.82rem;
		font-weight: 700;
	}
	.needs_attention .field-warning { color: #6b3f0a; }
	.optional .field-warning { color: #4d5a66; }
	.why-note {
		margin: 0.05rem 0 0;
		color: var(--color-text-muted);
