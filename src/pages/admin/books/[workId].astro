</style>

<script>
	const form = document.getElementById("catalog-editor");
	const summary = document.querySelector("[data-health-summary]");
	const countNode = summary?.querySelector("[data-health-summary-count]");
	const issueNodes = Array.from(document.querySelectorAll("[data-health-summary-item]"));
	const selectedEditionId = Number(form?.getAttribute("data-selected-edition-id") || 0) || 0;
	const workFallbackCover = String(form?.getAttribute("data-work-fallback-cover") || "").trim();
	const seriesSearch = document.querySelector("[data-series-search]");
	const seriesIdInput = document.querySelector("[data-series-id]");
	const seriesCreateNameInput = document.querySelector("[data-series-create-name]");
	const seriesEditor = document.querySelector("[data-series-editor]");
	const seriesResults = document.querySelector("[data-series-results]");
	const seriesClearButton = document.querySelector("[data-series-clear]");
	const seriesPositionInput = document.querySelector("[data-series-position]");
	const seriesOptions = Array.from(document.querySelectorAll("[data-series-option]")).map((option) => ({
		id: Number(option.getAttribute("data-id") || 0) || 0,
		name: option.textContent || ""
	}));
	const coverUrlInput = document.querySelector("[data-cover-url]");
	const preferredCoverUrlInput = document.querySelector("[data-preferred-cover-url]");
	const coverSourceInput = document.querySelector("[data-cover-source]");
	const coverFileInput = document.querySelector("[data-cover-file]");
	const coverUrlTextInput = document.querySelector("[data-cover-url-input]");
	const coverUploadTrigger = document.querySelector("[data-cover-upload-trigger]");
	const coverRemoveButton = document.querySelector("[data-cover-remove]");
	const coverProvenance = document.querySelector("[data-cover-provenance]");
	const coverLayerNote = document.querySelector("[data-cover-layer-note]");
	const coverUploadStatus = document.querySelector("[data-cover-upload-status]");
	const formatSelect = document.querySelector("[data-format-select]");
	const formatHelp = document.querySelector("[data-format-help]");
	const publicationDateInput = document.querySelector("[data-publication-date]");
	const publicationYearInput = document.querySelector("[data-publication-year]");
	const saveBar = document.querySelector("[data-save-bar]");
	const saveButton = document.querySelector("[data-save-button]");
	const discardButton = document.querySelector("[data-discard-changes]");
	let isSubmittingCatalogEditor = false;
	let initialFormSnapshot = "";

	function normalizeSeriesName(value) {
		return String(value || "").trim().toLowerCase().replace(/&/g, " and ").replace(/[^a-z0-9]+/g, " ").replace(/\s+/g, " ").trim();
	}
	function optionLabel(option) {
		return option?.name || "";
	}
	function closeSeriesResults() {
		if (seriesResults instanceof HTMLElement) {
			seriesResults.replaceChildren();
			seriesResults.hidden = true;
		}
	}
	function setSeriesControlSelected(selected) {
		if (seriesSearch instanceof HTMLInputElement) {
			seriesSearch.readOnly = selected;
		}
		if (seriesClearButton instanceof HTMLElement) {
			seriesClearButton.hidden = !selected;
		}
		if (seriesPositionInput instanceof HTMLInputElement) {
			seriesPositionInput.disabled = !selected;
			if (!selected) seriesPositionInput.value = "";
		}
	}
	function selectSeries(option) {
		if (!(seriesSearch instanceof HTMLInputElement)) return;
		if (!(seriesIdInput instanceof HTMLInputElement)) return;
		if (!(seriesCreateNameInput instanceof HTMLInputElement)) return;
		seriesSearch.value = optionLabel(option);
		seriesIdInput.value = String(option?.id || 0);
		seriesCreateNameInput.value = "";
		setSeriesControlSelected(true);
		closeSeriesResults();
		seriesSearch.blur();
		refreshHealthState();
		updateDirtyState();
	}
	function selectCreatedSeries(raw) {
		if (!(seriesSearch instanceof HTMLInputElement)) return;
		if (!(seriesIdInput instanceof HTMLInputElement)) return;
		if (!(seriesCreateNameInput instanceof HTMLInputElement)) return;
		const name = String(raw || "").trim();
		if (!name) return;
		seriesSearch.value = name;
		seriesIdInput.value = "0";
		seriesCreateNameInput.value = name;
		setSeriesControlSelected(true);
		closeSeriesResults();
		seriesSearch.blur();
		refreshHealthState();
		updateDirtyState();
	}
	function clearSeriesSelection() {
		if (seriesSearch instanceof HTMLInputElement) {
			seriesSearch.value = "";
			seriesSearch.readOnly = false;
		}
		if (seriesIdInput instanceof HTMLInputElement) seriesIdInput.value = "0";
		if (seriesCreateNameInput instanceof HTMLInputElement) seriesCreateNameInput.value = "";
		setSeriesControlSelected(false);
		closeSeriesResults();
		refreshHealthState();
		updateDirtyState();
		seriesSearch instanceof HTMLInputElement && seriesSearch.focus();
	}
	function renderSeriesResults(raw, showInitial = false) {
		if (!(seriesResults instanceof HTMLElement)) return;
		seriesResults.replaceChildren();
		const normalized = normalizeSeriesName(raw);
		if (!normalized && !showInitial) {
			seriesResults.hidden = true;
			return;
		}
		const matches = seriesOptions
			.filter((option) => !normalized || normalizeSeriesName(option.name).includes(normalized))
			.slice(0, 6);
		for (const option of matches) {
			const button = document.createElement("button");
			button.type = "button";
			button.textContent = option.name;
			button.addEventListener("click", () => selectSeries(option));
			seriesResults.append(button);
		}
		const exact = seriesOptions.some((option) => normalizeSeriesName(option.name) === normalized);
		if (normalized && !exact) {
			const createButton = document.createElement("button");
			createButton.type = "button";
			createButton.textContent = `+ Create "${String(raw).trim()}"`;
			createButton.addEventListener("click", () => selectCreatedSeries(raw));
			seriesResults.append(createButton);
		}
		seriesResults.hidden = seriesResults.childElementCount === 0;
	}
	function syncSeriesState() {
		if (!(seriesSearch instanceof HTMLInputElement)) return;
		if (!(seriesIdInput instanceof HTMLInputElement)) return;
		if (!(seriesCreateNameInput instanceof HTMLInputElement)) return;
		if (seriesSearch.readOnly) return;
		const raw = seriesSearch.value.trim();
		if (!raw) {
			seriesIdInput.value = "0";
			seriesCreateNameInput.value = "";
			setSeriesControlSelected(false);
			renderSeriesResults("", document.activeElement === seriesSearch);
			return;
		}
		seriesIdInput.value = "0";
		seriesCreateNameInput.value = "";
		setSeriesControlSelected(false);
		if (document.activeElement === seriesSearch) renderSeriesResults(raw);
		else closeSeriesResults();
	}
	seriesSearch?.addEventListener("input", syncSeriesState);
	seriesSearch?.addEventListener("change", syncSeriesState);
	seriesSearch?.addEventListener("focus", () => {
		if (!(seriesSearch instanceof HTMLInputElement) || seriesSearch.readOnly) return;
		renderSeriesResults(seriesSearch.value, true);
	});
	seriesClearButton?.addEventListener("click", clearSeriesSelection);
	document.addEventListener("click", (event) => {
		if (!(seriesResults instanceof HTMLElement)) return;
		if (seriesEditor instanceof HTMLElement && event.target instanceof Node && seriesEditor.contains(event.target)) return;
		seriesResults.hidden = true;
	});

	function ensureCoverImageNode() {
		const existing = document.querySelector("[data-cover-preview]");
		if (existing instanceof HTMLImageElement) return existing;
		const preview = document.querySelector(".cover-preview");
		if (!(preview instanceof HTMLElement)) return null;
		const img = document.createElement("img");
		img.setAttribute("alt", "Selected cover preview");
		img.setAttribute("data-cover-preview", "");
		img.loading = "lazy";
		img.decoding = "async";
		preview.replaceChildren(img);
		return img;
	}
	function setCoverStatus(message, isError = false) {
		if (!(coverUploadStatus instanceof HTMLElement)) return;
		coverUploadStatus.textContent = message;
		coverUploadStatus.hidden = !message;
		coverUploadStatus.classList.toggle("is-error", isError);
	}
	function refreshCoverActionState() {
		const hasEditionCover = coverUrlInput instanceof HTMLInputElement && coverUrlInput.value.trim() !== "";
		if (coverRemoveButton instanceof HTMLButtonElement) coverRemoveButton.hidden = !hasEditionCover;
	}
	function setCoverSourceText(source, hasEditionCover) {
		if (coverProvenance instanceof HTMLElement) {
			coverProvenance.textContent = hasEditionCover
				? source === "upload"
					? "Source: Edition cover · Admin upload"
					: source === "url"
						? "Source: Edition cover · Admin URL"
						: "Source: Edition cover · Existing DogEared data"
				: workFallbackCover
					? "Source: Work fallback cover"
					: "No cover selected";
		}
		if (coverLayerNote instanceof HTMLElement) {
			coverLayerNote.textContent = hasEditionCover
				? "This image is stored on the selected Edition."
				: workFallbackCover
					? "This image is the Work fallback. Uploading here creates an Edition cover for the selected Edition."
					: "No Edition cover is set. Uploading here creates an Edition cover for the selected Edition.";
		}
	}
	function setCoverValue(value, source) {
		const next = String(value || "").trim();
		if (coverUrlInput instanceof HTMLInputElement) coverUrlInput.value = next;
		if (coverSourceInput instanceof HTMLInputElement) coverSourceInput.value = source || "";
		if (coverUrlTextInput instanceof HTMLInputElement) coverUrlTextInput.value = next;
		if (next) {
			const img = ensureCoverImageNode();
			if (img) img.src = next;
		} else {
			if (workFallbackCover) {
				const img = ensureCoverImageNode();
				if (img) img.src = workFallbackCover;
			} else {
				const preview = document.querySelector(".cover-preview");
				if (preview instanceof HTMLElement) preview.innerHTML = '<span class="cover-placeholder" aria-hidden="true" data-cover-placeholder><span class="material-icons">menu_book</span></span>';
			}
		}
		setCoverSourceText(source, !!next);
		refreshCoverActionState();
		refreshHealthState();
		updateDirtyState();
	}
	coverUploadTrigger?.addEventListener("click", () => {
		if (coverFileInput instanceof HTMLInputElement) coverFileInput.click();
	});
	coverFileInput?.addEventListener("change", async () => {
		if (!(coverFileInput instanceof HTMLInputElement)) return;
		const file = coverFileInput.files?.[0];
		if (!file) return;
		const allowed = new Set(["image/jpeg", "image/png", "image/webp"]);
		if (!allowed.has(file.type)) {
			setCoverStatus("Choose a JPEG, PNG, or WebP image.", true);
			coverFileInput.value = "";
			return;
		}
		if (file.size > 750_000) {
			setCoverStatus("Choose a cover image under 750KB.", true);
			coverFileInput.value = "";
			return;
		}
		try {
			setCoverStatus("Uploading...");
			if (coverUploadTrigger instanceof HTMLButtonElement) coverUploadTrigger.disabled = true;
			const reader = new FileReader();
			const dataUrl = await new Promise((resolve, reject) => {
				reader.onload = () => resolve(String(reader.result || ""));
				reader.onerror = () => reject(new Error("Failed to read cover."));
				reader.readAsDataURL(file);
			});
			setCoverValue(dataUrl, "upload");
			setCoverStatus("Cover ready. Save catalog data to persist.");
		} catch {
			setCoverStatus("Could not upload this image. Try again.", true);
		} finally {
			if (coverUploadTrigger instanceof HTMLButtonElement) coverUploadTrigger.disabled = false;
		}
	});
	coverUrlTextInput?.addEventListener("change", () => {
		if (!(coverUrlTextInput instanceof HTMLInputElement)) return;
		const value = coverUrlTextInput.value.trim();
		if (value && !/^https?:\/\//i.test(value)) {
			setCoverStatus("Enter a valid image URL starting with http:// or https://.", true);
			return;
		}
		setCoverValue(value, value ? "url" : "remove");
		setCoverStatus(value ? "Cover URL ready. Save catalog data to persist." : "");
	});
	coverRemoveButton?.addEventListener("click", () => {
		if (coverUrlInput instanceof HTMLInputElement) coverUrlInput.value = "";
		setCoverValue("", "remove");
		setCoverStatus("");
	});

	function refreshFormatFields() {
		const value = formatSelect instanceof HTMLSelectElement ? formatSelect.value : "";
		for (const node of document.querySelectorAll("[data-format-field]")) {
			const formats = String(node.getAttribute("data-format-field") || "").split(/\s+/).filter(Boolean);
			const show = !value || formats.includes(value);
			node.classList.toggle("is-hidden-for-format", !show);
			node.classList.toggle("is-secondary", value === "ebook" && node.getAttribute("data-format-field") === "physical ebook");
		}
		if (formatHelp instanceof HTMLElement) {
			if (!value) formatHelp.textContent = "Choose a format so DogEared can determine which length metadata is relevant.";
			else if (value === "audiobook") formatHelp.textContent = "Audiobooks use duration for progress normalization. Page count is optional unless this Edition also has print metadata.";
			else if (value === "ebook") formatHelp.textContent = "Ebooks use page count when available. Location count can help with Kindle-style progress.";
			else formatHelp.textContent = "Physical books use page count for page and percentage progress.";
		}
	}
	formatSelect?.addEventListener("change", refreshFormatFields);

	function fieldControlValue(field, selector) {
		const container = document.querySelector(`[data-health-field="${CSS.escape(field)}"]`);
		const control = selector ? container?.querySelector(selector) : container?.querySelector("input, select, textarea");
		return control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement
			? String(control.value || "").trim()
			: "";
	}
	function positiveNumber(value) {
		return Number(String(value || "").trim()) > 0;
	}
	function positiveWholeNumber(value) {
		const parsed = Number(String(value || "").trim());
		return Number.isInteger(parsed) && parsed > 0;
	}
	function durationLooksValid(value) {
		const raw = String(value || "").trim();
		return raw !== "" && /\d/.test(raw);
	}
	function hasExternalIdentifier() {
		return ["isbn10", "isbn13", "googleBooksId", "openLibraryWorkId", "openLibraryEditionId"].some((name) => {
			const control = form?.querySelector(`[name="${name}"]`);
			return control instanceof HTMLInputElement && control.value.trim() !== "";
		});
	}
	function isFieldValidNow(field) {
		if (field === "seriesId") return seriesIdInput instanceof HTMLInputElement && Number(seriesIdInput.value || 0) > 0 || seriesCreateNameInput instanceof HTMLInputElement && seriesCreateNameInput.value.trim() !== "";
		if (field === "seriesPosition") return !(seriesIdInput instanceof HTMLInputElement) || Number(seriesIdInput.value || 0) <= 0 || positiveWholeNumber(fieldControlValue(field));
		if (field === "editionFormat") return formatSelect instanceof HTMLSelectElement && formatSelect.value !== "";
		if (field === "pageCount") return formatSelect instanceof HTMLSelectElement && formatSelect.value === "audiobook" ? true : positiveNumber(fieldControlValue(field));
		if (field === "duration") return formatSelect instanceof HTMLSelectElement && formatSelect.value !== "audiobook" ? true : durationLooksValid(fieldControlValue(field));
		if (field === "locationCount") return formatSelect instanceof HTMLSelectElement && formatSelect.value !== "ebook" ? true : positiveNumber(fieldControlValue(field));
		if (field === "coverUrl") return coverUrlInput instanceof HTMLInputElement && coverUrlInput.value.trim() !== "" || workFallbackCover !== "";
		if (field === "preferredCoverUrl") return preferredCoverUrlInput instanceof HTMLInputElement && preferredCoverUrlInput.value.trim() !== "";
		if (field === "externalIdentifiers") return hasExternalIdentifier();
		return fieldControlValue(field) !== "";
	}
	function refreshHealthState() {
		let visibleIssues = 0;
		for (const item of issueNodes) {
			const field = item.getAttribute("data-health-summary-item") || "";
			const corrected = field && isFieldValidNow(field);
			item.toggleAttribute("hidden", corrected);
			if (!corrected) visibleIssues += 1;
			for (const container of document.querySelectorAll(`[data-health-field="${CSS.escape(field)}"]`)) {
				container.classList.toggle("is-corrected", corrected);
			}
		}
		if (countNode) {
			countNode.textContent = visibleIssues > 0
				? `${visibleIssues.toLocaleString()} issue${visibleIssues === 1 ? "" : "s"} require attention`
				: "All visible Data Health issues look corrected. Save to clear them from Data Health.";
		}
		summary?.classList.toggle("is-healthy", visibleIssues === 0);
		summary?.classList.toggle("has-issues", visibleIssues > 0);
	}
	document.addEventListener("input", (event) => {
		if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
			refreshHealthState();
			updateDirtyState();
		}
	});
	document.addEventListener("change", (event) => {
		if (event.target instanceof HTMLSelectElement || event.target instanceof HTMLInputElement) {
			refreshHealthState();
			updateDirtyState();
		}
	});
	publicationDateInput?.addEventListener("change", () => {
		if (!(publicationDateInput instanceof HTMLInputElement)) return;
		if (!(publicationYearInput instanceof HTMLInputElement)) return;
		if (publicationYearInput.value.trim()) return;
		const year = publicationDateInput.value.trim().match(/^\d{4}/)?.[0] || "";
		if (!year) return;
		publicationYearInput.value = year;
		refreshHealthState();
		updateDirtyState();
	});
	function snapshotForm() {
		if (!(form instanceof HTMLFormElement)) return "";
		return Array.from(new FormData(form).entries()).map(([key, value]) => `${key}=${value instanceof File ? `${value.name}:${value.size}` : String(value)}`).join("&");
	}
	function isDirty() {
		return !!initialFormSnapshot && snapshotForm() !== initialFormSnapshot;
	}
	function updateDirtyState() {
		const dirty = isDirty();
		if (saveBar instanceof HTMLElement) saveBar.hidden = !dirty;
		if (saveButton instanceof HTMLButtonElement) saveButton.disabled = !dirty;
	}
	queueMicrotask(() => {
		syncSeriesState();
		refreshFormatFields();
		refreshCoverActionState();
		initialFormSnapshot = snapshotForm();
		updateDirtyState();
	});
	form?.addEventListener("submit", () => {
		isSubmittingCatalogEditor = true;
	});
	discardButton?.addEventListener("click", () => {
		if (!isDirty()) return;
		if (window.confirm("Discard unsaved catalog changes?")) window.location.reload();
	});
	for (const link of document.querySelectorAll("[data-edition-link]")) {
		link.addEventListener("click", (event) => {
			if (!isDirty()) return;
			if (window.confirm("Switch Editions and discard unsaved changes?")) return;
			event.preventDefault();
		});
	}
	for (const button of document.querySelectorAll("[data-edition-delete]")) {
		button.addEventListener("click", (event) => {
			if (button instanceof HTMLButtonElement && button.disabled) return;
			if (window.confirm("Delete this Edition? This cannot be undone.")) return;
			event.preventDefault();
		});
	}
	window.addEventListener("beforeunload", (event) => {
		if (isSubmittingCatalogEditor || !initialFormSnapshot || snapshotForm() === initialFormSnapshot) return;
		event.preventDefault();
		event.returnValue = "";
	});
	for (const link of document.querySelectorAll("[data-health-summary-link]")) {
		link.addEventListener("click", (event) => {
			const targetField = link.getAttribute("data-target-field") || "";
			const target = document.getElementById(`field-${targetField}`);
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: "smooth", block: "center" });
			const focusable = target.querySelector("input, select, textarea, summary");
			if (focusable instanceof HTMLElement) focusable.focus({ preventScroll: true });
			history.replaceState(null, "", `#field-${targetField}`);
		});
	}
	refreshHealthState();
</script>
