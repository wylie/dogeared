---
import Layout from "../../../layouts/Layout.astro";
import { resolveAdminSession } from "../../../lib/admin";
import { getNeonSql } from "../../../lib/neon";
import { formatDate, formatNumber, safeAdminLoad } from "../../../lib/adminFormatting";
import {
	catalogEditorFormatOptions,
	formatDuration,
	isAudiobookFormat,
	isDigitalLocationFormat,
	loadCatalogEditorData,
	loadCatalogMetadataHealth,
	saveCatalogEditorData
} from "../../../lib/adminCatalog";
import type { CatalogHealthIssue } from "../../../lib/adminCatalog";

export const prerender = false;

const admin = await resolveAdminSession(Astro.request);
if (!admin.isAdmin) return Astro.redirect("/");

const sql = getNeonSql();
const workId = Number(Astro.params.workId || 0);
const notices: string[] = [];
const warnings: string[] = [];
let selectedEditionId = Number(Astro.url.searchParams.get("editionId") || 0);
let isAddingEdition = Astro.url.searchParams.get("editionId") === "new";
if (Astro.url.searchParams.get("saved") === "1") notices.push("Catalog changes saved.");
if (Astro.url.searchParams.get("deleted") === "1") notices.push("Edition removed.");

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	selectedEditionId = Number(formData.get("editionId") || 0);
	isAddingEdition = String(formData.get("editionMode") || "") === "add";
	const saveResult = await safeAdminLoad(
		"Catalog editor save",
		() => saveCatalogEditorData(sql, admin.userId, formData),
		{ ok: false, message: "Catalog changes could not be saved." }
	);
	if (saveResult.warning) warnings.push(saveResult.warning);
	if (saveResult.data.ok && saveResult.data.deletedEditionId) return Astro.redirect(`/admin/books/${workId}?deleted=1`);
	if (saveResult.data.ok && saveResult.data.editionId && isAddingEdition) return Astro.redirect(`/admin/books/${workId}?editionId=${encodeURIComponent(String(saveResult.data.editionId))}&saved=1`);
	if (saveResult.data.ok) notices.push(saveResult.data.message);
	else warnings.push(saveResult.data.message);
}

const editorResult = await safeAdminLoad("Catalog editor data", () => loadCatalogEditorData(sql, workId), null);
if (editorResult.warning) warnings.push(editorResult.warning);
const editor = editorResult.data;
if (editor && !selectedEditionId && editor.work.preferredEditionId > 0 && !isAddingEdition) selectedEditionId = editor.work.preferredEditionId;
const selectedEdition = isAddingEdition ? null : editor?.editions.find((edition) => edition.id === selectedEditionId) || editor?.editions[0] || null;
const healthResult = editor
	? await safeAdminLoad("Catalog editor health", () => loadCatalogMetadataHealth(sql, { q: String(editor.work.id), limit: 200 }), { issues: [], records: [], pagination: { limit: 200, offset: 0, total: 0 }, facets: { formats: [], providers: [] }, summary: { totalIssues: 0, totalRecords: 0, critical: 0, needsAttention: 0, optional: 0, missingPageCounts: 0, missingAudiobookDurations: 0, potentialDuplicates: 0, progressBlocking: 0 } })
	: { data: { issues: [], records: [], pagination: { limit: 200, offset: 0, total: 0 }, facets: { formats: [], providers: [] }, summary: { totalIssues: 0, totalRecords: 0, critical: 0, needsAttention: 0, optional: 0, missingPageCounts: 0, missingAudiobookDurations: 0, potentialDuplicates: 0, progressBlocking: 0 } }, warning: "" };
if (healthResult.warning) warnings.push(healthResult.warning);
const workMetadata = editor?.work.metadata || {};
const workProvenance = typeof workMetadata.provenance === "object" && workMetadata.provenance !== null ? workMetadata.provenance as Record<string, unknown> : {};
const editionMetadata = selectedEdition?.metadata || {};
const editionProvenance = typeof editionMetadata.provenance === "object" && editionMetadata.provenance !== null ? editionMetadata.provenance as Record<string, unknown> : {};
const issueHref = `/admin/data-health?catalog_q=${encodeURIComponent(String(workId))}#catalog-metadata`;
const sectionLinks = [
	{ id: "catalog-editor", label: "Editor" },
	{ id: "impact-preview", label: "Impact" },
	{ id: "audit-history", label: "Audit History" }
];
const allEditorIssues = editor
	? healthResult.data.issues.filter((issue) => issue.workId === editor.work.id)
	: [];
const editorIssues = isAddingEdition
	? allEditorIssues.filter((issue) => issue.editionId === 0)
	: allEditorIssues.filter((issue) => !selectedEdition || issue.editionId === 0 || issue.editionId === selectedEdition.id || issue.bookId === selectedEdition.bookId);

type FieldHealth = {
	field: string;
	label: string;
	helper: string;
	uses: string[];
	issue: CatalogHealthIssue;
};

function issueLabel(value: string) {
	return String(value || "")
		.replace(/[_-]+/g, " ")
		.replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function severityLabel(value: string) {
	if (value === "critical") return "Critical";
	if (value === "needs_attention") return "Needs attention";
	return "Optional";
}

function issueToField(issue: CatalogHealthIssue): FieldHealth {
	const isAudioProgress = issue.issueType === "progress_not_normalizable" && /audio/i.test(issue.issue);
	const field = isAudioProgress ? "duration" : ({
		missing_audiobook_duration: "duration",
		missing_page_count: "pageCount",
		missing_location_count: "locationCount",
		missing_chapter_count: "chapterCount",
		missing_cover: "coverUrl",
		missing_author: "primaryAuthor",
		missing_publication_year: issue.editionId > 0 ? "publicationYear" : "originalPublicationYear",
		missing_publisher: "publisher",
		missing_identifiers: "externalIdentifiers",
		missing_series_position: "seriesPosition",
		missing_series_relationship: "seriesId",
		malformed_title: "workTitle",
		missing_description: "description",
		missing_reading_format_metadata: "editionFormat",
		progress_not_normalizable: "pageCount"
	} as Record<string, string>)[issue.issueType] || "catalogEditor";
	const details: Record<string, { label: string; helper: string; uses: string[] }> = {
		duration: {
			label: "Duration needed",
			helper: "Required for audiobook and percentage progress.",
			uses: ["Percentage tracking", "Reading Activity", "Daily Reading Volume"]
		},
		pageCount: {
			label: "Page count needed",
			helper: "Required for page and percentage progress.",
			uses: ["Percentage tracking", "Reading statistics", "Reading Activity"]
		},
		locationCount: {
			label: "Location count",
			helper: "Location-based Editions are easier to normalize when the total location count is known.",
			uses: ["Location tracking", "Reading Activity", "Daily Reading Volume"]
		},
		chapterCount: {
			label: "Chapter count",
			helper: "Chapter metadata helps keep chapter progress meaningful across Editions.",
			uses: ["Chapter tracking", "Progress labels", "Reading Activity"]
		},
		seriesPosition: {
			label: "Series position needed",
			helper: "Required for reading order in the selected Series.",
			uses: ["Series pages", "Reading order", "Previous/Next navigation"]
		},
		seriesId: {
			label: "Series needs review",
			helper: "The title suggests this book belongs to a Series.",
			uses: ["Series pages", "Search dedupe", "Author pages"]
		},
		primaryAuthor: {
			label: "Primary author",
			helper: "Author metadata is part of canonical Work identity and duplicate prevention.",
			uses: ["Search dedupe", "Author pages", "BookCards"]
		},
		workTitle: {
			label: "Title needs review",
			helper: "Remove redundant Series or format text once the structured fields are set.",
			uses: ["Search dedupe", "BookCards", "Series grouping"]
		},
		description: {
			label: "Description missing",
			helper: "Add a concise book description for reader-facing detail pages.",
			uses: ["Book detail", "Search context", "Catalog QA"]
		},
		editionFormat: {
			label: "Format missing",
			helper: "Choose a format so DogEared can determine which length metadata is relevant.",
			uses: ["Data Health", "Progress metadata", "Edition display"]
		},
		publisher: {
			label: "Publisher",
			helper: "Publisher helps administrators distinguish Editions and provider matches.",
			uses: ["Edition display", "Provider review", "Catalog QA"]
		},
		publicationYear: {
			label: "Publication year",
			helper: "Publication information helps distinguish similar Editions.",
			uses: ["Edition display", "Search filters", "Catalog QA"]
		},
		originalPublicationYear: {
			label: "Original publication year",
			helper: "Original publication year helps describe the canonical Work.",
			uses: ["Book detail", "Search context", "Catalog QA"]
		},
		preferredCoverUrl: {
			label: "Preferred cover",
			helper: "A preferred Work cover keeps cards recognizable when Editions disagree.",
			uses: ["BookCards", "Search results", "Series pages"]
		},
		coverUrl: {
			label: "Edition cover",
			helper: "Edition covers help distinguish formats and provider records.",
			uses: ["Edition display", "Book detail", "Search results"]
		},
		externalIdentifiers: {
			label: "External identifiers",
			helper: "Identifiers help DogEared avoid duplicate Works and Editions during search/import.",
			uses: ["Search dedupe", "Provider matching", "Import cleanup"]
		},
		catalogEditor: {
			label: issue.issue,
			helper: "Review this issue in Data Health before changing canonical catalog identity.",
			uses: ["Data Health", "Duplicate prevention", "Catalog integrity"]
		}
	};
	const detail = details[field] || details.catalogEditor;
	return { field, issue, ...detail };
}

const fieldHealthItems = editorIssues.map(issueToField);
const fieldHealthByField = fieldHealthItems.reduce((map, item) => {
	if (!map.has(item.field)) map.set(item.field, item);
	const existing = map.get(item.field);
	if (existing && existing.issue.severity !== "critical" && item.issue.severity === "critical") map.set(item.field, item);
	return map;
}, new Map<string, FieldHealth>());

function fieldHealth(field: string) {
	return fieldHealthByField.get(field) || null;
}

function fieldClass(field: string, extra = "") {
	const health = fieldHealth(field);
	return ["field-control", health ? `has-health-issue ${health.issue.severity}` : "", extra].filter(Boolean).join(" ");
}

function issueTarget(issue: CatalogHealthIssue) {
	return issueToField(issue).field;
}

function normalizedEditorFormat(value: unknown) {
	const raw = String(value || "").trim().toLowerCase();
	if (isAudiobookFormat(raw)) return "audiobook";
	if (isDigitalLocationFormat(raw)) return "ebook";
	if (["physical", "hardcover", "paperback", "library binding"].includes(raw)) return "physical";
	return "";
}

const selectedFormatValue = normalizedEditorFormat(selectedEdition?.format);
const editingEditionFields = isAddingEdition || !!selectedEdition;
const preferredEditionId = editor?.work.preferredEditionId && editor.editions.some((edition) => edition.id === editor.work.preferredEditionId)
	? editor.work.preferredEditionId
	: editor?.editions[0]?.id || 0;
const languageOptions = [
	{ value: "en", label: "English" },
	{ value: "es", label: "Spanish" },
	{ value: "fr", label: "French" },
	{ value: "de", label: "German" },
	{ value: "it", label: "Italian" },
	{ value: "ja", label: "Japanese" },
	{ value: "ko", label: "Korean" },
	{ value: "pt", label: "Portuguese" },
	{ value: "zh", label: "Chinese" }
];
const selectedLanguageValue = String(selectedEdition?.language || "").trim().toLowerCase();
const hasKnownLanguage = languageOptions.some((language) => language.value === selectedLanguageValue);
function coverProviderLabel(source: unknown, url: unknown) {
	const normalizedSource = String(source || "").trim();
	if (/admin upload/i.test(normalizedSource)) return "Admin upload";
	if (/admin url/i.test(normalizedSource)) return "Admin URL";
	if (/google/i.test(normalizedSource)) return "Google Books";
	if (/open library/i.test(normalizedSource)) return "Open Library";
	const normalizedUrl = String(url || "").trim();
	if (/books\.google|googleusercontent/i.test(normalizedUrl)) return "Google Books";
	if (/openlibrary|covers\.openlibrary/i.test(normalizedUrl)) return "Open Library";
	return normalizedSource && !/existing dogeared data/i.test(normalizedSource) ? normalizedSource : "Existing DogEared data";
}
const displayCoverUrl = selectedEdition?.coverUrl || editor?.work.preferredCoverUrl || "";
const displayCoverSource = selectedEdition?.coverUrl
	? `Edition cover · ${coverProviderLabel(editionProvenance.source, selectedEdition.coverUrl)}`
	: editor?.work.preferredCoverUrl
		? `Work fallback cover · ${coverProviderLabel(workProvenance.source, editor.work.preferredCoverUrl)}`
		: "No cover selected";
const selectedEditionHasCover = !!selectedEdition?.coverUrl;
const coverLayerNote = selectedEdition?.coverUrl
	? "This image is stored on the selected Edition."
	: editor?.work.preferredCoverUrl
		? "This image is the Work fallback. Uploading here creates an Edition cover for the selected Edition."
		: "No Edition cover is set. Uploading here creates an Edition cover for the selected Edition.";
const editionTitleIsUseful = !!selectedEdition?.title && selectedEdition.title.trim() !== editor?.work.title.trim();
---

<Layout title={editor ? `Edit ${editor.work.title}` : "Catalog Editor"} sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="admin-catalog-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/admin">Admin</a><span aria-hidden="true">/</span><a href="/admin/data-health">Data Health</a><span aria-hidden="true">/</span><span>Catalog Editor</span>
		</nav>

		<header class="hero">
			<div>
				<h1>{editor ? editor.work.title : "Catalog Editor"}</h1>
				<p>Admin-only Work and Edition metadata repair. Reader shelves, progress, journal entries, ratings, and finish dates are preserved.</p>
			</div>
			<div class="hero-actions">
				<a href={issueHref}>View health issues</a>
				{editor?.work.bookId ? <a href={`/book?bookId=${encodeURIComponent(String(editor.work.bookId))}`}>View book detail</a> : null}
			</div>
		</header>

		{warnings.length > 0 && (
			<div class="warning-list" role="alert">
				{warnings.map((warning) => <p>{warning}</p>)}
			</div>
		)}

		{notices.length > 0 && (
			<div class="notice-list" role="status">
				{notices.map((notice) => <p>{notice}</p>)}
			</div>
		)}

		{!editor ? (
			<section class="panel">
				<h2>Work Not Found</h2>
				<p>No catalog Work matched this admin editor URL.</p>
			</section>
		) : (
			<>
				<section id="field-catalogEditor" class={`health-summary ${editorIssues.length > 0 ? "has-issues" : "is-healthy"}`} aria-labelledby="catalog-health-summary-heading" data-health-summary tabindex="-1">
					<div class="health-summary-head">
						<span class="material-icons" aria-hidden="true">{editorIssues.length > 0 ? "warning" : "check_circle"}</span>
						<div>
							<h2 id="catalog-health-summary-heading">Data Health Summary</h2>
							<p data-health-summary-count>
								{editorIssues.length > 0
									? `${editorIssues.length.toLocaleString()} issue${editorIssues.length === 1 ? "" : "s"} require attention`
									: "No Data Health issues detected for this Work and selected Edition"}
							</p>
						</div>
					</div>
					{editorIssues.length > 0 && (
						<ul class="health-summary-list">
							{editorIssues.map((issue) => (
								<li data-health-summary-item={issueTarget(issue)}>
									<a href={`#field-${issueTarget(issue)}`} data-health-summary-link data-target-field={issueTarget(issue)}>
										<span class={`severity-dot ${issue.severity}`} aria-hidden="true"></span>
										<span class="sr-only">{severityLabel(issue.severity)}: </span>
										{issue.issue}
									</a>
								</li>
							))}
						</ul>
					)}
				</section>

				<form
					id="catalog-editor"
					class="catalog-editor-form"
					method="post"
					data-selected-edition-id={String(selectedEdition?.id || 0)}
					data-work-fallback-cover={editor.work.preferredCoverUrl}
				>
					<input type="hidden" name="workId" value={String(editor.work.id)} />
					<input type="hidden" name="editionId" value={String(selectedEdition?.id || 0)} />
					<input type="hidden" name="editionMode" value={isAddingEdition ? "add" : "edit"} />
					<input type="hidden" name="coverUrl" value={selectedEdition?.coverUrl || ""} data-cover-url />
					<input type="hidden" name="coverSource" value="" data-cover-source />

					<section class="panel">
						<div class="panel-head">
							<h2>Book Catalog Editor</h2>
							<p>Repair the book as an administrator sees it. DogEared saves shared book identity, Series data, and publication-specific Edition details to the right records underneath.</p>
						</div>
						<fieldset class="field-group editions-manager">
							<legend>Editions</legend>
							<p class="subsection-note">Choose the publication or format you are editing. Book and Series fields stay shared across every Edition.</p>
							<div class="edition-tabs" role="list" aria-label="Editions">
								{editor.editions.map((edition) => (
									<div class={`edition-tab ${edition.id === selectedEdition?.id ? "is-active" : ""}`} role="listitem">
										<a href={`/admin/books/${editor.work.id}?editionId=${encodeURIComponent(String(edition.id))}`} data-edition-link>
											<strong>{edition.format || "Choose format"}</strong>
											<span>{edition.publisher || edition.title || `Edition #${edition.id}`}</span>
											{edition.id === preferredEditionId ? <em>Preferred Edition</em> : null}
										</a>
										<label class="preferred-edition-radio">
											<input type="radio" name="preferredEditionId" value={String(edition.id)} checked={edition.id === preferredEditionId} />
											<span>Preferred</span>
										</label>
									</div>
								))}
								<a class={`edition-tab add-edition ${isAddingEdition ? "is-active" : ""}`} href={`/admin/books/${editor.work.id}?editionId=new`} data-edition-link role="listitem">
									<strong>+ Add Edition</strong>
									<span>Attach another format to this Work</span>
								</a>
							</div>
							{selectedEdition ? (
								<div class="edition-admin-actions">
									<p>Editing Edition #{selectedEdition.id}{selectedEdition.bookId ? ` · Book ${selectedEdition.bookId}` : ""}</p>
									<button
										type="submit"
										class="danger-button"
										name="editionIntent"
										value="delete"
										formnovalidate
										data-edition-delete
										disabled={editor.editions.length <= 1 || selectedEdition.referenceCount > 0}
									>
										Delete Edition
									</button>
									{selectedEdition.referenceCount > 0 ? <span class="inline-note">Referenced by reader history</span> : null}
								</div>
							) : (
								<p class="edition-current">Adding a new Edition to this Work.</p>
							)}
						</fieldset>
						<fieldset class="field-group">
							<legend>Book</legend>
							<div class="field-grid two">
								<label id="field-workTitle" class={fieldClass("workTitle")} data-health-field="workTitle">
									<span class="field-label">Title {fieldHealth("workTitle") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="workTitle" value={editor.work.title} required maxlength="500" placeholder="The Last Graduate" aria-describedby={fieldHealth("workTitle") ? "help-workTitle why-workTitle" : "why-workTitle"} />
									{fieldHealth("workTitle") && <p id="help-workTitle" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("workTitle")!.issue.severity)}: </span>{fieldHealth("workTitle")!.helper}</p>}
									<p id="why-workTitle" class="why-note">Shared book title, without Series numbering when possible.</p>
								</label>
								<label id="field-primaryAuthor" class={fieldClass("primaryAuthor")} data-health-field="primaryAuthor">
									<span class="field-label">Primary author {fieldHealth("primaryAuthor") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="primaryAuthor" value={editor.work.primaryAuthor} maxlength="300" placeholder="Naomi Novik" aria-describedby={fieldHealth("primaryAuthor") ? "help-primaryAuthor why-primaryAuthor" : "why-primaryAuthor"} />
									{fieldHealth("primaryAuthor") && <p id="help-primaryAuthor" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("primaryAuthor")!.issue.severity)}: </span>{fieldHealth("primaryAuthor")!.helper}</p>}
									<p id="why-primaryAuthor" class="why-note">Main credited author shown on reader-facing pages.</p>
								</label>
								<label id="field-originalPublicationYear" class={fieldClass("originalPublicationYear")} data-health-field="originalPublicationYear">
									<span class="field-label">Original publication year {fieldHealth("originalPublicationYear") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="originalPublicationYear" type="number" min="1400" max="2100" step="1" inputmode="numeric" value={editor.work.originalPublicationYear > 0 ? String(editor.work.originalPublicationYear) : ""} placeholder="2021" aria-describedby={fieldHealth("originalPublicationYear") ? "help-originalPublicationYear why-originalPublicationYear" : "why-originalPublicationYear"} />
									{fieldHealth("originalPublicationYear") && <p id="help-originalPublicationYear" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("originalPublicationYear")!.issue.severity)}: </span>{fieldHealth("originalPublicationYear")!.helper}</p>}
									<p id="why-originalPublicationYear" class="why-note">Year the book was first published, regardless of this Edition.</p>
								</label>
								<label id="field-description" class={fieldClass("description", "span-two")} data-health-field="description">
									<span class="field-label">Description {fieldHealth("description") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<textarea name="description" rows="5" placeholder="A concise reader-facing description." aria-describedby={fieldHealth("description") ? "help-description why-description" : "why-description"}>{editor.work.description}</textarea>
									{fieldHealth("description") && <p id="help-description" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("description")!.issue.severity)}: </span>{fieldHealth("description")!.helper}</p>}
									<p id="why-description" class="why-note">Reader-facing synopsis for the shared book.</p>
								</label>
								<label class="span-two">
									<span>Subjects</span>
									<textarea name="subjects" rows="2" placeholder="Magic schools, coming of age">{editor.work.subjects.join(", ")}</textarea>
									<p class="why-note">Comma-separated topics or provider subjects.</p>
								</label>
								<label class="span-two">
									<span>Genres</span>
									<textarea name="genres" rows="2" placeholder="Fantasy, Young Adult">{editor.work.genres.join(", ")}</textarea>
									<p class="why-note">Reader-facing genre labels. Keep these broad and recognizable.</p>
								</label>
							</div>
						</fieldset>
						<fieldset class="field-group">
							<legend>Series</legend>
							<div class="series-editor">
								<div id="field-seriesId" class={fieldClass("seriesId", "series-combobox")} data-health-field="seriesId" data-series-editor>
									<span class="field-label">Series {fieldHealth("seriesId") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input type="hidden" name="seriesId" value={String(editor.work.seriesId || 0)} data-series-id />
									<input type="hidden" name="seriesCreateName" value="" data-series-create-name />
									<div class="series-option-data" hidden>
										{editor.seriesOptions.map((series) => (
											<span data-series-option data-id={String(series.id)}>{series.name}</span>
										))}
									</div>
									<div class="series-control-shell">
										<input name="seriesSearch" value={editor.work.seriesName} placeholder="Search existing Series..." autocomplete="off" aria-describedby={fieldHealth("seriesId") ? "help-seriesId why-seriesId" : "why-seriesId"} aria-controls="series-results" data-series-search readonly={editor.work.seriesId > 0} />
										<button type="button" class="series-clear-button" data-series-clear aria-label="Remove Series" hidden={editor.work.seriesId <= 0}>
											<span aria-hidden="true">×</span>
										</button>
										<div id="series-results" class="series-results" data-series-results role="listbox" hidden></div>
									</div>
									{fieldHealth("seriesId") && <p id="help-seriesId" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("seriesId")!.issue.severity)}: </span>{fieldHealth("seriesId")!.helper}</p>}
									<p id="why-seriesId" class="why-note">Search for an existing Series or create a new one.</p>
								</div>
								<label id="field-seriesPosition" class={fieldClass("seriesPosition", "series-position-field")} data-health-field="seriesPosition">
									<span class="field-label">Series position {fieldHealth("seriesPosition") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="seriesPosition" type="number" min="1" step="1" inputmode="numeric" value={editor.work.seriesPosition} placeholder="2" aria-describedby={fieldHealth("seriesPosition") ? "help-seriesPosition why-seriesPosition" : "why-seriesPosition"} data-series-position disabled={editor.work.seriesId <= 0} />
									{fieldHealth("seriesPosition") && <p id="help-seriesPosition" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("seriesPosition")!.issue.severity)}: </span>{fieldHealth("seriesPosition")!.helper}</p>}
									<p id="why-seriesPosition" class="why-note">Enter the book's number in the Series, e.g. 2. DogEared derives totals like Book 2 of 3.</p>
								</label>
							</div>
						</fieldset>
						<fieldset class="field-group">
							<legend>Edition & Format</legend>
							<p class="subsection-note">Publication-specific information such as format, publisher, length, and identifiers.</p>
							{!editingEditionFields ? (
								<p>No Edition is selected. Add an Edition to enter publication-specific metadata.</p>
							) : (
								<>
									<p class="edition-current">{isAddingEdition ? "New Edition" : `Editing Edition #${selectedEdition?.id}${selectedEdition?.bookId ? ` · Book ${selectedEdition.bookId}` : ""}`}</p>
									<div class="field-grid two">
										<label id="field-editionFormat" class={fieldClass("editionFormat")} data-health-field="editionFormat">
											<span class="field-label">Format {fieldHealth("editionFormat") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
											<select name="editionFormat" aria-describedby={fieldHealth("editionFormat") ? "help-editionFormat why-editionFormat" : "why-editionFormat"} data-format-select>
												<option value="" selected={!selectedFormatValue}>Choose reading format...</option>
												{catalogEditorFormatOptions().map((format) => (
													<option value={format.value} selected={format.value === selectedFormatValue}>{format.label}</option>
												))}
											</select>
											{fieldHealth("editionFormat") && <p id="help-editionFormat" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("editionFormat")!.issue.severity)}: </span>{fieldHealth("editionFormat")!.helper}</p>}
											<p id="why-editionFormat" class="why-note">Format of the Edition you are currently editing.</p>
										</label>
										<label id="field-publisher" class={fieldClass("publisher")} data-health-field="publisher">
											<span class="field-label">Publisher {fieldHealth("publisher") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
											<input name="publisher" value={selectedEdition?.publisher || ""} maxlength="300" placeholder="Random House" aria-describedby={fieldHealth("publisher") ? "help-publisher why-publisher" : "why-publisher"} />
											{fieldHealth("publisher") && <p id="help-publisher" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("publisher")!.issue.severity)}: </span>{fieldHealth("publisher")!.helper}</p>}
											<p id="why-publisher" class="why-note">Publisher of this specific Edition.</p>
										</label>
										<label class="field-control">
											<span class="field-label">Publication date</span>
											<input name="publicationDate" value={selectedEdition?.publicationDate || ""} maxlength="80" placeholder="2021-09-28" aria-describedby="why-publicationDate" data-publication-date />
											<p id="why-publicationDate" class="why-note">Publication date of this specific Edition. Use YYYY-MM-DD when known.</p>
										</label>
										<label id="field-publicationYear" class={fieldClass("publicationYear")} data-health-field="publicationYear">
											<span class="field-label">Publication year {fieldHealth("publicationYear") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
											<input name="publicationYear" type="number" min="1400" max="2100" step="1" inputmode="numeric" value={selectedEdition && selectedEdition.publicationYear > 0 ? String(selectedEdition.publicationYear) : ""} placeholder="2021" aria-describedby={fieldHealth("publicationYear") ? "help-publicationYear why-publicationYear" : "why-publicationYear"} data-publication-year />
											{fieldHealth("publicationYear") && <p id="help-publicationYear" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("publicationYear")!.issue.severity)}: </span>{fieldHealth("publicationYear")!.helper}</p>}
											<p id="why-publicationYear" class="why-note">Edition year. DogEared can fill this from Publication date when the year is clear.</p>
										</label>
										<label class="field-control">
											<span class="field-label">Language</span>
											<select name="language" aria-describedby="why-language">
												<option value="" selected={!selectedLanguageValue}>Choose language...</option>
												{!hasKnownLanguage && selectedLanguageValue ? <option value={selectedLanguageValue} selected>{selectedEdition?.language}</option> : null}
												{languageOptions.map((language) => (
													<option value={language.value} selected={language.value === selectedLanguageValue}>{language.label}</option>
												))}
											</select>
											<p id="why-language" class="why-note">Language for this Edition. DogEared stores the standard code underneath.</p>
										</label>
									</div>
									<details class="advanced-field" open={editionTitleIsUseful}>
										<summary>Edition title</summary>
										<label>
											<span>Edition title or subtitle</span>
											<input name="editionTitle" value={selectedEdition?.title || ""} maxlength="500" placeholder="Special illustrated edition" />
											<p class="why-note">Use only when this Edition has a distinct title or subtitle.</p>
										</label>
									</details>
								</>
							)}
						</fieldset>
						<fieldset class="field-group" data-progress-metadata>
							<legend>Progress Metadata</legend>
							<p class="subsection-note" data-format-help>Choose a format so DogEared can determine which length metadata is relevant.</p>
							<div class="field-grid two">
								<label id="field-pageCount" class={fieldClass("pageCount")} data-health-field="pageCount" data-format-field="physical ebook">
									<span class="field-label">Page count {fieldHealth("pageCount") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="pageCount" type="number" min="1" step="1" inputmode="numeric" value={selectedEdition && selectedEdition.pageCount > 0 ? String(selectedEdition.pageCount) : ""} placeholder="400" aria-describedby={fieldHealth("pageCount") ? "help-pageCount why-pageCount" : "why-pageCount"} />
									{fieldHealth("pageCount") && <p id="help-pageCount" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("pageCount")!.issue.severity)}: </span>{fieldHealth("pageCount")!.helper}</p>}
									<p id="why-pageCount" class="why-note">Total number of pages in this Edition.</p>
								</label>
								<label id="field-duration" class={fieldClass("duration")} data-health-field="duration" data-format-field="audiobook">
									<span class="field-label">Audiobook duration {fieldHealth("duration") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="duration" value={formatDuration(selectedEdition?.durationSeconds || 0)} placeholder="13 hr 24 min" aria-describedby={fieldHealth("duration") ? "help-duration why-duration" : "why-duration"} />
									{fieldHealth("duration") && <p id="help-duration" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("duration")!.issue.severity)}: </span>{fieldHealth("duration")!.helper}</p>}
									<p id="why-duration" class="why-note">Total running time of this audiobook Edition.</p>
								</label>
										<label id="field-locationCount" class={fieldClass("locationCount")} data-health-field="locationCount" data-format-field="ebook">
											<span class="field-label">Total ebook locations {fieldHealth("locationCount") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
											<input name="locationCount" type="number" min="1" step="1" inputmode="numeric" value={selectedEdition && selectedEdition.locationCount > 0 ? String(selectedEdition.locationCount) : ""} placeholder="5120" aria-describedby={fieldHealth("locationCount") ? "help-locationCount why-locationCount" : "why-locationCount"} />
											{fieldHealth("locationCount") && <p id="help-locationCount" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("locationCount")!.issue.severity)}: </span>{fieldHealth("locationCount")!.helper}</p>}
											<p id="why-locationCount" class="why-note">Total location count used by this ebook Edition, when available.</p>
										</label>
										<label id="field-chapterCount" class={fieldClass("chapterCount")} data-health-field="chapterCount">
											<span class="field-label">Chapter count {fieldHealth("chapterCount") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
											<input name="chapterCount" type="number" min="1" step="1" inputmode="numeric" value={selectedEdition && selectedEdition.chapterCount > 0 ? String(selectedEdition.chapterCount) : ""} placeholder="32" aria-describedby={fieldHealth("chapterCount") ? "help-chapterCount why-chapterCount" : "why-chapterCount"} />
											{fieldHealth("chapterCount") && <p id="help-chapterCount" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("chapterCount")!.issue.severity)}: </span>{fieldHealth("chapterCount")!.helper}</p>}
											<p id="why-chapterCount" class="why-note">Total number of chapters in this Edition, when known.</p>
										</label>
							</div>
						</fieldset>
						<fieldset class="field-group">
							<legend>Cover</legend>
							<div id="field-coverUrl" class={fieldClass("coverUrl", "cover-editor")} data-health-field="coverUrl">
								<div class="cover-preview">
									{displayCoverUrl ? <img src={displayCoverUrl} alt={`Cover for ${editor.work.title}`} loading="lazy" decoding="async" data-cover-preview /> : <span class="cover-placeholder" aria-hidden="true" data-cover-placeholder><span class="material-icons">menu_book</span></span>}
								</div>
								<div class="cover-editor-main">
									<div class="cover-editor-head">
										<strong>Current cover</strong>
										<span data-cover-provenance>Source: {displayCoverSource}</span>
										<p data-cover-layer-note>{coverLayerNote}</p>
									</div>
									{(fieldHealth("coverUrl") || fieldHealth("preferredCoverUrl")) && <p id="help-coverUrl" class="field-warning"><span class="sr-only">{severityLabel((fieldHealth("coverUrl") || fieldHealth("preferredCoverUrl"))!.issue.severity)}: </span>{(fieldHealth("coverUrl") || fieldHealth("preferredCoverUrl"))!.helper}</p>}
									<div class="cover-actions">
										<button type="button" class="secondary-button" data-cover-upload-trigger>Upload new cover</button>
										<input type="file" accept="image/jpeg,image/png,image/webp" data-cover-file />
										<button type="button" class="secondary-button" data-cover-remove hidden={!selectedEditionHasCover}>Remove Edition cover</button>
									</div>
									<p class="cover-upload-status" data-cover-upload-status aria-live="polite" hidden></p>
									<details class="advanced-field">
										<summary>Use image URL instead</summary>
										<label>
											<span>Edition cover URL</span>
											<input value={selectedEdition?.coverUrl || ""} maxlength="2000" placeholder="https://..." data-cover-url-input />
											<p class="why-note">Creates or replaces the selected Edition's cover.</p>
										</label>
									</details>
								</div>
							</div>
						</fieldset>
						<details id="field-externalIdentifiers" class={fieldClass("externalIdentifiers", "advanced-metadata")} data-health-field="externalIdentifiers">
							<summary>Advanced metadata {fieldHealth("externalIdentifiers") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</summary>
							{fieldHealth("externalIdentifiers") && <p id="help-externalIdentifiers" class="field-warning"><span class="sr-only">{severityLabel(fieldHealth("externalIdentifiers")!.issue.severity)}: </span>{fieldHealth("externalIdentifiers")!.helper}</p>}
							<div class="field-grid two">
								<label>
									<span>Canonical title</span>
									<input name="canonicalTitle" value={editor.work.canonicalTitle} maxlength="500" placeholder="The Last Graduate" />
									<p class="why-note">Advanced title used for matching when provider titles disagree.</p>
								</label>
								<label id="field-preferredCoverUrl" class={fieldClass("preferredCoverUrl")} data-health-field="preferredCoverUrl">
									<span class="field-label">Work fallback cover URL {fieldHealth("preferredCoverUrl") && <span class="material-icons warning-icon" aria-hidden="true">warning</span>}</span>
									<input name="preferredCoverUrl" value={editor.work.preferredCoverUrl} maxlength="2000" placeholder="https://..." data-preferred-cover-url />
									<p class="why-note">Fallback used when the selected Edition has no cover.</p>
								</label>
								<label>
									<span>ISBN-10</span>
									<input name="isbn10" value={selectedEdition?.isbn10 || ""} maxlength="40" placeholder="0593321203" />
									<p class="why-note">10-digit identifier for this Edition.</p>
								</label>
								<label>
									<span>ISBN-13</span>
									<input name="isbn13" value={selectedEdition?.isbn13 || ""} maxlength="40" placeholder="9780593321201" />
									<p class="why-note">13-digit identifier for this Edition.</p>
								</label>
								<label>
									<span>Google Books ID</span>
									<input name="googleBooksId" value={selectedEdition?.googleBooksId || ""} maxlength="200" placeholder="abc123" />
									<p class="why-note">Google Books identifier for this Edition.</p>
								</label>
								<label>
									<span>Open Library Work ID</span>
									<input name="openLibraryWorkId" value={selectedEdition?.openLibraryWorkId || ""} maxlength="200" placeholder="OL12345W" />
									<p class="why-note">Open Library identifier for the shared book.</p>
								</label>
								<label>
									<span>Open Library Edition ID</span>
									<input name="openLibraryEditionId" value={selectedEdition?.openLibraryEditionId || ""} maxlength="200" placeholder="OL12345M" />
									<p class="why-note">Open Library identifier for this specific Edition.</p>
								</label>
							</div>
						</details>
						<p class="note">Source: {String(editionProvenance.source || workProvenance.source || "Existing DogEared data")} · Manually reviewed fields are protected from automated refreshes · Updated {formatDate(selectedEdition?.updatedAt || editor.work.updatedAt)}</p>
					</section>

					<section id="impact-preview" class="panel">
						<div class="panel-head">
							<h2>Impact Preview</h2>
							<p>These reader-owned records are preserved. The editor updates catalog metadata only.</p>
						</div>
						<div class="grid five">
							<article class="stat"><p>Readers</p><strong>{formatNumber(editor.impact.readers)}</strong></article>
							<article class="stat"><p>Shelf entries</p><strong>{formatNumber(editor.impact.shelfEntries)}</strong></article>
							<article class="stat"><p>Progress events</p><strong>{formatNumber(editor.impact.progressEvents)}</strong></article>
							<article class="stat"><p>Journal entries</p><strong>{formatNumber(editor.impact.journalEntries)}</strong></article>
							<article class="stat"><p>Editions</p><strong>{formatNumber(editor.impact.editionCount)}</strong></article>
						</div>
					</section>
					<div class="catalog-save-bar" data-save-bar hidden>
						<p data-save-status>Unsaved changes</p>
						<div class="save-actions">
							<button type="button" class="secondary-button" data-discard-changes>Discard changes</button>
							<button type="submit" data-save-button disabled>Save catalog data</button>
						</div>
					</div>
				</form>

				<section id="audit-history" class="panel">
					<div class="panel-head">
						<h2>Audit History</h2>
						<p>Manual catalog changes are tracked without storing reader content.</p>
					</div>
					<div class="table-wrap">
						<table>
							<thead>
								<tr><th>Time</th><th>Admin</th><th>Entity</th><th>Fields</th></tr>
							</thead>
							<tbody>
								{editor.auditEvents.length === 0 ? (
									<tr><td colspan="4">No manual catalog edits recorded for this Work.</td></tr>
								) : editor.auditEvents.map((event) => (
									<tr>
										<td>{formatDate(event.createdAt)}</td>
										<td>{event.adminUsername}</td>
										<td>{event.entityType} #{event.entityId}</td>
										<td>{event.changedFields.map((change) => change.field).join(", ") || "Catalog update"}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			</>
		)}
	</div>
</Layout>

<style>
	.admin-catalog-page { max-width: 980px; min-width: 0; }
	.breadcrumbs { display: flex; flex-wrap: wrap; gap: 0.35rem; color: var(--color-text-muted); font-size: 0.86rem; }
	.breadcrumbs a { color: var(--color-nav); font-weight: 700; text-decoration: none; }
	.hero { margin-top: 0.85rem; display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
	.hero h1 { margin: 0; }
	.hero p { margin: 0.35rem 0 0; color: var(--color-text-muted); }
	.hero-actions, .actions { display: flex; flex-wrap: wrap; gap: 0.55rem; }
	.hero-actions a, .actions a {
		color: var(--color-nav);
		font-weight: 700;
		text-decoration: none;
	}
