---
import Layout from "../../layouts/Layout.astro";
import { resolveAdminSession } from "../../lib/admin";
import { getNeonSql } from "../../lib/neon";
import { loadAdminBetaUsers } from "../../lib/adminData";

export const prerender = false;

const admin = await resolveAdminSession(Astro.request);
if (!admin.isAdmin) return Astro.redirect("/");

const query = String(Astro.url.searchParams.get("q") || "").trim();
const sql = getNeonSql();
const users = await loadAdminBetaUsers(sql, query);

const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "beta-user-search", label: "Search" },
	{ id: "beta-user-list", label: "Beta Users" }
];

function formatDate(value: string) {
	const parsed = new Date(value);
	if (!Number.isFinite(parsed.getTime())) return "Unknown";
	return parsed.toLocaleString();
}
---

<Layout title="Admin Beta Users" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="admin-beta-users-page">
		<header id="overview" class="hero">
			<h1>Beta Users</h1>
			<p>Monitor reader onboarding, activity, and account readiness during beta.</p>
		</header>

		<section class="panel" id="beta-user-search">
			<div class="panel-head">
				<h2>Search</h2>
			</div>
			<form class="search-form" method="get" action="/admin/beta-users">
				<label for="beta-user-search-input">Name, username, or email</label>
				<div class="search-row">
					<input id="beta-user-search-input" name="q" type="search" value={query} placeholder="reader@example.com" />
					<button type="submit">Search</button>
					{query && <a class="secondary-link" href="/admin/beta-users">Clear</a>}
				</div>
			</form>
		</section>

		<section class="panel" id="beta-user-list">
			<div class="panel-head">
				<h2>Users</h2>
				<p>{users.length.toLocaleString()} {users.length === 1 ? "reader" : "readers"} shown.</p>
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Reader</th>
							<th>Email</th>
							<th>Joined</th>
							<th>Last active</th>
							<th>Books</th>
							<th>Reviews</th>
							<th>Journal</th>
							<th>Streak</th>
							<th>Status</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{users.length === 0 ? (
							<tr><td colspan="10">No beta users matched that search.</td></tr>
						) : users.map((user) => (
							<tr>
								<td>
									<strong>{user.displayName || user.username || "Unnamed reader"}</strong>
									{user.username ? <a class="table-link" href={`/admin/users/${encodeURIComponent(user.username)}`}>@{user.username}</a> : <span class="muted">No username</span>}
								</td>
								<td>{user.email || "Unknown"}</td>
								<td>{formatDate(user.joinedAt)}</td>
								<td>{user.lastActiveAt ? formatDate(user.lastActiveAt) : "No activity"}</td>
								<td>{user.books.toLocaleString()}</td>
								<td>{user.reviews.toLocaleString()}</td>
								<td>{user.journalEntries.toLocaleString()}</td>
								<td>{user.readingStreak.toLocaleString()}</td>
								<td><span class="status-pill">{user.status}</span></td>
								<td>
									<div class="action-stack" aria-label={`Actions for ${user.username || user.email || "reader"}`}>
										<button type="button" disabled>Impersonate</button>
										<button type="button" disabled>Resend login</button>
										<button type="button" disabled>Export</button>
										<button type="button" disabled>Deactivate</button>
										{user.username ? <a class="danger-link" href={`/admin/users/${encodeURIComponent(user.username)}`}>Delete</a> : <span class="muted">Delete</span>}
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	</div>
</Layout>

<style>
	.admin-beta-users-page { max-width: 1080px; }
	.hero h1 { margin: 0; }
	.hero p { margin: 0.35rem 0 0; color: var(--color-text-muted); }
	.panel { margin-top: 1rem; border: var(--border-subtle); border-radius: var(--radius-lg); background: var(--color-surface-raised); padding: 1rem; }
	.panel-head h2 { margin: 0; }
	.panel-head p { margin: 0.3rem 0 0; color: #575757; font-size: 0.9rem; }
	.search-form { display: grid; gap: 0.4rem; margin-top: 0.65rem; }
	.search-form label { font-weight: 700; font-size: 0.9rem; color: #3f3f3f; }
	.search-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
	.search-row input { flex: 1 1 260px; min-width: 0; height: 38px; border: var(--border-strong); border-radius: var(--radius-sm); padding: 0 0.65rem; font: inherit; }
	.search-row button { height: 38px; border: none; border-radius: 8px; padding: 0 0.85rem; background: var(--color-primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
	.secondary-link,
	.table-link { color: var(--color-nav); font-weight: 700; text-decoration: none; }
	.secondary-link:hover,
	.table-link:hover { color: var(--color-nav-hover); text-decoration: underline; }
	.table-wrap { margin-top: 0.7rem; overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
	th, td { text-align: left; padding: 0.45rem; border-bottom: var(--border-subtle); vertical-align: top; }
	th { font-weight: 700; color: #444; }
	td strong { display: block; }
	.muted { color: #6b7280; }
	.status-pill { display: inline-flex; min-height: 24px; align-items: center; border-radius: 999px; border: var(--border-subtle); padding: 0 0.5rem; background: #fff; font-size: 0.78rem; font-weight: 700; }
	.action-stack { display: flex; gap: 0.35rem; flex-wrap: wrap; min-width: 220px; }
	.action-stack button,
	.action-stack a { border: var(--border-subtle); border-radius: 999px; min-height: 30px; padding: 0 0.55rem; background: #fff; color: var(--color-nav); font: inherit; font-weight: 700; text-decoration: none; }
	.action-stack button:disabled,
	.action-stack a[aria-disabled="true"] { opacity: 0.55; cursor: not-allowed; }
	.action-stack .danger-link { color: #991b1b; }
	@media (max-width: 720px) {
		.search-row { display: grid; grid-template-columns: 1fr; align-items: stretch; }
		.search-row input,
		.search-row button { width: 100%; }
	}
</style>
