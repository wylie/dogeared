---
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const SUPPORT_LINK = "https://buymeacoffee.com/wylie";
const sectionLinks = [
	{ id: "why", label: "Why Support" },
	{ id: "ways", label: "Ways to Help" }
];
---

<Layout
	title="Support DogEared"
	sectionLinks={sectionLinks}
	metaDescription="Support DogEared, an independently built reading community maintained by Argon Collective LLC."
	canonicalUrl="/support"
>
	<div slot="right" class="support-page">
		<header class="support-hero">
			<p class="eyebrow">Support DogEared</p>
			<h1>Help keep DogEared independent and improving.</h1>
			<p class="lede">
				DogEared is independently built and maintained by Argon Collective LLC for readers who want a calmer
				place to track, remember, and discover books.
			</p>
		</header>

		<section id="why" class="support-section">
			<h2>Why Support Helps</h2>
			<p>
				Hosting, development, maintenance, and book data all have real costs. Optional reader support helps keep
				the project independent and gives more time to improve the reading experience.
			</p>
			<p>
				Support is never required to use DogEared. It is simply a way to help if the project is useful to you.
			</p>
		</section>

		<section id="ways" class="support-section support-actions">
			<div>
				<h2>Support the Project</h2>
				<p>A one-time contribution helps cover the practical costs behind the site.</p>
			</div>
			<a href={SUPPORT_LINK} class="support-cta" target="_blank" rel="noopener noreferrer">Buy Me a Coffee</a>
		</section>
	</div>
</Layout>

<style>
	.support-page {
		max-width: 820px;
	}
	.support-hero {
		margin-bottom: 1.2rem;
	}
	.eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6a5c3d;
	}
	.support-page h1 {
		margin: 0;
		line-height: 1.05;
		font-size: clamp(2.1rem, 4vw, 3.5rem);
	}
	.lede {
		max-width: 42rem;
		margin: 0.8rem 0 0;
		font-size: 1.05rem;
		line-height: 1.55;
		color: #4d4d4d;
	}
	.support-section {
		margin-top: 0.85rem;
		background: var(--color-surface-raised);
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		padding: 0.95rem 1rem;
	}
	.support-section h2 {
		margin: 0;
	}
	.support-section p {
		margin: 0.55rem 0 0;
		line-height: 1.6;
		color: #353535;
	}
	.support-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
	}
	.support-cta {
		flex: 0 0 auto;
		text-decoration: none;
		border-radius: 999px;
		background: #121212;
		color: #fff;
		padding: 0.58rem 0.86rem;
		font-weight: 700;
	}
	.support-cta:hover,
	.support-cta:focus-visible {
		background: #2f8f57;
	}
	@media (max-width: 680px) {
		.support-actions {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
