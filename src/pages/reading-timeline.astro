---
import Layout from "../layouts/Layout.astro";
import { resolveUserBySession } from "../lib/auth";
import { getNeonSql } from "../lib/neon";
import { authorHref } from "../lib/author";
import { ensureCustomShelfSchema } from "../lib/customShelves";
import type { ReadingLifeGenre, ReadingLifeProgressEvent } from "../lib/readingLife.ts";
import {
	buildReadingTimelineBooks,
	buildReadingTimelineMilestones,
	filterReadingTimelineBooks,
	formatTimelineDate,
	groupReadingTimelineByYearMonth,
	readingTimelineFilterOptions,
	type ReadingTimelineBook
} from "../lib/readingTimeline.ts";

export const prerender = false;

type RawFinishedBookRow = {
	id: number;
	title: string;
	primary_author: string;
	author_id: number | null;
	cover_url: string;
	page_count: number;
	published_year: number | null;
	finished_date: string | null;
	updated_at: string | null;
	rating: number | null;
	genres: ReadingLifeGenre[] | string | null;
	series_id: number | null;
	series_name: string | null;
	custom_shelves: string[] | string | null;
};

type RawProgressRow = {
	book_id: number;
	date: string;
	page_delta: number;
};

function parseJsonArray(value: unknown) {
	if (Array.isArray(value)) return value;
	if (typeof value === "string") {
		try {
			const parsed = JSON.parse(value || "[]");
			return Array.isArray(parsed) ? parsed : [];
		} catch {
			return [];
		}
	}
	return [];
}

function parseGenres(value: RawFinishedBookRow["genres"]): ReadingLifeGenre[] {
	return parseJsonArray(value)
		.map((item) => ({
			slug: String((item as ReadingLifeGenre)?.slug || "").trim(),
			name: String((item as ReadingLifeGenre)?.name || "").trim()
		}))
		.filter((genre) => genre.name);
}

function parseStringArray(value: unknown) {
	return parseJsonArray(value).map((item) => String(item || "").trim()).filter(Boolean);
}

function bookHref(id: number) {
	return `/book?bookId=${encodeURIComponent(String(id))}`;
}

function formatRating(value: number | null | undefined) {
	const rating = Number(value || 0);
	return rating > 0 ? `${rating}/5` : "Unrated";
}

function ratingStars(value: number | null | undefined) {
	const rating = Math.max(0, Math.min(5, Math.round(Number(value || 0))));
	return rating > 0 ? Array.from({ length: 5 }, (_, index) => index < rating ? "★" : "☆").join("") : "";
}

function genreLabel(book: ReadingTimelineBook) {
	const genres = (book.genres || []).map((genre) => genre.name).filter(Boolean);
	return genres.slice(0, 2).join(", ");
}

function shelfLabel(book: ReadingTimelineBook) {
	const labels = [book.shelfLabel || "Read", ...(book.customShelves || [])].filter(Boolean);
	return labels.join(" · ");
}

async function ensureReadingTimelineSchema(sql: ReturnType<typeof getNeonSql>) {
	await Promise.all([
		sql`alter table user_book add column if not exists rating int`,
		sql`alter table user_book add column if not exists finished_reflection text not null default ''`,
		sql`
			create table if not exists user_reading_progress_event (
				id bigserial primary key,
				user_id uuid not null references app_user(id) on delete cascade,
				book_id bigint not null references book(id) on delete cascade,
				from_page int not null default 0,
				to_page int not null default 0,
				page_delta int not null default 0,
				recorded_at timestamptz not null default now()
			)
		`
	]);
	await ensureCustomShelfSchema(sql);
}

const session = await resolveUserBySession(Astro.request);
const viewerUserId = session?.userId || "";
const filters = {
	year: Astro.url.searchParams.get("year") || "",
	genre: Astro.url.searchParams.get("genre") || "",
	shelf: Astro.url.searchParams.get("shelf") || "",
	rating: Astro.url.searchParams.get("rating") || "",
	author: Astro.url.searchParams.get("author") || "",
	query: Astro.url.searchParams.get("q") || ""
};
const sectionLinks = viewerUserId ? [
	{ id: "filters", label: "Filters" },
	{ id: "milestones", label: "Milestones" },
	{ id: "timeline", label: "Timeline" }
] : [];

let allBooks: ReadingTimelineBook[] = [];
let progressEvents: ReadingLifeProgressEvent[] = [];
let annualGoal = "";
let loadError = "";

if (viewerUserId) {
	try {
		const sql = getNeonSql();
		await ensureReadingTimelineSchema(sql);
		const [profileRows, finishedRows, progressRows] = await Promise.all([
			sql<Array<{ profile_data: unknown }>>`
				select profile_data
				from app_user
				where id = ${viewerUserId}::uuid
				limit 1
			`,
			sql<RawFinishedBookRow[]>`
				select
					b.id,
					b.title,
					b.primary_author,
					b.author_id,
					b.cover_url,
					b.page_count,
					b.published_year,
					ub.finished_date::text as finished_date,
					ub.updated_at::text as updated_at,
					ub.rating,
					coalesce(
						json_agg(distinct jsonb_build_object('slug', bg.genre_slug, 'name', bg.genre_name))
							filter (where bg.genre_slug is not null),
						'[]'::json
					) as genres,
					s.id as series_id,
					s.name as series_name,
					coalesce(
						json_agg(distinct cs.name)
							filter (where cs.name is not null),
						'[]'::json
					) as custom_shelves
				from user_book ub
				join book b on b.id = ub.book_id
				left join book_genre bg on bg.book_id = b.id
				left join series_book sb on sb.book_id = b.id
				left join series s on s.id = sb.series_id
				left join user_custom_shelf_book csb on csb.user_id = ub.user_id and csb.book_id = ub.book_id
				left join user_custom_shelf cs on cs.id = csb.shelf_id and cs.user_id = ub.user_id
				where ub.user_id = ${viewerUserId}::uuid
					and ub.status = 'finished'
				group by b.id, b.title, b.primary_author, b.author_id, b.cover_url, b.page_count, b.published_year, ub.finished_date, ub.updated_at, ub.rating, s.id, s.name
				order by coalesce(ub.finished_date, ub.updated_at::date) desc, b.title asc
			`,
			sql<RawProgressRow[]>`
				select
					book_id,
					recorded_at::date::text as date,
					page_delta
				from user_reading_progress_event
				where user_id = ${viewerUserId}::uuid
				order by recorded_at desc
			`
		]);

		const profileData = profileRows[0]?.profile_data && typeof profileRows[0].profile_data === "object"
			? profileRows[0].profile_data as Record<string, unknown>
			: {};
		annualGoal = String(profileData.readingGoal || "");
		allBooks = buildReadingTimelineBooks(finishedRows.map((row) => ({
			id: Number(row.id || 0),
			title: String(row.title || "Untitled"),
			author: String(row.primary_author || "Unknown Author"),
			authorId: row.author_id ? Number(row.author_id) : null,
			coverUrl: String(row.cover_url || ""),
			pageCount: Number(row.page_count || 0),
			publishedYear: row.published_year ? Number(row.published_year) : null,
			finishedDate: String(row.finished_date || ""),
			updatedAt: String(row.updated_at || ""),
			rating: row.rating ? Number(row.rating) : null,
			genres: parseGenres(row.genres),
			seriesId: row.series_id ? Number(row.series_id) : null,
			seriesName: String(row.series_name || ""),
			status: "finished",
			shelfLabel: "Read",
			customShelves: parseStringArray(row.custom_shelves)
		})));
		progressEvents = progressRows.map((row) => ({
			bookId: Number(row.book_id || 0),
			date: String(row.date || ""),
			pageDelta: Number(row.page_delta || 0)
		}));
	} catch (error) {
		loadError = error instanceof Error ? error.message : "Unable to load your reading timeline.";
	}
}

const filteredBooks = filterReadingTimelineBooks(allBooks, filters);
const groups = groupReadingTimelineByYearMonth(filteredBooks, progressEvents);
const filterOptions = readingTimelineFilterOptions(allBooks);
const milestones = buildReadingTimelineMilestones({ books: allBooks, progressEvents, annualGoal });
const totalPages = filteredBooks.reduce((sum, book) => sum + Math.max(0, Number(book.pageCount || 0)), 0);
const hasActiveFilters = Object.values(filters).some((value) => String(value || "").trim());
---

<Layout
	title="Reading Timeline"
	metaDescription="A private chronological reading timeline for finished books."
	canonicalUrl="/reading-timeline"
	robots="noindex,nofollow"
	sectionLinks={sectionLinks}
>
	<div slot="right" class="reading-timeline-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<span>Reading Timeline</span>
		</nav>

		<header class="timeline-hero">
			<p class="eyebrow">Private reading history</p>
			<h1>Reading Timeline</h1>
			<p>Browse finished books by year and month, and revisit the seasons of your reading life.</p>
			{loadError && <p class="note" role="status">Timeline is temporarily unavailable. {loadError}</p>}
			{!viewerUserId && (
				<div class="sign-in-panel">
					<h2>Log in to see your timeline.</h2>
					<p>Your timeline is built from finished books, ratings, finished dates, page counts, and reading progress.</p>
					<a class="button-link" href="/?next=/reading-timeline">Log in</a>
				</div>
			)}
		</header>

		{viewerUserId && (
			<>
				<section id="filters" class="panel filters-panel" aria-labelledby="filters-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Find a season</p>
							<h2 id="filters-title">Filter your timeline</h2>
						</div>
						<p>{filteredBooks.length.toLocaleString()} of {allBooks.length.toLocaleString()} finished books</p>
					</div>
					<form class="timeline-filters" method="get" action="/reading-timeline">
						<label>
							<span>Year</span>
							<select name="year">
								<option value="" selected={!filters.year}>All years</option>
								{filterOptions.years.map((year) => <option value={year} selected={String(filters.year) === String(year)}>{year}</option>)}
							</select>
						</label>
						<label>
							<span>Genre</span>
							<select name="genre">
								<option value="" selected={!filters.genre}>All genres</option>
								{filterOptions.genres.map((genre) => <option value={genre} selected={filters.genre === genre}>{genre}</option>)}
							</select>
						</label>
						<label>
							<span>Shelf</span>
							<select name="shelf">
								<option value="" selected={!filters.shelf}>All shelves</option>
								{filterOptions.shelves.map((shelf) => <option value={shelf} selected={filters.shelf === shelf}>{shelf}</option>)}
							</select>
						</label>
						<label>
							<span>Rating</span>
							<select name="rating">
								<option value="" selected={!filters.rating}>Any rating</option>
								{filterOptions.ratings.map((rating) => <option value={rating} selected={String(filters.rating) === String(rating)}>{rating}/5</option>)}
							</select>
						</label>
						<label>
							<span>Author</span>
							<select name="author">
								<option value="" selected={!filters.author}>All authors</option>
								{filterOptions.authors.map((author) => <option value={author} selected={filters.author === author}>{author}</option>)}
							</select>
						</label>
						<label class="search-filter">
							<span>Search</span>
							<input type="search" name="q" value={filters.query} placeholder="Title, author, series, shelf, or genre" />
						</label>
						<div class="filter-actions">
							<button type="submit">Apply</button>
							{hasActiveFilters && <a href="/reading-timeline">Clear</a>}
						</div>
					</form>
				</section>

				<section id="milestones" class="panel milestones-panel" aria-labelledby="milestones-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Notable moments</p>
							<h2 id="milestones-title">Milestones</h2>
						</div>
						<p>{totalPages.toLocaleString()} pages in this view</p>
					</div>
					{milestones.length === 0 ? (
						<p class="empty-state">Finish a book with a date to begin building milestones.</p>
					) : (
						<ul class="milestone-list">
							{milestones.map((milestone) => (
								<li>
									<p>{milestone.title}</p>
									{milestone.bookId ? (
										<a href={bookHref(milestone.bookId)}>{milestone.description}</a>
									) : (
										<strong>{milestone.description}</strong>
									)}
									{milestone.dateLabel && <span>{milestone.dateLabel}</span>}
								</li>
							))}
						</ul>
					)}
				</section>

				<section id="timeline" class="timeline-section" aria-labelledby="timeline-title">
					<div class="timeline-title-row">
						<div>
							<p class="eyebrow">Finished books</p>
							<h2 id="timeline-title">Chronological timeline</h2>
						</div>
						<a class="quiet-link" href="/reading-life">Open My Reading Life</a>
					</div>
					{groups.length === 0 ? (
						<section class="panel">
							<p class="empty-state">{hasActiveFilters ? "No finished books match these filters yet." : "No finished books with dates yet. Mark a book Read with a finished date to start your timeline."}</p>
						</section>
					) : (
						groups.map((yearGroup) => (
							<section class="timeline-year" aria-labelledby={`year-${yearGroup.year}`}>
								<div class="year-heading">
									<h3 id={`year-${yearGroup.year}`}>{yearGroup.year}</h3>
									<p>{yearGroup.books.toLocaleString()} {yearGroup.books === 1 ? "book" : "books"} · {yearGroup.pages.toLocaleString()} pages</p>
								</div>
								{yearGroup.months.map((monthGroup) => (
									<section class="timeline-month" aria-labelledby={`month-${yearGroup.year}-${monthGroup.month}`}>
										<div class="month-heading">
											<div>
												<h4 id={`month-${yearGroup.year}-${monthGroup.month}`}>{monthGroup.monthName}</h4>
												<p>{monthGroup.summary.booksFinished.toLocaleString()} finished · {monthGroup.summary.pagesRead.toLocaleString()} pages</p>
											</div>
											<dl class="month-summary">
												<div><dt>Favorite genre</dt><dd>{monthGroup.summary.favoriteGenre}</dd></div>
												<div><dt>Average rating</dt><dd>{monthGroup.summary.averageRating > 0 ? `${monthGroup.summary.averageRating.toFixed(2)}/5` : "Unrated"}</dd></div>
												<div><dt>Reading streak</dt><dd>{monthGroup.summary.readingStreakDays.toLocaleString()} {monthGroup.summary.readingStreakDays === 1 ? "day" : "days"}</dd></div>
											</dl>
										</div>
										<ol class="book-timeline-list">
											{monthGroup.books.map((book) => (
												<li>
													<a class="book-cover" href={bookHref(book.id)} aria-label={`Open ${book.title}`}>
														{book.coverUrl ? (
															<img src={book.coverUrl} alt="" loading="lazy" decoding="async" width="48" height="72" />
														) : (
															<span class="cover-placeholder" aria-hidden="true">menu_book</span>
														)}
													</a>
													<div class="book-entry-main">
														<p class="finish-date">{formatTimelineDate(book.dateKey)}</p>
														<h5><a href={bookHref(book.id)}>{book.title}</a></h5>
														<p class="book-meta">
															<a href={authorHref(book.author, book.authorId || 0)}>{book.author}</a>
															{book.seriesName && <> · {book.seriesName}</>}
														</p>
														<p class="book-detail-line">
															<span>{ratingStars(book.rating)} {formatRating(book.rating)}</span>
															<span>{shelfLabel(book)}</span>
															{genreLabel(book) && <span>{genreLabel(book)}</span>}
														</p>
													</div>
												</li>
											))}
										</ol>
									</section>
								))}
							</section>
						))
					)}
				</section>
			</>
		)}
	</div>
</Layout>

<style>
	.reading-timeline-page {
		max-width: 980px;
	}
	.breadcrumbs {
		display: flex;
		gap: 0.35rem;
		align-items: center;
		flex-wrap: wrap;
		margin: 0 0 0.65rem;
		font-size: 0.84rem;
		color: var(--color-text-subtle);
	}
	.breadcrumbs a,
	.quiet-link,
	.book-entry-main a,
	.milestone-list a {
		color: var(--color-nav);
		text-decoration: none;
	}
	.breadcrumbs a:hover,
	.breadcrumbs a:focus-visible,
	.quiet-link:hover,
	.quiet-link:focus-visible,
	.book-entry-main a:hover,
	.book-entry-main a:focus-visible,
	.milestone-list a:hover,
	.milestone-list a:focus-visible {
		color: var(--color-nav-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.timeline-hero {
		padding: 0.4rem 0 0.9rem;
	}
	.eyebrow {
		margin: 0 0 0.25rem;
		color: var(--color-text-subtle);
		font-size: 0.78rem;
		font-weight: 780;
		text-transform: uppercase;
		letter-spacing: 0;
	}
	.timeline-hero h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.35rem);
		line-height: 1;
	}
	.timeline-hero > p {
		max-width: 680px;
		margin: 0.7rem 0 0;
		color: var(--color-text-muted);
		font-size: 1.05rem;
		line-height: 1.55;
	}
	.note,
	.empty-state {
		color: var(--color-text-muted);
	}
	.sign-in-panel,
	.panel,
	.timeline-year {
		background: var(--color-surface-raised);
		border: var(--border-subtle);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-xs);
		padding: 1rem;
	}
	.sign-in-panel {
		margin-top: 1rem;
	}
	.sign-in-panel h2,
	.sign-in-panel p {
		margin: 0 0 0.45rem;
	}
	.button-link,
	.timeline-filters button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: 999px;
		background: var(--color-primary);
		color: #fff;
		font-weight: 800;
		text-decoration: none;
		padding: 0.55rem 0.95rem;
		cursor: pointer;
	}
	.panel + .panel,
	.panel + .timeline-section,
	.timeline-year + .timeline-year {
		margin-top: 1rem;
	}
	.section-head,
	.timeline-title-row,
	.year-heading,
	.month-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.section-head,
	.timeline-title-row {
		margin-bottom: 0.85rem;
	}
	.section-head h2,
	.section-head p,
	.timeline-title-row h2,
	.timeline-title-row p,
	.year-heading h3,
	.year-heading p,
	.month-heading h4,
	.month-heading p {
		margin: 0;
	}
	.section-head > p,
	.year-heading p,
	.month-heading p {
		color: var(--color-text-muted);
		font-weight: 700;
	}
	.timeline-filters {
		display: grid;
		grid-template-columns: repeat(5, minmax(120px, 1fr));
		gap: 0.65rem;
		align-items: end;
	}
	.timeline-filters label span {
		display: block;
		margin-bottom: 0.25rem;
		color: var(--color-text-muted);
		font-size: 0.82rem;
		font-weight: 800;
	}
	.timeline-filters select,
	.timeline-filters input {
		width: 100%;
		box-sizing: border-box;
		border: var(--border-subtle);
		border-radius: 8px;
		background: #fff;
		color: var(--color-text);
		font: inherit;
		padding: 0.52rem 0.62rem;
	}
	.timeline-filters select:focus,
	.timeline-filters input:focus {
		outline: 3px solid rgba(31, 122, 69, 0.28);
		outline-offset: 2px;
	}
	.search-filter {
		grid-column: span 2;
	}
	.filter-actions {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}
	.filter-actions a {
		color: var(--color-nav);
		font-weight: 800;
		text-decoration: none;
	}
	.milestone-list,
	.book-timeline-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.milestone-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0.65rem;
	}
	.milestone-list li {
		border: var(--border-subtle);
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.66);
		padding: 0.75rem;
	}
	.milestone-list p,
	.milestone-list strong,
	.milestone-list span {
		display: block;
		margin: 0;
	}
	.milestone-list p {
		color: var(--color-text-muted);
		font-size: 0.82rem;
		font-weight: 800;
	}
	.milestone-list strong,
	.milestone-list a {
		margin-top: 0.25rem;
		font-weight: 800;
		line-height: 1.25;
	}
	.milestone-list span {
		margin-top: 0.3rem;
		color: var(--color-text-muted);
		font-size: 0.84rem;
	}
	.timeline-year {
		margin-top: 0.8rem;
		padding: 1.1rem;
	}
	.year-heading {
		border-bottom: var(--border-subtle);
		padding-bottom: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.year-heading h3 {
		font-size: 1.8rem;
		line-height: 1;
	}
	.timeline-month + .timeline-month {
		margin-top: 1.3rem;
	}
	.month-heading {
		align-items: flex-start;
		margin-bottom: 0.5rem;
	}
	.month-heading h4 {
		font-size: 1.2rem;
	}
	.month-summary {
		display: grid;
		grid-template-columns: repeat(3, minmax(110px, 1fr));
		gap: 0.45rem;
		margin: 0;
		min-width: min(100%, 440px);
	}
	.month-summary div {
		border: var(--border-subtle);
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.58);
		padding: 0.45rem 0.55rem;
	}
	.month-summary dt,
	.month-summary dd {
		margin: 0;
	}
	.month-summary dt {
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 800;
	}
	.month-summary dd {
		margin-top: 0.1rem;
