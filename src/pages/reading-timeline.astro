---
export const prerender = false;

const destination = new URL("/reading-life", Astro.url);
for (const [key, value] of Astro.url.searchParams.entries()) {
	destination.searchParams.append(key, value);
}
destination.hash = "timeline";

return Astro.redirect(`${destination.pathname}${destination.search}${destination.hash}`, 302);
---
