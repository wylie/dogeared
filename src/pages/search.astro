---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import ShelfDropdown from '../components/ShelfDropdown.astro';
import RatingControl from '../components/RatingControl.astro';
import { resolveUserBySession } from '../lib/auth';
import { authorHref } from '../lib/author';
import { getNeonSql } from '../lib/neon';
import { resolveCustomShelfOptions } from '../lib/customShelves';

export const prerender = false;
const session = await resolveUserBySession(Astro.request);
const isAuthenticated = !!session?.userId;

type SearchResult = {
	source?: "dbd" | "google_books" | "open_library";
	title: string;
	subtitle: string;
	authors: string[];
	description: string;
	publisher: string;
	publishedDate: string;
	printType: string;
	pageCount: number | null;
	categories: string[];
	language: string;
	thumbnail: string;
	isbn10: string;
	isbn13: string;
	googleBooksId: string;
	bookId?: number;
	authorId?: number;
	seriesName?: string;
	seriesBookOrder?: number;
	seriesLabel?: string;
	variantCount?: number;
	variants?: Array<{
		title: string;
		author: string;
		pageCount: number;
		thumbnail: string;
		language: string;
		publishedDate: string;
		publisher: string;
		isbn10: string;
		isbn13: string;
		googleBooksId: string;
		bookId?: number;
		authorId?: number;
		format: string;
		optionLabel: string;
		detailLabel: string;
	}>;
};

type CollectionSearchResult = {
	title: string;
	slug: string;
	subtitle: string;
	description: string;
	heroImage: string;
	category: string;
	bookCount: number;
	featured: boolean;
};

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
let results: SearchResult[] = [];
let collectionResults: CollectionSearchResult[] = [];
let errorMessage = "";
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let viewerRatingByBookId = new Map<number, number>();
let averageRatingByBookId = new Map<number, number>();
let ratingCountByBookId = new Map<number, number>();
let customShelfOptionsJson = "[]";

function truncateDescription(value: string, maxLength = 280) {
	const text = String(value || "")
		.replace(/<[^>]+>/g, " ")
		.replace(/\s+/g, " ")
		.trim();
	if (!text) return "";
	if (text.length <= maxLength) return text;
	return `${text.slice(0, maxLength).trimEnd()}…`;
}

function publishedYearOnly(value: string) {
	const match = String(value || "").match(/\b(1[0-9]{3}|20[0-9]{2}|2100)\b/);
	return match ? match[1] : "";
}

if (query) {
	try {
		const endpoint = new URL("/api/books/search", Astro.url);
		endpoint.searchParams.set("q", query);
		endpoint.searchParams.set("page", "1");
		endpoint.searchParams.set("pageSize", "20");
		const response = await fetch(endpoint, { headers: { Accept: "application/json" } });
		if (!response.ok) {
			errorMessage = `Search failed (${response.status}).`;
		} else {
			const payload = await response.json();
			results = Array.isArray(payload?.results) ? payload.results : [];
			collectionResults = Array.isArray(payload?.collectionResults) ? payload.collectionResults : [];
			if (session?.userId && results.length > 0) {
				const bookIds = Array.from(new Set(results.map((result) => Number(result.bookId || 0)).filter((value) => value > 0)));
				if (bookIds.length > 0) {
					const sql = getNeonSql();
					const statusRows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>>`
						select book_id, status, rating
						from user_book
						where user_id = ${session.userId}::uuid
							and book_id = any(${bookIds}::bigint[])
					`;
					viewerStatusByBookId = new Map(statusRows.map((row) => [Number(row.book_id || 0), row.status]));
					viewerRatingByBookId = new Map(statusRows.map((row) => [
						Number(row.book_id || 0),
						Math.max(0, Math.min(5, Number(row.rating || 0) || 0))
					]));
					const ratingRows = await sql<Array<{ book_id: number; average_rating: number | null; rating_count: number }>>`
						select
							ub.book_id,
							round(avg(ub.rating)::numeric, 1) as average_rating,
							count(*) filter (where ub.rating is not null)::int as rating_count
						from user_book ub
						where ub.book_id = any(${bookIds}::bigint[])
						group by ub.book_id
					`;
					averageRatingByBookId = new Map(
						ratingRows.map((row) => [Number(row.book_id || 0), Number(row.average_rating || 0)])
					);
					ratingCountByBookId = new Map(
						ratingRows.map((row) => [Number(row.book_id || 0), Number(row.rating_count || 0)])
					);
				}
			}
		}
	} catch (error) {
		errorMessage = error instanceof Error ? error.message : "Unknown error";
	}
}

if (session?.userId) {
	try {
		const sql = getNeonSql();
		customShelfOptionsJson = JSON.stringify(await resolveCustomShelfOptions(sql, session.userId));
	} catch {
		customShelfOptionsJson = "[]";
	}
}
---

<Layout
	title="Search"
	robots="noindex,nofollow"
	metaDescription="Search DogEared for books and add them to your shelves."
	canonicalUrl="/search"
>
		<div slot="right" class="search-page" id="search-page" data-query={query} data-authenticated={String(isAuthenticated)}>
		<h1>Search</h1>
		{!query && <p>Search for a favorite title, then add it to Want to Read, Currently Reading, or Read to build recommendations.</p>}
		{query && errorMessage && <p>Search failed: {errorMessage}</p>}
		{query && !errorMessage && results.length === 0 && collectionResults.length === 0 && <p>No results for "{query}". Try a broader title, an author name, or fewer keywords.</p>}
		{query && !errorMessage && (results.length > 0 || collectionResults.length > 0) && <p>Results for "{query}". Use the shelf dropdown to save books to <a href="/settings#account-settings">Profile</a>.</p>}

		{query && !errorMessage && collectionResults.length > 0 && (
			<section class="collection-search-section" aria-labelledby="collection-search-title">
				<h2 id="collection-search-title">Editorial Collections</h2>
				<ul class="collection-search-results">
					{collectionResults.map((collection) => (
						<li>
							<a href={`/collections/${encodeURIComponent(collection.slug)}`}>
								{collection.heroImage && <img src={collection.heroImage} alt="" loading="lazy" decoding="async" />}
								<span>
									{collection.category && <em>{collection.category}</em>}
									<strong>{collection.title}</strong>
									{collection.subtitle && <small>{collection.subtitle}</small>}
									<small>{collection.description}</small>
									<small>{collection.bookCount.toLocaleString()} book{collection.bookCount === 1 ? "" : "s"}</small>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<ul class="search-results" id="search-results">
			{results.map((result) => (
				(() => {
					const numericBookId = Number(result.bookId || 0);
					const averageRating = Number(averageRatingByBookId.get(numericBookId) || 0);
					const ratingCount = Number(ratingCountByBookId.get(numericBookId) || 0);
					return (
				<BookCard
					title={result.title}
					titleHref={Number(result.bookId || 0) > 0
						? `/book?bookId=${encodeURIComponent(String(result.bookId || 0))}`
						: `/book?googleBooksId=${encodeURIComponent(result.googleBooksId || "")}&isbn13=${encodeURIComponent(result.isbn13 || "")}&isbn10=${encodeURIComponent(result.isbn10 || "")}&title=${encodeURIComponent(result.title)}&author=${encodeURIComponent(result.authors[0] ?? "")}`}
					author={result.authors[0] || "Unknown author"}
					authorHref={result.authors[0] ? authorHref(result.authors[0], result.authorId || 0) : ""}
					thumbnail={result.thumbnail}
					description={truncateDescription(result.description)}
					readers={0}
					shelfEntries={0}
					publishedLabel={publishedYearOnly(result.publishedDate)}
					pageCount={result.pageCount || 0}
					averageRating={averageRating}
					genres={result.categories}
				>
						<div slot="meta">
							{result.seriesLabel && <p class="meta series-meta">{result.seriesLabel}</p>}
							{result.publisher && <p class="meta">Publisher: {result.publisher}</p>}
							{Number(result.bookId || 0) > 0 && viewerStatusByBookId.get(Number(result.bookId || 0)) === "finished" && (
								<RatingControl
									bookId={Number(result.bookId || 0)}
									rating={viewerRatingByBookId.get(Number(result.bookId || 0)) || 0}
									editable={true}
								/>
							)}
						</div>
						<div slot="actions">
							<ShelfDropdown attrs={{
								'data-title': result.title,
								'data-author': result.authors[0] ?? "",
								'data-description': result.description,
								'data-pages': String(result.pageCount ?? 0),
								'data-cover': result.thumbnail,
								'data-format': result.printType || "Book",
								'data-language': result.language || "",
								'data-publisher': result.publisher || "",
								'data-published-date': result.publishedDate || "",
								'data-isbn10': result.isbn10 || "",
								'data-isbn13': result.isbn13 || "",
								'data-google-books-id': result.googleBooksId || "",
								'data-source': result.source || (result.googleBooksId ? "google_books" : "open_library"),
								'data-source-work-id': result.googleBooksId || "",
								'data-source-url': result.googleBooksId ? `https://books.google.com/books?id=${encodeURIComponent(result.googleBooksId)}` : "",
								'data-categories': JSON.stringify(result.categories ?? []),
								'data-custom-shelves': customShelfOptionsJson
							}} />
						</div>
					</BookCard>
					);
				})()
			))}
		</ul>
		{query && !errorMessage && results.length > 0 && (
			<div id="search-sentinel-wrap">
				<div id="search-sentinel" aria-hidden="true"></div>
				<p id="search-loading" class="meta" hidden>Loading more results...</p>
			</div>
		)}
	</div>
</Layout>

<style>
	.search-page {
		max-width: 900px;
	}

	.search-results {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.collection-search-section {
		margin-top: 1rem;
	}
	.collection-search-section h2 {
		margin: 0 0 0.65rem;
	}
	.collection-search-results {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.collection-search-results a {
		position: relative;
		overflow: hidden;
		min-height: 190px;
		display: grid;
		align-items: end;
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface-raised);
		color: inherit;
		text-decoration: none;
	}
	.collection-search-results img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.26;
	}
	.collection-search-results span {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.22rem;
		padding: 0.85rem;
		background: linear-gradient(to top, rgba(255,255,255,0.96), rgba(255,255,255,0.68));
	}
	.collection-search-results strong {
		font-size: 1.25rem;
		line-height: 1.1;
	}
	.collection-search-results small,
	.collection-search-results em {
		color: var(--color-text-muted);
		font-style: normal;
	}

	#search-sentinel-wrap {
		padding: 0.75rem 0 0.25rem;
	}

	#search-sentinel {
		height: 1px;
	}

	.meta {
		margin: 0.2rem 0;
		color: #4a4a4a;
		font-size: 0.92rem;
	}
	.series-meta {
		color: var(--color-nav);
		font-weight: 700;
	}

	.shelf-dropdown {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		margin-top: 0.4rem;
	}

	.shelf-trigger {
		border: none;
		border-radius: 8px;
		padding: 0.55rem 0.85rem;
		font-size: 0.95rem;
		background: var(--color-primary);
		color: #fff;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.shelf-icon {
		font-size: 1.15rem;
		line-height: 1;
	}

	.shelf-check {
		font-size: 1rem;
		line-height: 1;
		opacity: 0;
		transition: opacity 120ms ease-in-out;
	}

	.shelf-dropdown.is-shelved .shelf-check {
		opacity: 1;
	}

	.shelf-trigger:hover {
		background: var(--color-primary-hover);
	}

	.shelf-menu {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		left: auto;
		min-width: 180px;
		background: #fff;
		border: none;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-popover);
		padding: 0.28rem;
		z-index: 25;
	}

	.shelf-option {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		text-align: left;
		border: none;
		background: transparent;
		padding: 0.5rem 0.75rem;
		font-size: 0.92rem;
		cursor: pointer;
		color: var(--color-text);
	}

	.shelf-option:hover {
		background: rgba(87, 117, 144, 0.09);
	}

	.shelf-feedback {
		margin-top: 0.25rem;
		font-size: 0.82rem;
		color: #1f7a45;
		line-height: 1.25;
	}

	.login-confirm-overlay {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100dvh;
		min-height: 100vh;
		background: rgba(0, 0, 0, 0.62);
		z-index: 110;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.login-confirm-dialog {
		width: min(460px, 100%);
		background: #111;
		color: #fff;
		border-radius: var(--radius-lg);
		padding: 1rem;
		box-shadow: var(--shadow-md);
	}

	.login-confirm-dialog p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.45;
	}

	.login-confirm-actions {
		margin-top: 0.95rem;
		display: flex;
		justify-content: flex-end;
		gap: 0.55rem;
	}

	.login-confirm-actions button {
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: transparent;
		color: #d9e3ff;
		font: inherit;
		font-weight: 600;
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		cursor: pointer;
	}

	.login-confirm-actions .confirm {
		background: #2e8f57;
		border-color: #2e8f57;
		color: #fff;
	}

	@media (max-width: 860px) {
		.search-results,
		.collection-search-results {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { resolveClientAuthState } from "../lib/clientAuth.ts";
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		parseCategories,
		promptForShelfLogin,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		toggleShelfMenu,
		initRatingControls
	} from "../lib/shelfClient.ts";
	import {
		loadShelfEntries,
		loadShelfUpdates,
		migrateShelfEntriesInPlace,
		saveShelfEntries,
		saveShelfUpdates
	} from "../lib/shelfStorage.ts";

	const searchPage = document.getElementById("search-page");
	let isAuthenticated = searchPage?.dataset.authenticated === "true";
	const feedbackTimers = new WeakMap();
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	initRatingControls();

	function normalizeText(value) {
		return String(value || "").trim().toLowerCase();
	}

	function canonicalizeTitle(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/\([^)]*\)/g, " ")
			.replace(/\b(abridged|unabridged|audio ?book|audiobook|kindle edition|paperback|hardcover|ebook|e-book|digital edition|color edition)\b/g, " ")
			.split(":")[0]
			.replace(/^(the|a|an)\s+/g, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function canonicalizeAuthor(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/^(by\s+)/, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function logShelfUpdate(entry, status) {
		if (!entry?.title) return;
		const updates = loadShelfUpdates();
		updates.unshift({
			id: `upd_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
			timestamp: Date.now(),
			status: status || entry.status || "want_to_read",
			title: entry.title,
			author: entry.author || "",
			coverUrl: entry.coverUrl || "",
			format: entry.format || "",
			language: entry.language || ""
		});
		saveShelfUpdates(updates);
	}

	function findEntry(entries, title, author) {
		const t = canonicalizeTitle(title);
		const a = canonicalizeAuthor(author);
		return entries.find((entry) => (
			canonicalizeTitle(entry.title) === t && canonicalizeAuthor(entry.author) === a
		));
	}

	function closeAllMenus() {
		closeShelfMenus(shelfDropdowns);
	}

	function applyStatus(entry, selectedStatus, totalPages) {
		entry.status = selectedStatus;
		if (selectedStatus === "finished") {
			if (totalPages > 0) {
				entry.currentPage = totalPages;
			}
			entry.finishedDate = entry.finishedDate || new Date().toISOString().slice(0, 10);
			return;
		}
		if (selectedStatus === "reading") {
			entry.currentPage = Math.max(0, Number(entry.currentPage) || 0);
		}
		if (selectedStatus === "want_to_read") {
			entry.currentPage = 0;
		}
		entry.finishedDate = "";
	}

	function mergeServerEntry(entries, localEntry, serverEntry) {
		if (!serverEntry || typeof serverEntry !== "object") return;
		const incoming = serverEntry;
		const byId = String(incoming.id || "").trim();
		const byTitle = String(incoming.title || localEntry?.title || "").trim();
		const byAuthor = String(incoming.author || localEntry?.author || "").trim();
		const existingById = byId ? entries.findIndex((item) => String(item?.id || "") === byId) : -1;
		const existingByTitle = existingById === -1 ? entries.findIndex((item) => findEntry([item], byTitle, byAuthor)) : -1;
		const nextEntry = {
			...(localEntry || {}),
			...incoming
		};
		if (existingById >= 0) {
			entries[existingById] = nextEntry;
			return;
		}
		if (existingByTitle >= 0) {
			entries[existingByTitle] = nextEntry;
			return;
		}
		entries.unshift(nextEntry);
	}

	function setShelf(dropdown, selectedStatus) {
		if (!isAuthenticated) {
			promptForShelfLogin();
			return;
		}
		const title = String(dropdown.dataset.title || "").trim();
		if (!title) return;
		const author = String(dropdown.dataset.author || "").trim();
		const totalPages = Math.max(0, Number(dropdown.dataset.pages || 0) || 0);
		const coverUrl = String(dropdown.dataset.cover || "").trim();
		const format = String(dropdown.dataset.format || "").trim();
		const language = String(dropdown.dataset.language || "").trim();
		const publisher = String(dropdown.dataset.publisher || "").trim();
		const publishedDate = String(dropdown.dataset.publishedDate || "").trim();
		const description = String(dropdown.dataset.description || "").trim();
		const isbn10 = String(dropdown.dataset.isbn10 || "").trim();
		const isbn13 = String(dropdown.dataset.isbn13 || "").trim();
		const googleBooksId = String(dropdown.dataset.googleBooksId || "").trim();
		const categories = parseCategories(dropdown.dataset.categories);

		const entries = loadShelfEntries();
		const existing = findEntry(entries, title, author);
		if (existing) {
			const previousStatus = existing.status;
			if (!existing.totalPages && totalPages > 0) existing.totalPages = totalPages;
			if (!existing.coverUrl && coverUrl) existing.coverUrl = coverUrl;
			if (format) existing.format = format;
			if (language) existing.language = language;
			if (publisher) existing.publisher = publisher;
			if (publishedDate) existing.publishedDate = publishedDate;
			if (isbn10) existing.isbn10 = isbn10;
			if (isbn13) existing.isbn13 = isbn13;
			if (googleBooksId) existing.googleBooksId = googleBooksId;
			if (categories.length > 0) existing.categories = categories;
			if (description && !existing.description) existing.description = description;
			applyStatus(existing, selectedStatus, totalPages || Number(existing.totalPages) || 0);
			existing.updatedAt = Date.now();
			saveShelfEntries(entries);
			if (previousStatus !== selectedStatus) {
				logShelfUpdate(existing, selectedStatus);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(selectedStatus)}.`, feedbackTimers);
			} else {
				showShelfFeedback(dropdown, `Already on ${statusLabel(selectedStatus)}.`, feedbackTimers);
			}
			setDropdownLabel(dropdown, selectedStatus);
			setShelvedState(dropdown, true);
			void (async () => {
				const result = await saveShelfEntryWithRetry(existing);
				const serverEntry = result?.data && typeof result.data === "object" ? result.data.entry : null;
				if (result.ok && serverEntry) {
					const latest = loadShelfEntries();
					mergeServerEntry(latest, existing, serverEntry);
					saveShelfEntries(latest);
					syncExistingState();
				} else if (!result.ok && result.message) {
					showShelfFeedback(dropdown, result.message, feedbackTimers);
				}
			})();
			return;
		}

		const next = buildShelfEntryFromRecord({
			title,
			author,
			description,
			pageCount: totalPages,
			coverUrl,
			format,
			language,
			publisher,
			publishedDate,
			isbn10,
			isbn13,
			googleBooksId,
			categories
		}, {
			status: selectedStatus,
			totalPages,
			currentPage: 0,
			finishedDate: "",
			source: "google_books",
			sourceWorkId: googleBooksId,
			sourceUrl: googleBooksId ? `https://books.google.com/books?id=${encodeURIComponent(googleBooksId)}` : "",
			updatedAt: Date.now()
		});
		applyStatus(next, selectedStatus, totalPages);
		entries.unshift(next);
		saveShelfEntries(entries);
		logShelfUpdate(next, selectedStatus);
		setDropdownLabel(dropdown, selectedStatus);
		setShelvedState(dropdown, true);
		showShelfFeedback(dropdown, `Saved to ${statusLabel(selectedStatus)}.`, feedbackTimers);
		void (async () => {
			const result = await saveShelfEntryWithRetry(next);
			const serverEntry = result?.data && typeof result.data === "object" ? result.data.entry : null;
			if (result.ok && serverEntry) {
				const latest = loadShelfEntries();
				mergeServerEntry(latest, next, serverEntry);
				saveShelfEntries(latest);
				syncExistingState();
			} else if (!result.ok && result.message) {
				showShelfFeedback(dropdown, result.message, feedbackTimers);
			}
		})();
	}

	function syncExistingState() {
		if (!isAuthenticated) {
			for (const dropdown of shelfDropdowns) {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
			return;
		}
		const entries = loadShelfEntries();
		for (const dropdown of shelfDropdowns) {
			const title = dropdown.dataset.title || "";
			const author = dropdown.dataset.author || "";
			const existing = findEntry(entries, title, author);
			if (existing) {
				setDropdownLabel(dropdown, existing.status || "");
				setShelvedState(dropdown, true);
			} else {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
		}
	}

	async function initAuthState() {
		migrateShelfEntriesInPlace();
		const state = await resolveClientAuthState({ ssrAuthenticated: isAuthenticated });
		isAuthenticated = state.authenticated;
		syncExistingState();
	}

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle instanceof HTMLElement) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown instanceof HTMLElement) {
				toggleShelfMenu(dropdown, shelfDropdowns);
			}
			return;
		}
		const option = target.closest('[data-action="set-shelf"]');
		if (option instanceof HTMLElement) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = option.closest(".shelf-dropdown");
			if (dropdown instanceof HTMLElement) {
				const status = option.dataset.status || "want_to_read";
				setShelf(dropdown, status);
				closeShelfMenus(shelfDropdowns);
			}
			return;
		}
		if (target.closest(".shelf-dropdown")) return;
		closeAllMenus();
	});

	void initAuthState();
</script>
