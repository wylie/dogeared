</style>

<script>
	import { resolveClientAuthState } from "../lib/clientAuth.ts";
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		parseCategories,
		promptForShelfLogin,
		isShelfActionBusy,
		isShelfDropdownOrMenuTarget,
		setDropdownLabel,
		setShelfActionBusy,
		setShelvedState,
		showShelfFeedback,
		resolveShelfDropdownFromTarget,
		statusLabel,
		saveShelfEntryWithRetry,
		prepareReadingFormatForShelfStatus,
		toggleShelfMenu,
		initRatingControls
	} from "../lib/shelfClient.ts";
	import {
		loadShelfEntries,
		loadShelfUpdates,
		migrateShelfEntriesInPlace,
		saveShelfEntries,
		saveShelfUpdates
	} from "../lib/shelfStorage.ts";

	const searchPage = document.getElementById("search-page");
	let isAuthenticated = searchPage?.dataset.authenticated === "true";
	const feedbackTimers = new WeakMap();
	initRatingControls();

	function getShelfDropdowns() {
		return Array.from(document.querySelectorAll(".shelf-dropdown"));
	}

	function normalizeText(value) {
		return String(value || "").trim().toLowerCase();
	}

	function canonicalizeTitle(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/\([^)]*\)/g, " ")
			.replace(/\b(abridged|unabridged|audio ?book|audiobook|kindle edition|paperback|hardcover|ebook|e-book|digital edition|color edition)\b/g, " ")
			.split(":")[0]
			.replace(/^(the|a|an)\s+/g, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function canonicalizeAuthor(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/^(by\s+)/, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function logShelfUpdate(entry, status) {
		if (!entry?.title) return;
		const updates = loadShelfUpdates();
		updates.unshift({
			id: `upd_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
			timestamp: Date.now(),
			status: status || entry.status || "want_to_read",
			title: entry.title,
			author: entry.author || "",
			coverUrl: entry.coverUrl || "",
			format: entry.format || "",
			language: entry.language || ""
		});
		saveShelfUpdates(updates);
	}

	function findEntry(entries, title, author) {
		const t = canonicalizeTitle(title);
		const a = canonicalizeAuthor(author);
		return entries.find((entry) => (
			canonicalizeTitle(entry.title) === t && canonicalizeAuthor(entry.author) === a
		));
	}

	function closeAllMenus() {
		closeShelfMenus(getShelfDropdowns());
	}

	function applyStatus(entry, selectedStatus, totalPages) {
		entry.status = selectedStatus;
		if (selectedStatus === "finished") {
			if (totalPages > 0) {
				entry.currentPage = totalPages;
			}
			entry.finishedDate = entry.finishedDate || new Date().toISOString().slice(0, 10);
			return;
		}
		if (selectedStatus === "reading") {
			entry.currentPage = Math.max(0, Number(entry.currentPage) || 0);
		}
		if (selectedStatus === "want_to_read") {
			entry.currentPage = 0;
		}
		entry.finishedDate = "";
	}

	function mergeServerEntry(entries, localEntry, serverEntry) {
		if (!serverEntry || typeof serverEntry !== "object") return;
		const incoming = serverEntry;
		const byId = String(incoming.id || "").trim();
		const byTitle = String(incoming.title || localEntry?.title || "").trim();
		const byAuthor = String(incoming.author || localEntry?.author || "").trim();
		const existingById = byId ? entries.findIndex((item) => String(item?.id || "") === byId) : -1;
		const existingByTitle = existingById === -1 ? entries.findIndex((item) => findEntry([item], byTitle, byAuthor)) : -1;
		const nextEntry = {
			...(localEntry || {}),
			...incoming
		};
		if (existingById >= 0) {
			entries[existingById] = nextEntry;
			return;
		}
		if (existingByTitle >= 0) {
			entries[existingByTitle] = nextEntry;
			return;
		}
		entries.unshift(nextEntry);
	}

	async function setShelf(dropdown, selectedStatus) {
		if (!isAuthenticated) {
			promptForShelfLogin();
			return;
		}
		if (isShelfActionBusy(dropdown)) return;
		const title = String(dropdown.dataset.title || "").trim();
		if (!title) return;
		const author = String(dropdown.dataset.author || "").trim();
		const totalPages = Math.max(0, Number(dropdown.dataset.pages || 0) || 0);
		const coverUrl = String(dropdown.dataset.cover || "").trim();
		const format = String(dropdown.dataset.format || "").trim();
		const language = String(dropdown.dataset.language || "").trim();
		const publisher = String(dropdown.dataset.publisher || "").trim();
		const publishedDate = String(dropdown.dataset.publishedDate || "").trim();
		const description = String(dropdown.dataset.description || "").trim();
		const isbn10 = String(dropdown.dataset.isbn10 || "").trim();
		const isbn13 = String(dropdown.dataset.isbn13 || "").trim();
		const googleBooksId = String(dropdown.dataset.googleBooksId || "").trim();
		const bookId = Number(dropdown.dataset.bookId || 0) || 0;
		const source = String(dropdown.dataset.source || "").trim();
		const sourceWorkId = String(dropdown.dataset.sourceWorkId || "").trim();
		const sourceEditionId = String(dropdown.dataset.sourceEditionId || "").trim();
		const sourceUrl = String(dropdown.dataset.sourceUrl || "").trim();
		const categories = parseCategories(dropdown.dataset.categories);

		setShelfActionBusy(dropdown, true);
		showShelfFeedback(dropdown, "Saving...", feedbackTimers);
		try {
			const entries = loadShelfEntries();
			const existing = findEntry(entries, title, author);
			const draft = existing ? { ...existing } : buildShelfEntryFromRecord({
				bookId,
				title,
				author,
				description,
				pageCount: totalPages,
				coverUrl,
				format,
				language,
				publisher,
				publishedDate,
				isbn10,
				isbn13,
				googleBooksId,
				categories
			}, {
				bookId,
				status: selectedStatus,
				totalPages,
				currentPage: 0,
				finishedDate: "",
				source: source || (googleBooksId ? "google_books" : ""),
				sourceWorkId: sourceWorkId || googleBooksId,
				sourceEditionId,
				sourceUrl: sourceUrl || (googleBooksId ? `https://books.google.com/books?id=${encodeURIComponent(googleBooksId)}` : ""),
				updatedAt: Date.now()
			});

			const previousStatus = existing?.status || "";
			if (!draft.totalPages && totalPages > 0) draft.totalPages = totalPages;
			if (!draft.coverUrl && coverUrl) draft.coverUrl = coverUrl;
			if (format) draft.format = format;
			if (language) draft.language = language;
			if (publisher) draft.publisher = publisher;
			if (publishedDate) draft.publishedDate = publishedDate;
			if (isbn10) draft.isbn10 = isbn10;
			if (isbn13) draft.isbn13 = isbn13;
			if (googleBooksId) draft.googleBooksId = googleBooksId;
			if (bookId > 0) draft.bookId = bookId;
			if (source) draft.source = source;
			if (sourceWorkId) draft.sourceWorkId = sourceWorkId;
			if (sourceEditionId) draft.sourceEditionId = sourceEditionId;
			if (sourceUrl) draft.sourceUrl = sourceUrl;
			if (categories.length > 0) draft.categories = categories;
			if (description && !draft.description) draft.description = description;
			applyStatus(draft, selectedStatus, totalPages || Number(draft.totalPages) || 0);
			if (!(await prepareReadingFormatForShelfStatus(draft, selectedStatus))) return;
			draft.updatedAt = Date.now();

			const result = await saveShelfEntryWithRetry(draft);
			if (!result.ok) {
				showShelfFeedback(dropdown, result.message || "Failed to save shelf entry.", feedbackTimers);
				return;
			}

			const latest = loadShelfEntries();
			const localMatch = findEntry(latest, title, author);
			if (localMatch) Object.assign(localMatch, draft);
			else latest.unshift(draft);
			const serverEntry = result?.data && typeof result.data === "object" ? result.data.entry : null;
			if (serverEntry) mergeServerEntry(latest, draft, serverEntry);
			saveShelfEntries(latest);
			if (previousStatus !== selectedStatus) logShelfUpdate(draft, selectedStatus);
			setDropdownLabel(dropdown, selectedStatus);
			setShelvedState(dropdown, true);
			syncExistingState();
			showShelfFeedback(
				dropdown,
				previousStatus === selectedStatus ? `Already on ${statusLabel(selectedStatus)}.` : `Saved to ${statusLabel(selectedStatus)}.`,
				feedbackTimers
			);
		} finally {
			setShelfActionBusy(dropdown, false);
		}
	}

	function syncExistingState() {
		if (!isAuthenticated) {
			for (const dropdown of getShelfDropdowns()) {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
			return;
		}
		const entries = loadShelfEntries();
		for (const dropdown of getShelfDropdowns()) {
			const title = dropdown.dataset.title || "";
			const author = dropdown.dataset.author || "";
			const existing = findEntry(entries, title, author);
			if (existing) {
				setDropdownLabel(dropdown, existing.status || "");
				setShelvedState(dropdown, true);
			} else {
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
			}
		}
	}

	const searchResultsRoot = document.getElementById("search-results");
	const progressiveStatus = document.querySelector("[data-search-progressive-status]");
	const searchLiveStatus = document.querySelector("[data-search-live-status]");
	const emptySearchState = document.querySelector("[data-empty-search-state]");
	let externalSearchController = null;
	let externalSearchRequestId = 0;

	function escapeHtml(value) {
		return String(value || "")
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#39;");
	}

	function slugifyAuthorName(value) {
		return String(value || "")
			.trim()
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-+|-+$/g, "");
	}

	function truncateSearchDescription(value, maxLength = 240) {
		const text = String(value || "")
			.replace(/<[^>]+>/g, " ")
			.replace(/\s+/g, " ")
			.trim();
		if (!text) return "";
		if (text.length <= maxLength) return text;
		return `${text.slice(0, maxLength).trimEnd()}...`;
	}

	function publishedYearLabel(value) {
		return String(value || "").match(/\b(1[0-9]{3}|20[0-9]{2}|2100)\b/)?.[1] || "";
	}

	function searchResultClientKey(result) {
		const bookId = Number(result?.bookId || 0) || 0;
		if (bookId > 0) return `book:${bookId}`;
		const identifier = String(result?.googleBooksId || result?.isbn13 || result?.isbn10 || result?.sourceWorkId || result?.sourceEditionId || "").trim();
		if (identifier) return `external:${identifier}`;
		const author = Array.isArray(result?.authors) ? String(result.authors[0] || "") : "";
		return `title:${String(result?.title || "").trim().toLowerCase()}|${author.trim().toLowerCase()}`;
	}

	function renderedResultKeys() {
		return new Set(Array.from(document.querySelectorAll("[data-search-result-key]"))
			.map((node) => node instanceof HTMLElement ? String(node.dataset.searchResultKey || "") : "")
			.filter(Boolean));
	}

	function renderedBookIds() {
		return new Set(Array.from(document.querySelectorAll("[data-search-book-id]"))
			.map((node) => node instanceof HTMLElement ? Math.max(0, Number(node.dataset.searchBookId || 0) || 0) : 0)
			.filter((id) => id > 0));
	}

	function hasExactLocalTitle(queryText) {
		const normalizedQuery = canonicalizeTitle(queryText);
		if (!normalizedQuery) return false;
		return Array.from(document.querySelectorAll("[data-search-title]")).some((node) => {
			if (!(node instanceof HTMLElement)) return false;
			return canonicalizeTitle(node.dataset.searchTitle || "") === normalizedQuery;
		});
	}

	function renderCustomShelfOptions(rawJson) {
		let shelves = [];
		try {
			const parsed = JSON.parse(String(rawJson || "[]"));
			if (Array.isArray(parsed)) shelves = parsed;
		} catch {
			shelves = [];
		}
		const items = shelves
			.map((shelf) => ({
				id: Math.max(0, Number(shelf?.id || 0) || 0),
				name: String(shelf?.name || "").trim(),
				icon: String(shelf?.icon || "bookmarks").trim() || "bookmarks"
			}))
			.filter((shelf) => shelf.id > 0 && shelf.name)
			.slice(0, 24);
		if (items.length === 0) return "";
		return `
			<div class="shelf-option-divider" role="separator" aria-hidden="true"></div>
			${items.map((shelf) => `
				<button type="button" class="shelf-option" data-action="assign-custom-shelf" data-shelf-id="${shelf.id}" role="menuitem">
					<span class="material-icons shelf-option-icon" aria-hidden="true">${escapeHtml(shelf.icon)}</span>
					<span>${escapeHtml(shelf.name)}</span>
				</button>
			`).join("")}
		`;
	}

	function renderProgressiveShelfDropdown(result, author, categories) {
		const bookId = Number(result?.bookId || 0) || 0;
		const googleBooksId = String(result?.googleBooksId || "").trim();
		const sourceWorkId = String(result?.sourceWorkId || googleBooksId || "").trim();
		const sourceEditionId = String(result?.sourceEditionId || "").trim();
		const sourceUrl = googleBooksId
			? `https://books.google.com/books?id=${encodeURIComponent(googleBooksId)}`
			: (sourceWorkId ? `https://openlibrary.org/works/${encodeURIComponent(sourceWorkId)}` : "");
		const menuId = `shelf-menu-progressive-${Math.random().toString(36).slice(2, 10)}`;
		const attrs = {
			"data-book-id": String(bookId || ""),
			"data-title": String(result?.title || ""),
			"data-author": author,
			"data-description": String(result?.description || ""),
			"data-pages": String(result?.pageCount ?? 0),
			"data-cover": String(result?.thumbnail || ""),
			"data-format": String(result?.printType || "Book"),
			"data-language": String(result?.language || ""),
			"data-publisher": String(result?.publisher || ""),
			"data-published-date": String(result?.publishedDate || ""),
			"data-isbn10": String(result?.isbn10 || ""),
			"data-isbn13": String(result?.isbn13 || ""),
			"data-google-books-id": googleBooksId,
			"data-source": String(result?.source || (googleBooksId ? "google_books" : "open_library")),
			"data-source-work-id": sourceWorkId,
			"data-source-edition-id": sourceEditionId,
			"data-source-url": sourceUrl,
			"data-categories": JSON.stringify(categories),
			"data-custom-shelves": String(searchPage?.dataset.customShelves || "[]")
		};
		const attrHtml = Object.entries(attrs)
			.map(([name, value]) => `${name}="${escapeHtml(value)}"`)
			.join(" ");
		return `
			<div class="shelf-dropdown" ${attrHtml}>
				<div class="shelf-button-wrapper">
					<button type="button" class="shelf-trigger shelf-fab" data-action="toggle-shelf" data-status="" aria-expanded="false" aria-haspopup="menu" aria-controls="${menuId}" aria-label="Shelf: Not on Shelf. Open shelf options" title="Shelf: Not on Shelf">
						<span class="material-icons shelf-plus" aria-hidden="true">library_add</span>
					</button>
					<div id="${menuId}" class="shelf-menu" role="menu" aria-label="Shelf options" hidden>
						<button type="button" class="shelf-option" data-action="set-shelf" data-status="want_to_read" role="menuitem"><span class="material-icons shelf-option-icon" aria-hidden="true">add</span><span>Want to Read</span></button>
						<button type="button" class="shelf-option" data-action="set-shelf" data-status="reading" role="menuitem"><span class="material-icons shelf-option-icon" aria-hidden="true">menu_book</span><span>Currently Reading</span></button>
						<button type="button" class="shelf-option" data-action="set-shelf" data-status="finished" role="menuitem"><span class="material-icons shelf-option-icon" aria-hidden="true">check</span><span>Read</span></button>
						<div data-custom-shelf-options>${renderCustomShelfOptions(searchPage?.dataset.customShelves || "[]")}</div>
						<div class="shelf-option-divider" role="separator" aria-hidden="true"></div>
						<button type="button" class="shelf-option shelf-option-danger" data-action="remove-from-shelves" role="menuitem"><span class="material-icons shelf-option-icon" aria-hidden="true">remove_circle</span><span>Remove from Shelves</span></button>
					</div>
				</div>
				<p class="shelf-feedback" role="status" aria-live="polite" hidden></p>
			</div>
		`;
	}

	function renderProgressiveResult(result) {
		const title = String(result?.title || "").trim();
		if (!title) return "";
		const authors = Array.isArray(result?.authors) ? result.authors : [];
		const author = String(authors[0] || "Unknown author").trim();
		const authorSlug = slugifyAuthorName(author);
		const bookId = Number(result?.bookId || 0) || 0;
		const titleHref = bookId > 0
			? `/book?bookId=${encodeURIComponent(String(bookId))}`
			: `/book?googleBooksId=${encodeURIComponent(String(result?.googleBooksId || ""))}&isbn13=${encodeURIComponent(String(result?.isbn13 || ""))}&isbn10=${encodeURIComponent(String(result?.isbn10 || ""))}&title=${encodeURIComponent(title)}&author=${encodeURIComponent(author)}`;
		const categories = Array.isArray(result?.categories) ? result.categories.map((item) => String(item || "").trim()).filter(Boolean).slice(0, 4) : [];
		const key = searchResultClientKey(result);
		const year = publishedYearLabel(result?.publishedDate);
		const description = truncateSearchDescription(result?.description || "");
		return `
			<li class="progressive-book-card" data-search-result-key="${escapeHtml(key)}" data-search-book-id="${bookId || ""}" data-search-title="${escapeHtml(title)}">
				<div class="progressive-cover-wrap">
					${result?.thumbnail ? `<a href="${escapeHtml(titleHref)}" aria-label="View ${escapeHtml(title)}"><img class="progressive-cover" src="${escapeHtml(result.thumbnail)}" alt="${escapeHtml(title)} cover" loading="lazy" decoding="async" width="84" height="126" /></a>` : `<div class="progressive-cover progressive-cover-placeholder"><span class="material-icons" aria-hidden="true">menu_book</span></div>`}
					<div class="cover-actions">${renderProgressiveShelfDropdown(result, author, categories)}</div>
				</div>
				<div class="progressive-card-body">
					<h3><a href="${escapeHtml(titleHref)}">${escapeHtml(title)}</a></h3>
					<p class="meta">by ${authorSlug ? `<a class="author-link" href="/author/${encodeURIComponent(authorSlug)}">${escapeHtml(author)}</a>` : escapeHtml(author)}</p>
					${result?.seriesLabel ? `<p class="meta series-meta">${escapeHtml(result.seriesLabel)}</p>` : ""}
					${bookId > 0 ? `<p class="meta">Already in DogEared</p>` : `<p class="meta">Found through ${result?.source === "open_library" ? "Open Library" : "Google Books"}</p>`}
					${year ? `<p class="meta">Published: ${escapeHtml(year)}</p>` : ""}
					${Number(result?.pageCount || 0) > 0 ? `<p class="meta">Pages: ${Number(result.pageCount).toLocaleString()}</p>` : ""}
					${result?.publisher ? `<p class="meta">Publisher: ${escapeHtml(result.publisher)}</p>` : ""}
					${categories.length > 0 ? `<div class="progressive-chip-row">${categories.map((category) => `<a class="progressive-chip" href="/related?kind=genre&value=${encodeURIComponent(category)}">${escapeHtml(category)}</a>`).join("")}</div>` : ""}
					${description ? `<p class="progressive-description">${escapeHtml(description)}</p>` : ""}
				</div>
			</li>
		`;
	}

	function appendExternalResults(results) {
		if (!(searchResultsRoot instanceof HTMLElement)) return 0;
		const keys = renderedResultKeys();
		const bookIds = renderedBookIds();
		const html = [];
		for (const result of Array.isArray(results) ? results : []) {
			const key = searchResultClientKey(result);
			const bookId = Number(result?.bookId || 0) || 0;
			if (!key || keys.has(key) || (bookId > 0 && bookIds.has(bookId))) continue;
			const rendered = renderProgressiveResult(result);
			if (!rendered) continue;
			keys.add(key);
			if (bookId > 0) bookIds.add(bookId);
			html.push(rendered);
		}
		if (html.length === 0) return 0;
		searchResultsRoot.insertAdjacentHTML("beforeend", html.join(""));
		syncExistingState();
		return html.length;
	}

	function setProgressiveStatus(message, hidden = false) {
		if (!(progressiveStatus instanceof HTMLElement)) return;
		progressiveStatus.textContent = message;
		progressiveStatus.hidden = hidden;
	}

	function setSearchLiveStatus(message) {
		if (!(searchLiveStatus instanceof HTMLElement)) return;
		searchLiveStatus.textContent = message;
	}

	function setSearchLifecycleState(state) {
		if (!(searchPage instanceof HTMLElement)) return;
		searchPage.dataset.searchState = state;
	}

	function setCompletedEmptyState(visible, queryText) {
		if (emptySearchState instanceof HTMLElement) {
			emptySearchState.hidden = !visible;
		}
		if (visible) {
			setSearchLifecycleState("empty");
			setSearchLiveStatus(`No results for ${queryText}.`);
		}
	}

	function renderExternalSearchSkeletons() {
		return Array.from({ length: 4 }, (_, index) => `
			<li class="search-result-skeleton" data-search-skeleton="${index}" aria-hidden="true">
				<span class="search-skeleton-cover"></span>
				<span class="search-skeleton-copy">
					<span class="search-skeleton-line title"></span>
					<span class="search-skeleton-line author"></span>
					<span class="search-skeleton-line meta"></span>
					<span class="search-skeleton-line description"></span>
				</span>
			</li>
		`).join("");
	}

	function showExternalSearchSkeletons() {
		if (!(searchResultsRoot instanceof HTMLElement)) return;
		if (searchResultsRoot.querySelector("[data-search-skeleton]")) return;
		searchResultsRoot.insertAdjacentHTML("beforeend", renderExternalSearchSkeletons());
	}

	function hideExternalSearchSkeletons() {
		if (!(searchResultsRoot instanceof HTMLElement)) return;
		searchResultsRoot.querySelectorAll("[data-search-skeleton]").forEach((node) => node.remove());
	}

	async function loadProgressiveExternalResults() {
		const queryText = String(searchPage?.dataset.query || "").trim();
		if (!queryText || !(searchResultsRoot instanceof HTMLElement)) return;
		setSearchLifecycleState("loading");
		setCompletedEmptyState(false, queryText);
		setSearchLiveStatus("Searching books.");
		if (hasExactLocalTitle(queryText)) {
			const totalCards = searchResultsRoot.querySelectorAll("[data-search-result-key]").length;
			setSearchLifecycleState(totalCards > 0 ? "results" : "empty");
			setSearchLiveStatus(totalCards > 0
				? `${totalCards.toLocaleString()} result${totalCards === 1 ? "" : "s"} found for ${queryText}.`
				: `No results for ${queryText}.`);
			setProgressiveStatus("Showing DogEared catalog matches.", true);
			return;
		}
		externalSearchController?.abort();
		const requestId = ++externalSearchRequestId;
		const controller = new AbortController();
		externalSearchController = controller;
		const params = new URLSearchParams({ q: queryText, page: "1", pageSize: "20", mode: "external" });
		const excludeIds = Array.from(renderedBookIds());
		if (excludeIds.length > 0) params.set("excludeBookIds", excludeIds.join(","));
		setProgressiveStatus("Checking Google Books and Open Library for more matches.");
		const providers = [
			{ id: "google_books", label: "Google Books" },
			{ id: "open_library", label: "Open Library" }
		];
		let appendedTotal = 0;
		let providerFailures = 0;
		let externalSkeletonTimer = window.setTimeout(showExternalSearchSkeletons, 140);
		await Promise.all(providers.map(async (provider) => {
			const providerParams = new URLSearchParams(params);
			providerParams.set("provider", provider.id);
			try {
				const response = await fetch(`/api/books/search?${providerParams.toString()}`, {
					headers: { Accept: "application/json" },
					signal: controller.signal
				});
				const payload = await response.json().catch(() => ({}));
				if (requestId !== externalSearchRequestId) return;
				if (!response.ok) {
					providerFailures += 1;
					return;
				}
				const appended = appendExternalResults(payload?.results || []);
				appendedTotal += appended;
				if (appended > 0) {
					setSearchLifecycleState("loading");
					setCompletedEmptyState(false, queryText);
					setSearchLiveStatus(`Added ${appended.toLocaleString()} more match${appended === 1 ? "" : "es"} from ${provider.label}.`);
					setProgressiveStatus(`Added ${appended.toLocaleString()} more match${appended === 1 ? "" : "es"} from ${provider.label}.`, false);
				}
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				if (requestId === externalSearchRequestId) providerFailures += 1;
			}
		}));
		window.clearTimeout(externalSkeletonTimer);
		hideExternalSearchSkeletons();
		if (requestId !== externalSearchRequestId) return;
		const totalCards = searchResultsRoot.querySelectorAll("[data-search-result-key]").length;
		if (appendedTotal > 0) {
			setSearchLifecycleState("results");
			setCompletedEmptyState(false, queryText);
			setSearchLiveStatus(`${totalCards.toLocaleString()} result${totalCards === 1 ? "" : "s"} found for ${queryText}.`);
			setProgressiveStatus(`Added ${appendedTotal.toLocaleString()} more match${appendedTotal === 1 ? "" : "es"}.`, false);
		} else if (providerFailures > 0 && totalCards === 0) {
			setSearchLifecycleState("error");
			setCompletedEmptyState(false, queryText);
			setSearchLiveStatus("Search results are temporarily unavailable.");
			setProgressiveStatus("More matches are temporarily unavailable.", false);
		} else {
			setCompletedEmptyState(totalCards === 0, queryText);
			if (totalCards > 0) {
				setSearchLifecycleState("results");
				setSearchLiveStatus(`${totalCards.toLocaleString()} result${totalCards === 1 ? "" : "s"} found for ${queryText}.`);
			}
			setProgressiveStatus("", true);
		}
	}

	async function initAuthState() {
		migrateShelfEntriesInPlace();
		const state = await resolveClientAuthState({ ssrAuthenticated: isAuthenticated });
		isAuthenticated = state.authenticated;
		syncExistingState();
	}

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle instanceof HTMLElement) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown instanceof HTMLElement) {
				toggleShelfMenu(dropdown, getShelfDropdowns());
			}
			return;
		}
		const option = target.closest('[data-action="set-shelf"]');
		if (option instanceof HTMLElement) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = resolveShelfDropdownFromTarget(option);
			if (dropdown instanceof HTMLElement) {
				const status = option.dataset.status || "want_to_read";
					void setShelf(dropdown, status);
				closeShelfMenus(getShelfDropdowns());
			}
			return;
		}
		if (isShelfDropdownOrMenuTarget(target)) return;
		closeAllMenus();
	});

	document.querySelector("[data-search-form]")?.addEventListener("submit", () => {
		externalSearchController?.abort();
		externalSearchRequestId += 1;
		hideExternalSearchSkeletons();
		setCompletedEmptyState(false, String(searchPage?.dataset.query || "").trim());
	});

	document.getElementById("left-hand-search")?.addEventListener("input", (event) => {
		const nextQuery = event.target instanceof HTMLInputElement ? event.target.value.trim() : "";
		if (nextQuery !== String(searchPage?.dataset.query || "").trim()) {
			externalSearchController?.abort();
			externalSearchRequestId += 1;
			hideExternalSearchSkeletons();
			setCompletedEmptyState(false, String(searchPage?.dataset.query || "").trim());
		}
	});

	void initAuthState();
	void loadProgressiveExternalResults();
</script>
