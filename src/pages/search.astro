---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import ShelfDropdown from '../components/ShelfDropdown.astro';
import RatingControl from '../components/RatingControl.astro';
import { resolveUserBySession } from '../lib/auth';
import { authorHref } from '../lib/author';
import { getNeonSql } from '../lib/neon';
import { resolveCustomShelfOptions } from '../lib/customShelves';
import { recordPerformanceEventSafe } from '../lib/performanceTelemetry';
import { normalizeSearchResult, summarizeSearchResultForLog, type SearchResult } from '../lib/searchResults';

export const prerender = false;
const pagePerfStartedAt = performance.now();
const pagePerfStages: Record<string, number> = {};
const markPagePerfStage = (stage: string) => {
	pagePerfStages[stage] = Math.round((performance.now() - pagePerfStartedAt) * 10) / 10;
};
const session = await resolveUserBySession(Astro.request);
markPagePerfStage("session_loaded");
const isAuthenticated = !!session?.userId;

type CollectionSearchResult = {
	title: string;
	slug: string;
	subtitle: string;
	description: string;
	heroImage: string;
	category: string;
	bookCount: number;
	featured: boolean;
};

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
let results: SearchResult[] = [];
let collectionResults: CollectionSearchResult[] = [];
let errorMessage = "";
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let viewerRatingByBookId = new Map<number, number>();
let averageRatingByBookId = new Map<number, number>();
let ratingCountByBookId = new Map<number, number>();
let readerCountByBookId = new Map<number, number>();
let shelfEntryCountByBookId = new Map<number, number>();
let customShelfOptionsJson = "[]";
const customShelfOptionsPromise = session?.userId
	? resolveCustomShelfOptions(getNeonSql(), session.userId)
		.then((options) => JSON.stringify(options))
		.catch(() => "[]")
	: Promise.resolve("[]");

function truncateDescription(value: string, maxLength = 280) {
	const text = String(value || "")
		.replace(/<[^>]+>/g, " ")
		.replace(/\s+/g, " ")
		.trim();
	if (!text) return "";
	if (text.length <= maxLength) return text;
	return `${text.slice(0, maxLength).trimEnd()}…`;
}

function publishedYearOnly(value: string) {
	const match = String(value || "").match(/\b(1[0-9]{3}|20[0-9]{2}|2100)\b/);
	return match ? match[1] : "";
}

function searchResultKey(result: SearchResult) {
	const authors = Array.isArray(result.authors) ? result.authors : [];
	const bookId = Number(result.bookId || 0) || 0;
	if (bookId > 0) return `book:${bookId}`;
	const identifier = String(result.googleBooksId || result.isbn13 || result.isbn10 || result.sourceWorkId || result.sourceEditionId || "").trim();
	if (identifier) return `external:${identifier}`;
	return `title:${String(result.title || "").trim().toLowerCase()}|${String(authors[0] || "").trim().toLowerCase()}`;
}

function summarizeRawResultForLog(value: unknown, index: number) {
	if (!value || typeof value !== "object") {
		return { index, valueType: typeof value };
	}
	const record = value as Record<string, unknown>;
	return {
		index,
		source: String(record.source || ""),
		workId: Number(record.bookId || 0) || 0,
		editionId: String(record.isbn13 || record.isbn10 || record.googleBooksId || ""),
		bookId: Number(record.bookId || 0) || 0,
		authorId: Number(record.authorId || 0) || 0,
		title: String(record.title || ""),
		authorsType: Array.isArray(record.authors) ? "array" : typeof record.authors,
		slug: "",
		cover: String(record.thumbnail || ""),
		series: String(record.seriesLabel || record.seriesName || ""),
		genresType: Array.isArray(record.categories) ? "array" : typeof record.categories,
		hasDescription: !!String(record.description || "")
	};
}

if (query) {
	try {
		const endpoint = new URL("/api/books/search", Astro.url);
		endpoint.searchParams.set("q", query);
		endpoint.searchParams.set("page", "1");
		endpoint.searchParams.set("pageSize", "20");
		endpoint.searchParams.set("mode", "local");
		const response = await fetch(endpoint, { headers: { Accept: "application/json" } });
		markPagePerfStage("local_search_loaded");
		if (!response.ok) {
			errorMessage = "Unable to search right now. Please try again in a moment.";
		} else {
			const payload = await response.json();
			const rawResults = Array.isArray(payload?.results) ? payload.results : [];
			results = rawResults
				.map((result, index) => {
					const normalized = normalizeSearchResult(result, { source: "search.page", index, query });
					if (!normalized) {
						console.warn("[search.result.skipped]", {
							query,
							reason: "malformed search result",
							result: summarizeRawResultForLog(result, index)
						});
						return null;
					}
					if (import.meta.env.DEV) {
						console.info("[search.result.renderable]", {
							query,
							result: summarizeSearchResultForLog(normalized, index)
						});
					}
					return normalized;
				})
				.filter((result): result is SearchResult => !!result);
			collectionResults = Array.isArray(payload?.collectionResults) ? payload.collectionResults : [];
			if (results.length > 0) {
				const bookIds = Array.from(new Set(results.map((result) => Number(result.bookId || 0)).filter((value) => value > 0)));
				if (bookIds.length > 0) {
					const sql = getNeonSql();
					const summaryRowsPromise = sql<Array<{ book_id: number; reader_count: number; shelf_entry_count: number; average_rating: number | null; rating_count: number }>>`
						select
							ub.book_id,
							count(distinct ub.user_id)::int as reader_count,
							count(*)::int as shelf_entry_count,
							round(avg(ub.rating)::numeric, 1) as average_rating,
							count(*) filter (where ub.rating is not null)::int as rating_count
						from user_book ub
						where ub.book_id = any(${bookIds}::bigint[])
						group by ub.book_id
					`;
					const statusRowsPromise = session?.userId
						? sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>>`
							select book_id, status, rating
							from user_book
							where user_id = ${session.userId}::uuid
								and book_id = any(${bookIds}::bigint[])
						`
						: Promise.resolve([] as Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>);
					const [summaryRows, statusRows] = await Promise.all([summaryRowsPromise, statusRowsPromise]);
					markPagePerfStage("result_summaries_loaded");
					readerCountByBookId = new Map(summaryRows.map((row) => [Number(row.book_id || 0), Number(row.reader_count || 0)]));
					shelfEntryCountByBookId = new Map(summaryRows.map((row) => [Number(row.book_id || 0), Number(row.shelf_entry_count || 0)]));
					averageRatingByBookId = new Map(
						summaryRows.map((row) => [Number(row.book_id || 0), Number(row.average_rating || 0)])
					);
					ratingCountByBookId = new Map(
						summaryRows.map((row) => [Number(row.book_id || 0), Number(row.rating_count || 0)])
					);
					if (session?.userId) {
						viewerStatusByBookId = new Map(statusRows.map((row) => [Number(row.book_id || 0), row.status]));
						viewerRatingByBookId = new Map(statusRows.map((row) => [
							Number(row.book_id || 0),
							Math.max(0, Math.min(5, Number(row.rating || 0) || 0))
						]));
					}
				}
			}
		}
	} catch (error) {
		errorMessage = error instanceof Error ? error.message : "Unable to search right now. Please try again in a moment.";
		markPagePerfStage("load_failed");
	}
}

customShelfOptionsJson = await customShelfOptionsPromise;
markPagePerfStage("custom_shelves_loaded");

const completedResultCount = results.length + collectionResults.length;
const completionStatus = query && !errorMessage
	? completedResultCount > 0
		? `${completedResultCount.toLocaleString()} result${completedResultCount === 1 ? "" : "s"} found for ${query}. Checking Google Books and Open Library for more matches.`
		: "Searching books."
	: "";
const initialSearchState = !query
	? "idle"
	: errorMessage
		? "error"
		: "loading";

recordPerformanceEventSafe({
	operationName: "page.search",
	route: "/search",
	totalMs: performance.now() - pagePerfStartedAt,
	success: !errorMessage,
	httpStatus: errorMessage ? 500 : 200,
	spans: pagePerfStages,
	metadata: {
		authenticated: isAuthenticated,
		hasQuery: !!query,
		resultCount: results.length,
		collectionCount: collectionResults.length
	}
});
---

<Layout
	title="Search"
	robots="noindex,nofollow"
	metaDescription="Search DogEared for books and add them to your shelves."
	canonicalUrl="/search"
>
		<div
			slot="right"
			class="search-page"
			id="search-page"
			data-guided-anchor="search-page"
			data-query={query}
			data-search-state={initialSearchState}
			data-authenticated={String(isAuthenticated)}
			data-custom-shelves={customShelfOptionsJson}
		>
		<h1>Search</h1>
		{!query && <p>Search for a favorite title, then add it to Want to Read, Currently Reading, or Read to build recommendations.</p>}
		<p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-search-live-status>{completionStatus}</p>
		{query && errorMessage && (
			<div class="search-state search-state-error" role="status">
				<p>{errorMessage}</p>
				<a href="/search">Start a new search</a>
			</div>
		)}
		{query && !errorMessage && results.length === 0 && collectionResults.length === 0 && (
			<div class="search-state" role="status" data-empty-search-state hidden>
				<p>No results for "{query}". Try a broader title, an author name, or fewer keywords.</p>
				<a href="/search">Search again</a>
			</div>
		)}
		{query && !errorMessage && (results.length > 0 || collectionResults.length > 0) && <p>Results for "{query}". Use the shelf button on a card to save books to your Profile.</p>}
		{query && !errorMessage && (
			<p id="search-progressive-status" class="meta" role="status" aria-live="polite" data-search-progressive-status>
				{results.length > 0 || collectionResults.length > 0
					? "Checking Google Books and Open Library for more matches."
					: "Searching DogEared first, then checking Google Books and Open Library."}
			</p>
		)}

		{query && !errorMessage && collectionResults.length > 0 && (
			<section class="collection-search-section" aria-labelledby="collection-search-title">
				<h2 id="collection-search-title">Editorial Collections</h2>
				<ul class="collection-search-results">
					{collectionResults.map((collection) => (
						<li>
							<a href={`/collections/${encodeURIComponent(collection.slug)}`}>
								{collection.heroImage && <img src={collection.heroImage} alt="" loading="lazy" decoding="async" />}
								<span>
									{collection.category && <em>{collection.category}</em>}
									<strong>{collection.title}</strong>
									{collection.subtitle && <small>{collection.subtitle}</small>}
									<small>{collection.description}</small>
									<small>{collection.bookCount.toLocaleString()} book{collection.bookCount === 1 ? "" : "s"}</small>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<ul class="search-results" id="search-results">
			{results.map((result) => (
				(() => {
					const numericBookId = Number(result.bookId || 0);
					const averageRating = Number(averageRatingByBookId.get(numericBookId) || 0);
					const ratingCount = Number(ratingCountByBookId.get(numericBookId) || 0);
					const readerCount = Number(readerCountByBookId.get(numericBookId) || 0);
					const shelfEntryCount = Number(shelfEntryCountByBookId.get(numericBookId) || 0);
					const authors = Array.isArray(result.authors) ? result.authors : [];
					const primaryAuthor = authors[0] || "Unknown author";
					const authorForHref = authors[0] || "";
					const categories = Array.isArray(result.categories) ? result.categories : [];
					return (
				<BookCard
					attrs={{
						'data-search-result-key': searchResultKey(result),
						'data-search-book-id': String(numericBookId || ""),
						'data-search-title': result.title
					}}
					title={result.title}
					titleHref={Number(result.bookId || 0) > 0
						? `/book?bookId=${encodeURIComponent(String(result.bookId || 0))}`
						: `/book?googleBooksId=${encodeURIComponent(result.googleBooksId || "")}&isbn13=${encodeURIComponent(result.isbn13 || "")}&isbn10=${encodeURIComponent(result.isbn10 || "")}&title=${encodeURIComponent(result.title)}&author=${encodeURIComponent(authorForHref)}`}
					author={primaryAuthor}
					authorHref={authorForHref ? authorHref(authorForHref, result.authorId || 0) : ""}
					thumbnail={result.thumbnail}
					description={truncateDescription(result.description)}
					readers={numericBookId > 0 ? readerCount : 0}
					shelfEntries={numericBookId > 0 ? shelfEntryCount : 0}
					publishedLabel={publishedYearOnly(result.publishedDate)}
					pageCount={result.pageCount || 0}
					averageRating={averageRating}
					seriesLabel={result.seriesLabel}
					genres={categories}
				>
						<div slot="meta">
							{numericBookId > 0 && <p class="meta">Already in DogEared</p>}
							{result.publisher && <p class="meta">Publisher: {result.publisher}</p>}
							{Number(result.bookId || 0) > 0 && viewerStatusByBookId.get(Number(result.bookId || 0)) === "finished" && (
								<RatingControl
									bookId={Number(result.bookId || 0)}
									rating={viewerRatingByBookId.get(Number(result.bookId || 0)) || 0}
									editable={true}
								/>
							)}
						</div>
						<div slot="actions">
							<ShelfDropdown attrs={{
								'data-book-id': String(result.bookId || ""),
								'data-title': result.title,
								'data-author': authorForHref,
								'data-description': result.description,
								'data-pages': String(result.pageCount ?? 0),
								'data-cover': result.thumbnail,
								'data-format': result.printType || "Book",
								'data-language': result.language || "",
								'data-publisher': result.publisher || "",
								'data-published-date': result.publishedDate || "",
								'data-isbn10': result.isbn10 || "",
								'data-isbn13': result.isbn13 || "",
								'data-google-books-id': result.googleBooksId || "",
								'data-source': result.source || (result.googleBooksId ? "google_books" : "open_library"),
								'data-source-work-id': result.sourceWorkId || result.googleBooksId || "",
								'data-source-edition-id': result.sourceEditionId || "",
								'data-source-url': result.googleBooksId
									? `https://books.google.com/books?id=${encodeURIComponent(result.googleBooksId)}`
									: (result.sourceWorkId ? `https://openlibrary.org/works/${encodeURIComponent(result.sourceWorkId)}` : ""),
								'data-categories': JSON.stringify(categories),
								'data-custom-shelves': customShelfOptionsJson
							}} />
						</div>
					</BookCard>
					);
				})()
			))}
			{query && !errorMessage && results.length === 0 && collectionResults.length === 0 && Array.from({ length: 4 }).map((_, index) => (
				<li class="search-result-skeleton" data-search-skeleton={String(index)} aria-hidden="true">
					<span class="search-skeleton-cover"></span>
					<span class="search-skeleton-copy">
						<span class="search-skeleton-line title"></span>
						<span class="search-skeleton-line author"></span>
						<span class="search-skeleton-line meta"></span>
						<span class="search-skeleton-line description"></span>
					</span>
				</li>
			))}
		</ul>
		{query && !errorMessage && results.length > 0 && (
			<div id="search-sentinel-wrap">
				<div id="search-sentinel" aria-hidden="true"></div>
				<p id="search-loading" class="meta" hidden>Loading more results...</p>
			</div>
		)}
	</div>
</Layout>

<style>
	.search-page {
		max-width: 900px;
	}

	.search-results {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.search-state {
		display: grid;
		gap: 0.45rem;
		margin-top: 0.7rem;
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: rgba(255, 255, 255, 0.58);
		padding: 0.85rem;
	}
	.search-state[hidden] {
		display: none;
	}
	.search-state p {
		margin: 0;
		color: var(--color-text-muted);
	}
	.search-state a {
		justify-self: start;
		border-radius: var(--radius-pill);
		background: var(--color-primary);
		color: #fff;
		padding: 0.42rem 0.75rem;
		font-weight: 750;
		text-decoration: none;
	}
	.search-state-error {
		border-color: rgba(153, 27, 27, 0.26);
	}

	.collection-search-section {
		margin-top: 1rem;
	}
	.collection-search-section h2 {
		margin: 0 0 0.65rem;
	}
	.collection-search-results {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.collection-search-results a {
		position: relative;
		overflow: hidden;
		min-height: 190px;
		display: grid;
		align-items: end;
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface-raised);
		color: inherit;
		text-decoration: none;
	}
	.collection-search-results img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.26;
	}
	.collection-search-results span {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.22rem;
		padding: 0.85rem;
		background: linear-gradient(to top, rgba(255,255,255,0.96), rgba(255,255,255,0.68));
	}
	.collection-search-results strong {
		font-size: 1.25rem;
		line-height: 1.1;
	}
	.collection-search-results small,
	.collection-search-results em {
		color: var(--color-text-muted);
		font-style: normal;
	}

	#search-sentinel-wrap {
		padding: 0.75rem 0 0.25rem;
	}

	#search-sentinel {
		height: 1px;
	}

	.meta {
		margin: 0.2rem 0;
		color: #4a4a4a;
		font-size: 0.92rem;
	}
	.series-meta {
		color: var(--color-nav);
		font-weight: 700;
	}

	.shelf-dropdown {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		margin-top: 0.4rem;
	}

	.shelf-trigger {
		border: none;
		border-radius: 8px;
		padding: 0.55rem 0.85rem;
		font-size: 0.95rem;
		background: var(--color-primary);
		color: #fff;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.shelf-icon {
		font-size: 1.15rem;
		line-height: 1;
	}

	.shelf-check {
		font-size: 1rem;
		line-height: 1;
		opacity: 0;
		transition: opacity 120ms ease-in-out;
	}

	.shelf-dropdown.is-shelved .shelf-check {
		opacity: 1;
	}

	.shelf-trigger:hover {
		background: var(--color-primary-hover);
	}

	.shelf-menu {
		min-width: 180px;
		background: #fff;
		border: none;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-popover);
		padding: 0.28rem;
	}

	.shelf-option {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		text-align: left;
		border: none;
		background: transparent;
		padding: 0.5rem 0.75rem;
		font-size: 0.92rem;
		cursor: pointer;
		color: var(--color-text);
	}

	.shelf-option:hover {
		background: rgba(87, 117, 144, 0.09);
	}

	.shelf-feedback {
		margin-top: 0.25rem;
		font-size: 0.82rem;
		color: #1f7a45;
		line-height: 1.25;
	}

	.login-confirm-overlay {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100dvh;
		min-height: 100vh;
		background: rgba(0, 0, 0, 0.62);
		z-index: 110;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.login-confirm-dialog {
		width: min(460px, 100%);
		background: #111;
		color: #fff;
		border-radius: var(--radius-lg);
		padding: 1rem;
		box-shadow: var(--shadow-md);
	}

	.login-confirm-dialog p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.45;
	}

	.login-confirm-actions {
		margin-top: 0.95rem;
		display: flex;
		justify-content: flex-end;
		gap: 0.55rem;
	}

	.login-confirm-actions button {
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: transparent;
		color: #d9e3ff;
		font: inherit;
		font-weight: 600;
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		cursor: pointer;
	}

	.login-confirm-actions .confirm {
		background: #2e8f57;
		border-color: #2e8f57;
		color: #fff;
	}

	@media (max-width: 860px) {
		.search-results,
		.collection-search-results {
			grid-template-columns: 1fr;
		}
	}
</style>

<style is:global>
	#search-results .progressive-book-card {
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface-raised);
		padding: 0.68rem;
		position: relative;
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr);
		gap: 0.68rem;
		min-width: 0;
	}
	#search-results .progressive-book-card:hover {
		background: #fff;
		border-color: var(--color-border);
	}
	#search-results .search-result-skeleton {
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: rgba(255, 255, 255, 0.72);
		padding: 0.68rem;
		position: relative;
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr);
		gap: 0.68rem;
		min-width: 0;
		min-height: 154px;
	}
	#search-results .search-skeleton-cover,
	#search-results .search-skeleton-line {
		display: block;
