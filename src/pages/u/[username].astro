---
export const prerender = false;

const username = String(Astro.params.username || "").trim();
if (!username) {
	return Astro.redirect('/');
}
const next = new URL(`/profile/${encodeURIComponent(username)}`, Astro.url);
next.search = Astro.url.search;
return Astro.redirect(`${next.pathname}${next.search}`);
---
