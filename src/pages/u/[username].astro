	function parseProgressInput(rawValue, totalPages) {
		const raw = String(rawValue || "").trim();
		if (!raw) return { valid: false, currentPage: 0, mode: "page", normalizedText: "" };
		const maxPages = Math.max(0, Number(totalPages || 0) || 0);
		if (raw.endsWith("%")) {
			const percentValue = Number(raw.slice(0, -1).trim());
			if (!Number.isFinite(percentValue)) return { valid: false, currentPage: 0, mode: "percent", normalizedText: raw };
			const clampedPercent = Math.max(0, Math.min(100, percentValue));
			const currentPage = maxPages > 0
				? Math.round((clampedPercent / 100) * maxPages)
				: 0;
			return {
				valid: true,
				currentPage,
				mode: "percent",
				normalizedText: `${clampedPercent}%`,
				percent: clampedPercent
			};
		}
		const numericPages = Number(raw);
		if (!Number.isFinite(numericPages)) return { valid: false, currentPage: 0, mode: "page", normalizedText: raw };
		const currentPage = Math.max(0, Math.min(maxPages > 0 ? maxPages : Number.MAX_SAFE_INTEGER, Math.round(numericPages)));
		return {
			valid: true,
			currentPage,
			mode: "page",
			normalizedText: String(currentPage)
		};
	}

	function promptForFinishRating() {
		return new Promise((resolve) => {
			const existing = document.getElementById("finish-rating-overlay");
			if (existing) existing.remove();

			const overlay = document.createElement("div");
			overlay.id = "finish-rating-overlay";
			overlay.className = "finish-rating-overlay";
			Object.assign(overlay.style, {
				position: "fixed",
				inset: "0",
				background: "rgba(0,0,0,0.45)",
				display: "grid",
				placeItems: "center",
				zIndex: "1200",
				padding: "1rem"
			});

			const modal = document.createElement("div");
			modal.className = "finish-rating-modal";
			modal.setAttribute("role", "dialog");
			modal.setAttribute("aria-modal", "true");
			modal.setAttribute("aria-label", "Rate this finished book");
			Object.assign(modal.style, {
				width: "min(460px, 100%)",
				background: "#fff",
				borderRadius: "14px",
				padding: "1rem",
				boxShadow: "0 10px 26px rgba(0,0,0,0.2)"
			});

			const title = document.createElement("p");
			title.className = "finish-rating-title";
			title.textContent = "Rate this book";
			Object.assign(title.style, {
				margin: "0",
				fontSize: "1.75rem",
				fontWeight: "800",
				color: "#1f2937"
			});

			const subtitle = document.createElement("p");
			subtitle.className = "finish-rating-subtitle";
			subtitle.textContent = "";

			const stars = document.createElement("div");
			stars.className = "finish-rating-stars";
			stars.setAttribute("aria-label", "Rating stars");
			Object.assign(stars.style, {
				display: "flex",
				gap: "0.3rem"
			});

			const actions = document.createElement("div");
			actions.className = "finish-rating-actions";
			Object.assign(actions.style, {
				display: "flex",
				justifyContent: "flex-end",
				gap: "0.45rem",
				marginTop: "0.8rem"
			});

			const cancelButton = document.createElement("button");
			cancelButton.type = "button";
			cancelButton.className = "finish-rating-cancel";
			cancelButton.textContent = "Cancel";

			const skipButton = document.createElement("button");
			skipButton.type = "button";
			skipButton.className = "finish-rating-skip";
			skipButton.textContent = "Skip";

			const saveButton = document.createElement("button");
			saveButton.type = "button";
			saveButton.className = "finish-rating-save";
			saveButton.textContent = "Save";
			saveButton.disabled = true;

			let selectedRating = 0;

			const renderStars = (hoverValue = 0) => {
				const active = hoverValue || selectedRating;
				const buttons = stars.querySelectorAll("button");
				buttons.forEach((button, index) => {
					const value = index + 1;
					button.textContent = value <= active ? "★" : "☆";
					button.setAttribute("aria-pressed", value === selectedRating ? "true" : "false");
				});
				saveButton.disabled = selectedRating < 1 || selectedRating > 5;
			};

			const close = (result) => {
				overlay.remove();
				resolve(result);
			};

			for (let i = 1; i <= 5; i += 1) {
				const star = document.createElement("button");
				star.type = "button";
				star.className = "finish-rating-star";
				star.dataset.value = String(i);
				star.setAttribute("aria-label", `${i} star${i === 1 ? "" : "s"}`);
				star.textContent = "☆";
				Object.assign(star.style, {
					border: "none",
					background: "transparent",
					fontSize: "2rem",
					lineHeight: "1",
					padding: "0.1rem",
					color: "#f59e0b",
					cursor: "pointer"
				});
				star.addEventListener("mouseenter", () => renderStars(i));
				star.addEventListener("mouseleave", () => renderStars());
				star.addEventListener("click", () => {
					selectedRating = i;
					renderStars();
				});
				stars.append(star);
			}

			cancelButton.addEventListener("click", () => close({ cancelled: true, rating: null }));
			skipButton.addEventListener("click", () => close({ cancelled: false, rating: null }));
			saveButton.addEventListener("click", () => close({ cancelled: false, rating: selectedRating }));
			Object.assign(cancelButton.style, {
				border: "none",
				borderRadius: "8px",
				height: "34px",
				padding: "0 0.8rem",
				fontWeight: "700",
				background: "#eceff3",
				color: "#1f2937",
				cursor: "pointer"
			});
			Object.assign(skipButton.style, {
				border: "none",
				borderRadius: "8px",
				height: "34px",
				padding: "0 0.8rem",
				fontWeight: "700",
				background: "#f3efe7",
				color: "#374151",
				cursor: "pointer"
			});
			Object.assign(saveButton.style, {
				border: "none",
				borderRadius: "8px",
				height: "34px",
				padding: "0 0.8rem",
				fontWeight: "700",
				background: "var(--color-primary)",
				color: "#fff",
				cursor: "pointer"
			});
			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) close({ cancelled: true, rating: null });
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && document.body.contains(overlay)) close({ cancelled: true, rating: null });
			}, { once: true });

			actions.append(cancelButton, skipButton, saveButton);
			modal.append(title, stars, actions);
			overlay.append(modal);
			document.body.append(overlay);
			renderStars();
		});
	}

