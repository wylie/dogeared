---
import Layout from "../../layouts/Layout.astro";
import BookCard from "../../components/BookCard.astro";
import ShelfDropdown from "../../components/ShelfDropdown.astro";
import Chip from "../../components/Chip.astro";
import RatingControl from "../../components/RatingControl.astro";
import { resolveUserBySession } from "../../lib/auth";
import { getNeonSql } from "../../lib/neon";
import { resolvePublicProfileBundle, resolvePublicRecentActivity, resolvePublicShelfSummary } from "../../lib/publicProfile";
import { authorHref } from "../../lib/author";
import { ensureCustomShelfSchema } from "../../lib/customShelves";

export const prerender = false;

const requestedUsername = String(Astro.params.username || "").trim().toLowerCase();
const session = await resolveUserBySession(Astro.request);
const viewerUserId = String(session?.userId || "");
const editMode = String(Astro.url.searchParams.get("edit") || "").trim() === "1";
const showWelcomeBanner = String(Astro.url.searchParams.get("welcome") || "").trim() === "1";

function normalizeText(value: unknown, maxLength: number) {
	return String(value || "").replace(/\s+/g, " ").trim().slice(0, maxLength);
}

function normalizeUsernameForSave(value: unknown) {
	const raw = normalizeText(value, 40).replace(/^@+/, "").toLowerCase();
	if (!raw) return "";
	return raw.replace(/[^a-z0-9._-]/g, "").slice(0, 40);
}

function normalizeGenres(value: unknown) {
	const parts = String(value || "").split(",");
	const dedupe = new Set<string>();
	const out: string[] = [];
	for (const part of parts) {
		const next = normalizeText(part, 40);
		if (!next) continue;
		const key = next.toLowerCase();
		if (dedupe.has(key)) continue;
		dedupe.add(key);
		out.push(next);
		if (out.length >= 12) break;
	}
	return out;
}

if (Astro.request.method === "POST" && viewerUserId && requestedUsername) {
	const formData = await Astro.request.formData();
	const profileIntent = String(formData.get("profileIntent") || "").trim().toLowerCase();
	if (profileIntent === "save") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId === viewerUserId) {
			const sql = getNeonSql();
			const existingRows = await sql<Array<{ username: string | null; profile_data: unknown }>>`
				select username, profile_data
				from app_user
				where id = ${viewerUserId}::uuid
				limit 1
			`;
			const currentUsername = normalizeUsernameForSave(existingRows[0]?.username);
			const existingProfileData = (existingRows[0]?.profile_data && typeof existingRows[0].profile_data === "object")
				? existingRows[0].profile_data as Record<string, unknown>
				: {};
			const existingSettings = (existingProfileData.settings && typeof existingProfileData.settings === "object")
				? existingProfileData.settings as Record<string, unknown>
				: {};
			const currentAvatar = normalizeText(existingProfileData.avatar, 500000);
			const submittedAvatar = normalizeText(formData.get("avatarUrl"), 500000);
			const nextAvatar = submittedAvatar || currentAvatar;
			let nextUsername = normalizeUsernameForSave(formData.get("username"));
			if (!nextUsername) nextUsername = currentUsername;
			if (nextUsername && nextUsername !== currentUsername) {
				const takenRows = await sql<Array<{ id: string }>>`
					select id
					from app_user
					where lower(username) = lower(${nextUsername})
						and id <> ${viewerUserId}::uuid
					limit 1
				`;
				if (takenRows.length > 0) {
					nextUsername = currentUsername;
				}
			}
			const nextProfile = {
				avatar: nextAvatar,
				name: normalizeText(formData.get("name"), 80),
				username: nextUsername ? `@${nextUsername}` : "",
				location: normalizeText(formData.get("location"), 80),
				readingGoal: normalizeText(formData.get("readingGoal"), 80),
				favoriteBook: normalizeText(formData.get("favoriteBook"), 120),
				favoriteAuthor: normalizeText(formData.get("favoriteAuthor"), 120),
				blurb: normalizeText(formData.get("blurb"), 400),
				genres: normalizeGenres(formData.get("genres")),
				settings: existingSettings
			};
			await sql`
				update app_user
				set
					username = ${nextUsername || null},
					profile_data = ${JSON.stringify(nextProfile)}::jsonb
				where id = ${viewerUserId}::uuid
			`;
			return Astro.redirect(`/u/${encodeURIComponent(nextUsername || requestedUsername)}`);
		}
		return Astro.redirect(`/u/${encodeURIComponent(requestedUsername)}`);
	}
	const followIntent = String(formData.get("followIntent") || "").trim().toLowerCase();
	if (followIntent === "follow" || followIntent === "unfollow") {
		const target = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
		if (target.targetUserId && target.targetUserId !== viewerUserId) {
			const sql = getNeonSql();
			if (followIntent === "follow") {
				await sql`
					insert into user_follow (follower_user_id, followed_user_id)
					values (${viewerUserId}::uuid, ${target.targetUserId}::uuid)
					on conflict (follower_user_id, followed_user_id) do nothing
				`;
			} else {
				await sql`
					delete from user_follow
					where follower_user_id = ${viewerUserId}::uuid
						and followed_user_id = ${target.targetUserId}::uuid
				`;
			}
		}
		return Astro.redirect(`/u/${encodeURIComponent(requestedUsername)}`);
	}
}

let notFound = false;
let privateProfile = false;
let profile = {
	avatar: "",
	name: "",
	location: "",
	readingGoal: "",
	favoriteBook: "",
	favoriteAuthor: "",
	blurb: "",
	genres: [] as string[],
	username: ""
};
let canViewActivity = false;
let shelfStats = { wantToRead: 0, reading: 0, finished: 0, total: 0 };
let recentActivity: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	status: string;
	eventType: string;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	rating: number;
	updatedAt: string;
}> = [];
let currentlyReading: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	googleBooksId: string;
	description: string;
	currentPage: number;
	totalPages: number;
	updatedAt: string;
}> = [];
let wantToReadBooks: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	updatedAt: string;
}> = [];
let finishedBooks: Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	rating: number;
	finishedDate: string;
	updatedAt: string;
}> = [];
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let followState = {
	followersCount: 0,
	followingCount: 0,
	isViewerFollowing: false,
	canFollow: false
};
let isOwnerViewer = false;
let customShelves: Array<{ id: number; name: string; slug: string; icon: string; position: number; bookCount: number }> = [];
let shelfSectionOrderKeys: string[] = [];
let shelfSectionOrderByKey = new Map<string, number>();
let customShelfBooksByShelfId = new Map<number, Array<{
	bookId: number;
	title: string;
	author: string;
	authorId: number;
	thumbnail: string;
	language: string;
	isbn10: string;
	isbn13: string;
	description: string;
	status: string;
	rating: number;
	updatedAt: string;
}>>();
let favoriteBookHref = "";
let favoriteAuthorHref = "";
let ownerProfileData: Record<string, unknown> = {};
const PAGE_SIZE = 12;
const recentPage = Math.max(1, Number(Astro.url.searchParams.get("ra_page") || "1") || 1);
const readingPage = Math.max(1, Number(Astro.url.searchParams.get("cr_page") || "1") || 1);
const wantToReadPage = Math.max(1, Number(Astro.url.searchParams.get("wr_page") || "1") || 1);
const finishedPage = Math.max(1, Number(Astro.url.searchParams.get("rd_page") || "1") || 1);

const bundle = await resolvePublicProfileBundle({ username: requestedUsername, viewerUserId });
if (bundle.status === "not_found") notFound = true;
if (bundle.status === "private") privateProfile = true;
if (bundle.status === "ok" && bundle.profile && bundle.targetUserId) {
	const sql = getNeonSql();
	profile = bundle.profile;
	canViewActivity = bundle.canViewActivity;
	isOwnerViewer = !!viewerUserId && viewerUserId === bundle.targetUserId;
	if (isOwnerViewer) {
		const ownerRows = await sql<Array<{ profile_data: unknown }>>`
			select profile_data
			from app_user
			where id = ${bundle.targetUserId}::uuid
			limit 1
		`;
		ownerProfileData = (ownerRows[0]?.profile_data && typeof ownerRows[0].profile_data === "object")
			? ownerRows[0].profile_data as Record<string, unknown>
			: {};
	}
	followState = {
		followersCount: bundle.followersCount,
		followingCount: bundle.followingCount,
		isViewerFollowing: bundle.isViewerFollowing,
		canFollow: !!viewerUserId && viewerUserId !== bundle.targetUserId
	};
	if (profile.favoriteBook) {
		const favoriteRaw = String(profile.favoriteBook || "").trim();
		let favoriteTitle = favoriteRaw;
		let favoriteAuthor = "";
		const byMatch = favoriteRaw.match(/^(.*?)\s+by\s+(.+)$/i);
		if (byMatch) {
			favoriteTitle = String(byMatch[1] || "").trim();
			favoriteAuthor = String(byMatch[2] || "").trim();
		}
		const favoriteMatch = await sql<Array<{ id: number }>>`
			select b.id
			from book b
			where lower(trim(coalesce(b.title, ''))) = lower(${favoriteTitle})
				and (
					${favoriteAuthor} = ''
					or lower(trim(coalesce(b.primary_author, ''))) = lower(${favoriteAuthor})
				)
			order by b.id desc
			limit 1
		`;
		const bookId = Number(favoriteMatch[0]?.id || 0);
		if (bookId > 0) favoriteBookHref = `/book?bookId=${encodeURIComponent(String(bookId))}`;
		else if (favoriteTitle) {
			favoriteBookHref = `/book?title=${encodeURIComponent(favoriteTitle)}${favoriteAuthor ? `&author=${encodeURIComponent(favoriteAuthor)}` : ""}`;
		}
	}
	if (profile.favoriteAuthor) {
		const favoriteAuthorMatch = await sql<Array<{ id: number }>>`
			select a.id
			from author a
			where lower(trim(coalesce(a.name, ''))) = lower(${profile.favoriteAuthor})
			order by a.id desc
			limit 1
		`;
		const favoriteAuthorId = Number(favoriteAuthorMatch[0]?.id || 0);
		favoriteAuthorHref = authorHref(profile.favoriteAuthor, favoriteAuthorId);
	}
	const [summary, updates, readingRows, wantToReadRows, finishedRows, customShelfRows, customShelfBookRows] = await Promise.all([
		resolvePublicShelfSummary(bundle.targetUserId),
		bundle.canViewActivity ? resolvePublicRecentActivity(bundle.targetUserId, 500) : Promise.resolve([]),
		bundle.canViewActivity
				? sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				google_books_id: string;
				current_page: number;
				total_pages: number;
				updated_at: string;
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					b.google_books_id,
					ub.current_page,
					ub.total_pages,
					ub.updated_at::text as updated_at
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'reading'
				order by ub.updated_at desc
				limit 500
			`
			: Promise.resolve([]),
		bundle.canViewActivity
				? sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				updated_at: string;
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					ub.updated_at::text as updated_at
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'want_to_read'
				order by ub.updated_at desc
				limit 500
			`
			: Promise.resolve([]),
		bundle.canViewActivity
				? sql<Array<{
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
				language: string;
				isbn10: string;
				isbn13: string;
				rating: number | null;
				finished_date: string | null;
				updated_at: string;
			}>>`
				select
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
					b.language,
					b.isbn10,
					b.isbn13,
					ub.rating,
					ub.finished_date::text as finished_date,
					ub.updated_at::text as updated_at
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${bundle.targetUserId}::uuid
					and ub.status = 'finished'
				order by coalesce(ub.finished_date, ub.updated_at) desc
				limit 500
			`
			: Promise.resolve([]),
		isOwnerViewer
			? (async () => {
				await ensureCustomShelfSchema(sql);
				return sql<Array<{ id: number; name: string; slug: string; icon: string; position: number; book_count: number }>>`
					select
						s.id,
						s.name,
						s.slug,
						s.icon,
						s.position,
						coalesce(count(sb.book_id), 0)::int as book_count
					from user_custom_shelf s
					left join user_custom_shelf_book sb
						on sb.shelf_id = s.id
						and sb.user_id = s.user_id
					where s.user_id = ${bundle.targetUserId}::uuid
					group by s.id, s.name, s.slug, s.position
					order by s.position asc, s.id asc
				`;
			})()
			: Promise.resolve([]),
		isOwnerViewer
			? (async () => {
				await ensureCustomShelfSchema(sql);
				return sql<Array<{
					shelf_id: number;
					book_id: number;
					title: string;
					primary_author: string;
					author_id: number | null;
					cover_url: string;
					language: string;
					isbn10: string;
					isbn13: string;
					status: string | null;
					rating: number | null;
					updated_at: string | null;
				}>>`
					select
						sb.shelf_id,
						b.id as book_id,
						b.title,
						b.primary_author,
						b.author_id,
						b.cover_url,
						b.language,
						b.isbn10,
						b.isbn13,
						ub.status,
						ub.rating,
						coalesce(ub.updated_at::text, sb.created_at::text) as updated_at
					from user_custom_shelf_book sb
					join book b on b.id = sb.book_id
					left join user_book ub
						on ub.user_id = sb.user_id
						and ub.book_id = sb.book_id
					where sb.user_id = ${bundle.targetUserId}::uuid
					order by sb.shelf_id asc, coalesce(ub.updated_at, sb.created_at) desc
				`;
			})()
			: Promise.resolve([])
	]);
	shelfStats = summary;
	recentActivity = updates;
	currentlyReading = readingRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		googleBooksId: String(row.google_books_id || "").trim(),
		description: "",
		currentPage: Math.max(0, Number(row.current_page || 0) || 0),
		totalPages: Math.max(0, Number(row.total_pages || 0) || 0),
		updatedAt: String(row.updated_at || "").trim()
	}));
	wantToReadBooks = wantToReadRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		description: "",
		updatedAt: String(row.updated_at || "").trim()
	}));
	finishedBooks = finishedRows.map((row) => ({
		bookId: Number(row.book_id || 0),
		title: String(row.title || "").trim(),
		author: String(row.primary_author || "").trim(),
		authorId: Math.max(0, Number(row.author_id || 0) || 0),
		thumbnail: String(row.cover_url || "").trim(),
		language: String(row.language || "").trim(),
		isbn10: String(row.isbn10 || "").trim(),
		isbn13: String(row.isbn13 || "").trim(),
		description: "",
		rating: Math.max(0, Math.min(5, Number(row.rating || 0) || 0)),
		finishedDate: String(row.finished_date || "").trim(),
		updatedAt: String(row.updated_at || "").trim()
	}));
	customShelves = customShelfRows.map((row) => ({
		id: Math.max(0, Number(row.id || 0) || 0),
		name: String(row.name || "").trim(),
		slug: String(row.slug || "").trim(),
		icon: String(row.icon || "bookmarks").trim() || "bookmarks",
		position: Math.max(0, Number(row.position || 0) || 0),
		bookCount: Math.max(0, Number(row.book_count || 0) || 0)
	})).filter((row) => row.id > 0 && row.name);
	if (isOwnerViewer) {
		const defaultKeys = ["default:reading", "default:want_to_read", "default:finished"];
		const customKeys = customShelves.map((shelf) => `custom:${shelf.id}`);
		const allKeys = [...defaultKeys, ...customKeys];
		const settings = ownerProfileData.settings && typeof ownerProfileData.settings === "object"
			? ownerProfileData.settings as Record<string, unknown>
			: {};
		const storedOrder = Array.isArray(settings.shelfSectionOrder)
			? settings.shelfSectionOrder.map((item) => String(item || "").trim()).filter(Boolean)
			: [];
		const dedupedStored = Array.from(new Set(storedOrder));
		shelfSectionOrderKeys = [
			...dedupedStored.filter((key) => allKeys.includes(key)),
			...allKeys.filter((key) => !dedupedStored.includes(key))
		];
		shelfSectionOrderByKey = new Map(shelfSectionOrderKeys.map((key, index) => [key, index]));
		customShelves = [...customShelves].sort((a, b) => {
			const aOrder = shelfSectionOrderByKey.get(`custom:${a.id}`) ?? Number.MAX_SAFE_INTEGER;
			const bOrder = shelfSectionOrderByKey.get(`custom:${b.id}`) ?? Number.MAX_SAFE_INTEGER;
			return aOrder - bOrder || a.position - b.position || a.id - b.id;
		});
	}
	customShelfBooksByShelfId = customShelfBookRows.reduce((map, row) => {
		const shelfId = Math.max(0, Number(row.shelf_id || 0) || 0);
		const bookId = Math.max(0, Number(row.book_id || 0) || 0);
		if (!shelfId || !bookId) return map;
		const list = map.get(shelfId) || [];
		list.push({
			bookId,
			title: String(row.title || "").trim(),
			author: String(row.primary_author || "").trim(),
			authorId: Math.max(0, Number(row.author_id || 0) || 0),
			thumbnail: String(row.cover_url || "").trim(),
			language: String(row.language || "").trim(),
			isbn10: String(row.isbn10 || "").trim(),
			isbn13: String(row.isbn13 || "").trim(),
			description: "",
			status: String(row.status || "").trim(),
			rating: Math.max(0, Math.min(5, Number(row.rating || 0) || 0)),
			updatedAt: String(row.updated_at || "").trim()
		});
		map.set(shelfId, list);
		return map;
	}, new Map<number, Array<{
		bookId: number;
		title: string;
		author: string;
		authorId: number;
		thumbnail: string;
		language: string;
		isbn10: string;
		isbn13: string;
		description: string;
		status: string;
		rating: number;
		updatedAt: string;
	}>>());
	if (viewerUserId && (recentActivity.length > 0 || currentlyReading.length > 0 || wantToReadBooks.length > 0 || finishedBooks.length > 0 || customShelfBookRows.length > 0)) {
		const bookIds = Array.from(new Set([
			...recentActivity.map((item) => Number(item.bookId || 0)),
			...currentlyReading.map((item) => Number(item.bookId || 0)),
			...wantToReadBooks.map((item) => Number(item.bookId || 0)),
			...finishedBooks.map((item) => Number(item.bookId || 0)),
			...customShelfBookRows.map((item) => Number(item.book_id || 0))
		].filter((value) => value > 0)));
		if (bookIds.length > 0) {
			const rows = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished" }>>`
				select book_id, status
				from user_book
				where user_id = ${viewerUserId}::uuid
					and book_id = any(${bookIds}::bigint[])
			`;
			viewerStatusByBookId = new Map(
				rows.map((row) => [Number(row.book_id || 0), row.status])
			);
		}
	}
}

function activityHeading(eventType: string) {
	const type = String(eventType || "").trim().toLowerCase();
	if (type === "reading") return { prefix: "Added to", shelf: "Currently Reading" };
	if (type === "finished") return { prefix: "Finished Reading", shelf: "" };
	if (type === "want_to_read") return { prefix: "Added to", shelf: "Want to Read" };
	return { prefix: "Added to", shelf: "Shelf" };
}

function renderRatingStars(value: number) {
	const clamped = Math.max(0, Math.min(5, Number(value) || 0));
	return Array.from({ length: 5 }, (_, index) => (index < clamped ? "★" : "☆")).join("");
}

function statusLabel(status: string) {
	const normalized = String(status || "").trim();
	if (normalized === "reading") return "Currently Reading";
	if (normalized === "finished") return "Read";
	if (normalized === "want_to_read") return "Want to Read";
	return "Not on Shelf";
}

function formatActivityDate(value: string) {
	const parsed = new Date(String(value || "").trim());
	if (!Number.isFinite(parsed.getTime())) return "";
	return parsed.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric"
	});
}

function shelfHrefForOwner(sectionId: string) {
	const map: Record<string, string> = {
		want_to_read: "want-to-read",
		reading: "currently-reading",
		finished: "read",
		total: ""
	};
	const target = map[String(sectionId || "").trim()] || "recent-activity";
	return target ? `#${encodeURIComponent(target)}` : "#";
}

function paginate<T>(items: T[], page: number, pageSize: number) {
	const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
	const currentPage = Math.min(Math.max(1, page), totalPages);
	const start = (currentPage - 1) * pageSize;
	return {
		items: items.slice(start, start + pageSize),
		totalPages,
		currentPage
	};
}

function paginationHref(param: string, value: number, anchor: string) {
	const params = new URLSearchParams(Astro.url.searchParams);
	if (value <= 1) params.delete(param);
	else params.set(param, String(value));
	const query = params.toString();
	return `${Astro.url.pathname}${query ? `?${query}` : ""}#${anchor}`;
}

function shelfSectionOrderValue(key: string) {
	const value = shelfSectionOrderByKey.get(String(key || "").trim());
	return Number.isFinite(value as number) ? Number(value) : 999;
}

function shelfSectionOrderStyle(key: string) {
	return `order:${300 + shelfSectionOrderValue(key)}`;
}

const baseSectionLinks = [
	{ id: "about", label: "About" },
	{ id: "shelf-summary", label: "Shelf Summary" },
	...(isOwnerViewer ? [{ id: "custom-shelves", label: "Custom Shelves" }] : []),
	{ id: "recent-activity", label: "Recent Activity" }
];
const orderedShelfSectionLinks = isOwnerViewer
	? [
		{ id: "currently-reading", label: "Currently Reading", key: "default:reading" },
		{ id: "want-to-read", label: "Want to Read", key: "default:want_to_read" },
		{ id: "read", label: "Read", key: "default:finished" },
		...customShelves.map((shelf) => ({
			id: `custom-shelf-${shelf.slug || shelf.id}`,
			label: shelf.name,
			key: `custom:${shelf.id}`
		}))
	]
		.sort((a, b) => shelfSectionOrderValue(String(a.key || "")) - shelfSectionOrderValue(String(b.key || "")))
		.map(({ id, label }) => ({ id, label }))
	: [
		{ id: "currently-reading", label: "Currently Reading" },
		{ id: "want-to-read", label: "Want to Read" },
		{ id: "read", label: "Read" }
	];
const sectionLinks = [...baseSectionLinks, ...orderedShelfSectionLinks];
const customShelfOptionsJson = JSON.stringify(customShelves.map((shelf) => ({
	id: shelf.id,
	name: shelf.name,
	icon: shelf.icon
})));

const pagedRecent = paginate(recentActivity, recentPage, PAGE_SIZE);
const pagedReading = paginate(currentlyReading, readingPage, PAGE_SIZE);
const pagedWantToRead = paginate(wantToReadBooks, wantToReadPage, PAGE_SIZE);
const pagedFinished = paginate(finishedBooks, finishedPage, PAGE_SIZE);
const shelfSectionOrderJson = JSON.stringify(
	shelfSectionOrderKeys.length > 0
		? shelfSectionOrderKeys
		: ["default:reading", "default:want_to_read", "default:finished", ...customShelves.map((shelf) => `custom:${shelf.id}`)]
);
const profileCanonicalUrl = profile.username ? `/u/${encodeURIComponent(profile.username)}` : `/u/${encodeURIComponent(requestedUsername)}`;
const profileRobots = (!notFound && !privateProfile && !!profile.username) ? "index,follow" : "noindex,nofollow";
const profileDescription = !notFound && !privateProfile
	? `${profile.name || `@${profile.username}`}'s reading profile on Dogeared. ${shelfStats.total.toLocaleString()} books across shelves.`
	: "Reader profile on Dogeared.";
const profileStructuredData = (!notFound && !privateProfile && !!profile.username)
	? JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Person",
		name: profile.name || `@${profile.username}`,
		alternateName: `@${profile.username}`,
		description: profile.blurb || undefined,
		url: profileCanonicalUrl,
		image: profile.avatar || undefined
	})
	: "";
const profileBreadcrumbStructuredData = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: "/" },
		...(profile.username ? [{ "@type": "ListItem", position: 2, name: `@${profile.username}`, item: profileCanonicalUrl }] : [{ "@type": "ListItem", position: 2, name: "Profile", item: profileCanonicalUrl }])
	]
});
const profileStructuredDataPayload = profileStructuredData
	? JSON.stringify([JSON.parse(profileStructuredData), JSON.parse(profileBreadcrumbStructuredData)])
	: "";
---

<Layout
	title={profile.username ? `${profile.username} • Profile` : "Profile"}
	sectionLinks={sectionLinks}
	metaDescription={profileDescription}
	canonicalUrl={profileCanonicalUrl}
	robots={profileRobots}
	structuredData={profileStructuredDataPayload}
>
	<div slot="right" class="public-profile-page" data-shelf-section-order={shelfSectionOrderJson}>
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			{profile.username ? (
				<>
					<span>Profile</span>
					<span aria-hidden="true">/</span>
					<span>@{profile.username}</span>
				</>
			) : <span>Profile</span>}
		</nav>
		{notFound && (
			<section class="state-card">
				<h1>Profile not found</h1>
				<p>That username does not exist.</p>
			</section>
		)}
		{!notFound && privateProfile && (
			<section class="state-card">
				<h1>@{requestedUsername}</h1>
				<p>This profile is private.</p>
			</section>
		)}
		{!notFound && !privateProfile && (
			<>
				{showWelcomeBanner && (
					<section class="welcome-banner" role="status" aria-live="polite">
						<p><strong>Welcome to Dogeared.</strong> Your account setup is complete and your profile is live.</p>
						<button type="button" id="dismiss-welcome-banner" class="welcome-banner-dismiss">Dismiss</button>
					</section>
				)}
				<section id="about" class="profile-card">
					{isOwnerViewer && (
						<div class="profile-card-actions">
							<div class="profile-actions-menu-wrap" data-profile-actions-menu>
								<button
									type="button"
									class="profile-actions-menu-trigger"
									data-action="toggle-profile-actions-menu"
									aria-expanded="false"
									aria-label="Profile actions"
								>
									<span class="material-icons" aria-hidden="true">more_vert</span>
								</button>
								<div class="profile-actions-menu" hidden>
									<a class="profile-actions-menu-item" href={`/u/${encodeURIComponent(profile.username)}?edit=1`}>
										{editMode ? "Editing..." : "Edit Profile"}
									</a>
								</div>
							</div>
						</div>
					)}
					<div class="profile-head">
						<div class="avatar-wrap" aria-hidden="true">
							{profile.avatar ? (
								<img
									src={profile.avatar}
									alt=""
									class="avatar"
									onerror="this.outerHTML='<div class=&quot;avatar-fallback&quot; aria-hidden=&quot;true&quot;>@</div>';"
								/>
							) : (
								<div class="avatar-fallback">@</div>
							)}
						</div>
						<div>
							<h1>{profile.name || `@${profile.username}`}</h1>
							<p class="username">@{profile.username}</p>
							<p class="meta">Followers: <span id="follow-count-followers">{followState.followersCount}</span> · Following: <span id="follow-count-following">{followState.followingCount}</span></p>
						</div>
					</div>
					{followState.canFollow && (
						<div class="follow-actions">
							<form method="post" action={`/u/${encodeURIComponent(profile.username)}`}>
								<input type="hidden" name="followIntent" value={followState.isViewerFollowing ? "unfollow" : "follow"} />
								<button
									id="follow-toggle"
									type="submit"
									data-username={profile.username}
									data-following={String(followState.isViewerFollowing)}
								>
									{followState.isViewerFollowing ? "Following" : "Follow"}
								</button>
							</form>
							<p id="follow-feedback" class="meta" hidden></p>
						</div>
					)}
					{isOwnerViewer && editMode ? (
						<form method="post" action={`/u/${encodeURIComponent(profile.username)}?edit=1`} class="inline-profile-form">
							<input type="hidden" name="profileIntent" value="save" />
							<label>Name<input type="text" name="name" maxlength="80" value={profile.name || ""} required /></label>
							<label>Username<input type="text" name="username" maxlength="40" value={profile.username ? `@${profile.username}` : ""} required /></label>
							<label>Avatar URL<input type="text" name="avatarUrl" maxlength="500000" value={profile.avatar || ""} /></label>
							<label>Upload Avatar<input type="file" name="avatarFile" accept="image/*" data-avatar-file /></label>
							<label>Location<input type="text" name="location" maxlength="80" value={profile.location || ""} /></label>
							<label>Reading goal<input type="text" name="readingGoal" maxlength="80" value={profile.readingGoal || ""} /></label>
							<label>Favorite book<input type="text" name="favoriteBook" maxlength="120" value={profile.favoriteBook || ""} /></label>
							<label>Favorite author<input type="text" name="favoriteAuthor" maxlength="120" value={profile.favoriteAuthor || ""} /></label>
							<label class="full-width">Blurb<textarea name="blurb" rows={3} maxlength={400}>{profile.blurb || ""}</textarea></label>
							<label class="full-width">Genres (comma separated)<input type="text" name="genres" value={profile.genres.join(", ")} /></label>
							<div class="inline-profile-actions">
								<button type="submit">Save Profile</button>
								<a class="secondary" href={`/u/${encodeURIComponent(profile.username)}`}>Cancel</a>
							</div>
						</form>
					) : (
						<>
							{profile.blurb && <p class="blurb">{profile.blurb}</p>}
							<div class="meta-grid">
								{profile.location && <p><strong>Location:</strong> {profile.location}</p>}
								{profile.readingGoal && <p><strong>Reading goal:</strong> {profile.readingGoal}</p>}
								{profile.favoriteBook && (
									<p>
										<strong>Favorite book:</strong>{" "}
										<a class="author-link" href={favoriteBookHref || `/book?title=${encodeURIComponent(profile.favoriteBook)}`}>{profile.favoriteBook}</a>
									</p>
								)}
								{profile.favoriteAuthor && (
									<p>
										<strong>Favorite author:</strong>{" "}
										{favoriteAuthorHref
											? <a class="author-link" href={favoriteAuthorHref}>{profile.favoriteAuthor}</a>
											: profile.favoriteAuthor}
									</p>
								)}
							</div>
							{profile.genres.length > 0 && (
								<ul class="genre-list">
									{profile.genres.map((genre) => (
										<li>
											<Chip
												label={genre}
												className="genre-chip"
												href={`/related?kind=genre&value=${encodeURIComponent(genre)}`}
											/>
										</li>
									))}
								</ul>
							)}
						</>
					)}
				</section>

				<section id="shelf-summary" class="shelf-card">
					<h2>Shelf Summary</h2>
					<div class="shelf-summary-grid">
						<a class="shelf-summary-item" href={shelfHrefForOwner("reading")}>
							<p class="shelf-summary-label">
								<span class="material-icons shelf-summary-icon" aria-hidden="true">menu_book</span>
								<span>Currently Reading</span>
							</p>
							<p class="shelf-summary-value">{shelfStats.reading}</p>
						</a>
						<a class="shelf-summary-item" href={shelfHrefForOwner("want_to_read")}>
							<p class="shelf-summary-label">
								<span class="material-icons shelf-summary-icon" aria-hidden="true">add</span>
								<span>Want to Read</span>
							</p>
							<p class="shelf-summary-value">{shelfStats.wantToRead}</p>
						</a>
						<a class="shelf-summary-item" href={shelfHrefForOwner("finished")}>
							<p class="shelf-summary-label">
								<span class="material-icons shelf-summary-icon" aria-hidden="true">check</span>
								<span>Read</span>
							</p>
							<p class="shelf-summary-value">{shelfStats.finished}</p>
						</a>
						<div class="shelf-summary-item shelf-summary-item-total" role="group" aria-label="Total books">
							<p class="shelf-summary-label">
								<span class="material-icons shelf-summary-icon" aria-hidden="true">library_books</span>
								<span>Total</span>
							</p>
							<p class="shelf-summary-value">{shelfStats.total}</p>
						</div>
					</div>
				</section>

				{isOwnerViewer && (
					<section id="custom-shelves" class="activity-card activity-card-plain custom-shelves-section">
						<h2>Custom Shelves</h2>
						<p class="meta">Create shelves for your own groupings and assign books from each book card menu.</p>
						<form class="custom-shelf-create" data-custom-shelf-create>
							<input type="text" name="name" maxlength="60" placeholder="New shelf name" required />
							<button type="submit">Create shelf</button>
						</form>
						<p class="meta custom-shelf-feedback" data-custom-shelf-feedback hidden></p>
						<div class="custom-shelf-list" data-custom-shelf-list>
							{customShelves.length === 0 && <p class="custom-shelf-empty">No custom shelves yet.</p>}
						</div>
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && customShelves.map((shelf) => (
					<section
						id={`custom-shelf-${shelf.slug || shelf.id}`}
						class="custom-shelf-books-section"
						data-custom-shelf-row
						data-shelf-section-key={`custom:${shelf.id}`}
						data-shelf-id={String(shelf.id)}
						style={shelfSectionOrderStyle(`custom:${shelf.id}`)}
					>
						<div class="custom-shelf-heading-row">
							<h3><span class="material-icons custom-shelf-heading-icon" aria-hidden="true">{shelf.icon}</span>{shelf.name}</h3>
							<div class="custom-shelf-menu-wrap">
								<button
									type="button"
									class="custom-shelf-menu-trigger"
									data-action="toggle-custom-shelf-menu"
									aria-expanded="false"
									aria-label={`Actions for ${shelf.name}`}
								>
									<span class="material-icons" aria-hidden="true">more_vert</span>
								</button>
								<div class="custom-shelf-menu" hidden>
									<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up">Move up</button>
									<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down">Move down</button>
									<button type="button" class="custom-shelf-menu-item" data-action="change-custom-shelf-icon" data-current-icon={shelf.icon}>Change icon</button>
									<button type="button" class="custom-shelf-menu-item" data-action="rename-custom-shelf">Rename</button>
									<button type="button" class="custom-shelf-menu-item danger" data-action="delete-custom-shelf">Delete</button>
								</div>
							</div>
						</div>
						<p class="meta custom-shelf-count">{shelf.bookCount} {shelf.bookCount === 1 ? "book" : "books"}</p>
						{(customShelfBooksByShelfId.get(shelf.id) || []).length === 0 ? (
							<p class="meta">No books on this shelf yet.</p>
						) : (
							<ul class="activity-grid">
								{(customShelfBooksByShelfId.get(shelf.id) || []).map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
										thumbnail={item.thumbnail}
									>
										<p slot="preTitle" class="meta activity-headline">
											<span class="activity-prefix">
												{shelf.name}
											</span>
											{formatActivityDate(item.updatedAt) && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="meta">
											{item.rating > 0 && <p class="meta rating-meta">{renderRatingStars(item.rating)} {item.rating}/5</p>}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": "",
												"data-display-icon": shelf.icon,
												"data-current-custom-shelf-id": String(shelf.id),
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": "0",
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
					</section>
				))}

				{(canViewActivity || isOwnerViewer) && (
					<section id="recent-activity" class="activity-card activity-card-plain">
						<h2>Recent Activity</h2>
						{pagedRecent.items.length === 0 ? (
							<p>No recent activity.</p>
						) : (
							<ul class="activity-grid">
								{pagedRecent.items.map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
										thumbnail={item.thumbnail}
									>
										<p slot="preTitle" class="meta activity-headline">
											<span class="activity-prefix">{activityHeading(item.eventType).prefix}</span>
											{activityHeading(item.eventType).shelf && <>&nbsp;<em>{activityHeading(item.eventType).shelf}</em></>}
											{formatActivityDate(item.updatedAt) && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="meta">
											{String(item.eventType || "").trim().toLowerCase() === "finished" && (
												isOwnerViewer ? (
													<RatingControl bookId={item.bookId} rating={item.rating} editable={true} />
												) : (
													item.rating > 0 && <p class="meta rating-meta">{renderRatingStars(item.rating)} {item.rating}/5</p>
												)
											)}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": "0",
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
						{pagedRecent.totalPages > 1 && (
							<div class="section-pagination">
								<a class="owner-edit-link" href={paginationHref("ra_page", pagedRecent.currentPage - 1, "recent-activity")} aria-disabled={pagedRecent.currentPage <= 1}>Previous</a>
								<span>Page {pagedRecent.currentPage} of {pagedRecent.totalPages}</span>
								<a class="owner-edit-link" href={paginationHref("ra_page", pagedRecent.currentPage + 1, "recent-activity")} aria-disabled={pagedRecent.currentPage >= pagedRecent.totalPages}>Next</a>
							</div>
						)}
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && (
					<section
						id="currently-reading"
						class="activity-card activity-card-plain currently-reading-section"
						data-shelf-section-key="default:reading"
						style={shelfSectionOrderStyle("default:reading")}
					>
						<div class="custom-shelf-heading-row">
							<h2>Currently Reading</h2>
							{isOwnerViewer && (
								<div class="custom-shelf-menu-wrap">
									<button type="button" class="custom-shelf-menu-trigger" data-action="toggle-custom-shelf-menu" aria-expanded="false" aria-label="Actions for Currently Reading">
										<span class="material-icons" aria-hidden="true">more_vert</span>
									</button>
									<div class="custom-shelf-menu" hidden>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up">Move up</button>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down">Move down</button>
									</div>
								</div>
							)}
						</div>
						{pagedReading.items.length === 0 ? (
							<p>No books are currently marked as reading.</p>
						) : (
							<ul class="activity-grid currently-reading-grid">
								{pagedReading.items.map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
										thumbnail={item.thumbnail}
									>
										<p slot="preTitle" class="meta activity-headline">
											<span class="activity-prefix">Currently Reading</span>
											{formatActivityDate(item.updatedAt) && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="meta" class="reading-progress-block">
											{item.totalPages > 0 && (
												<>
													<p class="meta progress-current-value">
														Progress: {item.currentPage}/{item.totalPages} pages ({Math.max(0, Math.min(100, Math.round((item.currentPage / Math.max(1, item.totalPages)) * 100)))}%)
													</p>
													<div class="progress-track" aria-hidden="true">
														<div
															class="progress-fill"
															style={`width:${Math.max(0, Math.min(100, Math.round((item.currentPage / Math.max(1, item.totalPages)) * 100)))}%`}
														></div>
													</div>
												</>
											)}
											{isOwnerViewer && (
												<div class="progress-inline">
													<label class="progress-inline-label" for={`progress-inline-${item.bookId}`}>Update progress (page or %)</label>
													<div class="progress-inline-controls">
														<input
															id={`progress-inline-${item.bookId}`}
															class="progress-inline-input"
															type="text"
															inputmode="text"
															placeholder="154 or 31%"
															value=""
														/>
														<button
															type="button"
															class="progress-inline-save"
															data-action="save-reading-progress"
															data-book-id={String(item.bookId || 0)}
															data-title={item.title}
															data-author={item.author}
															data-description={item.description}
															data-cover={item.thumbnail}
															data-language={item.language}
															data-isbn10={item.isbn10}
															data-isbn13={item.isbn13}
															data-google-books-id={item.googleBooksId}
															data-total-pages={String(Math.max(0, Number(item.totalPages || 0)))}
														>
															Save
														</button>
														<button
															type="button"
															class="progress-inline-finish"
															data-action="mark-finished-quick"
															data-book-id={String(item.bookId || 0)}
															data-title={item.title}
															data-author={item.author}
															data-description={item.description}
															data-cover={item.thumbnail}
															data-language={item.language}
															data-isbn10={item.isbn10}
															data-isbn13={item.isbn13}
															data-google-books-id={item.googleBooksId}
															data-total-pages={String(Math.max(0, Number(item.totalPages || 0)))}
															data-current-page={String(Math.max(0, Number(item.currentPage || 0)))}
															aria-label="Mark as Finished"
															title="Mark as Finished"
														>
															<span class="material-icons" aria-hidden="true">done_all</span>
														</button>
													</div>
												</div>
											)}
										</div>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": String(item.totalPages || 0),
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
						{pagedReading.totalPages > 1 && (
							<div class="section-pagination">
								<a class="owner-edit-link" href={paginationHref("cr_page", pagedReading.currentPage - 1, "currently-reading")} aria-disabled={pagedReading.currentPage <= 1}>Previous</a>
								<span>Page {pagedReading.currentPage} of {pagedReading.totalPages}</span>
								<a class="owner-edit-link" href={paginationHref("cr_page", pagedReading.currentPage + 1, "currently-reading")} aria-disabled={pagedReading.currentPage >= pagedReading.totalPages}>Next</a>
							</div>
						)}
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && (
					<section id="want-to-read" class="activity-card activity-card-plain" data-shelf-section-key="default:want_to_read" style={shelfSectionOrderStyle("default:want_to_read")}>
						<div class="custom-shelf-heading-row">
							<h2>Want to Read</h2>
							{isOwnerViewer && (
								<div class="custom-shelf-menu-wrap">
									<button type="button" class="custom-shelf-menu-trigger" data-action="toggle-custom-shelf-menu" aria-expanded="false" aria-label="Actions for Want to Read">
										<span class="material-icons" aria-hidden="true">more_vert</span>
									</button>
									<div class="custom-shelf-menu" hidden>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up">Move up</button>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down">Move down</button>
									</div>
								</div>
							)}
						</div>
						{pagedWantToRead.items.length === 0 ? (
							<p>No books in Want to Read yet.</p>
						) : (
							<ul class="activity-grid">
								{pagedWantToRead.items.map((item) => (
									<BookCard
										title={item.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(item.bookId || 0))}`}
										author={item.author}
										authorHref={item.author ? authorHref(item.author, item.authorId) : ""}
										thumbnail={item.thumbnail}
									>
										<p slot="preTitle" class="meta activity-headline">
											<span class="activity-prefix">Want to Read</span>
											{formatActivityDate(item.updatedAt) && (
												<>
													<br />
													<span class="activity-date">Updated {formatActivityDate(item.updatedAt)}</span>
												</>
											)}
										</p>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-custom-shelves": customShelfOptionsJson,
												"data-book-id": String(item.bookId || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(item.bookId || 0)) || "",
												"data-title": item.title,
												"data-author": item.author,
												"data-description": item.description,
												"data-pages": "0",
												"data-cover": item.thumbnail,
												"data-format": "Book",
												"data-language": item.language,
												"data-isbn10": item.isbn10,
												"data-isbn13": item.isbn13
											}} />
										</div>
									</BookCard>
								))}
							</ul>
						)}
						{pagedWantToRead.totalPages > 1 && (
							<div class="section-pagination">
								<a class="owner-edit-link" href={paginationHref("wr_page", pagedWantToRead.currentPage - 1, "want-to-read")} aria-disabled={pagedWantToRead.currentPage <= 1}>Previous</a>
								<span>Page {pagedWantToRead.currentPage} of {pagedWantToRead.totalPages}</span>
								<a class="owner-edit-link" href={paginationHref("wr_page", pagedWantToRead.currentPage + 1, "want-to-read")} aria-disabled={pagedWantToRead.currentPage >= pagedWantToRead.totalPages}>Next</a>
							</div>
						)}
					</section>
				)}

				{(canViewActivity || isOwnerViewer) && (
					<section id="read" class="activity-card activity-card-plain" data-shelf-section-key="default:finished" style={shelfSectionOrderStyle("default:finished")}>
						<div class="custom-shelf-heading-row">
							<h2>Read</h2>
							{isOwnerViewer && (
								<div class="custom-shelf-menu-wrap">
									<button type="button" class="custom-shelf-menu-trigger" data-action="toggle-custom-shelf-menu" aria-expanded="false" aria-label="Actions for Read">
										<span class="material-icons" aria-hidden="true">more_vert</span>
									</button>
									<div class="custom-shelf-menu" hidden>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-up">Move up</button>
										<button type="button" class="custom-shelf-menu-item" data-action="move-shelf-section-down">Move down</button>
									</div>
								</div>
							)}
						</div>
						{pagedFinished.items.length === 0 ? (
							<p>No finished books yet.</p>
