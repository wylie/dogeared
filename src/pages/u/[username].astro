	}
	.shelf-dropdown { position: relative; display: inline-flex; flex-direction: column; align-items: flex-start; min-width: 150px; }
	.shelf-trigger { border: none; border-radius: 8px; padding: 0.55rem 0.85rem; font-size: 0.95rem; background: var(--color-primary); color: #fff; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; }
	.shelf-trigger:hover { background: var(--color-primary-hover); }
	.shelf-icon { font-size: 1.15rem; line-height: 1; }
	.shelf-check { font-size: 1rem; line-height: 1; opacity: 0; transition: opacity 120ms ease-in-out; }
	.shelf-dropdown.is-shelved .shelf-check { opacity: 1; }
	.shelf-menu { position: absolute; top: calc(100% + 4px); right: 0; left: auto; min-width: 180px; background: #fff; border: 1px solid #c9c9c9; border-radius: 8px; box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12); padding: 0.25rem 0; z-index: 25; }
	.shelf-option { display: flex; align-items: center; gap: 0.45rem; width: 100%; text-align: left; border: none; background: transparent; padding: 0.5rem 0.75rem; font-size: 0.92rem; cursor: pointer; color: #222; }
	.shelf-option:hover { background: #f2f2f2; }
	.shelf-feedback { margin-top: 0.25rem; font-size: 0.82rem; color: #1f7a45; line-height: 1.25; }
	.finish-rating-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.45);
		display: grid;
		place-items: center;
		z-index: 1200;
		padding: 1rem;
	}
	.finish-rating-modal {
		width: min(460px, 100%);
		background: #fff;
		border-radius: 14px;
		padding: 1rem;
		box-shadow: 0 10px 26px rgba(0, 0, 0, 0.2);
	}
	.finish-rating-title {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 800;
		color: #1f2937;
	}
	.finish-rating-subtitle {
		margin: 0.2rem 0 0.75rem;
		color: #5b6470;
		font-size: 0.9rem;
	}
	.finish-rating-stars {
		display: flex;
		gap: 0.3rem;
	}
	.finish-rating-star {
		border: none;
		background: transparent;
		font-size: 2rem;
		line-height: 1;
		padding: 0.1rem;
		color: #f59e0b;
		cursor: pointer;
	}
	.finish-rating-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.45rem;
		margin-top: 0.8rem;
	}
	.finish-rating-cancel,
	.finish-rating-skip,
	.finish-rating-save {
		border: none;
		border-radius: 8px;
		height: 34px;
		padding: 0 0.8rem;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.finish-rating-cancel {
		background: #eceff3;
		color: #1f2937;
	}
	.finish-rating-skip {
		background: #f3efe7;
		color: #374151;
	}
	.finish-rating-save {
		background: var(--color-primary);
		color: #fff;
	}
	.finish-rating-save:disabled {
		opacity: 0.7;
		cursor: default;
	}
	.public-profile-page :global(.shelf-state) { display: none !important; }
	.status { text-transform: capitalize; }
	@media (max-width: 740px) {
		.meta-grid { grid-template-columns: 1fr; }
		.inline-profile-form { grid-template-columns: 1fr; }
		.shelf-summary-grid { grid-template-columns: 1fr; }
		.shelf-summary-item-total { grid-column: auto; }
		.activity-grid { grid-template-columns: 1fr; }
		.profile-card-actions { position: static; margin-bottom: 0.6rem; justify-content: flex-start; }
	}
</style>

<script>
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		toggleShelfMenu
	} from "../../lib/shelfClient.ts";
	import {
		loadShelfEntries,
		migrateShelfEntriesInPlace
	} from "../../lib/shelfStorage.ts";
	const followToggle = document.getElementById("follow-toggle");
	const followFeedback = document.getElementById("follow-feedback");
	const dismissWelcomeBanner = document.getElementById("dismiss-welcome-banner");
	const followersCountNode = document.getElementById("follow-count-followers");
	const followingCountNode = document.getElementById("follow-count-following");
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const feedbackTimers = new WeakMap();

	dismissWelcomeBanner?.addEventListener("click", () => {
		const url = new URL(window.location.href);
		url.searchParams.delete("welcome");
		const next = `${url.pathname}${url.searchParams.toString() ? `?${url.searchParams.toString()}` : ""}${url.hash}`;
		window.history.replaceState({}, "", next);
		const banner = dismissWelcomeBanner.closest(".welcome-banner");
		if (banner instanceof HTMLElement) banner.hidden = true;
	});

	function normalizeText(value) {
		return String(value || "").trim().toLowerCase();
	}

	function canonicalizeTitle(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/\([^)]*\)/g, " ")
			.replace(/\b(abridged|unabridged|audio ?book|audiobook|kindle edition|paperback|hardcover|ebook|e-book|digital edition|color edition)\b/g, " ")
			.split(":")[0]
			.replace(/^(the|a|an)\s+/g, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function canonicalizeAuthor(value) {
		return normalizeText(value)
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/^(by\s+)/, "")
			.replace(/[^a-z0-9\s]/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function findEntry(entries, input) {
		const bookId = Number(input?.bookId || 0);
		if (bookId > 0) {
			const byBookId = entries.find((entry) => Number(entry?.bookId || 0) === bookId);
			if (byBookId) return byBookId;
		}
		const isbn13 = normalizeText(input?.isbn13 || "");
		const isbn10 = normalizeText(input?.isbn10 || "");
		const googleBooksId = normalizeText(input?.googleBooksId || "");
		if (isbn13 || isbn10 || googleBooksId) {
			const byIdentifier = entries.find((entry) => {
				const entryIsbn13 = normalizeText(entry?.isbn13 || "");
				const entryIsbn10 = normalizeText(entry?.isbn10 || "");
				const entryGoogleBooksId = normalizeText(entry?.googleBooksId || "");
				if (isbn13 && entryIsbn13 && isbn13 === entryIsbn13) return true;
				if (isbn10 && entryIsbn10 && isbn10 === entryIsbn10) return true;
				if (googleBooksId && entryGoogleBooksId && googleBooksId === entryGoogleBooksId) return true;
				return false;
			});
			if (byIdentifier) return byIdentifier;
		}
		const t = canonicalizeTitle(input?.title || "");
		const a = canonicalizeAuthor(input?.author || "");
		return entries.find((entry) => (
			canonicalizeTitle(entry?.title) === t && canonicalizeAuthor(entry?.author) === a
		));
	}

	function syncExistingState() {
		const entries = loadShelfEntries();
		for (const dropdown of shelfDropdowns) {
			const seededStatus = String(dropdown.dataset.initialStatus || "").trim();
			let appliedSeed = false;
			if (seededStatus === "want_to_read" || seededStatus === "reading" || seededStatus === "finished") {
				setDropdownLabel(dropdown, seededStatus);
				setShelvedState(dropdown, true);
				appliedSeed = true;
			}
			const existing = findEntry(entries, {
				bookId: Number(dropdown.dataset.bookId || 0),
				title: String(dropdown.dataset.title || ""),
				author: String(dropdown.dataset.author || ""),
				isbn10: String(dropdown.dataset.isbn10 || ""),
				isbn13: String(dropdown.dataset.isbn13 || ""),
				googleBooksId: String(dropdown.dataset.googleBooksId || "")
			});
			if (existing) {
				setDropdownLabel(dropdown, String(existing.status || "want_to_read"));
				setShelvedState(dropdown, true);
			} else if (!appliedSeed) {
				setDropdownLabel(dropdown, "want_to_read");
				setShelvedState(dropdown, false);
			}
		}
	}

	async function hydrateShelfEntriesFromServer() {
		try {
			const response = await fetch("/api/shelf/entries");
			if (!response.ok) return;
			const data = await response.json().catch(() => ({}));
			if (!Array.isArray(data?.entries)) return;
			localStorage.setItem("dogeared:myreads", JSON.stringify(data.entries));
		} catch {
			// Keep local data if network hydration fails.
		}
	}
	function setFollowFeedback(message, isError = false) {
		if (!(followFeedback instanceof HTMLElement)) return;
		followFeedback.textContent = message;
		followFeedback.hidden = !message;
		followFeedback.style.color = isError ? "#991b1b" : "";
	}

	function parseProgressInput(rawValue, totalPages) {
		const raw = String(rawValue || "").trim();
		if (!raw) return { valid: false, currentPage: 0, mode: "page", normalizedText: "" };
		const maxPages = Math.max(0, Number(totalPages || 0) || 0);
		if (raw.endsWith("%")) {
			const percentValue = Number(raw.slice(0, -1).trim());
			if (!Number.isFinite(percentValue)) return { valid: false, currentPage: 0, mode: "percent", normalizedText: raw };
			const clampedPercent = Math.max(0, Math.min(100, percentValue));
			const currentPage = maxPages > 0
				? Math.round((clampedPercent / 100) * maxPages)
				: 0;
			return {
				valid: true,
				currentPage,
				mode: "percent",
				normalizedText: `${clampedPercent}%`,
				percent: clampedPercent
			};
		}
		const numericPages = Number(raw);
		if (!Number.isFinite(numericPages)) return { valid: false, currentPage: 0, mode: "page", normalizedText: raw };
		const currentPage = Math.max(0, Math.min(maxPages > 0 ? maxPages : Number.MAX_SAFE_INTEGER, Math.round(numericPages)));
		return {
			valid: true,
			currentPage,
			mode: "page",
			normalizedText: String(currentPage)
		};
	}

	function promptForFinishRating() {
		return new Promise((resolve) => {
			const existing = document.getElementById("finish-rating-overlay");
			if (existing) existing.remove();

			const overlay = document.createElement("div");
			overlay.id = "finish-rating-overlay";
			overlay.className = "finish-rating-overlay";
			Object.assign(overlay.style, {
				position: "fixed",
				inset: "0",
				background: "rgba(0,0,0,0.45)",
				display: "grid",
				placeItems: "center",
				zIndex: "1200",
				padding: "1rem"
			});

			const modal = document.createElement("div");
			modal.className = "finish-rating-modal";
			modal.setAttribute("role", "dialog");
			modal.setAttribute("aria-modal", "true");
			modal.setAttribute("aria-label", "Rate this finished book");
			Object.assign(modal.style, {
				width: "min(460px, 100%)",
				background: "#fff",
				borderRadius: "14px",
				padding: "1rem",
				boxShadow: "0 10px 26px rgba(0,0,0,0.2)"
			});

			const title = document.createElement("p");
			title.className = "finish-rating-title";
			title.textContent = "Rate this book";
			Object.assign(title.style, {
				margin: "0",
				fontSize: "1.75rem",
				fontWeight: "800",
				color: "#1f2937"
			});

			const subtitle = document.createElement("p");
			subtitle.className = "finish-rating-subtitle";
			subtitle.textContent = "";

			const stars = document.createElement("div");
			stars.className = "finish-rating-stars";
			stars.setAttribute("aria-label", "Rating stars");
			Object.assign(stars.style, {
				display: "flex",
				gap: "0.3rem"
			});

			const actions = document.createElement("div");
			actions.className = "finish-rating-actions";
			Object.assign(actions.style, {
				display: "flex",
				justifyContent: "flex-end",
				gap: "0.45rem",
				marginTop: "0.8rem"
			});

			const cancelButton = document.createElement("button");
			cancelButton.type = "button";
			cancelButton.className = "finish-rating-cancel";
			cancelButton.textContent = "Cancel";

			const skipButton = document.createElement("button");
			skipButton.type = "button";
			skipButton.className = "finish-rating-skip";
			skipButton.textContent = "Skip";

			const saveButton = document.createElement("button");
			saveButton.type = "button";
			saveButton.className = "finish-rating-save";
			saveButton.textContent = "Save";
			saveButton.disabled = true;

			let selectedRating = 0;

			const renderStars = (hoverValue = 0) => {
				const active = hoverValue || selectedRating;
				const buttons = stars.querySelectorAll("button");
				buttons.forEach((button, index) => {
					const value = index + 1;
					button.textContent = value <= active ? "★" : "☆";
					button.setAttribute("aria-pressed", value === selectedRating ? "true" : "false");
				});
				saveButton.disabled = selectedRating < 1 || selectedRating > 5;
			};

			const close = (result) => {
				overlay.remove();
				resolve(result);
			};

			for (let i = 1; i <= 5; i += 1) {
				const star = document.createElement("button");
				star.type = "button";
				star.className = "finish-rating-star";
				star.dataset.value = String(i);
				star.setAttribute("aria-label", `${i} star${i === 1 ? "" : "s"}`);
				star.textContent = "☆";
				Object.assign(star.style, {
					border: "none",
					background: "transparent",
					fontSize: "2rem",
					lineHeight: "1",
					padding: "0.1rem",
					color: "#f59e0b",
					cursor: "pointer"
				});
				star.addEventListener("mouseenter", () => renderStars(i));
				star.addEventListener("mouseleave", () => renderStars());
				star.addEventListener("click", () => {
					selectedRating = i;
					renderStars();
				});
				stars.append(star);
			}

			cancelButton.addEventListener("click", () => close({ cancelled: true, rating: null }));
			skipButton.addEventListener("click", () => close({ cancelled: false, rating: null }));
			saveButton.addEventListener("click", () => close({ cancelled: false, rating: selectedRating }));
			Object.assign(cancelButton.style, {
				border: "none",
				borderRadius: "8px",
				height: "34px",
				padding: "0 0.8rem",
				fontWeight: "700",
				background: "#eceff3",
				color: "#1f2937",
				cursor: "pointer"
			});
			Object.assign(skipButton.style, {
				border: "none",
				borderRadius: "8px",
				height: "34px",
				padding: "0 0.8rem",
				fontWeight: "700",
				background: "#f3efe7",
				color: "#374151",
				cursor: "pointer"
			});
			Object.assign(saveButton.style, {
				border: "none",
				borderRadius: "8px",
				height: "34px",
				padding: "0 0.8rem",
				fontWeight: "700",
				background: "var(--color-primary)",
				color: "#fff",
				cursor: "pointer"
			});
			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) close({ cancelled: true, rating: null });
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && document.body.contains(overlay)) close({ cancelled: true, rating: null });
			}, { once: true });

			actions.append(cancelButton, skipButton, saveButton);
			modal.append(title, stars, actions);
			overlay.append(modal);
			document.body.append(overlay);
			renderStars();
		});
	}

	function removeCardFromCurrentlyReading(dropdown, status) {
		if (String(status || "").trim() === "reading") return;
		const section = dropdown?.closest?.(".currently-reading-section");
		if (!(section instanceof HTMLElement)) return;
		const card = dropdown.closest(".book-card");
		if (!(card instanceof HTMLElement)) return;
		card.remove();
		const remaining = section.querySelectorAll(".currently-reading-grid .book-card");
		if (remaining.length === 0) {
			const grid = section.querySelector(".currently-reading-grid");
			if (grid instanceof HTMLElement) {
				grid.outerHTML = "<p>No books are currently marked as reading.</p>";
			}
		}
	}

	followToggle?.addEventListener("click", async () => {
		if (!(followToggle instanceof HTMLButtonElement)) return;
		const username = String(followToggle.dataset.username || "").trim();
		const isFollowing = String(followToggle.dataset.following || "") === "true";
		if (!username) return;
		followToggle.disabled = true;
		setFollowFeedback(isFollowing ? "Unfollowing..." : "Following...");
		try {
			const response = await fetch("/api/follow", {
				method: isFollowing ? "DELETE" : "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ username })
			});
			const data = await response.json().catch(() => ({}));
			if (response.status === 401) {
				window.location.href = "/settings#account-settings";
				return;
			}
			if (!response.ok) {
				setFollowFeedback(String(data?.error || "Unable to update follow state."), true);
				return;
			}
			const nextFollowing = !!data?.isViewerFollowing;
			followToggle.dataset.following = nextFollowing ? "true" : "false";
			followToggle.textContent = nextFollowing ? "Following" : "Follow";
			if (followersCountNode instanceof HTMLElement) {
				followersCountNode.textContent = String(Number(data?.followersCount || 0));
			}
			if (followingCountNode instanceof HTMLElement) {
				followingCountNode.textContent = String(Number(data?.followingCount || 0));
			}
			setFollowFeedback(nextFollowing ? "You are now following this reader." : "You unfollowed this reader.");
		} catch {
			setFollowFeedback("Unable to update follow state.", true);
		} finally {
			followToggle.disabled = false;
		}
	});

	for (const dropdown of shelfDropdowns) {
		const trigger = dropdown.querySelector('[data-action="toggle-shelf"]');
		const options = Array.from(dropdown.querySelectorAll('[data-action="set-shelf"]'));
		if (trigger) {
			trigger.addEventListener("click", (event) => {
				event.preventDefault();
				event.stopPropagation();
				toggleShelfMenu(dropdown, shelfDropdowns);
			});
		}
		for (const option of options) {
			option.addEventListener("click", async (event) => {
				event.preventDefault();
				event.stopPropagation();
				const status = option.dataset.status || "want_to_read";
				const entry = buildShelfEntryFromRecord({
					title: String(dropdown.dataset.title || "").trim(),
					author: String(dropdown.dataset.author || "").trim(),
					description: String(dropdown.dataset.description || "").trim(),
					pageCount: 0,
					coverUrl: String(dropdown.dataset.cover || "").trim(),
					format: String(dropdown.dataset.format || "Book").trim(),
					language: String(dropdown.dataset.language || "").trim(),
					isbn10: String(dropdown.dataset.isbn10 || "").trim(),
					isbn13: String(dropdown.dataset.isbn13 || "").trim()
				}, {
					status,
					totalPages: 0,
					currentPage: status === "reading" ? 1 : 0,
					finishedDate: status === "finished" ? new Date().toISOString().slice(0, 10) : ""
				});
				if (status === "finished") {
					const finishRating = await promptForFinishRating();
					if (finishRating.cancelled) return;
					if (finishRating.rating) entry.rating = finishRating.rating;
				}
				if (!entry.title) return;
				try {
					const result = await saveShelfEntryWithRetry(entry);
					if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
					setDropdownLabel(dropdown, status);
					setShelvedState(dropdown, true);
					showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
					removeCardFromCurrentlyReading(dropdown, status);
					closeShelfMenus(shelfDropdowns);
				} catch (error) {
					showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
				}
			});
		}
	}

	document.addEventListener("click", async (event) => {
		const rawTarget = event.target;
		const target = rawTarget instanceof Element
			? rawTarget
			: (rawTarget instanceof Node ? rawTarget.parentElement : null);
		if (!(target instanceof HTMLElement)) return;
		const quickFinish = target.closest('[data-action="mark-finished-quick"]');
		if (quickFinish instanceof HTMLButtonElement) {
			event.preventDefault();
			event.stopPropagation();
			const totalPages = Math.max(0, Number(quickFinish.dataset.totalPages || 0) || 0);
			const currentPageRaw = Math.max(0, Number(quickFinish.dataset.currentPage || 0) || 0);
			const finishedPage = totalPages > 0 ? totalPages : currentPageRaw;
			const entry = buildShelfEntryFromRecord({
				title: String(quickFinish.dataset.title || "").trim(),
				author: String(quickFinish.dataset.author || "").trim(),
				description: String(quickFinish.dataset.description || "").trim(),
				pageCount: totalPages,
				coverUrl: String(quickFinish.dataset.cover || "").trim(),
				format: "Book",
				language: String(quickFinish.dataset.language || "").trim(),
				isbn10: String(quickFinish.dataset.isbn10 || "").trim(),
				isbn13: String(quickFinish.dataset.isbn13 || "").trim()
			}, {
				status: "finished",
				totalPages,
				currentPage: finishedPage,
				finishedDate: new Date().toISOString().slice(0, 10)
			});
			const finishRating = await promptForFinishRating();
			if (finishRating.cancelled) return;
			if (finishRating.rating) entry.rating = finishRating.rating;
			if (!entry.title) return;
			quickFinish.disabled = true;
			try {
				const result = await saveShelfEntryWithRetry(entry);
				if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
			const card = quickFinish.closest(".book-card");
			const dropdown = card?.querySelector(".shelf-dropdown");
				if (dropdown) {
					setDropdownLabel(dropdown, "finished");
					setShelvedState(dropdown, true);
					showShelfFeedback(dropdown, "Saved to Read.", feedbackTimers);
					removeCardFromCurrentlyReading(dropdown, "finished");
				}
			} finally {
				quickFinish.disabled = false;
			}
			return;
		}
		const progressSave = target.closest('[data-action="save-reading-progress"]');
		if (progressSave instanceof HTMLButtonElement) {
			event.preventDefault();
			event.stopPropagation();
			const card = progressSave.closest(".book-card");
			const input = card?.querySelector(".progress-inline-input");
			if (!(input instanceof HTMLInputElement)) return;
			const totalPages = Math.max(0, Number(progressSave.dataset.totalPages || 0) || 0);
			const parsed = parseProgressInput(input.value, totalPages);
			if (!parsed.valid) {
				progressSave.textContent = "Invalid";
				setTimeout(() => {
					progressSave.textContent = "Save";
				}, 1000);
				return;
			}
			const currentPage = parsed.currentPage;

			const entry = buildShelfEntryFromRecord({
				title: String(progressSave.dataset.title || "").trim(),
				author: String(progressSave.dataset.author || "").trim(),
				description: String(progressSave.dataset.description || "").trim(),
				pageCount: totalPages,
				coverUrl: String(progressSave.dataset.cover || "").trim(),
				format: "Book",
				language: String(progressSave.dataset.language || "").trim(),
				isbn10: String(progressSave.dataset.isbn10 || "").trim(),
				isbn13: String(progressSave.dataset.isbn13 || "").trim(),
				googleBooksId: String(progressSave.dataset.googleBooksId || "").trim()
			}, {
				status: "reading",
				totalPages,
				currentPage,
				finishedDate: ""
			});
			const directBookId = Math.max(0, Number(progressSave.dataset.bookId || 0) || 0);
			if (directBookId > 0) entry.bookId = directBookId;
			if (!entry.title) return;

			const originalLabel = progressSave.textContent || "Save";
			progressSave.disabled = true;
			progressSave.textContent = "Saving...";
			try {
				const result = await saveShelfEntryWithRetry(entry);
				if (!result.ok) throw new Error(result.message || "Failed to save progress.");
				const progressNode = card?.querySelector(".progress-current-value");
				if (progressNode instanceof HTMLElement) {
					const percent = totalPages > 0 ? Math.max(0, Math.min(100, Math.round((currentPage / totalPages) * 100))) : 0;
					progressNode.textContent = totalPages > 0
						? `Progress: ${currentPage}/${totalPages} pages (${percent}%)`
						: `Progress: ${currentPage} pages`;
				}
				const progressFill = card?.querySelector(".progress-fill");
				if (progressFill instanceof HTMLElement && totalPages > 0) {
					const percent = Math.max(0, Math.min(100, Math.round((currentPage / totalPages) * 100)));
					progressFill.style.width = `${percent}%`;
				}
				const quickFinish = card?.querySelector('[data-action="mark-finished-quick"]');
				if (quickFinish instanceof HTMLButtonElement) {
					quickFinish.dataset.currentPage = String(currentPage);
				}
				input.value = "0";
				progressSave.textContent = "Saved";
				setTimeout(() => {
					progressSave.textContent = originalLabel;
				}, 900);
			} catch {
				progressSave.textContent = "Retry";
				setTimeout(() => {
					progressSave.textContent = originalLabel;
				}, 1200);
			} finally {
				progressSave.disabled = false;
			}
			return;
		}
		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = toggle.closest(".shelf-dropdown");
			if (dropdown) toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}
		const option = target.closest('[data-action="set-shelf"]');
		if (option) {
			event.preventDefault();
			event.stopPropagation();
			const dropdown = option.closest(".shelf-dropdown");
			if (!dropdown) return;
			const status = option.dataset.status || "want_to_read";
			const entry = buildShelfEntryFromRecord({
				title: String(dropdown.dataset.title || "").trim(),
				author: String(dropdown.dataset.author || "").trim(),
				description: String(dropdown.dataset.description || "").trim(),
				pageCount: 0,
				coverUrl: String(dropdown.dataset.cover || "").trim(),
				format: String(dropdown.dataset.format || "Book").trim(),
				language: String(dropdown.dataset.language || "").trim(),
				isbn10: String(dropdown.dataset.isbn10 || "").trim(),
				isbn13: String(dropdown.dataset.isbn13 || "").trim()
			}, {
				status,
				totalPages: 0,
				currentPage: status === "reading" ? 1 : 0,
				finishedDate: status === "finished" ? new Date().toISOString().slice(0, 10) : ""
			});
			if (status === "finished") {
				const finishRating = await promptForFinishRating();
				if (finishRating.cancelled) return;
				if (finishRating.rating) entry.rating = finishRating.rating;
			}
			if (!entry.title) return;
			try {
				const result = await saveShelfEntryWithRetry(entry);
				if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
				setDropdownLabel(dropdown, status);
				setShelvedState(dropdown, true);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
				removeCardFromCurrentlyReading(dropdown, status);
				closeShelfMenus(shelfDropdowns);
				await hydrateShelfEntriesFromServer();
				syncExistingState();
			} catch (error) {
				showShelfFeedback(dropdown, error instanceof Error ? error.message : "Failed to save.", feedbackTimers);
			}
			return;
		}
		if (target.closest(".shelf-dropdown")) return;
		closeShelfMenus(shelfDropdowns);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Enter") return;
		const target = event.target;
		if (!(target instanceof HTMLInputElement)) return;
		if (!target.classList.contains("progress-inline-input")) return;
		event.preventDefault();
		const card = target.closest(".book-card");
		if (!(card instanceof HTMLElement)) return;
		const saveButton = card.querySelector('[data-action="save-reading-progress"]');
		if (!(saveButton instanceof HTMLButtonElement)) return;
		if (saveButton.disabled) return;
		saveButton.click();
	});

	void (async () => {
		migrateShelfEntriesInPlace();
		await hydrateShelfEntriesFromServer();
		syncExistingState();
	})();
</script>
