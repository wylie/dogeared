---
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import { getNeonSql } from "../lib/neon";
import { buildBreadcrumbList, toAbsoluteUrl } from "../lib/seo";
import { authorHref } from "../lib/author";

export const prerender = false;

function normalizeText(value: unknown) {
	return String(value || "").trim();
}

const params = Astro.url.searchParams;
const q = normalizeText(params.get("q"));
const letter = normalizeText(params.get("letter")).slice(0, 1).toUpperCase();
const sort = normalizeText(params.get("sort")) || "name";
const dir = normalizeText(params.get("dir")) === "desc" ? "desc" : "asc";
const page = Math.max(1, Number(params.get("page") || 1) || 1);
const pageSize = 50;
const sortKey = ["name", "books", "readers", "shelves", "activity"].includes(sort) ? sort : "readers";

const sql = getNeonSql();
let total = 0;
let totalPages = 1;
let currentPage = page;
let offset = (currentPage - 1) * pageSize;
const rows = await sql<Array<{
	id: number;
	name: string;
	photo_url: string;
	books: number;
	readers: number;
	shelves: number;
	last_activity: string | null;
	total_count: number;
}>>`
	with author_stats as (
		select
			a.id,
			a.name,
			coalesce(a.photo_url, '') as photo_url,
			count(distinct b.id)::int as books,
			count(distinct ub.user_id)::int as readers,
			count(distinct concat(ub.user_id::text, ':', coalesce(ub.status, '')))::int as shelves,
			max(coalesce(ub.updated_at, b.updated_at, a.updated_at))::text as last_activity
		from author a
		join book b on b.author_id = a.id
		left join user_book ub on ub.book_id = b.id
		where trim(coalesce(a.name, '')) <> ''
			and (${q} = '' or lower(a.name) like ${`%${q.toLowerCase()}%`})
			and (${letter} = '' or upper(left(trim(a.name), 1)) = ${letter})
		group by a.id, a.name, a.photo_url
		having count(distinct b.id) > 0
	)
	select
		id,
		name,
		photo_url,
		books,
		readers,
		shelves,
		last_activity,
		count(*) over()::int as total_count
	from author_stats
	order by
		case when ${sortKey} = 'name' and ${dir} = 'asc' then lower(name) end asc nulls last,
		case when ${sortKey} = 'name' and ${dir} = 'desc' then lower(name) end desc nulls last,
		case when ${sortKey} = 'books' and ${dir} = 'asc' then books end asc nulls last,
		case when ${sortKey} = 'books' and ${dir} = 'desc' then books end desc nulls last,
		case when ${sortKey} = 'readers' and ${dir} = 'asc' then readers end asc nulls last,
		case when ${sortKey} = 'readers' and ${dir} = 'desc' then readers end desc nulls last,
		case when ${sortKey} = 'shelves' and ${dir} = 'asc' then shelves end asc nulls last,
		case when ${sortKey} = 'shelves' and ${dir} = 'desc' then shelves end desc nulls last,
		case when ${sortKey} = 'activity' and ${dir} = 'asc' then last_activity end asc nulls last,
		case when ${sortKey} = 'activity' and ${dir} = 'desc' then last_activity end desc nulls last,
		id asc
	limit ${pageSize}
	offset ${offset}
`;

total = Number(rows[0]?.total_count || 0);
if (rows.length === 0 && page > 1) {
	const countRows = await sql<Array<{ total: number }>>`
		select count(*)::int as total
		from (
			select a.id
			from author a
			join book b on b.author_id = a.id
			where trim(coalesce(a.name, '')) <> ''
				and (${q} = '' or lower(a.name) like ${`%${q.toLowerCase()}%`})
				and (${letter} = '' or upper(left(trim(a.name), 1)) = ${letter})
			group by a.id
			having count(distinct b.id) > 0
		) counted_authors
	`;
	total = Number(countRows[0]?.total || 0);
}
totalPages = Math.max(1, Math.ceil(total / pageSize));
currentPage = Math.min(page, totalPages);
let pageRows = rows;
if (currentPage !== page) {
	offset = (currentPage - 1) * pageSize;
	pageRows = await sql<typeof rows>`
		with author_stats as (
			select
				a.id,
				a.name,
				coalesce(a.photo_url, '') as photo_url,
				count(distinct b.id)::int as books,
				count(distinct ub.user_id)::int as readers,
				count(distinct concat(ub.user_id::text, ':', coalesce(ub.status, '')))::int as shelves,
				max(coalesce(ub.updated_at, b.updated_at, a.updated_at))::text as last_activity
			from author a
			join book b on b.author_id = a.id
			left join user_book ub on ub.book_id = b.id
			where trim(coalesce(a.name, '')) <> ''
				and (${q} = '' or lower(a.name) like ${`%${q.toLowerCase()}%`})
				and (${letter} = '' or upper(left(trim(a.name), 1)) = ${letter})
			group by a.id, a.name, a.photo_url
			having count(distinct b.id) > 0
		)
		select
			id,
			name,
			photo_url,
			books,
			readers,
			shelves,
			last_activity,
			count(*) over()::int as total_count
		from author_stats
		order by
			case when ${sortKey} = 'name' and ${dir} = 'asc' then lower(name) end asc nulls last,
			case when ${sortKey} = 'name' and ${dir} = 'desc' then lower(name) end desc nulls last,
			case when ${sortKey} = 'books' and ${dir} = 'asc' then books end asc nulls last,
			case when ${sortKey} = 'books' and ${dir} = 'desc' then books end desc nulls last,
			case when ${sortKey} = 'readers' and ${dir} = 'asc' then readers end asc nulls last,
			case when ${sortKey} = 'readers' and ${dir} = 'desc' then readers end desc nulls last,
			case when ${sortKey} = 'shelves' and ${dir} = 'asc' then shelves end asc nulls last,
			case when ${sortKey} = 'shelves' and ${dir} = 'desc' then shelves end desc nulls last,
			case when ${sortKey} = 'activity' and ${dir} = 'asc' then last_activity end asc nulls last,
			case when ${sortKey} = 'activity' and ${dir} = 'desc' then last_activity end desc nulls last,
			id asc
		limit ${pageSize}
		offset ${offset}
	`;
}

const baseParams = new URLSearchParams();
if (q) baseParams.set("q", q);
if (letter) baseParams.set("letter", letter);
if (sort) baseParams.set("sort", sort);
if (dir) baseParams.set("dir", dir);
function pageHref(nextPage: number) {
	const p = new URLSearchParams(baseParams);
	p.set("page", String(nextPage));
	return `/authors?${p.toString()}`;
}

const alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const authorsStructuredData = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: "Authors",
		description: "Browse authors with books and shelf activity in DogEared.",
		url: toAbsoluteUrl("/authors", Astro.site ?? Astro.url)
	},
	buildBreadcrumbList([
		{ name: "Home", item: "/" },
		{ name: "Authors", item: "/authors" }
	], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV }),
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: "Authors",
		itemListElement: pageRows.slice(0, 50).map((row, index) => ({
				"@type": "ListItem",
				position: index + 1,
				url: toAbsoluteUrl(authorHref(row.name, row.id), Astro.site ?? Astro.url),
				name: row.name
			}))
	}
]);
---

<Layout
	title="Authors"
	metaDescription="Browse all authors in DogEared. Search, filter, and sort by readers, shelves, and book counts."
	canonicalUrl="/authors"
	structuredData={authorsStructuredData}
>
	<div slot="right" class="authors-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span aria-hidden="true">/</span><span>Authors</span>
		</nav>
		<header class="header">
			<h1>Authors</h1>
			<p>{total.toLocaleString()} authors with books in DogEared.</p>
		</header>
		<form method="get" class="controls">
			<input type="search" name="q" value={q} placeholder="Search authors" />
			<select name="sort">
				<option value="name" selected={sort === "name"}>Name</option>
				<option value="readers" selected={sort === "readers"}>Most readers</option>
				<option value="shelves" selected={sort === "shelves"}>Most shelves</option>
				<option value="books" selected={sort === "books"}>Most books</option>
				<option value="activity" selected={sort === "activity"}>Recent activity</option>
			</select>
			<select name="dir">
				<option value="desc" selected={dir === "desc"}>Desc</option>
				<option value="asc" selected={dir === "asc"}>Asc</option>
			</select>
			<select name="letter">
				<option value="">All letters</option>
				{alpha.map((ch) => <option value={ch} selected={letter === ch}>{ch}</option>)}
			</select>
			<button type="submit">Apply</button>
		</form>
		<ul class="author-grid">
			{pageRows.map((row) => (
				<li>
					<a class="author-card" href={authorHref(row.name, row.id)}>
						{row.photo_url ? <img src={row.photo_url} alt={`${row.name} portrait`} loading="lazy" decoding="async" width="56" height="56" /> : <span class="avatar-fallback" aria-hidden="true">A</span>}
						<div>
							<strong>{row.name}</strong>
							<p>{row.books.toLocaleString()} books · {row.readers.toLocaleString()} readers · {row.shelves.toLocaleString()} shelves</p>
						</div>
					</a>
				</li>
			))}
		</ul>
		<Pagination
			currentPage={currentPage}
			totalPages={totalPages}
			previousHref={currentPage > 1 ? pageHref(currentPage - 1) : ""}
			nextHref={currentPage < totalPages ? pageHref(currentPage + 1) : ""}
			label="Authors pagination"
		/>
	</div>
</Layout>

<style>
	.authors-page { max-width: 1040px; display: grid; gap: 0.95rem; }
	.breadcrumbs { display: flex; gap: 0.35rem; font-size: 0.84rem; color: var(--color-text-subtle); }
	.breadcrumbs a { color: var(--color-nav); text-decoration: none; }
	.breadcrumbs a:hover, .breadcrumbs a:focus-visible { color: var(--color-nav-hover); text-decoration: underline; text-underline-offset: 2px; }
	.header h1, .header p { margin: 0; }
	.controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.controls input, .controls select, .controls button { font: inherit; padding: 0.44rem 0.6rem; border-radius: var(--radius-sm); border: var(--border-strong); }
	.controls button {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
		font-weight: 700;
		cursor: pointer;
	}
	.controls button:hover {
		background: var(--color-primary-hover);
		border-color: var(--color-primary-hover);
	}
	.author-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.author-card { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 0.68rem; align-items: center; text-decoration: none; color: inherit; background: var(--color-surface-raised); border: var(--border-subtle); border-radius: var(--radius-lg); padding: 0.72rem; }
	.author-card img, .avatar-fallback { width: 56px; height: 56px; border-radius: 999px; object-fit: cover; background: #ece7dc; display: grid; place-items: center; }
	.author-card strong { display: block; }
	.author-card p { margin: 0.2rem 0 0; color: var(--color-text-muted); font-size: 0.88rem; }
	@media (max-width: 760px) { .author-grid { grid-template-columns: 1fr; } }
</style>
