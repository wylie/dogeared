				<li>
					<strong>${escapeHtml(item.title || "Untitled")}</strong>
					<span>Existing Work: ${escapeHtml(item.existingWork || "DogEared work")}</span>
					<span>Imported Edition: ${escapeHtml(item.importedEdition || "Goodreads row")}</span>
					<small>${escapeHtml(item.action || "Merged into existing work")} because ${escapeHtml(item.reason || "the records describe the same book.")}</small>
				</li>
			`).join("")
			: `<li><span>No likely duplicate works found in this preview.</span></li>`;
		const reviewItems = Array.isArray(preview.reviewReasons) && preview.reviewReasons.length > 0
			? preview.reviewReasons.map((item) => `
				<li>
					<strong>${escapeHtml(item.title || "Untitled")}</strong>
					<span>${escapeHtml(item.author || "Unknown author")}</span>
					<small>${escapeHtml((item.reasons || []).join(", "))}</small>
				</li>
			`).join("")
			: `<li><span>No books need metadata review in this preview.</span></li>`;
		importPreview.innerHTML = `
			<h3>Import Preview</h3>
			<p>DogEared found ${preview.importableRows} books to import. Estimated time: ${escapeHtml(preview.estimatedLabel)}.</p>
			<div class="import-preview-grid">
