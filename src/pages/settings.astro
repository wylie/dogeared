	async function importGoodreadsCsv(file, options = { mode: "merge", dryRun: false }) {
		const text = await file.text();
		const parseResult = parseGoodreadsImportCsv(text);
		if (parseResult.candidates.length === 0) {
			throw new Error("No importable rows found. Confirm this is a Goodreads export CSV.");
		}
		const mode = options?.mode === "replace" ? "replace" : "merge";
		const existingEntries = mode === "replace" ? [] : loadEntries();
		const plan = buildGoodreadsImportPlan(parseResult, existingEntries, mode);
		const summary = summarizeGoodreadsImportPlan(plan);
		const preview = buildGoodreadsImportPreview(plan);
		if (options?.dryRun) {
			return {
				...preview,
				localCache: "full",
				syncFailed: 0,
				previewOnly: true,
				totalPreview: summary.importableRows,
				changedEntries: plan.changedEntries
			};
		}

		if (mode === "replace") {
			const cleared = await clearShelfOnServer();
			if (!cleared) throw new Error("Could not clear the existing shelf before replacing it.");
		}

		for (const change of plan.statusChanges) {
			logShelfUpdate(change.entry, change.status);
		}

		const localCache = saveEntriesWithFallback(plan.nextEntries);
		const syncFailed = await syncEntriesToServer(plan.changedEntries, (completed, total) => {
			showFeedback(`Syncing imported books: ${completed}/${total} saved...`);
		});
		saveImportRecovery(syncFailed > 0 ? plan.changedEntries.slice(-syncFailed) : []);

		return { ...preview, localCache, syncFailed, previewOnly: false };
	}

