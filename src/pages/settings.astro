	}

	function saveImportHistory(item) {
		const history = loadImportHistory();
		history.unshift({ ...item, createdAt: new Date().toISOString() });
		localStorage.setItem(IMPORT_HISTORY_KEY, JSON.stringify(history.slice(0, 8)));
		renderImportHistory();
	}

	function renderImportHistory() {
		if (!(importHistoryList instanceof HTMLElement)) return;
		const history = loadImportHistory();
		if (history.length === 0) {
			importHistoryList.innerHTML = "<p>No imports have run in this browser yet.</p>";
			return;
		}
		importHistoryList.innerHTML = history.map((item) => `
			<div class="import-history-item">
				<span>${escapeHtml(new Date(item.createdAt).toLocaleString())}</span>
				<strong>${Number(item.imported || 0)} imported, ${Number(item.updated || 0)} merged, ${Number(item.skipped || 0)} skipped</strong>
			</div>
		`).join("");
	}

