		const setText = (element, value) => {
			if (element instanceof HTMLElement) element.textContent = String(value);
		};
		setText(importCurrentStatus, status);
		setText(importBooksImported, Number(result.imported || 0));
		setText(importBooksSkipped, Number(result.skipped || 0));
		setText(importDuplicatesMerged, Number(result.duplicateRows || result.potentialDuplicates || 0));
		setText(importMissingMetadata, Number(result.missingMetadata || result.booksRequiringReview || 0));
		setText(importSeriesMatched, Number(result.seriesDetected || 0));
	}

	function renderPreview(preview) {
		if (!(importPreview instanceof HTMLElement)) return;
		const duplicateItems = Array.isArray(preview.duplicateExplanations) && preview.duplicateExplanations.length > 0
