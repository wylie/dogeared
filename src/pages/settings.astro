	async function syncEntriesToServer(entries, onProgress) {
		let failed = 0;
		let completed = 0;
		const batchSize = 10;
		for (let i = 0; i < entries.length; i += batchSize) {
			const batch = entries.slice(i, i + batchSize);
			const results = await Promise.all(batch.map((entry) => saveShelfEntryWithRetry(entry, {
				redirectPath: "/settings#auth-settings",
				retries: 2,
				retryDelayMs: 300
			})));
			for (const result of results) {
				completed += 1;
				if (!result.ok) failed += 1;
			}
			if (typeof onProgress === "function") onProgress(completed, entries.length);
		}
		return failed;
	}

