---
import Layout from '../layouts/Layout.astro';
import { resolveUserBySession } from '../lib/auth';

export const prerender = false;

const session = await resolveUserBySession(Astro.request);
if (!session?.userId) {
	return Astro.redirect('/');
}

const sectionLinks = [
	{ id: "profile-settings", label: "Profile" },
	{ id: "account-settings", label: "Account" },
	{ id: "notifications-settings", label: "Notifications" },
	{ id: "learning-settings", label: "Learning" },
	{ id: "privacy-settings", label: "Privacy" },
	{ id: "reading-defaults", label: "Reading Defaults" },
	{ id: "personalization-settings", label: "Personalization" },
	{ id: "import-dashboard", label: "Import" },
	{ id: "data-export", label: "Data Export" },
	{ id: "api-settings", label: "API" },
	{ id: "security-settings", label: "Security" },
	{ id: "danger-zone-settings", label: "Danger Zone" }
];
---

<Layout title="Settings" sectionLinks={sectionLinks} robots="noindex,nofollow">
	<div slot="right" class="settings-page">
		<h1>Settings</h1>
		<p class="subhead">Manage account setup, privacy, imports, and preferences.</p>

		<section class="settings-section" id="profile-settings" aria-labelledby="profile-settings-title">
			<h2 id="profile-settings-title">Profile</h2>
			<p class="section-copy">
				Profile details live on your public reader page. Update your name, avatar, location, and favorites there.
			</p>
			<div class="account-actions">
				<a class="button-link secondary" href="/profile">Open Profile</a>
			</div>
		</section>

		<section class="settings-section" id="account-settings" aria-labelledby="account-settings-title">
			<h2 id="account-settings-title">Account</h2>
			<p class="section-copy">
				Your reading history, shelves, ratings, and reviews stay with your account even if your email changes.
			</p>
			<div class="account-blocks">
				<div class="account-panel">
					<h3>Email Address</h3>
					<p class="account-meta"><strong id="account-current-email">Loading...</strong></p>
					<div id="pending-email-panel" class="pending-panel" hidden>
						<p class="account-meta">Pending Email Change: <strong id="pending-email-address"></strong></p>
						<p class="meta">Check that inbox for a verification link before the change is applied.</p>
						<div class="account-actions">
							<button type="button" id="resend-email-verification-button" class="secondary">Resend Verification</button>
						</div>
					</div>
					<div class="account-actions">
						<button type="button" id="open-email-change-button">Change Email</button>
					</div>
				</div>
				<div class="account-panel">
					<h3>Password</h3>
					<p class="account-meta">DogEared uses secure magic links for sign-in. There is no password to manage right now.</p>
				</div>
				<div class="account-panel">
					<h3>Future Account Management</h3>
					<div class="account-actions account-actions-wrap">
						<button type="button" class="secondary" disabled>Export My Data</button>
						<button type="button" class="secondary" disabled>Delete Account</button>
					</div>
				</div>
			</div>
			<p id="email-change-feedback" class="feedback" hidden></p>
		</section>

		<section class="settings-section import-dashboard" id="import-dashboard" aria-labelledby="import-dashboard-title">
			<h2 id="import-dashboard-title">Import Dashboard</h2>
			<p class="section-copy">
				Bring your Goodreads shelves into DogEared with a preview first, a clear report after, and a way to resume if a sync is interrupted. If you are starting fresh, you can skip import and add books from Search.
			</p>
			<div class="import-status-grid" aria-live="polite">
				<article class="import-stat">
					<span>Current status</span>
					<strong id="import-current-status">Ready</strong>
				</article>
				<article class="import-stat">
					<span>Books imported</span>
					<strong id="import-books-imported">0</strong>
				</article>
				<article class="import-stat">
					<span>Books skipped</span>
					<strong id="import-books-skipped">0</strong>
				</article>
				<article class="import-stat">
					<span>Duplicates merged</span>
					<strong id="import-duplicates-merged">0</strong>
				</article>
				<article class="import-stat">
					<span>Missing metadata</span>
					<strong id="import-missing-metadata">0</strong>
				</article>
				<article class="import-stat">
					<span>Series matched</span>
					<strong id="import-series-matched">0</strong>
				</article>
			</div>
			<div class="import-workflow">
				<form id="goodreads-import-form" class="import-form">
					<label for="goodreads-csv">Goodreads CSV</label>
					<input id="goodreads-csv" name="goodreadsCsv" type="file" accept=".csv,text/csv" required />
					<div class="import-controls-row">
						<label for="import-mode">Import mode</label>
						<select id="import-mode">
							<option value="merge">Merge with existing shelf</option>
							<option value="replace">Replace existing shelf</option>
						</select>
					</div>
					<label class="checkbox-row">
						<input type="checkbox" id="import-dry-run-first" checked />
						<span>Always show preview before importing</span>
					</label>
					<div class="account-actions account-actions-wrap">
						<button type="button" id="preview-import-button" class="secondary">Preview Import</button>
						<button type="submit">Continue Import</button>
						<button type="button" id="cancel-import-button" class="secondary" hidden>Cancel</button>
						<button type="button" id="resume-import-button" class="secondary" hidden>Resume Failed Sync</button>
					</div>
				</form>
				<div class="import-help">
					<h3>What DogEared checks</h3>
					<p>DogEared reads the file, matches likely duplicate works, keeps your strongest shelf state, and flags books that may need metadata review.</p>
				</div>
			</div>

			<p id="import-feedback" class="feedback" hidden></p>
			<p id="import-controls-feedback" class="feedback" hidden></p>
			<div id="import-preview" class="summary import-preview" hidden></div>
			<div id="import-summary" class="summary import-report" hidden></div>
			<div class="summary import-history" id="import-history">
				<h3>Import History</h3>
				<div id="import-history-list"><p>No imports have run in this browser yet.</p></div>
			</div>
		</section>

		<section class="settings-section" id="auth-settings" aria-labelledby="auth-settings-title">
			<h2 id="auth-settings-title">Authentication</h2>
			<p class="section-copy">
				Sign in with a magic link delivered through Brevo, or sign out.
			</p>

			<div class="account-blocks">
				<div class="account-panel">
					<div id="account-signed-in-state" hidden>
						<p class="account-meta">Signed in as <strong id="account-email"></strong></p>
						<div class="account-actions">
							<button type="button" id="logout-button" class="secondary">Log Out</button>
						</div>
					</div>
					<form id="magic-link-form" class="import-form" hidden>
						<label for="magic-email">Email</label>
						<input id="magic-email" type="email" autocomplete="email" required placeholder="you@example.com" />
						<button type="submit">Send Magic Link</button>
					</form>
				</div>
			</div>

			<p id="account-feedback" class="feedback" hidden></p>
		</section>

		<section class="settings-section" id="notifications-settings" aria-labelledby="notifications-settings-title">
			<h2 id="notifications-settings-title">Notifications</h2>
			<p class="section-copy">Choose which in-app notifications DogEared can show. Account security emails are always sent when your login email changes.</p>
			<div class="danger-form">
				<label class="checkbox-row">
					<input type="checkbox" id="notification-category-community" checked />
					<span>Community updates</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="notification-category-reading" checked />
					<span>Reading updates</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="notification-category-discovery" checked />
					<span>Discovery updates</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="notification-category-milestones" checked />
					<span>Milestones</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="notification-category-system" checked />
					<span>System and import updates</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="browser-notifications-enabled" />
					<span>Prepare for browser notifications when available</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="release-email-enabled" />
					<span>Email me occasional DogEared release notes</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="weekly-summary-enabled" />
					<span>Email me a weekly reading summary</span>
				</label>
			</div>
		</section>

		<section class="settings-section" id="learning-settings" aria-labelledby="learning-settings-title">
			<h2 id="learning-settings-title">Learning</h2>
			<p class="section-copy">Control the contextual tips that help you find your way around DogEared.</p>
			<div class="danger-form">
				<label class="checkbox-row">
					<input type="checkbox" id="show-helpful-tips" checked />
					<span>Show helpful tips</span>
				</label>
				<button type="button" id="reset-guided-tour-button" class="secondary">Reset Guided Tour</button>
				<button type="button" id="restart-onboarding-button" class="secondary">Restart Onboarding</button>
				<button type="button" id="hide-onboarding-checklist-button" class="secondary">Hide Onboarding Checklist</button>
			</div>
			<p id="learning-feedback" class="feedback" hidden></p>
		</section>

		<section class="settings-section" id="danger-zone-settings" aria-labelledby="danger-zone-settings-title">
			<h2 id="danger-zone-settings-title">Danger Zone</h2>
			<p class="section-copy danger-copy">
				Delete Account is planned for a future account management update. It is not available from Settings yet.
			</p>
			<div id="account-danger-zone" class="account-panel account-panel-danger" hidden>
				<button type="button" class="danger" disabled>Delete Account</button>
			</div>
		</section>

		<section class="settings-section" id="privacy-settings" aria-labelledby="privacy-settings-title">
			<h2 id="privacy-settings-title">Privacy</h2>
			<p class="section-copy">Control profile visibility and what appears to other readers.</p>
			<div class="danger-form">
				<label for="profile-visibility">Profile visibility</label>
				<select id="profile-visibility">
					<option value="public">Public profile</option>
					<option value="private">Private profile</option>
				</select>
				<label class="checkbox-row">
					<input type="checkbox" id="share-location" checked />
					<span>Show my location on profile and metrics</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="share-activity" checked />
					<span>Allow activity sharing in feeds</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="allow-discovery" checked />
					<span>Allow my profile in discovery suggestions</span>
				</label>
				<label class="checkbox-row">
					<input type="checkbox" id="allow-follow-requests" checked />
					<span>Allow other readers to follow me</span>
				</label>
			</div>
		</section>

		<section class="settings-section" id="reading-defaults" aria-labelledby="reading-defaults-title">
			<h2 id="reading-defaults-title">Reading Defaults</h2>
			<p class="section-copy">Choose default shelf behavior and list sorting.</p>
			<div class="danger-form">
				<label for="default-shelf">Default shelf when adding books</label>
				<select id="default-shelf">
					<option value="want_to_read">Want to Read</option>
					<option value="reading">Currently Reading</option>
					<option value="finished">Read</option>
				</select>
				<label for="home-sort">Default home/profile sort</label>
				<select id="home-sort">
					<option value="relevance">Relevance</option>
					<option value="recent">Most Recent</option>
					<option value="rating">Highest Rated</option>
				</select>
			</div>
		</section>

		<section class="settings-section" id="personalization-settings" aria-labelledby="personalization-settings-title">
			<h2 id="personalization-settings-title">Personalization</h2>
			<p class="section-copy">Set preferences that shape search, ranking, and recommendations.</p>
			<div class="danger-form">
				<label for="favorite-genres-input">Favorite genres (comma separated)</label>
				<input id="favorite-genres-input" type="text" placeholder="Fantasy, Science Fiction" />
				<label for="excluded-genres-input">Excluded genres (comma separated)</label>
				<input id="excluded-genres-input" type="text" placeholder="Horror" />
			</div>
		</section>

		<section class="settings-section" id="api-settings" aria-labelledby="api-settings-title">
			<h2 id="api-settings-title">API</h2>
			<p class="section-copy">
				DogEared now stores shelved books in its own catalog. Use these routes to read from the DogEared API instead of relying on third-party APIs for saved data.
			</p>

			<div class="api-grid">
				<div class="api-card">
					<h3>My Shelf</h3>
					<p class="api-copy">Returns the saved books currently synced to your DogEared shelf.</p>
					<label for="api-shelf-url">Endpoint</label>
					<div class="api-url-row">
						<input id="api-shelf-url" class="api-url" type="text" readonly value="" />
						<button type="button" class="secondary copy-button" data-copy-target="api-shelf-url">Copy</button>
					</div>
				</div>

				<div class="api-card">
					<h3>Catalog Search</h3>
					<p class="api-copy">Searches books through DogEared's server-side search route.</p>
					<label for="api-search-url">Endpoint</label>
					<div class="api-url-row">
						<input id="api-search-url" class="api-url" type="text" readonly value="" />
						<button type="button" class="secondary copy-button" data-copy-target="api-search-url">Copy</button>
					</div>
				</div>

				<div class="api-card">
					<h3>Top Books By Genre</h3>
					<p class="api-copy">Returns books ranked from real DogEared shelf activity.</p>
					<label for="api-top-url">Endpoint</label>
					<div class="api-url-row">
						<input id="api-top-url" class="api-url" type="text" readonly value="" />
						<button type="button" class="secondary copy-button" data-copy-target="api-top-url">Copy</button>
					</div>
				</div>
			</div>

			<p class="api-note">
				Search still begins with Google Books, but once a book is shelved or imported it can be served back from DogEared's own database.
			</p>
			<p id="api-feedback" class="feedback" hidden></p>
		</section>

		<section class="settings-section" id="data-export" aria-labelledby="data-export-title">
			<h2 id="data-export-title">Data Export</h2>
			<p class="section-copy">
				Download a JSON export of your account profile and shelved books.
			</p>
			<div class="account-actions">
				<button type="button" id="download-data-button" disabled>Download My Data (JSON)</button>
			</div>
			<div class="danger-form">
				<label for="preferred-export-format">Preferred export format</label>
				<select id="preferred-export-format">
					<option value="json">JSON</option>
					<option value="csv" disabled>CSV (Coming Soon)</option>
				</select>
			</div>
			<hr />
			<p class="danger-copy">Delete all shelf entries while keeping your account.</p>
			<div class="account-actions">
				<button type="button" id="clear-shelf-button" class="danger">Delete All Shelf Entries</button>
			</div>
			<p id="export-feedback" class="feedback" hidden></p>
		</section>

		<section class="settings-section" id="security-settings" aria-labelledby="security-settings-title">
			<h2 id="security-settings-title">Security</h2>
			<p class="section-copy">Review active sessions and recent activity.</p>
			<div class="account-actions">
				<button type="button" id="refresh-security-button" class="secondary">Refresh</button>
				<button type="button" id="revoke-sessions-button" class="secondary">Revoke Other Sessions</button>
			</div>
			<div id="session-list" class="summary"></div>
			<div id="recent-activity-list" class="summary"></div>
			<p id="security-feedback" class="feedback" hidden></p>
		</section>

		<div class="account-actions">
			<button type="button" id="save-preferences-button">Save Preferences</button>
		</div>
		<p id="preferences-feedback" class="feedback" hidden></p>
		<div id="email-change-modal" class="modal-backdrop" hidden>
			<div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="email-change-title">
				<h2 id="email-change-title">Change Email</h2>
				<p class="section-copy">Enter the new email address you want to use for DogEared. We will send a verification link before anything changes.</p>
				<form id="email-change-form" class="import-form">
					<label for="new-email-address">New Email Address</label>
					<input id="new-email-address" type="email" autocomplete="email" required placeholder="you@example.com" />
					<div class="account-actions">
						<button type="button" id="cancel-email-change-button" class="secondary">Cancel</button>
						<button type="submit">Continue</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</Layout>

<style>
	.settings-page {
		max-width: 920px;
		display: flex;
		flex-direction: column;
	}

	h1 {
		margin: 0;
	}

	.subhead {
		margin: 0.5rem 0 1.25rem;
		color: var(--color-text-muted);
		order: 1;
	}

	h1 {
		order: 0;
	}

	#profile-settings { order: 2; }
	#account-settings { order: 3; }
	#notifications-settings { order: 4; }
	#learning-settings { order: 5; }
	#auth-settings { order: 6; }
	#privacy-settings { order: 7; }
	#reading-defaults { order: 8; }
	#personalization-settings { order: 9; }
	#import-dashboard { order: 10; }
	#data-export { order: 11; }
	#api-settings { order: 12; }
	#security-settings { order: 13; }
	#danger-zone-settings { order: 14; }

	.settings-section {
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		padding: 1.05rem;
		background: var(--color-surface-raised);
		margin-top: 1.05rem;
	}

	.settings-section h2 {
		margin: 0;
	}

	.section-copy {
		margin: 0.5rem 0 0.8rem;
		color: var(--color-text-muted);
		line-height: 1.5;
	}

	.steps {
		margin: 0 0 1rem 1.1rem;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}

	.import-form {
		display: grid;
		gap: 0.55rem;
	}

	label {
		font-weight: 600;
	}

	input[type="file"] {
		font-size: 0.95rem;
	}

	input[type="text"],
	input[type="email"],
	select {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		border: var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0.6rem 0.7rem;
		font: inherit;
		background: rgba(255, 255, 255, 0.82);
	}

	.checkbox-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 400;
	}

	.checkbox-row input[type="checkbox"] {
		width: 1rem;
		height: 1rem;
	}

	button {
		border: none;
		border-radius: var(--radius-sm);
		padding: 0.62rem 0.92rem;
		font-size: 0.95rem;
		background: #151515;
		color: #fff;
		cursor: pointer;
		justify-self: start;
	}
	button:hover:not(:disabled) {
		background: #2a2a2a;
	}

	button:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.button-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
		padding: 0.6rem 0.9rem;
		font-size: 0.95rem;
		text-decoration: none;
		justify-self: start;
	}

	.feedback {
		margin: 0.85rem 0 0;
		padding: 0.7rem 0.8rem;
		border-radius: var(--radius-md);
		background: #f3f6f8;
		color: #1f2937;
	}

	.feedback.error {
		background: #fef2f2;
		color: #991b1b;
	}

	.summary {
		margin-top: 0.8rem;
		padding: 0.85rem;
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-md);
		background: rgba(255, 255, 255, 0.54);
	}

	.summary p {
		margin: 0.2rem 0;
	}

	.import-status-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
		margin: 0.8rem 0 1rem;
	}

	.import-stat {
		border: var(--border-subtle);
		border-radius: var(--radius-md);
		background: rgba(255, 255, 255, 0.56);
		padding: 0.65rem;
	}

	.import-stat span {
		display: block;
		color: var(--color-text-muted);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.import-stat strong {
		display: block;
		margin-top: 0.2rem;
		font-size: 1.18rem;
	}

	.import-workflow {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(220px, 0.8fr);
		gap: 1rem;
		align-items: start;
	}

	.import-controls-row {
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr);
		gap: 0.55rem;
		align-items: center;
		max-width: 520px;
	}

	.import-help {
		border-left: var(--border-subtle);
		padding-left: 0.9rem;
		color: var(--color-text-muted);
	}

	.import-help h3,
	.import-history h3,
	.import-preview h3,
	.import-report h3 {
		margin: 0 0 0.45rem;
		font-size: 1rem;
	}

	.import-preview-grid,
	.import-report-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.45rem;
		margin: 0.7rem 0;
	}

	.import-mini-stat {
		border-top: var(--border-subtle);
		padding-top: 0.45rem;
	}

	.import-mini-stat span {
		display: block;
		color: var(--color-text-muted);
		font-size: 0.8rem;
	}

	.import-mini-stat strong {
		display: block;
		margin-top: 0.15rem;
	}

	.import-list {
		margin: 0.55rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.import-list li {
		border-top: var(--border-subtle);
		padding-top: 0.45rem;
	}

	.import-list strong {
		display: block;
	}

	.import-list span,
	.import-list small {
		display: block;
		color: var(--color-text-muted);
		line-height: 1.4;
	}

	.import-history-item {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		border-top: var(--border-subtle);
