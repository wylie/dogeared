	importForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		summary.hidden = true;
		const file = csvInput?.files?.[0];
		if (!file) {
			showFeedback("Choose a Goodreads CSV file first.", true);
			return;
		}
		const mode = importModeSelect instanceof HTMLSelectElement && importModeSelect.value === "replace" ? "replace" : "merge";
		const dryRunFirst = importDryRunFirst instanceof HTMLInputElement ? importDryRunFirst.checked : false;
		const signature = fileSignature(file, mode);
		showFeedback(dryRunFirst && previewReadySignature !== signature ? "Checking your Goodreads CSV before importing..." : "Importing Goodreads data...");
		try {
			if (dryRunFirst && previewReadySignature !== signature) {
				const preview = await importGoodreadsCsv(file, { mode, dryRun: true });
				renderPreview(preview);
				previewReadySignature = signature;
				if (cancelImportButton instanceof HTMLElement) cancelImportButton.hidden = false;
				showFeedback("Preview ready. Review the details, then choose Continue Import when you are ready.");
				return;
			}
			const result = await importGoodreadsCsv(file, { mode, dryRun: false });
			const statusParts = [
				`${result.imported} imported`,
				`${result.updated} updated`,
				`${result.skipped} skipped`
			];
			if (result.localCache === "failed") {
				showFeedback(`Import complete (${statusParts.join(", ")}), but browser storage is full. Your books were synced to DogEared; open Profile to confirm.`, true);
			} else if (result.localCache === "trimmed") {
				showFeedback(`Import complete (${statusParts.join(", ")}). Open Profile to review your imported shelves.`);
			} else if (result.syncFailed > 0) {
				showFeedback(`Import mostly completed (${statusParts.join(", ")}), but ${result.syncFailed} books could not sync. Try importing again in merge mode.`, true);
			} else {
				showFeedback(`Import complete: ${statusParts.join(", ")}. Open Profile to review your shelves.`);
			}
			showSummary(result);
			previewReadySignature = "";
			if (importPreview instanceof HTMLElement) importPreview.hidden = true;
			if (cancelImportButton instanceof HTMLElement) cancelImportButton.hidden = true;
			importForm.reset();
		} catch (error) {
			showFeedback(error instanceof Error ? error.message : "Unable to import this CSV. Confirm it is a Goodreads export, then try again.", true);
		}
	});

