---
import Layout from "../../layouts/Layout.astro";
import BookCard from "../../components/BookCard.astro";
import CollectionBookCard from "../../components/CollectionBookCard.astro";
import ShelfDropdown from "../../components/ShelfDropdown.astro";
import RatingControl from "../../components/RatingControl.astro";
import SeriesSection from "../../components/SeriesSection.astro";
import AuthorSection from "../../components/AuthorSection.astro";
import { getNeonSql } from "../../lib/neon";
import { resolveUserBySession } from "../../lib/auth";
import { authorHref, canonicalizeAuthor, normalizeAuthorName, slugifyAuthor } from "../../lib/author";
import { fetchExternalAuthorBooks, type ExternalAuthorBook } from "../../lib/externalAuthorBooks";
import { authorCanonicalPath } from "../../lib/indexing";
import { buildBreadcrumbList, toAbsoluteUrl } from "../../lib/seo";
import { ensureSeriesSchema, inferKnownSeriesMetadata } from "../../lib/series";
import { loadCollectionsForAuthor, type CollectionRecord } from "../../lib/collections";
import { ensureCanonicalWorkSchema } from "../../lib/catalogWorks";
import { canonicalizeCatalogAuthor, canonicalizeCatalogTitle } from "../../lib/catalogKeys";
import { withRuntimeCache } from "../../lib/runtimeCache";

export const prerender = false;

type BookRow = {
	id: number;
	workId: number;
	title: string;
	author: string;
	authorId: number;
	shelves: number;
	readers: number;
	genres: string[];
	coverUrl: string;
	language: string;
	isbn10: string;
	isbn13: string;
	googleBooksId: string;
	synopsis: string;
	publishedYear: number;
	pageCount: number;
	averageRating: number;
	ratingCount: number;
	seriesId: number;
	seriesName: string;
	bookOrder: number;
	publicationOrder: number;
	chronologicalOrder: number;
};

type BibliographyItem = {
	kind: "local" | "external";
	id: string;
	title: string;
	author: string;
	seriesKey: string;
	seriesName: string;
	bookOrder: number;
	publicationOrder: number;
	chronologicalOrder: number;
	publishedYear: number;
	coverUrl: string;
	localBook?: BookRow;
	externalBook?: ExternalAuthorBook;
};

type BibliographySection = {
	id: string;
	title: string;
	kind: "series" | "standalone";
	coverUrl: string;
	books: BibliographyItem[];
};

const slug = String(Astro.params.slug || "").trim().toLowerCase();
const requestedName = normalizeAuthorName(Astro.url.searchParams.get("name"));
const canonicalFromSlug = slug.replace(/[^a-z0-9]+/g, "");
const canonical = canonicalizeAuthor(requestedName) || canonicalFromSlug;

const session = await resolveUserBySession(Astro.request);
const viewerUserId = String(session?.userId || "");

let authorName = requestedName;
let books: BookRow[] = [];
let viewerStatusByBookId = new Map<number, "want_to_read" | "reading" | "finished">();
let viewerRatingByBookId = new Map<number, number>();
let errorMessage = "";
let bio = "";
let bioSource = "";
let bioSourceUrl = "";
let authorPhotoUrl = "";
let shelvesCount = 0;
let readersCount = 0;
let externalBooks: ExternalAuthorBook[] = [];
let authorId = 0;
let featuredInCollections: CollectionRecord[] = [];

function renderAverageStars(value: number) {
	const rounded = Math.max(0, Math.min(5, Math.round((Number(value || 0) + Number.EPSILON) * 2) / 2));
	const full = Math.floor(rounded);
	const hasHalf = rounded - full >= 0.5;
	const empty = 5 - full - (hasHalf ? 1 : 0);
	return `${"★".repeat(full)}${hasHalf ? "☆" : ""}${"☆".repeat(Math.max(0, empty))}`;
}

function numericOrder(value: unknown) {
	const parsed = Number(value || 0);
	return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
}

function seriesGroupingKey(name: string) {
	const canonicalName = canonicalizeCatalogTitle(name);
	return canonicalName ? `series:${canonicalName}` : "";
}

function formatSeriesSectionTitle(name: string) {
	const clean = String(name || "").trim();
	if (!clean) return "";
	return /\bseries$/i.test(clean) ? clean : `${clean} Series`;
}

function formatBookCount(count: number) {
	const normalized = Math.max(0, Number(count || 0) || 0);
	return `${normalized.toLocaleString()} book${normalized === 1 ? "" : "s"}`;
}

function compareBibliographyItems(a: BibliographyItem, b: BibliographyItem) {
	const aOrder = numericOrder(a.bookOrder) || numericOrder(a.publicationOrder) || numericOrder(a.chronologicalOrder);
	const bOrder = numericOrder(b.bookOrder) || numericOrder(b.publicationOrder) || numericOrder(b.chronologicalOrder);
	if (aOrder !== bOrder) return (aOrder || Number.MAX_SAFE_INTEGER) - (bOrder || Number.MAX_SAFE_INTEGER);
	if (a.publishedYear !== b.publishedYear) return (a.publishedYear || Number.MAX_SAFE_INTEGER) - (b.publishedYear || Number.MAX_SAFE_INTEGER);
	return a.title.localeCompare(b.title);
}

function buildAuthorBibliographySections(localBooks: BookRow[], missingBooks: ExternalAuthorBook[]) {
	const seriesSections = new Map<string, BibliographySection>();
	const standalone: BibliographyItem[] = [];
	const appendItem = (item: BibliographyItem) => {
		if (item.seriesKey && item.seriesName) {
			const section = seriesSections.get(item.seriesKey) || {
				id: item.seriesKey.replace(/[^a-z0-9-]+/gi, "-"),
				title: formatSeriesSectionTitle(item.seriesName),
				kind: "series" as const,
				coverUrl: "",
				books: []
			};
			if (!section.coverUrl && item.coverUrl) section.coverUrl = item.coverUrl;
			section.books.push(item);
			seriesSections.set(item.seriesKey, section);
		} else {
			standalone.push(item);
		}
	};

	for (const book of localBooks) {
		const seriesName = String(book.seriesName || "").trim();
		const bookOrder = numericOrder(book.bookOrder);
		appendItem({
			kind: "local",
			id: `local-${book.id}`,
			title: book.title,
			author: book.author,
			seriesKey: seriesName ? seriesGroupingKey(seriesName) : "",
			seriesName,
			bookOrder,
			publicationOrder: numericOrder(book.publicationOrder) || bookOrder,
			chronologicalOrder: numericOrder(book.chronologicalOrder) || bookOrder,
			publishedYear: Math.max(0, Number(book.publishedYear || 0) || 0),
			coverUrl: book.coverUrl,
			localBook: book
		});
	}

	for (const book of missingBooks) {
		const inferred = inferKnownSeriesMetadata({ title: book.title, author: book.author });
		const seriesName = String(inferred?.seriesName || "").trim();
		const bookOrder = numericOrder(inferred?.bookOrder);
		appendItem({
			kind: "external",
			id: `external-${book.sourceWorkId || canonicalizeCatalogTitle(book.title)}`,
			title: book.title,
			author: book.author,
			seriesKey: seriesName ? seriesGroupingKey(seriesName) : "",
			seriesName,
			bookOrder,
			publicationOrder: bookOrder,
			chronologicalOrder: bookOrder,
			publishedYear: Math.max(0, Number(book.publishedYear || 0) || 0),
			coverUrl: book.coverUrl,
			externalBook: book
		});
	}

	const sections = Array.from(seriesSections.values())
		.map((section) => ({ ...section, books: [...section.books].sort(compareBibliographyItems) }))
		.sort((a, b) => a.title.localeCompare(b.title));
	if (standalone.length > 0) {
		sections.push({
			id: "standalone",
			title: "Standalone Books",
			kind: "standalone",
			coverUrl: "",
			books: [...standalone].sort((a, b) => {
				if (a.publishedYear !== b.publishedYear) return (a.publishedYear || Number.MAX_SAFE_INTEGER) - (b.publishedYear || Number.MAX_SAFE_INTEGER);
				return a.title.localeCompare(b.title);
			})
		});
	}
	return sections;
}

async function fetchOpenLibraryBio(name: string) {
	if (!name) return null;
	try {
		const searchUrl = `https://openlibrary.org/search/authors.json?q=${encodeURIComponent(name)}`;
		const searchRes = await fetch(searchUrl, { signal: AbortSignal.timeout(900) });
		if (!searchRes.ok) return null;
		const searchJson = await searchRes.json();
		const docs = Array.isArray(searchJson?.docs) ? searchJson.docs : [];
		if (docs.length === 0) return null;
		const targetLower = name.toLowerCase();
		const candidate = docs.find((row: any) => String(row?.name || "").trim().toLowerCase() === targetLower) || docs[0];
		const key = String(candidate?.key || "").trim();
		if (!key) return null;
		const detailsRes = await fetch(`https://openlibrary.org${encodeURIComponent(key).replace(/%2F/g, "/")}.json`, {
			signal: AbortSignal.timeout(900)
		});
		if (!detailsRes.ok) return null;
		const details = await detailsRes.json();
		const bioRaw = typeof details?.bio === "string" ? details.bio : String(details?.bio?.value || "");
		const photoId = Number(Array.isArray(details?.photos) ? details.photos[0] : 0) || 0;
		return {
			bio: String(bioRaw || "").replace(/\s+/g, " ").trim(),
			photoUrl: photoId > 0 ? `https://covers.openlibrary.org/a/id/${photoId}-L.jpg` : "",
			sourceUrl: `https://openlibrary.org${key}`
		};
	} catch {
		return null;
	}
}

try {
	const sql = getNeonSql();
	await ensureCanonicalWorkSchema(sql);
	await ensureSeriesSchema(sql);
	const canonicalAuthorRows = await sql<Array<{
		id: number;
		name: string;
		bio: string;
		photo_url: string;
		bio_source: string;
		bio_source_url: string;
	}>>`
		select id, name, coalesce(bio, '') as bio, coalesce(photo_url, '') as photo_url, coalesce(bio_source, '') as bio_source, coalesce(bio_source_url, '') as bio_source_url
		from author
		where lower(regexp_replace(coalesce(name, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
		order by id asc
		limit 1
	`;
	const canonicalAuthor = canonicalAuthorRows[0];
	if (Number(canonicalAuthor?.id || 0) > 0) {
		authorId = Number(canonicalAuthor.id || 0);
		authorName = normalizeAuthorName(canonicalAuthor.name);
		bio = String(canonicalAuthor.bio || "").trim();
		authorPhotoUrl = String(canonicalAuthor.photo_url || "").trim();
		bioSource = String(canonicalAuthor.bio_source || "").trim();
		bioSourceUrl = String(canonicalAuthor.bio_source_url || "").trim();
	}
	const rows = await sql<BookRow[]>`
		select
			b.id,
			coalesce(b.work_id, b.id)::bigint as "workId",
			coalesce(nullif(trim(bw.canonical_title), ''), nullif(trim(bw.title), ''), b.title) as title,
			coalesce(nullif(trim(b.primary_author), ''), 'Unknown') as author,
			coalesce(b.author_id, 0)::bigint as "authorId",
			count(ub.book_id)::int as shelves,
			count(distinct ub.user_id)::int as readers,
			coalesce(array_agg(distinct bg.genre_name order by bg.genre_name) filter (where trim(coalesce(bg.genre_name, '')) <> ''), '{}') as genres,
			coalesce(nullif(trim(b.cover_url), ''), '') as "coverUrl",
			coalesce(nullif(trim(b.language), ''), '') as language,
			coalesce(nullif(trim(b.isbn10), ''), '') as isbn10,
			coalesce(nullif(trim(b.isbn13), ''), '') as isbn13,
			coalesce(nullif(trim(b.google_books_id), ''), '') as "googleBooksId",
			coalesce(nullif(trim(b.synopsis), ''), '') as synopsis,
			coalesce(b.published_year, 0)::int as "publishedYear",
			coalesce(nullif(b.page_count, 0), 0)::int as "pageCount",
			coalesce(rt.average_rating, 0) as "averageRating",
			coalesce(rt.rating_count, 0)::int as "ratingCount",
			coalesce(series_info.series_id, 0)::bigint as "seriesId",
			coalesce(series_info.series_name, '') as "seriesName",
			coalesce(series_info.book_order, 0)::numeric as "bookOrder",
			coalesce(series_info.publication_order, 0)::numeric as "publicationOrder",
			coalesce(series_info.chronological_order, 0)::numeric as "chronologicalOrder"
		from book b
		left join book_work bw on bw.id = b.work_id
		left join user_book ub on ub.book_id = b.id
		left join book_genre bg on bg.book_id = b.id
		left join lateral (
			select
				candidate.series_id,
				candidate.series_name,
				candidate.book_order,
				candidate.publication_order,
				candidate.chronological_order
			from (
				select
					s.id as series_id,
					s.name as series_name,
					sb.book_order,
					sb.publication_order,
					sb.chronological_order,
					1 as priority
				from series_book sb
				join series s on s.id = sb.series_id
				where sb.book_id = b.id
				union all
				select
					s.id as series_id,
					s.name as series_name,
					sb.book_order,
					sb.publication_order,
					sb.chronological_order,
					2 as priority
				from book sibling
				join series_book sb on sb.book_id = sibling.id
				join series s on s.id = sb.series_id
				where b.work_id is not null
					and sibling.work_id = b.work_id
				union all
				select
					s.id as series_id,
					s.name as series_name,
					bw.series_position as book_order,
					bw.series_position as publication_order,
					bw.series_position as chronological_order,
					3 as priority
				from series s
				where s.id = bw.series_id
			) candidate
			order by candidate.priority asc, candidate.book_order nulls last, candidate.series_id asc
			limit 1
		) series_info on true
		left join lateral (
			select
				round(avg(ub2.rating)::numeric, 2) as average_rating,
				count(*) filter (where ub2.rating is not null)::int as rating_count
			from user_book ub2
			where ub2.book_id = b.id
		) rt on true
		where (
			(${authorId} > 0 and b.author_id = ${authorId})
			or lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
		)
		group by b.id, b.work_id, bw.canonical_title, bw.title, b.title, b.primary_author, b.author_id, b.cover_url, b.language, b.isbn10, b.isbn13, b.google_books_id, b.synopsis, b.published_year, b.page_count, rt.average_rating, rt.rating_count, series_info.series_id, series_info.series_name, series_info.book_order, series_info.publication_order, series_info.chronological_order
		order by coalesce(series_info.series_name, '') asc, coalesce(series_info.book_order, 999999) asc, shelves desc, readers desc, b.title asc
	`;

	if (rows.length > 0) {
		authorName = normalizeAuthorName(rows[0].author);
		const byCanonicalSlot = new Map<string, BookRow>();
		for (const row of rows) {
			const seriesId = Number(row.seriesId || 0);
			const bookOrder = Number(row.bookOrder || 0);
			const key = seriesId > 0 && bookOrder > 0
				? `series:${seriesId}:${bookOrder}`
				: `work:${canonicalizeCatalogTitle(row.title)}:${canonicalizeCatalogAuthor(row.author)}`;
			const existing = byCanonicalSlot.get(key);
			if (!existing || row.shelves > existing.shelves || row.readers > existing.readers || row.ratingCount > existing.ratingCount) {
				byCanonicalSlot.set(key, row);
			}
		}
		books = Array.from(byCanonicalSlot.values());
		const authorCounts = await sql<Array<{ shelves: number; readers: number }>>`
			select
				count(distinct concat(ub.user_id::text, ':', coalesce(ub.status, '')))::int as shelves,
				count(distinct ub.user_id)::int as readers
			from user_book ub
			join book b on b.id = ub.book_id
			where lower(regexp_replace(coalesce(b.primary_author, ''), '[^[:alnum:]]+', '', 'g')) = ${canonical}
		`;
		shelvesCount = Number(authorCounts[0]?.shelves || 0);
		readersCount = Number(authorCounts[0]?.readers || 0);
	}

	if (viewerUserId && books.length > 0) {
		const bookIds = Array.from(new Set(books.map((book) => Number(book.id || 0)).filter((id) => id > 0)));
		if (bookIds.length > 0) {
			const statuses = await sql<Array<{ book_id: number; status: "want_to_read" | "reading" | "finished"; rating: number | null }>>`
				select book_id, status, rating
				from user_book
				where user_id = ${viewerUserId}::uuid
					and book_id = any(${bookIds}::bigint[])
			`;
			viewerStatusByBookId = new Map(statuses.map((row) => [Number(row.book_id || 0), row.status]));
			viewerRatingByBookId = new Map(
				statuses
					.map((status) => [Number(status.book_id || 0), Number(status.rating || 0) || 0] as const)
					.filter(([, rating]) => rating > 0)
			);
		}
	}

	const openLibraryBioPromise = authorName && (!bio || !authorPhotoUrl)
		? withRuntimeCache(`author-open-library-bio:v1:${canonicalizeCatalogAuthor(authorName)}`, 6 * 60 * 60 * 1000, () => fetchOpenLibraryBio(authorName)).catch(() => null)
		: Promise.resolve(null);
	const [openLibrary, collections] = await Promise.all([
		openLibraryBioPromise,
		loadCollectionsForAuthor(sql, { authorId, authorName }, 4)
	]);
	if (openLibrary) {
		if (openLibrary.bio && !bio) {
			bio = openLibrary.bio;
			bioSource = "Open Library";
			bioSourceUrl = openLibrary.sourceUrl;
		}
		if (openLibrary.photoUrl && !authorPhotoUrl) {
			authorPhotoUrl = openLibrary.photoUrl;
		}
	}
	featuredInCollections = collections;
} catch (error) {
	errorMessage = error instanceof Error ? error.message : "Failed to load author page.";
}
if (authorName) {
	const localBookKey = books.map((book) => Number(book.id || 0)).filter((id) => id > 0).sort((a, b) => a - b).join("-");
	externalBooks = await withRuntimeCache(
		`author-external-books:v1:${canonicalizeCatalogAuthor(authorName)}:${localBookKey}`,
		60 * 60 * 1000,
		() => fetchExternalAuthorBooks(authorName, books)
	).catch(() => []);
}
const bibliographySections = buildAuthorBibliographySections(books, externalBooks);
const knownBookCount = bibliographySections.reduce((total, section) => total + section.books.length, 0);

const displayName = authorName || requestedName || slug.replace(/-/g, " ");
const cleanAuthorPath = displayName ? authorCanonicalPath(displayName) : "/authors";
if (displayName) {
	const expectedSlug = slugifyAuthor(displayName);
	if (slug !== expectedSlug || Astro.url.search) {
		return Astro.redirect(cleanAuthorPath, 301);
	}
}
const authorRobots = !errorMessage && books.length > 0 ? "index,follow" : "noindex,follow";
const authorDescription = displayName
	? `${displayName} on DogEared: ${knownBookCount.toLocaleString()} known books, ${readersCount.toLocaleString()} readers, and shelf activity.`
	: "Browse authors and their books on DogEared.";
const authorStructuredData = displayName
	? JSON.stringify([
		{
			"@context": "https://schema.org",
			"@type": "Person",
			name: displayName,
			description: bio || `${displayName} author page on DogEared`,
			url: toAbsoluteUrl(cleanAuthorPath, Astro.site ?? Astro.url),
			image: authorPhotoUrl || undefined
		},
		buildBreadcrumbList([
			{ name: "Home", item: "/" },
			{ name: "Authors", item: "/authors" },
			{ name: displayName, item: cleanAuthorPath }
		], { site: Astro.site ?? Astro.url, logErrors: import.meta.env.DEV })
	])
	: "";
---

<Layout
	title={displayName || "Author"}
	metaDescription={authorDescription}
	canonicalUrl={cleanAuthorPath}
	ogType="profile"
	robots={authorRobots}
	socialImage={authorPhotoUrl || "/og-image.png"}
	socialImageAlt={displayName ? `${displayName} on DogEared` : "Authors on DogEared"}
	structuredData={authorStructuredData}
>
	<div slot="right" class="author-page" data-author-id={authorId > 0 ? String(authorId) : ""}>
		{errorMessage && <p class="error">{errorMessage}</p>}

		<AuthorSection
			name={displayName || "Author"}
			photoUrl={authorPhotoUrl}
			bio={bio}
			bioSource={bioSource}
			bioSourceUrl={bioSourceUrl}
			stats={[
				{ label: "Known books", value: knownBookCount },
				{ label: "Readers", value: `${readersCount.toLocaleString()} · Shelf entries: ${shelvesCount.toLocaleString()}` }
			]}
		/>

			{featuredInCollections.length > 0 && (
				<section class="featured-in-section" aria-labelledby="featured-in-title">
					<div class="section-head">
						<h2 id="featured-in-title">Featured In</h2>
					</div>
					<ul class="featured-in-grid">
						{featuredInCollections.map((collection) => (
							<li>
								<a href={`/collections/${encodeURIComponent(collection.slug)}`}>
									{collection.heroImage && <img src={collection.heroImage} alt="" loading="lazy" decoding="async" />}
									<span>
										<strong>{collection.title}</strong>
										{collection.subtitle && <small>{collection.subtitle}</small>}
										<small>{collection.bookCount.toLocaleString()} book{collection.bookCount === 1 ? "" : "s"}</small>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<section class="books-section" aria-label={`${displayName || "Author"} bibliography`}>
			{bibliographySections.length === 0 ? (
				<p>No known books for this author are available yet.</p>
			) : (
				<div class="author-book-groups">
					{bibliographySections.map((group) => (
						group.kind === "series" ? (
							<SeriesSection
								title={group.title}
								supportingText={formatBookCount(group.books.length)}
								coverUrl={group.coverUrl}
								headingId={`author-book-group-${group.id}`}
								spacing="inline"
							>
								{group.books.map((entry) => entry.localBook ? (
									<CollectionBookCard
										title={entry.localBook.title}
										titleHref={`/book?bookId=${encodeURIComponent(String(entry.localBook.id))}`}
										author={entry.localBook.author}
										authorHref={entry.localBook.author ? authorHref(entry.localBook.author, entry.localBook.authorId) : ""}
										thumbnail={entry.localBook.coverUrl}
										publishedLabel={entry.localBook.publishedYear > 0 ? String(entry.localBook.publishedYear) : ""}
										pageCount={entry.localBook.pageCount}
										averageRating={entry.localBook.averageRating}
										seriesLabel={entry.bookOrder > 0 ? `Book ${entry.bookOrder}` : ""}
									>
										{!(Number(entry.localBook.ratingCount || 0) > 0) && <p slot="meta" class="meta">No ratings yet.</p>}
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-book-id": String(entry.localBook.id || 0),
												"data-initial-status": viewerStatusByBookId.get(Number(entry.localBook.id || 0)) || "",
												"data-title": entry.localBook.title,
												"data-author": entry.localBook.author,
												"data-cover": entry.localBook.coverUrl,
												"data-description": entry.localBook.synopsis,
												"data-pages": String(entry.localBook.pageCount || 0),
												"data-language": entry.localBook.language,
												"data-isbn10": entry.localBook.isbn10,
												"data-isbn13": entry.localBook.isbn13,
												"data-google-books-id": entry.localBook.googleBooksId,
												"data-categories": JSON.stringify(entry.localBook.genres ?? [])
											}} />
										</div>
									</CollectionBookCard>
								) : entry.externalBook ? (
									<CollectionBookCard
										title={entry.externalBook.title}
										author={entry.externalBook.author}
										thumbnail={entry.externalBook.coverUrl}
										publishedLabel={entry.externalBook.publishedYear > 0 ? String(entry.externalBook.publishedYear) : ""}
										seriesLabel={entry.bookOrder > 0 ? `Book ${entry.bookOrder}` : ""}
									>
										<p slot="meta" class="meta">No ratings yet.</p>
										<div slot="actions">
											<ShelfDropdown attrs={{
												"data-book-id": "",
												"data-title": entry.externalBook.title,
												"data-author": entry.externalBook.author,
												"data-cover": entry.externalBook.coverUrl,
												"data-isbn10": entry.externalBook.isbn10,
												"data-isbn13": entry.externalBook.isbn13,
												"data-published-date": entry.externalBook.publishedYear > 0 ? String(entry.externalBook.publishedYear) : "",
												"data-source": "open_library",
												"data-source-work-id": entry.externalBook.sourceWorkId,
												"data-source-url": entry.externalBook.sourceUrl
											}} />
										</div>
									</CollectionBookCard>
								) : null)}
							</SeriesSection>
						) : (
							<section class="author-book-group" aria-labelledby={`author-book-group-${group.id}`}>
								<div class="author-book-group-heading">
									<p class="author-book-group-eyebrow">Books</p>
									<h2 id={`author-book-group-${group.id}`}>{group.title}</h2>
									<p>{formatBookCount(group.books.length)}</p>
								</div>
								<ul class="book-grid">
									{group.books.map((entry) => entry.localBook ? (
										<BookCard
											title={entry.localBook.title}
											titleHref={`/book?bookId=${encodeURIComponent(String(entry.localBook.id))}`}
											author={entry.localBook.author}
											authorHref={entry.localBook.author ? authorHref(entry.localBook.author, entry.localBook.authorId) : ""}
											thumbnail={entry.localBook.coverUrl}
											description={entry.localBook.synopsis || "Synopsis unavailable for this title."}
											readers={entry.localBook.readers}
											shelfEntries={entry.localBook.shelves}
											publishedLabel={entry.localBook.publishedYear > 0 ? String(entry.localBook.publishedYear) : ""}
											pageCount={entry.localBook.pageCount}
											averageRating={entry.localBook.averageRating}
											genres={entry.localBook.genres}
										>
											<div slot="preMeta">
												{viewerStatusByBookId.get(Number(entry.localBook.id || 0)) === "finished" && (
													<RatingControl
														bookId={String(entry.localBook.id || 0)}
														rating={viewerRatingByBookId.get(Number(entry.localBook.id || 0)) || 0}
														editable={true}
													/>
												)}
												{viewerStatusByBookId.get(Number(entry.localBook.id || 0)) !== "finished" && !(Number(entry.localBook.ratingCount || 0) > 0) && (
													<p class="meta">No ratings yet.</p>
												)}
											</div>
											<div slot="actions">
												<ShelfDropdown attrs={{
													"data-book-id": String(entry.localBook.id || 0),
													"data-initial-status": viewerStatusByBookId.get(Number(entry.localBook.id || 0)) || "",
													"data-title": entry.localBook.title,
													"data-author": entry.localBook.author,
													"data-cover": entry.localBook.coverUrl,
													"data-description": entry.localBook.synopsis,
													"data-pages": String(entry.localBook.pageCount || 0),
													"data-language": entry.localBook.language,
													"data-isbn10": entry.localBook.isbn10,
													"data-isbn13": entry.localBook.isbn13,
													"data-google-books-id": entry.localBook.googleBooksId,
													"data-categories": JSON.stringify(entry.localBook.genres ?? [])
												}} />
											</div>
										</BookCard>
									) : entry.externalBook ? (
										<BookCard
											title={entry.externalBook.title}
											author={entry.externalBook.author}
											thumbnail={entry.externalBook.coverUrl}
											publishedLabel={entry.externalBook.publishedYear > 0 ? String(entry.externalBook.publishedYear) : ""}
											showCommunityStats={false}
										>
											<div slot="actions">
												<ShelfDropdown attrs={{
													"data-book-id": "",
													"data-title": entry.externalBook.title,
													"data-author": entry.externalBook.author,
													"data-cover": entry.externalBook.coverUrl,
													"data-isbn10": entry.externalBook.isbn10,
													"data-isbn13": entry.externalBook.isbn13,
													"data-published-date": entry.externalBook.publishedYear > 0 ? String(entry.externalBook.publishedYear) : "",
													"data-source": "open_library",
													"data-source-work-id": entry.externalBook.sourceWorkId,
													"data-source-url": entry.externalBook.sourceUrl
												}} />
											</div>
										</BookCard>
									) : null)}
								</ul>
							</section>
						)
					))}
				</div>
			)}
			</section>
	</div>
</Layout>

<script>
	import {
		buildShelfEntryFromRecord,
		closeShelfMenus,
		isShelfDropdownOrMenuTarget,
		parseCategories,
		removeBookFromAllShelvesOnServer,
		resolveShelfDropdownFromTarget,
		resolveShelfRemoveMessage,
		setDropdownLabel,
		setShelvedState,
		showShelfFeedback,
		statusLabel,
		saveShelfEntryWithRetry,
		toggleShelfMenu,
		initRatingControls
	} from "../../lib/shelfClient.ts";
	const shelfDropdowns = Array.from(document.querySelectorAll(".shelf-dropdown"));
	const feedbackTimers = new WeakMap();
	initRatingControls();

	function buildEntry(dropdown, status) {
		const title = String(dropdown.dataset.title || "").trim();
		const totalPages = Math.max(0, Number(dropdown.dataset.pages || 0) || 0);
		return buildShelfEntryFromRecord({
			bookId: dropdown.dataset.bookId,
			title,
			author: String(dropdown.dataset.author || "").trim(),
			description: String(dropdown.dataset.description || "").trim(),
			pageCount: totalPages,
			coverUrl: String(dropdown.dataset.cover || ""),
			format: "Book",
			language: String(dropdown.dataset.language || ""),
			publishedDate: String(dropdown.dataset.publishedDate || ""),
			isbn10: String(dropdown.dataset.isbn10 || ""),
			isbn13: String(dropdown.dataset.isbn13 || ""),
			googleBooksId: String(dropdown.dataset.googleBooksId || ""),
			categories: parseCategories(dropdown.dataset.categories)
		}, {
			status,
			totalPages,
			currentPage: status === "finished" ? totalPages : (status === "reading" ? Math.min(1, totalPages || 1) : 0),
			finishedDate: status === "finished" ? new Date().toISOString().slice(0, 10) : "",
			source: String(dropdown.dataset.source || ""),
			sourceWorkId: String(dropdown.dataset.sourceWorkId || ""),
			sourceUrl: String(dropdown.dataset.sourceUrl || "")
		});
	}

	document.addEventListener("click", async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;

		const toggle = target.closest('[data-action="toggle-shelf"]');
		if (toggle instanceof HTMLButtonElement) {
			const dropdown = toggle.closest(".shelf-dropdown");
			if (!(dropdown instanceof HTMLElement)) return;
			toggleShelfMenu(dropdown, shelfDropdowns);
			return;
		}

		const option = target.closest('[data-action="set-shelf"]');
		if (option instanceof HTMLButtonElement) {
			const dropdown = resolveShelfDropdownFromTarget(option);
			if (!(dropdown instanceof HTMLElement)) return;
			const status = String(option.dataset.status || "want_to_read");
			const title = String(dropdown.dataset.title || "").trim();
			if (!title) return;
			const entry = buildEntry(dropdown, status);
			try {
				const result = await saveShelfEntryWithRetry(entry);
				if (!result.ok) throw new Error(result.message || "Failed to save shelf entry.");
				const data = (result.data && typeof result.data === "object" ? result.data : {}) as Record<string, unknown>;
				const bookId = Math.max(0, Number(data.bookId || 0) || 0);
				if (bookId > 0) dropdown.dataset.bookId = String(bookId);
				setDropdownLabel(dropdown, status);
				setShelvedState(dropdown, true);
				showShelfFeedback(dropdown, `Saved to ${statusLabel(status)}.`, feedbackTimers);
				closeShelfMenus(shelfDropdowns);
			} catch (err) {
				showShelfFeedback(dropdown, err instanceof Error ? err.message : "Failed to save.", feedbackTimers);
			}
			return;
		}

		const assignOption = target.closest('[data-action="assign-custom-shelf"]');
		if (assignOption instanceof HTMLButtonElement) {
			const dropdown = resolveShelfDropdownFromTarget(assignOption);
			if (!(dropdown instanceof HTMLElement)) return;
			const shelfId = Math.max(0, Number(assignOption.dataset.shelfId || 0) || 0);
			if (!shelfId) return;
			try {
				let bookId = Math.max(0, Number(dropdown.dataset.bookId || 0) || 0);
				if (!bookId) {
					const saveResult = await saveShelfEntryWithRetry(buildEntry(dropdown, "want_to_read"));
					if (!saveResult.ok) throw new Error(saveResult.message || "Failed to add this book to DogEared.");
					const data = (saveResult.data && typeof saveResult.data === "object" ? saveResult.data : {}) as Record<string, unknown>;
					bookId = Math.max(0, Number(data.bookId || 0) || 0);
					if (bookId) dropdown.dataset.bookId = String(bookId);
					setDropdownLabel(dropdown, "want_to_read");
					setShelvedState(dropdown, true);
				}
				const response = await fetch("/api/shelf/custom-shelf-books", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ shelfId, bookId })
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(String(data?.error || "Failed to assign custom shelf."));
				showShelfFeedback(dropdown, "Saved to custom shelf.", feedbackTimers);
				closeShelfMenus(shelfDropdowns);
			} catch (err) {
				showShelfFeedback(dropdown, err instanceof Error ? err.message : "Failed to save.", feedbackTimers);
			}
			return;
		}

		const removeOption = target.closest('[data-action="remove-from-shelves"]');
		if (removeOption instanceof HTMLButtonElement) {
			const dropdown = resolveShelfDropdownFromTarget(removeOption);
			if (!(dropdown instanceof HTMLElement)) return;
			try {
				const result = await removeBookFromAllShelvesOnServer(dropdown.dataset.bookId, buildEntry(dropdown, "want_to_read"));
				if (!result.ok) throw new Error(resolveShelfRemoveMessage(result));
				setDropdownLabel(dropdown, "");
				setShelvedState(dropdown, false);
				showShelfFeedback(dropdown, "Removed from shelves.", feedbackTimers);
				closeShelfMenus(shelfDropdowns);
				window.dispatchEvent(new CustomEvent("dogeared:reading-data-changed"));
			} catch (err) {
				showShelfFeedback(dropdown, err instanceof Error ? err.message : "Failed to remove from shelves.", feedbackTimers);
			}
			return;
		}

		if (!isShelfDropdownOrMenuTarget(target)) closeShelfMenus(shelfDropdowns);
	});
</script>

