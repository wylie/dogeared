---
import Layout from "../layouts/Layout.astro";
import { resolveUserBySession } from "../lib/auth";
import { getNeonSql } from "../lib/neon";
import { authorHref } from "../lib/author";
import { loadFinishedBooksForReader } from "../lib/finishedBooks";
import {
	buildReadingLifeSummary,
	filterReadingTimeline,
	type ReadingLifeCalendarDay,
	type ReadingLifeCurrentBook,
	type ReadingLifeFinishedBook,
	type ReadingLifeProgressEvent
} from "../lib/readingLife.ts";
import { recordPerformanceEventSafe } from "../lib/performanceTelemetry";

export const prerender = false;

const pagePerfStartedAt = performance.now();
const pagePerfStages: Record<string, number> = {};
const markPagePerfStage = (stage: string) => {
	pagePerfStages[stage] = Math.round((performance.now() - pagePerfStartedAt) * 10) / 10;
};

type RawCurrentBookRow = {
	id: number;
	title: string;
	primary_author: string;
	cover_url: string;
	current_page: number;
	total_pages: number;
	updated_at: string | null;
};

type RawProgressRow = {
	book_id: number;
	work_id: number | null;
	title: string;
	primary_author: string;
	date: string;
	page_delta: number;
};

function formatDate(value: string) {
	if (!value) return "Date unavailable";
	const date = new Date(`${value}T00:00:00Z`);
	if (!Number.isFinite(date.getTime())) return value;
	return new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(date);
}

function formatFullDate(value: string) {
	if (!value) return "Date unavailable";
	const date = new Date(`${value}T00:00:00Z`);
	if (!Number.isFinite(date.getTime())) return value;
	return new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(date);
}

function formatMonthName(month: number) {
	return new Intl.DateTimeFormat("en", { month: "long", timeZone: "UTC" }).format(new Date(Date.UTC(2026, month - 1, 1)));
}

function pluralize(count: number, singular: string, plural = `${singular}s`) {
	return `${count.toLocaleString()} ${count === 1 ? singular : plural}`;
}

function formatPageEquivalents(value: number) {
	return pluralize(Math.max(0, Math.round(Number(value || 0))), "page equivalent");
}

function calendarDayHasReading(day: ReadingLifeCalendarDay) {
	return day.active || day.pageEquivalents > 0 || day.sessions > 0 || day.booksRead > 0 || day.completions > 0;
}

function calendarDayPrimaryLine(day: ReadingLifeCalendarDay) {
	if (!calendarDayHasReading(day)) return "No reading recorded.";
	if (day.pageEquivalents > 0 && day.booksRead > 0) {
		return `${formatPageEquivalents(day.pageEquivalents)} across ${pluralize(day.booksRead, "book")}`;
	}
	if (day.pageEquivalents > 0) return `${formatPageEquivalents(day.pageEquivalents)} recorded`;
	return `${pluralize(day.booksRead, "book")} read`;
}

function calendarDayAriaLabel(day: ReadingLifeCalendarDay) {
	const date = formatFullDate(day.date);
	if (!calendarDayHasReading(day)) return `${date}: No reading recorded.`;
	return [
		`${date}: ${formatPageEquivalents(day.pageEquivalents)}`,
		pluralize(day.progressUpdates, "progress update"),
		`${pluralize(day.booksRead, "book")} read`,
		`${pluralize(day.completions, "book")} finished`
	].join(", ") + ".";
}

function activityDayWorkBreakdownJson(day: ReadingLifeCalendarDay) {
	return JSON.stringify(day.workBreakdown.map((work) => ({
		title: work.title,
		author: work.author || "",
		pageEquivalents: work.pageEquivalents,
		progressUpdates: work.progressUpdates,
		finishes: work.finishes,
		incompleteUpdates: work.incompleteUpdates,
		normalizationState: work.normalizationState
	})));
}

function dayDistanceFromToday(day: ReadingLifeCalendarDay, todayKey: string) {
	const current = new Date(`${day.date}T00:00:00Z`).getTime();
	const today = new Date(`${todayKey}T00:00:00Z`).getTime();
	if (!Number.isFinite(current) || !Number.isFinite(today)) return Number.MAX_SAFE_INTEGER;
	return Math.round((today - current) / 86400000);
}

function formatRating(value: number | null | undefined) {
	const rating = Number(value || 0);
	return rating > 0 ? `${rating}/5` : "Unrated";
}

function ratingStars(value: number | null | undefined) {
	const rating = Math.max(0, Math.min(5, Math.round(Number(value || 0))));
	return rating > 0 ? Array.from({ length: 5 }, (_, index) => index < rating ? "★" : "☆").join("") : "";
}

function bookHref(id: number) {
	return `/book?bookId=${encodeURIComponent(String(id))}`;
}

function timelineAuthorHref(book: Pick<ReadingLifeFinishedBook, "author" | "authorId">) {
	return authorHref(book.author, book.authorId);
}

function bookTitle(book: ReadingLifeFinishedBook | null) {
	return book?.title || "Not enough data yet";
}

function bookMeta(book: ReadingLifeFinishedBook | null, suffix = "") {
	if (!book) return "";
	const parts = [book.author];
	if (book.pageCount && book.pageCount > 0) parts.push(`${book.pageCount.toLocaleString()} pages`);
	if (book.publishedYear) parts.push(String(book.publishedYear));
	if (suffix) parts.push(suffix);
	return parts.filter(Boolean).join(" · ");
}

let readingLifeSchemaReady: Promise<void> | null = null;

async function ensureReadingLifeSchema(sql: ReturnType<typeof getNeonSql>) {
	if (!readingLifeSchemaReady) {
		readingLifeSchemaReady = Promise.all([
			sql`alter table user_book add column if not exists rating int`,
			sql`alter table user_book add column if not exists finished_reflection text not null default ''`,
			sql`
				create table if not exists user_reading_progress_event (
					id bigserial primary key,
					user_id uuid not null references app_user(id) on delete cascade,
					book_id bigint not null references book(id) on delete cascade,
					from_page int not null default 0,
					to_page int not null default 0,
					page_delta int not null default 0,
					recorded_at timestamptz not null default now()
				)
			`
		]).then(() => undefined);
	}
	try {
		await readingLifeSchemaReady;
	} catch (error) {
		readingLifeSchemaReady = null;
		throw error;
	}
}

const session = await resolveUserBySession(Astro.request);
markPagePerfStage("session_loaded");
const viewerUserId = session?.userId || "";
const now = new Date();
const currentYear = now.getUTCFullYear();
const selectedYear = Number(Astro.url.searchParams.get("year") || currentYear) || currentYear;
const selectedMonth = Number(Astro.url.searchParams.get("month") || 0) || 0;
const timelineQuery = String(Astro.url.searchParams.get("q") || "").trim();
const sectionLinks = [
	{ id: "overview", label: "Overview" },
	{ id: "timeline", label: "History" },
	{ id: "genres", label: "Insights" },
	{ id: "journey", label: "Journey" }
];

let finishedBooks: ReadingLifeFinishedBook[] = [];
let currentBooks: ReadingLifeCurrentBook[] = [];
let progressEvents: ReadingLifeProgressEvent[] = [];
let annualGoal = "";
let loadError = "";

if (viewerUserId) {
	try {
		const sql = getNeonSql();
		await ensureReadingLifeSchema(sql);
		markPagePerfStage("schema_ready");
		const [profileRows, finishedRows, currentRows, progressRows] = await Promise.all([
			sql<Array<{ profile_data: unknown }>>`
				select profile_data
				from app_user
				where id = ${viewerUserId}::uuid
				limit 1
			`,
			loadFinishedBooksForReader(sql, viewerUserId),
			sql<RawCurrentBookRow[]>`
				select
					b.id,
					b.title,
					b.primary_author,
					b.cover_url,
					ub.current_page,
					ub.total_pages,
					ub.updated_at::text as updated_at
				from user_book ub
				join book b on b.id = ub.book_id
				where ub.user_id = ${viewerUserId}::uuid
					and ub.status = 'reading'
				order by ub.updated_at desc, b.title asc
				limit 8
			`,
			sql<RawProgressRow[]>`
				select
					pe.book_id,
					bw.id as work_id,
					b.title,
					b.primary_author,
					pe.recorded_at::date::text as date,
					pe.page_delta
				from user_reading_progress_event pe
				join book b on b.id = pe.book_id
				left join book_work bw on bw.id = b.work_id
				where pe.user_id = ${viewerUserId}::uuid
				order by pe.recorded_at desc
			`
		]);

		const profileData = profileRows[0]?.profile_data && typeof profileRows[0].profile_data === "object"
			? profileRows[0].profile_data as Record<string, unknown>
			: {};
		annualGoal = String(profileData.readingGoal || "");
		finishedBooks = finishedRows;
		currentBooks = currentRows.map((row) => ({
			id: Number(row.id || 0),
			title: String(row.title || "Untitled"),
			author: String(row.primary_author || "Unknown Author"),
			coverUrl: String(row.cover_url || ""),
			currentPage: Number(row.current_page || 0),
			totalPages: Number(row.total_pages || 0),
			updatedAt: String(row.updated_at || "")
		}));
		progressEvents = progressRows.map((row) => ({
			bookId: Number(row.book_id || 0),
			workId: Number(row.work_id || 0) || null,
			title: String(row.title || "Untitled"),
			author: String(row.primary_author || "Unknown Author"),
			date: String(row.date || ""),
			pageDelta: Number(row.page_delta || 0)
		}));
		markPagePerfStage("reading_life_loaded");
	} catch (error) {
		loadError = error instanceof Error ? error.message : "Unable to load your reading life.";
		markPagePerfStage("load_failed");
	}
}

const readingLifeBuildStartedAt = performance.now();
const readingLife = buildReadingLifeSummary({
	finishedBooks,
	currentBooks,
	progressEvents,
	annualGoal,
	now
});
pagePerfStages.daily_reading_activity = Math.round((performance.now() - readingLifeBuildStartedAt) * 10) / 10;
const timelineItems = filterReadingTimeline(readingLife.timeline, {
	year: selectedYear,
	month: selectedMonth,
	query: timelineQuery
});
const calendarDays = readingLife.calendarDays;
const todayKey = now.toISOString().slice(0, 10);
const calendarSummary = {
	activeDays: calendarDays.filter((day) => day.active).length,
	pageEquivalents: calendarDays.reduce((sum, day) => sum + day.pageEquivalents, 0),
	completions: calendarDays.reduce((sum, day) => sum + day.completions, 0),
	incompleteUpdates: calendarDays.reduce((sum, day) => sum + day.incompleteUpdates, 0)
};
const volumeRangeOptions = [
	{ id: "today", label: "Today", days: 1 },
	{ id: "7d", label: "7 Days", days: 7 },
	{ id: "30d", label: "30 Days", days: 30 },
	{ id: "6m", label: "6 Months", days: 183 },
	{ id: "365d", label: "365 Days", days: 365 }
];
const volumeRanges = volumeRangeOptions.map((range) => {
	const days = readingLife.dailyActivityDays.filter((day) => {
		const distance = dayDistanceFromToday(day, todayKey);
		return distance >= 0 && distance < range.days;
	});
	const maxVolume = Math.max(0, ...days.map((day) => day.pageEquivalents));
	return {
		...range,
		days,
		maxVolume,
		summary: {
			pageEquivalents: days.reduce((sum, day) => sum + day.pageEquivalents, 0),
			activeDays: days.filter((day) => day.active).length,
			booksRead: new Set(days.flatMap((day) => day.workBreakdown.map((work) => work.key))).size,
			progressUpdates: days.reduce((sum, day) => sum + day.progressUpdates, 0),
			finishes: days.reduce((sum, day) => sum + day.finishes, 0),
			incompleteUpdates: days.reduce((sum, day) => sum + day.incompleteUpdates, 0)
		}
	};
});
const hasReadingLifeData = finishedBooks.length > 0 || currentBooks.length > 0 || progressEvents.length > 0;
const yearOptions = readingLife.availableYears.length > 0 ? readingLife.availableYears : [currentYear];
const months = Array.from({ length: 12 }, (_, index) => index + 1);

recordPerformanceEventSafe({
	operationName: "page.reading-life",
	route: "/reading-life",
	totalMs: performance.now() - pagePerfStartedAt,
	success: !loadError,
	httpStatus: loadError ? 500 : 200,
	spans: pagePerfStages,
	metadata: {
		authenticated: !!viewerUserId,
		finishedCount: finishedBooks.length,
		currentCount: currentBooks.length,
		progressEventCount: progressEvents.length
	}
});
---

<Layout
	title="My Reading Life"
	metaDescription="A private reflection on your reading history, pace, genres, authors, and finished-book timeline."
	robots="noindex,nofollow"
	sectionLinks={sectionLinks}
>
	<div slot="right" class="reading-life-page">
		<header class="reading-life-hero">
			<p class="eyebrow">Personal reading reflection</p>
			<h1>My Reading Life</h1>
			<p class="hero-copy">A calm look at what you have finished, where your attention has gone, and how your reading has changed over time.</p>
			{loadError && <p class="note" role="status">Reading life is temporarily unavailable. {loadError}</p>}
			{!viewerUserId && (
				<div class="sign-in-panel">
					<h2>Log in to see your reading life.</h2>
					<p>This page is built from your shelves, finished dates, ratings, progress updates, authors, genres, and series.</p>
					<a class="button-link" href="/?next=/reading-life">Log in</a>
				</div>
			)}
		</header>

		{viewerUserId && (
			<>
				{!hasReadingLifeData && (
					<section class="empty-reading-life panel" aria-labelledby="empty-reading-life-title">
						<h2 id="empty-reading-life-title">Your reading story starts with one book.</h2>
						<p>Add your first book to begin tracking progress, finished dates, ratings, and the patterns that make this page useful.</p>
						<a class="button-link" href="/search">Find a Book</a>
					</section>
				)}
				<section id="overview" class="panel overview-panel" aria-labelledby="overview-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">This year</p>
							<h2 id="overview-title">A year in motion</h2>
						</div>
						<p>{readingLife.overview.readingPaceLabel}</p>
					</div>
					<div class="overview-grid">
						<article class="memory-card featured">
							<p>Books completed</p>
							<strong>{readingLife.overview.booksCompletedThisYear.toLocaleString()}</strong>
							<span>{readingLife.overview.goalProgress.detailLabel}</span>
						</article>
						<article class="memory-card">
							<p>Pages read</p>
							<strong>{readingLife.overview.pagesReadThisYear.toLocaleString()}</strong>
							<span>{readingLife.overview.averagePagesPerDay.toLocaleString()} pages per day</span>
						</article>
						<article class="memory-card">
							<p>Reading streak</p>
							<strong>{readingLife.overview.readingStreakDays.toLocaleString()}</strong>
							<span>{readingLife.overview.readingStreakDays === 1 ? "day" : "days"}</span>
						</article>
						<article class="memory-card">
							<p>Average rating</p>
							<strong>{readingLife.overview.averageRating > 0 ? readingLife.overview.averageRating.toFixed(2) : "—"}</strong>
							<span>{readingLife.overview.averageRating > 0 ? "across rated books" : "Rate finished books to see this"}</span>
						</article>
						<article class="memory-card">
							<p>Average book length</p>
							<strong>{readingLife.overview.averageBookLength > 0 ? readingLife.overview.averageBookLength.toLocaleString() : "—"}</strong>
							<span>pages</span>
						</article>
						<article class="memory-card">
							<p>Current books</p>
							<strong>{readingLife.overview.currentBooks.toLocaleString()}</strong>
							<span>{readingLife.overview.currentBooks === 1 ? "book in progress" : "books in progress"}</span>
						</article>
						<article class="memory-card">
							<p>Favorite genre</p>
							<strong>{readingLife.overview.favoriteGenre}</strong>
							<span>by finished books</span>
						</article>
						<article class="memory-card">
							<p>Favorite author</p>
							<strong>{readingLife.overview.favoriteAuthor}</strong>
							<span>by finished books</span>
						</article>
						<article class="memory-card">
							<p>Newest author discovered</p>
							<strong>{readingLife.overview.newestAuthorDiscovered}</strong>
							<span>from your finish history</span>
						</article>
					</div>
					<div class="goal-strip">
						<div>
							<p>Reading goal progress</p>
							<strong>
								{readingLife.overview.goalProgress.goal > 0
									? `${readingLife.overview.goalProgress.percent.toLocaleString()}% complete`
									: "No yearly goal set"}
							</strong>
							<span>{readingLife.overview.goalProgress.paceLabel}</span>
						</div>
						<div
							class="goal-bar progress-bar-track"
							role="progressbar"
							aria-label="Reading goal progress"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow={String(readingLife.overview.goalProgress.barPercent)}
						>
							<span class="progress-bar-fill" style={`width:${readingLife.overview.goalProgress.barPercent}%`}></span>
						</div>
					</div>
					{currentBooks.length > 0 && (
						<div class="current-books">
							<h3>Current books</h3>
							<ul>
								{currentBooks.map((book) => {
									const progress = book.totalPages && book.totalPages > 0
										? Math.min(100, Math.round(((book.currentPage || 0) / book.totalPages) * 100))
										: 0;
									return (
										<li>
											<a href={bookHref(book.id)}>
												{book.coverUrl ? <img src={book.coverUrl} alt="" loading="lazy" /> : <span class="cover-placeholder" aria-hidden="true">menu_book</span>}
												<span>
													<strong>{book.title}</strong>
													<small>{book.author}{progress > 0 ? ` · ${progress}%` : ""}</small>
												</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					)}
				</section>

				<section id="timeline" class="panel" aria-labelledby="timeline-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Finished books</p>
							<h2 id="timeline-title">Reading timeline</h2>
						</div>
						<p>{timelineItems.length.toLocaleString()} book{timelineItems.length === 1 ? "" : "s"} shown</p>
					</div>
					<form class="timeline-filters" method="get" action="/reading-life">
						<label>
							<span>Year</span>
							<select name="year">
								{yearOptions.map((year) => <option value={year} selected={year === selectedYear}>{year}</option>)}
							</select>
						</label>
						<label>
							<span>Month</span>
							<select name="month">
								<option value="" selected={selectedMonth === 0}>All months</option>
								{months.map((month) => <option value={month} selected={month === selectedMonth}>{formatMonthName(month)}</option>)}
							</select>
						</label>
						<label class="search-filter">
							<span>Search</span>
							<input type="search" name="q" value={timelineQuery} placeholder="Title, author, or genre" />
						</label>
						<button type="submit">Apply</button>
					</form>
					{timelineItems.length === 0 ? (
						<p class="empty-state">No finished books match these filters yet.</p>
					) : (
						<ol class="timeline-list">
							{timelineItems.map((book) => (
								<li>
									<a class="timeline-cover" href={bookHref(book.id)}>
										{book.coverUrl ? <img src={book.coverUrl} alt="" loading="lazy" /> : <span class="cover-placeholder" aria-hidden="true">menu_book</span>}
									</a>
									<div>
										<p class="timeline-date">{formatDate(book.dateKey)}</p>
										<h3><a href={bookHref(book.id)}>{book.title}</a></h3>
										<p class="meta">
											{timelineAuthorHref(book)
												? <a href={timelineAuthorHref(book)}>{book.author}</a>
												: book.author}
											{book.seriesName ? ` · ${book.seriesName}` : ""}
										</p>
										<p class="rating-line">{ratingStars(book.rating)} {formatRating(book.rating)}</p>
									</div>
								</li>
							))}
						</ol>
					)}
				</section>

				<section id="reading-activity" class="panel reading-activity-panel" aria-labelledby="reading-activity-title" data-reading-activity>
					<div class="section-head">
						<div>
							<p class="eyebrow">Daily reading</p>
							<h2 id="reading-activity-title">Reading activity</h2>
						</div>
						<p>{calendarSummary.activeDays.toLocaleString()} active days · {calendarSummary.completions.toLocaleString()} finishes</p>
					</div>
					<p class="text-alt">{calendarSummary.pageEquivalents.toLocaleString()} page equivalents across {calendarSummary.activeDays.toLocaleString()} active days in {currentYear}. Calendar shows consistency; Volume shows how much was recorded each day.</p>
					<div class="reading-activity-switcher" role="tablist" aria-label="Reading activity view">
						<button type="button" role="tab" aria-selected="true" aria-controls="calendar" id="reading-activity-calendar-tab" data-reading-activity-view="calendar">Calendar</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="volume" id="reading-activity-volume-tab" data-reading-activity-view="volume">Volume</button>
					</div>

					<div id="calendar" class="reading-activity-view" role="tabpanel" aria-labelledby="reading-activity-calendar-tab" data-reading-activity-panel="calendar">
						<div class="activity-view-head">
							<div>
								<h3>Calendar</h3>
								<p>When reading happened, and how consistently.</p>
							</div>
							<p>{formatPageEquivalents(calendarSummary.pageEquivalents)}</p>
						</div>
						<p class="text-alt">Calendar summary: {calendarSummary.pageEquivalents.toLocaleString()} page equivalents across {calendarSummary.activeDays.toLocaleString()} active days in {currentYear}.{calendarSummary.incompleteUpdates > 0 ? ` ${calendarSummary.incompleteUpdates.toLocaleString()} updates could not be converted.` : ""}</p>
						<div class="calendar-grid" role="group" aria-label={`Reading activity heatmap for ${currentYear}. ${calendarSummary.activeDays} active days, ${calendarSummary.pageEquivalents} page equivalents recorded, ${calendarSummary.completions} finished books.`}>
							{calendarDays.map((day) => (
								<button
									type="button"
									class={`calendar-day level-${day.level}`}
									data-activity-day
									data-calendar-day
									data-date-label={formatFullDate(day.date)}
									data-primary-line={calendarDayPrimaryLine(day)}
									data-pages={String(day.pages)}
									data-page-equivalents={String(day.pageEquivalents)}
									data-sessions={String(day.sessions)}
									data-progress-updates={String(day.progressUpdates)}
									data-books-read={String(day.booksRead)}
									data-completions={String(day.completions)}
									data-incomplete-updates={String(day.incompleteUpdates)}
									data-normalization-state={day.normalizationState}
									data-work-breakdown={activityDayWorkBreakdownJson(day)}
									data-finished-titles={JSON.stringify(day.finishedTitles)}
									aria-label={calendarDayAriaLabel(day)}
								></button>
							))}
						</div>
						<div class="calendar-legend" aria-label="Calendar intensity legend: less to more page-equivalent reading volume.">
							<span>Less</span>
							<i class="level-0"></i>
							<i class="level-1"></i>
							<i class="level-2"></i>
							<i class="level-3"></i>
							<i class="level-4"></i>
							<span>More</span>
						</div>
					</div>

					<div id="volume" class="reading-activity-view" role="tabpanel" aria-labelledby="reading-activity-volume-tab" data-reading-activity-panel="volume" hidden>
						<div class="activity-view-head">
							<div>
								<h3>Volume</h3>
								<p>How much reading was recorded on each day.</p>
							</div>
						</div>
						<div class="volume-range-switcher" role="tablist" aria-label="Reading volume range">
							{volumeRangeOptions.map((range) => (
								<button type="button" role="tab" aria-selected={range.id === "30d" ? "true" : "false"} data-volume-range-button={range.id}>{range.label}</button>
							))}
						</div>
						{volumeRanges.map((range) => (
							<div class="volume-range" data-volume-range={range.id} hidden={range.id !== "30d"}>
								<div class="volume-summary">
									<strong>{range.id === "today" ? "Today" : range.label}</strong>
									<span>{formatPageEquivalents(range.summary.pageEquivalents)} · {pluralize(range.summary.activeDays, "active day")} · {pluralize(range.summary.progressUpdates, "progress update")}</span>
								</div>
								<div class="volume-chart" role="group" aria-label={`Daily reading volume for ${range.label}. ${range.summary.pageEquivalents} page equivalents across ${range.days.length} days.`}>
									{range.days.map((day) => {
										const height = day.pageEquivalents > 0 && range.maxVolume > 0
											? Math.max(6, Math.round((day.pageEquivalents / range.maxVolume) * 100))
											: (day.active ? 6 : 0);
										return (
											<button
												type="button"
												class={`volume-day level-${day.level}`}
												style={`--bar-height: ${height}%`}
												data-activity-day
												data-volume-bar
												data-date-label={formatFullDate(day.date)}
												data-primary-line={calendarDayPrimaryLine(day)}
												data-pages={String(day.pages)}
												data-page-equivalents={String(day.pageEquivalents)}
												data-sessions={String(day.sessions)}
												data-progress-updates={String(day.progressUpdates)}
												data-books-read={String(day.booksRead)}
												data-completions={String(day.completions)}
												data-incomplete-updates={String(day.incompleteUpdates)}
												data-normalization-state={day.normalizationState}
												data-work-breakdown={activityDayWorkBreakdownJson(day)}
												data-finished-titles={JSON.stringify(day.finishedTitles)}
												aria-label={calendarDayAriaLabel(day)}
											><span></span></button>
										);
									})}
								</div>
								{range.summary.incompleteUpdates > 0 && (
									<p class="text-alt">{range.summary.incompleteUpdates.toLocaleString()} updates in this range could not be converted to page equivalents.</p>
								)}
							</div>
						))}
					</div>
					<div id="calendar-day-tooltip" class="calendar-day-tooltip" role="tooltip" hidden></div>
				</section>

				<section id="genres" class="panel" aria-labelledby="genres-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Taste over time</p>
							<h2 id="genres-title">Genre insights</h2>
						</div>
					</div>
					{readingLife.genreInsights.length === 0 ? (
						<p class="empty-state">Finish books with genre metadata to see genre insights.</p>
					) : (
						<div class="insight-columns">
							<div>
								<h3>Favorite genres</h3>
								<ul class="ranked-list">
									{readingLife.genreInsights.slice(0, 8).map((genre) => (
										<li>
											<span><strong>{genre.label}</strong><small>{genre.books.toLocaleString()} books · {genre.pages.toLocaleString()} pages</small></span>
											<em>{genre.averageRating > 0 ? `${genre.averageRating.toFixed(2)}/5` : "Unrated"}</em>
										</li>
									))}
								</ul>
							</div>
							<div>
								<h3>Genre trend</h3>
								<ul class="trend-list">
									{readingLife.genreTrend.slice(0, 10).map((row) => (
										<li><span>{row.year}</span><strong>{row.label}</strong><em>{row.books} book{row.books === 1 ? "" : "s"}</em></li>
									))}
								</ul>
							</div>
						</div>
					)}
				</section>

				<section id="authors" class="panel" aria-labelledby="authors-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Companions on the shelf</p>
							<h2 id="authors-title">Author insights</h2>
						</div>
					</div>
					{readingLife.authorInsights.mostRead.length === 0 ? (
						<p class="empty-state">Finish a book to begin building author insights.</p>
					) : (
						<div class="insight-columns three">
							<div>
								<h3>Most read</h3>
								<ul class="ranked-list compact">
									{readingLife.authorInsights.mostRead.slice(0, 6).map((author) => (
										<li><span><strong>{author.label}</strong><small>{author.books} book{author.books === 1 ? "" : "s"}</small></span><em>{author.pages.toLocaleString()} pages</em></li>
									))}
								</ul>
							</div>
							<div>
								<h3>Highest rated</h3>
								<ul class="ranked-list compact">
									{readingLife.authorInsights.highestRated.slice(0, 6).map((author) => (
										<li><span><strong>{author.label}</strong><small>{author.books} book{author.books === 1 ? "" : "s"}</small></span><em>{author.averageRating.toFixed(2)}/5</em></li>
									))}
								</ul>
							</div>
							<div>
								<h3>New authors discovered</h3>
								<ul class="ranked-list compact">
									{readingLife.authorInsights.newAuthors.slice(0, 6).map((author) => (
										<li><span><strong>{author.label}</strong><small>{author.firstFinishedDate ? formatDate(author.firstFinishedDate) : ""}</small></span><em>new</em></li>
									))}
								</ul>
							</div>
						</div>
					)}
				</section>

				<section id="fun-statistics" class="panel" aria-labelledby="fun-stats-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Small discoveries</p>
							<h2 id="fun-stats-title">Fun statistics</h2>
						</div>
					</div>
					<div class="fun-grid">
						<article><p>Longest book</p><strong>{bookTitle(readingLife.funStats.longestBook)}</strong><span>{bookMeta(readingLife.funStats.longestBook)}</span></article>
						<article><p>Shortest book</p><strong>{bookTitle(readingLife.funStats.shortestBook)}</strong><span>{bookMeta(readingLife.funStats.shortestBook)}</span></article>
						<article><p>Oldest publication</p><strong>{bookTitle(readingLife.funStats.oldestPublication)}</strong><span>{bookMeta(readingLife.funStats.oldestPublication)}</span></article>
						<article><p>Newest publication</p><strong>{bookTitle(readingLife.funStats.newestPublication)}</strong><span>{bookMeta(readingLife.funStats.newestPublication)}</span></article>
						<article><p>Highest-rated</p><strong>{bookTitle(readingLife.funStats.highestRated)}</strong><span>{bookMeta(readingLife.funStats.highestRated, formatRating(readingLife.funStats.highestRated?.rating))}</span></article>
						<article><p>Lowest-rated</p><strong>{bookTitle(readingLife.funStats.lowestRated)}</strong><span>{bookMeta(readingLife.funStats.lowestRated, formatRating(readingLife.funStats.lowestRated?.rating))}</span></article>
						<article><p>Most re-read</p><strong>{readingLife.funStats.mostRereadLabel}</strong><span>DogEared stores one shelf entry per book today</span></article>
						<article><p>Most common decade</p><strong>{readingLife.funStats.mostCommonDecade}</strong><span>by publication year</span></article>
						<article><p>Average publication year</p><strong>{readingLife.funStats.averagePublicationYear > 0 ? readingLife.funStats.averagePublicationYear : "—"}</strong><span>across dated books</span></article>
					</div>
				</section>

				<section id="journey" class="panel" aria-labelledby="journey-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Built for Year in Books</p>
							<h2 id="journey-title">Reading journey</h2>
						</div>
					</div>
					{readingLife.yearSummaries.length === 0 ? (
						<p class="empty-state">Your yearly summaries will appear as you finish books.</p>
					) : (
						<ol class="year-list">
							{readingLife.yearSummaries.map((year) => (
								<li>
									<strong>{year.year}</strong>
									<span>{year.books.toLocaleString()} books</span>
									<span>{year.pages.toLocaleString()} pages</span>
									<span>{year.genres.toLocaleString()} genres</span>
									<span>{year.authors.toLocaleString()} authors</span>
									<span>{year.series.toLocaleString()} series</span>
									<span>{year.averageRating > 0 ? `${year.averageRating.toFixed(2)}/5 average` : "unrated"}</span>
									<em>{year.topGenre}</em>
								</li>
							))}
						</ol>
					)}
				</section>
			</>
		)}
	</div>
</Layout>

