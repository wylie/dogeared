		min-height: var(--bar-min-height, 0);
		border-radius: 4px 4px 2px 2px;
		background: rgba(87, 117, 144, 0.14);
	}
	.volume-day.level-1 span { background: #d9ead2; }
	.volume-day.level-2 span { background: #bfd9ab; }
	.volume-day.level-3 span { background: #75bd9f; }
	.volume-day.level-4 span { background: #277da1; }
	.volume-day:hover span,
	.volume-day:focus-visible span {
		box-shadow: 0 0 0 2px rgba(31, 122, 69, 0.5);
		outline: 2px solid rgba(31, 122, 69, 0.68);
		outline-offset: 1px;
	}
	.insight-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.insight-columns.three {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.insight-columns h3 {
		margin: 0 0 0.5rem;
	}
	.ranked-list,
	.trend-list {
		display: grid;
		gap: 0.5rem;
	}
	.ranked-list li,
	.trend-list li,
	.year-list li {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		align-items: center;
		border: var(--border-subtle);
		background: rgba(255, 255, 255, 0.64);
		border-radius: var(--radius-sm);
		padding: 0.55rem 0.65rem;
	}
	.ranked-list strong,
	.ranked-list small {
		display: block;
	}
	.ranked-list small,
	.trend-list span,
	.trend-list em,
	.year-list span,
	.year-list em {
		color: var(--color-text-muted);
		font-size: 0.84rem;
		font-style: normal;
	}
	.ranked-list em {
		color: var(--color-rating);
		font-style: normal;
		font-weight: 800;
		white-space: nowrap;
	}
	.year-list {
		display: grid;
		gap: 0.6rem;
	}
	.year-list li {
		display: grid;
		grid-template-columns: 70px repeat(6, minmax(0, 1fr)) minmax(120px, 1fr);
	}
	.year-list strong {
		font-size: 1.1rem;
	}
	@media (max-width: 820px) {
		.section-head,
		.goal-strip {
			grid-template-columns: 1fr;
			display: grid;
		}
		.timeline-filters,
		.insight-columns,
		.insight-columns.three {
			grid-template-columns: 1fr;
		}
		.timeline-filters button {
			width: 100%;
		}
		.activity-view-head,
		.volume-summary {
			display: grid;
			align-items: start;
		}
		.reading-activity-switcher,
		.volume-range-switcher {
			width: 100%;
		}
		.year-list li {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.year-list strong {
			grid-column: 1 / -1;
		}
	}
</style>

<script>
	const READING_LIFE_REFRESH_EVENT = "dogeared:reading-data-changed";
	let readingLifeRefreshTimer = 0;
	let activeCalendarDay = null;
	let hoveredCalendarDay = null;

	function pluralizeCalendarCount(count, singular, plural = `${singular}s`) {
		return `${Number(count || 0).toLocaleString()} ${Number(count || 0) === 1 ? singular : plural}`;
	}

	function getCalendarTooltip() {
		return document.getElementById("calendar-day-tooltip");
	}

	function getActivityDayTarget(event) {
		return event.target instanceof Element ? event.target.closest("[data-activity-day]") : null;
	}

	function parseFinishedTitles(button) {
		try {
			const parsed = JSON.parse(String(button?.dataset?.finishedTitles || "[]"));
			return Array.isArray(parsed) ? parsed.map((title) => String(title || "").trim()).filter(Boolean) : [];
		} catch {
			return [];
		}
	}

	function parseWorkBreakdown(button) {
		try {
			const parsed = JSON.parse(String(button?.dataset?.workBreakdown || "[]"));
			return Array.isArray(parsed) ? parsed.map((work) => ({
				title: String(work?.title || "Untitled").trim(),
				author: String(work?.author || "").trim(),
				pageEquivalents: Math.max(0, Number(work?.pageEquivalents || 0) || 0),
				progressUpdates: Math.max(0, Number(work?.progressUpdates || 0) || 0),
				finishes: Math.max(0, Number(work?.finishes || 0) || 0),
				incompleteUpdates: Math.max(0, Number(work?.incompleteUpdates || 0) || 0),
				normalizationState: String(work?.normalizationState || "")
			})).filter((work) => work.title) : [];
		} catch {
			return [];
		}
	}

	function renderCalendarTooltip(button) {
		const tooltip = getCalendarTooltip();
		if (!(tooltip instanceof HTMLElement)) return null;
		const pageEquivalents = Math.max(0, Number(button.dataset.pageEquivalents || button.dataset.pages || 0) || 0);
		const progressUpdates = Math.max(0, Number(button.dataset.progressUpdates || button.dataset.sessions || 0) || 0);
		const booksRead = Math.max(0, Number(button.dataset.booksRead || 0) || 0);
		const completions = Math.max(0, Number(button.dataset.completions || 0) || 0);
		const incompleteUpdates = Math.max(0, Number(button.dataset.incompleteUpdates || 0) || 0);
		const finishedTitles = parseFinishedTitles(button);
		const workBreakdown = parseWorkBreakdown(button);
		const hasReading = pageEquivalents > 0 || progressUpdates > 0 || booksRead > 0 || completions > 0 || incompleteUpdates > 0;
		const fragment = document.createDocumentFragment();
		const heading = document.createElement("p");
		heading.className = "calendar-tooltip-date";
		heading.textContent = String(button.dataset.dateLabel || "Date unavailable");
		fragment.append(heading);
		const primary = document.createElement("p");
		primary.className = "calendar-tooltip-line";
		primary.textContent = String(button.dataset.primaryLine || (hasReading ? `${pluralizeCalendarCount(pageEquivalents, "page equivalent")} recorded` : "No reading recorded."));
		fragment.append(primary);
		if (hasReading) {
			const sessionsLine = document.createElement("p");
			sessionsLine.className = "calendar-tooltip-line";
			sessionsLine.textContent = `${pluralizeCalendarCount(progressUpdates, "progress update")} · ${pluralizeCalendarCount(booksRead, "book")} · ${pluralizeCalendarCount(completions, "finish", "finishes")}`;
			fragment.append(sessionsLine);
		}
		if (workBreakdown.length > 0) {
			const label = document.createElement("p");
			label.className = "calendar-tooltip-finished-label";
			label.textContent = "Books:";
			fragment.append(label);
			const list = document.createElement("ul");
			list.className = "calendar-tooltip-finished-list";
			for (const work of workBreakdown.slice(0, 6)) {
				const item = document.createElement("li");
				const suffix = work.pageEquivalents > 0
					? `${pluralizeCalendarCount(work.pageEquivalents, "page equivalent")}${work.normalizationState === "derived" ? " derived from finish" : ""}`
					: work.incompleteUpdates > 0
						? "not converted"
						: "";
				item.textContent = [work.title, suffix].filter(Boolean).join(" — ");
				list.append(item);
			}
			fragment.append(list);
		}
		if (incompleteUpdates > 0) {
			const incomplete = document.createElement("p");
			incomplete.className = "calendar-tooltip-line";
			incomplete.textContent = `${pluralizeCalendarCount(incompleteUpdates, "additional update")} could not be converted.`;
			fragment.append(incomplete);
		}
		if (finishedTitles.length > 0) {
			const label = document.createElement("p");
			label.className = "calendar-tooltip-finished-label";
			label.textContent = "Finished:";
			fragment.append(label);
			const list = document.createElement("ul");
			list.className = "calendar-tooltip-finished-list";
			for (const title of finishedTitles) {
				const item = document.createElement("li");
				item.textContent = title;
				list.append(item);
			}
			fragment.append(list);
		}
		tooltip.replaceChildren(fragment);
		return tooltip;
	}

	function clampCalendarTooltip(value, min, max) {
		if (max < min) return min;
		return Math.max(min, Math.min(max, value));
	}

	function positionCalendarTooltip(button) {
		const tooltip = getCalendarTooltip();
		if (!(tooltip instanceof HTMLElement)) return;
		const rect = button.getBoundingClientRect();
		const gutter = 12;
		const gap = 10;
		const bottomReserve = 92;
		const bottomLimit = Math.max(gutter, window.innerHeight - gutter - bottomReserve);
		tooltip.hidden = false;
		tooltip.style.visibility = "hidden";
		tooltip.style.left = "0px";
		tooltip.style.top = "0px";
		const tipRect = tooltip.getBoundingClientRect();
		const centeredLeft = rect.left + (rect.width / 2) - (tipRect.width / 2);
		const centeredTop = rect.top + (rect.height / 2) - (tipRect.height / 2);
		const placements = [
			{
				name: "bottom",
				fits: rect.bottom + gap + tipRect.height <= bottomLimit,
				space: Math.max(0, bottomLimit - rect.bottom - gap),
				left: clampCalendarTooltip(centeredLeft, gutter, window.innerWidth - gutter - tipRect.width),
				top: rect.bottom + gap
			},
			{
				name: "top",
				fits: rect.top - gap - tipRect.height >= gutter,
				space: Math.max(0, rect.top - gutter - gap),
				left: clampCalendarTooltip(centeredLeft, gutter, window.innerWidth - gutter - tipRect.width),
				top: rect.top - gap - tipRect.height
			},
			{
				name: "right",
				fits: rect.right + gap + tipRect.width <= window.innerWidth - gutter,
				space: Math.max(0, window.innerWidth - gutter - rect.right - gap),
				left: rect.right + gap,
				top: clampCalendarTooltip(centeredTop, gutter, bottomLimit - tipRect.height)
			},
			{
				name: "left",
				fits: rect.left - gap - tipRect.width >= gutter,
				space: Math.max(0, rect.left - gutter - gap),
				left: rect.left - gap - tipRect.width,
				top: clampCalendarTooltip(centeredTop, gutter, bottomLimit - tipRect.height)
			}
		];
		const placement = placements.find((item) => item.fits) || [...placements].sort((a, b) => b.space - a.space)[0];
		const left = clampCalendarTooltip(placement.left, gutter, window.innerWidth - gutter - tipRect.width);
		const top = clampCalendarTooltip(placement.top, gutter, bottomLimit - tipRect.height);
		tooltip.dataset.placement = placement.name;
		tooltip.style.left = `${Math.round(left)}px`;
		tooltip.style.top = `${Math.round(top)}px`;
		tooltip.style.setProperty("--arrow-x", `${Math.round(clampCalendarTooltip(rect.left + (rect.width / 2) - left, 14, tipRect.width - 14))}px`);
		tooltip.style.setProperty("--arrow-y", `${Math.round(clampCalendarTooltip(rect.top + (rect.height / 2) - top, 14, tipRect.height - 14))}px`);
		tooltip.style.visibility = "";
	}

	function showCalendarTooltip(button) {
		if (!(button instanceof HTMLElement)) return;
		const tooltip = renderCalendarTooltip(button);
		if (!(tooltip instanceof HTMLElement)) return;
		if (activeCalendarDay instanceof HTMLElement && activeCalendarDay !== button) {
			activeCalendarDay.removeAttribute("aria-describedby");
		}
		activeCalendarDay = button;
		button.setAttribute("aria-describedby", tooltip.id);
		positionCalendarTooltip(button);
	}

	function hideCalendarTooltip() {
		const tooltip = getCalendarTooltip();
		if (activeCalendarDay instanceof HTMLElement) activeCalendarDay.removeAttribute("aria-describedby");
		activeCalendarDay = null;
		if (tooltip instanceof HTMLElement) tooltip.hidden = true;
	}

	function syncCalendarTooltipPosition() {
		if (!(activeCalendarDay instanceof HTMLElement)) return;
		if (!document.body.contains(activeCalendarDay)) {
			hideCalendarTooltip();
			return;
		}
		const rect = activeCalendarDay.getBoundingClientRect();
		if (rect.bottom <= 0 || rect.top >= window.innerHeight || rect.right <= 0 || rect.left >= window.innerWidth) {
			hideCalendarTooltip();
			return;
		}
		positionCalendarTooltip(activeCalendarDay);
	}

	async function refreshReadingLifeSections() {
		try {
			const response = await fetch(window.location.href, {
				credentials: "same-origin",
				headers: { "X-Dogeared-Partial": "reading-life-summary" }
			});
			if (!response.ok) return;
			const html = await response.text();
			const doc = new DOMParser().parseFromString(html, "text/html");
			for (const id of ["overview", "timeline", "reading-activity"]) {
				const current = document.getElementById(id);
				const next = doc.getElementById(id);
				if (current instanceof HTMLElement && next instanceof HTMLElement) current.replaceWith(next);
			}
			hideCalendarTooltip();
			restoreReadingActivityControls();
		} catch {
			// Keep the current view if the targeted refresh is unavailable.
		}
	}

	function scheduleReadingLifeRefresh() {
		window.clearTimeout(readingLifeRefreshTimer);
		readingLifeRefreshTimer = window.setTimeout(() => {
			void refreshReadingLifeSections();
		}, 120);
	}

	window.addEventListener(READING_LIFE_REFRESH_EVENT, scheduleReadingLifeRefresh);
	window.addEventListener("storage", (event) => {
		if (event.key === "dogeared:reading-data-changed-at") scheduleReadingLifeRefresh();
	});
	try {
		const channel = new BroadcastChannel("dogeared:reading-data");
		channel.addEventListener("message", (event) => {
			if (event.data?.type === "changed") scheduleReadingLifeRefresh();
		});
		window.addEventListener("pagehide", () => channel.close(), { once: true });
	} catch {
		// Storage and same-page events cover browsers without BroadcastChannel.
	}

	function applyReadingActivityView(view) {
		const normalized = view === "volume" ? "volume" : "calendar";
		for (const button of document.querySelectorAll("[data-reading-activity-view]")) {
			const selected = button.getAttribute("data-reading-activity-view") === normalized;
			button.setAttribute("aria-selected", selected ? "true" : "false");
		}
		for (const panel of document.querySelectorAll("[data-reading-activity-panel]")) {
			if (!(panel instanceof HTMLElement)) continue;
			panel.hidden = panel.getAttribute("data-reading-activity-panel") !== normalized;
		}
		try {
			sessionStorage.setItem("dogeared:reading-activity-view", normalized);
		} catch {
			// Session persistence is a convenience, not required.
		}
		hideCalendarTooltip();
	}

	function applyVolumeRange(range) {
		const normalized = range || "30d";
		for (const button of document.querySelectorAll("[data-volume-range-button]")) {
			const selected = button.getAttribute("data-volume-range-button") === normalized;
			button.setAttribute("aria-selected", selected ? "true" : "false");
		}
		for (const panel of document.querySelectorAll("[data-volume-range]")) {
			if (!(panel instanceof HTMLElement)) continue;
			panel.hidden = panel.getAttribute("data-volume-range") !== normalized;
		}
		try {
			sessionStorage.setItem("dogeared:reading-volume-range", normalized);
		} catch {
			// Session persistence is a convenience, not required.
		}
		hideCalendarTooltip();
	}

	function restoreReadingActivityControls() {
		try {
			applyReadingActivityView(sessionStorage.getItem("dogeared:reading-activity-view") || "calendar");
			applyVolumeRange(sessionStorage.getItem("dogeared:reading-volume-range") || "30d");
		} catch {
			applyReadingActivityView("calendar");
			applyVolumeRange("30d");
		}
	}

	document.addEventListener("click", (event) => {
		const viewButton = event.target instanceof Element ? event.target.closest("[data-reading-activity-view]") : null;
		if (viewButton instanceof HTMLElement) {
			applyReadingActivityView(viewButton.getAttribute("data-reading-activity-view"));
			return;
		}
		const rangeButton = event.target instanceof Element ? event.target.closest("[data-volume-range-button]") : null;
		if (rangeButton instanceof HTMLElement) {
			applyVolumeRange(rangeButton.getAttribute("data-volume-range-button"));
			return;
		}
		const target = getActivityDayTarget(event);
		if (target instanceof HTMLElement) {
			showCalendarTooltip(target);
			return;
		}
		hideCalendarTooltip();
	});

	document.addEventListener("pointerover", (event) => {
		const target = getActivityDayTarget(event);
		if (!(target instanceof HTMLElement)) return;
		hoveredCalendarDay = target;
		showCalendarTooltip(target);
	});
	document.addEventListener("pointerout", (event) => {
		const target = getActivityDayTarget(event);
		if (!(target instanceof HTMLElement)) return;
		const related = event.relatedTarget instanceof Element ? event.relatedTarget.closest("[data-activity-day]") : null;
		if (related === target) return;
		if (hoveredCalendarDay === target) hoveredCalendarDay = null;
		if (document.activeElement !== target) hideCalendarTooltip();
	});
	document.addEventListener("focusin", (event) => {
		const target = getActivityDayTarget(event);
		if (target instanceof HTMLElement) showCalendarTooltip(target);
	});
	document.addEventListener("focusout", (event) => {
		const target = getActivityDayTarget(event);
		if (!(target instanceof HTMLElement)) return;
		window.setTimeout(() => {
			if (hoveredCalendarDay !== target && document.activeElement !== target) hideCalendarTooltip();
		}, 0);
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") hideCalendarTooltip();
	});
	window.addEventListener("scroll", syncCalendarTooltipPosition, { passive: true });
	window.addEventListener("resize", syncCalendarTooltipPosition);
	restoreReadingActivityControls();
</script>
