---
import type { ExternalAuthorBook } from "../lib/externalAuthorBooks";
import BookCard from "./BookCard.astro";
import ShelfDropdown from "./ShelfDropdown.astro";
type Props = { books?: ExternalAuthorBook[] };
const { books = [] } = Astro.props as Props;
---

<section class="external-books-section" aria-labelledby="external-books-title">
	<div class="external-books-head">
		<div>
			<h2 id="external-books-title">Not Yet In DogEared</h2>
			<p>These books have not been added to DogEared yet. Add one to your shelves to help expand DogEared's catalog.</p>
		</div>
	</div>
	{books.length === 0 ? (
		<p class="external-empty">No additional books were found for this author.</p>
	) : (
		<ul class="external-book-grid">
			{books.map((book) => (
				<BookCard
					title={book.title}
					author={book.author}
					thumbnail={book.coverUrl}
					publishedLabel={book.publishedYear > 0 ? String(book.publishedYear) : ""}
					showCommunityStats={false}
				>
					<div slot="actions">
						<ShelfDropdown attrs={{
							"data-book-id": "",
							"data-title": book.title,
							"data-author": book.author,
							"data-cover": book.coverUrl,
							"data-isbn10": book.isbn10,
							"data-isbn13": book.isbn13,
							"data-published-date": book.publishedYear > 0 ? String(book.publishedYear) : "",
							"data-source": "open_library",
							"data-source-work-id": book.sourceWorkId,
							"data-source-url": book.sourceUrl
						}} />
					</div>
				</BookCard>
			))}
		</ul>
	)}
</section>

<style>
	.external-books-section { margin-top: 1.3rem; }
	.external-books-head h2 { margin: 0; }
	.external-books-head p, .external-empty { margin: 0.3rem 0 0; color: #56616d; line-height: 1.45; }
	.external-book-grid { list-style: none; margin: 0.7rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 760px) { .external-book-grid { grid-template-columns: 1fr; } }
</style>
