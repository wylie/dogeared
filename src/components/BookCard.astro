---
import Chip from "./Chip.astro";
import { displayBookCoverUrl, normalizeBookCoverUrl } from "../lib/bookCovers";
type Props = {
	title: string;
	titleHref?: string;
	author?: string;
	authorHref?: string;
	thumbnail?: string;
	description?: string;
	readers?: number;
	shelfEntries?: number;
	publishedLabel?: string;
	pageCount?: number;
	averageRating?: number;
	genres?: string[];
	topics?: string[];
	showCommunityStats?: boolean;
	attrs?: Record<string, string>;
};

const {
	title,
	titleHref = "",
	author = "",
	authorHref = "",
	thumbnail = "",
	description = "",
	readers = -1,
	shelfEntries = -1,
	publishedLabel = "",
	pageCount = 0,
	averageRating = 0,
	genres = [],
	topics = [],
	showCommunityStats = true,
	attrs = {}
} = Astro.props as Props;

const hasTopRight = Astro.slots.has("topRight");
const socialSlotHtml = Astro.slots.has("social") ? (await Astro.slots.render("social")).trim() : "";
const hasSocial = socialSlotHtml.length > 0;
const hasSynopsisText = !!String(description || "").trim() && !/^synopsis unavailable/i.test(String(description || "").trim());
const normalizedReaders = Number(readers);
const normalizedShelves = Number(shelfEntries);
const normalizedPages = Number(pageCount);
const normalizedRating = Math.max(0, Math.min(5, Number(averageRating) || 0));
const normalizedThumbnail = normalizeBookCoverUrl(thumbnail);
const displayThumbnail = displayBookCoverUrl(normalizedThumbnail);
const normalizedGenres = Array.from(new Set((Array.isArray(genres) ? genres : []).map((genre) => String(genre || "").trim()).filter(Boolean))).slice(0, 4);
const normalizedTopics = Array.from(new Set((Array.isArray(topics) ? topics : []).map((topic) => String(topic || "").trim()).filter(Boolean))).slice(0, 4);

function renderAverageStars(value: number) {
	const rounded = Math.round(value);
	return Array.from({ length: 5 }, (_, index) => (index < rounded ? "★" : "☆")).join("");
}
---

<li class="book-card" {...attrs}>
	{titleHref && (
		<details class="card-menu">
			<summary aria-label={`Open actions for ${title}`} title="More actions">
				<span class="material-icons" aria-hidden="true">more_vert</span>
			</summary>
			<div class="card-menu-panel">
				<button
					type="button"
					class="card-menu-item"
					data-action="share-book"
					data-share-title={title}
					data-share-url={titleHref}
				>
					<span class="material-icons" aria-hidden="true">share</span>
					<span>Share</span>
				</button>
			</div>
		</details>
	)}
	{hasTopRight && <div class="top-right"><slot name="topRight" /></div>}
	<div class="cover-wrap">
		{normalizedThumbnail ? (
			titleHref
				? <a href={titleHref} aria-label={`View ${title}`}><img class="cover" src={displayThumbnail} alt={`${title} cover`} loading="lazy" decoding="async" width="84" height="126" sizes="(max-width: 420px) 72px, 84px" /></a>
				: <img class="cover" src={displayThumbnail} alt={`${title} cover`} loading="lazy" decoding="async" width="84" height="126" sizes="(max-width: 420px) 72px, 84px" />
		) : (
			<div class="cover cover-placeholder"><span class="material-icons" aria-hidden="true">menu_book</span></div>
		)}
		<div class="cover-actions">
			<slot name="actions" />
		</div>
	</div>
	<div class="card-body">
		<slot name="preTitle" />
		<h3>{titleHref ? <a href={titleHref}>{title}</a> : title}</h3>
		{author && (
			<p class="meta">
				by{" "}
				{authorHref
					? <a class="author-link" href={authorHref}>{author}</a>
					: author}
			</p>
		)}
		{showCommunityStats && <p class="meta">Readers: {Number.isFinite(normalizedReaders) && normalizedReaders >= 0 ? normalizedReaders.toLocaleString() : "—"} · Shelf entries: {Number.isFinite(normalizedShelves) && normalizedShelves >= 0 ? normalizedShelves.toLocaleString() : "—"}</p>}
		{String(publishedLabel || "").trim() && (
			<p class="meta">Published: {String(publishedLabel || "").trim()}</p>
		)}
		{Number.isFinite(normalizedPages) && normalizedPages > 0 && (
			<p class="meta">Pages: {normalizedPages.toLocaleString()}</p>
		)}
		{normalizedRating > 0 && (
			<p class="meta">Average rating: {renderAverageStars(normalizedRating)} {normalizedRating.toFixed(2)}</p>
		)}
		{normalizedGenres.length > 0 && (
			<div class="genre-links" aria-label="Genres">
				{normalizedGenres.map((genre) => (
					<Chip label={genre} href={`/related?kind=genre&value=${encodeURIComponent(genre)}`} kind="genre" />
				))}
			</div>
		)}
		{normalizedTopics.length > 0 && (
			<div class="topic-links" aria-label="Topics">
				{normalizedTopics.map((topic) => (
					<Chip label={topic} href={`/related?kind=topic&value=${encodeURIComponent(topic)}`} kind="topic" />
				))}
			</div>
		)}
		<slot name="preMeta" />
		<slot name="meta" />
		{description && (
			<div class="description-wrap">
				<p class="description">{description}</p>
				{titleHref && hasSynopsisText && <a class="description-more" href={titleHref}>Continue reading</a>}
			</div>
		)}
		<div class="card-tail">
			<slot name="footer" />
			<slot />
		</div>
	</div>
	{hasSocial && (
		<div class="card-social" set:html={socialSlotHtml}></div>
	)}
</li>

<style>
	.book-card {
		border: var(--border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-surface-raised);
		padding: 0.68rem;
		position: relative;
		z-index: 0;
		isolation: isolate;
		overflow: visible;
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr);
		gap: 0.68rem;
		backdrop-filter: blur(10px);
		transition:
			background-color var(--transition-medium),
			border-color var(--transition-medium),
			transform var(--transition-medium);
	}
	.book-card:hover {
		background: #fff;
		border-color: var(--color-border);
	}
	.book-card:has(.shelf-menu:not([hidden])) {
		z-index: 50;
	}
	.top-right {
		position: absolute;
		top: 0.65rem;
		right: 2.1rem;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.28rem;
	}
	.card-menu {
		position: absolute;
		top: 0.45rem;
		right: 0.4rem;
		z-index: 70;
	}
	.card-menu > summary {
		list-style: none;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border-radius: var(--radius-sm);
		cursor: pointer;
		color: var(--color-text-subtle);
	}
	.card-menu > summary::-webkit-details-marker {
		display: none;
	}
	.card-menu[open] > summary,
	.card-menu > summary:hover {
		background: rgba(87, 117, 144, 0.1);
		color: var(--color-text);
	}
	.card-menu-panel {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		min-width: 132px;
		background: #fff;
		border: none;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-popover);
		padding: 0.25rem;
	}
	.card-menu-item {
		width: 100%;
		border: none;
		background: transparent;
		border-radius: var(--radius-sm);
		padding: 0.42rem 0.48rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--color-text);
		font: inherit;
		font-size: 0.86rem;
		cursor: pointer;
	}
	.card-menu-item:hover {
		background: rgba(87, 117, 144, 0.09);
	}
	.card-menu-item .material-icons {
		font-size: 1rem;
	}
	.cover-wrap {
		width: 84px;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.cover-wrap a {
		display: block;
		width: 100%;
	}
	.cover {
		width: 84px;
		height: 126px;
		object-fit: cover;
		border-radius: 7px;
		background: rgba(255, 255, 255, 0.62);
		box-shadow: var(--shadow-xs);
	}
	.cover-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-subtle);
		border: var(--border-subtle);
		box-shadow: none;
	}
	.card-body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		min-width: 0;
	}
	.card-body h3 {
		margin: 0;
		padding-right: 1.7rem;
		font-size: 1.02rem;
		line-height: 1.22;
		font-weight: 680;
		overflow-wrap: anywhere;
	}
	.card-body h3 a {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		color: inherit;
		text-decoration: none;
	}
	.card-body h3 a:hover {
		color: var(--color-nav-hover);
		text-decoration: none;
	}
	.meta,
	:global(.book-card .meta) {
		margin: 0.18rem 0;
		font-size: 0.84rem;
		line-height: 1.32;
		color: var(--color-text-muted);
	}
	:global(.book-card .meta + .meta) {
		margin-top: 0.1rem;
	}
	.meta :global(a.author-link) {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
	}
	.genre-links, .topic-links { display: flex; flex-wrap: wrap; gap: 0.28rem; margin-top: 0.32rem; }
	.genre-links :global(.chip), .topic-links :global(.chip) { padding: 0.16rem 0.5rem; font-size: 0.74rem; font-weight: 650; }
	.description-wrap {
		margin-top: 0.3rem;
	}
	.description {
		margin: 0.22rem 0 0;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		line-height: 1.42;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.description-more {
		display: inline-block;
		margin-top: 0.35rem;
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-nav);
		text-decoration: none;
	}
	.description-more:hover,
	.description-more:focus-visible {
		color: var(--color-nav-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.card-tail {
		margin-top: 0.34rem;
		display: flex;
		flex-direction: column;
		gap: 0.24rem;
	}
	.card-tail:empty {
		display: none;
		margin-top: 0;
	}
	.cover-actions {
		width: 100%;
		margin: 0;
		padding: 0;
	}
	.cover-actions :global(.shelf-dropdown) {
		width: 100%;
		min-width: 0;
		--shelf-trigger-width: 100%;
		--shelf-trigger-height: 32px;
		--shelf-trigger-min-width: 100%;
		--shelf-trigger-min-height: 32px;
		--shelf-trigger-radius: var(--radius-sm);
		--shelf-trigger-icon-size: 1.15rem;
	}
	.cover-actions :global(.shelf-state) {
		display: none !important;
	}
	.cover-actions :global(.shelf-dropdown .shelf-menu) {
		top: calc(100% + 4px);
		right: auto !important;
		left: 0 !important;
	}
	.card-social {
		grid-column: 1 / -1;
		margin-top: 0.18rem;
		padding-top: 0.48rem;
		border-top: var(--border-subtle);
		/* display: flex; */
		/* align-items: center; */
		gap: 0.6rem;
		min-width: 0;
	}
	@media (max-width: 420px) {
		.book-card {
			grid-template-columns: 72px minmax(0, 1fr);
			gap: 0.55rem;
			padding: 0.6rem;
		}
		.cover-wrap {
			width: 72px;
		}
		.cover {
			width: 72px;
			height: 108px;
		}
		.card-menu {
			top: 0.35rem;
			right: 0.3rem;
		}
		.cover-actions :global(.shelf-dropdown) {
			--shelf-trigger-height: 30px;
			--shelf-trigger-min-height: 30px;
		}
		.card-body h3 {
			padding-right: 1.55rem;
			font-size: 0.95rem;
		}
		.description {
			font-size: 0.82rem;
			line-height: 1.35;
			-webkit-line-clamp: 6;
		}
		.card-social {
			padding-top: 0.38rem;
			gap: 0.42rem;
		}
	}
</style>

<script>
	if (!(window as typeof window & { __bookCardMenuBound?: boolean }).__bookCardMenuBound) {
		(window as typeof window & { __bookCardMenuBound?: boolean }).__bookCardMenuBound = true;
		document.addEventListener("click", async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const shareButton = target.closest('[data-action="share-book"]');
			if (!(shareButton instanceof HTMLButtonElement)) return;
			event.preventDefault();
			event.stopPropagation();
			const title = String(shareButton.dataset.shareTitle || "").trim();
			const rawUrl = String(shareButton.dataset.shareUrl || "").trim();
			if (!rawUrl) return;
			const absoluteUrl = new URL(rawUrl, window.location.origin).toString();
			try {
				if (navigator.share) {
					await navigator.share({ title, text: title, url: absoluteUrl });
				} else if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(absoluteUrl);
					shareButton.querySelector("span:last-child").textContent = "Copied";
					setTimeout(() => {
						const label = shareButton.querySelector("span:last-child");
						if (label) label.textContent = "Share";
					}, 1200);
				}
			} catch {
				// Ignore canceled share actions.
			}
			const details = shareButton.closest("details");
			if (details instanceof HTMLDetailsElement) details.open = false;
		});

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			if (target.closest(".card-menu")) return;
			for (const menu of document.querySelectorAll(".card-menu[open]")) {
				if (menu instanceof HTMLDetailsElement) menu.open = false;
			}
		});
	}
</script>
