---
type Props = {
	title: string;
	titleHref?: string;
	author?: string;
	authorHref?: string;
	thumbnail?: string;
	description?: string;
};

const {
	title,
	titleHref = "",
	author = "",
	authorHref = "",
	thumbnail = "",
	description = ""
} = Astro.props as Props;

const hasTopRight = Astro.slots.has("topRight");
const hasSynopsisText = !!String(description || "").trim() && !/^synopsis unavailable/i.test(String(description || "").trim());
---

<li class="book-card">
	{titleHref && (
		<details class="card-menu">
			<summary aria-label={`Open actions for ${title}`} title="More actions">
				<span class="material-icons" aria-hidden="true">more_vert</span>
			</summary>
			<div class="card-menu-panel">
				<button
					type="button"
					class="card-menu-item"
					data-action="share-book"
					data-share-title={title}
					data-share-url={titleHref}
				>
					<span class="material-icons" aria-hidden="true">share</span>
					<span>Share</span>
				</button>
			</div>
		</details>
	)}
	{hasTopRight && <div class="top-right"><slot name="topRight" /></div>}
	<div class="cover-wrap">
		{thumbnail ? (
			titleHref
				? <a href={titleHref} aria-label={`View ${title}`}><img class="cover" src={thumbnail} alt={`${title} cover`} loading="lazy" /></a>
				: <img class="cover" src={thumbnail} alt={`${title} cover`} loading="lazy" />
		) : (
			<div class="cover cover-placeholder"><span class="material-icons" aria-hidden="true">menu_book</span></div>
		)}
		<div class="cover-actions">
			<slot name="actions" />
		</div>
	</div>
	<div class="card-body">
		<slot name="preTitle" />
		<h3>{titleHref ? <a href={titleHref}>{title}</a> : title}</h3>
		{author && (
			<p class="meta">
				by{" "}
				{authorHref
					? <a class="author-link" href={authorHref}>{author}</a>
					: author}
			</p>
		)}
		<slot name="preMeta" />
		<slot name="meta" />
		{description && (
			<div class="description-wrap">
				<p class="description">{description}</p>
				{titleHref && hasSynopsisText && <a class="description-more" href={titleHref}>Continue reading</a>}
			</div>
		)}
		<slot name="footer" />
		<slot />
	</div>
</li>

<style>
	.book-card {
		border: none;
		border-radius: 12px;
		background: #fff;
		padding: 0.65rem;
		position: relative;
		z-index: 0;
		isolation: isolate;
		overflow: visible;
		display: grid;
		grid-template-columns: 76px minmax(0, 1fr);
		gap: 0.65rem;
	}
	.book-card:has(.shelf-menu:not([hidden])) {
		z-index: 50;
	}
	.top-right {
		position: absolute;
		top: 0.65rem;
		right: 2.1rem;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.28rem;
	}
	.card-menu {
		position: absolute;
		top: 0.45rem;
		right: 0.4rem;
		z-index: 70;
	}
	.card-menu > summary {
		list-style: none;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border-radius: 8px;
		cursor: pointer;
		color: #3f4b57;
	}
	.card-menu > summary::-webkit-details-marker {
		display: none;
	}
	.card-menu[open] > summary,
	.card-menu > summary:hover {
		background: #eef3f8;
	}
	.card-menu-panel {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		min-width: 132px;
		background: #fff;
		border: 1px solid #d7dee7;
		border-radius: 10px;
		box-shadow: 0 10px 20px rgba(15, 23, 42, 0.14);
		padding: 0.25rem;
	}
	.card-menu-item {
		width: 100%;
		border: none;
		background: transparent;
		border-radius: 8px;
		padding: 0.42rem 0.48rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: #222;
		font: inherit;
		font-size: 0.86rem;
		cursor: pointer;
	}
	.card-menu-item:hover {
		background: #f1f5f9;
	}
	.card-menu-item .material-icons {
		font-size: 1rem;
	}
	.cover-wrap {
		width: 76px;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.cover-wrap a {
		display: block;
		width: 100%;
	}
	.cover {
		width: 76px;
		height: 114px;
		object-fit: cover;
		border-radius: 6px;
		background: #f1f1f1;
	}
	.cover-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #8a8a8a;
		border: 1px solid #d7d7d7;
	}
	.card-body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		min-width: 0;
	}
	.card-body h3 {
		margin: 0;
		padding-right: 1.7rem;
		font-size: 1rem;
		overflow-wrap: anywhere;
	}
	.card-body h3 a {
		color: inherit;
		text-decoration: none;
	}
	.card-body h3 a:hover {
		text-decoration: underline;
	}
	.meta,
	:global(.book-card .meta) {
		margin: 0.2rem 0;
		font-size: 0.87rem;
		color: #4d4d4d;
	}
	:global(.book-card .meta + .meta) {
		margin-top: 0.1rem;
	}
	.description-wrap {
		margin-top: 0.25rem;
	}
	.description {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: #575757;
		line-height: 1.45;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-line-clamp: 7;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.description-more {
		display: inline-block;
		margin-top: 0.3rem;
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-secondary);
		text-decoration: none;
	}
	.description-more:hover,
	.description-more:focus-visible {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.cover-actions {
		width: 100%;
		margin: 0;
		padding: 0;
	}
	.cover-actions :global(.shelf-dropdown) {
		width: 100%;
		min-width: 0;
		--shelf-trigger-width: 100%;
		--shelf-trigger-height: 32px;
		--shelf-trigger-min-width: 100%;
		--shelf-trigger-min-height: 32px;
		--shelf-trigger-radius: 8px;
		--shelf-trigger-icon-size: 1.15rem;
	}
	.cover-actions :global(.shelf-state) {
		display: none !important;
	}
	.cover-actions :global(.shelf-dropdown .shelf-menu) {
		top: calc(100% + 4px);
		right: auto !important;
		left: 0 !important;
	}
	@media (max-width: 420px) {
		.book-card {
			grid-template-columns: 72px minmax(0, 1fr);
			gap: 0.55rem;
			padding: 0.6rem;
		}
		.cover-wrap,
		.cover {
			width: 72px;
			height: 108px;
		}
		.card-menu {
			top: 0.35rem;
			right: 0.3rem;
		}
		.cover-actions :global(.shelf-dropdown) {
			--shelf-trigger-height: 30px;
			--shelf-trigger-min-height: 30px;
		}
		.card-body h3 {
			padding-right: 1.55rem;
			font-size: 0.95rem;
		}
		.description {
			font-size: 0.82rem;
			line-height: 1.35;
			-webkit-line-clamp: 6;
		}
	}
</style>

<script>
	if (!(window as typeof window & { __bookCardMenuBound?: boolean }).__bookCardMenuBound) {
		(window as typeof window & { __bookCardMenuBound?: boolean }).__bookCardMenuBound = true;
		document.addEventListener("click", async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const shareButton = target.closest('[data-action="share-book"]');
			if (!(shareButton instanceof HTMLButtonElement)) return;
			event.preventDefault();
			event.stopPropagation();
			const title = String(shareButton.dataset.shareTitle || "").trim();
			const rawUrl = String(shareButton.dataset.shareUrl || "").trim();
			if (!rawUrl) return;
			const absoluteUrl = new URL(rawUrl, window.location.origin).toString();
			try {
				if (navigator.share) {
					await navigator.share({ title, text: title, url: absoluteUrl });
				} else if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(absoluteUrl);
					shareButton.querySelector("span:last-child").textContent = "Copied";
					setTimeout(() => {
						const label = shareButton.querySelector("span:last-child");
						if (label) label.textContent = "Share";
					}, 1200);
				}
			} catch {
				// Ignore canceled share actions.
			}
			const details = shareButton.closest("details");
			if (details instanceof HTMLDetailsElement) details.open = false;
		});

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			if (target.closest(".card-menu")) return;
			for (const menu of document.querySelectorAll(".card-menu[open]")) {
				if (menu instanceof HTMLDetailsElement) menu.open = false;
			}
		});
	}
</script>
