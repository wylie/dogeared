---
type Props = {
	title: string;
	titleHref?: string;
	author?: string;
	authorHref?: string;
	thumbnail?: string;
	description?: string;
};

const {
	title,
	titleHref = "",
	author = "",
	authorHref = "",
	thumbnail = "",
	description = ""
} = Astro.props as Props;

const hasTopRight = Astro.slots.has("topRight");
---

<li class="book-card">
	{hasTopRight && <div class="top-right"><slot name="topRight" /></div>}
	<div class="cover-wrap">
		{thumbnail
			? <img class="cover" src={thumbnail} alt={`${title} cover`} loading="lazy" />
			: <div class="cover cover-placeholder"><span class="material-icons" aria-hidden="true">menu_book</span></div>}
	</div>
	<div class="card-body">
		<slot name="preTitle" />
		<h3>{titleHref ? <a href={titleHref}>{title}</a> : title}</h3>
		{author && (
			<p class="meta">
				by{" "}
				{authorHref
					? <a class="author-link" href={authorHref}>{author}</a>
					: author}
			</p>
		)}
		<slot name="preMeta" />
		<slot name="meta" />
		{description && (
			<div class="description-wrap">
				<p class="description">{description}</p>
				{titleHref && <a class="description-more" href={titleHref}>Continue reading</a>}
			</div>
		)}
		<slot name="footer" />
		<slot />
		<div class="card-actions">
			<slot name="actions" />
		</div>
	</div>
</li>

<style>
	.book-card {
		border: none;
		border-radius: 12px;
		background: #fff;
		padding: 0.65rem;
		position: relative;
		z-index: 0;
		isolation: isolate;
		overflow: visible;
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr);
		gap: 0.65rem;
	}
	.book-card:has(.shelf-menu:not([hidden])) {
		z-index: 50;
	}
	.top-right {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.28rem;
	}
	.cover-wrap {
		width: 56px;
		height: 84px;
	}
	.cover {
		width: 56px;
		height: 84px;
		object-fit: cover;
		border-radius: 6px;
		background: #f1f1f1;
	}
	.cover-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #8a8a8a;
		border: 1px solid #d7d7d7;
	}
	.card-body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		min-width: 0;
	}
	.card-body h3 {
		margin: 0;
		padding-right: 3.6rem;
		font-size: 1rem;
		overflow-wrap: anywhere;
	}
	.card-body h3 a {
		color: inherit;
		text-decoration: none;
	}
	.card-body h3 a:hover {
		text-decoration: underline;
	}
	.meta,
	:global(.book-card .meta) {
		margin: 0.2rem 0;
		font-size: 0.87rem;
		color: #4d4d4d;
	}
	:global(.book-card .meta + .meta) {
		margin-top: 0.1rem;
	}
	.description-wrap {
		margin-top: 0.25rem;
	}
	.description {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: #575757;
		line-height: 1.45;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-line-clamp: 7;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.description-more {
		display: inline-block;
		margin-top: 0.3rem;
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-secondary);
		text-decoration: none;
	}
	.description-more:hover,
	.description-more:focus-visible {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.card-actions {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		margin: 0;
		padding: 0;
		z-index: 60;
	}
	.card-actions :global(.shelf-state) {
		display: none !important;
	}
	@media (max-width: 420px) {
		.book-card {
			grid-template-columns: 52px minmax(0, 1fr);
			gap: 0.55rem;
			padding: 0.6rem;
		}
		.cover-wrap,
		.cover {
			width: 52px;
			height: 78px;
		}
		.card-body h3 {
			padding-right: 3.25rem;
			font-size: 0.95rem;
		}
		.description {
			font-size: 0.82rem;
			line-height: 1.35;
			-webkit-line-clamp: 6;
		}
	}
</style>
