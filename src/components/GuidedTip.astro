---
const { isAuthenticated = false } = Astro.props as { isAuthenticated?: boolean };
---

{isAuthenticated && (
	<aside class="guided-tip" data-guided-tip data-coach-mark hidden role="dialog" aria-live="polite" aria-labelledby="guided-tip-title" aria-describedby="guided-tip-description">
		<div class="guided-tip-arrow" data-guided-tip-arrow aria-hidden="true"></div>
		<div class="guided-tip-icon" data-guided-tip-icon aria-hidden="true">auto_stories</div>
		<div class="guided-tip-body">
			<p class="guided-tip-status" data-guided-tip-status hidden></p>
			<h2 id="guided-tip-title" data-guided-tip-title></h2>
			<p id="guided-tip-description" data-guided-tip-description></p>
			<p id="guided-tip-book-context" class="guided-tip-sr-only" data-guided-tip-book-context hidden></p>
			<div class="guided-tip-actions">
				<a class="guided-tip-primary" data-guided-tip-primary href="/search">Search Books</a>
				<button type="button" class="guided-tip-dismiss" data-guided-tip-dismiss>Dismiss</button>
			</div>
		</div>
	</aside>
)}

{isAuthenticated && (
	<script is:inline>
	(() => {
		const root = document.querySelector("[data-guided-tip]");
		if (!(root instanceof HTMLElement)) return;

		const titleEl = root.querySelector("[data-guided-tip-title]");
		const descriptionEl = root.querySelector("[data-guided-tip-description]");
		const bookContextEl = root.querySelector("[data-guided-tip-book-context]");
		const statusEl = root.querySelector("[data-guided-tip-status]");
		const iconEl = root.querySelector("[data-guided-tip-icon]");
		const primaryEl = root.querySelector("[data-guided-tip-primary]");
		const dismissEl = root.querySelector("[data-guided-tip-dismiss]");
		const arrowEl = root.querySelector("[data-guided-tip-arrow]");
		if (!(titleEl instanceof HTMLElement) || !(descriptionEl instanceof HTMLElement) || !(primaryEl instanceof HTMLAnchorElement) || !(dismissEl instanceof HTMLButtonElement)) return;

		const path = window.location.pathname.replace(/\/+$/, "") || "/";
		const TIPS = [
			{
				id: "home-welcome",
				path: "/",
				anchor: "[data-guided-anchor='home-intro'], .intro",
				title: "Welcome to DogEared",
				description: "This is your reading home. Start by searching for a book you love and adding it to a shelf.",
				icon: "local_library",
				primaryLabel: "Search Books",
				primaryHref: "/search",
				placement: "below",
				when: (stats) => stats.totalBooks === 0
			},
			{
				id: "search-add-book",
				path: "/search",
				anchor: "[data-guided-anchor='search-page'], #search-page",
				title: "Search and shelve",
				description: "Search for any book and add it to Want to Read, Currently Reading, or Read as your plans change.",
				icon: "search",
				primaryLabel: "Search Books",
				primaryHref: "#search-page",
				placement: "below",
				when: (stats) => stats.totalBooks === 0
			},
			{
				id: "book-detail-shelves",
				pathPrefix: "/book",
				anchor: ".book-head .shelf-dropdown, .book-head",
				title: "Save books as you browse",
				description: "Use the shelf button to save this book to Want to Read, Currently Reading, or Read.",
				icon: "bookmark_add",
				primaryLabel: "Shelf Button",
				primaryHref: "#main-content",
				placement: "left",
				when: (stats) => stats.totalBooks === 0
			},
			{
				id: "first-book-added",
				anchor: ".shelf-dropdown.is-shelved, .shelf-dropdown, #currently-reading, main",
				title: "You added your first book",
				description: "Books can move between shelves as your reading changes. DogEared keeps that history with your account.",
				icon: "celebration",
				primaryLabel: "Open Profile",
				primaryHref: "/profile",
				when: (stats) => stats.totalBooks > 0 && stats.progressEvents === 0
			},
			{
				id: "currently-reading-progress",
				pathPrefix: "/profile",
				anchor: "#currently-reading [data-action='save-reading-progress'], #currently-reading",
				title: "Track your current read",
				description: "Update reading progress after a session so your profile reflects where you are right now.",
				icon: "trending_up",
				primaryLabel: "Update Progress",
				primaryHref: "#currently-reading",
				placement: "below",
				when: (stats) => stats.readingBooks > 0 && stats.progressEvents === 0
			},
			{
				id: "first-progress-update",
				anchor: "main",
				title: "A note for later",
				description: "After a progress update, you can write a private journal entry to remember what stood out today.",
				icon: "edit_note",
				primaryLabel: "Open Journal",
				primaryHref: "/journal#new-entry",
				when: (stats) => stats.progressEvents > 0 && stats.journalEntries === 0
			},
			{
				id: "reading-journal-private",
				path: "/journal",
				anchor: "[data-guided-anchor='journal-entry-form'], #new-entry",
				title: "Your private notebook",
				description: "Capture thoughts, favorite quotes, questions, predictions, interesting passages, and small reading moments here. Journal entries are never public.",
				icon: "lock",
				primaryLabel: "New Entry",
				primaryHref: "#new-entry",
				placement: "above",
				when: (stats) => stats.journalEntries === 0
			},
			{
				id: "discover-recommendations",
				path: "/discover",
				anchor: "[data-guided-anchor='discover-recommendations'], #recommended-for-you, .discover-intro",
				title: "Recommendations learn with you",
				description: "They improve as you finish books, rate books, review books, follow readers, and build your shelves.",
				icon: "explore",
				primaryLabel: "Browse Recommendations",
				primaryHref: "#recommended-for-you",
				placement: "below",
				when: (stats) => Number(stats?.recommendationInteractions || 0) === 0
			},
			{
				id: "first-finished-book",
				pathPrefix: "/profile",
				anchor: "#read, main",
				title: "You finished a book",
				description: "A short review can help future readers understand whether this book is right for them.",
				icon: "task_alt",
				primaryLabel: "Find Finished Books",
				primaryHref: "/profile#read",
				placement: "below",
				when: (stats) => stats.finishedBooks > 0 && stats.reviews === 0
			},
			{
				id: "settings-learning",
				path: "/settings",
				anchor: "#learning-settings",
				title: "Choose how much guidance you want",
				description: "Helpful tips can be turned off here, and Reset Guided Tour brings dismissed tips back.",
				icon: "settings",
				primaryLabel: "Learning Settings",
				primaryHref: "#learning-settings",
				placement: "below",
				when: () => true
			}
		];

		let activeTip = null;
		let activeSettings = null;
		let activeStats = null;
		let refreshTimer = 0;
		let positionFrame = 0;
		let positionFallbackTimer = 0;
		let outsideDismissPausedUntil = 0;
		let suppressRegularTipsUntil = 0;
		let restoreFocusEl = null;

		function isTipAvailable(tip, settings, stats) {
			if (!settings?.showHelpfulTips) return false;
			const completed = Array.isArray(settings.completedTips) ? settings.completedTips : [];
			const dismissed = Array.isArray(settings.dismissedTips) ? settings.dismissedTips : [];
			if (completed.includes(tip.id) || dismissed.includes(tip.id)) return false;
			if (tip.path && tip.path !== path) return false;
			if (tip.pathPrefix && !path.startsWith(tip.pathPrefix)) return false;
			return typeof tip.when === "function" ? tip.when(stats || {}) : true;
		}

		function findAnchor(tip) {
			if (tip?.anchorElement instanceof HTMLElement) return tip.anchorElement;
			const selectors = String(tip.anchor || "main").split(",").map((item) => item.trim()).filter(Boolean);
			for (const selector of selectors) {
				const node = document.querySelector(selector);
				if (node instanceof HTMLElement) return node;
			}
			return document.querySelector("main");
		}

		function isAnchorVisible(anchor) {
			if (!(anchor instanceof HTMLElement)) return false;
			if (!document.documentElement.contains(anchor)) return false;
			if (anchor.hidden) return false;
			const style = window.getComputedStyle(anchor);
			if (style.display === "none" || style.visibility === "hidden" || Number(style.opacity || 1) === 0) return false;
			const rect = anchor.getBoundingClientRect();
			if (rect.width <= 0 || rect.height <= 0) return false;
			const bounds = getSafeViewportBounds();
			return rect.bottom > bounds.top
				&& rect.right > bounds.left
				&& rect.top < bounds.bottom
				&& rect.left < bounds.right;
		}

		function isElementVisible(element) {
			if (!(element instanceof HTMLElement) || element.hidden) return false;
			const style = window.getComputedStyle(element);
			if (style.display === "none" || style.visibility === "hidden") return false;
			const rect = element.getBoundingClientRect();
			return rect.width > 0 && rect.height > 0;
		}

		function getSafeViewportBounds() {
			const margin = 12;
			const isSmallViewport = window.matchMedia("(max-width: 720px)").matches;
			let top = margin;
			let bottom = window.innerHeight - (isSmallViewport ? 72 : margin);
			const leftHandNav = document.getElementById("left-hand-nav");
			if (isSmallViewport && leftHandNav instanceof HTMLElement && isElementVisible(leftHandNav)) {
				const navStyle = window.getComputedStyle(leftHandNav);
				const navRect = leftHandNav.getBoundingClientRect();
				if ((navStyle.position === "sticky" || navStyle.position === "fixed") && navRect.top <= margin && navRect.bottom > top) {
					top = Math.min(window.innerHeight - 120, Math.max(top, navRect.bottom + 8));
				}
			}
			const fixedObstacles = [document.querySelector(".floating-actions"), document.querySelector("[data-feedback-error-prompt]:not([hidden])")];
			for (const obstacle of fixedObstacles) {
				if (!(obstacle instanceof HTMLElement) || !isElementVisible(obstacle)) continue;
				const obstacleStyle = window.getComputedStyle(obstacle);
				if (obstacleStyle.position !== "fixed" && obstacleStyle.position !== "sticky") continue;
				const obstacleRect = obstacle.getBoundingClientRect();
				if (obstacleRect.top > top && obstacleRect.top < bottom) bottom = Math.min(bottom, obstacleRect.top - 10);
			}
			return {
				top: Math.max(margin, top),
				right: Math.max(margin + 96, window.innerWidth - margin),
				bottom: Math.max(top + 96, bottom),
				left: margin
			};
		}

		function clamp(value, min, max) {
			if (max < min) return min;
			return Math.min(Math.max(value, min), max);
		}

		function resolvePlacement(tip, rect, width, height, bounds) {
			const preferred = String(tip?.placement || "").trim();
			const gap = 14;
			const minUsableHeight = Math.min(132, height);
			const below = bounds.bottom - (rect.bottom + gap);
			const above = rect.top - gap - bounds.top;
			const left = rect.left - gap - bounds.left;
			const right = bounds.right - (rect.right + gap);
			const canBelow = below >= minUsableHeight;
			const canAbove = above >= minUsableHeight;
			const canLeft = left >= width;
			const canRight = right >= width;
			if (preferred === "below" && canBelow) return "below";
			if (preferred === "above" && canAbove) return "above";
			if (preferred === "left" && canLeft) return "left";
			if (preferred === "right" && canRight) return "right";
			if (window.matchMedia("(max-width: 720px)").matches) return below >= above ? "below" : "above";
			if (canRight) return "right";
			if (canLeft) return "left";
			if (canBelow || below >= above) return "below";
			return "above";
		}

		function concealTip() {
			root.classList.remove("is-visible");
			root.setAttribute("aria-hidden", "true");
			root.setAttribute("inert", "");
		}

		function revealTip() {
			root.hidden = false;
			root.setAttribute("aria-hidden", "false");
			root.removeAttribute("inert");
			window.requestAnimationFrame(() => root.classList.add("is-visible"));
		}

		function clearRestoreFocus() {
			restoreFocusEl = null;
		}

		function restoreTriggerFocus() {
			const target = restoreFocusEl;
			clearRestoreFocus();
			if (!(target instanceof HTMLElement) || !document.documentElement.contains(target)) return;
			try {
				target.focus({ preventScroll: true });
			} catch {
				target.focus();
			}
		}

		function dismissForAnchorLoss(reason) {
			if (activeTip?.transient) {
				dismissTransientTip(reason);
				return;
			}
			concealTip();
		}

		function positionTip(anchor) {
			if (!(anchor instanceof HTMLElement) || !isAnchorVisible(anchor)) {
				dismissForAnchorLoss(anchor instanceof HTMLElement && !document.documentElement.contains(anchor) ? "anchor-removed" : "anchor-hidden");
				return;
			}
			const rect = anchor.getBoundingClientRect();
			const gap = 14;
			const isSmallViewport = window.matchMedia("(max-width: 720px)").matches;
			const bounds = getSafeViewportBounds();
			const width = isSmallViewport
				? Math.min(360, Math.max(260, bounds.right - bounds.left))
				: Math.min(360, Math.max(280, bounds.right - bounds.left));
			root.style.width = `${width}px`;
			root.style.maxWidth = `${width}px`;
			root.style.maxHeight = "";
			root.style.overflowY = "";
			const measuredHeight = root.offsetHeight || 180;
			const placement = resolvePlacement(activeTip, rect, width, measuredHeight, bounds);
			let maxHeight = Math.max(96, bounds.bottom - bounds.top);
			let left = rect.right + gap;
			let top = clamp(rect.top, bounds.top, bounds.bottom - measuredHeight);
			if (placement === "left") {
				left = rect.left - width - gap;
			} else if (placement === "below" || placement === "above") {
				left = clamp(rect.left + rect.width / 2 - width / 2, bounds.left, bounds.right - width);
				if (placement === "below") {
					top = rect.bottom + gap;
					maxHeight = Math.max(96, bounds.bottom - top);
				} else {
					maxHeight = Math.max(96, rect.top - gap - bounds.top);
					top = rect.top - gap - Math.min(measuredHeight, maxHeight);
					top = Math.max(bounds.top, top);
				}
			} else {
				maxHeight = Math.max(96, bounds.bottom - bounds.top);
			}
			if (placement === "right" || placement === "left") {
				top = clamp(rect.top + rect.height / 2 - measuredHeight / 2, bounds.top, bounds.bottom - measuredHeight);
			}
			left = clamp(left, bounds.left, bounds.right - width);
			top = clamp(top, bounds.top, bounds.bottom - Math.min(measuredHeight, maxHeight));
			root.style.left = `${left}px`;
			root.style.right = "auto";
			root.style.bottom = "auto";
			root.style.top = `${top}px`;
			root.style.maxHeight = `${maxHeight}px`;
			root.style.overflowY = measuredHeight > maxHeight ? "auto" : "";
			root.dataset.placement = placement;
			if (arrowEl instanceof HTMLElement) {
				if (placement === "below" || placement === "above") {
					const arrowLeft = clamp(rect.left + rect.width / 2 - left - 8, 18, width - 28);
					arrowEl.style.left = `${arrowLeft}px`;
					arrowEl.style.top = "";
				} else {
					const arrowTop = clamp(rect.top + rect.height / 2 - top - 8, 18, Math.min(measuredHeight, maxHeight) - 28);
					arrowEl.style.top = `${arrowTop}px`;
					arrowEl.style.left = "";
				}
			}
			revealTip();
		}

		function schedulePosition() {
			if (!activeTip) return;
			window.cancelAnimationFrame(positionFrame);
			window.clearTimeout(positionFallbackTimer);
			const run = () => {
				window.clearTimeout(positionFallbackTimer);
				const anchor = findAnchor(activeTip);
				if (anchor instanceof HTMLElement) positionTip(anchor);
				else dismissForAnchorLoss("anchor-removed");
			};
			positionFrame = window.requestAnimationFrame(run);
			positionFallbackTimer = window.setTimeout(run, 80);
		}

		function showTip(tip) {
			const anchor = findAnchor(tip);
			if (!(anchor instanceof HTMLElement)) return hideTip();
			if (activeTip?.transient && tip?.transient) dispatchProgressPromptDismissed(activeTip, "replaced");
			const activeElement = document.activeElement;
			restoreFocusEl = tip.triggerElement instanceof HTMLElement
				? tip.triggerElement
				: (activeElement instanceof HTMLElement && !root.contains(activeElement) ? activeElement : null);
			activeTip = tip;
			root.dataset.tipMode = tip.transient ? "transient" : "guided";
			if (statusEl instanceof HTMLElement) {
				const status = String(tip.status || "").trim();
				statusEl.textContent = status;
				statusEl.hidden = !status;
			}
			titleEl.textContent = tip.title;
			descriptionEl.textContent = tip.description;
			if (bookContextEl instanceof HTMLElement) {
				const bookTitle = String(tip.bookTitle || "").trim();
				bookContextEl.textContent = bookTitle ? `Prompt opened from progress controls for ${bookTitle}.` : "";
				bookContextEl.hidden = !bookTitle;
				root.setAttribute("aria-describedby", bookTitle ? "guided-tip-description guided-tip-book-context" : "guided-tip-description");
			}
			if (iconEl instanceof HTMLElement) iconEl.textContent = tip.icon || "auto_stories";
			primaryEl.textContent = tip.primaryLabel || "Continue";
			primaryEl.href = tip.primaryHref || "#";
			dismissEl.textContent = tip.dismissLabel || "Dismiss";
			root.hidden = false;
			root.classList.remove("is-visible");
			root.setAttribute("aria-hidden", "true");
			root.setAttribute("inert", "");
			positionTip(anchor);
			if (tip.transient) {
				window.requestAnimationFrame(() => {
					if (activeTip === tip && !root.hidden) primaryEl.focus({ preventScroll: true });
				});
			}
		}

		function hideTip(options = {}) {
			const shouldRestoreFocus = options.restoreFocus !== false && !!activeTip?.transient;
			activeTip = null;
			root.classList.remove("is-visible");
			root.setAttribute("aria-hidden", "true");
			root.setAttribute("inert", "");
			root.hidden = true;
			delete root.dataset.tipMode;
			root.style.maxHeight = "";
			root.style.overflowY = "";
			window.cancelAnimationFrame(positionFrame);
			window.clearTimeout(positionFallbackTimer);
			if (shouldRestoreFocus) restoreTriggerFocus();
			else clearRestoreFocus();
		}

		function dispatchProgressPromptDismissed(tip, reason) {
			if (!tip?.transient || tip.id !== "progress-journal-prompt") return;
			window.dispatchEvent(new CustomEvent("dogeared:progress-journal-prompt-dismissed", {
				detail: {
					bookId: tip.bookId || 0,
					currentPage: tip.currentPage || 0,
					reason
				}
			}));
		}

		function dismissTransientTip(reason = "dismiss") {
			if (!activeTip?.transient) return false;
			dispatchProgressPromptDismissed(activeTip, reason);
			suppressRegularTipsUntil = Date.now() + 4000;
			hideTip({ restoreFocus: true });
			return true;
		}

		async function postAction(action, tipId = activeTip?.id) {
			if (!tipId) return;
			try {
				const response = await fetch("/api/guidance/status", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ action, tipId })
				});
				if (response.ok) {
					const data = await response.json().catch(() => ({}));
					activeSettings = data?.settings || activeSettings;
					activeStats = data?.stats || activeStats;
				}
			} catch {
				// Guidance should never block reading workflows.
			}
		}

		function renderNextTip() {
			if (activeTip?.transient) return;
			if (Date.now() < suppressRegularTipsUntil) return;
			if (!activeSettings || !activeStats) return hideTip();
			const availableTips = TIPS.filter((candidate) => isTipAvailable(candidate, activeSettings, activeStats));
			const tip = availableTips.find((candidate) => candidate.path || candidate.pathPrefix) || availableTips[0];
			if (tip) showTip(tip);
			else hideTip();
		}

		async function refreshStatus() {
			if (activeTip?.transient) return;
			try {
				const response = await fetch("/api/guidance/status", { headers: { Accept: "application/json" } });
				if (!response.ok) return hideTip();
				const data = await response.json().catch(() => ({}));
				activeSettings = data?.settings || null;
				activeStats = data?.stats || null;
				renderNextTip();
			} catch {
				hideTip();
			}
		}

		dismissEl.addEventListener("click", async () => {
			if (dismissTransientTip("dismiss")) return;
			await postAction("dismiss");
			hideTip();
			renderNextTip();
		});

		primaryEl.addEventListener("click", async (event) => {
			const href = primaryEl.getAttribute("href") || "";
			event.preventDefault();
			if (activeTip?.transient) {
				dispatchProgressPromptDismissed(activeTip, "primary");
				hideTip({ restoreFocus: false });
				if (href.startsWith("#")) {
					document.querySelector(href)?.scrollIntoView({ behavior: "smooth", block: "start" });
					const target = document.querySelector(href);
					if (target instanceof HTMLElement) target.focus?.();
					return;
				}
				window.location.href = href || "/";
				return;
			}
			await postAction("complete");
			if (href.startsWith("#")) {
				document.querySelector(href)?.scrollIntoView({ behavior: "smooth", block: "start" });
				const target = document.querySelector(href);
				if (target instanceof HTMLElement) target.focus?.();
				hideTip();
				renderNextTip();
				return;
			}
			window.location.href = href || "/";
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || root.hidden) return;
			if (dismissTransientTip("escape")) return;
			void postAction("dismiss");
			hideTip();
		});

		document.addEventListener("click", (event) => {
			if (!activeTip?.transient || root.hidden || Date.now() < outsideDismissPausedUntil) return;
			const target = event.target instanceof Node ? event.target : null;
			if (!target) return;
			const anchor = findAnchor(activeTip);
			if (root.contains(target)) return;
			if (anchor instanceof HTMLElement && anchor.contains(target)) return;
			dismissTransientTip("outside");
		});

		window.addEventListener("resize", () => {
			if (!activeTip) return;
			schedulePosition();
		});

		window.addEventListener("scroll", () => {
			if (!activeTip) return;
			schedulePosition();
		}, { passive: true });

		window.addEventListener("hashchange", () => {
			if (!activeTip) return;
			window.setTimeout(schedulePosition, 120);
		});

		window.addEventListener("dogeared:reading-data-changed", () => {
			window.clearTimeout(refreshTimer);
			refreshTimer = window.setTimeout(refreshStatus, 600);
		});

		window.addEventListener("dogeared:progress-journal-prompt", (event) => {
			const detail = event instanceof CustomEvent ? event.detail || {} : {};
			const anchor = detail.anchor instanceof HTMLElement ? detail.anchor : null;
			const trigger = detail.trigger instanceof HTMLElement ? detail.trigger : anchor;
			const bookId = Math.max(0, Number(detail.bookId || 0) || 0);
			const currentPage = Math.max(0, Number(detail.currentPage || 0) || 0);
			const href = String(detail.href || "").trim();
			if (!anchor || !bookId || !currentPage || !href) return;
			outsideDismissPausedUntil = Date.now() + 300;
			suppressRegularTipsUntil = Date.now() + 4000;
			showTip({
				id: "progress-journal-prompt",
				anchorElement: anchor,
				title: "Capture today's reading?",
				status: "✓ Progress updated.",
				description: "Remember a thought before you move on.",
				icon: "check_circle",
				primaryLabel: "Write Journal Entry",
				primaryHref: href,
				dismissLabel: "Not now",
				placement: "below",
				transient: true,
				triggerElement: trigger,
				bookTitle: String(detail.bookTitle || "").trim(),
				bookId,
				currentPage
			});
		});

		const anchorObserver = new MutationObserver(() => {
			if (!activeTip?.transient) return;
			schedulePosition();
		});
		anchorObserver.observe(document.body, { childList: true, subtree: true });

		void refreshStatus();
	})();
	</script>
)}

<style>
	.guided-tip {
		position: fixed;
