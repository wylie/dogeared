---
import FeedbackWidget from "./FeedbackWidget.astro";

type Props = { isAuthenticated?: boolean };
const { isAuthenticated = false } = Astro.props as Props;

const supportActions = [
	{
		href: "https://buymeacoffee.com/wylie",
		icon: "favorite",
		label: "Support DogEared",
		kind: "support",
		background: "#151515",
		hoverBackground: "#151515"
	}
];
---

<div class="floating-actions" aria-label="Reader actions">
	<FeedbackWidget isAuthenticated={isAuthenticated} />
	{supportActions.map((action) => (
		<a
			class={`floating-action floating-action-${action.kind}`}
			href={action.href}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={action.label}
			style={`--floating-action-bg: ${action.background}; --floating-action-hover-bg: ${action.hoverBackground};`}
		>
			<span class="material-icons floating-action-icon" aria-hidden="true">{action.icon}</span>
			<span class="floating-action-label">{action.label}</span>
		</a>
	))}
</div>

<script>
	const floatingActions = document.querySelector(".floating-actions");
	if (floatingActions instanceof HTMLElement) {
		const enablePointerExpansion = () => {
			floatingActions.classList.add("is-pointer-active");
		};
		const enableKeyboardExpansion = (event) => {
			if (event.key === "Tab") floatingActions.classList.add("is-keyboard-active");
		};
		const disableKeyboardExpansion = () => {
			floatingActions.classList.remove("is-keyboard-active");
		};
		floatingActions.addEventListener("pointermove", enablePointerExpansion, { once: true });
		window.addEventListener("keydown", enableKeyboardExpansion);
		window.addEventListener("pointerdown", disableKeyboardExpansion);
	}
</script>

<style>
	.floating-actions {
		position: fixed;
		right: 1rem;
		bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.55rem;
	}
	:global(.floating-action-slot) {
		display: contents;
	}
	:global(.floating-action) {
		--floating-action-size: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		width: max-content;
		min-width: var(--floating-action-size);
		max-width: var(--floating-action-size);
		height: var(--floating-action-size);
		box-sizing: border-box;
		overflow: hidden;
		border: none;
		border-radius: 999px;
		padding: 0;
		background: var(--floating-action-bg);
		color: #fff;
		box-shadow: var(--shadow-sm);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 750;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			max-width 180ms ease,
			gap 180ms ease,
			padding 180ms ease,
			background-color 160ms ease,
			box-shadow var(--transition-fast);
	}
	.floating-actions.is-pointer-active :global(.floating-action:hover),
	.floating-actions.is-keyboard-active :global(.floating-action:focus) {
		max-width: calc(100vw - 2rem);
		gap: 0.35rem;
		padding: 0 0.95rem 0 0;
		background: var(--floating-action-hover-bg);
		box-shadow: var(--shadow-md);
	}
	:global(.floating-action:focus-visible) {
		outline: 3px solid #111;
		outline-offset: 3px;
	}
	:global(.floating-action-icon) {
		flex: 0 0 var(--floating-action-size);
		width: var(--floating-action-size);
		height: var(--floating-action-size);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		line-height: 1;
	}
	:global(.floating-action-support .floating-action-icon) {
		font-size: 1.25rem;
	}
	:global(.floating-action-label) {
		display: inline-block;
		max-width: 0;
		opacity: 0;
		overflow: hidden;
		text-overflow: clip;
		transition:
			max-width 180ms ease,
			opacity 140ms ease;
	}
	.floating-actions.is-pointer-active :global(.floating-action:hover .floating-action-label),
	.floating-actions.is-keyboard-active :global(.floating-action:focus .floating-action-label) {
		max-width: 18rem;
		opacity: 1;
	}
	@media (max-width: 900px) {
		.floating-actions {
			right: 0.6rem;
			bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
			gap: 0.45rem;
		}
		:global(.floating-action) {
			--floating-action-size: 46px;
			font-size: 0.84rem;
		}
		:global(.floating-action-icon) {
			flex-basis: var(--floating-action-size);
			width: var(--floating-action-size);
			height: var(--floating-action-size);
		}
		.floating-actions.is-pointer-active :global(.floating-action:hover),
		.floating-actions.is-keyboard-active :global(.floating-action:focus) {
			max-width: calc(100vw - 1.2rem);
			gap: 0.32rem;
			padding: 0 0.8rem 0 0;
		}
		.floating-actions.is-pointer-active :global(.floating-action:hover .floating-action-label),
		.floating-actions.is-keyboard-active :global(.floating-action:focus .floating-action-label) {
			max-width: 18rem;
			opacity: 1;
		}
	}
</style>
