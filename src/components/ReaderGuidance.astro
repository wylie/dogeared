---
type Props = { isAuthenticated?: boolean };
const { isAuthenticated = false } = Astro.props as Props;
---

<aside
	class="reader-guidance"
	data-reader-guidance
	data-authenticated={String(isAuthenticated)}
	hidden
	aria-label="Getting started with DogEared"
>
	<div>
		<p class="reader-guidance-title" data-guidance-title>New to DogEared?</p>
		<p class="reader-guidance-copy" data-guidance-copy></p>
		<p class="reader-guidance-detail" data-guidance-detail></p>
	</div>
	<div class="reader-guidance-actions">
		<button type="button" class="reader-guidance-primary" data-guidance-create>Create Account</button>
		<button type="button" class="reader-guidance-secondary" data-guidance-login>Log In</button>
		<button type="button" class="reader-guidance-primary" data-guidance-search hidden>Search Books</button>
		<button type="button" class="reader-guidance-dismiss" data-guidance-dismiss aria-label="Dismiss getting started guidance">Dismiss</button>
	</div>
</aside>

<script>
	const guidance = document.querySelector("[data-reader-guidance]");

	function readCookie(name) {
		const prefix = `${name}=`;
		return document.cookie.split(";").map((part) => part.trim()).find((part) => part.startsWith(prefix))?.slice(prefix.length) || "";
	}

	function writeCookie(name, value, maxAge = 60 * 60 * 24 * 365) {
		document.cookie = `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${maxAge}; SameSite=Lax`;
	}

	function clearCookie(name) {
		writeCookie(name, "", 0);
	}

	function hideGuidance() {
		if (guidance instanceof HTMLElement) guidance.hidden = true;
	}

	async function refreshReaderStatus() {
		if (!(guidance instanceof HTMLElement) || guidance.dataset.authenticated !== "true") return;
		try {
			const response = await fetch("/api/onboarding/status", { credentials: "same-origin" });
			const data = await response.json().catch(() => ({}));
			if (response.ok && data?.complete) {
				clearCookie("dogeared_new_reader");
				clearCookie("dogeared_reader_guidance_dismissed");
				hideGuidance();
			}
		} catch {
			// Guidance should never interfere with reading actions.
		}
	}

	if (guidance instanceof HTMLElement) {
		const authenticated = guidance.dataset.authenticated === "true";
		const title = guidance.querySelector("[data-guidance-title]");
		const copy = guidance.querySelector("[data-guidance-copy]");
		const detail = guidance.querySelector("[data-guidance-detail]");
		const createButton = guidance.querySelector("[data-guidance-create]");
		const loginButton = guidance.querySelector("[data-guidance-login]");
		const searchButton = guidance.querySelector("[data-guidance-search]");
		const dismissButton = guidance.querySelector("[data-guidance-dismiss]");

		if (!authenticated && !readCookie("dogeared_new_visitor")) {
			writeCookie("dogeared_new_visitor", "true");
		}

		const visitorVisible = !authenticated
			&& readCookie("dogeared_new_visitor") === "true"
			&& readCookie("dogeared_visitor_guidance_dismissed") !== "true";
		const readerVisible = authenticated
			&& readCookie("dogeared_new_reader") === "true"
			&& readCookie("dogeared_reader_guidance_dismissed") !== "true";

		if (visitorVisible) {
			guidance.dataset.mode = "visitor";
			if (title instanceof HTMLElement) title.textContent = "New to DogEared?";
			if (copy instanceof HTMLElement) copy.textContent = "Track what you're reading, rate books you love, discover new favorites, and follow other readers.";
			if (detail instanceof HTMLElement) detail.textContent = "Create an account to save books, build shelves, and get personalized recommendations. Every shelf addition and rating helps DogEared learn your reading taste.";
			guidance.hidden = false;
		} else if (readerVisible) {
			guidance.dataset.mode = "reader";
			if (title instanceof HTMLElement) title.textContent = "Make DogEared yours";
			if (copy instanceof HTMLElement) copy.textContent = "Add a few favorite books and ratings to help DogEared learn what you enjoy.";
			if (detail instanceof HTMLElement) detail.textContent = "Your shelves, ratings, and reviews make recommendations more personal.";
			if (createButton instanceof HTMLElement) createButton.hidden = true;
			if (loginButton instanceof HTMLElement) loginButton.hidden = true;
			if (searchButton instanceof HTMLElement) searchButton.hidden = false;
			guidance.hidden = false;
			void refreshReaderStatus();
		}

		function focusSearch() {
			const search = document.getElementById("left-hand-search");
			if (search instanceof HTMLInputElement) {
				search.focus({ preventScroll: false });
				search.scrollIntoView({ behavior: "smooth", block: "center" });
				return;
			}
			window.location.href = "/search";
		}

		createButton?.addEventListener("click", () => {
			window.dispatchEvent(new CustomEvent("dogeared:open-auth", { detail: { mode: "create" } }));
		});
		loginButton?.addEventListener("click", () => {
			window.dispatchEvent(new CustomEvent("dogeared:open-auth", { detail: { mode: "login" } }));
		});
		searchButton?.addEventListener("click", focusSearch);

		dismissButton?.addEventListener("click", () => {
			const mode = String(guidance.dataset.mode || "visitor");
			writeCookie(mode === "reader" ? "dogeared_reader_guidance_dismissed" : "dogeared_visitor_guidance_dismissed", "true");
			hideGuidance();
		});

		window.addEventListener("dogeared:reading-data-changed", () => void refreshReaderStatus());
	}
</script>

<style>
	.reader-guidance {
		position: fixed;
		left: 50%;
		bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
		transform: translateX(-50%);
		z-index: 9998;
		width: min(680px, calc(100vw - 2rem));
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.85rem;
		padding: 0.9rem;
		border: none;
		border-radius: var(--radius-lg);
		background: #fffaf0;
		box-shadow: var(--shadow-sm);
	}
	.reader-guidance[hidden] { display: none; }
	.reader-guidance-title { margin: 0; font-weight: 700; color: #263746; }
	.reader-guidance-copy { margin: 0.2rem 0 0; color: #354350; font-size: 0.92rem; line-height: 1.4; }
	.reader-guidance-detail { margin: 0.28rem 0 0; color: #59636d; font-size: 0.84rem; line-height: 1.4; }
	.reader-guidance-actions { display: flex; align-items: center; gap: 0.35rem; flex: 0 0 auto; }
	.reader-guidance-actions button { min-height: 44px; border-radius: 9px; padding: 0 0.75rem; font: inherit; font-weight: 700; cursor: pointer; }
	.reader-guidance-primary { border: none; background: var(--color-primary); color: #fff; }
	.reader-guidance-primary:hover { background: var(--color-primary-hover); }
	.reader-guidance-secondary { border: var(--border-subtle); background: #fff; color: var(--color-secondary); }
	.reader-guidance-secondary:hover { background: #f2f6f9; }
	.reader-guidance-dismiss { border: none; background: transparent; color: var(--color-secondary); }
	@media (max-width: 680px) {
		.reader-guidance { bottom: calc(5.4rem + env(safe-area-inset-bottom, 0px)); width: calc(100vw - 1rem); align-items: stretch; }
		.reader-guidance-copy { font-size: 0.84rem; }
		.reader-guidance-actions { align-self: center; flex-wrap: wrap; justify-content: flex-end; }
	}
	@media (max-width: 480px) {
		.reader-guidance { display: grid; gap: 0.45rem; }
		.reader-guidance-actions { justify-content: flex-end; }
	}
</style>
