---
type Props = {
	label: string;
	href?: string;
	className?: string;
	tone?: "highlight" | "secondary";
	variant?: "clickable" | "static";
	kind?: "genre" | "topic";
};

const {
	label,
	href = "",
	className = "",
	tone = "highlight",
	variant = href ? "clickable" : "static",
	kind
} = Astro.props as Props;

const toneClass = tone === "secondary" ? "chip--secondary" : "chip--highlight";
const variantClass = variant === "static" ? "chip--static" : "";
const kindClass = kind === "topic" ? "chip--topic" : kind === "genre" ? "chip--genre" : "";
const classes = `chip ${toneClass} ${variantClass} ${kindClass} ${className}`.trim();
---

{variant === "clickable" && href ? (
	<a class={classes} href={href}>{label}</a>
) : (
	<span class={classes}>{label}</span>
)}
