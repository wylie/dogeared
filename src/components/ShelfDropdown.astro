---
type Props = {
	attrs?: Record<string, string | number | boolean | null | undefined>;
};

const { attrs = {} } = Astro.props as Props;
const initialStatusRaw = String(attrs["data-initial-status"] || "").trim();
const initialStatus = (
	initialStatusRaw === "reading" || initialStatusRaw === "finished" || initialStatusRaw === "want_to_read"
)
	? initialStatusRaw
	: "";
const hasInitialStatus = initialStatusRaw === "reading" || initialStatusRaw === "finished" || initialStatusRaw === "want_to_read";
const initialLabel = initialStatus === "reading"
	? "Currently Reading"
	: (initialStatus === "finished" ? "Read" : (initialStatus === "want_to_read" ? "Want to Read" : "Not on Shelf"));
const displayIconOverride = String(attrs["data-display-icon"] || "").trim();
const statusIcon = initialStatus === "reading"
	? "menu_book"
	: (initialStatus === "finished" ? "check" : (initialStatus === "want_to_read" ? "add" : "library_add"));
const initialIcon = displayIconOverride || statusIcon;
const hideLabel = String(attrs["data-hide-label"] || "").trim() === "true";
const currentCustomShelfId = Math.max(0, Number(attrs["data-current-custom-shelf-id"] || 0) || 0);
const customShelvesRaw = String(attrs["data-custom-shelves"] || "[]");
let customShelves: Array<{ id: number; name: string; icon: string }> = [];
try {
	const parsed = JSON.parse(customShelvesRaw);
	if (Array.isArray(parsed)) {
		customShelves = parsed
			.map((row) => ({
				id: Math.max(0, Number((row as { id?: unknown }).id || 0) || 0),
				name: String((row as { name?: unknown }).name || "").trim(),
				icon: String((row as { icon?: unknown }).icon || "bookmarks").trim() || "bookmarks"
			}))
			.filter((row) => row.id > 0 && row.name)
			.slice(0, 24);
	}
} catch {
	customShelves = [];
}
---

<div
	class={`shelf-dropdown${hasInitialStatus ? " is-shelved" : ""}`}
	{...attrs}
>
	<button
		type="button"
		class="shelf-trigger shelf-fab"
		data-action="toggle-shelf"
		data-status={initialStatus}
		data-display-icon={displayIconOverride}
		aria-expanded="false"
		aria-label={`Shelf: ${initialLabel}. Open shelf options`}
		title={`Shelf: ${initialLabel}`}
	>
		<span class="material-icons shelf-plus" aria-hidden="true">{initialIcon}</span>
	</button>
	{!hideLabel && <p class="shelf-state">{initialLabel}</p>}
	<div class="shelf-menu" hidden>
		<button
			type="button"
			class={`shelf-option${initialStatus === "want_to_read" ? " is-current" : ""}`}
			data-action="set-shelf"
			data-status="want_to_read"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">add</span>
			<span>Want to Read</span>
		</button>
		<button
			type="button"
			class={`shelf-option${initialStatus === "reading" ? " is-current" : ""}`}
			data-action="set-shelf"
			data-status="reading"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">menu_book</span>
			<span>Currently Reading</span>
		</button>
		<button
			type="button"
			class={`shelf-option${initialStatus === "finished" ? " is-current" : ""}`}
			data-action="set-shelf"
			data-status="finished"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">check</span>
			<span>Read</span>
		</button>
		<div data-custom-shelf-options>
			{customShelves.length > 0 && (
				<>
					<div class="shelf-option-divider" role="separator" aria-hidden="true"></div>
					{customShelves.map((shelf) => (
						<button
							type="button"
							class={`shelf-option${currentCustomShelfId === shelf.id ? " is-current" : ""}`}
							data-action="assign-custom-shelf"
							data-shelf-id={String(shelf.id)}
						>
							<span class="material-icons shelf-option-icon" aria-hidden="true">{shelf.icon}</span>
							<span>{shelf.name}</span>
						</button>
					))}
				</>
			)}
		</div>
		<div class="shelf-option-divider" role="separator" aria-hidden="true"></div>
		<button
			type="button"
			class="shelf-option shelf-option-danger"
			data-action="remove-from-shelves"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">remove_circle</span>
			<span>Remove from Shelves</span>
		</button>
	</div>
	<p class="shelf-feedback" hidden></p>
</div>

<style>
	.shelf-dropdown {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		width: 44px;
		min-width: 44px;
		overflow: visible;
	}
	.shelf-dropdown .shelf-trigger.shelf-fab {
		width: var(--shelf-trigger-width, 44px) !important;
		height: var(--shelf-trigger-height, 44px) !important;
		min-width: var(--shelf-trigger-min-width, 44px) !important;
		min-height: var(--shelf-trigger-min-height, 44px) !important;
		border: none !important;
		border-radius: var(--shelf-trigger-radius, 999px) !important;
		padding: 0 !important;
		background: var(--color-primary) !important;
		color: #fff !important;
		cursor: pointer;
		display: grid !important;
		place-items: center !important;
		line-height: 1 !important;
	}
	.shelf-dropdown .shelf-trigger.shelf-fab:hover {
		background: var(--color-primary-hover) !important;
	}
	.shelf-plus {
		font-size: var(--shelf-trigger-icon-size, 1.4rem);
		line-height: 1;
	}
	.shelf-state {
		margin: 0.22rem 0 0;
		font-size: 0.72rem;
		line-height: 1.1;
		font-weight: 700;
		color: #1f5138;
	}
	.shelf-menu {
		position: absolute;
		top: calc(100% + 4px);
		right: 0 !important;
		left: auto !important;
		min-width: 180px;
		background: #fff;
		border: 1px solid #c9c9c9;
		border-radius: 8px;
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
		padding: 0.25rem 0;
		z-index: 25;
	}
	.shelf-option {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		text-align: left;
		border: none;
		background: transparent;
		padding: 0.5rem 0.75rem;
		font-size: 0.92rem;
		cursor: pointer;
		color: #222;
	}
	.shelf-option.is-current { font-weight: 600; }
	.shelf-option-icon {
		font-size: 1.15rem;
		line-height: 1;
		color: #9aa3af;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		vertical-align: middle;
		transform: translateY(0);
		font-weight: 700;
	}
	.shelf-option.is-current .shelf-option-icon {
		color: var(--color-primary);
	}
	.shelf-option:hover {
		background: #f2f2f2;
	}
	.shelf-option-divider {
		height: 1px;
		margin: 0.2rem 0;
		background: #ececec;
	}
	.shelf-feedback {
		position: static;
		margin: 0.28rem 0 0;
		max-width: 100%;
		font-size: 0.82rem;
		color: var(--color-secondary);
		line-height: 1.25;
		white-space: normal;
		overflow-wrap: anywhere;
		background: transparent !important;
		border: none !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		outline: none !important;
		padding: 0 !important;
		z-index: 40;
	}
	.shelf-option-danger {
		color: #8a1d1d;
	}
	.shelf-option-danger .shelf-option-icon {
		color: #8a1d1d;
	}
</style>
