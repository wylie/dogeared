---
import { normalizeBookCoverUrl } from "../lib/bookCovers";
type Props = {
	attrs?: Record<string, string | number | boolean | null | undefined>;
};

const { attrs = {} } = Astro.props as Props;
const normalizedAttrs = { ...attrs };
if ("data-cover" in normalizedAttrs) {
	normalizedAttrs["data-cover"] = normalizeBookCoverUrl(normalizedAttrs["data-cover"]);
}
const initialStatusRaw = String(attrs["data-initial-status"] || "").trim();
const initialStatus = (
	initialStatusRaw === "reading" || initialStatusRaw === "finished" || initialStatusRaw === "want_to_read"
)
	? initialStatusRaw
	: "";
const hasInitialStatus = initialStatusRaw === "reading" || initialStatusRaw === "finished" || initialStatusRaw === "want_to_read";
const initialLabel = initialStatus === "reading"
	? "Currently Reading"
	: (initialStatus === "finished" ? "Read" : (initialStatus === "want_to_read" ? "Want to Read" : "Not on Shelf"));
const displayIconOverride = String(attrs["data-display-icon"] || "").trim();
const statusIcon = initialStatus === "reading"
	? "menu_book"
	: (initialStatus === "finished" ? "check" : (initialStatus === "want_to_read" ? "add" : "library_add"));
const initialIcon = displayIconOverride || statusIcon;
const hideLabel = String(attrs["data-hide-label"] || "").trim() === "true";
const currentCustomShelfId = Math.max(0, Number(attrs["data-current-custom-shelf-id"] || 0) || 0);
const customShelvesRaw = String(attrs["data-custom-shelves"] || "[]");
const menuId = `shelf-menu-${Math.random().toString(36).slice(2, 10)}`;
let customShelves: Array<{ id: number; name: string; icon: string }> = [];
try {
	const parsed = JSON.parse(customShelvesRaw);
	if (Array.isArray(parsed)) {
		customShelves = parsed
			.map((row) => ({
				id: Math.max(0, Number((row as { id?: unknown }).id || 0) || 0),
				name: String((row as { name?: unknown }).name || "").trim(),
				icon: String((row as { icon?: unknown }).icon || "bookmarks").trim() || "bookmarks"
			}))
			.filter((row) => row.id > 0 && row.name)
			.slice(0, 24);
	}
} catch {
	customShelves = [];
}
---

<div
	class={`shelf-dropdown${hasInitialStatus ? " is-shelved" : ""}`}
	{...normalizedAttrs}
>
	<button
		type="button"
		class="shelf-trigger shelf-fab"
		data-action="toggle-shelf"
		data-status={initialStatus}
		data-display-icon={displayIconOverride}
		aria-expanded="false"
		aria-haspopup="menu"
		aria-controls={menuId}
		aria-label={`Shelf: ${initialLabel}. Open shelf options`}
		title={`Shelf: ${initialLabel}`}
	>
		<span class="material-icons shelf-plus" aria-hidden="true">{initialIcon}</span>
	</button>
	{!hideLabel && <p class="shelf-state">{initialLabel}</p>}
	<div id={menuId} class="shelf-menu" role="menu" aria-label="Shelf options" hidden>
		<button
			type="button"
			class={`shelf-option${initialStatus === "want_to_read" ? " is-current" : ""}`}
			data-action="set-shelf"
			data-status="want_to_read"
			role="menuitem"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">add</span>
			<span>Want to Read</span>
		</button>
		<button
			type="button"
			class={`shelf-option${initialStatus === "reading" ? " is-current" : ""}`}
			data-action="set-shelf"
			data-status="reading"
			role="menuitem"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">menu_book</span>
			<span>Currently Reading</span>
		</button>
		<button
			type="button"
			class={`shelf-option${initialStatus === "finished" ? " is-current" : ""}`}
			data-action="set-shelf"
			data-status="finished"
			role="menuitem"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">check</span>
			<span>Read</span>
		</button>
		<div data-custom-shelf-options>
			{customShelves.length > 0 && (
				<>
					<div class="shelf-option-divider" role="separator" aria-hidden="true"></div>
					{customShelves.map((shelf) => (
						<button
							type="button"
							class={`shelf-option${currentCustomShelfId === shelf.id ? " is-current" : ""}`}
							data-action="assign-custom-shelf"
							data-shelf-id={String(shelf.id)}
							role="menuitem"
						>
							<span class="material-icons shelf-option-icon" aria-hidden="true">{shelf.icon}</span>
							<span>{shelf.name}</span>
						</button>
					))}
				</>
			)}
		</div>
		<div class="shelf-option-divider" role="separator" aria-hidden="true"></div>
		<button
			type="button"
			class="shelf-option shelf-option-danger"
			data-action="remove-from-shelves"
			role="menuitem"
		>
			<span class="material-icons shelf-option-icon" aria-hidden="true">remove_circle</span>
			<span>Remove from Shelves</span>
		</button>
	</div>
	<p class="shelf-feedback" role="status" aria-live="polite" hidden></p>
</div>

<style>
	.shelf-dropdown {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		width: 44px;
		min-width: 44px;
		overflow: visible;
	}
	.shelf-dropdown .shelf-trigger.shelf-fab {
		width: var(--shelf-trigger-width, 44px) !important;
		height: var(--shelf-trigger-height, 44px) !important;
		min-width: var(--shelf-trigger-min-width, 44px) !important;
		min-height: var(--shelf-trigger-min-height, 44px) !important;
		border: none !important;
		border-radius: var(--shelf-trigger-radius, 999px) !important;
		padding: 0 !important;
		background: var(--color-primary) !important;
		color: #fff !important;
		cursor: pointer;
		display: grid !important;
		place-items: center !important;
		line-height: 1 !important;
	}
	.shelf-dropdown .shelf-trigger.shelf-fab:hover {
		background: var(--color-primary-hover) !important;
	}
	.shelf-plus {
		font-size: var(--shelf-trigger-icon-size, 1.4rem);
		line-height: 1;
	}
	.shelf-state {
		margin: 0.22rem 0 0;
		font-size: 0.72rem;
		line-height: 1.1;
		font-weight: 700;
		color: #1f5138;
	}
	.shelf-menu {
		--shelf-menu-gap: 0.38rem;
		--shelf-menu-caret-size: 10px;
		--shelf-caret-left: 22px;
		--shelf-caret-top: 22px;
		position: fixed;
		top: var(--shelf-menu-y, 0);
		left: var(--shelf-menu-x, 0) !important;
		right: auto !important;
		min-width: 180px;
		max-width: calc(100vw - env(safe-area-inset-left) - env(safe-area-inset-right) - 16px);
		max-height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 16px);
		overflow: auto;
		overscroll-behavior: contain;
		background: #fff;
		border: none;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-popover);
		padding: 0.28rem;
		z-index: 120;
	}
	.shelf-menu::before {
		content: "";
		position: absolute;
		width: var(--shelf-menu-caret-size);
		height: var(--shelf-menu-caret-size);
		background: #fff;
		box-shadow: -2px -2px 3px rgba(31, 41, 55, 0.04);
		transform: rotate(45deg);
	}
	.shelf-menu[data-placement="bottom"]::before {
		top: calc(var(--shelf-menu-caret-size) / -2);
		left: var(--shelf-caret-left);
	}
	.shelf-menu[data-placement="top"]::before {
		bottom: calc(var(--shelf-menu-caret-size) / -2);
		left: var(--shelf-caret-left);
		box-shadow: 2px 2px 3px rgba(31, 41, 55, 0.04);
	}
	.shelf-menu[data-placement="right"]::before {
		left: calc(var(--shelf-menu-caret-size) / -2);
		top: var(--shelf-caret-top);
	}
	.shelf-menu[data-placement="left"]::before {
		right: calc(var(--shelf-menu-caret-size) / -2);
		top: var(--shelf-caret-top);
		box-shadow: 2px 2px 3px rgba(31, 41, 55, 0.04);
	}
	.shelf-menu [data-custom-shelf-options] {
		display: contents;
		background: transparent !important;
		padding: 0;
		margin: 0;
		border: 0;
	}
	.shelf-option {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		text-align: left;
		border: none;
		background: transparent;
		padding: 0.5rem 0.62rem;
		font-size: 0.92rem;
		cursor: pointer;
		color: var(--color-text);
		font: inherit;
		line-height: 1.25;
		box-shadow: none;
		border-radius: var(--radius-sm);
	}
	.shelf-option.is-current { font-weight: 600; }
	.shelf-option-icon {
		font-size: 1.15rem;
		line-height: 1;
		color: #9aa3af;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		vertical-align: middle;
		transform: translateY(0);
		font-weight: 700;
	}
	.shelf-option.is-current .shelf-option-icon {
		color: var(--color-primary);
	}
	.shelf-option:hover {
		background: rgba(87, 117, 144, 0.09);
	}
	.shelf-option-divider {
		height: 1px;
		margin: 0.22rem 0.18rem;
		background: var(--color-border-soft);
	}
	.shelf-feedback {
		margin: 0.28rem 0 0;
		width: 100%;
		min-height: 2.1rem;
		font-size: 0.82rem;
		color: var(--color-primary);
		line-height: 1.25;
		white-space: normal;
		overflow-wrap: anywhere;
		text-align: left;
		background: transparent !important;
		border: none !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		outline: none !important;
		padding: 0 !important;
	}
	.shelf-feedback.is-error {
		color: #991b1b;
	}
	.shelf-feedback.is-busy {
		color: var(--color-text-muted);
	}
	.shelf-feedback[hidden] {
		display: block;
		visibility: hidden;
	}
	.shelf-option-danger {
		color: #8a1d1d;
	}
	.shelf-option-danger .shelf-option-icon {
		color: #8a1d1d;
	}
</style>
