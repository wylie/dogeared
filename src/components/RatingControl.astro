---
type Props = {
	bookId: number | string;
	rating?: number | null;
	editable?: boolean;
};

const { bookId, rating = 0, editable = false } = Astro.props as Props;
const normalizedRating = Math.max(0, Math.min(5, Number(rating || 0) || 0));
const stars = Array.from({ length: 5 }, (_, index) => (index < normalizedRating ? "★" : "☆")).join("");
---

<div class={`rating-control${editable ? " is-editable" : ""}`} data-rating-control data-book-id={String(bookId || "")} data-rating={normalizedRating ? String(normalizedRating) : ""}>
	<span class="rating-control-label" data-rating-label>{normalizedRating ? `Your rating: ${normalizedRating}/5` : "Rate this book"}</span>
	{!editable && <p class="rating-control-static"><span class="rating-control-stars" data-rating-stars>{stars}</span></p>}
	{editable && (
		<div class="rating-control-actions" aria-label={normalizedRating ? `Your rating: ${normalizedRating}/5` : "Rate this book"}>
			{[1, 2, 3, 4, 5].map((value) => (
				<button type="button" data-action="set-rating" data-rating={String(value)} aria-label={`${value} star${value === 1 ? "" : "s"}`} aria-pressed={normalizedRating === value ? "true" : "false"}>
					{value <= normalizedRating ? "★" : "☆"}
				</button>
			))}
			<button type="button" class="rating-clear" data-action="clear-rating" aria-label="Clear rating" title="Clear rating" hidden={normalizedRating <= 0}>
				<span class="material-icons" aria-hidden="true">cancel</span>
			</button>
		</div>
	)}
	<p class="rating-feedback" data-rating-feedback hidden></p>
</div>

<style>
	.rating-control {
		display: grid;
		gap: 0.15rem;
		margin-top: 0.35rem;
	}
	.rating-control-label {
		position: absolute !important;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	.rating-control-static {
		margin: 0;
	}
	.rating-control-stars {
		color: var(--color-rating);
		letter-spacing: 0.02em;
	}
	.rating-control-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.14rem;
	}
	.rating-control-actions button {
		border: none;
		background: transparent;
		color: var(--color-rating);
		font: inherit;
		font-size: 1.2rem;
		line-height: 1;
		padding: 0.1rem;
		cursor: pointer;
	}
	.rating-control-actions button[aria-pressed="true"] {
		transform: translateY(-1px);
	}
	.rating-control-actions button.rating-clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		appearance: none;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: #9ca3af;
		width: 1.1rem;
		height: 1.1rem;
		padding: 0;
		cursor: pointer;
		margin-left: 0.28rem;
	}
	.rating-control-actions button.rating-clear[hidden] {
		display: none;
	}
	.rating-control-actions button.rating-clear .material-icons {
		display: block;
		font-size: 1.05rem;
		line-height: 1;
	}
	.rating-control-actions button.rating-clear:hover,
	.rating-control-actions button.rating-clear:focus-visible {
		color: #6b7280;
	}
	.rating-feedback {
		margin: 0;
		font-size: 0.8rem;
		color: #1f7a45;
	}
	.rating-feedback.is-error {
		color: #991b1b;
	}
</style>
