  const leftHandFollowingItem = document.getElementById("left-hand-following-item");
  const leftHandProfileItem = document.getElementById("left-hand-profile-item");
  const leftHandProfileLink = leftHandProfileItem instanceof HTMLAnchorElement
    ? leftHandProfileItem
    : leftHandProfileItem?.querySelector("a");
  const leftHandNotificationsItem = document.getElementById("left-hand-notifications-item");
  const leftHandNotificationsLink = leftHandNotificationsItem instanceof HTMLAnchorElement
    ? leftHandNotificationsItem
    : leftHandNotificationsItem?.querySelector("a");
  const leftHandNotificationBadge = document.getElementById("left-hand-notification-badge");
  const leftHandSettingsItem = document.getElementById("left-hand-settings-item");
  const leftHandLogoutItem = document.getElementById("left-hand-logout-item");
  const leftHandLogoutButton = leftHandLogoutItem?.querySelector("button");
  const leftHandLoginModal = document.getElementById("left-hand-login-modal");
  const leftHandLoginTitle = document.getElementById("left-hand-login-title");
  const leftHandLoginCopy = document.getElementById("left-hand-login-copy");
  const leftHandLoginForm = document.getElementById("left-hand-login-form");
  const leftHandLoginEmail = document.getElementById("left-hand-login-email");
  const leftHandLoginFeedback = document.getElementById("left-hand-login-feedback");
  const leftHandSecondaryLinks = document.getElementById("left-hand-secondary-links");
  const leftHandSearchForm = leftHandNav?.querySelector("[data-search-form]");
  const leftHandSearchInput = document.getElementById("left-hand-search");
  const leftHandSearchStatus = leftHandNav?.querySelector("[data-search-submit-status]");
  const leftHandSearchClear = leftHandNav?.querySelector("[data-search-clear]");
  const splitMenus = leftHandNav
    ? Array.from(leftHandNav.querySelectorAll("[data-split-menu]"))
    : [];
  const detailsMenus = leftHandNav
    ? Array.from(leftHandNav.querySelectorAll("details.nav-menu"))
    : [];
  const authenticatedOnlyItems = leftHandNav
    ? Array.from(leftHandNav.querySelectorAll("[data-authenticated-only]"))
    : [];
  const loggedOutOnlyItems = leftHandNav
    ? Array.from(leftHandNav.querySelectorAll("[data-logged-out-only]"))
    : [];
  const NAV_SCROLL_KEY_PRIMARY = "dogeared:left-nav:primary-scroll-left";
  const NAV_SCROLL_KEY_SECONDARY = "dogeared:left-nav:secondary-scroll-left";

  function restoreNavScrollPosition() {
    if (typeof window === "undefined") return;
    const primary = Number(window.sessionStorage.getItem(NAV_SCROLL_KEY_PRIMARY) || "0");
    const secondary = Number(window.sessionStorage.getItem(NAV_SCROLL_KEY_SECONDARY) || "0");
    if (leftHandPrimaryLinks instanceof HTMLElement && Number.isFinite(primary) && primary > 0) {
      leftHandPrimaryLinks.scrollLeft = primary;
    } else {
      scrollActivePrimaryNavIntoView();
    }
    if (leftHandSecondaryLinks instanceof HTMLElement && Number.isFinite(secondary) && secondary > 0) {
      leftHandSecondaryLinks.scrollLeft = secondary;
    }
  }

  function scrollActivePrimaryNavIntoView() {
    if (!(leftHandPrimaryLinks instanceof HTMLElement)) return;
    if (!window.matchMedia("(max-width: 900px)").matches) return;
    const activeLink = leftHandPrimaryLinks.querySelector('[aria-current="page"]');
    if (!(activeLink instanceof HTMLElement)) return;
    window.requestAnimationFrame(() => {
      activeLink.scrollIntoView({ block: "nearest", inline: "center" });
      persistNavScrollPosition();
    });
  }

  function persistNavScrollPosition() {
    if (typeof window === "undefined") return;
    if (leftHandPrimaryLinks instanceof HTMLElement) {
      window.sessionStorage.setItem(NAV_SCROLL_KEY_PRIMARY, String(Math.max(0, Math.round(leftHandPrimaryLinks.scrollLeft || 0))));
    }
    if (leftHandSecondaryLinks instanceof HTMLElement) {
      window.sessionStorage.setItem(NAV_SCROLL_KEY_SECONDARY, String(Math.max(0, Math.round(leftHandSecondaryLinks.scrollLeft || 0))));
    }
  }

  function splitMenuParts(menu) {
    if (!(menu instanceof HTMLElement)) return null;
    const trigger = menu.querySelector("[data-split-menu-trigger]");
    const list = menu.querySelector("[data-split-menu-list]");
    if (!(trigger instanceof HTMLButtonElement) || !(list instanceof HTMLElement)) return null;
    return { menu, trigger, list };
  }

  function isMobilePrimaryNav() {
    return typeof window !== "undefined" && window.matchMedia("(max-width: 900px)").matches;
  }

  function scheduleMobileStickyOffsetUpdate() {
    if (typeof window === "undefined") return;
    window.requestAnimationFrame(updateMobileStickyOffset);
  }

  function detailsMenuParts(menu) {
    if (!(menu instanceof HTMLDetailsElement)) return null;
    const trigger = menu.querySelector("summary");
    const list = menu.querySelector(":scope > ul");
    if (!(trigger instanceof HTMLElement) || !(list instanceof HTMLElement)) return null;
    return { menu, trigger, list };
  }

  function syncDetailsMenuState(menu) {
    const parts = detailsMenuParts(menu);
    if (!parts) return;
    parts.trigger.setAttribute("aria-expanded", String(parts.menu.open));
    if (parts.list.id) parts.trigger.setAttribute("aria-controls", parts.list.id);
  }

  function closeDetailsMenus(options = {}) {
    const except = options.except instanceof HTMLDetailsElement ? options.except : null;
    let changed = false;
    for (const menu of detailsMenus) {
      if (!(menu instanceof HTMLDetailsElement) || menu === except || !menu.open) continue;
      menu.open = false;
      syncDetailsMenuState(menu);
      changed = true;
    }
    if (changed) scheduleMobileStickyOffsetUpdate();
  }

  function closeSplitMenus(options = {}) {
    const restoreFocus = !!options.restoreFocus;
    let focusTarget = null;
    let changed = false;
    for (const menu of splitMenus) {
      const parts = splitMenuParts(menu);
      if (!parts) continue;
      const wasOpen = parts.trigger.getAttribute("aria-expanded") === "true";
      parts.list.hidden = true;
      parts.trigger.setAttribute("aria-expanded", "false");
      if (wasOpen && !focusTarget) focusTarget = parts.trigger;
      changed = changed || wasOpen;
    }
    if (restoreFocus && focusTarget instanceof HTMLElement) {
      focusTarget.focus();
    }
    if (changed) scheduleMobileStickyOffsetUpdate();
  }

  function openSplitMenu(menu) {
    const parts = splitMenuParts(menu);
    if (!parts) return;
    closeSplitMenus();
    if (isMobilePrimaryNav()) closeDetailsMenus();
    parts.list.hidden = false;
    parts.trigger.setAttribute("aria-expanded", "true");
    scheduleMobileStickyOffsetUpdate();
  }

  function toggleSplitMenu(menu) {
    const parts = splitMenuParts(menu);
    if (!parts) return;
    const isOpen = parts.trigger.getAttribute("aria-expanded") === "true";
    if (isOpen) closeSplitMenus({ restoreFocus: false });
    else openSplitMenu(menu);
  }

  for (const menu of detailsMenus) {
    if (!(menu instanceof HTMLDetailsElement)) continue;
    syncDetailsMenuState(menu);
    menu.addEventListener("toggle", () => {
      syncDetailsMenuState(menu);
      if (menu.open && isMobilePrimaryNav()) {
        closeSplitMenus();
        closeDetailsMenus({ except: menu });
      }
      scheduleMobileStickyOffsetUpdate();
    }, { signal });
  }

