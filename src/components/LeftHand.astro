---
type SectionLink = { id: string; label: string };
type NavMatch = "exact" | "prefix";
type NavItem = {
  href: string;
  label: string;
  id?: string;
  match?: NavMatch;
  aliases?: string[];
  className?: string;
  sectionAriaLabel?: string;
};
const {
  current = "/",
  sectionLinks = [],
  isAuthenticated = false,
  isAdmin = false,
  allowAuthPrompt = true,
  foundingReaderMode = "open",
  appVersion = "v0.4.0-beta",
  releaseVersion = appVersion
} = Astro.props as {
  current?: string;
  sectionLinks?: SectionLink[];
  isAuthenticated?: boolean;
  isAdmin?: boolean;
  allowAuthPrompt?: boolean;
  foundingReaderMode?: string;
  appVersion?: string;
  releaseVersion?: string;
};
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/+$/, "") : path);
const currentNormalized = normalize(current);
const routeMatches = (href: string, match: NavMatch = "exact") => {
  const normalizedHref = normalize(href);
  if (match === "prefix") return currentNormalized === normalizedHref || currentNormalized.startsWith(`${normalizedHref}/`);
  return currentNormalized === normalizedHref;
};
const isNavItemActive = (item: Pick<NavItem, "href" | "match" | "aliases">) => {
  const match = item.match || "exact";
  return [item.href, ...(item.aliases || [])].some((href) => routeMatches(href, match));
};
const navItemHref = (item: NavItem) => isNavItemActive(item) ? undefined : item.href;
const navItemClass = (item: NavItem) => {
  const stateClass = isNavItemActive(item) ? "active" : "hover";
  return [stateClass, item.className].filter(Boolean).join(" ");
};
const navItemAriaCurrent = (item: NavItem) => isNavItemActive(item) ? "page" : undefined;
const showSectionLinks = (item: NavItem) => isNavItemActive(item) && sectionLinks.length > 0;
const query = Astro.url.searchParams.get("q") ?? "";
const normalizedFoundingReaderMode = ["open", "waitlist", "invite_only"].includes(foundingReaderMode) ? foundingReaderMode : "open";
const discoverLinkItem: NavItem = { href: "/discover", label: "Discover" };
const discoverMenuItems: NavItem[] = [
  { href: "/books", label: "Books", match: "prefix", aliases: ["/book"] },
  { href: "/authors", label: "Authors", match: "prefix", aliases: ["/author"] }
];
const discoverNavItems: NavItem[] = [discoverLinkItem, ...discoverMenuItems];
const discoverMenuActive = discoverMenuItems.some((item) => isNavItemActive(item));
const discoverGroupActive = discoverNavItems.some((item) => isNavItemActive(item));
const primaryPersonalNavItems: NavItem[] = [
  { href: "/reading-life", label: "My Reading Life", id: "left-hand-reading-life-item" },
  { href: "/journal", label: "Reading Journal", id: "left-hand-journal-item" },
  { href: "/following", label: "Following", id: "left-hand-following-item" }
];
const aboutNavItems: NavItem[] = [
  { href: "/mission", label: "Mission" },
  { href: "/metrics", label: "Metrics" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/release-notes", label: "Release Notes" }
];
const adminNavItems: NavItem[] = [
  { href: "/admin", label: "Dashboard" },
  { href: "/admin/analytics", label: "Analytics" },
  { href: "/admin/performance", label: "Performance" },
  { href: "/admin/collections", label: "Collections" },
  { href: "/admin/feedback", label: "Feedback", sectionAriaLabel: "Admin Feedback sections" },
  { href: "/admin/notifications", label: "Notifications" },
  { href: "/admin/data-health", label: "Data Health" },
  { href: "/admin/founding-readers", label: "Founding Readers", aliases: ["/admin/beta-users"] },
  { href: "/admin/releases", label: "Releases" },
  { href: "/admin/operations", label: "Operations" },
  { href: "/admin/users", label: "Users", match: "prefix" }
];
const notificationUtilityItem: NavItem = { href: "/notifications", label: "Notifications", id: "left-hand-notifications-item" };
const profileUtilityItem: NavItem = { href: "/profile", label: "Profile", id: "left-hand-profile-item", match: "prefix" };
const accountNavItems: NavItem[] = [
  { href: "/settings", label: "Settings", id: "left-hand-settings-item" }
];
const footerNavItems: NavItem[] = [
  { href: "/privacy", label: "Privacy" },
  { href: "/support", label: "Support DogEared" },
  { href: "/release-notes", label: `DogEared Beta ${releaseVersion || appVersion}` }
];
const navMenuTriggerClass = (items: NavItem[]) =>
  ["nav-menu-trigger", items.some((item) => isNavItemActive(item)) ? "active" : ""].filter(Boolean).join(" ");
---

<header
  id="left-hand-nav"
  class="app-header-shell"
  data-current={current}
  data-ssr-authenticated={String(isAuthenticated)}
  data-auth-prompt={String(allowAuthPrompt)}
  data-founding-reader-mode={normalizedFoundingReaderMode}
>
  <div class="app-header-inner site-container">
    <div class="brand-row">
      <div class="brand-lockup">
        <h2>
          <a href="/" class="special-font">
            <img
              src="/logo-96.png"
              sizes="(max-width: 900px) 32px, 50px"
              alt=""
              class="title-logo"
              aria-hidden="true"
              width="72"
              height="96"
              decoding="async"
              fetchpriority="high"
            />
            <span>DogEared</span>
          </a>
        </h2>
      </div>
    </div>

    <form action="/search" method="get" data-search-form class="global-search-form">
      <label class="visually-hidden" for="left-hand-search">Search books and authors</label>
      <div class="search-input-wrap">
        <input id="left-hand-search" type="search" name="q" placeholder="Search for Books" value={query} />
        <span class="search-submit-status" data-search-submit-status role="status" aria-live="polite" hidden>
          <span class="search-submit-spinner" aria-hidden="true"></span>
          <span class="search-submit-label visually-hidden">Searching books.</span>
        </span>
        <button type="button" class="search-clear" data-search-clear aria-label="Clear search" title="Clear search" hidden={!query.trim()}>
          <span aria-hidden="true">×</span>
        </button>
      </div>
    </form>

    <nav id="left-hand-primary-links" class="primary-links" aria-label="Primary navigation">
      <div class="nav-destination-cluster">
        <div class={`split-nav-group nav-group nav-group-discover${discoverGroupActive ? " active" : ""}`} data-split-menu>
          <a
            href={navItemHref(discoverLinkItem)}
            class={`split-nav-link ${navItemClass(discoverLinkItem)}`}
            aria-current={navItemAriaCurrent(discoverLinkItem)}
          >
            <span>{discoverLinkItem.label}</span>
          </a>
          <button
            type="button"
            class={`split-menu-button${discoverMenuActive ? " active" : ""}`}
            aria-label="Open Discover menu"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="left-hand-discover-menu"
            data-split-menu-trigger
          >
            <span aria-hidden="true">▾</span>
          </button>
          <ul id="left-hand-discover-menu" class="split-menu-list" data-split-menu-list hidden>
            {discoverMenuItems.map((item) => (
              <li>
                <a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {isAuthenticated && (
          <ul class="primary-direct-list">
            {primaryPersonalNavItems.map((item) => (
              <li id={item.id} data-authenticated-only>
                <a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>
                  <span>{item.label}</span>
                </a>
                {showSectionLinks(item) && (
                  <ul class="section-links-nested" aria-label={item.sectionAriaLabel}>
                    {sectionLinks.map((link) => (
                      <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )}

        <details class="nav-menu nav-group nav-group-about">
          <summary class={navMenuTriggerClass(aboutNavItems)} aria-expanded="false" aria-controls="left-hand-about-menu">About</summary>
          <ul id="left-hand-about-menu">
            {aboutNavItems.map((item) => (
              <li>
                <a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>
                  <span>{item.label}</span>
                </a>
                {showSectionLinks(item) && (
                  <ul class="section-links-nested" aria-label={item.sectionAriaLabel}>
                  {sectionLinks.map((link) => (
                    <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                  ))}
                </ul>
                )}
              </li>
            ))}
            {footerNavItems.slice(0, 2).map((item) => (
              <li><a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>{item.label}</a></li>
            ))}
          </ul>
        </details>

        {isAdmin && (
        <details class="nav-menu nav-group nav-group-admin">
          <summary class={navMenuTriggerClass(adminNavItems)} aria-expanded="false" aria-controls="left-hand-admin-menu">Admin</summary>
            <ul id="left-hand-admin-menu">
              {adminNavItems.map((item) => (
                <li id={item.id}>
                  <a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>{item.label}</a>
                  {showSectionLinks(item) && (
                    <ul class="section-links-nested" aria-label={item.sectionAriaLabel}>
                      {sectionLinks.map((link) => (
                        <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </details>
        )}

        {!isAuthenticated && allowAuthPrompt && (
          <button id="left-hand-login-item" data-logged-out-only type="button" class="nav-text-button hover">Log In</button>
        )}
      </div>

      {isAuthenticated && (
        <div class="utility-nav-list" aria-label="Account utilities" data-authenticated-only>
          <a
            id={notificationUtilityItem.id}
            data-authenticated-only
            href={navItemHref(notificationUtilityItem)}
            class={`utility-icon-button ${navItemClass(notificationUtilityItem)}`}
            aria-current={navItemAriaCurrent(notificationUtilityItem)}
            aria-label="Notifications"
            title="Notifications"
          >
            <span class="material-icons" aria-hidden="true">notifications</span>
            <span id="left-hand-notification-badge" class="notification-badge utility-notification-badge" aria-hidden="true" hidden>0</span>
          </a>

          <a
            id={profileUtilityItem.id}
            data-authenticated-only
            href={navItemHref(profileUtilityItem)}
            class={`utility-icon-button ${navItemClass(profileUtilityItem)}`}
            aria-current={navItemAriaCurrent(profileUtilityItem)}
            aria-label="View your Profile"
            title="Profile"
          >
            <span class="material-icons" aria-hidden="true">account_circle</span>
          </a>

          <details class="nav-menu nav-group nav-group-account utility-menu" data-authenticated-only>
            <summary
              id="left-hand-settings-item"
              class={`${navMenuTriggerClass(accountNavItems)} utility-icon-button`}
              aria-current={accountNavItems.some((item) => isNavItemActive(item)) ? "page" : undefined}
              aria-expanded="false"
              aria-controls="left-hand-account-menu"
              aria-label="Account settings"
              title="Settings"
            >
              <span class="material-icons" aria-hidden="true">settings</span>
            </summary>
            <ul id="left-hand-account-menu">
              {accountNavItems.map((item) => (
                <li data-authenticated-only>
                  <a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>
                    <span>{item.label}</span>
                  </a>
                  {showSectionLinks(item) && (
                    <ul class="section-links-nested" aria-label={item.sectionAriaLabel}>
                      {sectionLinks.map((link) => (
                        <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
              <li id="left-hand-logout-item" data-authenticated-only><button type="button" class="nav-text-button hover">Log Out</button></li>
            </ul>
          </details>
        </div>
      )}
    </nav>

    {sectionLinks.length > 0 && (
      <ul id="left-hand-secondary-links" class="secondary-links-mobile" aria-label="Section navigation">
        {sectionLinks.map((link) => (
          <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
        ))}
      </ul>
    )}

    <footer class="header-footer">
      <nav class="header-footer-nav" aria-label="Footer navigation">
        <ul>
          {footerNavItems.map((item) => (
            <li><a href={navItemHref(item)} class={navItemClass(item)} aria-current={navItemAriaCurrent(item)}>{item.label}</a></li>
          ))}
          <li>
            <span>Built by Argon Collective LLC</span>
          </li>
        </ul>
      </nav>
    </footer>
  </div>
  {allowAuthPrompt && (
    <div id="left-hand-login-modal" class="login-modal" hidden>
      <div class="login-modal-backdrop" data-action="close-login-modal"></div>
      <div class="login-modal-panel" role="dialog" aria-modal="true" aria-labelledby="left-hand-login-title">
        <button type="button" class="login-modal-close" data-action="close-login-modal" aria-label="Close login dialog">×</button>
        <h3 id="left-hand-login-title">Welcome to DogEared</h3>
        <p id="left-hand-login-copy" class="login-modal-copy">Enter your email to continue or request access to the Founding Reader Program.</p>
        <form id="left-hand-login-form" class="login-modal-form">
          <label for="left-hand-login-email">Email</label>
          <input id="left-hand-login-email" type="email" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" required placeholder="you@example.com" />
          <button type="submit" class="login-submit">Continue</button>
        </form>
        <p id="left-hand-login-feedback" class="login-feedback" hidden></p>
      </div>
    </div>
  )}
</header>

<style>
  #left-hand-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    box-sizing: border-box;
    padding: 0.48rem 0;
    background: rgba(255, 255, 255, 0.93);
    border-bottom: var(--border-subtle);
    box-shadow: 0 8px 28px rgba(29, 49, 64, 0.08);
    backdrop-filter: blur(10px);
  }

  .app-header-inner {
    display: grid;
    grid-template-columns: auto minmax(15rem, 29rem) minmax(0, 1fr);
    gap: 0.55rem clamp(0.7rem, 1.25vw, 1rem);
    align-items: center;
  }

  .brand-row {
    min-width: 0;
  }

  .brand-lockup,
  h2 {
    display: grid;
    min-width: 0;
    margin: 0;
  }

  h2 a.special-font {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    width: max-content;
    max-width: 100%;
    color: var(--color-text);
    font-size: clamp(1.45rem, 2.1vw, 1.85rem);
    line-height: 1;
    white-space: nowrap;
  }

  .title-logo {
    display: inline-block;
    width: clamp(34px, 3vw, 42px);
    height: clamp(34px, 3vw, 42px);
    object-fit: contain;
    flex: 0 0 auto;
  }

  .primary-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(0.55rem, 1.3vw, 1rem);
    min-width: 0;
    overflow: visible;
  }

  .primary-direct-list,
  .nav-group > ul,
  .split-menu-list,
  .header-footer-nav ul,
  .secondary-links-mobile {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .nav-destination-cluster,
  .primary-direct-list,
  .utility-nav-list {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.14rem;
    min-width: 0;
  }

  .nav-destination-cluster {
    flex: 0 1 auto;
  }

  .primary-direct-list {
    flex: 0 0 auto;
  }

  .utility-nav-list {
    flex: 0 0 auto;
    gap: 0.18rem;
    padding-left: clamp(0.35rem, 0.9vw, 0.65rem);
    margin-left: clamp(0.1rem, 0.5vw, 0.35rem);
  }

  .nav-group {
    position: relative;
  }

  .nav-group > ul {
    display: grid;
    gap: 0.12rem;
  }

  .nav-menu > ul,
  .split-menu-list {
    position: absolute;
    top: calc(100% + 0.45rem);
    right: 0;
    z-index: 90;
    min-width: 13rem;
    max-width: min(18rem, calc(100vw - 1.5rem));
    padding: 0.38rem;
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow-popover);
  }
  .split-menu-list {
    display: grid;
    gap: 0.12rem;
  }
  .split-menu-list[hidden],
  .nav-group > ul.split-menu-list[hidden] {
    display: none;
  }

  .nav-group-admin > ul {
    min-width: 15rem;
    max-height: min(70vh, 32rem);
    overflow: auto;
  }

  .utility-menu > ul {
    min-width: 10rem;
  }

  .secondary-links-mobile {
    display: none;
  }

  .section-links-nested {
    list-style: none;
    margin: 0.24rem 0 0.14rem;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--color-border-soft);
  }
  .section-links-nested li + li {
    margin-top: 0.08rem;
  }
  .section-links-nested a {
    font-size: 0.9em;
    color: var(--color-nav);
  }

  .primary-direct-list > li > .section-links-nested {
    display: none;
  }

  .header-footer {
    display: none;
    color: var(--color-text-subtle);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .header-footer a {
    color: var(--color-nav);
    text-decoration: none;
  }
  .header-footer a,
  .header-footer span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .header-footer a {
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .header-footer a:hover,
  .header-footer a:focus-visible {
    color: var(--color-nav-hover);
    text-decoration: underline;
  }
  .header-footer a.active {
    color: var(--color-nav-active);
    text-decoration: underline;
  }

  li {
    text-align: left;
    gap: .25rem;
  }

  a {
    text-decoration: none;
    color: var(--color-nav);
    border-radius: var(--radius-pill);
  }

  .primary-links a,
  .primary-links .nav-text-button,
  .nav-menu-trigger,
  .split-menu-button {
    display: inline-flex;
    align-items: center;
    min-height: 2.08rem;
    box-sizing: border-box;
    padding: 0.35rem 0.56rem;
    line-height: 1.2;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .split-nav-group {
    display: inline-flex;
    align-items: center;
    gap: 0.04rem;
  }

  .split-nav-link {
    padding-right: 0.34rem;
  }

  .split-menu-button {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--color-nav);
    font: inherit;
    padding-left: 0.22rem;
    padding-right: 0.42rem;
    cursor: pointer;
  }

  .split-menu-button span {
    display: inline-block;
    color: var(--color-text-subtle);
    font-size: 0.7rem;
    line-height: 1;
    transition: transform 140ms ease;
  }

  .split-menu-button[aria-expanded="true"] span {
    transform: rotate(180deg);
  }

  .utility-icon-button {
    position: relative;
    justify-content: center;
    width: 2.1rem;
    min-width: 2.1rem;
    min-height: 2.1rem;
    padding: 0;
    gap: 0;
  }

  .utility-icon-button .material-icons {
    font-size: 1.22rem;
    line-height: 1;
  }

  .nav-menu > ul a,
  .split-menu-list a,
  .nav-menu > ul .nav-text-button {
    justify-content: flex-start;
    width: 100%;
  }

  .nav-menu-trigger {
    cursor: pointer;
    color: var(--color-nav);
    user-select: none;
    gap: 0.34rem;
  }

  .nav-menu-trigger::-webkit-details-marker {
    display: none;
  }

  .nav-menu-trigger::after {
    content: "▾";
    margin-left: 0.34rem;
    color: var(--color-text-subtle);
    font-size: 0.7rem;
    line-height: 1;
    display: inline-block;
    transition: transform 140ms ease;
  }

  .nav-menu[open] > .nav-menu-trigger::after {
    transform: rotate(180deg);
  }

  .utility-menu > .nav-menu-trigger::after {
    content: none;
    margin-left: 0;
  }

  .notification-badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-pill);
    background: rgba(31, 122, 69, 0.14);
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 850;
    line-height: 1;
    padding: 0 0.25rem;
  }
  .notification-badge[hidden] {
    display: none;
  }
  .utility-notification-badge {
    position: absolute;
    top: 0.14rem;
    right: 0.05rem;
    min-width: 0.92rem;
    height: 0.92rem;
    border: 1px solid rgba(255, 255, 255, 0.92);
    font-size: 0.58rem;
    padding: 0 0.18rem;
    box-shadow: 0 1px 4px rgba(31, 122, 69, 0.22);
  }

  a.active,
  .nav-menu-trigger.active,
  .split-menu-button.active {
    background: var(--color-nav-surface);
    color: var(--color-nav-active);
    text-decoration: none;
    cursor: default;
    border-left: 0;
    font-weight: 700;
  }
  .split-menu-button.active {
    cursor: pointer;
  }
  .section-links-nested a.section-active {
    color: var(--color-nav-active);
    background: var(--color-nav-surface);
    text-decoration: none;
  }

  .hover:hover,
  .hover:focus-visible,
  .nav-menu-trigger:hover,
  .split-menu-button:hover,
  .split-menu-button:focus-visible,
  .utility-icon-button:hover,
  .utility-icon-button:focus-visible,
  .nav-menu-trigger:focus-visible {
    color: var(--color-nav-hover);
    text-decoration: none;
    background: var(--color-nav-surface-hover);
  }

  .primary-links a:focus-visible,
  .primary-links .nav-text-button:focus-visible,
  .nav-menu-trigger:focus-visible,
  .split-menu-button:focus-visible {
    outline: 3px solid rgba(31, 122, 69, 0.34);
    outline-offset: 2px;
  }

  .nav-text-button {
    appearance: none;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    color: var(--color-nav);
    font: inherit;
    cursor: pointer;
    border-radius: var(--radius-pill);
  }

