---
import Widget from "./Widget.astro"
type SectionLink = { id: string; label: string };
const { current = "/", sectionLinks = [], isAuthenticated = false, isAdmin = false } = Astro.props as { current?: string; sectionLinks?: SectionLink[]; isAuthenticated?: boolean; isAdmin?: boolean };
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/+$/, "") : path);
const isActive = (href: string) => normalize(current) === normalize(href);
const currentNormalized = normalize(current);
const isProfilePage = currentNormalized === "/profile" || currentNormalized.startsWith("/profile/");
const isReadingLifePage = currentNormalized === "/reading-life";
const isJournalPage = currentNormalized === "/journal";
const isDiscoverPage = currentNormalized === "/discover";
const isHomePage = currentNormalized === "/";
const isAdminDashboardPage = currentNormalized === "/admin";
const isAdminCollectionsPage = currentNormalized === "/admin/collections";
const isAdminUsersPage = currentNormalized === "/admin/users" || currentNormalized.startsWith("/admin/users/");
const query = Astro.url.searchParams.get("q") ?? "";
---

<Widget style="height: 100%; padding: 0; overflow: visible;" background={true}>
  <div id="left-hand-nav" data-current={current} data-ssr-authenticated={String(isAuthenticated)}>
    <div class="mobile-top-row">
      <h2>
        <a href="/" class="special-font">
          <img
            src="/logo-96.png"
            sizes="(max-width: 900px) 55px, 50px"
            alt=""
            class="title-logo"
            aria-hidden="true"
            width="72"
            height="96"
            decoding="async"
            fetchpriority="high"
          />
          <span>DogEared</span>
        </a>
      </h2>
    </div>
    <form action="/search" method="get">
      <label class="visually-hidden" for="left-hand-search">Search books and authors</label>
      <input id="left-hand-search" type="search" name="q" placeholder="Search for Books" value={query} />
    </form>
    <nav id="left-hand-primary-links" class="primary-links" aria-label="Primary navigation">
      <section class="nav-group nav-group-you">
        <h3 class="nav-group-title">You</h3>
        <ul>
          <li id="left-hand-login-item" hidden={isAuthenticated}><button type="button" class="nav-text-button hover">Log In</button></li>
          <li id="left-hand-profile-item" hidden={!isAuthenticated}>
            <a href="/profile" class={isProfilePage ? 'active' : 'hover'} aria-current={isProfilePage ? 'page' : undefined}><span id="left-hand-profile-label">Profile</span></a>
            {isProfilePage && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li id="left-hand-reading-life-item" hidden={!isAuthenticated}>
            <a href={isReadingLifePage ? undefined : '/reading-life'} class={isReadingLifePage ? 'active' : 'hover'} aria-current={isReadingLifePage ? 'page' : undefined}>My Reading Life</a>
            {isReadingLifePage && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li id="left-hand-journal-item" hidden={!isAuthenticated}>
            <a href={isJournalPage ? undefined : '/journal'} class={isJournalPage ? 'active' : 'hover'} aria-current={isJournalPage ? 'page' : undefined}>Reading Journal</a>
            {isJournalPage && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li id="left-hand-settings-item" hidden={!isAuthenticated}>
            <a href={isActive('/settings') ? undefined : '/settings'} class={isActive('/settings') ? 'active' : 'hover'} aria-current={isActive('/settings') ? 'page' : undefined}>Settings</a>
            {isActive('/settings') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li id="left-hand-logout-item" hidden={!isAuthenticated}><button type="button" class="nav-text-button hover">Log Out</button></li>
        </ul>
      </section>

      <section class="nav-group nav-group-explore">
        <h3 class="nav-group-title">Explore</h3>
        <ul>
          <li>
            <a href={isDiscoverPage ? undefined : '/discover'} class={isDiscoverPage ? 'active' : 'hover'} aria-current={isDiscoverPage ? 'page' : undefined}>Discover</a>
            {isDiscoverPage && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li>
            <a href={isActive('/books') ? undefined : '/books'} class={isActive('/books') ? 'active' : 'hover'} aria-current={isActive('/books') ? 'page' : undefined}>Books</a>
            {isActive('/books') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li>
            <a href={isActive('/authors') ? undefined : '/authors'} class={isActive('/authors') ? 'active' : 'hover'} aria-current={isActive('/authors') ? 'page' : undefined}>Authors</a>
            {isActive('/authors') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li>
            <a href={isActive('/collections') ? undefined : '/collections'} class={isActive('/collections') || currentNormalized.startsWith('/collections/') ? 'active' : 'hover'} aria-current={isActive('/collections') || currentNormalized.startsWith('/collections/') ? 'page' : undefined}>Collections</a>
            {(isActive('/collections') || currentNormalized.startsWith('/collections/')) && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li id="left-hand-following-item" hidden={!isAuthenticated}>
            <a href={isActive('/following') ? undefined : '/following'} class={isActive('/following') ? 'active' : 'hover'} aria-current={isActive('/following') ? 'page' : undefined}>Following</a>
            {isActive('/following') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        </ul>
      </section>

      <section class="nav-group nav-group-about">
        <h3 class="nav-group-title">About</h3>
        <ul>
          <li>
            <a href={isActive('/mission') ? undefined : '/mission'} class={isActive('/mission') ? 'active' : 'hover'} aria-current={isActive('/mission') ? 'page' : undefined}>Mission</a>
            {isActive('/mission') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li>
            <a href={isActive('/metrics') ? undefined : '/metrics'} class={isActive('/metrics') ? 'active' : 'hover'} aria-current={isActive('/metrics') ? 'page' : undefined}>Metrics</a>
            {isActive('/metrics') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
          <li>
            <a href={isActive('/roadmap') ? undefined : '/roadmap'} class={isActive('/roadmap') ? 'active' : 'hover'} aria-current={isActive('/roadmap') ? 'page' : undefined}>Roadmap</a>
            {isActive('/roadmap') && sectionLinks.length > 0 && (
              <ul class="section-links-nested">
                {sectionLinks.map((link) => (
                  <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        </ul>
      </section>

      {isAdmin && (
        <section class="nav-group nav-group-admin">
          <h3 class="nav-group-title">Admin</h3>
          <ul>
            <li>
              <a href={isAdminDashboardPage ? undefined : '/admin'} class={isAdminDashboardPage ? 'active' : 'hover'} aria-current={isAdminDashboardPage ? 'page' : undefined}>Dashboard</a>
              {isAdminDashboardPage && sectionLinks.length > 0 && (
                <ul class="section-links-nested">
                  {sectionLinks.map((link) => (
                    <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
            <li>
              <a href={isAdminCollectionsPage ? undefined : '/admin/collections'} class={isAdminCollectionsPage ? 'active' : 'hover'} aria-current={isAdminCollectionsPage ? 'page' : undefined}>Collections</a>
              {isAdminCollectionsPage && sectionLinks.length > 0 && (
                <ul class="section-links-nested">
                  {sectionLinks.map((link) => (
                    <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
            <li>
              <a href={isActive('/admin/data-health') ? undefined : '/admin/data-health'} class={isActive('/admin/data-health') ? 'active' : 'hover'} aria-current={isActive('/admin/data-health') ? 'page' : undefined}>Data Health</a>
              {isActive('/admin/data-health') && sectionLinks.length > 0 && (
                <ul class="section-links-nested">
                  {sectionLinks.map((link) => (
                    <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
            <li>
              <a href={isAdminUsersPage ? undefined : '/admin/users'} class={isAdminUsersPage ? 'active' : 'hover'} aria-current={isAdminUsersPage ? 'page' : undefined}>Users</a>
              {isAdminUsersPage && sectionLinks.length > 0 && (
                <ul class="section-links-nested">
                  {sectionLinks.map((link) => (
                    <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          </ul>
        </section>
      )}
    </nav>
    {sectionLinks.length > 0 && (
      <ul id="left-hand-secondary-links" class="secondary-links-mobile" aria-label="Section navigation">
        {sectionLinks.map((link) => (
          <li><a href={`#${link.id}`} class="hover" data-section-link={link.id}>{link.label}</a></li>
        ))}
      </ul>
    )}
    <footer class="sidebar-footer" aria-label="Site information">
      <p>Built by <a href="https://argoncollective.com" target="_blank" rel="noopener noreferrer">Argon Collective LLC</a></p>
      <nav aria-label="Site links">
        <a href="/privacy" class={isActive('/privacy') ? 'active' : 'hover'} aria-current={isActive('/privacy') ? 'page' : undefined}>Privacy</a>
        <a href="/support" class={isActive('/support') ? 'active' : 'hover'} aria-current={isActive('/support') ? 'page' : undefined}>Support DogEared</a>
      </nav>
    </footer>
  </div>
    <div id="left-hand-login-modal" class="login-modal" hidden>
    <div class="login-modal-backdrop" data-action="close-login-modal"></div>
    <div class="login-modal-panel" role="dialog" aria-modal="true" aria-labelledby="left-hand-login-title">
      <button type="button" class="login-modal-close" data-action="close-login-modal" aria-label="Close login dialog">×</button>
      <h3 id="left-hand-login-title">Welcome to DogEared</h3>
      <p id="left-hand-login-copy" class="login-modal-copy">Enter your email and continue with a magic link.</p>
      <form id="left-hand-login-form" class="login-modal-form">
        <label for="left-hand-login-email">Email</label>
        <input id="left-hand-login-email" type="email" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" required placeholder="you@example.com" />
        <button type="submit" class="login-submit">Continue</button>
      </form>
      <p id="left-hand-login-feedback" class="login-feedback" hidden></p>
    </div>
  </div>
</Widget>

<style>
  #left-hand-nav {
    padding: 1.05rem 0.95rem 1rem;
    min-height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .mobile-top-row {
    display: block;
  }
  .primary-links {
    margin: 1.05rem 0 0;
    padding: 1.05rem 0 0;
    border-top: var(--border-subtle);
    display: grid;
    gap: 1rem;
  }
  .nav-group {
    display: grid;
    gap: 0.34rem;
  }
  .nav-group-title {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    font-weight: 760;
  }
  .nav-group > ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.08rem;
  }
  .secondary-links-mobile {
    display: none;
  }
  .section-links-nested {
    list-style: none;
    margin: 0.24rem 0 0.14rem;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--color-border-soft);
  }
  .section-links-nested li + li {
    margin-top: 0.08rem;
  }
  .section-links-nested a {
    font-size: 0.9em;
    color: var(--color-nav);
  }
  .sidebar-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: var(--border-subtle);
    color: var(--color-text-subtle);
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .sidebar-footer p {
    margin: 0;
  }
  .sidebar-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    margin-top: 0.45rem;
  }
  .sidebar-footer a {
    color: var(--color-nav);
    text-decoration: none;
  }
  .sidebar-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .sidebar-footer nav a:hover,
  .sidebar-footer nav a:focus-visible {
    color: var(--color-nav-hover);
    text-decoration: underline;
  }
  .sidebar-footer nav a.active {
    color: var(--color-nav-active);
    text-decoration: underline;
  }
  li {
    text-align: left;
    width: 100%;
    gap: .25rem;
  }
  a {
    text-decoration: none;
    color: var(--color-nav);
    border-radius: var(--radius-sm);
  }
  .primary-links .nav-group > ul > li > a,
  .primary-links .nav-group > ul > li > .nav-text-button {
    display: flex;
    align-items: center;
    min-height: 2rem;
    width: 100%;
    box-sizing: border-box;
    padding: 0.34rem 0.58rem;
    line-height: 1.2;
    border-radius: var(--radius-pill);
  }
  a.active {
    background: var(--color-nav-surface);
    color: var(--color-nav-active);
    text-decoration: none;
    cursor: default;
    border-left: 0;
    font-weight: 700;
  }
  .section-links-nested a.section-active {
    color: var(--color-nav-active);
    background: var(--color-nav-surface);
    text-decoration: none;
  }
  /* .hover:hover {
    color: var(--color-nav-hover);
    text-decoration: none;
    background: var(--color-nav-surface-hover);
  } */
  .nav-text-button {
    appearance: none;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    color: var(--color-nav);
    font: inherit;
    cursor: pointer;
    border-radius: var(--radius-pill);
  }
  .mobile-menu-toggle {
    display: none;
    appearance: none;
    border: none;
    background: transparent;
    color: var(--color-text);
    border-radius: 0;
    padding: 0.2rem 0.3rem;
    font: inherit;
    font-weight: 800;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  input[type="search"] {
    font-size: 16px;
    width: 100%;
    border: 1px solid rgba(87, 117, 144, 0.18);
    border-radius: var(--radius-pill);
    padding: 0.58rem 0.95rem;
    margin-top: 1rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-text);
  }
  input[type="search"]::placeholder {
    color: var(--color-text-subtle);
  }
  input[type="search"]:focus {
    background: #fff;
    border-color: var(--color-border);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  form {
    width: 100%;
  }
  h2 {
    width: 100%;
    margin: 0 0 0.75rem 0;
    container-type: inline-size;
  }
  h2 a.special-font {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    width: 100%;
    font-size: clamp(2rem, 15cqw, 3rem);
    line-height: 1;
    white-space: nowrap;
  }
  .title-logo {
    display: inline-block;
    width: clamp(50px, 4.8cqw, 44px);
    height: clamp(50px, 4.8cqw, 44px);
    object-fit: contain;
    flex: 0 0 auto;
  }
  .login-modal[hidden] {
    display: none !important;
  }
  .login-modal {
    position: fixed;
    inset: 0;
    z-index: 12000;
  }
  .login-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
  }
  .login-modal-panel {
    position: relative;
    z-index: 1;
    width: min(420px, calc(100vw - 2rem));
    margin: 12vh auto 0;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 1rem;
    box-shadow: var(--shadow-popover);
  }
  .login-modal-panel h3 {
    margin: 0;
  }
  .login-modal-copy {
    margin: 0.5rem 0 0.9rem;
    color: #444;
  }
  .login-modal-form {
    display: grid;
    gap: 0.55rem;
  }
  .login-modal-form label {
    font-weight: 600;
  }
  .login-modal-form input[type="email"] {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: var(--border-strong);
    border-radius: var(--radius-md);
    padding: 0.7rem 0.85rem;
    font-size: 16px;
    margin-top: 0;
  }
  .login-submit {
    appearance: none;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.9rem;
    background: #151515;
    color: #fff;
    font: inherit;
    cursor: pointer;
    justify-self: start;
  }
  .login-modal-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    appearance: none;
    border: none;
    background: transparent;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text-muted);
  }
  .login-feedback {
    margin: 0.8rem 0 0;
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius-md);
    background: #f3f6f8;
    color: #1f2937;
  }
  .login-feedback.error {
    background: #fef2f2;
    color: #991b1b;
  }
  @media (max-width: 900px) {
    #left-hand-nav {
      position: sticky;
      top: 0;
      z-index: 30;
      display: grid;
      grid-template-areas:
        "top"
        "links"
        "secondary"
        "search"
        "footer";
      background: rgba(255, 255, 255, 0.92);
      border-bottom: var(--border-subtle);
      border-bottom-left-radius: 18px;
      border-bottom-right-radius: 18px;
      padding: 0.6rem 0.5rem 0.55rem;
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
      box-sizing: border-box;
    }
    .mobile-top-row {
      grid-area: top;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.55rem;
      min-height: 56px;
    }
    #left-hand-nav h2 {
      margin: 0;
      display: flex;
      align-items: center;
    }
    #left-hand-nav h2 a.special-font {
      font-size: clamp(2.25rem, 10vw, 2.95rem);
      gap: 0.4rem;
    }
    #left-hand-nav h2 a.special-font .title-logo {
      width: clamp(34px, 10vw, 55px);
      height: clamp(34px, 10vw, 55px);
    }
    #left-hand-nav form {
      grid-area: search;
      margin: 0.35rem 0 0.2rem;
      display: block;
    }
    #left-hand-nav input[type="search"] {
      margin-top: 0;
      padding: 0.4rem 0.8rem;
      border: var(--border-strong);
    }
    #left-hand-nav .primary-links {
      display: flex;
      flex-wrap: nowrap;
      column-gap: 1rem;
      row-gap: 0.5rem;
      border-top: none;
      margin-top: 0;
      padding: 0 0 0.5rem;
      grid-area: links;
      align-items: center;
      min-width: 0;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      white-space: nowrap;
    }
    #left-hand-nav .primary-links::-webkit-scrollbar { display: none; }
    #left-hand-nav .primary-links .nav-group {
      gap: 0.2rem;
      min-width: fit-content;
      flex: 0 0 auto;
    }
    #left-hand-nav .primary-links .nav-group-title {
      font-size: 0.72rem;
      color: var(--color-text-subtle);
      margin-bottom: 0.08rem;
    }
    #left-hand-nav .primary-links .nav-group > ul {
      display: flex;
      gap: 0.95rem;
      padding: 0;
      margin: 0;
      list-style: none;
      align-items: center;
      white-space: nowrap;
    }
    #left-hand-nav .primary-links .nav-group > ul > li {
      flex: 0 0 auto;
      width: auto;
    }
    #left-hand-nav .primary-links a,
    #left-hand-nav .primary-links .nav-text-button {
      display: inline-flex;
      align-items: center;
      border: none;
      background: transparent;
      border-radius: var(--radius-pill);
      padding: 0.38rem 0.2rem;
      line-height: 1.25;
      text-decoration: none;
      color: var(--color-nav);
    }
    #left-hand-nav .primary-links a.active {
      background: var(--color-nav-surface);
      color: var(--color-nav-active);
      text-decoration: none;
      border-left: 0;
    }
    #left-hand-nav .primary-links a.hover:hover,
    #left-hand-nav .primary-links .nav-text-button.hover:hover,
    #left-hand-nav .primary-links a:focus-visible,
    #left-hand-nav .primary-links .nav-text-button:focus-visible {
      text-decoration: none;
      background: var(--color-nav-surface-hover);
      color: var(--color-nav-hover);
    }
    #left-hand-nav .section-links-nested {
      display: none;
    }
    #left-hand-nav .secondary-links-mobile {
      grid-area: secondary;
      display: flex;
      flex-wrap: nowrap;
      column-gap: 0.85rem;
      row-gap: 0.45rem;
      list-style: none;
      margin: 0.15rem 0 0;
      padding: 0.6rem 0 0.35rem;
      border-top: var(--border-subtle);
      align-items: center;
      min-width: 0;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      white-space: nowrap;
    }
    #left-hand-nav .secondary-links-mobile li:first-child {
      padding-left: 0.2rem;
    }
    #left-hand-nav .secondary-links-mobile::-webkit-scrollbar {
      display: none;
    }
    #left-hand-nav .secondary-links-mobile li {
      flex: 0 0 auto;
      width: auto;
    }
    #left-hand-nav .secondary-links-mobile a {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      color: var(--color-nav);
      line-height: 1.25;
      padding: 0.34rem 0.2rem;
      border-radius: var(--radius-pill);
    }
    #left-hand-nav .secondary-links-mobile a.section-active {
      background: var(--color-nav-surface);
      color: var(--color-nav-active);
      text-decoration: none;
    }
    #left-hand-nav .sidebar-footer {
      grid-area: footer;
      margin-top: 0.35rem;
      padding-top: 0.5rem;
      font-size: 0.76rem;
    }
    #left-hand-nav .sidebar-footer nav {
      gap: 0.35rem 0.6rem;
    }
  }
  @media (max-width: 680px) {
    .mobile-top-row {
      margin-bottom: 0.5rem;
      min-height: 52px;
    }
    #left-hand-nav h2 a.special-font {
      font-size: clamp(2.1rem, 9.2vw, 2.6rem);
    }
  }
</style>

<script>
  import { resolveClientAuthState, subscribeAuthStateChange, setAuthPreviewMode } from "../lib/clientAuth.ts";

  const leftHandNav = document.getElementById("left-hand-nav");
  const ssrAuthenticated = leftHandNav?.dataset.ssrAuthenticated === "true";
  const leftHandMenuToggle = document.getElementById("left-hand-menu-toggle");
  const leftHandPrimaryLinks = document.getElementById("left-hand-primary-links");
  const leftHandLoginItem = document.getElementById("left-hand-login-item");
  const leftHandLoginButton = leftHandLoginItem?.querySelector("button");
  const leftHandFollowingItem = document.getElementById("left-hand-following-item");
  const leftHandProfileItem = document.getElementById("left-hand-profile-item");
  const leftHandProfileLink = leftHandProfileItem?.querySelector("a");
  const leftHandProfileLabel = document.getElementById("left-hand-profile-label");
  const leftHandSettingsItem = document.getElementById("left-hand-settings-item");
  const leftHandLogoutItem = document.getElementById("left-hand-logout-item");
  const leftHandAuthDivider = document.getElementById("left-hand-auth-divider");
  const leftHandLogoutButton = leftHandLogoutItem?.querySelector("button");
  const leftHandLoginModal = document.getElementById("left-hand-login-modal");
  const leftHandLoginTitle = document.getElementById("left-hand-login-title");
  const leftHandLoginCopy = document.getElementById("left-hand-login-copy");
  const leftHandLoginForm = document.getElementById("left-hand-login-form");
  const leftHandLoginEmail = document.getElementById("left-hand-login-email");
  const leftHandLoginFeedback = document.getElementById("left-hand-login-feedback");
  const leftHandSecondaryLinks = document.getElementById("left-hand-secondary-links");
  const NAV_SCROLL_KEY_PRIMARY = "dogeared:left-nav:primary-scroll-left";
  const NAV_SCROLL_KEY_SECONDARY = "dogeared:left-nav:secondary-scroll-left";

  function restoreNavScrollPosition() {
    if (typeof window === "undefined") return;
    const primary = Number(window.sessionStorage.getItem(NAV_SCROLL_KEY_PRIMARY) || "0");
    const secondary = Number(window.sessionStorage.getItem(NAV_SCROLL_KEY_SECONDARY) || "0");
    if (leftHandPrimaryLinks instanceof HTMLElement && Number.isFinite(primary) && primary > 0) {
      leftHandPrimaryLinks.scrollLeft = primary;
    }
    if (leftHandSecondaryLinks instanceof HTMLElement && Number.isFinite(secondary) && secondary > 0) {
      leftHandSecondaryLinks.scrollLeft = secondary;
    }
  }

  function persistNavScrollPosition() {
    if (typeof window === "undefined") return;
    if (leftHandPrimaryLinks instanceof HTMLElement) {
      window.sessionStorage.setItem(NAV_SCROLL_KEY_PRIMARY, String(Math.max(0, Math.round(leftHandPrimaryLinks.scrollLeft || 0))));
    }
    if (leftHandSecondaryLinks instanceof HTMLElement) {
      window.sessionStorage.setItem(NAV_SCROLL_KEY_SECONDARY, String(Math.max(0, Math.round(leftHandSecondaryLinks.scrollLeft || 0))));
    }
  }

  // Safari can clip fixed overlays when nested inside sticky/scroll containers.
  // Portal the modal to <body> so it always covers the full viewport.
  if (leftHandLoginModal instanceof HTMLElement && leftHandLoginModal.parentElement !== document.body) {
    document.body.appendChild(leftHandLoginModal);
  }

  function showLoginFeedback(message, isError = false) {
    if (!(leftHandLoginFeedback instanceof HTMLElement)) return;
    leftHandLoginFeedback.textContent = message;
    leftHandLoginFeedback.hidden = !message;
    leftHandLoginFeedback.classList.toggle("error", isError);
  }

  function openLoginModal(mode = "login") {
    if (!(leftHandLoginModal instanceof HTMLElement)) return;
    const creating = mode === "create";
    if (leftHandLoginTitle instanceof HTMLElement) {
      leftHandLoginTitle.textContent = creating ? "Create your DogEared account" : "Welcome back to DogEared";
    }
    if (leftHandLoginCopy instanceof HTMLElement) {
      leftHandLoginCopy.textContent = creating
        ? "Enter your email to save books, build shelves, and get personal recommendations."
        : "Enter your email and continue with a magic link.";
    }
    leftHandLoginModal.hidden = false;
    showLoginFeedback("");
    window.setTimeout(() => leftHandLoginEmail?.focus(), 0);
  }

  function closeLoginModal() {
    if (!(leftHandLoginModal instanceof HTMLElement)) return;
    leftHandLoginModal.hidden = true;
    showLoginFeedback("");
    if (leftHandLoginForm instanceof HTMLFormElement) {
      leftHandLoginForm.reset();
    }
  }

  function applyLeftHandAuthState(authenticated) {
    if (leftHandLoginItem instanceof HTMLElement) leftHandLoginItem.hidden = authenticated;
    if (leftHandFollowingItem instanceof HTMLElement) leftHandFollowingItem.hidden = !authenticated;
    if (leftHandProfileItem instanceof HTMLElement) leftHandProfileItem.hidden = !authenticated;
    if (leftHandSettingsItem instanceof HTMLElement) leftHandSettingsItem.hidden = !authenticated;
    if (leftHandLogoutItem instanceof HTMLElement) leftHandLogoutItem.hidden = !authenticated;
    if (leftHandAuthDivider instanceof HTMLElement) leftHandAuthDivider.hidden = !authenticated;
    window.requestAnimationFrame(updateMobileStickyOffset);
  }

  async function syncNotificationCount(authenticated) {
    if (!(leftHandProfileLabel instanceof HTMLElement)) return;
    if (!authenticated) {
      leftHandProfileLabel.textContent = "Profile";
      return;
    }
    try {
      const response = await fetch("/api/notifications/count", { credentials: "same-origin" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(String(data?.error || "Failed to load notifications."));
      const unreadCount = Math.max(0, Number(data?.unreadCount || 0));
      leftHandProfileLabel.textContent = unreadCount > 0 ? `Profile (${unreadCount})` : "Profile";
    } catch {
      leftHandProfileLabel.textContent = "Profile";
    }
  }

  async function syncLeftHandAuthState() {
    const state = await resolveClientAuthState({ ssrAuthenticated });
    applyLeftHandAuthState(state.authenticated);
    await syncNotificationCount(state.authenticated);
    if (!state.authenticated || !(leftHandProfileLink instanceof HTMLAnchorElement)) return;
    try {
      const response = await fetch("/api/auth/me", { credentials: "same-origin" });
      const data = await response.json().catch(() => ({}));
      const username = String(data?.user?.username || "").trim();
      leftHandProfileLink.href = username
        ? `/profile/${encodeURIComponent(username)}`
        : "/settings#account-settings";
    } catch {
      leftHandProfileLink.href = "/settings#account-settings";
    }
  }

  leftHandLogoutButton?.addEventListener("click", async () => {
    try {
      await fetch("/api/auth/logout", { method: "POST" });
      setAuthPreviewMode("live");
    } finally {
      window.location.href = "/";
    }
  });

  leftHandLoginButton?.addEventListener("click", () => {
    openLoginModal("login");
  });

  window.addEventListener("dogeared:open-auth", (event) => {
    const mode = event instanceof CustomEvent && event.detail?.mode === "create" ? "create" : "login";
    openLoginModal(mode);
  });

  leftHandLoginModal?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (target.matches('[data-action="close-login-modal"]')) {
      closeLoginModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && leftHandLoginModal instanceof HTMLElement && !leftHandLoginModal.hidden) {
      closeLoginModal();
    }
  });

  leftHandLoginForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = String(leftHandLoginEmail instanceof HTMLInputElement ? leftHandLoginEmail.value : "").trim();
    if (!email) {
      showLoginFeedback("Enter an email address.", true);
      return;
    }
    showLoginFeedback("Sending magic link...");
    try {
      const response = await fetch("/api/auth/request-magic-link", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        showLoginFeedback(String(data?.error || "Failed to send magic link."), true);
        return;
      }
      const preview = String(data?.previewUrl || "").trim();
      if (preview) {
        showLoginFeedback(`Magic link generated. Open: ${preview}`);
        return;
      }
      showLoginFeedback(String(data?.message || "Check your email for your magic link."));
    } catch {
      showLoginFeedback("Failed to send magic link.", true);
    }
  });

  leftHandMenuToggle?.addEventListener("click", () => {
    if (!(leftHandNav instanceof HTMLElement)) return;
    const willOpen = !leftHandNav.classList.contains("menu-open");
    leftHandNav.classList.toggle("menu-open", willOpen);
    if (leftHandMenuToggle instanceof HTMLButtonElement) {
      leftHandMenuToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
      leftHandMenuToggle.textContent = willOpen ? "✕" : "☰";
      leftHandMenuToggle.setAttribute("aria-label", willOpen ? "Close navigation menu" : "Open navigation menu");
    }
    updateMobileStickyOffset();
  });

  leftHandPrimaryLinks?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.closest("a,button")) return;
    if (!(leftHandNav instanceof HTMLElement)) return;
    if (window.matchMedia("(max-width: 900px)").matches && leftHandMenuToggle instanceof HTMLButtonElement) {
      leftHandNav.classList.remove("menu-open");
      leftHandMenuToggle.setAttribute("aria-expanded", "false");
      leftHandMenuToggle.textContent = "☰";
      leftHandMenuToggle.setAttribute("aria-label", "Open navigation menu");
    }
    persistNavScrollPosition();
    updateMobileStickyOffset();
  });

  leftHandSecondaryLinks?.addEventListener("click", () => {
    persistNavScrollPosition();
  });

  leftHandPrimaryLinks?.addEventListener("scroll", () => {
    persistNavScrollPosition();
  }, { passive: true });

  leftHandSecondaryLinks?.addEventListener("scroll", () => {
    persistNavScrollPosition();
  }, { passive: true });

  function updateMobileStickyOffset() {
    if (!(leftHandNav instanceof HTMLElement)) return;
    const isMobile = window.matchMedia("(max-width: 900px)").matches;
    const overlap = isMobile ? 12 : 0;
    const offset = isMobile ? Math.max(0, Math.ceil(leftHandNav.getBoundingClientRect().height) - overlap) : 0;
    document.documentElement.style.setProperty("--mobile-sticky-offset", `${offset}px`);
  }

  updateMobileStickyOffset();
  restoreNavScrollPosition();
  window.addEventListener("pageshow", restoreNavScrollPosition);
  window.addEventListener("resize", updateMobileStickyOffset);
  window.addEventListener("load", updateMobileStickyOffset);

  const sectionNavLinks = Array.from(document.querySelectorAll("[data-section-link]"));
  const sectionTargets = sectionNavLinks
    .map((link) => {
      if (!(link instanceof HTMLAnchorElement)) return null;
      const id = String(link.dataset.sectionLink || "").trim();
      const target = id ? document.getElementById(id) : null;
      return target ? { id, link, target } : null;
    })
    .filter(Boolean);

  function setActiveSectionLink(id) {
    for (const item of sectionTargets) {
      item.link.classList.toggle("section-active", item.id === id);
      if (item.id === id) item.link.setAttribute("aria-current", "location");
      else item.link.removeAttribute("aria-current");
    }
  }

  function resolveCurrentSectionId() {
    const first = sectionTargets[0];
    const last = sectionTargets[sectionTargets.length - 1];
    if (!first || !last) return "";
    const scrollY = window.scrollY || window.pageYOffset || 0;
    const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    if (scrollY <= 8) return first.id;
    if (maxScroll > 0 && scrollY >= maxScroll - 8) return last.id;

    let currentId = first.id;
    const marker = Math.max(120, window.innerHeight * 0.28);
    for (const item of sectionTargets) {
      const rect = item.target.getBoundingClientRect();
      if (rect.top <= marker) currentId = item.id;
      else break;
    }
    return currentId;
  }

  if (sectionTargets.length > 0) {
    let ticking = false;
    function updateActiveSectionLink() {
      setActiveSectionLink(resolveCurrentSectionId());
    }
    function requestActiveSectionUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        updateActiveSectionLink();
        ticking = false;
      });
    }
    setActiveSectionLink(resolveCurrentSectionId());
    window.addEventListener("scroll", requestActiveSectionUpdate, { passive: true });
    window.addEventListener("resize", requestActiveSectionUpdate);
    window.addEventListener("load", updateActiveSectionLink);
    window.addEventListener("hashchange", () => {
      const id = window.location.hash.replace(/^#/, "");
      if (id) setActiveSectionLink(id);
      else updateActiveSectionLink();
    });
  }

  subscribeAuthStateChange(() => {
    void syncLeftHandAuthState();
  });
  window.addEventListener("dogeared:notifications-updated", (event) => {
    const detail = (event instanceof CustomEvent && event.detail && typeof event.detail === "object")
      ? event.detail
      : {};
    const unreadCount = Math.max(0, Number((detail as { unreadCount?: unknown }).unreadCount || 0));
    if (leftHandProfileLabel instanceof HTMLElement) {
      leftHandProfileLabel.textContent = unreadCount > 0 ? `Profile (${unreadCount})` : "Profile";
    }
  });
  void syncLeftHandAuthState();
</script>
