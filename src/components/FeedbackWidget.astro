---
type Props = { isAuthenticated?: boolean };
const { isAuthenticated = false } = Astro.props as Props;
---

<div class="feedback-widget floating-action-slot" data-feedback-widget data-authenticated={String(isAuthenticated)}>
	<button
		type="button"
		class="floating-action floating-action-feedback"
		data-feedback-open
		aria-haspopup="dialog"
		aria-controls="feedback-modal"
		aria-label="Send Founding Reader feedback"
		style="--floating-action-bg: var(--color-primary); --floating-action-hover-bg: var(--color-primary-hover);"
	>
		<span class="material-icons floating-action-icon" aria-hidden="true">chat_bubble</span>
		<span class="floating-action-label">Feedback</span>
	</button>

	<div class="feedback-modal-shell" data-feedback-modal id="feedback-modal" hidden>
		<div class="feedback-backdrop" data-feedback-close></div>
		<section
			class="feedback-panel"
			role="dialog"
			aria-modal="true"
			aria-labelledby="feedback-title"
			aria-describedby="feedback-intro"
			tabindex="-1"
		>
			<div class="feedback-panel-head">
				<div>
					<h2 id="feedback-title">Founding Reader Feedback</h2>
					<p id="feedback-intro">Tell us what is broken, confusing, useful, or missing as DogEared grows.</p>
				</div>
				<button type="button" class="feedback-close" data-feedback-close aria-label="Close feedback">
					<span class="material-icons" aria-hidden="true">close</span>
				</button>
			</div>

			<form class="feedback-form" data-feedback-form novalidate>
				<p class="feedback-account" data-feedback-account hidden></p>
				<fieldset>
					<legend>What kind of feedback is this?</legend>
					<label><input type="radio" name="type" value="bug" checked /> Bug Report</label>
					<label><input type="radio" name="type" value="feature" /> Feature Request</label>
					<label><input type="radio" name="type" value="general" /> General Feedback</label>
					<label><input type="radio" name="type" value="question" /> Question</label>
				</fieldset>

				<fieldset class="feedback-severity" data-feedback-severity>
					<legend>Severity <span>(optional)</span></legend>
					<label><input type="radio" name="severity" value="" checked /> Not sure</label>
					<label><input type="radio" name="severity" value="cosmetic" /> Cosmetic</label>
					<label><input type="radio" name="severity" value="minor" /> Minor</label>
					<label><input type="radio" name="severity" value="major" /> Major</label>
					<label><input type="radio" name="severity" value="blocking" /> Blocking</label>
				</fieldset>

				<label class="feedback-label" for="feedback-subject">Subject <span>(optional)</span></label>
				<input id="feedback-subject" name="subject" type="text" maxlength="160" placeholder="Short summary" />

				<label class="feedback-label" for="feedback-description">Description</label>
				<textarea id="feedback-description" name="description" rows="5" minlength="10" maxlength="6000" required placeholder="What happened, or what would you like DogEared to know?"></textarea>

				<div class="feedback-bug-fields" data-feedback-bug-fields>
					<label class="feedback-label" for="feedback-expected">Expected behavior <span>(optional)</span></label>
					<textarea id="feedback-expected" name="expectedBehavior" rows="3" maxlength="2000"></textarea>
					<label class="feedback-label" for="feedback-actual">Actual behavior <span>(optional)</span></label>
					<textarea id="feedback-actual" name="actualBehavior" rows="3" maxlength="2000"></textarea>
					<label class="feedback-label" for="feedback-steps">Steps to reproduce <span>(optional)</span></label>
					<textarea id="feedback-steps" name="stepsToReproduce" rows="4" maxlength="3000" placeholder="1. Open the page&#10;2. Click the control&#10;3. See what happens"></textarea>
				</div>

				<div class="feedback-upload" data-feedback-dropzone tabindex="0" role="button" aria-describedby="feedback-upload-copy">
					<span class="material-icons" aria-hidden="true">add_photo_alternate</span>
					<div>
						<label for="feedback-screenshots">Add screenshots <span>(optional)</span></label>
						<p id="feedback-upload-copy">Drag screenshots here, or choose images. Up to 3 images.</p>
						<input id="feedback-screenshots" name="screenshots" type="file" accept="image/*" multiple />
					</div>
				</div>
				<ul class="feedback-screenshot-list" data-feedback-screenshot-list aria-label="Selected screenshots"></ul>

				<label class="feedback-label" for="feedback-email">Email <span>(optional)</span></label>
				<input id="feedback-email" name="email" type="email" autocomplete="email" />

				<p class="feedback-privacy">
					DogEared includes page URL, route, browser, device size, language, login state, relevant IDs, and recent client errors when helpful. We do not collect passwords, private journal content, or sensitive personal information.
				</p>

				<label class="feedback-honeypot" aria-hidden="true">
					Website
					<input type="text" name="website" tabindex="-1" autocomplete="off" />
				</label>

				<p class="feedback-status" data-feedback-status role="status" aria-live="polite"></p>

				<div class="feedback-actions">
					<button type="button" class="feedback-secondary" data-feedback-close>Cancel</button>
					<button type="submit" class="feedback-primary" data-feedback-submit>Send Feedback</button>
				</div>
			</form>

			<div class="feedback-success" data-feedback-success hidden>
				<p>Thanks for helping shape DogEared.</p>
				<p>Your feedback has been received.</p>
				<p data-feedback-tracking hidden></p>
				<button type="button" class="feedback-primary" data-feedback-close>Done</button>
			</div>
		</section>
	</div>

	<div class="feedback-error-prompt" data-feedback-error-prompt hidden role="status" aria-live="polite">
		<p><strong>Something unexpected happened.</strong></p>
		<p>Would you like to send a report?</p>
		<div>
			<button type="button" class="feedback-primary" data-feedback-error-report>Send report</button>
			<button type="button" class="feedback-secondary" data-feedback-error-dismiss>Not now</button>
		</div>
	</div>
</div>

<script>
	const widget = document.querySelector("[data-feedback-widget]");
	if (widget instanceof HTMLElement) {
		const openButton = widget.querySelector("[data-feedback-open]");
		const modal = widget.querySelector("[data-feedback-modal]");
		const panel = widget.querySelector(".feedback-panel");
		const form = widget.querySelector("[data-feedback-form]");
		const success = widget.querySelector("[data-feedback-success]");
		const typeInputs = Array.from(widget.querySelectorAll('input[name="type"]'));
		const severityGroup = widget.querySelector("[data-feedback-severity]");
		const bugFields = widget.querySelector("[data-feedback-bug-fields]");
		const descriptionInput = widget.querySelector("#feedback-description");
		const emailInput = widget.querySelector("#feedback-email");
		const screenshotInput = widget.querySelector("#feedback-screenshots");
		const screenshotList = widget.querySelector("[data-feedback-screenshot-list]");
		const dropzone = widget.querySelector("[data-feedback-dropzone]");
		const accountCopy = widget.querySelector("[data-feedback-account]");
		const status = widget.querySelector("[data-feedback-status]");
		const submitButton = widget.querySelector("[data-feedback-submit]");
		const trackingCopy = widget.querySelector("[data-feedback-tracking]");
		const errorPrompt = widget.querySelector("[data-feedback-error-prompt]");
		const errorReportButton = widget.querySelector("[data-feedback-error-report]");
		const errorDismissButton = widget.querySelector("[data-feedback-error-dismiss]");
		let previousFocus = null;
		let accountLoaded = false;
		let authenticated = widget.dataset.authenticated === "true";
		let selectedScreenshots = [];
		window.__dogearedClientErrors = window.__dogearedClientErrors || [];

		function setStatus(message, isError = false) {
			if (!(status instanceof HTMLElement)) return;
			status.textContent = message;
			status.dataset.state = isError ? "error" : message ? "info" : "";
		}

		async function loadAccountContext() {
			if (accountLoaded) return;
			accountLoaded = true;
			try {
				const response = await fetch("/api/auth/me", { credentials: "same-origin" });
				const data = await response.json().catch(() => ({}));
				const user = data?.user || {};
				authenticated = Boolean(data?.authenticated);
				if (authenticated && emailInput instanceof HTMLInputElement && !emailInput.value && typeof user.email === "string") {
					emailInput.value = user.email;
				}
				if (authenticated && accountCopy instanceof HTMLElement) {
					const username = typeof user.username === "string" && user.username ? `@${user.username}` : "your DogEared account";
					accountCopy.textContent = `Submitting as: ${username}`;
					accountCopy.hidden = false;
				}
			} catch {
				// Feedback should stay available even if account context cannot load.
			}
		}

		function currentFeedbackType() {
			const selected = typeInputs.find((input) => input instanceof HTMLInputElement && input.checked);
			return selected instanceof HTMLInputElement ? selected.value : "general";
		}

		function syncFeedbackMode() {
			const type = currentFeedbackType();
			if (bugFields instanceof HTMLElement) bugFields.hidden = type !== "bug";
			if (severityGroup instanceof HTMLElement) severityGroup.hidden = type === "general";
		}

		function openFeedbackModal(options = {}) {
			if (!(modal instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;
			previousFocus = document.activeElement;
			if (form instanceof HTMLFormElement) form.hidden = false;
			if (success instanceof HTMLElement) success.hidden = true;
			if (trackingCopy instanceof HTMLElement) trackingCopy.hidden = true;
			setStatus("");
			modal.hidden = false;
			document.body.classList.add("feedback-modal-open");
			void loadAccountContext();
			if (options.type && form instanceof HTMLFormElement) {
				const typeInput = form.querySelector(`input[name="type"][value="${CSS.escape(options.type)}"]`);
				if (typeInput instanceof HTMLInputElement) typeInput.checked = true;
			}
			if (options.subject && form instanceof HTMLFormElement) {
				const subjectInput = form.elements.namedItem("subject");
				if (subjectInput instanceof HTMLInputElement) subjectInput.value = String(options.subject || "");
			}
			if (options.description && descriptionInput instanceof HTMLTextAreaElement) {
				descriptionInput.value = String(options.description || "");
			}
			syncFeedbackMode();
			window.setTimeout(() => {
				if (descriptionInput instanceof HTMLTextAreaElement) descriptionInput.focus();
				else panel.focus();
			}, 0);
		}

		function closeFeedbackModal() {
			if (!(modal instanceof HTMLElement)) return;
			modal.hidden = true;
			document.body.classList.remove("feedback-modal-open");
			if (previousFocus instanceof HTMLElement) previousFocus.focus();
		}

		function collectViewport() {
			return `${window.innerWidth}x${window.innerHeight}`;
		}

		function collectScreenSize() {
			return `${window.screen?.width || 0}x${window.screen?.height || 0}`;
		}

		function detectBrowser() {
			const agent = navigator.userAgent;
			if (/Edg\//.test(agent)) return "Microsoft Edge";
			if (/Chrome\//.test(agent) && !/Chromium/.test(agent)) return "Chrome";
			if (/Safari\//.test(agent) && !/Chrome\//.test(agent)) return "Safari";
			if (/Firefox\//.test(agent)) return "Firefox";
			return agent.slice(0, 160);
		}

		function detectOperatingSystem() {
			const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
			const agent = navigator.userAgent;
			if (/Mac/i.test(platform)) return "macOS";
			if (/Win/i.test(platform)) return "Windows";
			if (/iPhone|iPad|iPod/i.test(agent)) return "iOS";
			if (/Android/i.test(agent)) return "Android";
			if (/Linux/i.test(platform)) return "Linux";
			return String(platform || "Unknown").slice(0, 160);
		}

		function routeForPath() {
			const path = window.location.pathname;
			if (path.startsWith("/book")) return "/book";
			if (path.startsWith("/author/")) return "/author/[slug]";
			if (path.startsWith("/collections/")) return "/collections/[slug]";
			if (path.startsWith("/profile/")) return "/profile/[username]";
			return path || "/";
		}

		function metadataFromPage() {
			const params = new URLSearchParams(window.location.search);
			const recommendationNode = document.querySelector("[data-recommendation-source], [data-recommendation-feedback-source], [data-action='book-card-recommendation-feedback'][data-source]");
			return {
				pageUrl: window.location.href,
				route: routeForPath(),
				timestamp: new Date().toISOString(),
				appVersion: document.body?.dataset.appVersion || "",
				releaseVersion: document.body?.dataset.releaseVersion || "",
				gitCommit: document.body?.dataset.gitCommit || "",
				userAgent: navigator.userAgent,
				browser: detectBrowser(),
				operatingSystem: detectOperatingSystem(),
				screenSize: collectScreenSize(),
				viewport: collectViewport(),
				colorScheme: window.matchMedia?.("(prefers-color-scheme: dark)")?.matches ? "dark" : "light",
				language: navigator.language || "",
				authenticated,
				bookId: params.get("bookId") || document.querySelector("[data-book-id]")?.getAttribute("data-book-id") || "",
				authorId: params.get("authorId") || document.querySelector("[data-author-id]")?.getAttribute("data-author-id") || "",
				collectionId: document.querySelector("[data-collection-id]")?.getAttribute("data-collection-id") || "",
				searchQuery: params.get("q") || "",
				recommendationSource: recommendationNode?.getAttribute("data-recommendation-source") || recommendationNode?.getAttribute("data-recommendation-feedback-source") || recommendationNode?.getAttribute("data-source") || "",
				environment: "",
				featureFlags: Array.from(document.querySelectorAll("[data-feature-flag]")).map((node) => node.getAttribute("data-feature-flag")).filter(Boolean).slice(0, 20),
				recentClientErrors: Array.isArray(window.__dogearedClientErrors) ? window.__dogearedClientErrors.slice(-5) : []
			};
		}

		function trackFeedbackSubmitted(type) {
			void type;
		}

		function escapeHtml(value) {
			return String(value || "")
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		openButton?.addEventListener("click", () => openFeedbackModal());
		typeInputs.forEach((input) => input.addEventListener("change", syncFeedbackMode));
		widget.querySelectorAll("[data-feedback-close]").forEach((button) => {
			button.addEventListener("click", closeFeedbackModal);
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && modal instanceof HTMLElement && !modal.hidden) closeFeedbackModal();
		});

		function renderScreenshots() {
			if (!(screenshotList instanceof HTMLElement)) return;
			screenshotList.innerHTML = selectedScreenshots.map((item, index) => `
				<li>
					<img src="${escapeHtml(item.dataUrl)}" alt="">
					<span>${escapeHtml(item.name)}</span>
					<button type="button" data-remove-screenshot="${index}" aria-label="Remove ${escapeHtml(item.name)}">Remove</button>
				</li>
			`).join("");
		}

		function readScreenshot(file) {
			return new Promise((resolve, reject) => {
				if (!file.type.startsWith("image/")) {
					reject(new Error("Choose image files only."));
					return;
				}
				if (file.size > 1_500_000) {
					reject(new Error("Screenshots must be under 1.5 MB each."));
					return;
				}
				const reader = new FileReader();
				reader.addEventListener("load", () => {
					resolve({
						name: file.name || "screenshot",
						type: file.type || "image/png",
						size: file.size || 0,
						dataUrl: String(reader.result || "")
					});
				});
				reader.addEventListener("error", () => reject(new Error("Could not read one screenshot.")));
				reader.readAsDataURL(file);
			});
		}

		async function addScreenshotFiles(files) {
			const incoming = Array.from(files || []).slice(0, Math.max(0, 3 - selectedScreenshots.length));
			if (incoming.length === 0) return;
			try {
				const next = await Promise.all(incoming.map(readScreenshot));
				selectedScreenshots = selectedScreenshots.concat(next).slice(0, 3);
				renderScreenshots();
				setStatus("");
			} catch (error) {
				setStatus(error instanceof Error ? error.message : "Could not attach screenshot.", true);
			}
		}

		screenshotInput?.addEventListener("change", () => {
			if (screenshotInput instanceof HTMLInputElement) void addScreenshotFiles(screenshotInput.files);
		});
		screenshotList?.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const button = target.closest("[data-remove-screenshot]");
			if (!(button instanceof HTMLButtonElement)) return;
			const index = Number(button.dataset.removeScreenshot || -1);
			if (index >= 0) {
				selectedScreenshots.splice(index, 1);
				renderScreenshots();
			}
		});
		dropzone?.addEventListener("dragover", (event) => {
			event.preventDefault();
			if (dropzone instanceof HTMLElement) dropzone.classList.add("is-dragging");
		});
		dropzone?.addEventListener("dragleave", () => {
			if (dropzone instanceof HTMLElement) dropzone.classList.remove("is-dragging");
		});
		dropzone?.addEventListener("drop", (event) => {
			event.preventDefault();
			if (dropzone instanceof HTMLElement) dropzone.classList.remove("is-dragging");
			void addScreenshotFiles(event.dataTransfer?.files);
		});
		dropzone?.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" && event.key !== " ") return;
			event.preventDefault();
			if (screenshotInput instanceof HTMLInputElement) screenshotInput.click();
		});

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!(form instanceof HTMLFormElement)) return;
			const formData = new FormData(form);
			const type = String(formData.get("type") || "general");
			const severity = String(formData.get("severity") || "").trim();
			const subject = String(formData.get("subject") || "").trim();
			const description = String(formData.get("description") || "").trim();
			const expectedBehavior = String(formData.get("expectedBehavior") || "").trim();
			const actualBehavior = String(formData.get("actualBehavior") || "").trim();
			const stepsToReproduce = String(formData.get("stepsToReproduce") || "").trim();
			const email = String(formData.get("email") || "").trim();
			const website = String(formData.get("website") || "").trim();

			if (description.length < 10) {
				setStatus("Please add a little more detail before sending feedback.", true);
				if (descriptionInput instanceof HTMLTextAreaElement) descriptionInput.focus();
				return;
			}
			if (email && emailInput instanceof HTMLInputElement && !emailInput.checkValidity()) {
				setStatus("Use a valid email address, or leave the email field blank.", true);
				emailInput.focus();
				return;
			}

			if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
			setStatus("Sending feedback...");
			try {
				const response = await fetch("/api/feedback", {
					method: "POST",
					credentials: "same-origin",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						type,
						severity,
						subject,
						description,
						expectedBehavior,
						actualBehavior,
						stepsToReproduce,
						email,
						website,
						metadata: metadataFromPage(),
						screenshots: selectedScreenshots
					})
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok || data?.ok === false) {
					setStatus(String(data?.error || "Feedback could not be sent. Try again in a moment."), true);
					return;
				}
				trackFeedbackSubmitted(type);
				form.reset();
				selectedScreenshots = [];
				renderScreenshots();
				syncFeedbackMode();
				form.hidden = true;
				if (success instanceof HTMLElement) success.hidden = false;
				if (trackingCopy instanceof HTMLElement) {
					const trackingNumber = String(data?.trackingNumber || "").trim();
					trackingCopy.textContent = trackingNumber ? `Tracking number: ${trackingNumber}` : "";
					trackingCopy.hidden = !trackingNumber;
				}
				setStatus("");
			} catch {
				setStatus("Feedback could not be sent. Try again in a moment.", true);
			} finally {
				if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
			}
		});

		function rememberClientError(error) {
			const list = Array.isArray(window.__dogearedClientErrors) ? window.__dogearedClientErrors : [];
			list.push({
				message: String(error?.message || error?.reason?.message || error || "Unknown client error").slice(0, 500),
				source: String(error?.filename || error?.source || window.location.href || "").slice(0, 500),
				stack: String(error?.error?.stack || error?.reason?.stack || "").slice(0, 1600),
				timestamp: new Date().toISOString()
			});
			window.__dogearedClientErrors = list.slice(-5);
			if (errorPrompt instanceof HTMLElement && modal instanceof HTMLElement && modal.hidden) {
				errorPrompt.hidden = false;
			}
		}

		window.addEventListener("error", (event) => {
			rememberClientError(event);
		});
		window.addEventListener("unhandledrejection", (event) => {
			rememberClientError(event);
		});
		errorDismissButton?.addEventListener("click", () => {
			if (errorPrompt instanceof HTMLElement) errorPrompt.hidden = true;
		});
		errorReportButton?.addEventListener("click", () => {
			if (errorPrompt instanceof HTMLElement) errorPrompt.hidden = true;
			openFeedbackModal({
				type: "bug",
				subject: "Unexpected client error",
				description: "Something unexpected happened while I was using DogEared."
			});
		});
		syncFeedbackMode();
	}
</script>

<style>
	:global(.floating-action:focus-visible),
	.feedback-close:focus-visible,
	.feedback-primary:focus-visible,
	.feedback-secondary:focus-visible,
	.feedback-form input:focus-visible,
	.feedback-form textarea:focus-visible {
		outline: 3px solid #111;
		outline-offset: 2px;
	}
	.feedback-modal-shell {
		position: fixed;
		inset: 0;
		z-index: 13000;
		display: grid;
		place-items: center;
		padding: 1rem;
		box-sizing: border-box;
	}
	.feedback-modal-shell[hidden] {
		display: none;
	}
	.feedback-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(16, 22, 28, 0.52);
	}
	.feedback-panel {
		position: relative;
		z-index: 1;
		width: min(560px, 100%);
		max-height: calc(100dvh - 2rem);
		overflow: auto;
		box-sizing: border-box;
		border: none;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
		padding: 1rem;
		color: var(--color-text);
	}
	.feedback-panel-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.feedback-panel h2 {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 650;
	}
	.feedback-panel p {
		margin: 0.25rem 0 0;
		line-height: 1.45;
	}
	.feedback-panel-head p,
	.feedback-account,
	.feedback-status {
		color: #536273;
		font-size: 0.92rem;
	}
	.feedback-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border: var(--border-subtle);
		border-radius: var(--radius-sm);
		background: #fff;
		color: var(--color-nav);
		cursor: pointer;
	}
	.feedback-form {
		display: grid;
		gap: 0.7rem;
		margin-top: 0.9rem;
	}
	.feedback-form[hidden],
	.feedback-success[hidden],
	.feedback-account[hidden],
	.feedback-bug-fields[hidden],
	.feedback-severity[hidden],
	.feedback-error-prompt[hidden] {
		display: none;
	}
	.feedback-form fieldset {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem 0.7rem;
		margin: 0;
		padding: 0.7rem;
		border: var(--border-subtle);
