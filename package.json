{
  "name": "dogeared",
  "type": "module",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "release:check": "npm test && npm run build",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "deps:audit": "npm audit --audit-level=high",
    "deps:outdated": "npm outdated || true",
    "preview": "astro preview",
    "astro": "astro",
    "backfill:genres": "node scripts/backfill-book-genres.mjs",
    "backfill:page-counts": "node scripts/backfill-book-page-counts.mjs",
    "backfill:publishers": "node scripts/backfill-book-publishers.mjs",
    "backfill:synopsis": "node scripts/backfill-book-synopsis.mjs",
    "backfill:author-avatars": "node scripts/backfill-author-avatars.mjs",
    "backfill:author-bios": "node scripts/backfill-author-bios.mjs",
    "backfill:report": "node scripts/metadata-quality-report.mjs",
    "backfill:metadata": "node scripts/run-metadata-backfills.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.5",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^6.3.2",
    "echarts": "^6.0.0"
  }
}
