{
  "name": "dogeared",
  "type": "module",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "release:check": "npm test && npm run build",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "deps:audit": "node scripts/deps-audit-ci.mjs",
    "ci:validate": "node scripts/validate-ci-config.mjs",
    "deps:outdated": "npm outdated || true",
    "preview": "astro preview",
    "astro": "astro",
    "backfill:genres": "node scripts/backfill-book-genres.mjs",
    "backfill:page-counts": "node scripts/backfill-book-page-counts.mjs",
    "backfill:publishers": "node scripts/backfill-book-publishers.mjs",
    "backfill:synopsis": "node scripts/backfill-book-synopsis.mjs",
    "backfill:author-avatars": "node scripts/backfill-author-avatars.mjs",
    "backfill:author-bios": "node scripts/backfill-author-bios.mjs",
    "backfill:report": "node scripts/metadata-quality-report.mjs",
    "backfill:metadata": "node scripts/run-metadata-backfills.mjs",
    "backfill:cleanup-genres-topics": "node scripts/cleanup-book-genres-topics-once.mjs",
    "cleanup:canonical-titles": "node --experimental-strip-types scripts/normalize-series-canonical-titles.mjs",
    "cleanup:duplicate-works": "node --experimental-strip-types scripts/normalize-duplicate-works.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.8",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^6.4.7",
    "echarts": "^6.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "path-to-regexp": "6.3.0",
    "tar": "^7.5.16",
    "vite": "7.3.5"
  }
}
